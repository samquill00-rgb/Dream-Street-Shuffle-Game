      var spill=ctx.createRadialGradient(cx,150,8,cx,170,170);spill.addColorStop(0,'#5ab8cc26');spill.addColorStop(1,'#5ab8cc00');
      ctx.fillStyle=spill;ctx.fillRect(cx-180,0,360,363);
