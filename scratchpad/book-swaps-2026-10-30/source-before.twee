if (vboxOn) { vSeq++; vbox.innerHTML = vhtml; voicePrep(vbox); vbox.setAttribute('aria-hidden', 'false'); [vbox, vtail, vdot].forEach(function(n) { n.style.transition = 'opacity 0.6s ease'; n.style.opacity = '0'; }); }
else hideVoiceBox();
