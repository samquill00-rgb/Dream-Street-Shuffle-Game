  [-2, 0.09, 2.5, 1.2, 0.8],
  [3, 0.09, 1.8, 0.9, 0.6],
  [0.5, 0.09, 2.2, 1.5, 1.0],
  [-4, 0.09, 3.0, 0.7, 0.5],
  [5, 0.09, 1.5, 1.0, 0.7]
];
for (var sti = 0; sti < stainPositions.length; sti++) {
