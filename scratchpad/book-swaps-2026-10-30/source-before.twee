  streetProgress=Math.max(0,Math.min(1,streetProgress||0));
  var t=still?0:ms/1000, o=Math.max(0,Math.min(1,opening)), e=enchant;
  var candleFlicker=still?1:.94+.035*Math.sin(t*10.7)+.025*Math.sin(t*17.3+1.2);
