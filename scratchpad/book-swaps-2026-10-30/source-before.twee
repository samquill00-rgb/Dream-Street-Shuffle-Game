 function material(color,metal){var key=color+'|'+metal;if(cache[key])return cache[key];var map=texture(function(c,w,h){c.fillStyle='#edeae1';c.fillRect(0,0,w,h);for(var i=0;i<1200;i++){c.fillStyle=i%5?'rgba(54,47,34,0.045)':'rgba(71,49,29,0.1)';c.fillRect(i*47%w,i*83%h,1+i%5,1);}});return cache[key]=new THREE.MeshStandardMaterial({color:color,map:map,roughness:metal?0.57:0.88,metalness:metal?0.55:0});}
 function mesh(p,g,m,x,y,z){var o=new THREE.Mesh(g,m);o.position.set(x,y,z);(p||scene).add(o);return o;}
 function group(p,x,y,z,ry){var g=new THREE.Group();g.position.set(x,y,z);g.rotation.y=ry||0;(p||scene).add(g);return g;}
 function screws(p,points,r){var bolts=new THREE.InstancedMesh(new THREE.SphereGeometry(r||0.007,8,5),material(0x756e5b,true),points.length),pose=new THREE.Object3D();points.forEach(function(v,i){pose.position.set(v[0],v[1],v[2]);pose.scale.set(1,1,0.3);pose.updateMatrix();bolts.setMatrixAt(i,pose.matrix);});bolts.instanceMatrix.needsUpdate=true;p.add(bolts);return bolts;}
 function plate(p,x,y,z,w,h,ry,col){var g=group(p,x,y,z,ry);mesh(g,new THREE.BoxGeometry(w,h,0.005),material(col||0x9c8654,true),0,0,0);screws(g,[[-w*0.36,-h*0.38,0.004],[w*0.36,-h*0.38,0.004],[-w*0.36,h*0.38,0.004],[w*0.36,h*0.38,0.004]],Math.min(0.006,w*0.055));return g;}
 function ring(p,x,y,z,r,t,rx,col){var o=mesh(p,new THREE.TorusGeometry(r,t||0.003,6,32),material(col||0x5a5649,true),x,y,z);o.rotation.x=rx||0;return o;}
 function age(t,cloth){if(!t||!t.image)return;var image=t.image,w=image.width,h=image.height;if(!w||!h)return;var c=document.createElement('canvas');c.width=w;c.height=h;var q=c.getContext('2d');try{q.drawImage(image,0,0);}catch(e){return;}
 for(var i=0;i<Math.min(1500,w*h/30);i++){var x=i*47%w,y=i*83%h,edge=Math.min(x,w-x,y,h-y);if(edge<Math.min(w,h)*0.07){q.fillStyle='rgba(85,65,38,0.12)';q.fillRect(x,y,1+i%3,1);}}
 if(cloth){for(var y=0;y<h;y+=3){q.fillStyle='rgba(20,15,10,0.055)';q.fillRect(0,y,w,1);}for(var x=0;x<w;x+=3){q.fillStyle='rgba(230,219,192,0.04)';q.fillRect(x,0,1,h);}}
 t.image=c;t.needsUpdate=true;}
 function finish(m,cloth){if(m.map){age(m.map,cloth);return;}var map=texture(function(c,w,h){c.fillStyle='#f2eee4';c.fillRect(0,0,w,h);for(var i=0;i<1000;i++){c.fillStyle=i%4?'rgba(74,60,40,0.06)':'rgba(100,76,45,0.1)';c.fillRect(i*47%w,i*83%h,1+i%4,1);}if(cloth)for(var y=0;y<h;y+=3){c.fillStyle='rgba(32,23,13,0.06)';c.fillRect(0,y,w,1);}});m.map=map;m.roughness=Math.max(m.roughness||0.5,cloth?0.8:0.55);m.needsUpdate=true;}
 function tread(p,x,y,z,w,d,round){var key='tread';if(!cache[key]){cache[key]=new THREE.MeshStandardMaterial({color:0x777a6c,map:texture(function(c,w,h){c.fillStyle='#363833';c.fillRect(0,0,w,h);for(var y=8;y<h;y+=22)for(var x=8;x<w;x+=22){c.strokeStyle='#686b60';c.lineWidth=3;c.beginPath();c.moveTo(x,y+7);c.lineTo(x+7,y);c.lineTo(x+14,y+7);c.stroke();}c.fillStyle='#161b18';c.fillRect(49,113,28,8);c.fillRect(179,113,28,8);}),roughness:0.67,metalness:0.45});}
 var o=mesh(p,round?new THREE.CircleGeometry(w/2,40):new THREE.PlaneGeometry(w,d),cache[key],x,y,z);o.rotation.x=-Math.PI/2;return o;}
 function glassEdge(p,x,y,z,w,h,ry){var map=texture(function(c,ww,hh){c.clearRect(0,0,ww,hh);var g=c.createLinearGradient(0,0,0,hh);g.addColorStop(0,'rgba(67,58,39,0.13)');g.addColorStop(0.12,'rgba(67,58,39,0)');g.addColorStop(0.76,'rgba(67,58,39,0)');g.addColorStop(1,'rgba(67,58,39,0.24)');c.fillStyle=g;c.fillRect(0,0,ww,hh);for(var i=0;i<120;i++)c.fillRect(i*47%ww,hh-1-i%20,1,1);});var o=mesh(p,new THREE.PlaneGeometry(w,h),new THREE.MeshStandardMaterial({map:map,transparent:true,depthWrite:false,roughness:0.8,polygonOffset:true,polygonOffsetFactor:-1}),x,y,z);o.rotation.y=ry||0;return o;}
 function chain(p,x,y,z,length,col){var n=Math.max(3,Math.round(length/0.045)),links=new THREE.InstancedMesh(new THREE.TorusGeometry(0.017,0.003,5,12),material(col||0x45443b,true),n),pose=new THREE.Object3D();for(var i=0;i<n;i++){pose.position.set(x,y-i*length/n,z);pose.rotation.y=i%2?Math.PI/2:0;pose.updateMatrix();links.setMatrixAt(i,pose.matrix);}links.instanceMatrix.needsUpdate=true;p.add(links);return links;}
 function step(p,x,y,z,w,d){var m=material(0x8a877b,false),o=mesh(p,new THREE.PlaneGeometry(w,d),m,x,y,z);o.rotation.x=-Math.PI/2;for(var i=0;i<3;i++){var seam=mesh(p,new THREE.BoxGeometry(0.004,0.001,d),material(0x595a52,false),x+(i-1)*w/3,y+0.001,z);}} 
 return {texture:texture,material:material,mesh:mesh,group:group,screws:screws,plate:plate,ring:ring,age:age,finish:finish,tread:tread,glassEdge:glassEdge,chain:chain,step:step};
};

// ====== GINGER LIGHT SCENE — INLINE ======
(function() {
var glActive = false;
var glAnimId = null;

function initGingerLight() {
if (glActive) return;
glActive = true;
if (typeof THREE === 'undefined') {
var s = document.createElement('script');
s.src = 'vendor/three/three.min.js';
s.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildGLScene) : buildGLScene()); };
document.head.appendChild(s);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildGLScene) : buildGLScene());
}
}

function buildGLScene() {
// Reduced-motion: hold one settled frame (lamp steady, fog and smoke still, cat at rest).
var glStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
// Create full-screen overlay wrapper
var glWrap = document.createElement('div');
glWrap.id = 'gl-wrap';
glWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#08080e;overflow:hidden;';
/* 2026-10-21 (Sam): title mode. The Title passage carries a #ga-container marked data-title; the street then builds inside #dss-title beneath the title's words, with no approach button, and fades in */
var glTitleHost = (function() { var c = document.getElementById('ga-container'); return (c && c.getAttribute('data-title')) ? document.getElementById('dss-title') : null; })();
if (glTitleHost) glWrap.className = 'gl-title';

// ============================================================
// SCENE SETUP
// ============================================================
var scene = new THREE.Scene();
var exterior=window.dssExteriorDetail(scene);
scene.background = new THREE.Color(0x15151f);

// Deep Soho fog — swallows the far end of the streets
scene.fog = new THREE.Fog(0x15151f, 4, 32);

var camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 200);

// ============================================================
// LAYOUT EXPLANATION
// ============================================================
// Street corner: Dean Street runs north-south (along Z axis)
// Greek Street joins from the east (along X axis)
// The hero streetlamp stands at the corner, slightly on the pavement
// Camera looks up slightly at the lamp from across the junction
// Buildings line both streets, fading into fog

camera.position.set(6.5, 2.2, 8);
camera.lookAt(0, 4.5, -1);

var renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
renderer.toneMappingExposure = 0.6;
glWrap.appendChild(renderer.domElement);
window._dssBindScene('gl-wrap', scene, renderer, camera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(scene, camera, renderer, { focus: 12 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(document.getElementById('gl-wrap'));

// Store base camera position for subtle breathing sway
var cameraBase = { x: 6.5, y: 2.2, z: 8 };

// ============================================================
// MATERIALS
// ============================================================
var glBrickKit = !!(window.dssScene && window.dssScene.makeGrimyBrick);
var darkBrick = glBrickKit
  ? window.dssScene.makeGrimyBrick({ baseColor: 0x3a2a22, repeat: [2, 4], sootStreaks: 7 })
  : new THREE.MeshStandardMaterial({ color: 0x3a2a22, roughness: 0.9 });
var creamWall = (window.dssScene && window.dssScene.makeWeatheredStucco)
  ? window.dssScene.makeWeatheredStucco({ baseColor: 0xc8bfaa, repeat: [1.8, 3] })
  : new THREE.MeshStandardMaterial({ color: 0xc8bfaa, roughness: 0.85 });
var greyStone = new THREE.MeshStandardMaterial({ color: 0x6a6560, roughness: 0.85 });
var sootBrick = glBrickKit
  ? window.dssScene.makeGrimyBrick({ baseColor: 0x2a2520, repeat: [2, 4], sootStreaks: 9, dampPatches: 6 })
  : new THREE.MeshStandardMaterial({ color: 0x2a2520, roughness: 0.9 });
var redBrick = glBrickKit
  ? window.dssScene.makeGrimyBrick({ baseColor: 0x6b3a2a, repeat: [2, 4] })
  : new THREE.MeshStandardMaterial({ color: 0x6b3a2a, roughness: 0.85 });
var shopFront = new THREE.MeshStandardMaterial({ color: 0x1a2a1a, roughness: 0.7 });
var darkWood = new THREE.MeshStandardMaterial({ color: 0x1a1008, roughness: 0.7 });
var pavementMat = (window.dssScene && window.dssScene.makePavingSlabs)
  ? window.dssScene.makePavingSlabs({ repeat: [20, 20] })
  : new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.6, metalness: 0.1 });
var roadMat = (window.dssScene && window.dssScene.makeGrimyRoad)
  ? window.dssScene.makeGrimyRoad({ baseColor: 0x151515 })
  : new THREE.MeshStandardMaterial({ color: 0x151515, roughness: 0.55, metalness: 0.15 });
// Second road runs along X — same asphalt with the texture spun 90 degrees
var roadMatX = roadMat.clone();
if (roadMatX.map) {
  roadMatX.map = roadMat.map.clone();
  roadMatX.map.center.set(0.5, 0.5);
  roadMatX.map.rotation = Math.PI / 2;
  roadMatX.map.repeat.set(1, 5);
  roadMatX.map.needsUpdate = true;
}
var windowFrame = new THREE.MeshStandardMaterial({ color: 0x8a8070, roughness: 0.7 });
var darkGlass = new THREE.MeshStandardMaterial({ color: 0x0a0a12, roughness: 0.2, metalness: 0.3 });
var warmGlass = new THREE.MeshStandardMaterial({ color: 0x2a1505, roughness: 0.3, emissive: 0xe87818, emissiveIntensity: 0.14 });
var ironMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.6, metalness: 0.4 });
var kerbMat = new THREE.MeshStandardMaterial({ color: 0x555555, roughness: 0.5, metalness: 0.15 });
var paveMat = new THREE.MeshStandardMaterial({ color: 0x4a4a4a, roughness: 0.65, metalness: 0.1 });
var drainMat = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.7, metalness: 0.4 });

// ============================================================
// HELPER: canvas texture
// ============================================================
function makeCanvasTexture(w, h, drawFunc) {
  var c = document.createElement('canvas');
  c.width = w; c.height = h;
  var cx = c.getContext('2d');
  drawFunc(cx, w, h);
  var tex = new THREE.CanvasTexture(c);
  tex.minFilter = THREE.LinearFilter;
  return tex;
}

function makeSign(text, opts) {
  var o = opts || {};
  var w = o.w || 512; var h = o.h || 128;
  var bg = o.bg || '#1a1a1a'; var fg = o.fg || '#c8c0a0';
  var fs = o.fs || 36; var ff = o.ff || 'bold Georgia';
  var tex = makeCanvasTexture(w, h, function(cx, cw, ch) {
    cx.fillStyle = bg; cx.fillRect(0, 0, cw, ch);
    if (o.border) {
      cx.strokeStyle = fg; cx.lineWidth = 3;
      cx.strokeRect(4, 4, cw - 8, ch - 8);
    }
    cx.fillStyle = fg; cx.font = fs + 'px ' + ff;
    cx.textAlign = 'center'; cx.textBaseline = 'middle';
    cx.fillText(text, cw/2, ch/2);
  });
  return new THREE.MeshStandardMaterial({ map: tex, roughness: 0.5 });
}

function placeMesh(geo, mat, x, y, z) {
  var m = new THREE.Mesh(geo, mat);
  m.position.set(x, y, z);
  scene.add(m);
  return m;
}

function placeMeshG(group, geo, mat, x, y, z) {
  var m = new THREE.Mesh(geo, mat);
  m.position.set(x, y, z);
  group.add(m);
  return m;
}

// ============================================================
// GROUND
// ============================================================
var pavement = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), pavementMat);
pavement.rotation.x = -Math.PI / 2;
pavement.receiveShadow = true;
scene.add(pavement);

// Dean Street road (runs along Z — north-south)
var deanRoad = new THREE.Mesh(new THREE.PlaneGeometry(7, 50), roadMat);
deanRoad.rotation.x = -Math.PI / 2;
deanRoad.position.set(0, 0.004, -5);
deanRoad.receiveShadow = true;
scene.add(deanRoad);

// Greek Street road (runs along X — east from junction)
var greekRoad = new THREE.Mesh(new THREE.PlaneGeometry(40, 7), roadMatX);
greekRoad.rotation.x = -Math.PI / 2;
greekRoad.position.set(15, 0.004, 0);
greekRoad.receiveShadow = true;
scene.add(greekRoad);

// Wet road reflections — glistening after rain, covers most of the visible road
var wetMat = new THREE.MeshStandardMaterial({
  color: 0x111115, roughness: 0.08, metalness: 0.6, transparent: true, opacity: 0.4
});
var wetRoad = new THREE.Mesh(new THREE.PlaneGeometry(30, 30), wetMat);
wetRoad.rotation.x = -Math.PI / 2;
wetRoad.position.set(2, 0.025, 0);
scene.add(wetRoad);

// Second wet sheen closer to camera — stronger reflection in foreground
var wetMat2 = new THREE.MeshStandardMaterial({
  color: 0x0a0a10, roughness: 0.05, metalness: 0.7, transparent: true, opacity: 0.25
});
var wetRoad2 = new THREE.Mesh(new THREE.PlaneGeometry(12, 10), wetMat2);
wetRoad2.rotation.x = -Math.PI / 2;
wetRoad2.position.set(1, 0.028, 4);
scene.add(wetRoad2);

// ============================================================
// PAVEMENTS — raised kerbs
// ============================================================
// West side of Dean St (where the lamp stands)
var deanPaveW = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.15, 35), paveMat);
deanPaveW.position.set(-5.25, 0.075, -5);
deanPaveW.receiveShadow = true;
scene.add(deanPaveW);
var deanKerbW = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.18, 35), kerbMat);
deanKerbW.position.set(-4, 0.09, -5);
scene.add(deanKerbW);

// East side of Dean St
var deanPaveE = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.15, 35), paveMat);
deanPaveE.position.set(5.25, 0.075, -5);
deanPaveE.receiveShadow = true;
scene.add(deanPaveE);
var deanKerbE = new THREE.Mesh(new THREE.BoxGeometry(0.15, 0.18, 35), kerbMat);
deanKerbE.position.set(4, 0.09, -5);
scene.add(deanKerbE);

// North side of Greek St (pub side)
var greekPaveN = new THREE.Mesh(new THREE.BoxGeometry(30, 0.15, 2.5), paveMat);
greekPaveN.position.set(15, 0.075, -5.25);
greekPaveN.receiveShadow = true;
scene.add(greekPaveN);
var greekKerbN = new THREE.Mesh(new THREE.BoxGeometry(30, 0.18, 0.15), kerbMat);
greekKerbN.position.set(15, 0.09, -4);
scene.add(greekKerbN);

// South side of Greek St
var greekPaveS = new THREE.Mesh(new THREE.BoxGeometry(30, 0.15, 2.5), paveMat);
greekPaveS.position.set(15, 0.075, 5.25);
greekPaveS.receiveShadow = true;
scene.add(greekPaveS);
var greekKerbS = new THREE.Mesh(new THREE.BoxGeometry(30, 0.18, 0.15), kerbMat);
greekKerbS.position.set(15, 0.09, 4);
scene.add(greekKerbS);

// Corner pavement (where the lamp and Red stand)
var cornerPave = new THREE.Mesh(new THREE.BoxGeometry(4, 0.15, 4), paveMat);
cornerPave.position.set(-4, 0.075, -4);
cornerPave.receiveShadow = true;
scene.add(cornerPave);

// ============================================================
// ROAD & PAVEMENT DETAIL
// ============================================================

// Cast kerb-stone joints, with occasional small spalls in the exposed edge.
[-1,1].forEach(function(side){for(var joint=0;joint<18;joint++){var z=-14+joint*1.25;exterior.mesh(scene,new THREE.BoxGeometry(0.152,0.002,0.007),exterior.material(0x4b4c43,false),side*4,0.181,z);if(joint%4===0){var chip=exterior.mesh(scene,new THREE.SphereGeometry(1,8,5),exterior.material(0x57584e,false),side*3.925,0.12,z+0.12);chip.scale.set(0.003,0.018,0.04);}}});
// --- ROAD TEXTURE: centre line (worn white paint, Dean Street) ---
var centreLine = new THREE.MeshStandardMaterial({
  color: 0x888878, roughness: 0.8, transparent: true, opacity: 0.25
});
centreLine.map=exterior.texture(function(c,w,h){c.fillStyle='#eee9d9';c.fillRect(0,0,w,h);c.globalCompositeOperation='destination-out';for(var flake=0;flake<600;flake++){c.fillStyle=flake%3?'rgba(0,0,0,0.7)':'rgba(0,0,0,1)';c.fillRect(flake*47%w,flake*83%h,1+flake%6,1+flake%3);}});centreLine.needsUpdate=true;
// Dashed centre line running north along Dean St
for (var cl = 0; cl < 8; cl++) {
  var dash = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.01, 1.8), centreLine);
  dash.position.set(0, 0.02, -2 - cl * 3.5);
  scene.add(dash);
}

// --- ROAD TEXTURE: manhole covers ---
var manholeMat = new THREE.MeshStandardMaterial({
  color: 0x1a1a1a, roughness: 0.55, metalness: 0.5
});
// Large round manhole near junction (use BoxGeometry to avoid z-fighting)
var manhole1 = new THREE.Mesh(new THREE.CylinderGeometry(0.35, 0.35, 0.03, 32), manholeMat);
manhole1.position.set(-1.5, 0.02, 1.5);
scene.add(manhole1);
exterior.tread(scene,-1.5,0.038,1.5,0.65,0.65,true);
// Manhole rim
var manholeRim1 = new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.03, 8, 40), manholeMat);
manholeRim1.rotation.x = -Math.PI / 2;
manholeRim1.position.set(-1.5, 0.035, 1.5);
scene.add(manholeRim1);

// Rectangular utility cover on Greek St
var utilCover = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.03, 0.5), manholeMat);
utilCover.position.set(8, 0.02, 0.5);
scene.add(utilCover);
exterior.tread(scene,8,0.038,0.5,0.74,0.44,false);

// --- ROAD TEXTURE: tar patches (irregular darker patches) ---
var tarMat = new THREE.MeshStandardMaterial({
  color: 0x0e0e0e, roughness: 0.9, transparent: true, opacity: 0.5
});
var tarPatches = [
  { x: 1.2, z: -4, sx: 1.5, sz: 0.8 },
  { x: -0.8, z: 3, sx: 0.9, sz: 1.2 },
  { x: 2.5, z: -8, sx: 1.1, sz: 0.6 },
  { x: 12, z: -0.5, sx: 0.7, sz: 1.0 }
];
for (var tp = 0; tp < tarPatches.length; tp++) {
  var patchShape=new THREE.Shape();for(var corner=0;corner<16;corner++){var angle=corner/16*Math.PI*2,r=0.46+0.04*Math.sin(corner*2.7+tp);var x=Math.cos(angle)*tarPatches[tp].sx*r,z=Math.sin(angle)*tarPatches[tp].sz*r;if(!corner)patchShape.moveTo(x,z);else patchShape.lineTo(x,z);}patchShape.closePath();
var patch=new THREE.Mesh(new THREE.ShapeGeometry(patchShape),tarMat);patch.rotation.x=-Math.PI/2;
  patch.position.set(tarPatches[tp].x, 0.015, tarPatches[tp].z);
  scene.add(patch);
}

// --- PAVEMENT TEXTURE: paving slab grid (scored lines) ---
var slabLineMat = new THREE.MeshStandardMaterial({
  color: 0x333330, roughness: 0.9
});
// Grid lines on west pavement near camera (visible area)
for (var sl = 0; sl < 10; sl++) {
  // Lines running along the pavement (Z direction)
  var slabZ = new THREE.Mesh(new THREE.PlaneGeometry(0.02, 2.5), slabLineMat);
  slabZ.rotation.x = -Math.PI / 2;
  slabZ.position.set(-4.5 - sl * 0.25, 0.16, -3.5);
  scene.add(slabZ);
}
for (var sl = 0; sl < 12; sl++) {
  // Cross lines (X direction) creating individual slabs
  var slabX = new THREE.Mesh(new THREE.PlaneGeometry(2.5, 0.02), slabLineMat);
  slabX.rotation.x = -Math.PI / 2;
  slabX.position.set(-5.25, 0.16, -1 - sl * 0.6);
  scene.add(slabX);
}

// --- PAVEMENT DETAIL: gutter channel along kerbs ---
var gutterMat = new THREE.MeshStandardMaterial({
  color: 0x2a2a2a, roughness: 0.7, metalness: 0.2
});
// West kerb gutter
var gutterW = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.01, 20), gutterMat);
gutterW.position.set(-3.85, 0.005, -5);
scene.add(gutterW);
// East kerb gutter
var gutterE = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.01, 20), gutterMat);
gutterE.position.set(3.85, 0.005, -5);
scene.add(gutterE);

// --- EXTRA DRAIN COVERS (raised to avoid z-fighting) ---
// Drain near the kerb at the junction
var drain2 = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.04, 0.3), drainMat);
drain2.position.set(-3.8, 0.03, -1);
scene.add(drain2);
var drainFrame=exterior.group(scene,-3.8,0.054,-1);drainFrame.rotation.x=-Math.PI/2;exterior.screws(drainFrame,[[-0.225,-0.125,0],[0.225,-0.125,0],[-0.225,0.125,0],[0.225,0.125,0]],0.009);
// Drain slots (lines across the cover)
for (var ds = 0; ds < 4; ds++) {
  var slot = new THREE.Mesh(
    new THREE.BoxGeometry(0.35, 0.005, 0.02),
    new THREE.MeshStandardMaterial({ color: 0x0a0a0a })
  );
