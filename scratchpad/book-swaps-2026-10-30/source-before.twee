    draw();
  }
  function update() {
    root.querySelector('.cards-deck').textContent = String(DECK-used);
    root.querySelector('.cards-built').textContent = liveCount()+' / '+slots.length;
    root.querySelector('.cards-angle').textContent = finalAt || ended || (houseReady && editing<0) ? '—' : Math.round(angle)+'°';
    root.querySelector('.cards-place').disabled = !!finalAt || ended;
    root.querySelector('.cards-place').textContent = editing>=0?'Move card':houseReady?'Face the roar':'Place card';
    cancel.hidden = editing < 0;
  }
  function tilt(delta) {
    var i = editing >= 0 ? editing : active;
    if (!running || ended || finalAt || i < 0 || document.hidden) return;
    angle = clamp(angle+delta,slots[i].kind==='bridge'?-25:30,slots[i].kind==='bridge'?25:100);
    update(); draw();
  }
  function slide(delta) {
    var i=editing>=0?editing:active;
