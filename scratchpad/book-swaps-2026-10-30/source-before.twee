}, 160);
}
var camMode = 'idle', camK = 0, camNext = 'idle', activeSpot = null, hoverSpot = null, cardShownAt = 0, byKey = false, lastKeyBtn = null, openedByKey = false, keysRow = null, returnFocusSpot = null;
// a span that acts as a button: reachable by Tab, pressed by Enter or Space
function keyable(b) {
