:: Fetch Street SVG {"position":"1650,0","size":"100,100"}
<!-- The Fetch meeting animation: the window ghost, out of the glass. Same
     silhouette language extended to a long coat; approach (0.8-6.8s, walk
     bob), the grin (the mouth-line curving, 8.3-10.6s, slight head tilt),
     the turn (scaleX narrowing), recession toward Centre Point (11.3-17.8s),
     then he stands small beside the tower, waiting, above the Follow him link.
     Flattened single line + SMIL: survives Harlowe hooks. -->
<svg class="fetch-street" viewBox="0 0 300 306" width="100%" style="max-width:430px;display:block;margin:0.8em auto;" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="You see yourself walking to meet you. It looks at you with a shit-eating grin then turns away and heads towards Centre Point."><defs><filter id="fsBlurBig" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="7"/></filter><filter id="fsBlurMid" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="1.5"/></filter><filter id="fsBlurSoft" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="1.2"/></filter><linearGradient id="fsSky" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#37454f"/><stop offset="42%" stop-color="#8a9ca6"/><stop offset="100%" stop-color="#bcc9cf"/></linearGradient><linearGradient id="fsGround" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#a3b3ba"/><stop offset="55%" stop-color="#7d8f99"/><stop offset="100%" stop-color="#55636d"/></linearGradient><linearGradient id="fsTowerFade" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#bcc9cf" stop-opacity="0.95"/><stop offset="100%" stop-color="#bcc9cf" stop-opacity="0"/></linearGradient><radialGradient id="fsLamp" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ffbe6e" stop-opacity="0.42"/><stop offset="100%" stop-color="#ffbe6e" stop-opacity="0"/></radialGradient><radialGradient id="fsEdge" cx="50%" cy="48%" r="70%"><stop offset="42%" stop-color="#ffffff"/><stop offset="100%" stop-color="#000000"/></radialGradient><mask id="fsMask"><rect x="0" y="0" width="300" height="240" fill="url(#fsEdge)"/></mask><linearGradient id="fsTowerRefl" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#5e707a" stop-opacity="0.3"/><stop offset="100%" stop-color="#5e707a" stop-opacity="0"/></linearGradient><radialGradient id="fsVig" cx="50%" cy="46%" r="72%"><stop offset="58%" stop-color="#000000" stop-opacity="0"/><stop offset="100%" stop-color="#000000" stop-opacity="0.22"/></radialGradient><pattern id="fsGrid" width="6" height="7" patternUnits="userSpaceOnUse"><path d="M0,0 L6,0 M0,0 L0,7" stroke="#6d7f88" stroke-width="0.7" opacity="0.5"/></pattern></defs><g filter="url(#dss-ink)"><g opacity="0" mask="url(#fsMask)"><animate attributeName="opacity" values="0;1" dur="1.2s" fill="freeze"/><rect x="0" y="0" width="300" height="148" fill="url(#fsSky)"/><rect x="0" y="148" width="300" height="92" fill="url(#fsGround)"/><g><rect x="161" y="20" width="22" height="128" rx="2" fill="#6e8089" opacity="0.5"/><rect x="161" y="20" width="22" height="128" rx="2" fill="url(#fsGrid)" opacity="0.45"/><circle cx="172" cy="17" r="1.3" fill="#ff3a2a" opacity="0.2"><animate attributeName="opacity" values="0.2;0.2;0.95;0.2;0.2" keyTimes="0;0.7;0.78;0.86;1" dur="4s" repeatCount="indefinite"/></circle><rect x="163" y="148" width="18" height="52" fill="url(#fsTowerRefl)" filter="url(#fsBlurMid)"/><rect x="158" y="16" width="28" height="64" fill="url(#fsTowerFade)"/></g><path d="M36,240 L155,150" stroke="#74868f" stroke-width="1.2" opacity="0.35" fill="none"/><path d="M264,240 L190,150" stroke="#74868f" stroke-width="1.2" opacity="0.35" fill="none"/><path d="M34,104 L34,148" stroke="#2a3238" stroke-width="1.4" opacity="0.5" stroke-linecap="round"/><path d="M30,104 L38,104" stroke="#2a3238" stroke-width="1.2" opacity="0.5" stroke-linecap="round"/><circle cx="34" cy="106" r="2.2" fill="#ffd9a0" opacity="0.85" filter="url(#fsBlurSoft)"/><circle cx="34" cy="110" r="46" fill="url(#fsLamp)"/><ellipse cx="34" cy="176" rx="5" ry="26" fill="#ffbe6e" opacity="0.16" filter="url(#fsBlurSoft)"/><g opacity="0.16" filter="url(#fsBlurSoft)"><ellipse cx="96" cy="182" rx="38" ry="1.6" fill="#dfe9ee"/><ellipse cx="212" cy="204" rx="52" ry="1.9" fill="#dfe9ee"/><ellipse cx="128" cy="226" rx="70" ry="2.2" fill="#dfe9ee"/></g><ellipse cx="230" cy="52" rx="95" ry="36" fill="#e6eef1" opacity="0.45" filter="url(#fsBlurBig)"><animateTransform attr