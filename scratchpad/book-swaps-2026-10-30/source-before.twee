    if ((hubFlag('next') + '|' + hubFlag('next2')) !== lastNextId) { placeNextArrow(cx, cy); refreshBar(); }
    x.clearRect(0, 0, W, H);
    drawSky(x, doors, S.cam.x);
    // 2026-10-14 overnight: the street and its glow were drawn unclipped, so whenever the camera was off the top row they
