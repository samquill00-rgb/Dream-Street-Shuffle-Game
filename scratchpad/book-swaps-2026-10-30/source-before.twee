  return { current: current, set: set, pool: pool, history: history, line: line, page: page, list: load };
})();
// 2026-10-14: the manuscript's other fates (Book Footer, The Deal). dssBookNote puts the footer's note on a slip, with
// Get Directions to where the book is; dssBookDeal reveals LACKLAND's "Ask him to take it on" only on a later night, after
// SHANA's six months (her slip from an earlier night), with at least four refusals filed across the nights.
window.dssBookNote = function() {
  /* 2026-10-24 sweep: the after-image clones the page just left into .dss-ghost, hidden note and all, so the next page found the clone (no _bn on it) and raised the note a second time; on the Maritime interlude that second slip had no passage to go with and stayed up all night (played live: "Your book is still at the French" rode through the Pillars, the cellar and the fight). Clones are skipped. */
  var src = Array.prototype.filter.call(document.querySelectorAll('.book-note-src'), function(s) { return !s.closest('.dss-ghost'); })[0]; if (!src || src._bn) return; src._bn = true;
  var go = src.getAttribute('data-go');
  if (window.dssInlineHint) window.dssInlineHint(src.innerHTML, go ? { go: go } : {});
};
window.dssBookDeal = function() {
  var box = document.querySelector('.book-deal'); if (!box || box._bd) return; box._bd = true;
  var list = (window.dssRefusals && window.dssRefusals.list()) || [], n = window.dssRefusals ? window.dssRefusals.night() : 0, first = 0;
  try { first = +localStorage.getItem('dssRunFirst') || 0; } catch (e) {} list = list.filter(function(r) { return r.n >= first; }); /* 2026-10-25 (Sam): the Deal counts this run's refusals only, the "Last night:" rule */
  var shanaBefore = list.some(function(r) { return r.k === 'shana' && r.n < n; });
  var refused = list.filter(function(r) { return !r.near && !r.yes; }).length;
  if (n >= 2 && shanaBefore && refused >= 4) box.hidden = false;
};
window.dssRingHold = (function() {
  function roomWords(card) {
    var root = card.closest('.dss-room-prose') || card.closest('tw-passage');
    if (!root) return 0;
    var n = 0, w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    while (w.nextNode()) {
      var t = w.currentNode, pe = t.parentNode;
      if (!t.nodeValue.trim() || !pe || pe.nodeType !== 1) continue;
      if (pe.closest('.phone-ringing, tw-link, script, style, tw-include, .dss-claimed, .dss-claimed-wrap, .dss-key-offer, .prose-tilde')) continue;
      if (!pe.getClientRects().length) continue;
      n += t.nodeValue.replace(/\s+/g, ' ').trim().length;
    }
    return n;
  }
  function release(card) {
    if (!card.classList.contains('ring-wait')) return;
    card.classList.remove('ring-wait');
    if (card._dssRingT) clearTimeout(card._dssRingT);
    if (card.isConnected && window.dssAudio && window.dssAudio.phoneBell) window.dssAudio.phoneBell(3);
  }
  function hold(card) {
    if (card._dssRingT) clearTimeout(card._dssRingT);
    card._dssRingT = setTimeout(function() { release(card); }, Math.min(7000, 2000 + roomWords(card) * 30));
  }
  function scan() {
    Array.prototype.forEach.call(document.querySelectorAll('.phone-ringing'), function(card) {
      var root = card.closest('.dss-room-prose') || card.closest('tw-passage');
      if (card._dssRingSeen) {
        // a 3D room lifts the words into its opening box once it has loaded: the reading beat starts again from there
        if (card.classList.contains('ring-wait') && root !== card._dssRoot) { card._dssRoot = root; hold(card); }
        return;
      }
      card._dssRingSeen = true; card._dssRoot = root;
      if (card.classList.contains('ring-now')) { setTimeout(function() { if (card.isConnected && window.dssAudio && window.dssAudio.phoneBell) window.dssAudio.phoneBell(3); }, 250); return; } // brought in by a scene when it is time (the Ham's verdict)
      if (!roomWords(card)) return;
      card.classList.add('ring-wait');
      hold(card);
      // in a 3D room, closing the opening box (its words put away) lets the phone ring straight away
      var watchT = setInterval(function() {
        if (!card.isConnected || !card.classList.contains('ring-wait')) { clearInterval(watchT); return; }
        var panel = card.closest('.dss-room-prose');
        if (!panel) return;
        if (!panel.classList.contains('dss-room-prose-away')) { card._dssPanelSeen = true; return; }
        if (card._dssPanelSeen) { clearInterval(watchT); release(card); }
      }, 250);
    });
  }
  var queued = false;
