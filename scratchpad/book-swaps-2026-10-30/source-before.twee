  function drawGates(x, cx, cy) {
    x.save();
    // the wall: the top edge and the right edge, each a low parapet of two lines, broken at the gates
    x.strokeStyle = 'rgba(214,190,150,0.5)'; x.lineWidth = 2;
    x.beginPath(); x.moveTo(0, 1); x.lineTo(17 * T, 1); x.moveTo(19 * T, 1); x.lineTo(COLS * T, 1); x.stroke();
    x.beginPath(); x.moveTo(COLS * T - 1, 0); x.lineTo(COLS * T - 1, 38 * T); x.moveTo(COLS * T - 1, 39 * T); x.lineTo(COLS * T - 1, ROWS * T); x.stroke();
    x.strokeStyle = 'rgba(214,190,150,0.16)'; x.lineWidth = 1;
    x.beginPath(); x.moveTo(0, 4.5); x.lineTo(17 * T, 4.5); x.moveTo(19 * T, 4.5); x.lineTo(COLS * T, 4.5); x.stroke();
    x.beginPath(); x.moveTo(COLS * T - 4.5, 0); x.lineTo(COLS * T - 4.5, 38 * T); x.moveTo(COLS * T - 4.5, 39 * T); x.lineTo(COLS * T - 4.5, ROWS * T); x.stroke();
