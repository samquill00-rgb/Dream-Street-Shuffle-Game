cx.fillStyle = '#c83a5a'; cx.beginPath(); cx.moveTo(w, h * 0.62); cx.lineTo(w, h); cx.lineTo(w * 0.6, h); cx.closePath(); cx.fill();
cx.fillStyle = '#e8b49a'; cx.beginPath(); cx.moveTo(w, h * 0.76); cx.lineTo(w, h); cx.lineTo(w * 0.78, h); cx.closePath(); cx.fill();
cx.strokeStyle = 'rgba(210, 190, 160, 0.7)'; cx.lineWidth = 2; cx.beginPath(); cx.moveTo(w, h * 0.62); cx.lineTo(w * 0.86, h * 0.78); cx.lineTo(w * 0.6, h); cx.stroke();
cx.strokeStyle = '#c9b48a'; cx.lineWidth = 5; cx.beginPath(); cx.moveTo(w * 0.5, 0); cx.lineTo(w * 0.5, h); cx.moveTo(0, h * 0.5); cx.lineTo(w, h * 0.5); cx.stroke();
});
