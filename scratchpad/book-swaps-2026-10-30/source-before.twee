// 2026-10-14 (Sam): THE RUMOUR, the Great Ham's whispered speech on a card of its own (the LORE card's look); it opens a
// moment after the page, and the small link in the line before it opens it again
window.dssRumourCard = function() {
  var src = document.querySelector('.rumour-text'), opener = document.querySelector('.rumour-open');
  if (!src || src._rc) return; src._rc = true;
  /* 2026-10-19 (Sam, playtest: "this rumour needs to be made MUCH more of, it's so easy to click by"): the first time it opens, the page goes
     darker, a breath, and his speech comes a paragraph at a time; a click or a key brings the next, and nothing closes it until his last
     line, when one button puts it away. Opened again from the line's small link, it shows whole, as before. His words unchanged. */
  var stage = null;
  function close() { stage = null; var o = document.getElementById('dss-lore-overlay'); if (o) { o.classList.add('out'); setTimeout(function() { if (o.parentNode) o.parentNode.removeChild(o); }, 250); } document.removeEventListener('keydown', onKey, true); }
  function onKey(ev) {
