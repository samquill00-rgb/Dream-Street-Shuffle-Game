    var clipCols = [0x8a1c1c, 0x2e6a3a, 0xc8a040, 0x1c3a8a, 0x222222, 0xe8e0c0];
    var ci = 0;
    for (var px = -2.4; px <= 2.4; px += 0.6, ci++) {
      cyl(0.03, 0.04, 0.42, 8, pumpMat, px, 1.4, -11.7);
      box(0.09, 0.12, 0.02, new THREE.MeshStandardMaterial({ color: clipCols[ci % clipCols.length] }), px, 1.58, -11.63, { cast: false });
      cyl(0.05, 0.05, 0.08, 10, new THREE.MeshStandardMaterial({ color: 0xd0d0d0, metalness: 0.9, roughness: 0.2 }), px, 1.2, -11.7);
    }
    // till glow and a fridge
    var till = box(0.5, 0.3, 0.4, new THREE.MeshStandardMaterial({ color: 0x1a1a1e, roughness: 0.4 }), 3.6, 1.32, -11.9);
    var tillScreen = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 0.22), new THREE.MeshBasicMaterial({ color: 0x8ab8e0 })); tillScreen.position.set(3.6, 1.36, -11.69); tillScreen.rotation.x = -0.3; scene.add(tillScreen);
    var tl = new THREE.PointLight(0x8ab8e0, 0.4, 2.5, 2); tl.position.set(3.6, 1.5, -11.5); (function(){})(tl); /* 2026-10-14 (speed): left out; 40 point lights ran this scene at ~9 fps, and its bulb and glow sprite carry the look */
    glowSprite('rgba(140,190,240,', 0.9, 3.6, 1.42, -11.6).material.opacity = 0.6;
    box(1.2, 0.9, 0.6, new THREE.MeshStandardMaterial({ color: 0x2a2a2e, roughness: 0.4, metalness: 0.5 }), -3.8, 0.45, -13.6);
    var fridgeGlass = new THREE.Mesh(new THREE.PlaneGeometry(1.1, 0.8), new THREE.MeshStandardMaterial({ color: 0xbfe0ff, emissive: 0x6090c0, emissiveIntensity: 0.5, transparent: true, opacity: 0.6 })); fridgeGlass.position.set(-3.8, 0.45, -13.29); scene.add(fridgeGlass);
    for (var fx = -4.25; fx <= -3.35; fx += 0.15) for (var fy = 0.2; fy <= 0.7; fy += 0.25) cyl(0.035, 0.035, 0.2, 8, new THREE.MeshStandardMaterial({ color: [0x66aa66, 0xaa8844, 0x6688cc][Math.floor(Math.random() * 3)], roughness: 0.2 }), fx, fy, -13.45);
    var fl = new THREE.PointLight(0x8ab8ff, 0.5, 3, 2); fl.position.set(-3.8, 0.5, -13.2); (function(){})(fl); /* 2026-10-14 (speed): left out; 40 point lights ran this scene at ~9 fps, and its bulb and glow sprite carry the look */
    glowSprite('rgba(150,200,255,', 1.6, -3.8, 0.5, -13.25).material.opacity = 0.55;
    // back-bar: shelves of bottles under a mirror, lit from beneath
    var shelfMat = new THREE.MeshStandardMaterial({ color: 0x3a2618, roughness: 0.6 });
    var glassMats = [0x66aa66, 0xaa8844, 0xcc9944, 0x6688cc, 0xddddcc, 0x884422, 0xcc4444].map(function(c) { return new THREE.MeshStandardMaterial({ color: c, roughness: 0.12, metalness: 0.1, transparent: true, opacity: 0.85 }); });
    for (var s = 0; s < 3; s++) {
      var y = 1.5 + s * 0.55;
      box(9, 0.04, 0.3, shelfMat, 0, y, -13.85, { cast: false });
      for (var bx = -4.3; bx <= 4.3; bx += 0.24) {
        var hgt = 0.26 + Math.random() * 0.14;
        cyl(0.035, 0.045, hgt, 8, glassMats[Math.floor(Math.random() * glassMats.length)], bx + rand(-0.03, 0.03), y + hgt / 2 + 0.02, -13.85 + rand(-0.05, 0.05));
        cyl(0.014, 0.014, 0.08, 6, glassMats[0], bx, y + hgt + 0.06, -13.85);
      }
      if (s === 1) { var strip = new THREE.PointLight(0xffc888, 0.8, 7, 2); strip.position.set(-3 + s * 3, y + 0.35, -13.5); scene.add(strip); } /* 2026-10-14 (speed): one strip light, not one a shelf */
      for (var hx = -3.6; hx <= 3.6; hx += 1.8) glowSprite('rgba(255,200,130,', 1.1, hx, y + 0.12, -13.7).material.opacity = 0.45;
    }
    var mirror = new THREE.Mesh(new THREE.PlaneGeometry(9, 1.6), new THREE.MeshStandardMaterial({ color: 0x556070, roughness: 0.04, metalness: 0.95 })); mirror.position.set(0, 2.25, -13.98); scene.add(mirror);
    // hanging glass rack above the bar
    var rackMat = new THREE.MeshStandardMaterial({ color: 0x3a2618, roughness: 0.6 });
    box(6, 0.06, 0.5, rackMat, 0, 2.5, -11.9, { cast: false });
    for (var gx = -2.8; gx <= 2.8; gx += 0.2) { cyl(0.04, 0.02, 0.18, 8, glassMat, gx, 2.38, -11.85); }
    // The four clocks. Three are wrong.
    var clocks = [[-3.6, 21, 40, 'LONDON'], [-1.2, 2, 10, 'DELHI'], [1.2, 11, 25, 'KATHMANDU'], [3.6, 6, 5, 'CAIRO']];
    clocks.forEach(function(c) {
      var m = new THREE.Mesh(new THREE.PlaneGeometry(0.62, 0.62), new THREE.MeshBasicMaterial({ map: clockTex(c[1], c[2], c[3]), transparent: true }));
      m.position.set(c[0], 3.45, -13.96); scene.add(m);
    });
    addSpot(0, 3.9, -11.5, 0, 3.4, -14, 0xffe0b0, 1.0, 0.9, 8);
    // TV screen high on the back wall, right of the bar, showing the departures
    var tv = box(1.5, 0.95, 0.06, new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 0.3 }), 5.6, 3.05, -13.96, { cast: false });
    var tvScreen = new THREE.Mesh(new THREE.PlaneGeometry(1.4, 0.85), new THREE.MeshBasicMaterial({ map: departuresTex })); tvScreen.position.set(5.6, 3.05, -13.92); scene.add(tvScreen);
    var tvl = new THREE.PointLight(0xffb050, 0.45, 4, 2); tvl.position.set(5.6, 3.0, -13.4); /* 2026-10-14 (speed): left out; its bulb and glow sprite carry the look */
    glowSprite('rgba(255,190,100,', 2.0, 5.6, 3.05, -13.85).material.opacity = 0.5;
    // one figure standing at the bar
    var st = new THREE.Sprite(new THREE.SpriteMaterial({ map: figureTex(false, 0.7), transparent: true, depthWrite: false }));
    st.scale.set(0.8, 1.75, 1); st.position.set(-1.6, 0.9, -11.1); scene.add(st);
    figures.push({ sprite: st, baseX: -1.6, phase: 1, speed: 0.4, amt: 0.02 });
  })();

  // Bunting on a string across the bay
  var bunting = [];
  (function() {
    var cols = [0xd8b040, 0xb03030, 0xe8e0c0, 0x2e6a8a];
    var n = 30, pts = [];
    for (var i = 0; i < n; i++) {
      var t = i / (n - 1), x = -6.4 + t * 12.8, y = 3.12 - Math.sin(t * Math.PI) * 0.3;
      pts.push(new THREE.Vector3(x, y, -0.6));
      var flag = new THREE.Mesh(new THREE.ConeGeometry(0.08, 0.2, 3), new THREE.MeshLambertMaterial({ color: cols[i % cols.length], side: THREE.DoubleSide }));
      flag.rotation.x = Math.PI; flag.rotation.y = Math.PI / 6; flag.position.set(x, y - 0.1, -0.6); scene.add(flag); bunting.push({ m: flag, ph: i * 0.45 });
    }
    scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), new THREE.LineBasicMaterial({ color: 0x8a8070 })));
  })();

  // Clickable volume for the pub bay
  (function() {
    var vol = new THREE.Mesh(new THREE.BoxGeometry(12, 3.2, 8), new THREE.MeshBasicMaterial({ transparent: true, opacity: 0, depthWrite: false }));
    vol.position.set(0, 1.6, -4); scene.add(vol);
    makeClickable(vol, { name: 'The Enlightenment', passage: 'Airport Pub' });
  })();

  // ============================================================
  // FOG LAYERS (concourse haze, cool; warm haze at the threshold)
  // ============================================================
  function fogTex(r, g, b, a) {
    return canvasTex(128, 128, function(ctx) {
      var gr = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
      gr.addColorStop(0, 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')'); gr.addColorStop(0.45, 'rgba(' + r + ',' + g + ',' + b + ',' + (a * 0.45) + ')'); gr.addColorStop(1, 'rgba(' + r + ',' + g + ',' + b + ',0)');
      ctx.fillStyle = gr; ctx.fillRect(0, 0, 128, 128);
    });
  }
  var coolFog = fogTex(150, 160, 185, 0.22), thinFog = fogTex(130, 138, 160, 0.14), warmFog = fogTex(210, 165, 105, 0.13);
  var fogSprites = [];
  function addFog(tex, n, x0, x1, y0, y1, z0, z1, s0, s1, op0, op1, aspect) {
    for (var i = 0; i < n; i++) {
      var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false, opacity: rand(op0, op1) }));
      var s = rand(s0, s1); sp.scale.set(s, s * aspect, 1);
      sp.position.set(rand(x0, x1), rand(y0, y1), rand(z0, z1)); scene.add(sp);
      fogSprites.push({ sprite: sp, baseX: sp.position.x, drift: rand(0.0015, 0.005), sway: rand(0, 6.3), swaySpeed: rand(0.0008, 0.003), swayAmt: rand(0.3, 1.2), lo: x0 - 6, hi: x1 + 6 });
    }
  }
  addFog(coolFog, 44, -30, 18, 0.2, 1.6, 1, 30, 5, 12, 0.18, 0.36, 0.35);   // ground haze along the concourse
  addFog(thinFog, 30, -30, 16, 1.8, 4.8, 2, 30, 7, 14, 0.1, 0.2, 0.3);   // mid, under the troffers
  addFog(warmFog, 14, -6, 7, 0.4, 3.2, -1, 3, 4, 8, 0.12, 0.22, 0.3);      // warm haze at the threshold, under the sign
  addFog(thinFog, 12, -10, 10, 2.5, 4.2, -13, -3, 5, 10, 0.05, 0.12, 0.3); // a little smoke-haze inside the bay
  addFog(coolFog, 10, -14, 14, 0.3, 2.0, 8, 28, 10, 18, 0.16, 0.26, 0.3);   // the far end fades out

  // The concourse falls away: columns, a far bulkhead, seating islands receding
  (function() {
    var colMat = new THREE.MeshStandardMaterial({ color: 0x8e8c86, roughness: 0.6, metalness: 0.2 });
    for (var z = 6; z <= 30; z += 8) { cyl(0.32, 0.32, 5.6, 16, colMat, -9, 2.8, z); cyl(0.32, 0.32, 5.6, 16, colMat, 9.5, 2.8, z); box(0.9, 0.06, 0.9, colMat, -9, 0.03, z, { cast: false }); box(0.9, 0.06, 0.9, colMat, 9.5, 0.03, z, { cast: false }); }
    var seatMat = new THREE.MeshStandardMaterial({ color: 0x2a3440, roughness: 0.7 }), seatFrame = new THREE.MeshStandardMaterial({ color: 0x8a8e94, roughness: 0.4, metalness: 0.7 });
    for (var z = 12; z <= 26; z += 7) { box(3.2, 0.08, 0.5, seatMat, -3, 0.46, z); box(3.2, 0.4, 0.06, seatMat, -3, 0.72, z - 0.24); box(3.2, 0.05, 0.05, seatFrame, -3, 0.2, z); box(0.05, 0.42, 0.05, seatFrame, -4.5, 0.22, z); box(0.05, 0.42, 0.05, seatFrame, -1.5, 0.22, z); }
    var far = new THREE.Mesh(new THREE.PlaneGeometry(60, 5.6), new THREE.MeshStandardMaterial({ color: 0x3a3834, roughness: 0.9 })); far.position.set(0, 2.8, 34); far.rotation.y = Math.PI; scene.add(far);
    // the concourse runs off to the LEFT along the terminal wall: shuttered units, columns, wall lamps receding into the haze
    var shutter = new THREE.MeshStandardMaterial({ color: 0x3c3a36, roughness: 0.6, metalness: 0.4 });
    var lampMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.5, metalness: 0.6 });
    for (var ux = -11; ux >= -36; ux -= 5) {
      box(3.6, 3.0, 0.1, shutter, ux, 1.5, 0.66, { cast: false });
      for (var sy = 0.1; sy < 3; sy += 0.18) box(3.6, 0.03, 0.02, new THREE.MeshStandardMaterial({ color: 0x2a2826 }), ux, sy, 0.72, { cast: false });
      box(3.7, 0.5, 0.12, new THREE.MeshStandardMaterial({ color: 0x1c1a18, roughness: 0.6 }), ux, 3.25, 0.66, { cast: false });
      cyl(0.3, 0.3, 5.6, 14, colMat, ux + 2.5, 2.8, 3.2);
      box(0.12, 0.12, 0.3, lampMat, ux, 3.7, 0.75, { cast: false });
      var wb = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 8), new THREE.MeshBasicMaterial({ color: 0xffe8c0 })); wb.position.set(ux, 3.62, 0.9); scene.add(wb);
      glowSprite('rgba(255,215,160,', 1.6, ux, 3.62, 0.92).material.opacity = 0.6;
      /* 2026-10-14 (speed): left out; its bulb and glow sprite carry the look */
    }
  })();

  // ============================================================
  // ANIMATION
  // ============================================================
  var clock = new THREE.Clock();
  var flipRow = -1, flipT = 0, nextFlip = 4, neonFlick = 1;
  var apShadowF = -1;
  var tickTroffer = troffers[0], flickerT = 0; // troffers[0] is the x=-14, z=3 panel, in frame at the left

  function animate() {
    if (!apActive) return;
    apAnimId = requestAnimationFrame(animate);
    var dt = apStill ? 0 : Math.min(clock.getDelta(), 0.05), t = apStill ? 5 : clock.elapsedTime;
    // 2026-10-14 (speed): three shadow-casting lights re-drew ~1,650 objects into their shadow maps every frame; the
    // shadows are of things that barely move, so they are redrawn one frame in four
    renderer.shadowMap.autoUpdate = false; apShadowF = (apShadowF + 1) % 4; if (apShadowF === 0) renderer.shadowMap.needsUpdate = true;

    for (var i = 0; i < pendants.length; i++) pendants[i].intensity = pendants[i].userData.base * (0.97 + 0.03 * Math.sin(t * 1.3 + i * 1.7));
    for (var i = 0; i < (apStill ? 0 : fogSprites.length); i++) { var f = fogSprites[i]; f.sway += f.swaySpeed; f.sprite.position.x = f.baseX + Math.sin(f.sway) * f.swayAmt; f.baseX += f.drift; if (f.baseX > f.hi) f.baseX = f.lo; }

    // one tired fluorescent tube out on the concourse
    flickerT -= dt;
    if (!apStill && flickerT <= 0) { var dead = Math.random() < 0.45; tickTroffer.material.color.setHex(dead ? 0x1e1e18 : (Math.random() < 0.5 ? 0x8a8870 : 0xd8d4b0)); flickerT = Math.random() < 0.75 ? 0.05 + Math.random() * 0.25 : 1.5 + Math.random() * 3; }
    // the red neon buzzes
    var buzz = (!apStill && Math.random() < 0.03) ? 0.35 : 1.0;
    neonFlick = neonFlick + (buzz - neonFlick) * 0.5;
    subSign.material.opacity = 0.55 + 0.45 * neonFlick; subGlow.intensity = 0.6 * neonFlick; neonSprite.material.opacity = 0.6 * neonFlick;
    apSheen.material.opacity = 0.075 + 0.035 * neonFlick;
    // bunting lifts in the draught from the concourse; pendants swing a little
    for (var b = 0; b < bunting.length; b++) bunting[b].m.rotation.z = Math.sin(t * 1.4 + bunting[b].ph) * 0.22;
    for (var pg = 0; pg < pendantGroups.length; pg++) { var P = pendantGroups[pg]; P.g.rotation.x = Math.sin(t * 0.9 + P.ph) * 0.03; P.g.rotation.z = Math.cos(t * 0.7 + P.ph) * 0.025; }

    // departures: a row flips over now and then, seen on the pub's TV
    if (flipRow < 0) { nextFlip -= dt; if (nextFlip <= 0) { flipRow = Math.floor(Math.random() * departuresRows.length); flipT = 0; } }
    else {
      flipT += dt * 1.6; drawDepartures(flipRow, Math.min(1, flipT)); departuresTex.needsUpdate = true;
      if (flipT >= 1.2) { flipRow = -1; nextFlip = 2 + Math.random() * 4; drawDepartures(-1, 1); departuresTex.needsUpdate = true; }
    }

    // people shift in their seats
    for (var f = 0; f < figures.length; f++) {
      var fg = figures[f]; fg.phase += fg.speed * dt;
      fg.sprite.position.x = fg.baseX + Math.sin(fg.phase) * fg.amt;
      fg.sprite.position.y += (Math.sin(fg.phase * 0.7) * 0.004 - (fg.sprite.position.y - (fg.sprite.scale.y > 1.5 ? 0.9 : 0.72))) * 0.1;
    }

    raycaster.setFromCamera(mouseNDC, camera);
    var hits = mouseMoved ? raycaster.intersectObjects(clickableObjects) : [];
    var hv = hits.length ? venueData.get(hits[0].object) : null;
    if (hv !== hoveredVenue) {
      hoveredVenue = hv;
      if (hv) { tooltip.textContent = hv.name; tooltip.classList.add('visible'); apWrap.style.cursor = 'pointer'; }
      else { tooltip.classList.remove('visible'); apWrap.style.cursor = ''; }
    }

    renderer.render(scene, camera);
  }
  animate();

var apBtn = document.createElement('div');
apBtn.textContent = 'ENTER THE ENLIGHTENMENT';
apBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(212,178,88,0.85);border:1px solid rgba(212,178,88,0.3);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
setTimeout(function() { apBtn.style.opacity = '1'; }, 2200);
apBtn.addEventListener('mouseenter', function() { apBtn.style.borderColor = 'rgba(212,178,88,0.6)'; });
apBtn.addEventListener('mouseleave', function() { apBtn.style.borderColor = 'rgba(212,178,88,0.3)'; });
apBtn.addEventListener('click', function(e) { e.stopPropagation(); apEnter(); });
apWrap.appendChild(apBtn);
document.body.appendChild(apWrap);
if (window.dssFilmGrade) window.dssFilmGrade(apWrap);
}

setInterval(function() {
var container = document.getElementById('ap-container');
if (container && !apActive) {
initap();
} else if (!container && apActive) {
apActive = false;
if (apAnimId) { cancelAnimationFrame(apAnimId); apAnimId = null; }
window._dssDisposeWrap('ap-wrap');
}
}, 300);
})();

// ====== NAZCA APPROACH SCENE — INLINE ======
// Dusk on the coast road. The Pacific going the colour of tin,
// the cantina's one bulb coming on, the Cessna propeller against the wall.
// Ported 2026-09-14 from nazca-approach-3d-static.html, the standalone
// prototype built on 2026-09-12. Standard lifecycle: nz-container / nz-wrap /
// _dssDisposeWrap. The overlay fades in place to reveal the passage prose;
// each world is entered once, from the Third Pillar Portal.
(function() {
var nzActive = false;
var nzAnimId = null;

function initnz() {
if (nzActive) return;
nzActive = true;
if (typeof THREE === 'undefined') {
var sc = document.createElement('script');
sc.src = 'vendor/three/three.min.js';
sc.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildnzScene) : buildnzScene()); };
document.head.appendChild(sc);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildnzScene) : buildnzScene());
}
}

function buildnzScene() {
var nzWrap = document.createElement('div');
nzWrap.id = 'nz-wrap';
nzWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#1b2434;';

// the prototype's fixed labels, re-homed inside the overlay
var nzStamp = document.createElement('div');
nzStamp.textContent = 'PERU';
nzStamp.style.cssText = 'position:absolute;top:18px;right:24px;font:14px "Courier New",monospace;color:rgba(226,170,96,0.5);letter-spacing:2px;pointer-events:none;z-index:9002;';
nzWrap.appendChild(nzStamp);
var nzLoc = document.createElement('div');
nzLoc.classList.add('dss-room-caption');
nzLoc.textContent = 'NAZCA APPROACH';
nzLoc.style.cssText = 'position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New",monospace;color:rgba(226,170,96,0.4);letter-spacing:2px;pointer-events:none;z-index:9002;';
nzWrap.appendChild(nzLoc);
var nzTip = document.createElement('div');
nzTip.style.cssText = 'position:fixed;padding:6px 14px;background:rgba(20,17,16,0.94);border:1px solid rgba(226,170,96,0.45);font:italic 13px Georgia,serif;color:#e8d5b7;pointer-events:none;opacity:0;transition:opacity 0.3s;z-index:9003;';
nzTip.classList.add('nz-tip');
nzWrap.appendChild(nzTip);
// the prototype toggles the tooltip with a .visible class
var nzTipObs = new MutationObserver(function() {
nzTip.style.opacity = nzTip.classList.contains('visible') ? '1' : '0';
});
nzTipObs.observe(nzTip, { attributes: true, attributeFilter: ['class'] });

var nzEntered = false;
function nzEnter() {
if (nzEntered) return;
nzEntered = true;
nzWrap.style.transition = 'opacity 1.6s ease';
nzWrap.style.opacity = '0';
setTimeout(function() {
if (nzAnimId) { cancelAnimationFrame(nzAnimId); nzAnimId = null; }
try { nzTipObs.disconnect(); } catch(e) {}
window._dssDisposeWrap('nz-wrap');
}, 1600);
}

  // ============================================================
  // SCENE SETUP
  // ============================================================
  var scene = new THREE.Scene();
  var fine = window.dssDreamDetail(scene);
  scene.background = new THREE.Color(0x14100e); /* 2026-10-23 (Sam): Nazca, rust and bone under a brown smog, gold sun */
  scene.fog = new THREE.FogExp2(0x5a4234, 0.0072);

  // LAYOUT: the coast road runs away down -z. The Pacific is on the RIGHT (x > 12),
  // below a low bluff, the sun going down into it. The cantina stands on the left
  // verge at z = -20 facing the road. The camera is on the right-hand verge, a
  // little way back, looking down the road on the diagonal: cantina left of centre,
  // sea and sun at the right, the road running off into the blue.
  var camera = new THREE.PerspectiveCamera(58, window.innerWidth / window.innerHeight, 0.1, 800);
  camera.position.set(5.3, 1.7, 5.5);
  camera.lookAt(-2.0, 2.2, -24);

  var renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
  renderer.toneMappingExposure = 0.72;
  nzWrap.appendChild(renderer.domElement);
  renderer.domElement.style.display = 'block';
  window._dssBindScene('nz-wrap', scene, renderer, camera);

  // resize is handled by _dssBindScene above.

  // ============================================================
  // CLICK TO ENTER
  // ============================================================
  var clickableObjects = [], venueData = new Map(), mouseNDC = new THREE.Vector2(-2, -2), mouseMoved = false;
  var raycaster = new THREE.Raycaster(), hoveredVenue = null, tooltip = nzTip;
  function makeClickable(mesh, info) { clickableObjects.push(mesh); venueData.set(mesh, info); }
  nzWrap.addEventListener('mousemove', function(e) {
    mouseMoved = true;
    mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
    tooltip.style.left = (e.clientX + 15) + 'px'; tooltip.style.top = (e.clientY - 30) + 'px';
  });
  nzWrap.addEventListener('click', function() { if (hoveredVenue) nzEnter(); });

  // ============================================================
  // HELPERS
  // ============================================================
  function canvasTex(w, h, draw, rep) {
    var c = document.createElement('canvas'); c.width = w; c.height = h;
    draw(c.getContext('2d'), w, h);
    var t = new THREE.CanvasTexture(c);
    if (rep) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rep[0], rep[1]); }
    t.anisotropy = 8;
    return t;
  }
  function rand(a, b) { return a + Math.random() * (b - a); }
  function mesh(geo, mat, x, y, z, parent) {
    var m = new THREE.Mesh(geo, mat); m.position.set(x, y, z);
    m.castShadow = true; m.receiveShadow = true; (parent || scene).add(m); return m;
  }
  function box(w, h, d, mat, x, y, z, parent) { return mesh(new THREE.BoxGeometry(w, h, d), mat, x, y, z, parent); }
  function cyl(rt, rb, h, seg, mat, x, y, z, parent) { return mesh(new THREE.CylinderGeometry(rt, rb, h, seg), mat, x, y, z, parent); }
  function radialTex(r, g, b, a, mid) {
    return canvasTex(128, 128, function(ctx) {
      var gr = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
      gr.addColorStop(0, 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')');
      gr.addColorStop(mid || 0.4, 'rgba(' + r + ',' + g + ',' + b + ',' + (a * 0.4) + ')');
      gr.addColorStop(1, 'rgba(' + r + ',' + g + ',' + b + ',0)');
      ctx.fillStyle = gr; ctx.fillRect(0, 0, 128, 128);
    });
  }
  function halo(r, g, b, size, x, y, z, opacity, noFog, parent) {
    var m = new THREE.SpriteMaterial({ map: radialTex(r, g, b, 0.9), blending: THREE.AdditiveBlending, transparent: true, depthWrite: false, opacity: opacity || 0.6 });
    if (noFog) m.fog = false;
    var s = new THREE.Sprite(m); s.scale.set(size, size, 1); s.position.set(x, y, z); (parent || scene).add(s); return s;
  }

  // ============================================================
  // SKY: the sun on the sea to the right, the east already blue
  // ============================================================
  var skyTex = canvasTex(2048, 1024, function(ctx, w, h) {
    var g = ctx.createLinearGradient(0, 0, 0, h);
    g.addColorStop(0, '#14100e'); g.addColorStop(0.3, '#2a201a'); g.addColorStop(0.42, '#3a2a22'); g.addColorStop(0.48, '#5a4232'); g.addColorStop(0.52, '#7a5638'); g.addColorStop(0.555, '#b08a4a'); g.addColorStop(0.585, '#8a5432'); g.addColorStop(0.62, '#3a2a22'); g.addColorStop(1, '#14100e');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    // the sun's glow: right-hand quarter of the dome (texture x ≈ 0.62)
    var sx = w * 0.62, sy = h * 0.565;
    var sg = ctx.createRadialGradient(sx, sy, 0, sx, sy, w * 0.22);
    sg.addColorStop(0, 'rgba(245,212,144,0.7)'); sg.addColorStop(0.12, 'rgba(212,174,106,0.4)'); sg.addColorStop(0.4, 'rgba(176,100,58,0.15)'); sg.addColorStop(1, 'rgba(120,70,40,0)');
    ctx.fillStyle = sg; ctx.fillRect(0, 0, w, h);
    var disc = ctx.createRadialGradient(sx, sy, 0, sx, sy, 26);
    disc.addColorStop(0, 'rgba(255,250,235,1)'); disc.addColorStop(0.7, 'rgba(255,230,180,0.9)'); disc.addColorStop(1, 'rgba(255,200,120,0)');
    ctx.fillStyle = disc; ctx.fillRect(0, 0, w, h);
    // long flat clouds, lit underneath
    for (var i = 0; i < 30; i++) {
      var cy = h * 0.44 + Math.random() * h * 0.1, cw = 80 + Math.random() * 400, cx = Math.random() * w;
      ctx.fillStyle = 'rgba(60,50,70,' + (0.15 + Math.random() * 0.25) + ')'; ctx.beginPath(); ctx.ellipse(cx, cy, cw, 3 + Math.random() * 9, 0, 0, 6.3); ctx.fill();
      ctx.fillStyle = 'rgba(255,170,100,' + (0.12 + Math.random() * 0.2) + ')'; ctx.beginPath(); ctx.ellipse(cx, cy + 5, cw * 0.8, 2 + Math.random() * 3, 0, 0, 6.3); ctx.fill();
    }
    // first stars in the east
    for (var s = 0; s < 120; s++) { var stx = Math.random() * w, sty = Math.random() * h * 0.3; if (Math.abs(stx - sx) < w * 0.25) continue; ctx.fillStyle = 'rgba(255,255,255,' + (0.1 + Math.random() * 0.4) + ')'; ctx.beginPath(); ctx.arc(stx, sty, 0.4 + Math.random() * 0.7, 0, 6.3); ctx.fill(); }
  });
  var sky = new THREE.Mesh(new THREE.SphereGeometry(600, 40, 24), new THREE.MeshBasicMaterial({ map: skyTex, side: THREE.BackSide, fog: false }));
  sky.rotation.y = 0.6; scene.add(sky);
  // the sun itself, as sprites out over the sea (right, ahead)
  var SUN = new THREE.Vector3(80, 18, -340);
  var sunCore = halo(255, 240, 200, 26, SUN.x, SUN.y, SUN.z, 1.0, true);
  var sunHalo = halo(255, 170, 90, 160, SUN.x, SUN.y, SUN.z, 0.5, true);
  halo(255, 120, 60, 420, SUN.x, SUN.y - 10, SUN.z, 0.22, true);

  // ============================================================
  // LIGHTING: a long low sun from the right, the sky blue from above
  // ============================================================
  scene.add(new THREE.AmbientLight(0x4a4038, 0.38));
  scene.add(new THREE.HemisphereLight(0x6a5a4a, 0x7a6040, 0.42));
  var sun = new THREE.DirectionalLight(0xd4ae6a, 1.15);
  sun.position.set(90, 11, -150); sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048);
  sun.shadow.camera.left = -60; sun.shadow.camera.right = 60; sun.shadow.camera.top = 40; sun.shadow.camera.bottom = -40;
  sun.shadow.camera.near = 20; sun.shadow.camera.far = 400; sun.shadow.bias = -0.0005;
  scene.add(sun);

  // ============================================================
  // TEXTURES
  // ============================================================
  var pampaTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#b8ac98'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 400; i++) { var v = 160 + Math.random() * 60; ctx.fillStyle = 'rgba(' + Math.floor(v) + ',' + Math.floor(v * 0.94) + ',' + Math.floor(v * 0.82) + ',0.35)'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 8 + Math.random() * 40, 5 + Math.random() * 20, Math.random() * 3, 0, 6.3); ctx.fill(); }
    for (var p = 0; p < 1600; p++) { var pv = 70 + Math.random() * 110; ctx.fillStyle = 'rgb(' + Math.floor(pv) + ',' + Math.floor(pv * 0.9) + ',' + Math.floor(pv * 0.78) + ')'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 0.8 + Math.random() * 3, 0.6 + Math.random() * 2, Math.random() * 3, 0, 6.3); ctx.fill(); }
    for (var c = 0; c < 40; c++) { ctx.strokeStyle = 'rgba(90,80,64,0.25)'; ctx.lineWidth = 1; ctx.beginPath(); var cx0 = Math.random() * w, cy0 = Math.random() * h; ctx.moveTo(cx0, cy0); ctx.lineTo(cx0 + (Math.random() - 0.5) * 60, cy0 + (Math.random() - 0.5) * 60); ctx.stroke(); }
  }, [30, 30]);
  var pampaMat = new THREE.MeshStandardMaterial({ map: pampaTex, roughness: 0.96, color: 0xc8c0b4 });

  var tarmacTex = canvasTex(256, 1024, function(ctx, w, h) {
    ctx.fillStyle = '#4a4744'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 6000; i++) { var v = 50 + Math.random() * 60; ctx.fillStyle = 'rgba(' + v + ',' + v + ',' + (v - 4) + ',0.5)'; ctx.fillRect(Math.random() * w, Math.random() * h, 2, 2); }
    // sun-faded centre line, broken
    for (var y = 0; y < h; y += 120) { ctx.fillStyle = 'rgba(220,200,150,0.45)'; ctx.fillRect(w / 2 - 4, y, 8, 60); }
    // cracks and patches
    ctx.strokeStyle = 'rgba(20,18,16,0.6)'; ctx.lineWidth = 1.5;
    for (var c = 0; c < 30; c++) { ctx.beginPath(); var x0 = Math.random() * w, y0 = Math.random() * h; ctx.moveTo(x0, y0); for (var k = 0; k < 5; k++) { x0 += (Math.random() - 0.5) * 30; y0 += Math.random() * 30; ctx.lineTo(x0, y0); } ctx.stroke(); }
    for (var pt = 0; pt < 8; pt++) { ctx.fillStyle = 'rgba(30,28,26,0.5)'; ctx.fillRect(Math.random() * w, Math.random() * h, 30 + Math.random() * 60, 20 + Math.random() * 50); }
    // pale dust blown across the edges
    var eg = ctx.createLinearGradient(0, 0, w, 0); eg.addColorStop(0, 'rgba(180,170,150,0.5)'); eg.addColorStop(0.15, 'rgba(180,170,150,0)'); eg.addColorStop(0.85, 'rgba(180,170,150,0)'); eg.addColorStop(1, 'rgba(180,170,150,0.5)');
    ctx.fillStyle = eg; ctx.fillRect(0, 0, w, h);
  }, [1, 40]);
  var tarmacMat = new THREE.MeshStandardMaterial({ map: tarmacTex, roughness: 0.62, metalness: 0.1 });

  var adobeTex = canvasTex(512, 256, function(ctx, w, h) {
    ctx.fillStyle = '#d8c8a8'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 3000; i++) { ctx.fillStyle = 'rgba(120,100,70,' + Math.random() * 0.18 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 2 + Math.random() * 4, 2); }
    // render cracked and flaking, a damp tide mark along the base
    ctx.strokeStyle = 'rgba(80,60,40,0.45)'; ctx.lineWidth = 1;
    for (var c = 0; c < 16; c++) { ctx.beginPath(); var x0 = Math.random() * w, y0 = Math.random() * h; ctx.moveTo(x0, y0); for (var k = 0; k < 6; k++) { x0 += (Math.random() - 0.5) * 24; y0 += (Math.random() - 0.3) * 24; ctx.lineTo(x0, y0); } ctx.stroke(); }
