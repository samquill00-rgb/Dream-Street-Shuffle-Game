    if (window.dssAudio && window.dssAudio.questCall) { try { window.dssAudio.questCall(); } catch (e) {} }
  }
  // 2026-10-16 (Sam, from a tester: "the entrance to Centre Point is a door to the left of where the label is ... it should be
  // an opening in the edge of the map, that's the gate, same for Cecil Court. Both should be labelled"): the map's outer
  // edge is a hairline, broken at the two gates; each gap is lit and has its posts. Centre Point opens in the top edge at
  // tiles 17 and 18 (the exit check), Cecil Court in the right edge at row 38 (its spot). Drawn in world coordinates.
  var GATES = [
    { id: 'north', side: 'top',   x0: 17 * T, x1: 19 * T },
    { id: 'cecil', side: 'right', y0: 38 * T, y1: 39 * T }
