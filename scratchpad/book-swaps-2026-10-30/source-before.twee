      var bp = ac.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = f; bp.Q.value = 1.2;
      var g = ac.createGain(); g.gain.value = _rnd(0.05, 0.2); src.connect(bp); bp.connect(g); g.connect(master); src.start(now);
      if (Math.random() < 0.25) { var s2 = ac.createBufferSource(); s2.buffer = _burstNoise(ac, 0.08, function(x) { return Math.pow(1 - x, 2); }); var g2 = ac.createGain(); g2.gain.value = 0.04; var l2 = ac.createBiquadFilter(); l2.type = 'bandpass'; l2.frequency.value = _rnd(600, 1200); s2.connect(l2); l2.connect(g2); g2.connect(master); s2.start(now + 0.01); }
