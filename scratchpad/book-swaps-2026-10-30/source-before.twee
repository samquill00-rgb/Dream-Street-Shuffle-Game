  var COYOTE = 0.16, BUFFER = 0.20;
  var BASE = 200, HURRY = 1.45, BACK = -0.75;   // ← now WALKS BACK (Sam: for a missed mark); HANG 0.62 retired

  var WORLD_END = 6900;
  var SNAKE0=3760,SNAKE1=4360,CROC_GATE=4610;
  var snakes=[3860,4000,4140,4280],cat={x:3600,friend:false,pet:0,seen:false},croc={passed:false,committed:false,wait:0,tunnel:0,open:0};
  var snakeHint=false,crocHint=false, hazardHint='', rescueHold=0, stepAccumulator=0;
  function snakeAt(x){if(FLOOR && FLOOR.some(function(f){return f.snake&&f.sanded;}))return null;for(var n=0;n<snakes.length;n++)if(Math.abs(x-snakes[n])<42)return {index:n,x:snakes[n],y:390+Math.sin(gameClock/950+n*.8)*12};return null;}

