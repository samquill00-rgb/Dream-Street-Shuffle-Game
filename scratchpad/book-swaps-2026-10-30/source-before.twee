    var px = d.fc*T + 8, py = d.fr*T + 8;
    if (side === 'w' || side === 'e') pool(px + (side === 'w' ? 3 : -3), py, 18, 34, d.col, a);
    else pool(px, py + (side === 'n' ? 3 : -3), 34, 18, d.col, a);
    if (d.spot) halo(px, py, 26, d.col, a * 0.5);
    var rc = d.fc + (side === 'e' ? 1 : side === 'w' ? -1 : 0), rr2 = d.fr + (side === 's' ? 1 : side === 'n' ? -1 : 0);
    if (inBounds(rc, rr2) && isRoad(rc, rr2)) smear(rc*T + 8, rr2*T - 4, d.col, a * 0.9);
  });
  drawFrontGlow(halo, pool, doors);
