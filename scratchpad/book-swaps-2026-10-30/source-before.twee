cam: function(portrait) { return portrait ? { x: 1.4, y: 1.45, z: 2.9, tx: -0.5, ty: 1.0, tz: -1.6 } : { x: 1.3, y: 1.4, z: 2.5, tx: -0.7, ty: 1.0, tz: -1.6 }; }, fov: [94, 76],
hint: 'LOOK CLOSER AT WHAT CATCHES YOUR EYE',
build: function(k) {
