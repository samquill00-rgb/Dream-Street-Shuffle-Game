// ---- HANGING PUB SIGN (on bracket projecting from facade) ----
var signTex = makeCanvasTexture(128, 128, function(cx, w, h) {
  cx.fillStyle = '#1a1510';
  cx.fillRect(0, 0, w, h);
  cx.strokeStyle = '#c0a040'; cx.lineWidth = 3;
  cx.strokeRect(5, 5, w - 10, h - 10);
  cx.fillStyle = '#c8a840';
  cx.font = 'bold 14px Georgia'; cx.textAlign = 'center';
  cx.fillText('PILLARS', w/2, 38);
  cx.fillText('OF', w/2, 58);
  cx.fillText('HERCULES', w/2, 78);
  cx.font = '9px Georgia';
  cx.fillText('FREE HOUSE', w/2, 105);
});
var signMat = new THREE.MeshStandardMaterial({ map: signTex, roughness: 0.5, side: THREE.DoubleSide });
// The sign hangs from a pivot at the end of a bracket that projects OUT
// from the facade (the old arm ran parallel to the wall at the wrong
// depth, leaving the sign floating flat like a billboard). Base angle is
// ~60 degrees, not 90 — a true perpendicular sign is edge-on to this
// camera — and the animate loop gives it a pendulum swing plus a slow
// wind-twist so the cheat reads as motion.
var bracketMat = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.8 });
placeMesh(pub, new THREE.BoxGeometry(0.04, 0.04, 1.7), bracketMat, 3.6, 4.25, 0.95);
var signStay = placeMesh(pub, new THREE.BoxGeometry(0.03, 0.03, 0.95), bracketMat, 3.6, 3.95, 0.6);
signStay.rotation.x = -0.72;
var signPivot = new THREE.Group();
signPivot.position.set(3.6, 4.25, 1.8);
signPivot.rotation.y = 1.05;
pub.add(signPivot);
var hangSign = new THREE.Mesh(new THREE.PlaneGeometry(0.8, 0.8), signMat);
hangSign.position.set(0, -0.45, 0);
signPivot.add(hangSign);
var signRod = new THREE.Mesh(new THREE.BoxGeometry(0.04, 0.5, 0.04), bracketMat);
signRod.position.set(0, -0.2, 0);
signPivot.add(signRod);

// ---- DRAINPIPE on right edge of building ----
placeMesh(pub, new THREE.CylinderGeometry(0.04, 0.04, 12, 6), pipeMat, 4.0, 6, 0.3);
placeMesh(pub, new THREE.BoxGeometry(0.12, 0.05, 0.12), pipeMat, 4.0, 3.5, 0.3);
placeMesh(pub, new THREE.BoxGeometry(0.12, 0.05, 0.12), pipeMat, 4.0, 8.0, 0.3);

[1.0,3.5,6,8,10.5].forEach(function(y){exterior.ring(pub,4,y,0.3,0.047,0.005,Math.PI/2,0x53564a);});
// Warm interior glow spilling from pub windows
var pubGlow = new THREE.PointLight(0xffd080, 1.7, 18, 2);
pubGlow.position.set(2.0, 1.5, 2);
pub.add(pubGlow);

// Second interior glow (fills out the ground floor)
var pubGlow2 = new THREE.PointLight(0xffd060, 0.85, 14, 2);
pubGlow2.position.set(3.0, 1.5, 1.5);
pub.add(pubGlow2);

// Third interior glow (deeper warmth)
