<script>
requestAnimationFrame(function() {
  var root = document.querySelector('.book-naming');
  if (!root) return;
  root.classList.add('is-empty');
  var ta = root.querySelector('textarea');
  // 2026-10-12 (the opening playthrough): the box gave no cue that it wants typing
  if (ta && !ta.placeholder) ta.placeholder = 'Type your title\u2026';
  function syncEmptyState() {
    if (!ta) return;
    var v = (ta.value || '').trim();
    if (v.length > 0) { root.classList.remove('is-empty'); root.classList.add('has-input'); }
    else { root.classList.add('is-empty'); root.classList.remove('has-input'); }
  }
  if (ta) {
    // Harlowe's input-box defaults to rows=2; force single-line.
    ta.rows = 1;
    function fitTitleFont() {
      var len = (ta.value || '').length;
      var size = '1.85em';
      if (len > 28) size = '0.85em';
      else if (len > 22) size = '1.05em';
      else if (len > 16) size = '1.3em';
      else if (len > 12) size = '1.55em';
      ta.style.setProperty('font-size', size, 'important');
    }
    fitTitleFont();
    ta.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.keyCode === 13) e.preventDefault();
      var k = e.key;
      var isCharOrDelete = (k && k.length === 1) || k === 'Backspace' || k === 'Delete';
      if (isCharOrDelete && window.dssAudio && window.dssAudio.typewriterTick) {
        try { window.dssAudio.typewriterTick(0.16); } catch(err) {}
      }
    });
    ta.addEventListener('input', function(){ syncEmptyState(); fitTitleFont(); });
    setTimeout(function() { try { ta.focus({preventScroll: true}); } catch(e) {} }, 200);
    syncEmptyState();
  }
  root.addEventListener('click', function(e) {
    if (e.target.closest('tw-link')) {
      if (ta) ta.dispatchEvent(new Event('input', {bubbles:true}));
    }
  }, true);
});
</script>

:: Dedicate Your Book {"position":"100,420","size":"100,100"}
<!-- 2026-10-22 (Sam: "Yes, build the dedication page"): the book's first page, one beat after the naming. The title, then "For" and the names the night has earned (the header's #dss-dedic-pool, banked across nights). The choice is kept in localStorage by dssDedication, like the slips, never in Harlowe state; the notebook's FINDS page shows it and can change it, the Dawn prints it under the title, and every old choice stays, struck through. Names only, no prose. The link stays grey until a name is chosen (there is always "no one"); a return night opens on last night's choice. In _hideStats and _backHide with Name Your Book. -->
