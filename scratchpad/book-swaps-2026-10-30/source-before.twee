<!-- Right pillar — same shape, scaleX(-1) mirrors it so break faces inward -->
<svg class="pillar right" viewBox="0 0 34 280" preserveAspectRatio="xMidYMax meet"><defs><linearGradient id="pf2b" x1="0" x2="0" y1="0" y2="1"><stop offset="0%"   stop-color="#8ac8dc" stop-opacity="0.72"/><stop offset="60%"  stop-color="#8ac8dc" stop-opacity="0.42"/><stop offset="100%" stop-color="#8ac8dc" stop-opacity="0"/></linearGradient></defs><g filter="url(#dss-ink-fine)"><rect x="1"  y="252" width="32" height="8"  fill="none" stroke="url(#pf2b)" stroke-width="1.1"/><rect x="4"  y="246" width="26" height="7"  fill="none" stroke="url(#pf2b)" stroke-width="1"/><!-- Shorter shaft: top at y=130 instead of y=88 — this pillar more ruined --><line x1="5"  y1="246" x2="6"  y2="130" stroke="url(#pf2b)" stroke-width="1.1"/><line x1="29" y1="246" x2="28" y2="130" stroke="url(#pf2b)" stroke-width="1.1"/><line x1="5.5" y1="152" x2="28.5" y2="152" stroke="url(#pf2b)" stroke-width="0.65"/><line x1="5.5" y1="174" x2="28.5" y2="174" stroke="url(#pf2b)" stroke-width="0.65"/><line x1="5.5" y1="196" x2="28.5" y2="196" stroke="url(#pf2b)" stroke-width="0.65"/><line x1="5.5" y1="218" x2="28.5" y2="218" stroke="url(#pf2b)" stroke-width="0.65"/><line x1="5.5" y1="240" x2="28.5" y2="240" stroke="url(#pf2b)" stroke-width="0.65"/><line x1="10" y1="130" x2="10" y2="245" stroke="#8ac8dc" stroke-width="0.3" opacity="0.22"/><line x1="14" y1="130" x2="14" y2="245" stroke="#8ac8dc" stroke-width="0.3" opacity="0.22"/><line x1="17" y1="130" x2="17" y2="245" stroke="#8ac8dc" stroke-width="0.3" opacity="0.22"/><line x1="20" y1="130" x2="20" y2="245" stroke="#8ac8dc" stroke-width="0.3" opacity="0.22"/><line x1="24" y1="130" x2="24" y2="245" stroke="#8ac8dc" stroke-width="0.3" opacity="0.22"/><!-- Echinus at top of shorter shaft --><path d="M6,130 Q5,120 3,114 L31,114 Q29,120 28,130" fill="none" stroke="url(#pf2b)" stroke-width="1.1"/><!-- This column: abacus has COLLAPSED entirely — jagged stump and tilted block --><path d="M3,114 L6,107 L10,112 L14,104 L18,110 L22,102 L27,108 L31,114" fill="none"