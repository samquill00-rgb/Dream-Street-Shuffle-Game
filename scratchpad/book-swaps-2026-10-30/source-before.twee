// ---- LIGHTING: the shop is the court's lamp ----
scene.add(new THREE.AmbientLight(0x0e1220, 0.4));
var moon = new THREE.DirectionalLight(0x24304a, 0.14); moon.position.set(-4, 9, 5); scene.add(moon);
var winGlow = new THREE.PointLight(0xffa040, 1.7, 5, 1.6); winGlow.position.set(0.675, 1.7, 0.4); scene.add(winGlow);
var doorGlow = new THREE.PointLight(0xff9838, 1.2, 4, 1.6); doorGlow.position.set(-1.62, 1.6, 0.35); scene.add(doorGlow);
var spill = new THREE.PointLight(0xffb060, 0.9, 6, 2); spill.position.set(-0.2, 1.0, 1.6); scene.add(spill);
// The shop in the flags (2026-09-22 polish loop): the door's and the window's
// amber lying on the wet court in front of them, two pools strongest at the
// sill line and fading out towards the camera, cut by the flagstone joints.
// One additive plane; it follows the two lamps' pulses in ofAnimate.
var ofSheenTex = makeCanvasTexture(256, 128, function(cx, w, h) {
  function pool(px, pw, a) {
    var g = cx.createRadialGradient(px, h * 0.08, 0, px, h * 0.08, pw);
    g.addColorStop(0, 'rgba(255,190,100,' + a + ')');
    g.addColorStop(0.5, 'rgba(255,170,70,' + (a * 0.35) + ')');
    g.addColorStop(1, 'rgba(255,150,50,0)');
    cx.fillStyle = g; cx.fillRect(0, 0, w, h);
  }
  pool(w * 0.72, w * 0.36, 0.62);
  pool(w * 0.27, w * 0.2, 0.42);
  cx.globalCompositeOperation = 'destination-out';
  cx.fillStyle = 'rgba(0,0,0,0.6)';
  for (var ji = 1; ji < 5; ji++) cx.fillRect(0, Math.round(ji * h / 5) - 1, w, 2);
  for (var jj = 1; jj < 9; jj++) cx.fillRect(Math.round(jj * w / 9) - 1, 0, 2, h);
  cx.globalCompositeOperation = 'source-over';
});
var ofSheen = new THREE.Mesh(new THREE.PlaneGeometry(4.4, 2.2),
  new THREE.MeshBasicMaterial({ map: ofSheenTex, transparent: true, opacity: 0.1, blending: THREE.AdditiveBlending, depthWrite: false }));
ofSheen.rotation.x = -Math.PI / 2;
ofSheen.position.set(-0.4, 0.012, 1.55);
scene.add(ofSheen);
// Court fog drifting through the amber
var hazeTexOF = makeCanvasTexture(128, 128, function(cx, w, h) {
var g = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
g.addColorStop(0, 'rgba(200,190,170,0.28)'); g.addColorStop(1, 'rgba(180,170,150,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var ofHaze = [];
for (var hz2 = 0; hz2 < 3; hz2++) {
var hsp = new THREE.Sprite(new THREE.SpriteMaterial({ map: hazeTexOF, transparent: true, opacity: 0.1 + Math.random() * 0.06, depthWrite: false }));
hsp.position.set((Math.random() - 0.5) * 7, 1 + Math.random() * 2.2, 1.5 + Math.random() * 2);
var hsc = 4 + Math.random() * 3.5;
hsp.scale.set(hsc, hsc * 0.55, 1);
hsp.userData = { ph: Math.random() * 6.28, sp: 0.06 + Math.random() * 0.05 };
scene.add(hsp); ofHaze.push(hsp);
}
// Dust motes in the spill
var motes = [];
for (var mt = 0; mt < 6; mt++) {
var mote = new THREE.Sprite(new THREE.SpriteMaterial({ map: hazeTexOF, transparent: true, opacity: 0.25, depthWrite: false, color: 0xffd898 }));
mote.position.set(-0.4 + Math.random() * 2.2, 0.4 + Math.random() * 1.6, 0.5 + Math.random() * 0.8);
mote.scale.set(0.03, 0.03, 1);
mote.userData = { ph: Math.random() * 6.28, sp: 0.25 + Math.random() * 0.3, bx: mote.position.x };
scene.add(mote); motes.push(mote);
}

// Animation
var clock = new THREE.Clock();
function ofAnimate() {
ofAnimId = requestAnimationFrame(ofAnimate);
var t = ofStill ? 4 : clock.getElapsedTime();
ofMagicTime.value = ofStill ? 0 : t;
ofBookMagic.frame(t, ofStill);
// Lamplight breath — the shop's pulse, strong enough to read from the court
var doorPulse = 0.72 + 0.28 * (0.5 + 0.5 * Math.sin(t * 1.05)) + 0.1 * Math.sin(t * 3.1);
var winPulse = 0.86 + 0.14 * (0.5 + 0.5 * Math.sin(t * 0.8 + 2));
winGlow.intensity = 1.5 + winPulse * 0.5;
doorGlow.intensity = 0.9 + doorPulse * 0.9;
ofSheen.material.opacity = 0.07 + winPulse * 0.03 + doorPulse * 0.012;
ofDoorBack.material.color.setScalar(0.62 + doorPulse * 0.45);
ofDisplay.material.color.setScalar(0.82 + winPulse * 0.2);
// The dealer turns a page
if (t > pageState.next) { pageState.start = t; pageState.next = t + 16 + Math.random() * 10; }
var pAge = t - pageState.start;
if (pAge >= 0 && pAge < 0.9) {
var pp = pAge / 0.9;
dPage.rotation.y = Math.PI * pp;
dPage.position.y = 1.08 + Math.sin(pp * Math.PI) * 0.06;
pageMat.opacity = 0.85 + Math.sin(pp * Math.PI) * 0.15;
} else {
dPage.rotation.y = 0;
dPage.position.y = 1.08;
pageMat.opacity = 0.85;
}
// A tiny living stillness in him: breath, and a slow settle of the head
dealer.position.y = Math.sin(t * 0.45) * 0.006;
dHead.rotation.z = Math.sin(t * 0.12) * 0.03;
// Sign sway + wind twist
ofPivot.rotation.z = Math.sin(t * 0.85) * 0.04;
ofPivot.rotation.y = 1.05 + Math.sin(t * 0.29) * 0.13;
// Haze drift
for (var hzi2 = 0; hzi2 < (ofStill ? 0 : ofHaze.length); hzi2++) {
var hzs2 = ofHaze[hzi2];
hzs2.position.x += Math.sin(t * hzs2.userData.sp + hzs2.userData.ph) * 0.0025;
}
// Motes rising through the amber
for (var mti = 0; mti < (ofStill ? 0 : motes.length); mti++) {
var mo = motes[mti];
mo.position.y += 0.0011 * mo.userData.sp;
mo.position.x = mo.userData.bx + Math.sin(t * 0.6 + mo.userData.ph) * 0.08;
if (mo.position.y > 2.3) mo.position.y = 0.35;
}
// Camera drift
camera.position.x = 0.1 + Math.sin(t * 0.1) * 0.03;
camera.position.y = 1.7 + Math.sin(t * 0.14) * 0.012;
if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
}
ofAnimate();

// Overlays
var ofVig = document.createElement('div');
ofVig.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9001;background:radial-gradient(ellipse at 48% 44%, transparent 30%, rgba(0,0,0,0.6) 100%);';
ofWrap.appendChild(ofVig);
var ofWash = document.createElement('div');
ofWash.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9002;background:linear-gradient(180deg, rgba(6,8,16,0.35) 0%, rgba(4,5,10,0.08) 30%, rgba(4,5,10,0.08) 62%, rgba(8,6,3,0.3) 100%);';
ofWrap.appendChild(ofWash);
var ofLoc = document.createElement('div');
ofLoc.classList.add('dss-room-caption');
ofLoc.textContent = 'CECIL COURT, WC2';
ofLoc.style.cssText = 'position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New",monospace;color:rgba(200,180,140,0.55);text-shadow:0 0 8px rgba(0,0,0,0.95),0 1px 2px rgba(0,0,0,0.9);letter-spacing:2px;pointer-events:none;z-index:9003;white-space:nowrap;'; // 2026-09-16: 0.25 alpha with no shadow vanished against the lit pavement here
ofWrap.appendChild(ofLoc);
var ofBtn = document.createElement('div');
ofBtn.textContent = "ENTER O’FLATTERLY’S";
ofBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(212,178,88,0.85);border:1px solid rgba(212,178,88,0.3);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
setTimeout(function() { ofBtn.style.opacity = '1'; }, 2200);
ofBtn.addEventListener('mouseenter', function() { ofBtn.style.color = 'rgba(230,200,120,0.95)'; ofBtn.style.borderColor = 'rgba(212,178,88,0.6)'; });
ofBtn.addEventListener('mouseleave', function() { ofBtn.style.color = 'rgba(212,178,88,0.85)'; ofBtn.style.borderColor = 'rgba(212,178,88,0.3)'; });
ofBtn.addEventListener('click', function() {
ofWrap.style.transition = 'opacity 1.5s ease';
ofWrap.style.opacity = '0';
setTimeout(function() {
if (ofAnimId) cancelAnimationFrame(ofAnimId); ofAnimId = null;
if (ofWrap.parentNode) ofWrap.parentNode.removeChild(ofWrap);
var links = document.querySelectorAll('tw-link, .enchantment-link');
for (var i = 0; i < links.length; i++) { if (links[i].textContent.trim() === '·') { links[i].click(); break; } }
}, 1500);
});
ofWrap.appendChild(ofBtn);
document.body.appendChild(ofWrap);
}

setInterval(function() {
var container = document.getElementById('of-container');
if (container && !ofActive) {
initOflatterly();
} else if (!container) {
ofActive = false;
if (ofAnimId) { cancelAnimationFrame(ofAnimId); ofAnimId = null; }
if (window._dssThreeRegistry && window._dssThreeRegistry['of-wrap']) { var ofEntry=window._dssThreeRegistry['of-wrap']; if(ofEntry.scene)ofEntry.scene.traverse(function(o){if(o.material&&o.material.userData.dssBookMask)o.material.userData.dssBookMask.dispose();}); }
window._dssDisposeWrap('of-wrap');
}
}, 300);
})();
// ====== THIRD PILLAR PORTAL SCENE — INLINE ======
// v2-expansion: the crossing moment. The pub dissolves into a flooded
// void; a whirlpool wakes in the rainwater between the two broken
// columns; a waterspout climbs out of its eye and the gold column
// rises inside it (blue + gold, Sam's direction 2026-08-21). When the
// world-pool is empty (nothing opens tonight) the spout falters at
// ~40% and sinks back — dim mode, button routes back to the Pillars.
// Standard lifecycle: tp-container / tp-wrap / _dssDisposeWrap.
(function() {
var tpActive = false;
var tpAnimId = null;

function initThirdPillar() {
if (tpActive) return;
tpActive = true;
if (typeof THREE === 'undefined') {
var s = document.createElement('script');
s.src = 'vendor/three/three.min.js';
s.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildTPScene) : buildTPScene()); };
document.head.appendChild(s);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildTPScene) : buildTPScene());
}
}

function buildTPScene() {
var tpWrap = document.createElement('div');
tpWrap.id = 'tp-wrap';
tpWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#04060c;';
document.body.appendChild(tpWrap);

// Mode: the passage's roll script has already run. If it produced a
// visible step-through link the crossing is open; otherwise dim mode.
var tpTargetLink = document.querySelector('#dss-portal-action tw-link');
var tpFallbackLink = document.querySelector('#dss-portal-fallback tw-link');
var tpFull = !!tpTargetLink;
// Reduced motion: this is a timed birth, so instead of holding the start we
// jump to the settled end (t pinned at 9s, dt 0: column risen, spout calm,
// no spin) and show the button almost at once.
var tpStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function makeCanvasTexture(w, h, drawFunc) {
var c = document.createElement('canvas');
c.width = w; c.height = h;
var cx = c.getContext('2d');
drawFunc(cx, w, h);
var tex = new THREE.CanvasTexture(c);
tex.minFilter = THREE.LinearFilter;
return tex;
}
function clamp01(v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
function easeOutCubic(v) { return 1 - Math.pow(1 - v, 3); }
function easeInOut(v) { return v < 0.5 ? 2 * v * v : 1 - Math.pow(-2 * v + 2, 2) / 2; }

var scene = new THREE.Scene();
scene.background = new THREE.Color(0x04060c);
scene.fog = new THREE.FogExp2(0x04060c, 0.038);
var camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 90);
camera.position.set(0, 2.6, 10.2);
camera.lookAt(0, 2.4, 0);

var renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
renderer.toneMappingExposure = 0.68;
tpWrap.appendChild(renderer.domElement);
window._dssBindScene('tp-wrap', scene, renderer, camera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(scene, camera, renderer, { bloomStrength: 0.55, bloomRadius: 0.6, bloomThreshold: 0.6 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(tpWrap);

// ============================================================
// LIGHTS
// ============================================================
scene.add(new THREE.AmbientLight(0x243a4c, 0.8));
var coolDir = new THREE.DirectionalLight(0x4a86a8, 0.75);
coolDir.position.set(-6, 8, -7);
scene.add(coolDir);
// Three Blue Posts: a cyan rim-light from behind edges all three
// pillars in blue — the broken pair read spectral, the gold column
// keeps its face and takes blue only at its outline. Elevation 36, not
// 25: the water mirrors this light straight back at the camera, and at
// 25 that mirror sat at the bottom edge of the frame as a white road.
// At 36 it falls below the frame, and the gold reflection can read.
var rimLight = new THREE.DirectionalLight(0x8ac8dc, 0.78);
rimLight.position.set(0, 6.5, -9);
scene.add(rimLight);
// Gold light wakes as the column rises. Decay 2 + generous range — the
// short-cutoff terminator reads as a straight line across water.
var goldLight = new THREE.PointLight(0xd4ae6a, 0, 38, 2);
goldLight.position.set(0, 2.8, 0.9);
scene.add(goldLight);
// Faint cyan uplight from the whirlpool eye. Held at 1.4, not 0.9: any
// lower and its mirror in the water is a white blob in front of the plinth.
var cyanLight = new THREE.PointLight(0x4a9cc0, 0, 24, 2);
cyanLight.position.set(0, 1.4, 0);
scene.add(cyanLight);

// ============================================================
// THE RAINWATER FLOOR
// ============================================================
var waterTex = makeCanvasTexture(512, 512, function(cx, w, h) {
cx.fillStyle = '#071018'; cx.fillRect(0, 0, w, h);
for (var i = 0; i < 90; i++) {
var r = 18 + Math.random() * 70;
var g = cx.createRadialGradient(Math.random() * w, Math.random() * h, 2, Math.random() * w, Math.random() * h, r);
var dark = Math.random() < 0.5;
g.addColorStop(0, dark ? 'rgba(4,8,13,0.5)' : 'rgba(12,24,34,0.4)');
g.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = g;
cx.fillRect(0, 0, w, h);
}
for (var s2 = 0; s2 < 26; s2++) {
cx.strokeStyle = 'rgba(120,180,200,' + (0.02 + Math.random() * 0.045) + ')';
cx.lineWidth = 0.6 + Math.random() * 1.4;
var sy = Math.random() * h, sx = Math.random() * w;
cx.beginPath(); cx.moveTo(sx, sy);
cx.quadraticCurveTo(sx + 40 + Math.random() * 60, sy + (Math.random() - 0.5) * 16, sx + 120 + Math.random() * 90, sy + (Math.random() - 0.5) * 26);
cx.stroke();
}
});
waterTex.wrapS = waterTex.wrapT = THREE.RepeatWrapping;
waterTex.repeat.set(4, 4);
var waterMat = new THREE.MeshStandardMaterial({ map: waterTex, color: 0x9ab4c2, roughness: 0.17, metalness: 0.6 });
var floor = new THREE.Mesh(new THREE.PlaneGeometry(70, 70), waterMat);
floor.rotation.x = -Math.PI / 2;
floor.position.y = 0;
scene.add(floor);

// Drifting sheen patches — BLOBS, never rings (rings read as straight
// lines at a low camera). Additive so they catch as light on water.
var sheenSpriteTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var g = cx.createRadialGradient(w / 2, h / 2, 2, w / 2, h / 2, w / 2);
g.addColorStop(0, 'rgba(140,200,220,0.30)');
g.addColorStop(0.55, 'rgba(90,150,180,0.10)');
g.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var sheens = [];
for (var sh = 0; sh < 7; sh++) {
var shm = new THREE.Sprite(new THREE.SpriteMaterial({ map: sheenSpriteTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0.05 + Math.random() * 0.06, depthWrite: false }));
var shr = 4.5 + Math.random() * 9, sha = Math.random() * Math.PI * 2;
shm.position.set(Math.cos(sha) * shr, 0.06, Math.sin(sha) * shr);
shm.scale.set(2.5 + Math.random() * 3.5, 1.1 + Math.random() * 1.4, 1);
shm.userData = { drift: 0.05 + Math.random() * 0.1, ph: Math.random() * Math.PI * 2 };
scene.add(shm); sheens.push(shm);
}

// ============================================================
// THE WHIRLPOOL — one disc, all art baked into one canvas
// ============================================================
var whirlTex = makeCanvasTexture(512, 512, function(cx, w, h) {
var cxr = w / 2, cyr = h / 2;
// dark eye
var eye = cx.createRadialGradient(cxr, cyr, 2, cxr, cyr, 70);
eye.addColorStop(0, 'rgba(2,4,8,0.9)');
eye.addColorStop(0.7, 'rgba(4,10,16,0.45)');
eye.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = eye; cx.beginPath(); cx.arc(cxr, cyr, 72, 0, Math.PI * 2); cx.fill();
// spiral arms
for (var arm = 0; arm < 5; arm++) {
var a0 = (arm / 5) * Math.PI * 2;
cx.beginPath();
for (var st = 0; st <= 90; st++) {
var tt = st / 90;
var ang = a0 + tt * 4.6;
var rad = 12 + tt * 235;
var px = cxr + Math.cos(ang) * rad, py = cyr + Math.sin(ang) * rad;
if (st === 0) cx.moveTo(px, py); else cx.lineTo(px, py);
}
cx.strokeStyle = 'rgba(138,200,220,0.5)';
cx.lineWidth = 5;
cx.lineCap = 'round';
cx.globalAlpha = 0.55;
cx.stroke();
cx.strokeStyle = 'rgba(74,156,192,0.35)';
cx.lineWidth = 11;
cx.globalAlpha = 0.3;
cx.stroke();
cx.globalAlpha = 1;
}
// froth flecks along the arms
for (var f = 0; f < 130; f++) {
var fa = Math.random() * Math.PI * 2, fr = 20 + Math.random() * 225;
cx.fillStyle = 'rgba(190,230,240,' + (0.06 + Math.random() * 0.2) + ')';
cx.beginPath(); cx.arc(cxr + Math.cos(fa) * fr, cyr + Math.sin(fa) * fr, 0.7 + Math.random() * 2.1, 0, Math.PI * 2); cx.fill();
}
});
var whirlMat = new THREE.MeshBasicMaterial({ map: whirlTex, transparent: true, opacity: 0, depthWrite: false });
var whirl = new THREE.Mesh(new THREE.CircleGeometry(3.3, 48), whirlMat);
whirl.rotation.x = -Math.PI / 2;
whirl.position.y = 0.02;
scene.add(whirl);

// The gold column's reflection in the rainwater: a strip from the plinth
// towards the camera, brightest at its root, broken by ripples. Additive.
var tpReflTex = makeCanvasTexture(64, 256, function(cx, w, h) {
var g = cx.createLinearGradient(0, 0, w, 0);
g.addColorStop(0, 'rgba(0,0,0,0)');
g.addColorStop(0.32, 'rgba(212,174,106,0.22)');
g.addColorStop(0.5, 'rgba(240,208,144,0.85)');
g.addColorStop(0.68, 'rgba(212,174,106,0.22)');
g.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
var v = cx.createLinearGradient(0, 0, 0, h);
v.addColorStop(0, 'rgba(0,0,0,0)');
v.addColorStop(0.18, 'rgba(0,0,0,0.1)');
v.addColorStop(0.55, 'rgba(0,0,0,0.55)');
v.addColorStop(1, 'rgba(0,0,0,1)');
cx.globalCompositeOperation = 'destination-out';
cx.fillStyle = v; cx.fillRect(0, 0, w, h);
for (var rb = 0; rb < 22; rb++) {
var ry = 6 + Math.random() * (h - 12);
cx.fillStyle = 'rgba(0,0,0,' + (0.25 + Math.random() * 0.5) + ')';
cx.fillRect(0, ry, w, 1 + Math.random() * 2.2);
}
});
var tpRefl = new THREE.Mesh(new THREE.PlaneGeometry(1.5, 6.2), new THREE.MeshBasicMaterial({ map: tpReflTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0, depthWrite: false }));
tpRefl.rotation.x = -Math.PI / 2;
tpRefl.position.set(0, 0.035, 4.3);
scene.add(tpRefl);

// ============================================================
// THE TWO BROKEN COLUMNS — standing in the water
// ============================================================
var stoneTex = makeCanvasTexture(256, 256, function(cx, w, h) {
cx.fillStyle = '#3e5570'; cx.fillRect(0, 0, w, h);
for (var i = 0; i < 60; i++) {
cx.fillStyle = 'rgba(' + (Math.random() < 0.5 ? '24,38,56' : '96,128,158') + ',' + (0.08 + Math.random() * 0.18) + ')';
cx.beginPath(); cx.arc(Math.random() * w, Math.random() * h, 3 + Math.random() * 22, 0, Math.PI * 2); cx.fill();
}
for (var cr = 0; cr < 7; cr++) {
cx.strokeStyle = 'rgba(16,22,28,' + (0.25 + Math.random() * 0.3) + ')';
cx.lineWidth = 0.7 + Math.random();
var x0 = Math.random() * w, y0 = Math.random() * h;
cx.beginPath(); cx.moveTo(x0, y0);
cx.lineTo(x0 + (Math.random() - 0.5) * 40, y0 + 20 + Math.random() * 50);
cx.lineTo(x0 + (Math.random() - 0.5) * 60, y0 + 60 + Math.random() * 60);
cx.stroke();
}
// rising damp band at the foot
var damp = cx.createLinearGradient(0, h * 0.72, 0, h);
damp.addColorStop(0, 'rgba(0,0,0,0)');
damp.addColorStop(1, 'rgba(10,18,26,0.55)');
cx.fillStyle = damp; cx.fillRect(0, 0, w, h);
});
var stoneMat = new THREE.MeshStandardMaterial({ map: stoneTex, roughness: 0.88, metalness: 0.06, emissive: 0x16344a, emissiveIntensity: 0.22 });

function buildBrokenColumn(x, height, tiltDir) {
var g = new THREE.Group();
var plinthA = new THREE.Mesh(new THREE.BoxGeometry(1.5, 0.34, 1.5), stoneMat);
plinthA.position.y = 0.17; g.add(plinthA);
var plinthB = new THREE.Mesh(new THREE.BoxGeometry(1.18, 0.28, 1.18), stoneMat);
plinthB.position.y = 0.48; g.add(plinthB);
var portalFine=window.dssDreamDetail(scene);
[-0.56,0.56].forEach(function(x){portalFine.wire([[x,0.35,0.59],[x*0.92,0.44,0.597],[x*0.96,0.56,0.59]],0.006,0x2e4052,g);});
var y = 0.62;
while (y + 0.56 < height) {
var drum = new THREE.Mesh(new THREE.CylinderGeometry(0.47, 0.5, 0.55, 20), stoneMat);
drum.position.y = y + 0.275;
drum.rotation.y = Math.random() * Math.PI;
g.add(drum);
y += 0.57;
}
portalFine.ring(0.495,0.008,0x42586b,0,0.655,0,g);
// broken crown: a tilted part-drum
var crown = new THREE.Mesh(new THREE.CylinderGeometry(0.42, 0.47, 0.3, 20), stoneMat);
crown.position.set(tiltDir * 0.07, y + 0.12, 0.03);
crown.rotation.z = tiltDir * 0.16;
crown.rotation.x = 0.07;
var crownPos=crown.geometry.attributes.position;
for(var ci=0;ci<crownPos.count;ci++){if(crownPos.getY(ci)>0){var xx=crownPos.getX(ci),zz=crownPos.getZ(ci);crownPos.setY(ci,crownPos.getY(ci)+Math.sin(xx*19+zz*13)*0.035+Math.cos(zz*27)*0.018);}}
crown.geometry.computeVertexNormals();g.add(crown);
// rubble half-drowned at the base
for (var rb = 0; rb < 3; rb++) {
var chunk = new THREE.Mesh(new THREE.DodecahedronGeometry(0.16 + Math.random() * 0.17,1), stoneMat);
var ra = Math.random() * Math.PI * 2, rr = 0.95 + Math.random() * 0.7;
chunk.position.set(Math.cos(ra) * rr, 0.05 + Math.random() * 0.06, Math.sin(ra) * rr);
chunk.rotation.set(Math.random(), Math.random(), Math.random());
g.add(chunk);
}
g.position.x = x;
scene.add(g);
return g;
}
buildBrokenColumn(-2.9, 3.7, -1);
buildBrokenColumn(2.9, 2.7, 1);

// ============================================================
// THE GOLD COLUMN — rises from the whirlpool's eye
// ============================================================
var fluteTex = makeCanvasTexture(256, 256, function(cx, w, h) {
var stripes = 16;
for (var i = 0; i < stripes; i++) {
var x0 = (i / stripes) * w, sw = w / stripes;
var g = cx.createLinearGradient(x0, 0, x0 + sw, 0);
g.addColorStop(0, '#7a5c2e');
g.addColorStop(0.35, '#caa25e');
g.addColorStop(0.5, '#e8c887');
g.addColorStop(0.65, '#caa25e');
g.addColorStop(1, '#6e5228');
cx.fillStyle = g; cx.fillRect(x0, 0, sw + 1, h);
}
// wear/noise
for (var n = 0; n < 240; n++) {
cx.fillStyle = 'rgba(' + (Math.random() < 0.5 ? '60,44,18' : '240,214,150') + ',' + (0.03 + Math.random() * 0.07) + ')';
cx.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 2, 1 + Math.random() * 5);
}
});
fluteTex.wrapS = fluteTex.wrapT = THREE.RepeatWrapping;
fluteTex.repeat.set(2, 1);
var goldMat = new THREE.MeshStandardMaterial({ map: fluteTex, color: 0xd4ae6a, metalness: 0.66, roughness: 0.34, emissive: 0x6a5220, emissiveIntensity: 0 });
var goldPlainMat = new THREE.MeshStandardMaterial({ color: 0xcaa25e, metalness: 0.7, roughness: 0.3, emissive: 0x6a5220, emissiveIntensity: 0 });

var pillar = new THREE.Group();
var gpA = new THREE.Mesh(new THREE.BoxGeometry(1.3, 0.28, 1.3), goldPlainMat);
gpA.position.y = 0.14; pillar.add(gpA);
var gpB = new THREE.Mesh(new THREE.BoxGeometry(1.04, 0.24, 1.04), goldPlainMat);
gpB.position.y = 0.4; pillar.add(gpB);
var shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.4, 0.44, 4.3, 28), goldMat);
shaft.position.y = 2.67; pillar.add(shaft);
/* 2026-10-29 (Sam's normal-mapped textures, "strange and beautiful"): the gold shaft takes a hammered relief (173's normal map) and, as it glows,
   the colours of oil on water (173b) rise through the gold instead of a flat glow */
(function() { if (!window.dssNrmTex) return; var n = window.dssNrmTex('173b_norm', 2, 3), e = window.dssNrmTex('173b', 1, 1.6); if (n) { goldMat.normalMap = n; goldMat.normalScale = new THREE.Vector2(0.55, 0.55); } if (e) { goldMat.emissiveMap = e; goldMat.emissive = new THREE.Color(0xffffff); } goldMat.needsUpdate = true; })();
var echinus = new THREE.Mesh(new THREE.CylinderGeometry(0.54, 0.42, 0.26, 28), goldPlainMat);
echinus.position.y = 4.95; pillar.add(echinus);
var abacus = new THREE.Mesh(new THREE.BoxGeometry(1.16, 0.16, 1.16), goldPlainMat);
abacus.position.y = 5.16; pillar.add(abacus);
pillar.position.y = -5.8;
scene.add(pillar);

// Gold halos + door-seam — ADDITIVE, or a near lamp reads dead-grey.
var goldGlowTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var g = cx.createRadialGradient(w / 2, h / 2, 2, w / 2, h / 2, w / 2);
g.addColorStop(0, 'rgba(240,208,144,0.55)');
g.addColorStop(0.45, 'rgba(212,174,106,0.16)');
g.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var haloA = new THREE.Sprite(new THREE.SpriteMaterial({ map: goldGlowTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0, depthWrite: false }));
haloA.position.set(0, 2.7, 0.4); haloA.scale.set(3.6, 5.4, 1); scene.add(haloA);
var haloB = new THREE.Sprite(new THREE.SpriteMaterial({ map: goldGlowTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0, depthWrite: false }));
haloB.position.set(0, 4.6, 0.4); haloB.scale.set(2.2, 2.6, 1); scene.add(haloB);
var seamTex = makeCanvasTexture(32, 256, function(cx, w, h) {
var g = cx.createLinearGradient(0, 0, w, 0);
g.addColorStop(0, 'rgba(0,0,0,0)');
g.addColorStop(0.5, 'rgba(250,228,170,0.85)');
g.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
var v = cx.createLinearGradient(0, 0, 0, h);
v.addColorStop(0, 'rgba(0,0,0,0.9)');
v.addColorStop(0.15, 'rgba(0,0,0,0)');
v.addColorStop(0.85, 'rgba(0,0,0,0)');
v.addColorStop(1, 'rgba(0,0,0,0.9)');
cx.globalCompositeOperation = 'destination-out';
cx.fillStyle = v; cx.fillRect(0, 0, w, h);
});
var seam = new THREE.Mesh(new THREE.PlaneGeometry(0.15, 4.3), new THREE.MeshBasicMaterial({ map: seamTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0, depthWrite: false }));
seam.position.set(0, 2.67, 0.47);
scene.add(seam);

// ============================================================
// THE WATERSPOUT — three nested spinning veils
// ============================================================
var spoutTex = makeCanvasTexture(256, 512, function(cx, w, h) {
for (var i = 0; i < 46; i++) {
var x0 = Math.random() * w, y0 = Math.random() * h;
var len = 60 + Math.random() * 170;
var grad = cx.createLinearGradient(x0, y0, x0 + 14, y0 - len);
var a = 0.2 + Math.random() * 0.42;
grad.addColorStop(0, 'rgba(74,156,192,0)');
grad.addColorStop(0.5, 'rgba(150,210,230,' + a + ')');
grad.addColorStop(1, 'rgba(74,156,192,0)');
cx.strokeStyle = grad;
cx.lineWidth = 1 + Math.random() * 2.6;
cx.lineCap = 'round';
cx.beginPath(); cx.moveTo(x0, y0); cx.lineTo(x0 + 14, y0 - len); cx.stroke();
}
});
spoutTex.wrapS = spoutTex.wrapT = THREE.RepeatWrapping;
function makeVeil(rTop, rBottom, opacity, texRepeat) {
var geo = new THREE.CylinderGeometry(rTop, rBottom, 5.8, 32, 1, true);
geo.translate(0, 2.9, 0);
var tex = spoutTex.clone();
tex.needsUpdate = true;
tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
tex.repeat.set(texRepeat, 1);
var m = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ map: tex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0, side: THREE.DoubleSide, depthWrite: false }));
m.userData = { baseOpacity: opacity, tex: tex };
m.scale.y = 0.04;
scene.add(m);
return m;
}
var veils = [makeVeil(0.85, 1.18, 0.62, 2), makeVeil(0.68, 0.95, 0.46, 3), makeVeil(0.56, 0.76, 0.38, 1)];

// ============================================================
// SPRAY + GOLD MOTES
// ============================================================
var sprayTex = makeCanvasTexture(64, 64, function(cx, w, h) {
var g = cx.createRadialGradient(w / 2, h / 2, 1, w / 2, h / 2, w / 2);
g.addColorStop(0, 'rgba(190,230,240,0.8)');
g.addColorStop(0.5, 'rgba(120,190,215,0.25)');
g.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var sprays = [];
for (var sp = 0; sp < 54; sp++) {
var spr = new THREE.Sprite(new THREE.SpriteMaterial({ map: sprayTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0, depthWrite: false }));
spr.userData = { ang: Math.random() * Math.PI * 2, r: 1.0 + Math.random() * 0.4, y: Math.random() * 5.5, vy: 0.5 + Math.random() * 1.1, va: 1.2 + Math.random() * 2.2, sc: 0.1 + Math.random() * 0.24 };
spr.scale.set(spr.userData.sc, spr.userData.sc, 1);
scene.add(spr); sprays.push(spr);
}
var motes = [];
for (var mo = 0; mo < 24; mo++) {
var mote = new THREE.Sprite(new THREE.SpriteMaterial({ map: goldGlowTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0, depthWrite: false }));
mote.userData = { ang: Math.random() * Math.PI * 2, r: 0.8 + Math.random() * 1.6, y: Math.random() * 5.2, vy: 0.06 + Math.random() * 0.12, va: 0.08 + Math.random() * 0.2, sc: 0.05 + Math.random() * 0.08, ph: Math.random() * Math.PI * 2 };
mote.scale.set(mote.userData.sc, mote.userData.sc, 1);
scene.add(mote); motes.push(mote);
}

// ============================================================
// ANIMATE — growth one-shot, then ambient loop
// ============================================================
var t0 = performance.now();
var lastT = t0;
var loreFired = false;
function tpAnimate() {
tpAnimId = requestAnimationFrame(tpAnimate);
var now = performance.now();
// Review hook: set window.DSS_TP_SPEED = 0.4 in the console before
// entering to watch the birth in slow motion (1 = normal).
var t = tpStill ? 9 : ((now - t0) / 1000) * (window.DSS_TP_SPEED || parseFloat(localStorage.getItem('dssTpSpeed')) || 1);
var dt = tpStill ? 0 : Math.min(0.05, (now - lastT) / 1000);
lastT = now;

// growth: full mode climbs to 1; dim mode falters at 0.42 and sinks
var growth;
if (tpFull) {
growth = easeInOut(clamp01((t - 0.9) / 4.4));
} else {
var up = 0.42 * easeInOut(clamp01((t - 0.8) / 2.6));
var sink = clamp01((t - 4.6) / 2.4);
growth = up * (1 - 0.62 * sink);
}

// whirlpool
whirlMat.opacity = Math.min(1, t / 1.2) * (0.6 + 0.4 * growth);
whirl.rotation.z -= dt * (0.5 + 1.7 * growth);
cyanLight.intensity = (0.36 + 1.2 * growth) * Math.min(1, t / 1.5);

// veils
for (var v = 0; v < veils.length; v++) {
var veil = veils[v];
var settle = tpFull ? clamp01((t - 5.6) / 1.6) : 0;
veil.scale.y = Math.max(0.04, growth);
veil.userData.tex.offset.y -= dt * (0.35 + 0.65 * growth) * (v === 1 ? 1.4 : 1);
veil.rotation.y += dt * (0.9 + 1.1 * growth) * (v === 1 ? -0.8 : 1) * (v === 2 ? 1.6 : 1);
veil.material.opacity = veil.userData.baseOpacity * (0.55 + 0.45 * growth) * (1 - 0.45 * settle);
}

// the gold column rises inside the spout
var pr = tpFull ? clamp01((growth - 0.45) / 0.55) : 0.1 * growth;
pillar.position.y = -5.8 * (1 - easeOutCubic(pr));
pillar.rotation.y += dt * 0.05;
goldMat.emissiveIntensity = 0.38 * pr;
goldPlainMat.emissiveIntensity = 0.3 * pr;
goldLight.intensity = (tpFull ? 2.9 : 0.5) * pr * (1 + 0.06 * Math.sin(t * 2.1));
haloA.material.opacity = pr * (0.4 + 0.1 * Math.sin(t * 1.7));
haloB.material.opacity = pr * (0.3 + 0.08 * Math.sin(t * 1.7 + 1));
seam.material.opacity = pr * (0.45 + 0.12 * Math.sin(t * 1.3));
tpRefl.material.opacity = pr * (0.26 + 0.06 * Math.sin(t * 1.7 + 0.6));
tpRefl.scale.x = 1 + 0.08 * Math.sin(t * 0.9);
if (tpFull && !loreFired && pr > 0.05) {
loreFired = true;
if (window.dssAudio && window.dssAudio.loreUnravel) window.dssAudio.loreUnravel();
}

// spray riding the funnel
for (var s3 = 0; s3 < sprays.length; s3++) {
var spr2 = sprays[s3], u = spr2.userData;
u.ang += dt * u.va;
u.y += dt * u.vy;
var top = 5.8 * Math.max(0.04, growth);
if (u.y > top) { u.y = 0.05; u.ang = Math.random() * Math.PI * 2; }
var rr2 = u.r * (1.05 - 0.35 * (u.y / 5.8));
spr2.position.set(Math.cos(u.ang) * rr2, u.y, Math.sin(u.ang) * rr2);
spr2.material.opacity = (u.y < top ? 0.65 : 0) * (0.25 + 0.75 * growth);
}

// gold motes, only once the column stands
for (var m2 = 0; m2 < motes.length; m2++) {
var mt = motes[m2], mu = mt.userData;
mu.ang += dt * mu.va;
mu.y += dt * mu.vy;
if (mu.y > 5.4) mu.y = 0.3;
mt.position.set(Math.cos(mu.ang) * mu.r, mu.y, Math.sin(mu.ang) * mu.r);
mt.material.opacity = pr * (0.22 + 0.14 * Math.sin(t * 0.9 + mu.ph));
}

// sheen drift
for (var s4 = 0; s4 < sheens.length; s4++) {
var shn = sheens[s4];
shn.position.x += dt * shn.userData.drift * Math.sin(t * 0.2 + shn.userData.ph);
shn.material.opacity = 0.045 + 0.03 * Math.sin(t * 0.35 + shn.userData.ph) + 0.05 * growth;
}

// camera: slow push-in with the growth, breathing sway
camera.position.z = 10.2 - 1.15 * growth + Math.sin(t * 0.1) * 0.05;
camera.position.y = 2.6 + Math.sin(t * 0.13) * 0.025;
camera.position.x = Math.sin(t * 0.08) * 0.06;
camera.lookAt(0, 2.3 + 0.5 * pr, 0);

if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
}
tpAnimate();

// Overlays
var tpVig = document.createElement('div');
tpVig.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9001;background:radial-gradient(ellipse at 50% 42%, transparent 32%, rgba(0,0,0,0.62) 100%);';
tpWrap.appendChild(tpVig);
var tpWash = document.createElement('div');
tpWash.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9002;background:linear-gradient(180deg, rgba(4,8,16,0.4) 0%, rgba(4,5,10,0.06) 34%, rgba(4,5,10,0.06) 66%, rgba(6,8,4,0.3) 100%);';
tpWrap.appendChild(tpWash);
/* 2026-10-29 (Sam, playtest note 20: "Above these pillars it should read in blue writing: 'THREE BLUE POSTS'"): the sign over the posts, lit once the column has risen */
var tpSign = document.createElement('div'); tpSign.className = 'dss-tbp-sign'; tpSign.textContent = 'THREE BLUE POSTS';
tpSign.style.cssText = 'position:absolute;top:7%;left:50%;transform:translateX(-50%);z-index:9003;pointer-events:none;white-space:nowrap;font:600 clamp(20px,3.2vw,40px) Georgia, serif;letter-spacing:0.32em;color:#7fb4ff;text-shadow:0 0 10px rgba(110,170,255,0.85),0 0 28px rgba(70,130,255,0.55),0 0 60px rgba(50,100,255,0.35);opacity:0;transition:opacity 3s ease;';
tpWrap.appendChild(tpSign); setTimeout(function() { tpSign.style.opacity = '1'; }, 2600);

var tpBtn = document.createElement('div');
tpBtn.textContent = tpFull ? 'STEP THROUGH' : 'BACK TO THE PILLARS';
tpBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(212,178,88,0.85);border:1px solid rgba(212,178,88,0.3);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
setTimeout(function() { tpBtn.style.opacity = '1'; }, tpStill ? 900 : (tpFull ? 7200 : 4200));
tpBtn.addEventListener('mouseenter', function() { tpBtn.style.color = 'rgba(230,200,120,0.95)'; tpBtn.style.borderColor = 'rgba(212,178,88,0.6)'; });
tpBtn.addEventListener('mouseleave', function() { tpBtn.style.color = 'rgba(212,178,88,0.85)'; tpBtn.style.borderColor = 'rgba(212,178,88,0.3)'; });
tpBtn.addEventListener('click', function() {
tpWrap.style.transition = 'opacity 1.5s ease';
tpWrap.style.opacity = '0';
setTimeout(function() {
if (tpAnimId) cancelAnimationFrame(tpAnimId); tpAnimId = null;
if (tpWrap.parentNode) tpWrap.parentNode.removeChild(tpWrap);
/* 2026-10-29 (Sam, playtest note 21: "The text after you click to go through the pillar happens far too quickly, you can't read it"): with a world to cross to, the page's words now stay and its own Step through takes you on; only the way back is still pressed for you */
var target = tpFull ? null : document.querySelector('#dss-portal-fallback tw-link');
if (target) target.click();
}, 1500);
});
tpWrap.appendChild(tpBtn);
}

setInterval(function() {
var container = document.getElementById('tp-container');
if (container && !tpActive) {
initThirdPillar();
} else if (!container) {
tpActive = false;
if (tpAnimId) { cancelAnimationFrame(tpAnimId); tpAnimId = null; }
window._dssDisposeWrap('tp-wrap');
}
}, 300);
})();

// ====== CENTRE POINT SCENE — INLINE ======
(function() {
var cpActive = false;
var cpAnimId = null;

function initCentrePoint() {
if (cpActive) return;
cpActive = true;
if (typeof THREE === 'undefined') {
var s = document.createElement('script');
s.src = 'vendor/three/three.min.js';
s.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildCPScene) : buildCPScene()); };
document.head.appendChild(s);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildCPScene) : buildCPScene());
}
}

function buildCPScene() {
// Reduced-motion: hold one settled frame (uplights steady, ladder pulse parked, fog still).
var cpStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var cpWrap = document.createElement('div');
cpWrap.id = 'cp-wrap';
cpWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#060810;';

// ============================================================
// HELPERS (defined first — used by materials below)
// ============================================================
function makeCanvasTexture(w, h, drawFunc) {
var c = document.createElement('canvas');
c.width = w; c.height = h;
var cx = c.getContext('2d');
drawFunc(cx, w, h);
var tex = new THREE.CanvasTexture(c);
tex.minFilter = THREE.LinearFilter;
return tex;
}

function placeMesh(geo, mat, x, y, z) {
var m = new THREE.Mesh(geo, mat);
m.position.set(x, y, z);
cpScene.add(m);
return m;
}

// ============================================================
// SCENE SETUP
// ============================================================
var cpScene = new THREE.Scene();
cpScene.background = new THREE.Color(0x060810);
cpScene.fog = new THREE.Fog(0x060810, 45, 220);

var cpCamera = new THREE.PerspectiveCamera(82, window.innerWidth / window.innerHeight, 0.1, 300);
cpCamera.position.set(0.6, 1.2, 5.0);
cpCamera.lookAt(0.3, 28, -2);

var cpRenderer;
try {
  cpRenderer = new THREE.WebGLRenderer({ antialias: true });
  cpRenderer.setSize(window.innerWidth, window.innerHeight);
  cpRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  cpRenderer.shadowMap.enabled = true;
  cpRenderer.shadowMap.type = THREE.PCFSoftShadowMap;
  cpRenderer.toneMapping = THREE.ACESFilmicToneMapping;
  cpRenderer.toneMappingExposure = 0.55;
  cpWrap.appendChild(cpRenderer.domElement);
  window._dssBindScene('cp-wrap', cpScene, cpRenderer, cpCamera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(cpScene, cpCamera, cpRenderer, { focus: 40, aperture: 0.0001, maxblur: 0.002 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(document.getElementById('cp-wrap'));
} catch (e) {
  /* WebGL unavailable (Chrome's GPU process is unhealthy or too many contexts
     are active). Skip the 3D ladder; build a plain fallback so the player can
     still click CLIMB IT and progress through to the ending. The fallback uses
     the same CLIMB IT button styling created further down so it visually
     matches; we just stop the WebGL pipeline here. */
  console.warn('[DSS] WebGL unavailable for Centre Point — falling back to plain CLIMB IT button.', e);
  var fbCaption = document.createElement('div');
  fbCaption.textContent = 'Every man and every woman is a star.';
  fbCaption.style.cssText = 'position:fixed;bottom:110px;left:0;right:0;text-align:center;font-family:"Playfair Display",Georgia,serif;font-size:14px;color:#f5d070;letter-spacing:0.18em;text-transform:uppercase;pointer-events:none;z-index:9003;white-space:nowrap;text-shadow:0 0 8px rgba(245,208,112,0.55),0 0 16px rgba(245,208,112,0.25),0 0 2px rgba(8,6,4,0.95);';
  cpWrap.appendChild(fbCaption);
  var fbBtn = document.createElement('button');
  fbBtn.className = 'dss-climb-button';
  fbBtn.type = 'button';
  fbBtn.textContent = 'CLIMB IT';
  fbBtn.style.cssText = 'position:fixed;bottom:40px;left:50%;transform:translateX(-50%);padding:16px 42px;font:bold 20px "Courier New",monospace;color:rgba(255,255,250,1);border:2px solid rgba(255,252,232,1);letter-spacing:5px;white-space:nowrap;cursor:pointer;z-index:9004;background:rgba(255,236,176,0.22);box-shadow:0 0 18px rgba(255,240,180,0.55),0 0 42px rgba(255,228,148,0.35),inset 0 0 14px rgba(255,248,212,0.25);text-shadow:0 0 8px rgba(255,255,255,1),0 0 18px rgba(255,252,220,1),0 0 36px rgba(255,236,168,0.85),0 0 58px rgba(255,220,140,0.55),0 0 2px rgba(8,6,4,0.85);';
  fbBtn.addEventListener('click', function() {
    var links = document.querySelectorAll('tw-link, .enchantment-link');
    for (var i = 0; i < links.length; i++) {
      if (links[i].textContent.trim() === '·') { links[i].click(); break; }
    }
  });
  cpWrap.appendChild(fbBtn);
  document.body.appendChild(cpWrap);
  return;
}

// ============================================================
// MATERIALS
// ============================================================

// Centre Point's distinctive off-white precast concrete panels
// with a slightly grainy aggregate finish — Portland stone dust mixed in
var concreteTex = makeCanvasTexture(512, 512, function(cx, w, h) {
// Base off-white — not pure white, slightly warm and aged
cx.fillStyle = '#cdc8bc';
cx.fillRect(0, 0, w, h);
// Aggregate texture — fine pebbled surface
for (var i = 0; i < 3000; i++) {
var gx = Math.random() * w;
var gy = Math.random() * h;
var gr = 0.8 + Math.random() * 1.8;
var tone = 150 + Math.random() * 60;
cx.fillStyle = 'rgba(' + tone + ',' + (tone-5) + ',' + (tone-10) + ',0.35)';
cx.beginPath();
cx.arc(gx, gy, gr, 0, Math.PI * 2);
cx.fill();
}
// Pollution staining — London grime running down from the top
var soot = cx.createLinearGradient(0, 0, 0, h);
soot.addColorStop(0,   'rgba(40, 38, 32, 0.18)');
soot.addColorStop(0.2, 'rgba(40, 38, 32, 0.08)');
soot.addColorStop(0.6, 'rgba(0,0,0,0)');
soot.addColorStop(1,   'rgba(40, 38, 32, 0.06)');
cx.fillStyle = soot;
cx.fillRect(0, 0, w, h);
// Rain streak staining
cx.strokeStyle = 'rgba(80, 75, 65, 0.05)';
cx.lineWidth = 1.5;
for (var rs = 0; rs < 18; rs++) {
cx.beginPath();
var rx = Math.random() * w;
cx.moveTo(rx, 0);
for (var ry = 0; ry < h; ry += 25) {
rx += (Math.random() - 0.5) * 3;
cx.lineTo(rx, ry);
}
cx.stroke();
}
});
var concreteMat = new THREE.MeshStandardMaterial({
map: concreteTex, roughness: 0.88, metalness: 0.0
});

// The dark recessed concrete between the honeycomb cells
var recessMat = new THREE.MeshStandardMaterial({
color: 0x1a1a18, roughness: 0.92
});

// Dark glass in the honeycomb windows — slightly reflective, 1973 tinted glass
var darkGlassTex = makeCanvasTexture(128, 128, function(cx, w, h) {
cx.fillStyle = '#080c10';
cx.fillRect(0, 0, w, h);
// Faint reflection — sky and light caught in the glass
var refl = cx.createLinearGradient(0, 0, w, h);
refl.addColorStop(0,   'rgba(60, 70, 90, 0.25)');
refl.addColorStop(0.4, 'rgba(20, 25, 35, 0.10)');
refl.addColorStop(1,   'rgba(5, 8, 12, 0.05)');
cx.fillStyle = refl;
cx.fillRect(0, 0, w, h);
});
var darkGlass = new THREE.MeshStandardMaterial({
map: darkGlassTex, roughness: 0.15, metalness: 0.55,
color: 0x0a0e14
});

// A few windows warmly lit — offices working late
var warmGlass = new THREE.MeshStandardMaterial({
color: 0x1a0c02, roughness: 0.3,
emissive: 0xd07020, emissiveIntensity: 0.28
});

// Very faintly lit window — fluorescent strip light, cold
var coldGlass = new THREE.MeshStandardMaterial({
color: 0x080c10, roughness: 0.3,
emissive: 0x8090b0, emissiveIntensity: 0.08
});

// Ground pavement
var paveTex = makeCanvasTexture(512, 512, function(cx, w, h) {
cx.fillStyle = '#484840';
cx.fillRect(0, 0, w, h);
// Concrete paving slabs
cx.strokeStyle = 'rgba(20, 18, 14, 0.55)';
cx.lineWidth = 3;
for (var gx = 0; gx <= w; gx += 128) {
cx.beginPath(); cx.moveTo(gx, 0); cx.lineTo(gx, h); cx.stroke();
}
for (var gy = 0; gy <= h; gy += 128) {
cx.beginPath(); cx.moveTo(0, gy); cx.lineTo(w, gy); cx.stroke();
}
// Surface grime and oil stains
cx.fillStyle = 'rgba(25, 22, 16, 0.15)';
for (var st = 0; st < 12; st++) {
cx.beginPath();
cx.ellipse(Math.random()*w, Math.random()*h, 10+Math.random()*30, 6+Math.random()*18, Math.random()*Math.PI, 0, Math.PI*2);
cx.fill();
}
});
var paveMat = new THREE.MeshStandardMaterial({ map: paveTex, roughness: 0.92 });

// ============================================================
// GROUND
// ============================================================
var ground = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), paveMat);
ground.rotation.x = -Math.PI / 2;
ground.receiveShadow = true;
cpScene.add(ground);

// ============================================================
// CENTRE POINT TOWER
// ============================================================
// The building is a cylindrical-ish tower with a hexagonal/faceted
// plan. Each face of the tower has the distinctive deep-set honeycomb
// window grid: horizontal bands of precast concrete framing
// large trapezoidal glazed bays.
//
// We build it as a CylinderGeometry core (the structural mass)
// then tile the honeycomb facade panels onto the visible faces.

var tower = new THREE.Group();

// ----- CORE SHAFT -----
// 34-storey tower. In 1973 it dominated the Tottenham Court Road skyline.
// Scale: ~0.7 units per storey, so total ~24 units tall.
var STOREYS = 34;
var STOREY_H = 0.72;
var TOWER_H = STOREYS * STOREY_H;
var TOWER_R = 2.8;

// Octagonal core — the structural body
var coreGeo = new THREE.CylinderGeometry(TOWER_R, TOWER_R + 0.2, TOWER_H, 8, 1);
var core = new THREE.Mesh(coreGeo, recessMat);
core.position.set(0, TOWER_H / 2, 0);
tower.add(core);

// ----- HONEYCOMB FACADE PANELS -----
// Centre Point's signature: each storey has deep-set concrete ribs
// forming a diamond/hexagonal grid on the facade.
// We'll tile this on the front 3 faces of the octagon.

// Each honeycomb cell: a concrete surround (thick, projected forward)
// with a recessed glass pane inside.
// Cell dimensions roughly: 0.65 wide × 0.68 tall

var CELL_W = 0.62;
var CELL_H = 0.66;
var PANEL_DEPTH = 0.18;
var GLASS_INSET = 0.12;

// The angled faces of the octagon — we'll cover faces at angles:
// 0° (front), ±45° (front-flanks), and partially ±90° (sides)
var facadeAngles = [0, -45, 45, -90, 90];
var facadeWidths = [5.0, 3.5, 3.5, 2.2, 2.2];

// Random seed for consistent window lighting
var winStates = [];
for (var w = 0; w < 2000; w++) {
var r = Math.random();
winStates.push(r < 0.08 ? 'warm' : r < 0.13 ? 'cold' : 'dark');
}

var warmWindows = [];
var winIdx = 0;

facadeAngles.forEach(function(angleDeg, fi) {
var angleRad = angleDeg * Math.PI / 180;
var fWidth   = facadeWidths[fi];

// Position of this face: on the surface of the octagon
var faceDist = TOWER_R * Math.cos(Math.PI / 8);

var cols = Math.floor(fWidth / CELL_W);
var rows = STOREYS;

for (var row = 0; row < rows; row++) {
for (var col = 0; col < cols; col++) {

// Local position on the face
var lx = (col - (cols - 1) / 2) * CELL_W;
var ly = (row + 0.5) * CELL_H + 0.5;

// Odd rows offset by half a cell — the honeycomb stagger
if (row % 2 === 1) lx += CELL_W * 0.5;

// Concrete surround (the rib frame around each cell)
var surroundGeo = new THREE.BoxGeometry(CELL_W - 0.04, CELL_H - 0.04, PANEL_DEPTH);
var surround = new THREE.Mesh(surroundGeo, concreteMat);

// Glass pane — inset behind the surround
var glassState = winStates[winIdx % winStates.length];
winIdx++;
var glassMat = (glassState === 'warm') ? warmGlass :
(glassState === 'cold') ? coldGlass : darkGlass;

var glassGeo = new THREE.BoxGeometry(CELL_W * 0.72, CELL_H * 0.78, 0.04);
var glass = new THREE.Mesh(glassGeo, glassMat);
glass.position.z = -GLASS_INSET;

// The horizontal rib — a thin bar across the bottom of each cell
var ribGeo = new THREE.BoxGeometry(CELL_W, 0.06, PANEL_DEPTH + 0.04);
var rib = new THREE.Mesh(ribGeo, concreteMat);
rib.position.y = -(CELL_H / 2) + 0.03;

// Group the cell
var cell = new THREE.Group();
cell.add(surround);
cell.add(glass);
cell.add(rib);

// Position on the face, rotated to sit on the correct face of octagon
cell.position.set(lx, ly, faceDist);
cell.rotation.y = -angleRad;

// Rotate so x-axis aligns with the face
var worldPos = new THREE.Vector3();
var cosA = Math.cos(angleRad);
var sinA = Math.sin(angleRad);
cell.position.set(
lx * cosA - 0 * sinA,
ly,
lx * sinA + faceDist * cosA
);

if (glassState === 'warm') {
warmWindows.push({ x: cell.position.x, y: ly, z: cell.position.z });
}

tower.add(cell);
}
}
});

// ----- PODIUM / BASE -----
// The building sits on a broad podium at street level
var podiumGeo = new THREE.BoxGeometry(7, 2.0, 7);
var podium = new THREE.Mesh(podiumGeo, concreteMat);
podium.position.set(0, 1.0, 0);
tower.add(podium);

// Podium overhang / colonnade edge
var overhangGeo = new THREE.BoxGeometry(8.2, 0.25, 8.2);
var overhang = new THREE.Mesh(overhangGeo, concreteMat);
overhang.position.set(0, 2.1, 0);
tower.add(overhang);

// Colonnade pillars around the base
for (var pi = 0; pi < 8; pi++) {
var pa = (pi / 8) * Math.PI * 2;
var px = Math.sin(pa) * 3.8;
var pz = Math.cos(pa) * 3.8;
var pillarGeo = new THREE.CylinderGeometry(0.15, 0.18, 2.2, 8);
var pillar = new THREE.Mesh(pillarGeo, concreteMat);
pillar.position.set(px, 1.1, pz);
tower.add(pillar);
}

// ----- ROOF / CROWN -----
// The top of Centre Point has a distinctive recessed plant-room and
// a parapet with a slightly different profile
var roofSlab = new THREE.Mesh(
new THREE.CylinderGeometry(TOWER_R + 0.1, TOWER_R + 0.1, 0.4, 8),
concreteMat
);
roofSlab.position.set(0, TOWER_H + 0.2, 0);
tower.add(roofSlab);

// Plant room on roof
var plantRoom = new THREE.Mesh(
new THREE.BoxGeometry(3.5, 2.5, 3.5),
recessMat
);
plantRoom.position.set(0, TOWER_H + 1.65, 0);
tower.add(plantRoom);

// Roof parapet
var parapet = new THREE.Mesh(
new THREE.CylinderGeometry(TOWER_R + 0.3, TOWER_R + 0.3, 0.3, 8),
concreteMat
);
parapet.position.set(0, TOWER_H + 0.55, 0);
tower.add(parapet);

// Aviation warning light on top
var warningLight = new THREE.Mesh(
new THREE.SphereGeometry(0.12, 8, 6),
new THREE.MeshStandardMaterial({
color: 0x400000, roughness: 0.3,
emissive: 0xff2000, emissiveIntensity: 0.6
})
);
warningLight.position.set(0, TOWER_H + 3.2, 0);
tower.add(warningLight);

cpScene.add(tower);

// ============================================================
// LOWER BUILDING / PODIUM CONTEXT — the smaller block at the base
// ============================================================
// Centre Point had a lower surrounding block — shops, service access
var lowerBlock = new THREE.Mesh(
new THREE.BoxGeometry(10, 5.5, 8),
concreteMat
);
lowerBlock.position.set(0, 2.75, -3.5);
cpScene.add(lowerBlock);

// A few windows on the lower block
for (var lb = 0; lb < 6; lb++) {
var lwx = -3.5 + lb * 1.4;
var lwGlass = (Math.random() < 0.3) ? warmGlass : darkGlass;
var lwin = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.9, 0.06), lwGlass);
lwin.position.set(lwx, 3.8, 0.5);
cpScene.add(lwin);
}

// Restrained fittings and worn edges: exterior detail pass.
(function(){var f=window.dssDreamDetail(cpScene);var ex=window.dssExteriorDetail(cpScene);
// Podium concrete expansion joints
[-2.4,0,2.4].forEach(function(x){f.box(0.012,1.8,0.008,0x706e64,x,1,3.505);});
// Overhang drip groove
f.box(7.7,0.008,0.012,0x77756b,0,1.974,3.94);
// Colonnade pillar foot collars
for(var i=0;i<8;i++){var a=i*Math.PI/4;f.ring(0.18,0.009,0x939084,Math.sin(a)*3.8,0.06,Math.cos(a)*3.8);}
// Podium rain-sill edging
f.box(6.9,0.025,0.04,0x9c998d,0,0.16,3.53);
// Lower block window bottom glazing beads
for(var w=0;w<6;w++)f.box(0.82,0.025,0.018,0x6e706d,-3.5+w*1.4,3.35,0.54);
// Lower block window side gaskets
for(var w=0;w<6;w++){var x=-3.5+w*1.4;[-0.399,0.399].forEach(function(dx){f.box(0.012,0.89,0.008,0x202522,x+dx,3.8,0.534);});}
// Roof plant room louvres
for(var l=0;l<8;l++)f.box(1.5,0.025,0.03,0x3d4140,0,TOWER_H+1.2+l*0.1,1.765);
// Warning lamp metal footing
f.put(new THREE.CylinderGeometry(0.16,0.19,0.065,12),f.mat(0x6d6c63,true),0,TOWER_H+3.08,0);
// Warning lamp guard ring
f.ring(0.123,0.008,0x6d6c63,0,TOWER_H+3.2,0);
// Paving movement joints
[-6,-3,0,3,6].forEach(function(x){f.box(0.009,0.002,4,0x30312e,x,0.003,6.3);});
})();

// ============================================================
// SKY — night sky with a faint sodium glow on the horizon
// ============================================================
// Sky dome
var skyGeo = new THREE.SphereGeometry(150, 16, 8);
var skyTex = makeCanvasTexture(512, 256, function(cx, w, h) {
// Very dark blue-black night sky
var skyGrad = cx.createLinearGradient(0, 0, 0, h);
skyGrad.addColorStop(0,    '#030408');
skyGrad.addColorStop(0.5,  '#060810');
skyGrad.addColorStop(0.75, '#0c0e18');
skyGrad.addColorStop(0.85, '#1a1008');
skyGrad.addColorStop(1,    '#2a1a08');
cx.fillStyle = skyGrad;
cx.fillRect(0, 0, w, h);
// Stars — faint
cx.fillStyle = 'rgba(255,255,255,0.7)';
for (var s = 0; s < 180; s++) {
var sx = Math.random() * w;
var sy = Math.random() * h * 0.7;
var sr = 0.4 + Math.random() * 0.8;
cx.beginPath();
cx.arc(sx, sy, sr, 0, Math.PI * 2);
cx.fill();
}
});
var skyMat = new THREE.MeshBasicMaterial({ map: skyTex, side: THREE.BackSide });
var sky = new THREE.Mesh(skyGeo, skyMat);
cpScene.add(sky);

// ============================================================
// STARS
// ============================================================
var starTex = makeCanvasTexture(64, 64, function(cx, w, h) {
var g = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
g.addColorStop(0,    'rgba(255,255,255,0.95)');
g.addColorStop(0.12, 'rgba(255,255,255,0.6)');
g.addColorStop(0.4,  'rgba(200,210,255,0.15)');
g.addColorStop(1,    'rgba(0,0,0,0)');
cx.fillStyle = g;
cx.fillRect(0, 0, w, h);
});

for (var si = 0; si < 220; si++) {
var sMat = new THREE.SpriteMaterial({
map: starTex, transparent: true,
opacity: 0.3 + Math.random() * 0.7,
fog: false
});
var sSpr = new THREE.Sprite(sMat);
var sTheta = Math.random() * Math.PI * 2;
var sPhi   = 0.05 + Math.random() * 0.45;
var sDist  = 90 + Math.random() * 30;
sSpr.position.set(
Math.sin(sTheta) * Math.sin(sPhi) * sDist,
Math.cos(sPhi)   * sDist * 0.6 + 15,
Math.cos(sTheta) * Math.sin(sPhi) * sDist - 20
);
var sSz = 0.4 + Math.random() * 1.1;
sSpr.scale.set(sSz, sSz, 1);
cpScene.add(sSpr);
}

// ============================================================
// TOWER UPLIGHTING — dramatic uplights on the base washing the concrete
// ============================================================
var upLight1 = new THREE.SpotLight(0xfff0d0, 1.8, 35, Math.PI / 7, 0.5);
upLight1.position.set(-3, 0.5, 4.5);
upLight1.target.position.set(-1, 15, 0);
cpScene.add(upLight1);
cpScene.add(upLight1.target);

var upLight2 = new THREE.SpotLight(0xfff0d0, 1.5, 35, Math.PI / 7, 0.5);
upLight2.position.set(3, 0.5, 4.5);
upLight2.target.position.set(1, 15, 0);
cpScene.add(upLight2);
cpScene.add(upLight2.target);

var upLight3 = new THREE.SpotLight(0xffe8b0, 1.0, 40, Math.PI / 8, 0.6);
upLight3.position.set(0, 0.5, 5.5);
upLight3.target.position.set(0, 22, 0);
cpScene.add(upLight3);
cpScene.add(upLight3.target);

// ============================================================
// WARM WINDOW GLOW LIGHTS
// ============================================================
// Add a few point lights near the warmly lit windows
var windowGlows = [];
var glowSubset = warmWindows.slice(0, 8);
glowSubset.forEach(function(ww) {
var wl = new THREE.PointLight(0xd07020, 0.18, 3.5);
wl.position.set(ww.x * 0.85, ww.y, ww.z * 0.85 + 0.5);
cpScene.add(wl);
windowGlows.push(wl);
});

// ============================================================
// AVIATION WARNING LIGHT — animated red blink
// ============================================================
var avLight = new THREE.PointLight(0xff2000, 0.0, 20);
avLight.position.set(0, TOWER_H + 3.3, 0);
cpScene.add(avLight);

// ============================================================
// AMBIENT + MOON
// ============================================================
cpScene.add(new THREE.AmbientLight(0x05060e, 0.12));

var moonLight = new THREE.DirectionalLight(0x1a2255, 0.06);
moonLight.position.set(-8, 30, 10);
cpScene.add(moonLight);

// ============================================================
// FOG SPRITES — ground-level murk
// ============================================================
var thickFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
grad.addColorStop(0,   'rgba(130,125,115,0.28)');
grad.addColorStop(0.5, 'rgba(100, 95, 85,0.12)');
grad.addColorStop(1,   'rgba(70, 65, 55, 0)');
cx.fillStyle = grad;
cx.fillRect(0, 0, w, h);
});
var sodiumFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
grad.addColorStop(0,   'rgba(220,110,20,0.22)');
grad.addColorStop(0.4, 'rgba(190, 85,14,0.10)');
grad.addColorStop(1,   'rgba(140, 55, 8, 0)');
cx.fillStyle = grad;
cx.fillRect(0, 0, w, h);
});

var fogSprites = [];

for (var fi = 0; fi < 50; fi++) {
var fMat = new THREE.SpriteMaterial({
map: (fi < 35) ? thickFogTex : sodiumFogTex,
transparent: true, opacity: 0.2 + Math.random() * 0.2
});
var fs = new THREE.Sprite(fMat);
fs.position.set(Math.random() * 40 - 18, 0.2 + Math.random() * 2.0, Math.random() * 25 - 3);
var fsc = 6 + Math.random() * 14;
fs.scale.set(fsc, fsc * 0.28, 1);
cpScene.add(fs);
fogSprites.push({
sprite: fs, baseX: fs.position.x,
drift: 0.002 + Math.random() * 0.005,
sway: Math.random() * Math.PI * 2,
swaySpeed: 0.001 + Math.random() * 0.003,
swayAmt: 0.5 + Math.random() * 1.2
});
}

// ============================================================
// NEON BLUE LADDER — two rails + cross rungs up the central gap
// ============================================================
var LADDER_X    = 0.0;
var RAIL_SEP    = 0.32;
var LADDER_Z    = TOWER_R + 0.4;
var RUNG_COUNT  = STOREYS + 2;
var RUNG_SPACING = STOREY_H;

// Base neon material — shared by rails
var neonMat = new THREE.MeshStandardMaterial({
color: 0x001833,
emissive: new THREE.Color(0x00aaff),
emissiveIntensity: 2.2,
roughness: 0.15,
metalness: 0.0,
fog: false
});

// LEFT RAIL
var leftRail = new THREE.Mesh(
new THREE.BoxGeometry(0.055, TOWER_H + 2, 0.055),
neonMat
);
leftRail.position.set(-RAIL_SEP, (TOWER_H + 2) / 2 + 0.5, LADDER_Z);
cpScene.add(leftRail);

// RIGHT RAIL
var rightRail = new THREE.Mesh(
new THREE.BoxGeometry(0.055, TOWER_H + 2, 0.055),
neonMat
);
rightRail.position.set(RAIL_SEP, (TOWER_H + 2) / 2 + 0.5, LADDER_Z);
cpScene.add(rightRail);

// RUNGS — flat boxes spanning between the rails, clearly visible face-on
var rungMeshes = [];
for (var rung = 0; rung < RUNG_COUNT; rung++) {
var ry = 0.8 + rung * RUNG_SPACING;
var rungMat = neonMat.clone();
var rungMesh = new THREE.Mesh(
new THREE.BoxGeometry(RAIL_SEP * 2, 0.07, 0.07),
rungMat
);
rungMesh.position.set(0, ry, LADDER_Z);
cpScene.add(rungMesh);
rungMeshes.push(rungMesh);
}

// Travelling pulse light
var pulseLight = new THREE.PointLight(0x00aaff, 0.0, 7);
cpScene.add(pulseLight);

// Soft base glow pooling at the bottom
var ladderBaseGlow = new THREE.PointLight(0x0055cc, 0.5, 10);
ladderBaseGlow.position.set(0, 1.5, LADDER_Z + 1);
cpScene.add(ladderBaseGlow);
// The neon in the night air (2026-09-22 polish loop): a soft blue haze
// hanging at the foot of the ladder, where the tubes' light catches the
// damp. One additive sprite; breathes with ladderBaseGlow.
var cpHazeTex = makeCanvasTexture(128, 128, function(cx, w, h) {
  var g = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
  g.addColorStop(0, 'rgba(90,170,255,0.55)');
  g.addColorStop(0.45, 'rgba(40,110,220,0.18)');
  g.addColorStop(1, 'rgba(20,60,160,0)');
  cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var cpHaze = new THREE.Sprite(new THREE.SpriteMaterial({ map: cpHazeTex, transparent: true, opacity: 0.1, blending: THREE.AdditiveBlending, depthWrite: false }));
cpHaze.position.set(LADDER_X, 1.6, LADDER_Z + 0.9);
cpHaze.scale.set(3.6, 2.2, 1);
cpScene.add(cpHaze);

// ============================================================
// ANIMATION
// ============================================================
var cpClock = new THREE.Clock();
var avBlinkPhase = 0;

function cpAnimate() {
cpAnimId = requestAnimationFrame(cpAnimate);
var t = cpStill ? 3 : cpClock.getElapsedTime();

// --- UPLIGHTING — slow breathing, like a building being dramatic ---
var upBreath = 0.96 + Math.sin(t * 0.18) * 0.03;
upLight1.intensity = 1.8 * upBreath;
upLight2.intensity = 1.5 * upBreath;
upLight3.intensity = 1.0 * upBreath;

// --- AVIATION LIGHT — slow red blink, every ~4 seconds ---
if (!cpStill) avBlinkPhase += 0.016;
var avCycle = Math.sin(avBlinkPhase * 0.8);
var avOn = avCycle > 0.85;
avLight.intensity = avOn ? (avCycle - 0.85) * 12 : 0;
warningLight.material.emissiveIntensity = avOn ? 0.8 + (avCycle - 0.85) * 4 : 0.08;

// --- WINDOW GLOW PULSE (very slow, nearly static) ---
for (var wgi = 0; wgi < windowGlows.length; wgi++) {
windowGlows[wgi].intensity = 0.15 + Math.sin(t * 0.08 + wgi * 0.9) * 0.04;
}

// --- NEON LADDER PULSE ---
// A bright pulse travels upward continuously, looping from bottom to top
var PULSE_SPEED = 4.5;
var pulsePos = (t * PULSE_SPEED) % (RUNG_COUNT + 4);
var pulseY   = 0.8 + pulsePos * RUNG_SPACING;

// Move the travelling point light
pulseLight.position.set(LADDER_X, pulseY, LADDER_Z + 0.8);

// Each rung brightness: peak when pulse is at that rung, fades off quickly
for (var ri = 0; ri < rungMeshes.length; ri++) {
var dist = Math.abs(ri - pulsePos);
var brightness = Math.max(0, 1.0 - dist * 0.55);
// Base flicker on the neon — slow, like a real tube
var neonFlicker = 0.88 + Math.sin(t * 1.4 + ri * 0.3) * 0.06
+ Math.sin(t * 3.1 + ri * 0.7) * 0.03;
rungMeshes[ri].material.emissiveIntensity = (0.5 + brightness * 1.8) * neonFlicker;
}

// Spine pulses with overall neon flicker
var spineFlicker = 0.9 + Math.sin(t * 1.2) * 0.05 + Math.sin(t * 2.8) * 0.03;
leftRail.material.emissiveIntensity  = 1.0 * spineFlicker;
rightRail.material.emissiveIntensity = 1.0 * spineFlicker;

// The pulse light intensity peaks at the centre of the travel
pulseLight.intensity = 1.2 + Math.sin(t * 1.8) * 0.2;

// Base glow breathes slowly
ladderBaseGlow.intensity = 0.35 + Math.sin(t * 0.4) * 0.12;
cpHaze.material.opacity = 0.08 + (ladderBaseGlow.intensity - 0.35) * 0.3 + Math.sin(t * 1.1) * 0.01;

// --- FOG DRIFT --- (held under reduced motion)
for (var fdi = 0; fdi < (cpStill ? 0 : fogSprites.length); fdi++) {
var f = fogSprites[fdi];
f.sway += f.swaySpeed;
f.sprite.position.x = f.baseX + Math.sin(f.sway) * f.swayAmt;
f.baseX += f.drift;
if (f.baseX > 22) f.baseX = -18;
}

if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { cpRenderer.render(cpScene, cpCamera); }
}

cpAnimate();

// Vignette
var cpVig = document.createElement('div');
cpVig.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9001;background:radial-gradient(ellipse at 45% 45%, transparent 30%, rgba(0,0,0,0.6) 100%);';
cpWrap.appendChild(cpVig);

// Datestamp

// Caption — Crowley's Thelemic line, sitting ABOVE the CLIMB IT button.
// Styled to match the "There is no part of me that is not of the Gods"
// quote that appears after the liver-eating: Playfair Display caps, gold,
// no italic. Caption at bottom:115px — lowered from 150px so it sits clear
// below the astral constellation that rises over the scene, while keeping
// breathing space above the CLIMB IT button (button top ≈88px).
var cpLoc = document.createElement('div');
cpLoc.classList.add('dss-room-caption');
var cpLocText = 'Every man and every woman is a star.';
cpLoc.style.cssText = 'position:fixed;bottom:115px;left:0;right:0;text-align:center;font-family:"Playfair Display",Georgia,serif;font-size:14px;color:#f5d070;letter-spacing:0.18em;text-transform:uppercase;pointer-events:none;z-index:9003;white-space:nowrap;text-shadow:0 0 8px rgba(245,208,112,0.55),0 0 16px rgba(245,208,112,0.25),0 0 2px rgba(8,6,4,0.95);opacity:0;transition:opacity 1.2s ease;';
// Phone widths: the letter-spaced caps run wider than the screen, so tighten them.
if (window.innerWidth < 480) { cpLoc.style.fontSize = '11px'; cpLoc.style.letterSpacing = '0.1em'; }
cpWrap.appendChild(cpLoc);
// Type the line out one character at a time — an inscription being chiselled,
// echoing the typewriter opening of the game — rather than a flat fade-in.
setTimeout(function() {
cpLoc.style.opacity = '1';
var cpci = 0;
var cpType = setInterval(function() {
cpci++;
cpLoc.textContent = cpLocText.slice(0, cpci);
if (cpci >= cpLocText.length) { clearInterval(cpType); }
}, 80);
}, 2600);

// Button: "CLIMB IT" — brightened from rgba(248,212,128) to a near-white
// gold so it reads as a clear, glowing call-to-action against the dark
// city scene rather than a muted text-link.
var cpBtn = document.createElement('button');
cpBtn.className = 'dss-climb-button';
cpBtn.type = 'button';
cpBtn.textContent = 'CLIMB IT';
cpBtn.style.cssText = 'position:fixed;bottom:40px;left:50%;transform:translateX(-50%);padding:16px 42px;font:bold 20px "Courier New",monospace;color:rgba(255,255,250,1);border:2px solid rgba(255,252,232,1);letter-spacing:5px;white-space:nowrap;cursor:pointer;z-index:9004;background:rgba(255,236,176,0.22);box-shadow:0 0 18px rgba(255,240,180,0.55),0 0 42px rgba(255,228,148,0.35),inset 0 0 14px rgba(255,248,212,0.25);opacity:0;transition:opacity 5.5s ease;text-shadow:0 0 8px rgba(255,255,255,1),0 0 18px rgba(255,252,220,1),0 0 36px rgba(255,236,168,0.85),0 0 58px rgba(255,220,140,0.55),0 0 2px rgba(8,6,4,0.85);';
setTimeout(function() { cpBtn.style.opacity = '1'; }, 3500);
cpBtn.addEventListener('mouseenter', function() {
cpBtn.style.color = 'rgba(255,252,232,1)';
cpBtn.style.borderColor = 'rgba(255,248,212,1)';
});
cpBtn.addEventListener('mouseleave', function() {
cpBtn.style.color = 'rgba(255,244,200,1)';
cpBtn.style.borderColor = 'rgba(255,232,160,0.95)';
});
cpBtn.addEventListener('click', function() {
// Freeze the canvas animation immediately so the 3D scene doesn't keep
// moving while it fades — kills the perceptual "second flash" some
// players were seeing as the snap-cut at end-of-fade.
if (cpAnimId) { cancelAnimationFrame(cpAnimId); cpAnimId = null; }
cpWrap.style.transition = 'opacity 0.6s ease';
cpWrap.style.opacity = '0';
setTimeout(function() {
if (cpWrap.parentNode) cpWrap.parentNode.removeChild(cpWrap);
// Approach Centre Point's hidden tw-link now targets Alba Complete /
// Alba Incomplete directly (the Centre Point router passage was
// bypassed). Click the first "·" link in the document.
var links = document.querySelectorAll('tw-link, .enchantment-link');
for (var i = 0; i < links.length; i++) {
if (links[i].textContent.trim() === '·') { links[i].click(); break; }
}
}, 650);
});
cpWrap.appendChild(cpBtn);

document.body.appendChild(cpWrap);
}

setInterval(function() {
var container = document.getElementById('cp-container');
if (container && !cpActive) {
initCentrePoint();
} else if (!container) {
cpActive = false;
if (cpAnimId) { cancelAnimationFrame(cpAnimId); cpAnimId = null; }
window._dssDisposeWrap('cp-wrap');
}
}, 300);
})();
// ====== CHINESE FISH AND CHIPS — INLINE ======
(function() {
var fcActive = false;
var fcAnimId = null;
var fcSource = null;

function initFc() {
  if (fcActive) return; fcActive = true;
  fcSource = document.getElementById("fc-container");
  if (typeof THREE === 'undefined') {
    var s = document.createElement('script');
    s.src = 'vendor/three/three.min.js';
    s.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildFcScene) : buildFcScene()); };
    document.head.appendChild(s);
  } else { (window.dssLoadPost ? window.dssLoadPost(buildFcScene) : buildFcScene()); }
}

// 2026-10-25 (Sam rejected the compact stand-in): waiting is the authored chippy street itself,
// seen from the kerb outside it with K. WEST beside. This layer adds only the passing rain and the drifting focus;
// it reads root.dataset.waitActive / waitProgress from the waiting passage's script.
function fcWaitingLayer(root, wrap, renderer) {
  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // The rain is drawn above the scenery, so it stays legible as the street goes out of focus behind it.
  var rc = document.createElement('canvas'), cx = rc.getContext('2d');
  rc.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:2;';
  wrap.appendChild(rc);
  var drops = [], seed = 7, opacity = 0, last = performance.now(), canvas = renderer.domElement, W = 0, H = 0;
  function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
  for (var i = 0; i < 240; i++) drops.push({ x: rnd(), y: rnd(), d: 0.35 + rnd() * 0.65 });
  return function(now) {
    var dt = Math.min(0.05, (now - last) / 1000); last = now;
    var active = root.dataset.waitActive === 'true', p = active ? Math.max(0, Math.min(1, +root.dataset.waitProgress || 0)) : 0;
    canvas.style.filter = active ? 'blur(' + (p * 8).toFixed(2) + 'px)' : 'none';
    canvas.style.transform = active ? 'scale(' + (1 + p * 0.035).toFixed(4) + ')' : 'none';
    // Showers come and go inside a wait; none before it starts, and it stops when the wait ends.
    var shower = active ? Math.max(0, Math.sin(p * Math.PI * 3.2 + 0.4) * 0.6 + Math.sin(now * 0.00037) * 0.4) : 0;
    opacity = active ? opacity + (shower - opacity) * Math.min(1, dt * 1.5) : 0;
    if (W !== window.innerWidth || H !== window.innerHeight) { W = rc.width = window.innerWidth; H = rc.height = window.innerHeight; }
    cx.clearRect(0, 0, W, H);
    if (opacity < 0.02) return;
    cx.lineCap = 'round';
    for (var k = 0; k < drops.length; k++) {
      var r = drops[k], len = (10 + 26 * r.d) / H;
      if (!still) { r.y += dt * (0.9 + 1.5 * r.d); if (r.y > 1 + len) { r.y = -len; r.x = rnd(); } }
      var x = r.x * W, y = r.y * H;
      cx.strokeStyle = 'rgba(176,188,204,' + (opacity * (0.12 + 0.3 * r.d)).toFixed(3) + ')';
      cx.lineWidth = 0.6 + r.d * 0.9;
      cx.beginPath(); cx.moveTo(x, y); cx.lineTo(x - len * H * 0.12, y - len * H); cx.stroke();
    }
  };
}
function buildFcScene() {
  if (!fcSource || !fcSource.isConnected) return;
  var fcWaitRoot = fcSource.closest(".bevan-waiting-clock"); // its own section, never the after-image ghost's copy
  var fcWrap = document.createElement('div');
  fcWrap.id = 'fc-wrap';
  fcWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#040408;overflow:hidden;';
  if (fcWaitRoot) { fcWrap.className = 'bw-street-scene'; fcWrap.style.pointerEvents = 'none'; }
  var fcStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ============================================================
  // SCENE SETUP
  // ============================================================
  var scene = new THREE.Scene();
scene.background = new THREE.Color(0x101019);
scene.fog = new THREE.Fog(0x101019, 5, 38);
scene.add(new THREE.AmbientLight(0x18182a, 0.26)); // added 2026-09-13: no ambient in this scene either

  var camera = new THREE.PerspectiveCamera(52, window.innerWidth / window.innerHeight, 0.1, 200);

  // ============================================================
  // LAYOUT — eye-level off-axis: looking down Greek Street toward
  // the chippy, which sits at the end of a receding row of shops.
  // ============================================================
camera.position.set(-5.0, 1.7, 10.5);
  camera.lookAt(1.2, 3.2, -1);
  // Waiting for LILY: standing on the kerb by the chippy door, K. WEST along the row behind.
  var fcWaitPhone = window.innerWidth < 600;
  function fcWaitView() {
    // A portrait phone needs a wider lens from further back to keep K. WEST and the chippy door both in frame.
    if (fcWaitPhone) { camera.fov = 66; camera.position.set(-0.4, 1.6, 12.5); camera.lookAt(-2.7, 3.4, 0.2); }
    else { camera.fov = 52; camera.position.set(2.6, 1.62, 7.2); camera.lookAt(-2.8, 2.95, 0.2); }
    camera.updateProjectionMatrix();
  }
  if (fcWaitRoot) fcWaitView();

  var renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.shadowMap.enabled = !fcWaitRoot; // a long wait runs lighter: no shadow pass
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
  renderer.toneMappingExposure = 0.65;
  fcWrap.appendChild(renderer.domElement);
  window._dssBindScene('fc-wrap', scene, renderer, camera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(scene, camera, renderer, { focus: 10 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(document.getElementById('fc-wrap'));

  // ============================================================
  // MATERIALS
  // ============================================================
  // Grimy brick — running bond, mortar courses, soot streaks, damp
  // patches, lichen, old paste-up ghost. Front-facade only.
  var brickFaceTex = makeCanvasTexture(512, 512, function(cx, w, h) {
    cx.fillStyle = '#6f4f3a'; cx.fillRect(0, 0, w, h);
    var bH = 14, bW = 32;
    for (var by = 0; by < h; by += bH) {
      var rowOff = ((Math.floor(by / bH)) % 2 === 0) ? 0 : bW / 2;
      for (var bx = -bW; bx < w + bW; bx += bW) {
        var px = bx + rowOff;
        var r = 95 + Math.floor(Math.random() * 50);
        var g = 60 + Math.floor(Math.random() * 35);
        var b = 45 + Math.floor(Math.random() * 30);
        if (Math.random() > 0.94) { r -= 40; g -= 32; b -= 22; }
        if (Math.random() > 0.96) { r += 30; g += 18; b += 10; }
        cx.fillStyle = 'rgb(' + r + ',' + g + ',' + b + ')';
        cx.fillRect(px + 1, by + 1, bW - 2, bH - 2);
        cx.fillStyle = 'rgba(20,12,6,' + (0.05 + Math.random() * 0.10).toFixed(3) + ')';
        cx.fillRect(px + 1, by + bH - 3, bW - 2, 2);
      }
    }
    cx.fillStyle = 'rgba(170, 145, 115, 0.32)';
    for (var hy = 0; hy < h; hy += bH) cx.fillRect(0, hy, w, 1);
    cx.fillStyle = 'rgba(160, 135, 105, 0.22)';
    for (var hyy = 0; hyy < h; hyy += bH) {
      var ro = ((Math.floor(hyy / bH)) % 2 === 0) ? 0 : bW / 2;
      for (var hxx = ro; hxx < w; hxx += bW) cx.fillRect(hxx, hyy, 1.4, bH);
    }
    // Vertical soot streaks
    for (var ss = 0; ss < 5; ss++) {
      var sx = Math.random() * w;
      var sxw = 12 + Math.random() * 30;
      var sg = cx.createLinearGradient(sx, 0, sx, h);
      sg.addColorStop(0, 'rgba(8, 6, 4, 0.55)');
      sg.addColorStop(0.3, 'rgba(12, 10, 6, 0.32)');
      sg.addColorStop(0.7, 'rgba(18, 14, 9, 0.12)');
      sg.addColorStop(1, 'rgba(22, 18, 10, 0)');
      cx.fillStyle = sg; cx.fillRect(sx - sxw / 2, 0, sxw, h);
    }
    // Damp / green patches (low-down)
    for (var d = 0; d < 5; d++) {
      var dx = Math.random() * w;
      var dy = h * 0.45 + Math.random() * h * 0.55;
      var dr = 30 + Math.random() * 50;
      var dg2 = cx.createRadialGradient(dx, dy, 0, dx, dy, dr);
      dg2.addColorStop(0, 'rgba(60, 75, 55, 0.32)');
      dg2.addColorStop(0.5, 'rgba(50, 60, 45, 0.16)');
      dg2.addColorStop(1, 'rgba(40, 50, 40, 0)');
      cx.fillStyle = dg2; cx.fillRect(dx - dr, dy - dr, dr * 2, dr * 2);
    }
    // Lichen splatters
    for (var lp = 0; lp < 14; lp++) {
      var lx = Math.random() * w, ly = Math.random() * h;
      var lr = 5 + Math.random() * 12;
      cx.fillStyle = 'rgba(95, 105, 60, ' + (0.10 + Math.random() * 0.18).toFixed(3) + ')';
      cx.beginPath(); cx.ellipse(lx, ly, lr, lr * 0.55, Math.random() * Math.PI, 0, Math.PI * 2); cx.fill();
    }
    // Top soot wash (chimney run-off)
    var topG = cx.createLinearGradient(0, 0, 0, h * 0.45);
    topG.addColorStop(0, 'rgba(18, 12, 8, 0.42)');
    topG.addColorStop(1, 'rgba(18, 12, 8, 0)');
    cx.fillStyle = topG; cx.fillRect(0, 0, w, h * 0.45);
    // Faded paste-up poster ghost
    cx.fillStyle = 'rgba(220, 200, 160, 0.08)';
    cx.fillRect(w * 0.12, h * 0.42, w * 0.18, h * 0.13);
    cx.fillStyle = 'rgba(180, 160, 120, 0.05)';
    cx.fillRect(w * 0.13, h * 0.43, w * 0.16, h * 0.11);
    // A few bright highlight bricks (paint-fleck or sunlight remnant)
    for (var hl = 0; hl < 8; hl++) {
      var hbx = Math.floor(Math.random() * (w / bW)) * bW;
      var hby = Math.floor(Math.random() * (h / bH)) * bH;
      cx.fillStyle = 'rgba(220, 195, 150, ' + (0.10 + Math.random() * 0.15).toFixed(3) + ')';
      cx.fillRect(hbx + 1, hby + 1, bW - 2, 2);
    }
  });
  brickFaceTex.wrapS = brickFaceTex.wrapT = THREE.RepeatWrapping;
  brickFaceTex.repeat.set(2, 4);
  var brickMat = new THREE.MeshStandardMaterial({ map: brickFaceTex, roughness: 0.92 });

  // Darker brick variant for façade panel — same texture, tinted darker
  var brickFaceTex2 = makeCanvasTexture(512, 512, function(cx, w, h) {
    cx.fillStyle = '#54382a'; cx.fillRect(0, 0, w, h);
    var bH = 14, bW = 32;
    for (var by = 0; by < h; by += bH) {
      var rowOff = ((Math.floor(by / bH)) % 2 === 0) ? 0 : bW / 2;
      for (var bx = -bW; bx < w + bW; bx += bW) {
        var px = bx + rowOff;
        var r = 75 + Math.floor(Math.random() * 40);
        var g = 45 + Math.floor(Math.random() * 28);
        var b = 32 + Math.floor(Math.random() * 22);
        if (Math.random() > 0.94) { r -= 28; g -= 22; b -= 16; }
        cx.fillStyle = 'rgb(' + r + ',' + g + ',' + b + ')';
        cx.fillRect(px + 1, by + 1, bW - 2, bH - 2);
      }
    }
    cx.fillStyle = 'rgba(140, 115, 90, 0.22)';
    for (var hy = 0; hy < h; hy += bH) cx.fillRect(0, hy, w, 1);
    // Heavy soot below window-line area
    var topG = cx.createLinearGradient(0, 0, 0, h);
    topG.addColorStop(0, 'rgba(10, 6, 4, 0.45)');
    topG.addColorStop(0.5, 'rgba(15, 10, 6, 0.18)');
    topG.addColorStop(1, 'rgba(20, 14, 8, 0.06)');
    cx.fillStyle = topG; cx.fillRect(0, 0, w, h);
  });
  brickFaceTex2.wrapS = brickFaceTex2.wrapT = THREE.RepeatWrapping;
  brickFaceTex2.repeat.set(2, 4);
  var darkBrick = new THREE.MeshStandardMaterial({ map: brickFaceTex2, roughness: 0.95 });

  // Weathered surfaces — the flat paints read showroom-clean; Soho '73 needs
  // soot at the cornices, scuffs at the skirting, and sun-faded streaks.
  var stuccoTex = (window.dssScene && window.dssScene.makeWeatheredStucco) ? window.dssScene.makeWeatheredStucco({ baseColor: 0xd8d0b8 }) : null;
  var creamPaint = new THREE.MeshStandardMaterial(stuccoTex ? { map: stuccoTex, roughness: 0.8 } : { color: 0xd8d0b8, roughness: 0.75 });
  var redWearTex = makeCanvasTexture(256, 256, function(cx, w, h) {
    cx.fillStyle = '#8a1818'; cx.fillRect(0, 0, w, h);
    for (var rs = 0; rs < 34; rs++) { var rxx = Math.random() * w; cx.fillStyle = 'rgba(' + (115 + Math.floor(Math.random() * 50)) + ',26,20,' + (0.14 + Math.random() * 0.16).toFixed(2) + ')'; cx.fillRect(rxx, 0, 2 + Math.random() * 8, h); }
    // Grime blotches — irregular darker patches, the dirt of decades
    for (var gb = 0; gb < 9; gb++) { var gbx = Math.random() * w, gby = Math.random() * h, gbr = 18 + Math.random() * 42; var gg = cx.createRadialGradient(gbx, gby, 0, gbx, gby, gbr); gg.addColorStop(0, 'rgba(30,12,10,' + (0.18 + Math.random() * 0.2).toFixed(2) + ')'); gg.addColorStop(1, 'rgba(30,12,10,0)'); cx.fillStyle = gg; cx.fillRect(gbx - gbr, gby - gbr, gbr * 2, gbr * 2); }
    var sootT = cx.createLinearGradient(0, 0, 0, 40); sootT.addColorStop(0, 'rgba(10,6,4,0.35)'); sootT.addColorStop(1, 'rgba(10,6,4,0)'); cx.fillStyle = sootT; cx.fillRect(0, 0, w, 40);
    var scufB = cx.createLinearGradient(0, h - 50, 0, h); scufB.addColorStop(0, 'rgba(20,10,8,0)'); scufB.addColorStop(1, 'rgba(20,10,8,0.45)'); cx.fillStyle = scufB; cx.fillRect(0, h - 50, w, 50);
    for (var rc = 0; rc < 90; rc++) { cx.fillStyle = 'rgba(40,14,12,' + (0.25 + Math.random() * 0.3).toFixed(2) + ')'; cx.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 3, 1 + Math.random() * 2); }
  });
  var shopRed = new THREE.MeshStandardMaterial({ map: redWearTex, roughness: 0.65 });
  var darkRed = new THREE.MeshStandardMaterial({ color: 0x5a1010, roughness: 0.7 });
  var goldTrim = new THREE.MeshStandardMaterial({ color: 0xc8a840, roughness: 0.35, metalness: 0.3 });
  var brightGold = new THREE.MeshStandardMaterial({ color: 0xd4b850, roughness: 0.3, metalness: 0.4 });
  var tileMat = new THREE.MeshStandardMaterial({ color: 0xb9c6bd, roughness: 0.62 }); // aged
  var whiteTile = new THREE.MeshStandardMaterial({ color: 0xd9d5c7, roughness: 0.6 }); // aged
  var whiteTrim = new THREE.MeshStandardMaterial({ color: 0xe8e4dc, roughness: 0.7 });
  var creamTrim = new THREE.MeshStandardMaterial({ color: 0xd8d0c0, roughness: 0.75 });
  var blackMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 0.5 });
  var redPaint = new THREE.MeshStandardMaterial({ map: redWearTex, color: 0xd88888, roughness: 0.6 }); // brighter tint over the same worn red

  // Pavement — slabs with cracks, gum, wet patches
  var paveFaceTex = makeCanvasTexture(512, 512, function(cx, w, h) {
    cx.fillStyle = '#3a3a36'; cx.fillRect(0, 0, w, h);
    var sw = 128, sh = 96;
    cx.strokeStyle = 'rgba(18, 18, 16, 0.55)'; cx.lineWidth = 1.4;
    for (var sy = 0; sy < h; sy += sh) {
      var off = ((sy / sh) % 2 === 0) ? 0 : sw / 2;
      for (var sx = -sw; sx < w + sw; sx += sw) {
        var bxp = sx + off;
        var sg = 48 + Math.floor(Math.random() * 28);
        cx.fillStyle = 'rgba(' + sg + ',' + sg + ',' + (sg - 4) + ',' + (0.32 + Math.random() * 0.3).toFixed(3) + ')';
        cx.fillRect(bxp, sy, sw, sh);
        cx.strokeRect(bxp, sy, sw, sh);
      }
    }
    cx.strokeStyle = 'rgba(15, 15, 12, 0.55)'; cx.lineWidth = 0.9;
    for (var c2 = 0; c2 < 7; c2++) {
      cx.beginPath();
      cx.moveTo(Math.random() * w, Math.random() * h);
      cx.lineTo(Math.random() * w, Math.random() * h);
      cx.stroke();
    }
    // Gum and fag-ends
    for (var fe = 0; fe < 60; fe++) {
      cx.fillStyle = 'rgba(180, 175, 165, ' + (0.15 + Math.random() * 0.22).toFixed(3) + ')';
      cx.beginPath(); cx.arc(Math.random() * w, Math.random() * h, 1.0 + Math.random() * 1.6, 0, Math.PI * 2); cx.fill();
    }
    // Wet patches
    for (var wp = 0; wp < 5; wp++) {
      var wpx = Math.random() * w, wpy = Math.random() * h;
      var wpr = 35 + Math.random() * 60;
      var wpg = cx.createRadialGradient(wpx, wpy, 0, wpx, wpy, wpr);
      wpg.addColorStop(0, 'rgba(72, 78, 80, 0.35)');
      wpg.addColorStop(1, 'rgba(72, 78, 80, 0)');
      cx.fillStyle = wpg; cx.fillRect(wpx - wpr, wpy - wpr, wpr * 2, wpr * 2);
    }
  });
  paveFaceTex.wrapS = paveFaceTex.wrapT = THREE.RepeatWrapping;
  paveFaceTex.repeat.set(16, 16); // was 4,4 over a 60m plane — slabs rendered 4m wide and every detail stretched away
  var pavementMat = new THREE.MeshStandardMaterial({ map: paveFaceTex, roughness: 0.5 }); // damp after the rain

  // Road — tarmac with aggregate, cracks, repair patches, tar-seal,
  // oil stains, faded white line.
  var roadFaceTex = makeCanvasTexture(512, 512, function(cx, w, h) {
    cx.fillStyle = '#1c1c1c'; cx.fillRect(0, 0, w, h);
    // Aggregate speckle
    for (var p = 0; p < 4200; p++) {
      var pg = 25 + Math.floor(Math.random() * 70);
      cx.fillStyle = 'rgba(' + pg + ',' + pg + ',' + pg + ',0.42)';
      cx.fillRect(Math.random() * w, Math.random() * h, 1.5, 1.5);
    }
    // Repair patches (lighter rectangular tarmac)
    for (var rp = 0; rp < 6; rp++) {
      var rx = Math.random() * w, ry = Math.random() * h;
      var rwd = 50 + Math.random() * 100, rht = 35 + Math.random() * 70;
      cx.fillStyle = 'rgba(78, 78, 78, ' + (0.16 + Math.random() * 0.22).toFixed(3) + ')';
      cx.fillRect(rx, ry, rwd, rht);
      // patch border (lighter edge)
      cx.strokeStyle = 'rgba(100, 100, 100, 0.18)'; cx.lineWidth = 0.6;
      cx.strokeRect(rx, ry, rwd, rht);
    }
    // Cracks (jagged)
    cx.strokeStyle = 'rgba(8, 8, 8, 0.8)'; cx.lineWidth = 1.2;
    for (var c = 0; c < 10; c++) {
      cx.beginPath();
      var cx0 = Math.random() * w, cy0 = Math.random() * h;
      cx.moveTo(cx0, cy0);
      var ang = Math.random() * Math.PI * 2, len = 30 + Math.random() * 80;
      cx.lineTo(cx0 + Math.cos(ang) * len, cy0 + Math.sin(ang) * len);
      cx.lineTo(cx0 + Math.cos(ang + 0.4) * len * 1.4, cy0 + Math.sin(ang + 0.4) * len * 1.4);
      cx.stroke();
    }
    // Tar-seal lines (wandering black sealant over cracks)
    cx.strokeStyle = 'rgba(0, 0, 0, 0.9)'; cx.lineWidth = 2.6;
    for (var tm = 0; tm < 5; tm++) {
      cx.beginPath();
      var tx = Math.random() * w, ty = Math.random() * h;
      cx.moveTo(tx, ty);
      for (var ts = 0; ts < 5; ts++) {
        tx += (Math.random() - 0.5) * 30;
        ty += 8 + Math.random() * 16;
        cx.lineTo(tx, ty);
      }
      cx.stroke();
    }
    // Faded white centre line
    cx.fillStyle = 'rgba(220, 220, 200, 0.5)';
    cx.fillRect(w * 0.5 - 2, h * 0.3, 4, h * 0.4);
    cx.fillStyle = 'rgba(220, 220, 200, 0.18)';
    cx.fillRect(w * 0.5 - 2, h * 0.05, 4, h * 0.2);
    cx.fillRect(w * 0.5 - 2, h * 0.75, 4, h * 0.2);
    // Oil / dirt blotches
    for (var os = 0; os < 4; os++) {
      var ox = Math.random() * w, oy = Math.random() * h;
      var orr = 8 + Math.random() * 18;
      var og = cx.createRadialGradient(ox, oy, 0, ox, oy, orr);
      og.addColorStop(0, 'rgba(0, 0, 0, 0.62)');
      og.addColorStop(0.7, 'rgba(15, 12, 5, 0.22)');
      og.addColorStop(1, 'rgba(15, 12, 5, 0)');
      cx.fillStyle = og; cx.fillRect(ox - orr, oy - orr, orr * 2, orr * 2);
    }
  });
  roadFaceTex.wrapS = roadFaceTex.wrapT = THREE.RepeatWrapping;
  roadFaceTex.repeat.set(1, 8);
  var roadMat = new THREE.MeshStandardMaterial({ map: roadFaceTex, roughness: 0.78, metalness: 0.18 });
  var sillMat = new THREE.MeshStandardMaterial({ color: 0xdcd4c8, roughness: 0.7 });
  var windowFrame = new THREE.MeshStandardMaterial({ color: 0xd8d0c0, roughness: 0.6 });
  var pipeMat = new THREE.MeshStandardMaterial({ color: 0x2a2a28, roughness: 0.7 });
  var ironMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.6, metalness: 0.3 });
  var woodMat = new THREE.MeshStandardMaterial({ color: 0x3a2a1a, roughness: 0.8 });
  var chromeMat = new THREE.MeshStandardMaterial({ color: 0x888888, roughness: 0.2, metalness: 0.6 });
  var formicaMat = new THREE.MeshStandardMaterial({ color: 0xd8c8a0, roughness: 0.4 });

  // ============================================================
  // HELPERS
  // ============================================================
  function makeCanvasTexture(w, h, drawFunc) {
    var c = document.createElement('canvas');
    c.width = w; c.height = h;
    var cx = c.getContext('2d');
    drawFunc(cx, w, h);
    var tex = new THREE.CanvasTexture(c);
    tex.minFilter = THREE.LinearFilter;
    return tex;
  }

  function placeMesh(group, geo, mat, x, y, z) {
    var m = new THREE.Mesh(geo, mat);
    m.position.set(x, y, z);
    group.add(m);
    return m;
  }

  // ============================================================
  // GROUND
  // ============================================================
  var ground = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), pavementMat);
  ground.rotation.x = -Math.PI / 2;
  ground.receiveShadow = true;
  scene.add(ground);

  var road = new THREE.Mesh(new THREE.PlaneGeometry(8, 60), roadMat);
  road.rotation.x = -Math.PI / 2;
  road.position.set(0, 0.004, 10);
  road.receiveShadow = true;
  scene.add(road);

  // Wet road surface (reflective — picks up the bright chippy glow)
  var wetMat = new THREE.MeshStandardMaterial({
    color: 0x1a1a1a, roughness: 0.1, metalness: 0.6, transparent: true, opacity: 0.35
  });
  var wetRoad = new THREE.Mesh(new THREE.PlaneGeometry(16, 16), wetMat);
  wetRoad.rotation.x = -Math.PI / 2;
  wetRoad.position.set(0, 0.01, 8);
  scene.add(wetRoad);

  // Road centre dashes
  for (var rli = -6; rli < 20; rli += 2.5) {
    var roadLine = new THREE.Mesh(new THREE.PlaneGeometry(0.12, 1.5),
      new THREE.MeshStandardMaterial({ color: 0x888888, roughness: 0.7, transparent: true, opacity: 0.25 }));
    roadLine.rotation.x = -Math.PI / 2;
    roadLine.position.set(0, 0.02, rli);
    scene.add(roadLine);
  }

  // ============================================================
  // THE CHINESE FISH & CHIPS
  // ============================================================
  var shop = new THREE.Group();

  // ---- BUILDING BODY ----
  // Simple 3-storey brick building. Narrower than the pubs — about 6 units wide.
  // The chippy is the ground floor; upper floors are residential flats.
  // 2026-10-28 (Sam, playtest note 29: "graphically underdeveloped"): the body and facade ran to the ground, a solid
  // slab in front of the counter, so the windows showed a flat red wash and nothing behind it. The brick now starts
  // above the shopfront and the ground floor is a room of its own: lino floor, tiled walls, a ceiling, the range.
  var buildingBody = new THREE.Mesh(new THREE.BoxGeometry(6, 7.4, 6), brickMat);
  buildingBody.position.set(0.5, 7.3, -3);
  shop.add(buildingBody);
  // Facade panel (slightly different tone)
  placeMesh(shop, new THREE.BoxGeometry(6.02, 7.4, 0.06), darkBrick, 0.5, 7.3, 0.03);
  placeMesh(shop, new THREE.BoxGeometry(6, 3.7, 5.2), brickMat, 0.5, 1.85, -3.4);
  var fc29TileTex = makeCanvasTexture(512, 320, function(cx, w, h) {
    cx.fillStyle = '#ece6d6'; cx.fillRect(0, 0, w, h);
    for (var ty = 0; ty < h; ty += 32) for (var tx = 0; tx < w; tx += 32) { var g = 222 + Math.floor(Math.random() * 18); cx.fillStyle = 'rgb(' + g + ',' + (g - 4) + ',' + (g - 16) + ')'; cx.fillRect(tx + 1, ty + 1, 30, 30); }
    cx.fillStyle = '#2f6a4e'; cx.fillRect(0, h * 0.62, w, 14);
    cx.fillStyle = 'rgba(120,110,90,0.35)'; for (var gx = 0; gx <= w; gx += 32) cx.fillRect(gx, 0, 1, h); for (var gy = 0; gy <= h; gy += 32) cx.fillRect(0, gy, w, 1);
    var grease = cx.createLinearGradient(0, h * 0.35, 0, h); grease.addColorStop(0, 'rgba(120,80,20,0)'); grease.addColorStop(1, 'rgba(120,80,20,0.28)'); cx.fillStyle = grease; cx.fillRect(0, 0, w, h);
  });
  var fc29Tile = new THREE.MeshStandardMaterial({ map: fc29TileTex, roughness: 0.45 });
  placeMesh(shop, new THREE.BoxGeometry(0.1, 3.7, 1.0), fc29Tile, -2.45, 1.85, -0.3);
  placeMesh(shop, new THREE.BoxGeometry(0.1, 3.7, 1.0), fc29Tile, 3.45, 1.85, -0.3);
  var fc29LinoTex = makeCanvasTexture(256, 256, function(cx, w, h) {
    for (var y = 0; y < 8; y++) for (var x = 0; x < 8; x++) { cx.fillStyle = (x + y) % 2 ? '#7a1e1e' : '#d8cdb4'; cx.fillRect(x * 32, y * 32, 32, 32); }
    cx.fillStyle = 'rgba(40,25,10,0.25)'; for (var sm = 0; sm < 60; sm++) cx.fillRect(Math.random() * w, Math.random() * h, 2 + Math.random() * 6, 1 + Math.random() * 3);
  });
  fc29LinoTex.wrapS = fc29LinoTex.wrapT = THREE.RepeatWrapping; fc29LinoTex.repeat.set(3, 0.5);
  var fc29Lino = new THREE.Mesh(new THREE.PlaneGeometry(6, 1.1), new THREE.MeshStandardMaterial({ map: fc29LinoTex, roughness: 0.5 }));
  fc29Lino.rotation.x = -Math.PI / 2; fc29Lino.position.set(0.5, 0.012, -0.3); shop.add(fc29Lino);
  var fc29Ceil = new THREE.Mesh(new THREE.PlaneGeometry(6, 1.1), new THREE.MeshStandardMaterial({ color: 0xe8e2d0, roughness: 0.8 }));
  fc29Ceil.rotation.x = Math.PI / 2; fc29Ceil.position.set(0.5, 3.72, -0.3); shop.add(fc29Ceil);

  // Side wall (visible at angle)
  var sideWall = new THREE.Mesh(new THREE.PlaneGeometry(6, 11),
    new THREE.MeshStandardMaterial({ color: 0x6a4a38, roughness: 0.88 }));
  sideWall.position.set(-2.49, 5.5, -3);
  sideWall.rotation.y = Math.PI / 2;
  shop.add(sideWall);

  // Mortar coursework hints
  for (var bri = 3.85; bri < 11; bri += 0.35) {
    if (Math.random() > 0.35) {
      placeMesh(shop, new THREE.PlaneGeometry(6.01, 0.015),
        new THREE.MeshStandardMaterial({ color: 0xb09888, roughness: 0.9, transparent: true, opacity: 0.18 }),
        0.5, bri, 0.05);
    }
  }

  // ---- UPPER FLOOR WINDOWS (residential — simple sash windows) ----
  // 2 rows of 3 windows. One warm-lit (row 0 col 1) and one red-lit
  // brothel-style upper-floor window (row 1 col 2) — same recipe as
  // Lackland's office: emissive redGlass + red point light.
  var upWinXs = [-0.8, 0.8, 2.4];
  var redBrothelGlass = new THREE.MeshStandardMaterial({
    color: 0x260e17, roughness: 0.35, emissive: 0x802039, emissiveIntensity: 0.32
  });
  for (var row = 0; row < 2; row++) {
    for (var col = 0; col < 3; col++) {
      var uwx = upWinXs[col];
      var uwy = 6.5 + row * 3;
      var uwLit = (row === 0 && col === 1);
      var uwRed = (row === 1 && col === 2); // top-right = red light
      // Brick reveal
      placeMesh(shop, new THREE.BoxGeometry(0.95, 1.55, 0.04),
        new THREE.MeshStandardMaterial({ color: 0x4a2a1a, roughness: 0.9 }), uwx, uwy, 0.04);
      // Frame
      placeMesh(shop, new THREE.BoxGeometry(0.85, 1.45, 0.05), windowFrame, uwx, uwy, 0.06);
      placeMesh(shop, new THREE.BoxGeometry(0.72, 1.32, 0.03), windowFrame, uwx, uwy, 0.09);
      // Glass
      if (uwRed) {
        placeMesh(shop, new THREE.BoxGeometry(0.68, 1.28, 0.03), redBrothelGlass, uwx, uwy, 0.11);
      } else {
        var uwGlassMat = (window.dssScene && window.dssScene.makeDressedWindow)
          ? window.dssScene.makeDressedWindow(uwLit, (row + col) % 3, (row * 2 + col) % 4)
          : new THREE.MeshBasicMaterial({ color: uwLit ? 0xffd699 : 0x334466, transparent: true, opacity: uwLit ? 0.35 : 0.12 });
        placeMesh(shop, new THREE.PlaneGeometry(0.68, 1.28), uwGlassMat, uwx, uwy, 0.11);
      }
      // Sash bar
      placeMesh(shop, new THREE.BoxGeometry(0.75, 0.04, 0.04), windowFrame, uwx, uwy + 0.1, uwRed ? 0.23 : 0.11);
      // Glazing bars
      if (!uwRed) placeMesh(shop, new THREE.BoxGeometry(0.02, 1.28, 0.02), windowFrame, uwx, uwy, 0.12);
      if (!uwRed) placeMesh(shop, new THREE.BoxGeometry(0.68, 0.02, 0.02), windowFrame, uwx, uwy + 0.35, 0.12);
      if (!uwRed) placeMesh(shop, new THREE.BoxGeometry(0.68, 0.02, 0.02), windowFrame, uwx, uwy - 0.35, 0.12);
      // Sill
      placeMesh(shop, new THREE.BoxGeometry(0.95, 0.07, 0.16), sillMat, uwx, uwy - 0.78, 0.13);
      // Lintel
      placeMesh(shop, new THREE.BoxGeometry(0.95, 0.1, 0.05),
        new THREE.MeshStandardMaterial({ color: 0x8a5a48, roughness: 0.8 }), uwx, uwy + 0.78, 0.08);
    }
  }
  // Red point light spilling out of the brothel window
  var redBrothelLight = new THREE.PointLight(0xcb5360, 0.32, 5);
  // shop is positioned at (0,0,0); upper window col 2 is at uwx=2.4
  // row 1 puts it at uwy = 6.5 + 1*3 = 9.5; spilling forward to z ≈ 1.3
  redBrothelLight.position.set(2.4, 9.5, 1.3);
  scene.add(redBrothelLight);

  // 2026-10-25 (Sam): a simple continuous 3D silhouette, no portrait texture.
  var rwRoomTexture=makeCanvasTexture(128,256,function(cx,w,h){
    var g=cx.createRadialGradient(w*.57,h*.39,2,w*.5,h*.47,h*.7);
    g.addColorStop(0,'#71313a');g.addColorStop(.38,'#4d1b28');g.addColorStop(1,'#1c0c15');
    cx.fillStyle=g;cx.fillRect(0,0,w,h);
    for(var side=0;side<2;side++)for(var fold=0;fold<5;fold++){
      cx.fillStyle=fold%2?'rgba(19,6,17,.55)':'rgba(62,16,33,.65)';
      cx.fillRect(side?w-18+fold*4:fold*4,0,4,h);
    }
  });
  var rwRoomMat=new THREE.MeshBasicMaterial({map:rwRoomTexture,toneMapped:false});
  placeMesh(shop,new THREE.PlaneGeometry(0.68,1.28),rwRoomMat,2.4,9.5,0.131);
  renderer.localClippingEnabled=true;
  var rwClip=[new THREE.Plane(new THREE.Vector3(1,0,0),-2.06),new THREE.Plane(new THREE.Vector3(-1,0,0),2.74),
    new THREE.Plane(new THREE.Vector3(0,1,0),-8.86),new THREE.Plane(new THREE.Vector3(0,-1,0),10.14)];
  var rwMat=new THREE.MeshStandardMaterial({color:0x34202b,roughness:.9,
    emissive:0x160912,emissiveIntensity:.16,transparent:true,opacity:0,clippingPlanes:rwClip});
  var rwHairMat=rwMat.clone();rwHairMat.color.setHex(0x17101b);
  var rwFaceMat=rwMat.clone();rwFaceMat.color.setHex(0x583b44);
  rwFaceMat.emissive.setHex(0x231019);rwFaceMat.emissiveIntensity=.12;
  // A soft local modelling light catches rounded surfaces without filling the silhouette.
  var rwModelLight=new THREE.PointLight(0xe5a2a0,.65,2.6,2);
  rwModelLight.position.set(2.05,9.95,.95);scene.add(rwModelLight);
  var rwEdgeMat=rwMat.clone();rwEdgeMat.color.setHex(0x44212b);rwEdgeMat.emissive.setHex(0x421b27);rwEdgeMat.emissiveIntensity=.23;
  var rwWoman=new THREE.Group();rwWoman.position.set(2.4,9.5,.15);shop.add(rwWoman);
  var rwBodyPivot=new THREE.Group();rwBodyPivot.position.y=-.36;rwWoman.add(rwBodyPivot);
  function rwForm(shape,mat,parent,z){
    var geo=new THREE.ExtrudeGeometry(shape,{depth:.018,bevelEnabled:true,
      bevelThickness:.009,bevelSize:.008,bevelSegments:4,curveSegments:20,steps:1});
    // The front is gently domed, rather than a flat extrusion. Its smooth normals
    // let the local red light describe volume while the original outline stays intact.
    geo.computeBoundingBox();var bounds=geo.boundingBox;
    var midX=(bounds.min.x+bounds.max.x)/2,midY=(bounds.min.y+bounds.max.y)/2;
    var halfX=(bounds.max.x-bounds.min.x)/2,halfY=(bounds.max.y-bounds.min.y)/2;
    var depth=Math.min(.028,halfX*.30),pos=geo.attributes.position,norm=geo.attributes.normal;
    for(var vi=0;vi<pos.count;vi++){
      if(norm.getZ(vi)<.5)continue;
      var xx=(pos.getX(vi)-midX)/halfX,yy=(pos.getY(vi)-midY)/halfY;
      var cross=Math.max(0,1-xx*xx),height=Math.max(0,1-yy*yy);
      pos.setZ(vi,pos.getZ(vi)+depth*cross*height);
      var n=new THREE.Vector3(2*depth*xx*height/halfX,2*depth*yy*cross/halfY,1).normalize();
      norm.setXYZ(vi,n.x,n.y,n.z);
    }
    pos.needsUpdate=true;norm.needsUpdate=true;geo.computeBoundingSphere();
    var m=new THREE.Mesh(geo,mat);m.position.z=z||0;parent.add(m);return m;
  }
  // Shoulder, waist and skirt are one flowing outline; the pose supplies the detail.
  var rwShape=new THREE.Shape();
  rwShape.moveTo(-.17,-.64);
  rwShape.bezierCurveTo(-.14,-.45,-.11,-.36,-.075,-.25);
  rwShape.bezierCurveTo(-.065,-.19,-.075,-.10,-.115,-.025);
  rwShape.bezierCurveTo(-.14,.018,-.145,.075,-.11,.10);
  rwShape.quadraticCurveTo(-.067,.125,-.032,.165);
  rwShape.lineTo(-.027,.222);rwShape.lineTo(.028,.222);rwShape.lineTo(.033,.163);
  rwShape.quadraticCurveTo(.06,.13,.12,.095);
  rwShape.bezierCurveTo(.156,.07,.143,.01,.117,-.04);
  rwShape.bezierCurveTo(.083,-.13,.059,-.17,.076,-.25);
  rwShape.bezierCurveTo(.12,-.36,.165,-.44,.185,-.64);rwShape.closePath();
  var rwBody=rwForm(rwShape,rwMat,rwBodyPivot);rwBody.position.y=.36;
  // A single arm curves to her hip. A hole keeps the elbow's gesture readable.
  var rwLeft=new THREE.Shape();rwLeft.moveTo(-.113,.085);
  rwLeft.bezierCurveTo(-.177,.05,-.205,-.07,-.20,-.14);
  rwLeft.quadraticCurveTo(-.177,-.22,-.079,-.255);
  rwLeft.lineTo(-.064,-.232);rwLeft.quadraticCurveTo(-.153,-.19,-.162,-.13);
  rwLeft.quadraticCurveTo(-.161,-.032,-.09,.039);rwLeft.closePath();
  rwForm(rwLeft,rwMat,rwBodyPivot).position.y=.36;
  // A small turned profile, without painted eyes, lips, jewellery or surface detail.
  var rwHead=new THREE.Group();rwHead.position.set(0,.63,.005);rwBodyPivot.add(rwHead);
  var rwFace=new THREE.Shape();rwFace.moveTo(-.04,-.045);
  rwFace.bezierCurveTo(-.083,-.006,-.08,.075,-.035,.098);
  rwFace.bezierCurveTo(.009,.12,.057,.084,.062,.047);
  rwFace.lineTo(.063,.021);rwFace.quadraticCurveTo(.063,.014,.077,-.001);
  rwFace.quadraticCurveTo(.084,-.009,.066,-.012);
  rwFace.bezierCurveTo(.064,-.037,.054,-.061,.032,-.069);
  rwFace.quadraticCurveTo(-.004,-.08,-.04,-.045);rwFace.closePath();
  rwForm(rwFace,rwFaceMat,rwHead,.014);
  // 2026-10-25 (Sam): swept-back updo, exposed ear/nape, one loose curl.
  var rwHair=new THREE.Shape();rwHair.moveTo(.059,.052);
  rwHair.bezierCurveTo(.063,.101,.002,.139,-.046,.119);
  rwHair.quadraticCurveTo(-.072,.138,-.101,.119);
  rwHair.bezierCurveTo(-.143,.11,-.147,.064,-.119,.04);
  rwHair.quadraticCurveTo(-.108,.026,-.082,.03);
  rwHair.quadraticCurveTo(-.071,.035,-.062,.053);
  rwHair.quadraticCurveTo(-.018,.057,.016,.077);
  rwHair.quadraticCurveTo(.038,.083,.059,.052);rwHair.closePath();
  rwForm(rwHair,rwHairMat,rwHead,.036);
  var rwEarShape=new THREE.Shape();rwEarShape.absellipse(0,0,.012,.022,0,Math.PI*2,false,0);
  var rwEar=rwForm(rwEarShape,rwFaceMat,rwHead,.056);
  rwEar.position.x=-.073;rwEar.position.y=-.008;rwEar.scale.set(.72,.8,.65);
  var rwCurlPath=new THREE.CatmullRomCurve3([
    new THREE.Vector3(-.035,.07,.075),new THREE.Vector3(-.044,.036,.078),
    new THREE.Vector3(-.031,.009,.078),new THREE.Vector3(-.034,-.023,.075),
    new THREE.Vector3(-.019,-.035,.072),new THREE.Vector3(-.013,-.025,.072)]);
  rwHead.add(new THREE.Mesh(new THREE.TubeGeometry(rwCurlPath,24,.0035,6,false),rwHairMat));
  // The neck catches a little of the same soft light as the cheek.
  var rwNeckShape=new THREE.Shape();rwNeckShape.moveTo(-.026,.164);
  rwNeckShape.quadraticCurveTo(-.018,.205,-.026,.264);
  rwNeckShape.lineTo(.025,.264);rwNeckShape.quadraticCurveTo(.022,.205,.032,.165);
  rwNeckShape.quadraticCurveTo(.004,.151,-.026,.164);rwNeckShape.closePath();
  var rwNeck=rwForm(rwNeckShape,rwFaceMat,rwBodyPivot,.029);rwNeck.position.y=.36;
  // A restrained crescent at the far cheek catches the soft red spill.
  var rwRim=new THREE.Shape();rwRim.moveTo(.054,.04);rwRim.quadraticCurveTo(.069,.004,.054,-.027);
  rwRim.quadraticCurveTo(.044,-.052,.032,-.058);rwRim.quadraticCurveTo(.049,-.056,.06,-.031);
  rwRim.quadraticCurveTo(.076,.008,.054,.04);rwRim.closePath();rwForm(rwRim,rwEdgeMat,rwHead,.037);
  // One continuous raised forearm; the palm turns toward the glass during the lean.
  var rwArm=new THREE.Group();rwArm.position.set(.116,.44,.018);rwBodyPivot.add(rwArm);
  var rwArmShape=new THREE.Shape();rwArmShape.moveTo(-.016,.008);
  rwArmShape.quadraticCurveTo(.044,-.015,.085,-.135);
  rwArmShape.quadraticCurveTo(.105,-.152,.112,-.112);
  rwArmShape.lineTo(.126,.094);rwArmShape.lineTo(.101,.098);
  rwArmShape.lineTo(.079,-.09);rwArmShape.quadraticCurveTo(.052,-.006,.016,.032);rwArmShape.closePath();
  rwForm(rwArmShape,rwMat,rwArm);
  var rwHand=new THREE.Group();rwHand.position.set(.113,.09,.012);rwArm.add(rwHand);
  var rwPalm=new THREE.Shape();rwPalm.moveTo(-.012,0);rwPalm.lineTo(-.02,.027);
  rwPalm.quadraticCurveTo(-.038,.047,-.029,.052);rwPalm.lineTo(-.012,.038);
  rwPalm.lineTo(-.011,.083);rwPalm.quadraticCurveTo(-.006,.093,-.002,.081);
  rwPalm.lineTo(.003,.055);rwPalm.lineTo(.007,.092);rwPalm.quadraticCurveTo(.013,.099,.015,.087);
  rwPalm.lineTo(.017,.051);rwPalm.lineTo(.022,.079);rwPalm.quadraticCurveTo(.029,.083,.028,.071);
  rwPalm.lineTo(.027,.032);rwPalm.quadraticCurveTo(.023,.008,.012,0);rwPalm.closePath();
  rwForm(rwPalm,rwMat,rwHand);
  rwWoman.name='halibut-window-silhouette';
  // Foreground reveal masks the shallow model at the actual edge of the aperture.
  [-1,1].forEach(function(side){
    placeMesh(shop,new THREE.BoxGeometry(.85,.085,.04),windowFrame,2.4,9.5+side*.6825,.25);
    placeMesh(shop,new THREE.BoxGeometry(.085,1.45,.04),windowFrame,2.4+side*.3825,9.5,.25);
  });
  var rwState={mode:'away',start:0,until:2,leanAt:0};
  var rwClose=false, rwBlend=0, rwStreetPos=camera.position.clone();
  var rwStreetTarget=new THREE.Vector3(1.2,3.2,-1), rwStreetFov=camera.fov;
  var rwTarget=new THREE.Vector3(2.4,9.5,0.1),rwProjected=new THREE.Vector3();
  var rwHotspot=document.createElement('button');rwHotspot.type='button';
  rwHotspot.setAttribute('aria-label','Look closer at the woman in the red window');rwHotspot.title='Look closer';
  rwHotspot.style.cssText='position:absolute;z-index:9003;min-width:32px;min-height:42px;background:transparent;border:1px solid transparent;border-radius:2px;cursor:zoom-in;padding:0;';
  rwHotspot.onmouseenter=rwHotspot.onfocus=function(){rwHotspot.style.borderColor='rgba(240,151,139,.7)';};
  rwHotspot.onmouseleave=rwHotspot.onblur=function(){rwHotspot.style.borderColor='transparent';};
  var rwBack=document.createElement('button');rwBack.type='button';rwBack.textContent='BACK TO THE STREET';
  rwBack.style.cssText='position:absolute;bottom:60px;left:50%;transform:translateX(-50%);z-index:9005;padding:12px 22px;background:rgba(12,3,10,.88);color:#ecc9b4;border:1px solid #9c5964;font:13px "Courier New",monospace;letter-spacing:2px;display:none;cursor:pointer;white-space:nowrap;';
  function rwSetClose(value){rwClose=value;rwBack.style.display=value?'block':'none';rwHotspot.style.display=value?'none':'block';
    fcBtn.style.visibility=value?'hidden':'visible';if(typeof choicesDock!=='undefined'&&choicesDock)choicesDock.style.visibility=value?'hidden':'visible';
    if(value){rwState.mode='present';rwState.start=clock.getElapsedTime();rwState.until=Infinity;rwState.leanAt=rwState.start+2;rwBack.focus();}
    else{rwState.until=clock.getElapsedTime()+5;rwHotspot.focus();}}
