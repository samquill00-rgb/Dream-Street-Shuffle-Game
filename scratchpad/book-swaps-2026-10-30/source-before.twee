if (link.classList && link.classList.contains('claude-draft') || (link.parentNode && link.parentNode.classList && link.parentNode.classList.contains('claude-draft'))) b.style.color = '#ff3aa8';
b.addEventListener('pointerdown', function(ev) { ev.stopPropagation(); });
b.addEventListener('click', function(ev) { ev.stopPropagation(); if (b._dssLoreNext) { window.dssLore.openNext(link, function() { stepBack(); }); return; } if (window.dssLore && window.dssLore.isLore && window.dssLore.isLore(link.textContent)) { window.dssLore.open(link); return; } if (link.getAttribute && link.getAttribute('data-dss-stay')) { link.click(); if (b.parentNode) b.parentNode.removeChild(b); try { card.focus({ preventScroll: true }); } catch (e) {} return; } if (!link.isConnected) { stepBack(); return; } var kOff = keyActs.indexOf(link) >= 0 ? keyOffer : null, lilyH = link.tagName === 'TW-HOOK' ? link : null; link.click(); stepBack(); if (o.onPress) o.onPress(spot, link); if (kOff) keyTaken(kOff); if (lilyH) lilyTaken(lilyH); });
row.appendChild(b);
});
var wrow = card.querySelector('.fi-wayon');
if (wrow) wayOn.forEach(function(sp) {
var b = document.createElement('span');
b.className = 'fi-action fi-wayon-btn'; b.textContent = sp.name; b.style.cssText = BTN; keyable(b);
b.addEventListener('pointerdown', function(ev) { ev.stopPropagation(); });
