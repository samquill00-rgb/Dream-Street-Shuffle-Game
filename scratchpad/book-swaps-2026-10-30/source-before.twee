})();
// ============================================================
// CINEMATIC POST-PROCESSING (shared) — the Fagin's-den pipeline for every
// 3D scene: UnrealBloom + Bokeh depth-of-field via EffectComposer, plus a
// vignette-and-grain film grade. Add-ons load once from vendor/three/ beside
// the html (vendored 2026-09-16, was two CDNs); if they fail every scene
// falls back to its plain renderer and still works.
// ============================================================
window.dssPostScriptURLs = [
  'vendor/three/shaders/CopyShader.js',
  'vendor/three/shaders/LuminosityHighPassShader.js',
  'vendor/three/shaders/BokehShader.js',
  'vendor/three/shaders/GammaCorrectionShader.js',
  'vendor/three/postprocessing/EffectComposer.js',
  'vendor/three/postprocessing/RenderPass.js',
  'vendor/three/postprocessing/ShaderPass.js',
  'vendor/three/postprocessing/MaskPass.js',
  'vendor/three/postprocessing/UnrealBloomPass.js',
  'vendor/three/postprocessing/BokehPass.js'
];
window.dssLoadPost = function(build) {
  var done = function() {
    try { build(); }
    catch (err) { if (window.dssSceneFailed) window.dssSceneFailed(err, 'build'); else throw err; }
  };
  if (typeof THREE !== 'undefined') window.dssGuardThree(THREE);
  if (typeof THREE !== 'undefined' && THREE.EffectComposer && THREE.BokehPass) { done(); return; }
  var urls = window.dssPostScriptURLs;
