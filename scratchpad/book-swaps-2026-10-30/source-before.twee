<div class="typewriter-page">
To return to Soho from Cecil Court is to cross the Styx; in some or other direction.

You wonder, limning Cambridge Circus, whether, to move from Cecil Court – that foxed God’s acre, full of books that lived and died – into the purgatorial womb of Soho, where books are promised, midwifed, scuppered, dreamed, is to move from death to life or life to death.

[[On.|Dean Street]]
</div>

:: Ride Jeffrey Bernard's cow [cow char-jeff] {"position":"900,1200","size":"100,100"}
You take its bridle. You cry, ‘Soho! Soho!’ and mount the beast.

<div id="cow-game-wrap" class="cow-game-wrap">
<div class="cow-game-heading"><span>JEFFREY BERNARD’S COW</span><span>DEAN → FRITH → POLAND</span></div>
<canvas id="cow-canvas" aria-label="Cow-riding minigame" width="380" height="520"></canvas>
<!-- Lane-controls crib line removed — it duplicated the rules popup. -->
</div>
<span id="cow-go-win" style="display:none;">[[Onward|Cow ride success]]</span>
<span id="cow-go-lose" style="display:none;">[[Thrown|Cow ride fail]]</span>
<!-- Stall safety net: manual escape revealed long after the short cow ride, only if auto-nav stalls. -->
<!-- Stall bail-out: a winning ride runs ~48s (6s practice + 2.2s countdown
     + 40s real) AND the timer counts from passage render, which includes
     however long the player dwells on the rules popup — so 150s, like the
     other canvas bails. (Was 35s, which bloomed a fail link under players
     who were winning.) -->
(after: 150s)[<div class="canvas-bail">The beast tires of you and tips you off. [[Pick yourself up.|Cow ride fail]]</div>]
<span id="cow-state-data" style="display:none">(if: $cowRideDone is true)[done](if: $cowRideWon is true)[ won]</span>
<script>
(function(){
/* ── Skip if already played (won or failed). window.Harlowe isn't exposed for
   direct JS reads in this build, so read $cowRideDone/$cowRideWon from the
   hidden #cow-state-data element that Harlowe prints above. ── */
var _cs = document.getElementById('cow-state-data');
var _ct = _cs ? _cs.textContent : '';
var cowDone = _ct.indexOf('done') !== -1;
var cowWon  = _ct.indexOf('won')  !== -1;
if (cowDone) {
var wrap = document.getElementById('cow-game-wrap');
if (wrap) wrap.style.display = 'none';
var spId = cowWon ? 'cow-go-win' : 'cow-go-lose';
setTimeout(function(){
var sp = document.getElementById(spId);
if (sp) { var lk = sp.querySelector('tw-link'); if (lk) lk.click(); }
}, 500);
return;
}

/* ── Cow-game music: custom loop with accelerating playback rate ── */
var _cowMusicEl = null;
var _cowMusicRate = 1.0;
var _cowMuteWatcher = null;
function _cowMuted() { return !!(window.dssAudio && window.dssAudio.isMuted && window.dssAudio.isMuted()); }
function startCowMusic() {
if (_cowMusicEl) return;
if (window.dssAudio && window.dssAudio.stopBed) window.dssAudio.stopBed('minigame-retro');
var el = new Audio(window._cowGameDataUri || '');
el.volume = 0.28;
el.loop = false;
el.muted = _cowMuted();
el.addEventListener('ended', function() {
_cowMusicRate = Math.min(_cowMusicRate * 1.06, 2.4);
el.playbackRate = _cowMusicRate;
el.currentTime = 0;
el.play().catch(function(){});
});
el.play().catch(function(){});
_cowMusicEl = el;
_cowMuteWatcher = setInterval(function() {
  if (!_cowMusicEl) { clearInterval(_cowMuteWatcher); _cowMuteWatcher = null; return; }
  var m = _cowMuted();
  if (_cowMusicEl.muted !== m) _cowMusicEl.muted = m;
}, 250);
}
function stopCowMusic() {
if (!_cowMusicEl) return;
if (_cowMuteWatcher) { clearInterval(_cowMuteWatcher); _cowMuteWatcher = null; }
_cowMusicEl.pause();
_cowMusicEl.src = '';
_cowMusicEl = null;
_cowMusicRate = 1.0;
}

var W = 380, H = 520;
var canvas = document.getElementById('cow-canvas');
if (!canvas) return;
var ctx = canvas.getContext('2d');
var arcadeReduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var arcadePops=[],arcadeDodged=0,arcadeLives=3,arcadeTier=-1,arcadeNear=0;

/* ── Layout: 3 vertical lanes, player at bottom ── */
var LANE_COUNT = 3;
var LANE_W     = W / LANE_COUNT;                       /* ~127px each */
var LANE_X     = [LANE_W*0.5, LANE_W*1.5, LANE_W*2.5]; /* lane centres */
var PLAYER_Y   = H - 80;                                /* near bottom */

/* ── Timing ── */
var PRACTICE_TIME = 6000;   /* 6s practice — enough to learn the controls */
var REAL_TIME     = 40000;  /* 40s real game */
var phase         = 'title';      /* 'title' | 'practice' | 'countdown' | 'real' | 'over' */
var phaseStart    = Date.now();
var countdownAt   = 0;

var gameOver  = false;
var wonGame   = false;
var wonAt     = 0;   // timestamp of victory — used for the brief "ride to the finish" beat
var winSparks = [];  // gold sparks streaming off the cow during the victory gallop
var nearMissAt = 0, nearMissX = 0; // near-miss spark streak (a whisker from a hit)
var gameEnded = false;

var lives       = 3;
var dodged      = 0;       /* obstacles successfully passed during real game */
var hitFlashAt  = 0;       /* timestamp of last hit (for invincibility flash) */
var INVULN_TIME = 1200;    /* 1.2s invulnerability after a hit */

var playerLane = 1;
var playerX    = LANE_X[1];
var targetX    = LANE_X[1];
var lastKeyAt  = 0;

var obstacles  = [];
var spawnCD    = 60;
var baseSpeed  = 2.8;

/* ── Scrolling road offset (for texture animation) ── */
var roadScroll = 0;

/* ── Lane highlight / click feedback ── */
var hoverLane  = -1;        /* which lane the mouse is over (-1 = none) */
var clickFlash = -1;        /* lane that was just clicked */
var clickFlashAt = 0;       /* timestamp of click flash */

/* ── Obstacle types ── */
var TYPES = [
{ name:'REVELLER',  w:30, h:44, weight:32, spd:1.00, wide:false },
{ name:'WAITER',    w:24, h:48, weight:18, spd:1.40, wide:false },
{ name:'PIG',       w:36, h:40, weight:18, spd:0.85, wide:false },
{ name:'BARREL',    w:30, h:30, weight:14, spd:1.70, wide:false },
{ name:'BLACK CAB', w:LANE_W*1.9, h:72, weight:22, spd:1.10, wide:true },
{ name:'UBER',      w:LANE_W*1.7, h:66, weight:10, spd:1.35, wide:true }
];

function pickType(){
var tot=0; for(var i=0;i<TYPES.length;i++) tot+=TYPES[i].weight;
var r=Math.random()*tot;
for(var j=0;j<TYPES.length;j++){ r-=TYPES[j].weight; if(r<=0) return TYPES[j]; }
return TYPES[0];
}

function spawnObstacle(){
var t=pickType();
var spd=getSpeed();

/* ── Fairness: project EVERY existing obstacle to the player's row,
   accounting for drift, and use those projected lanes for blocking.
   This guarantees there's always a path through the field. ── */
var blocked=[false,false,false];
var wideInZone=false;
/* Adjacent-row protection: also block lanes immediately neighbouring
   any obstacle still near the top of the field. Two obstacles arriving
   in adjacent rows at the same time leaves the player no time to
   swerve between them — so the second can't be spawned next to the
   first while the first is still high on screen. */
var nearTopBlocked=[false,false,false];
for(var bi=0;bi<obstacles.length;bi++){
var ob=obstacles[bi];
if(ob.y >= PLAYER_Y - 20) continue; /* already past — won't conflict with new spawn */
var arrivalFrames = (PLAYER_Y - ob.y) / Math.max(0.5, spd * ob.type.spd);
var projX = ob.x + (ob.drift || 0) * arrivalFrames;
var projLane = Math.max(0, Math.min(LANE_COUNT-1, Math.floor(projX / LANE_W)));
if(ob.type.wide){
wideInZone=true;
blocked[projLane]=true;
/* wide vehicles span 2 adjacent lanes */
var second = (ob.lane === projLane) ? projLane + 1 : ob.lane;
if(second>=0 && second<LANE_COUNT) blocked[second]=true;
} else {
blocked[projLane]=true;
}
/* If this obstacle is still in the top third of the field (so the
   new spawn would arrive in an adjacent row to it), forbid lanes
   directly next to it for the new spawn. */
if(ob.y < H * 0.34){
nearTopBlocked[projLane]=true;
if(projLane-1 >= 0) nearTopBlocked[projLane-1]=true;
if(projLane+1 < LANE_COUNT) nearTopBlocked[projLane+1]=true;
}
}
/* Merge near-top adjacency blocks into the main blocked array, but
   only if doing so still leaves at least one lane open. Otherwise
   drop the adjacency constraint for this spawn rather than skip
   spawning entirely (we'd rather have a spawn-fairness slip than
   a long empty stretch). */
var mergedBlocked=[false,false,false];
var mergedFree=0;
for(var mi=0;mi<LANE_COUNT;mi++){
mergedBlocked[mi] = blocked[mi] || nearTopBlocked[mi];
if(!mergedBlocked[mi]) mergedFree++;
}
if(mergedFree >= 1){ blocked = mergedBlocked; }
var freeCount=0;
for(var fc=0;fc<LANE_COUNT;fc++) if(!blocked[fc]) freeCount++;

/* Skip spawn if it would leave no free lane */
if(!t.wide && freeCount<=1){
return; /* don't block the last free lane */
}
if(t.wide){
/* wide vehicles need 2 adjacent free lanes AND no other wide already in zone */
var canPlaceWide=false;
for(var wp=0;wp<LANE_COUNT-1;wp++){
if(!blocked[wp] && !blocked[wp+1]){ canPlaceWide=true; break; }
}
if(!canPlaceWide || wideInZone) return;
}

var lane;
if(t.wide){
/* pick from adjacent free pairs */
var widePairs=[];
for(var wpa=0;wpa<LANE_COUNT-1;wpa++){
if(!blocked[wpa] && !blocked[wpa+1]) widePairs.push(wpa);
}
lane = widePairs[Math.floor(Math.random()*widePairs.length)];
} else {
/* always pick from free lanes */
var freeLanes=[];
for(var fl=0;fl<LANE_COUNT;fl++) if(!blocked[fl]) freeLanes.push(fl);
lane = freeLanes[Math.floor(Math.random()*freeLanes.length)];
/* Honesty bias: a quarter of narrow spawns seek the rider's lane when it's
   free, so sitting still is never a winning strategy. The fairness engine
   above still guarantees an escape route (a blocked-out player lane simply
   isn't in freeLanes, and the last free lane is never taken). */
if(Math.random()<0.25){ for(var pf=0;pf<freeLanes.length;pf++){ if(freeLanes[pf]===playerLane){ lane=playerLane; break; } } }
}
var x = t.wide ? (LANE_X[lane]+LANE_X[lane+1])/2 : LANE_X[lane];

/* Lateral drift — small and only in late tiers, capped so an obstacle
   shifts at most ~10px between spawn and player row (much less than a
   lane width). Prevents converging-lane impossible configurations. */
var drift=0;
var tier=getTier();
if(tier>=5 && !t.wide){
drift=(Math.random()-0.5) * 0.15;
}
obstacles.push({ type:t, x:x, y:-60, lane:lane, wobble:Math.random()*6.28, drift:drift });
/* Wide vehicles announce themselves — a horn as the cab/Uber enters. */
if(t.wide && window.dssAudio && window.dssAudio.carHorn) window.dssAudio.carHorn();
}

var lastSpeedTier = -1;

function getSpeed(){
var elapsed;
if(phase==='practice') elapsed=Date.now()-phaseStart;
else if(phase==='real') elapsed=Date.now()-phaseStart;
else elapsed=0;
if(phase==='practice') return 1.2;  /* gentle practice speed */
/* 8 tiers across 40s (5s each). Opening tiers raised (was 1.4/1.9/2.5 —
   after the 6s practice that made ~21s of low-threat runway); the ride now
   opens at canter pace and the climax has teeth sooner. Peak unchanged. */
var tier = Math.min(7, Math.floor(elapsed / 5000));
var speeds = [2.0, 2.6, 3.3, 4.1, 5.1, 6.3, 7.8, 9.4];
var tElapsed = elapsed - tier * 5000;
var cur = speeds[tier];
var nxt = tier < 7 ? speeds[tier + 1] : cur + 2.0;
var sp = cur + (nxt - cur) * (tElapsed / 5000) * 0.4;
return sp * (window.dssEase ? window.dssEase.by('cow', 1, 0.7) : 1); /* 2026-10-28 (dssEase): each throw makes the next ride slower */
}

function getTier(){
if(phase!=='real') return 0;
var elapsed=Date.now()-phaseStart;
return Math.min(7, Math.floor(elapsed/5000));
}

/* ── Start real game ── */
function startReal(){
phase='real';
phaseStart=Date.now();
obstacles=[];
spawnCD=50;
playerLane=1; targetX=LANE_X[1]; playerX=LANE_X[1];
}

/* ── Update ── */
function update(){
if(gameOver && !wonGame) return;
if(gameOver && wonGame){
// Won — keep the road scrolling and the cow galloping for a brief beat
// so the ride doesn't freeze the instant the win condition fires.
// After WIN_RIDE_TIME the road freezes and the end overlay takes over.
var WIN_RIDE_TIME = 1500;
if(Date.now() - wonAt > WIN_RIDE_TIME) return;
var spd = getSpeed();
roadScroll += spd * 1.5;
playerX += (targetX - playerX) * 0.24;
for(var i=obstacles.length-1;i>=0;i--){
obstacles[i].y += spd * obstacles[i].type.spd;
if(obstacles[i].y > H+80) obstacles.splice(i,1);
}
return;
}
if(phase==='title') return;
var spd=getSpeed();
roadScroll+=spd*1.5;

/* smooth player movement */
playerX += (targetX - playerX) * 0.24;

/* practice → countdown → real transition */
if(phase==='practice' && Date.now()-phaseStart >= PRACTICE_TIME){
phase='countdown'; countdownAt=Date.now(); obstacles=[];
}
if(phase==='countdown' && Date.now()-countdownAt >= 2200){
startReal();
}
if(phase==='countdown') return; /* freeze during countdown */

/* spawn */
spawnCD--;
if(spawnCD<=0){
spawnObstacle();
var el2=Date.now()-phaseStart;
var iv;
if(phase==='practice') iv=75;
else iv=Math.max(20, 80 - el2/800);  /* starts spacious, ramps over 40s, stays fair */
spawnCD=iv*(0.7+Math.random()*0.5);
}

/* move obstacles downward + lateral drift */
for(var i=obstacles.length-1;i>=0;i--){
obstacles[i].y += spd * obstacles[i].type.spd;
obstacles[i].wobble += 0.06;
/* lateral swerve in later tiers */
if(obstacles[i].drift){
obstacles[i].x += obstacles[i].drift;
/* bounce off pavement edges */
if(obstacles[i].x < 30) obstacles[i].drift = Math.abs(obstacles[i].drift);
if(obstacles[i].x > W-30) obstacles[i].drift = -Math.abs(obstacles[i].drift);
}
if(obstacles[i].y > H+80){
if(phase==='real') dodged++;
obstacles.splice(i,1);
}
}

/* collision (only in real game) */
if(phase==='real'){
var now=Date.now();
var invulnerable=(now-hitFlashAt < INVULN_TIME);
var px=playerX, py=PLAYER_Y, pw=40, ph=42;
if(!invulnerable){
for(var j=0;j<obstacles.length;j++){
var o=obstacles[j];
var HB=window.dssEase ? window.dssEase.by('cow', 0.60, 0.48) : 0.60; var ow=o.type.w*HB, oh=o.type.h*HB; /* 2026-10-28 (dssEase): and its knocks a little narrower */
if(Math.abs(px-o.x)<(pw+ow)/2 && Math.abs(py-o.y)<(ph+oh)/2){
lives--;
hitFlashAt=now;
if(window.dssAudio)window.dssAudio.muffledThud();
/* remove the obstacle we hit */
obstacles.splice(j,1);
if(lives<=0){
gameOver=true; wonGame=false;
if(window.dssEase) window.dssEase.lost('cow'); /* 2026-10-28 (Sam: "Easier each retry"): RIDE AGAIN is gentler each time */
/* The throw: heavy landing, then the gallop dies with you. */
if(window.dssAudio){window.dssAudio.punchImpact();setTimeout(function(){if(window.dssAudio)window.dssAudio.thunderClap();},250);}
stopCowMusic();
/* 2026-10-24 (Sam, Q9): one way out per screen. The THROWN card with its buttons is up now, so the 150 s stall bail under the canvas is taken away if it comes. */
(function(){ var g=window._passageGen; var t=setInterval(function(){ if(window._passageGen!==g){ clearInterval(t); return; } var b=document.querySelector('.canvas-bail'); if(b) b.remove(); },300); })();
return;
}
break; /* only one hit per frame */
}
}
}
/* Near-miss thrill: an obstacle crossing the player's row inside a whisker
   (no contact) throws a spark streak, so every close dodge is felt.
   Checked once per obstacle as it passes the row. */
for(var nj=0;nj<obstacles.length;nj++){
var no=obstacles[nj];
if(no.nearChecked || no.y <= PLAYER_Y) continue;
no.nearChecked=true;
var ndx=Math.abs(px-no.x);
var nmargin=(pw+no.type.w*0.60)/2;
if(ndx>=nmargin && ndx<nmargin+26){
nearMissAt=now; nearMissX=(no.x<px)?px-24:px+24;
if(window.dssAudio&&window.dssAudio.dodgeWhoosh)window.dssAudio.dodgeWhoosh();
}
}
/* win check */
if(now-phaseStart >= REAL_TIME){
gameOver=true; wonGame=true; wonAt=now;
/* Win chord over the gallop; let the gallop-out beat land, then quiet
   the loop under the end overlay. */
if(window.dssAudio)window.dssAudio.brightChord();
setTimeout(stopCowMusic,2500);
/* Seed the victory sparks — gold burst off the cow for the gallop-out. */
for(var ws=0; ws<36; ws++){
winSparks.push({ x:playerX+(Math.random()-0.5)*44, y:PLAYER_Y+(Math.random()-0.5)*34,
vx:(Math.random()-0.5)*2.6, vy:-1.5-Math.random()*3.2, life:1 });
}
}
}
}

/* ── Reset for a second ride (skips practice; fresh state) ── */
function restart(){
winSparks.length = 0; /* no victory sparks carried into a fresh ride */
lives = 3;
dodged = 0;
hitFlashAt = 0;
gameOver = false;
wonGame = false;
wonAt = 0;
obstacles = [];
_cowMusicRate = 1.0;
if(_cowMusicEl) _cowMusicEl.playbackRate = 1.0;
phase = 'countdown';
countdownAt = Date.now();
}

/* ═══════════════════════════════════════════
DRAWING
═══════════════════════════════════════════ */

/* ── Fixed street furniture positions (seeded so they don't change frame to frame) ── */
var LAMPS = [
{side:'L', baseY:60},
{side:'R', baseY:200},
{side:'L', baseY:340},
{side:'R', baseY:480},
{side:'L', baseY:620}
];
var SHOPFRONTS = [
{side:'L', baseY:0,   colour:'#3a1a2a', name:'THE FRENCH',    neon:'#e84060'},
{side:'R', baseY:130, colour:'#1a2a3a', name:'BAR ITALIA',    neon:'#40c0e8'},
{side:'L', baseY:260, colour:'#2a2a18', name:'RONNIE\u2019S', neon:'#e8c040'},
{side:'R', baseY:390, colour:'#2a1a28', name:'REVUE BAR',     neon:'#e840a0'},
{side:'L', baseY:520, colour:'#1a2828', name:'TRATTORIA',     neon:'#40e880'}
];
var DRAINS = [70, 190, 310, 430, 550];

function drawStreet(){
/* base dark road */
ctx.fillStyle='#08080e';
ctx.fillRect(0,0,W,H);

/* A moving slice of Soho overhead: the ride should feel like a night
   journey through a place, rather than an abstract lane grid. */
var skyGlow=ctx.createLinearGradient(0,0,0,170);
skyGlow.addColorStop(0,'rgba(31,41,67,.9)'); skyGlow.addColorStop(1,'rgba(8,9,18,0)');
ctx.fillStyle=skyGlow; ctx.fillRect(22,0,W-44,185);
ctx.fillStyle='rgba(235,215,154,.8)'; ctx.beginPath(); ctx.arc(W-58,58,13,0,Math.PI*2); ctx.fill();
ctx.fillStyle='rgba(20,24,42,.85)'; ctx.beginPath(); ctx.arc(W-53,53,13,0,Math.PI*2); ctx.fill();
ctx.fillStyle='rgba(16,18,28,.9)'; ctx.beginPath(); ctx.moveTo(22,150); ctx.lineTo(22,112); ctx.lineTo(70,94); ctx.lineTo(108,126); ctx.lineTo(156,82); ctx.lineTo(212,124); ctx.lineTo(270,91); ctx.lineTo(358,125); ctx.lineTo(358,150); ctx.closePath(); ctx.fill();
ctx.fillStyle='rgba(186,142,76,.35)'; [64,152,276,326].forEach(function(wx){ctx.fillRect(wx,112+(wx%3)*8,8,12);});

/* wider pavements with subtle texture */
ctx.fillStyle='#12121a';
ctx.fillRect(0,0,22,H);
ctx.fillRect(W-22,0,22,H);
/* paving slab lines (scrolling) */
ctx.strokeStyle='rgba(30,28,20,0.5)'; ctx.lineWidth=1;
var slabOff=roadScroll*0.8%36;
for(var sy=-36+slabOff;sy<H+36;sy+=36){
ctx.beginPath(); ctx.moveTo(0,sy); ctx.lineTo(22,sy); ctx.stroke();
ctx.beginPath(); ctx.moveTo(W-22,sy); ctx.lineTo(W,sy); ctx.stroke();
}

/* kerb lines – double line for depth */
ctx.strokeStyle='rgba(70,60,30,0.6)'; ctx.lineWidth=2;
ctx.beginPath(); ctx.moveTo(22,0); ctx.lineTo(22,H); ctx.stroke();
ctx.beginPath(); ctx.moveTo(W-22,0); ctx.lineTo(W-22,H); ctx.stroke();
ctx.strokeStyle='rgba(40,35,15,0.4)'; ctx.lineWidth=1;
ctx.beginPath(); ctx.moveTo(23,0); ctx.lineTo(23,H); ctx.stroke();
ctx.beginPath(); ctx.moveTo(W-23,0); ctx.lineTo(W-23,H); ctx.stroke();

/* ── Shop fronts on pavements (scrolling colour blocks with names) ── */
var shopScroll=roadScroll*0.8;
SHOPFRONTS.forEach(function(sh){
var sy2=(sh.baseY + shopScroll) % (H+200) - 100;
var sx = sh.side==='L' ? 0 : W-22;
var sw = 22;
/* coloured awning/frontage */
ctx.fillStyle=sh.colour;
ctx.fillRect(sx, sy2, sw, 80);
/* door frame */
ctx.fillStyle='rgba(0,0,0,0.4)';
ctx.fillRect(sx+(sh.side==='L'?8:4), sy2+35, 10, 45);
/* neon sign glow */
var ngx = sh.side==='L' ? 11 : W-11;
ctx.save();
ctx.globalAlpha=0.3;
ctx.fillStyle=sh.neon;
ctx.beginPath(); ctx.ellipse(ngx,sy2+20,9,12,0,0,Math.PI*2); ctx.fill();
ctx.globalAlpha=0.15;
ctx.beginPath(); ctx.ellipse(ngx,sy2+20,16,20,0,0,Math.PI*2); ctx.fill();
ctx.globalAlpha=1.0;
ctx.restore();
});

/* cobblestone grid – scrolling */
ctx.strokeStyle='rgba(22,22,38,0.7)'; ctx.lineWidth=1;
var off=roadScroll%28;
for(var y=-28+off; y<H+28; y+=28){
ctx.beginPath(); ctx.moveTo(22,y); ctx.lineTo(W-22,y); ctx.stroke();
}
/* offset vertical cobble lines for staggered brickwork effect */
var offH=roadScroll*0.3%28;
for(var row=-1; row<(H/28)+2; row++){
var ry=row*28+off;
var stagger=(row%2)*14;
for(var x=22+stagger; x<W-22; x+=28){
ctx.beginPath(); ctx.moveTo(x,ry); ctx.lineTo(x,ry+28); ctx.stroke();
}
}

/* ── Drain covers (scrolling circular grates) ── */
var drainScroll=roadScroll*1.1;
DRAINS.forEach(function(dy){
var dy2=(dy+drainScroll)%(H+160)-80;
/* manhole in road */
ctx.fillStyle='rgba(8,8,16,0.6)';
ctx.beginPath(); ctx.ellipse(W/2,dy2,14,10,0,0,Math.PI*2); ctx.fill();
/* grate lines */
ctx.strokeStyle='rgba(40,40,50,0.7)'; ctx.lineWidth=1.5;
for(var gi=-2;gi<=2;gi++){
ctx.beginPath(); ctx.moveTo(W/2-10,dy2+gi*4); ctx.lineTo(W/2+10,dy2+gi*4); ctx.stroke();
}
ctx.strokeStyle='rgba(50,45,30,0.5)'; ctx.lineWidth=1;
ctx.beginPath(); ctx.ellipse(W/2,dy2,14,10,0,0,Math.PI*2); ctx.stroke();
});

/* lane divider dashes */
ctx.strokeStyle='rgba(70,55,15,0.35)'; ctx.lineWidth=1;
ctx.setLineDash([10,14]);
var dashOff=roadScroll%24;
for(var l=1;l<LANE_COUNT;l++){
ctx.beginPath();
ctx.moveTo(LANE_W*l, -24+dashOff);
ctx.lineTo(LANE_W*l, H);
ctx.stroke();
}
ctx.setLineDash([]);

/* gutter puddles – reflect neon colours */
var pudOff=roadScroll*0.8%400;
var pudCols=['rgba(60,20,40,0.25)','rgba(20,40,60,0.25)','rgba(50,40,10,0.25)'];
[80,230,370].forEach(function(py,pi){
var py2=(py+pudOff)%(H+120)-60;
ctx.fillStyle=pudCols[pi%3];
ctx.beginPath(); ctx.ellipse(32,py2,14,6,0,0,Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.ellipse(W-32,py2+55,12,5,0.3,0,Math.PI*2); ctx.fill();
});

/* ── Lamp posts (scrolling, with warm glow cones) ── */
var lampScroll=roadScroll*0.8;
LAMPS.forEach(function(lp){
var ly2=(lp.baseY + lampScroll) % (H+200) - 100;
var lx = lp.side==='L' ? 10 : W-10;
/* post – thin dark iron */
ctx.strokeStyle='#2a2820'; ctx.lineWidth=3; ctx.lineCap='round';
ctx.beginPath(); ctx.moveTo(lx,ly2+40); ctx.lineTo(lx,ly2-10); ctx.stroke();
/* ornamental bracket */
var armDir = lp.side==='L' ? 1 : -1;
ctx.lineWidth=2;
ctx.beginPath();
ctx.moveTo(lx,ly2-8);
ctx.quadraticCurveTo(lx+armDir*8,ly2-16,lx+armDir*12,ly2-12);
ctx.stroke();
/* lantern box */
ctx.fillStyle='#3a3420';
ctx.fillRect(lx+armDir*9-3, ly2-16, 6, 8);
/* warm glass */
ctx.fillStyle='rgba(220,180,60,0.7)';
ctx.fillRect(lx+armDir*9-2, ly2-15, 4, 6);
/* glow cone onto road */
var glow=ctx.createRadialGradient(lx+armDir*10,ly2-8,3,lx+armDir*10,ly2+30,60);
glow.addColorStop(0,'rgba(200,160,50,0.12)');
glow.addColorStop(1,'rgba(200,160,50,0)');
ctx.fillStyle=glow;
ctx.fillRect(lx-50,ly2-40,100,120);
});

/* ── Lane grid: solid divider lines ── */
ctx.strokeStyle='rgba(80,65,20,0.4)'; ctx.lineWidth=2;
ctx.setLineDash([]);
for(var lg=1;lg<LANE_COUNT;lg++){
ctx.beginPath(); ctx.moveTo(LANE_W*lg,0); ctx.lineTo(LANE_W*lg,H); ctx.stroke();
}

/* ── Hover highlight: glow the lane the mouse is over ── */
if(hoverLane>=0 && !gameOver){
var hx=hoverLane*LANE_W;
ctx.fillStyle='rgba(200,160,40,0.06)';
ctx.fillRect(hx,0,LANE_W,H);
var hGrd=ctx.createLinearGradient(0,H-100,0,H);
hGrd.addColorStop(0,'rgba(200,160,40,0)');
hGrd.addColorStop(1,'rgba(200,160,40,0.10)');
ctx.fillStyle=hGrd;
ctx.fillRect(hx,H-100,LANE_W,100);
}

/* ── Click flash: bright pulse on the lane just clicked ── */
if(clickFlash>=0){
var flashAge=Date.now()-clickFlashAt;
if(flashAge<300){
var fAlpha=0.18*(1-flashAge/300);
ctx.fillStyle='rgba(230,190,60,'+fAlpha+')';
ctx.fillRect(clickFlash*LANE_W,0,LANE_W,H);
} else { clickFlash=-1; }
}

/* ── Lane arrows at bottom (click targets) ── */
if(!gameOver && phase!=='countdown'){
ctx.textAlign='center';
for(var la=0;la<LANE_COUNT;la++){
var isActive=(la===playerLane);
var isHover=(la===hoverLane);
var alpha=isActive?0.55:(isHover?0.40:0.18);
ctx.fillStyle='rgba(200,160,40,'+alpha+')';
var ax=LANE_X[la], ay=H-18;
ctx.beginPath();
ctx.moveTo(ax,ay-10);
ctx.lineTo(ax-14,ay+2);
ctx.lineTo(ax-6,ay+2);
ctx.lineTo(ax-6,ay+8);
ctx.lineTo(ax+6,ay+8);
ctx.lineTo(ax+6,ay+2);
ctx.lineTo(ax+14,ay+2);
ctx.closePath();
ctx.fill();
ctx.fillStyle='rgba(200,160,40,'+(isActive?0.6:0.25)+')';
ctx.font=(isActive?'bold ':'')+' 9px monospace';
ctx.fillText(la===0?'LEFT':(la===1?'MID':'RIGHT'), LANE_X[la], H-4);
}
}

/* vignette */
var grd=ctx.createRadialGradient(W/2,H/2,H*0.28,W/2,H/2,H*0.72);
grd.addColorStop(0,'rgba(0,0,0,0)');
grd.addColorStop(1,'rgba(0,0,0,0.55)');
ctx.fillStyle=grd; ctx.fillRect(0,0,W,H);
}

/* ── Draw the cow + rider (top-down perspective: facing up the screen) ── */
function drawPlayer(){
/* flash/blink during invulnerability */
var invuln=(Date.now()-hitFlashAt < INVULN_TIME) && phase==='real';
if(invuln && Math.floor(Date.now()/80)%2===0) return; /* blink off */

var galloping=phase==='real'||phase==='practice'||(wonGame&&Date.now()-wonAt<1200);
var tier=phase==='real'?Math.min(7,Math.floor((Date.now()-phaseStart)/5000)):0;
var stride=arcadeReduced?0:Date.now()/(96-tier*3),gait=galloping?Math.sin(stride):0;
// Dust is decorative and stays behind the cow, clear of incoming hazards.
if(galloping&&!arcadeReduced){
  for(var puff=0;puff<7;puff++){
    var age=(Date.now()/720+puff/7)%1,dx=playerX+Math.sin(puff*2.4+age*4)*(8+age*15),dy=PLAYER_Y+29+age*42,radius=3+age*9;
    var dustGlow=ctx.createRadialGradient(dx,dy,0,dx,dy,radius);dustGlow.addColorStop(0,'rgba(199,167,104,'+(.16*Math.sin(age*Math.PI))+')');dustGlow.addColorStop(1,'rgba(150,123,80,0)');ctx.fillStyle=dustGlow;ctx.fillRect(dx-radius,dy-radius,radius*2,radius*2);
  }
}
ctx.save();
ctx.translate(playerX, PLAYER_Y);
ctx.fillStyle='rgba(210,175,90,0.18)';
ctx.beginPath(); ctx.ellipse(-17+gait*3,31,7,3,0,0,Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.ellipse(17-gait*3,31,7,3,0,0,Math.PI*2); ctx.fill();

/* red flash overlay on hit */
if(invuln && Date.now()-hitFlashAt < 200){
ctx.globalAlpha=0.6;
}

/* shadow */
ctx.fillStyle='rgba(0,0,0,0.35)';
ctx.beginPath(); ctx.ellipse(2,18,26,10,0,0,Math.PI*2); ctx.fill();

// The shadow stays on the road while the beast bounds above it.
if(!arcadeReduced){var bound=galloping?Math.abs(Math.sin(stride))*(5+tier*.45):0;ctx.translate(0,-bound);ctx.rotate(gait*.045);ctx.scale(1+gait*.025,1-gait*.03);}
// Four absurdly busy legs: opposing knees and sharp little kicking hooves.
[-1,1].forEach(function(side){[false,true].forEach(function(front){
  var step=arcadeReduced?0:Math.sin(stride+(side>0?Math.PI:0)+(front?Math.PI:0));
  if(!galloping)step=0;
  ctx.save();ctx.translate(side*16,front?-14:18);ctx.rotate(side*(.18+step*.5));
  ctx.fillStyle='#a07818';ctx.fillRect(-3,0,6,front?13:16+step*3);ctx.fillStyle='#605020';ctx.fillRect(-4,(front?11:14+step*3),8,5);ctx.restore();
});});
/* cow body (oval, seen from above/behind) */
ctx.fillStyle='#c89830';
ctx.beginPath(); ctx.ellipse(0,0,22,28,0,0,Math.PI*2); ctx.fill();

/* hide patches */
ctx.fillStyle='#b08020';
ctx.beginPath(); ctx.ellipse(-8,-8,9,11,0.4,0,Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.ellipse(10,6,7,8,-0.3,0,Math.PI*2); ctx.fill();

/* cow head (top – facing forward/up) */
ctx.fillStyle='#d4a840';
ctx.beginPath(); ctx.ellipse(0,-26,14,11,0,0,Math.PI*2); ctx.fill();

/* ears */
ctx.fillStyle='#b08828';
ctx.beginPath(); ctx.ellipse(-14,-24,5,4,0.5+gait*.18,0,Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.ellipse(14,-24,5,4,-0.5-gait*.18,0,Math.PI*2); ctx.fill();

/* horns */
ctx.strokeStyle='#e8d8a0'; ctx.lineWidth=2.5; ctx.lineCap='round';
ctx.beginPath(); ctx.moveTo(-12,-30); ctx.quadraticCurveTo(-18,-38,-14,-42); ctx.stroke();
ctx.beginPath(); ctx.moveTo(12,-30); ctx.quadraticCurveTo(18,-38,14,-42); ctx.stroke();

/* cow tail (below, trailing behind) */
ctx.strokeStyle='#a88020'; ctx.lineWidth=2;
ctx.beginPath(); ctx.moveTo(0,28); ctx.quadraticCurveTo(4+gait*7,38,-3+gait*8,44); ctx.stroke();
/* tuft */
ctx.fillStyle='#c89830';
ctx.beginPath(); ctx.arc(-3+gait*8,44,3,0,Math.PI*2); ctx.fill();


/* ── Rider (sitting on cow, seen from above) ── */
ctx.save();if(!arcadeReduced&&galloping){ctx.translate(gait*1.5,-Math.abs(gait)*2.5);ctx.rotate(-gait*.035);}
/* legs straddling */
ctx.fillStyle='#5a4a20';
ctx.fillRect(-24,-6,8,16);
ctx.fillRect(16,-6,8,16);

/* torso */
ctx.fillStyle='#e0b840';
ctx.beginPath(); ctx.ellipse(0,-4,12,14,0,0,Math.PI*2); ctx.fill();

/* jacket details */
ctx.strokeStyle='#c8a030'; ctx.lineWidth=1;
ctx.beginPath(); ctx.moveTo(0,-18); ctx.lineTo(0,8); ctx.stroke();

/* arms forward (holding cow) */
ctx.fillStyle='#d4a838';
ctx.fillRect(-10,-20,6,10);
ctx.fillRect(4,-20,6,10);

/* head */
ctx.fillStyle='#e8c860';
ctx.beginPath(); ctx.arc(0,-18,9,0,Math.PI*2); ctx.fill();

/* hat */
ctx.fillStyle='#8a6820';
ctx.beginPath(); ctx.ellipse(0,-22,11,5,0,0,Math.PI*2); ctx.fill();
ctx.fillStyle='#7a5818';
ctx.beginPath(); ctx.ellipse(0,-24,7,4,0,0,Math.PI*2); ctx.fill();

ctx.restore();
ctx.restore();
}

/* ── Draw obstacles ── */
function drawObstacle(o){
var t=o.type;
ctx.save();
ctx.translate(o.x, o.y);

/* shadow */
ctx.fillStyle='rgba(0,0,0,0.3)';
ctx.beginPath(); ctx.ellipse(2,t.h*0.4,t.w*0.4,6,0,0,Math.PI*2); ctx.fill();

switch(t.name){
case 'REVELLER':
/* drunk person stumbling – wobble */
var wx=Math.sin(o.wobble)*4;
ctx.translate(wx,0);
/* body */
ctx.fillStyle='#6a6a88';
ctx.fillRect(-11,-20,22,34);
/* head */
ctx.fillStyle='#8888a0';
ctx.beginPath(); ctx.arc(0,-24,10,0,Math.PI*2); ctx.fill();
/* raised arm with bottle */
ctx.fillStyle='#6a6a88';
ctx.fillRect(10,-28,6,14);
ctx.fillStyle='#446644';
ctx.fillRect(12,-36,4,10);
/* legs */
ctx.fillStyle='#555570';
ctx.fillRect(-9,14,8,12);
ctx.fillRect(1,14,8,12);
/* shoes */
ctx.fillStyle='#333344';
ctx.fillRect(-9,24,8,4);
ctx.fillRect(1,24,8,4);
break;

case 'WAITER':
/* thin waiter carrying tray */
ctx.fillStyle='#222230';
ctx.fillRect(-9,-22,18,38);
/* white shirt front */
ctx.fillStyle='#aaaaaa';
ctx.fillRect(-6,-18,12,20);
/* bow tie */
ctx.fillStyle='#882222';
ctx.fillRect(-4,-18,8,4);
/* head */
