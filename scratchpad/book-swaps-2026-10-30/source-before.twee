html += '<div class="dss-card-key" style="margin-top:8px;"><div class="dss-card-keyart" aria-hidden="true">' + ((window.DSS_KEY_ART || {})[kid] || '') + '</div>' +
(kb ? '<div class="' + (kb.classList.contains('claude-draft') ? '' : 'dss-key-loud') + '" style="' + (kb.classList.contains('claude-draft') ? PINK : KEY_RED) + '">' + kb.textContent.trim().replace(/</g, '&lt;') + '</div>' : '') + '</div>';
}
