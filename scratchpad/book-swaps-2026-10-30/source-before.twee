  }
  (window.dssShowMinigameRules || function (o) { o.onPlay(); })({ key: 'mats', play: 'First flick', title: 'THE BEER MAT GAME', lines: [
    '<div>A stack of beer mats on the edge of the bar. Flick them up with the back of your hand, then catch them as they turn over.</div>',
    '<div>Use the space bar or click the button. Once to flick, a second time to catch.</div>',
    '<div>You add a mat each time. Lea’s record is four, try to beat it. Bow out whenever you like.</div>'
