if (window.dssPotion) [['potion', 0x3ee0a0, 0.58, 0.24], ['vial', 0x5ff0bc, 0.72, 0.3]].forEach(function(d) { var p = window.dssPotion(d[0], d[1], k.roomEnv); if (p) { p.position.set(d[2], 0.785, d[3]); p.scale.setScalar(1.3); deskG.add(p); } }); /* 2026-10-29 (Sam: "a couple of mint green ones to Lackland's"): on his desk, back right */
