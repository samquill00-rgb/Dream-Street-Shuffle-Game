<div class="trishas-frame">
<span class="trishas-strip">(display: "Trisha Strip SVG")</span>

<div class="shana-knock"><!-- 2026-10-16 (Sam: restore): from the 15 April backup's Shana Reads, words unchanged, before the cards. 2026-10-19 (Sam: "I thought I deleted her knocking the book to the floor"): the knock is cut again; was: She knocks //(print: $bookTitle)// to the floor and then very carefully places it back on the table, being certain to alter the page that it fell on. -->She reads.</div><div class="shana-knock">‘What’s wrong with it?’ she asks.</div>
She lays three cards face-down on the table.

<div class="tarot-spread" id="tarot-spread">
<div class="tarot-slot"><span class="tarot-position">Past</span><div class="tarot-card" id="tc-1" onclick="dssFlipCard(1)"><div class="card-inner"><div class="card-face card-back-face">(display: "Tarot Card Back")</div><div class="card-face card-front-face"><span class="card-numeral">(print: _c1n)</span>(if: (dm-names: _art2) contains _c1)[(print: _art2's (_c1))](else:)[(print: _art's (_c1))]</div></div></div><span class="tarot-card-label">(print: _c1)</span><div class="tarot-meaning" id="tm-1"></div></div>
<div class="tarot-slot"><span class="tarot-position">Present</span><div class="tarot-card" id="tc-2" onclick="dssFlipCard(2)"><div class="card-inner"><div class="card-face card-back-face">(display: "Tarot Card Back")</div><div class="card-face card-front-face"><span class="card-numeral">(print: _c2n)</span>(if: (dm-names: _art2) contains _c2)[(print: _art2's (_c2))](else:)[(print: _art's (_c2))]</div></div></div><span class="tarot-card-label">(print: _c2)</span><div class="tarot-meaning" id="tm-2"></div></div>
<div class="tarot-slot"><span class="tarot-position">Future</span><div class="tarot-card" id="tc-3" onclick="dssFlipCard(3)"><div class="card-inner"><div class="card-face card-back-face">(display: "Tarot Card Back")</div><div class="card-face card-front-face"><span class="card-numeral">(print: _c3n)</span>(if: (dm-names: _art2) contains _c3)[(print: _art2's (_c3))](else:)[(print: _art's (_c3))]</div></div></div><span class="tarot-card-label">(print: _c3)</span><div class="tarot-meaning" id="tm-3"></div></div>
</div>

<div class="tarot-reading-hint" id="tarot-reading-hint">Turn the cards in order, left to right.</div>

<span id="tarot-continue" style="display:none">
[[‘You do not find the Hanged Man.’|Shana's Verdict]]
(if: $hangedManLooked is not true)[
<div class="tarot-offer">‘I could look again,’ she says. ‘It’ll cost you.’</div>
<span class="inventory-note">SECOND READING · MORALE −4</span>
[[Let her look again|Shana Looks Again]]
]
</span>

<script>
(function(){
var flipped=[false,false,false];
var POS=["Where you've come from","Where you are","What awaits"];
/* One-line card meanings (Dr Quill's text). The Emperor and the Hanged Man
   are not in the deck, so they have no entry. */
var MEANING={
"The Fool":"Upstarts, spontaneities; the absurd leap.",
"The Magician":"The working-out of will within the world.",
"The High Priestess":"Arcane knowledge; hidden things, the unspoken and unspeakable.",
"The Empress":"Fecundity; creation ex materia.",
"The Hierophant":"The ancient depths of things; the folk-wise.",
"The Lovers":"The intensity of choice in resolution.",
"The Chariot":"The force of the will and its determined way.",
"Strength":"Patience over force.",
"The Hermit":"Rejection; the vox clamantis in deserto among its private truths.",
"Wheel of Fortune":"The cyclical churn among things.",
"Justice":"Cause and effect, working.",
"Death":"Endings and their trailing beginnings; the transmutation of being; paid passage.",
"Temperance":"The healthy bearing of the will among the desires.",
"The Devil":"Addiction, compulsion, repetition.",
"The Tower":"Upendings of the false and the anarchic tides.",
"The Star":"The bearing of the soul into the future.",
"The Moon":"The spectre; the virginal idol and its workings beneath the flesh.",
"The Sun":"The deep, fresh warmth of reality.",
"Judgement":"Reckoning; deliverance; conclusion.",
"The World":"The closing of cycles; the settling of all that is deposited."
};
function nameOf(n){var c=document.getElementById('tc-'+n);var s=c&&c.closest('.tarot-slot');var l=s&&s.querySelector('.tarot-card-label');return l?l.textContent.trim():'';}
function showMeaning(n){
var m=document.getElementById('tm-'+n);if(!m)return;
var nm=nameOf(n);
m.innerHTML='';
var p=document.createElement('div');p.className='tarot-meaning-pos';p.textContent=POS[n-1]||'';
var t=document.createElement('div');t.className='tarot-meaning-text';t.textContent=MEANING[nm]||'';
m.appendChild(p);m.appendChild(t);m.classList.add('shown');
}
function lockState(){
for(var i=1;i<=3;i++){var c=document.getElementById('tc-'+i);if(!c)continue;var locked=(i>1&&!flipped[i-2]);c.classList.toggle('locked',locked&&!flipped[i-1]);}
}
window.dssFlipCard=function(n){
var card=document.getElementById('tc-'+n);
if(!card||card.classList.contains('flipped'))return;
if(n>1&&!flipped[n-2])return;  /* left to right: the past before the present, the present before what awaits */
card.classList.add('flipped');
if(window.dssAudio&&window.dssAudio.cardTurn){try{window.dssAudio.cardTurn();}catch(e){}}
flipped[n-1]=true;
lockState();
setTimeout(function(){showMeaning(n);},680);
if(flipped[0]&&flipped[1]&&flipped[2]){
var h=document.getElementById('tarot-reading-hint');if(h)h.style.display='none';
setTimeout(function(){var c=document.getElementById('tarot-continue');if(c)c.style.display='';},1300);
}
};
lockState();
})();
</script>

:: Shana Looks Again [venue-trishas char-shana] {"position":"1050,1700","size":"100,100"}
{
<!-- THE SECOND LOOK (2026-09-11). Madame Sosostris does not find the Hanged Man;
     here Shana can look once more. One time in four he is there, bringing
     a little confidence. The second reading costs morale, never exploration.
     Once per game. -->
(set: $hangedManLooked to true)(set: $confidence to ($statLoss: $confidence, 4))\
\
