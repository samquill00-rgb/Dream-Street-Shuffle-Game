var shade = mesh(new THREE.ConeGeometry(0.28, 0.22, 24, 1, true), new THREE.MeshStandardMaterial({ map: shadeTex, roughness: 0.8, side: THREE.DoubleSide, emissive: 0x4a3a10, emissiveIntensity: 0.6 }), 0.2, H - 0.36, -0.2);
