  for (var b = 0; b < 18; b++) { var bub = document.createElement('i'); bub.className = 'wk-bubble'; bub.style.left = (4 + Math.random() * 92).toFixed(1) + '%'; bub.style.animationDelay = (0.2 + Math.random() * 2.2).toFixed(2) + 's'; /* was 0.4 + 3.6 (2026-10-19) */ bub.style.width = bub.style.height = (2 + Math.random() * 3).toFixed(1) + 'px'; glass.appendChild(bub); }
