    scene();
    var wood=ctx.createLinearGradient(0,360,0,H);wood.addColorStop(0,'#80603a');wood.addColorStop(.05,'#3e2c1e');wood.addColorStop(1,'#201711');ctx.fillStyle=wood;ctx.fillRect(0,363,W,67);
    ctx.strokeStyle='#c49c6060';ctx.beginPath();ctx.moveTo(0,364);ctx.lineTo(W,364);ctx.stroke();
    ctx.strokeStyle='#b89b7133';for(var j=0;j<6;j++){ctx.beginPath();ctx.moveTo(0,375+j*8);ctx.bezierCurveTo(130,369+j*8,450,387+j*8,600,374+j*8);ctx.stroke();}
