  cx.quadraticCurveTo(w * 0.64, h * 0.74, w * 0.66, h * 0.6);
  cx.stroke();
  cx.fillStyle = 'rgba(216, 168, 64, 0.85)';
  cx.beginPath(); cx.ellipse(w * 0.665, h * 0.575, 13, 17, 0.35, 0, Math.PI * 2); cx.fill();
  cx.lineCap = 'butt';
  cx.font = '18px Georgia';
  cx.fillStyle = '#d8a840';
  cx.fillText('FROM 1 A.M.', w / 2, 292);
});
