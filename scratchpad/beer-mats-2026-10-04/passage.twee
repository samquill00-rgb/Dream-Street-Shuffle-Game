:: Trisha's Beer Mats [venue-trishas] {"position":"550,1550","size":"100,100"}
<!-- BEER MATS. Astra's standalone prototype (prototypes/trishas-beer-mats/) set inside
     Trisha's, 2026-10-04. Optional; never changes alba or sobriety. Every word is
     Astra's placeholder dialogue, kept pink for Sam. Dev only: DSS_DEV exposes
     _beerMatsDev {flick, catchNow, miss, state}. -->
<div id="dss-beer-mats" class="claude-draft">
<h2>BEER MATS</h2>
<div class="mats-stage"><canvas width="600" height="400" tabindex="0" aria-label="A stack of beer mats resting on the edge of Trisha’s bar. Flick them up, then catch them as they turn over."></canvas><div class="mats-bubble mats-left"><strong>Lea</strong><span class="mats-lea">Six is mine. See if you can beat it.</span></div><div class="mats-bubble mats-right mats-quiet"><strong>Jack</strong><span class="mats-jack">I’ll count.</span></div></div>
<div class="mats-meters"><span><small>On the bar</small><b class="mats-stack">1 mat</b></span><span><small>Lea’s record</small><b>6 mats</b></span><span><small>Your best</small><b class="mats-best">—</b></span></div>
<div class="mats-status" role="status" aria-live="polite"><b class="mats-title">One mat to begin.</b><span class="mats-hint">Flick, watch the edge, then catch. Each flip turns at a different speed.</span></div>
<div class="mats-controls"><button type="button" class="mats-play">Flick</button><button type="button" class="mats-stop">Bow out</button></div>
<div class="mats-help">Space or the button: a quick flick, then a quick catch.</div>
<div class="mats-payment" aria-hidden="true">
<span data-outcome="win">(link: "mats-win")[(unless: $beerMatsPlayed is true)[(set: $beerMatsPlayed to true)(set: $confidence to ($statGain: $confidence, 8))<div class="inventory-note">MORALE +8</div>]<div>[[Back to the bar|Trisha's]]</div>]</span>
<span data-outcome="loss">(link: "mats-loss")[<div>[[Back to the bar|Trisha's]]</div>]</span>
</div>
</div>
<style>
#dss-beer-mats{max-width:660px;width:100%;margin:24px auto;text-align:center;box-sizing:border-box;font-family:Georgia,serif}
#dss-beer-mats h2{font-size:clamp(22px,5vw,34px);letter-spacing:.13em;margin:12px 0}
#dss-beer-mats h2,#dss-beer-mats b,#dss-beer-mats strong,#dss-beer-mats small,#dss-beer-mats span,#dss-beer-mats button{color:inherit}
#dss-beer-mats > br,#dss-beer-mats .mats-stage > br,#dss-beer-mats .mats-meters > br,#dss-beer-mats .mats-controls > br,#dss-beer-mats .mats-status > br{display:none}
#dss-beer-mats .mats-stage{position:relative;width:100%;aspect-ratio:3/2;border:1px solid #887052;border-radius:8px;overflow:hidden;background:#1a0a0e;box-sizing:border-box}
#dss-beer-mats canvas{display:block;width:100%;height:100%;touch-action:none}
#dss-beer-mats canvas:focus-visible{outline:2px solid #dfb978;outline-offset:3px}
#dss-beer-mats .mats-bubble{position:absolute;top:34%;max-width:30%;padding:9px 11px;border:1px solid #bca17a55;border-radius:3px;background:#160b0eee;font:italic clamp(11px,2.2vw,14px)/1.35 Georgia,serif;text-align:left;pointer-events:none;transition:opacity .25s}
#dss-beer-mats .mats-bubble strong{display:block;font-style:normal;font-size:9px;letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;opacity:.8}
#dss-beer-mats .mats-left{left:3%}#dss-beer-mats .mats-right{right:3%}#dss-beer-mats .mats-quiet{opacity:.72}
#dss-beer-mats .mats-meters{display:flex;gap:6px 16px;justify-content:space-between;padding:12px 2px 6px;font-variant-numeric:tabular-nums}
#dss-beer-mats .mats-meters span{flex:1;text-align:left;border-bottom:1px solid #ffffff16;padding-bottom:8px}
#dss-beer-mats .mats-meters small{display:block;font-size:10px;letter-spacing:2px;text-transform:uppercase;opacity:.75}
#dss-beer-mats .mats-meters b{display:block;font-weight:normal;font-size:clamp(20px,4vw,28px);margin-top:4px}
#dss-beer-mats .mats-status{min-height:3.6em;font-size:15px;line-height:1.6;padding-top:8px}
#dss-beer-mats .mats-status b{display:block;font-size:20px;font-weight:normal}
#dss-beer-mats .mats-controls{display:flex;gap:10px;justify-content:center;margin:12px 0}
#dss-beer-mats button{min-height:44px;min-width:48px;border:1px solid #87704d;border-radius:4px;background:#24231b;color:inherit;font:inherit;padding:8px 22px;touch-action:none;cursor:pointer;user-select:none;-webkit-user-select:none}
#dss-beer-mats .mats-play{background:#3a2a1c;min-width:140px}
#dss-beer-mats button:disabled{opacity:.4;cursor:default}
#dss-beer-mats .mats-help{font-size:12px;opacity:.75}
#dss-beer-mats .mats-payment{display:none}
#dss-beer-mats .mats-payment.revealed{display:block}
#dss-beer-mats .mats-payment.revealed > span > tw-link{display:none}
#dss-beer-mats [hidden]{display:none!important}
@media (max-width:650px){#dss-beer-mats .mats-bubble{top:30%;max-width:34%;padding:6px 8px}}
</style>
<script>
(function () {
  'use strict';
  var root = document.querySelector('tw-passage:last-of-type #dss-beer-mats');
  if (!root || root.dataset.mounted) return;
  root.dataset.mounted = 'yes';
  var canvas = root.querySelector('canvas'), ctx = canvas.getContext('2d');
  if (!ctx) return;
  // TUNING (2026-10-04, loosened from Astra's prototype: flick 190-340 ms, window 29-2n ms, floor 12).
  var RECORD = 6;                 // Lea's record; beat it to settle the round with a reward
  var CATCH_MIN = 320, CATCH_RANGE = 160;   // ms from flick to the catch point
  var TAIL = 170;                 // ms after the catch point before the stack is gone
  var WINDOW_BASE = 70, WINDOW_PER_MAT = 3, WINDOW_FLOOR = 40; // catch window in ms
  var EDGE = 0.70;                // bar edge as a fraction of canvas height
  var $ = function (s) { return root.querySelector(s); };
  var play = $('.mats-play'), stop = $('.mats-stop'), payment = $('.mats-payment');
  var W = 600, H = 400, phase = 'ready', count = 1, best = 0, flightStart = 0, duration = 0, catchAt = 0, progress = 0, particles = [], last = 0, raf = 0, ended = false, disposed = false, observer = null, resizeObs = null, autoReturn = 0;
  var listeners = [];
  function listen(el, ev, fn, o) { el.addEventListener(ev, fn, o); listeners.push([el, ev, fn, o]); }
  try { best = Number(localStorage.getItem('dss-trishas-mats-best')) || 0; } catch (e) {}
  function plural(n) { return n + (n === 1 ? ' mat' : ' mats'); }
  $('.mats-best').textContent = best ? plural(best) : '—';
  function resize() {
    var r = canvas.getBoundingClientRect(); if (!r.width) return;
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = r.width; H = r.height; canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function status(title, hint) { $('.mats-title').textContent = title; $('.mats-hint').textContent = hint; }
  function speak(event) {
    var lines = { ready: [count === 1 ? 'Six is mine. See if you can beat it.' : 'Another one. Ready?', 'I’ll count.'],
      won: ['Go on, then. One more?', count + ' caught.'], lost: ['Watch the edge.', 'That one doesn’t count.'],
      ended: ['We’ll leave it there.', 'Same time next round?'] };
    var pair = lines[event]; if (!pair) return;
    $('.mats-lea').textContent = pair[0]; $('.mats-jack').textContent = pair[1];
    $('.mats-left').classList.toggle('mats-quiet', event === 'won'); $('.mats-right').classList.toggle('mats-quiet', event !== 'won');
  }
  function windowMs() { return Math.max(WINDOW_FLOOR, WINDOW_BASE - count * WINDOW_PER_MAT); }
  function down() {
    if (ended) return;
    if (phase === 'ready') {
      catchAt = CATCH_MIN + Math.random() * CATCH_RANGE; duration = catchAt + TAIL; flightStart = performance.now(); progress = 0; phase = 'flying';
      play.textContent = 'Catch'; status('Flick — catch!', 'Snatch the edge as it comes over.');
    } else if (phase === 'flying') catchStack();
    else if (phase === 'won') { count++; reset(); }
    else if (phase === 'lost') reset();
  }
  function reset() {
    phase = 'ready'; speak('ready'); progress = 0; particles = []; play.textContent = 'Flick';
    $('.mats-stack').textContent = plural(count); stop.textContent = 'Bow out';
    status(count === 1 ? 'One mat to begin.' : 'Try ' + count + ' mats.', count > RECORD ? 'You’ve beaten Lea. How far can you take it?' : 'Flick, watch the edge, then catch. Each flip turns at a different speed.');
  }
  function catchStack() {
    progress = Math.min(1, (performance.now() - flightStart) / duration);
    if (Math.abs(progress * duration - catchAt) <= windowMs()) {
      phase = 'won'; speak('won'); best = Math.max(best, count);
      try { localStorage.setItem('dss-trishas-mats-best', best); } catch (e) {}
      $('.mats-best').textContent = plural(best); play.textContent = 'Try ' + (count + 1) + ' mats'; stop.textContent = 'Finish here';
      status(count > RECORD ? 'Lea’s record is beaten.' : 'Clean catch.', count + ' caught. Add another mat, or finish here.');
    } else fail(progress * duration < catchAt ? 'Too early.' : 'Too late.');
  }
  function fail(label) {
    phase = 'lost'; speak('lost'); play.textContent = 'Try again'; status(label, 'The stack got away. Try the same number again.');
    var p = pose(progress);
    for (var i = 0; i < count; i++) particles.push({ x: W * .5, y: p.y, vx: (Math.random() - .5) * 110, vy: 50 + Math.random() * 60, a: p.angle });
  }
  function finish() {
    if (ended || disposed) return;
    ended = true; phase = 'ended'; speak('ended'); particles = [];
    var outcome = best > RECORD ? 'win' : 'loss';
    status('Challenge finished.', best ? 'Your best catch: ' + plural(best) + '.' : 'The bar is here when you’re ready.');
    play.disabled = true; stop.disabled = true;
    var target = payment.querySelector('[data-outcome="' + outcome + '"] tw-link');
    if (target) target.click();
    payment.classList.add('revealed'); payment.removeAttribute('aria-hidden');
    autoReturn = setTimeout(function () {
      if (!root.isConnected) return;
      var back = payment.querySelector('[data-outcome="' + outcome + '"] tw-hook tw-link');
      if (back) back.click();
    }, 2800);
  }
  function pose(t) { return { y: H * EDGE - 24 * Math.sin(Math.min(1, t / .78) * Math.PI) + 14 * t, angle: Math.min(1.45, t * duration / catchAt) * Math.PI }; }
  function hand(y, closed, lift) {
    ctx.save(); ctx.translate(W * .5 + 30, y + lift); var s = Math.min(1, W / 700); ctx.scale(s, s);
    var skin = ctx.createLinearGradient(-25, -15, 47, 84); skin.addColorStop(0, '#bc9476'); skin.addColorStop(.3, '#967059'); skin.addColorStop(.65, '#5a3b32'); skin.addColorStop(1, '#2a1b1a');
    ctx.shadowColor = '#09040566'; ctx.shadowBlur = 9; ctx.fillStyle = skin; ctx.beginPath(); ctx.moveTo(22, 79); ctx.bezierCurveTo(18, 61, 12, 43, 6, 31); ctx.bezierCurveTo(0, 21, -16, 15, -24, 9); ctx.bezierCurveTo(-31, 3, -27, -2, -22, 0); ctx.bezierCurveTo(-12, 3, -3, 9, 6, 9); ctx.lineTo(closed ? 5 : 13, closed ? -7 : 19); ctx.bezierCurveTo(closed ? 4 : 14, closed ? -17 : 12, closed ? 14 : 22, closed ? -17 : 16, closed ? 17 : 26, closed ? -6 : 29); ctx.bezierCurveTo(24, 25, 30, 40, 34, 51); ctx.lineTo(47, 81); ctx.closePath(); ctx.fill(); ctx.shadowBlur = 0;
    ctx.strokeStyle = '#d0a28388'; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(-24, 3); ctx.quadraticCurveTo(-12, 7, 0, 14); ctx.stroke();
    ctx.strokeStyle = '#412b2577'; ctx.beginPath(); ctx.moveTo(4, 24); ctx.quadraticCurveTo(14, 22, 21, 34); ctx.moveTo(13, 38); ctx.lineTo(22, 42); ctx.stroke();
    ctx.fillStyle = '#171719'; ctx.beginPath(); ctx.moveTo(19, 72); ctx.lineTo(43, 64); ctx.lineTo(61, 110); ctx.lineTo(29, 115); ctx.fill(); ctx.restore();
  }
  function mat(x, y, angle, i, spread) {
    ctx.save(); ctx.translate(x + (spread || 0), y - i * 3); var flip = Math.cos(angle);
    ctx.transform(1, 0, .12 * Math.sin(angle), 1, 0, 0); ctx.scale(1, Math.max(.055, Math.abs(flip)));
    ctx.shadowColor = '#0008'; ctx.shadowBlur = 8;
    var card = ctx.createLinearGradient(-36, -29, 36, 29); card.addColorStop(0, flip < 0 ? '#8f4237' : '#c6b08b'); card.addColorStop(1, flip < 0 ? '#4e2525' : '#887151');
    ctx.fillStyle = card; ctx.strokeStyle = '#d8c5a0'; ctx.lineWidth = 1; ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(-36, -29, 72, 58, 4); else ctx.rect(-36, -29, 72, 58);
    ctx.fill(); ctx.stroke(); ctx.shadowBlur = 0;
    ctx.strokeStyle = flip < 0 ? '#d9b28c' : '#6c5641'; ctx.strokeRect(-30, -23, 60, 46);
    ctx.fillStyle = flip < 0 ? '#ead1ac' : '#604633'; ctx.textAlign = 'center'; ctx.font = '10px Georgia'; ctx.fillText('TRISHA’S', 0, 0); ctx.font = '6px sans-serif'; ctx.fillText('SOHO', 0, 12); ctx.restore();
  }
  // The bar, drawn flat: incarnadine wall, the fairy lights, the mirror, the wood and its lip.
  function backdrop(now) {
    var wall = ctx.createRadialGradient(W * .5, H * .1, H * .05, W * .5, H * .3, W * .8); wall.addColorStop(0, '#5a1526'); wall.addColorStop(.6, '#2a0a12'); wall.addColorStop(1, '#120507');
    ctx.fillStyle = wall; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = '#1b2a26'; ctx.fillRect(W * .25, H * .08, W * .5, H * .36);
    var glint = ctx.createLinearGradient(W * .25, 0, W * .75, 0); glint.addColorStop(0, '#ffffff00'); glint.addColorStop(.5, '#ffffff14'); glint.addColorStop(1, '#ffffff00');
    ctx.fillStyle = glint; ctx.fillRect(W * .25, H * .08, W * .5, H * .36);
    ctx.strokeStyle = '#8a6a3c'; ctx.lineWidth = 3; ctx.strokeRect(W * .25, H * .08, W * .5, H * .36);
    var bottles = ['#345445', '#754822', '#7f7660', '#54212a'];
    for (var i = 0; i < 9; i++) { var bx = W * (.29 + i * .0525); ctx.fillStyle = bottles[i % 4]; ctx.fillRect(bx, H * .26, W * .022, H * .16); ctx.fillRect(bx + W * .007, H * .22, W * .008, H * .05); }
    ctx.fillStyle = '#3a2416'; ctx.fillRect(W * .22, H * .42, W * .56, H * .012);
    for (var j = 0; j <= 14; j++) { var lx = W * (.08 + j * .06), ly = H * (.05 + .04 * Math.sin(j / 14 * Math.PI)), tw = .75 + .25 * Math.sin(now / 900 + j); var cols = ['#ffb75f', '#c95e75', '#759973']; ctx.fillStyle = cols[j % 3]; ctx.globalAlpha = tw; ctx.beginPath(); ctx.arc(lx, ly, 2.2, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = .25 * tw; ctx.beginPath(); ctx.arc(lx, ly, 7, 0, Math.PI * 2); ctx.fill(); ctx.globalAlpha = 1; }
    var top = H * EDGE - 70;
    var wood = ctx.createLinearGradient(0, top, 0, H * EDGE); wood.addColorStop(0, '#6b3f27'); wood.addColorStop(.7, '#4a2a19'); wood.addColorStop(1, '#5a3520');
    ctx.fillStyle = wood; ctx.fillRect(0, top, W, H * EDGE - top);
    ctx.strokeStyle = '#1f0f0944'; ctx.lineWidth = 1; for (var g = 0; g < 9; g++) { ctx.beginPath(); ctx.moveTo(0, top + 8 + g * 7.5); ctx.bezierCurveTo(W * .3, top + 6 + g * 7.5, W * .7, top + 10 + g * 7.5, W, top + 8 + g * 7.5); ctx.stroke(); }
    ctx.fillStyle = '#7a4a2c'; ctx.fillRect(0, H * EDGE, W, 6); ctx.fillStyle = '#a97a3f'; ctx.fillRect(0, H * EDGE + 6, W, 2);
    var front = ctx.createLinearGradient(0, H * EDGE + 8, 0, H); front.addColorStop(0, '#1a0c0c'); front.addColorStop(1, '#060203'); ctx.fillStyle = front; ctx.fillRect(0, H * EDGE + 8, W, H);
    ctx.fillStyle = '#622431'; ctx.fillRect(W * .2 - 7, H * EDGE - 24, 14, 10); var fl = ctx.createRadialGradient(W * .2, H * EDGE - 30, 1, W * .2, H * EDGE - 30, 22); fl.addColorStop(0, '#ffda97cc'); fl.addColorStop(1, '#ffb16000'); ctx.fillStyle = fl; ctx.fillRect(W * .2 - 22, H * EDGE - 52, 44, 44);
    ctx.fillStyle = '#93612b'; ctx.fillRect(W * .8 - 9, H * EDGE - 34, 18, 26); ctx.fillStyle = '#b9c8bf55'; ctx.fillRect(W * .8 - 11, H * EDGE - 40, 22, 34);
  }
  function draw(now) {
    if (disposed) return;
    raf = requestAnimationFrame(draw);
    var dt = Math.min(.04, (now - last) / 1000 || .016); last = now;
    backdrop(now);
    var i, p;
    if (phase === 'flying') { progress = (now - flightStart) / duration; if (progress >= 1) { progress = 1; fail('It slipped past.'); } }
    if (phase === 'ready' || phase === 'ended') { for (i = 0; i < count; i++) mat(W * .5, H * EDGE, 0, i); hand(H * EDGE, false, 16); }
    if (phase === 'flying') { p = pose(progress); ctx.fillStyle = '#0004'; ctx.beginPath(); ctx.ellipse(W * .5, H * EDGE, 39, 4, 0, 0, Math.PI * 2); ctx.fill(); for (i = 0; i < count; i++) mat(W * .5, p.y, p.angle, i, Math.sin(progress * Math.PI) * i * .65); hand(p.y, false, 10 - 18 * Math.sin(progress * Math.PI)); }
    if (phase === 'won') { p = pose(catchAt / duration); for (i = 0; i < count; i++) mat(W * .5, p.y, Math.PI, i); hand(p.y, true, -3); }
    if (phase === 'lost') { for (i = 0; i < particles.length; i++) { p = particles[i]; p.x += p.vx * dt; p.vy += 500 * dt; p.y += p.vy * dt; p.a += dt * 4; mat(p.x, p.y, p.a, 0); } }
    var shade = ctx.createRadialGradient(W * .5, H * .5, H * .2, W * .5, H * .5, W * .65); shade.addColorStop(0, '#0000'); shade.addColorStop(1, '#0005'); ctx.fillStyle = shade; ctx.fillRect(0, 0, W, H);
  }
  function key(e) {
    if (!root.isConnected) return;
    if (e.code === 'Space' && e.target.tagName !== 'BUTTON' && e.target.tagName !== 'INPUT') { e.preventDefault(); if (!e.repeat) down(); }
  }
  function cleanup() {
    if (disposed) return; disposed = true;
    cancelAnimationFrame(raf); clearTimeout(autoReturn);
    listeners.forEach(function (l) { l[0].removeEventListener(l[1], l[2], l[3]); });
    if (observer) observer.disconnect(); if (resizeObs) resizeObs.disconnect();
  }
  function boot() {
    listen(play, 'pointerdown', function (e) { if (e.button !== 0) return; e.preventDefault(); down(); });
    listen(play, 'click', function (e) { if (e.detail === 0) down(); });
    listen(canvas, 'pointerdown', function (e) { if (e.button !== 0) return; e.preventDefault(); down(); });
    listen(stop, 'click', finish);
    listen(document, 'keydown', key);
    listen(document, 'visibilitychange', function () { if (document.hidden && phase === 'flying') reset(); });
    listen(window, 'resize', resize);
    if (window.ResizeObserver) { resizeObs = new ResizeObserver(resize); resizeObs.observe(canvas); }
    observer = new MutationObserver(function () { if (!root.isConnected) cleanup(); });
    observer.observe(root.closest('tw-story') || root.parentNode, { childList: true, subtree: true });
    if (window.DSS_DEV) {
      window._beerMatsDev = { flick: function () { if (phase === 'ready') down(); }, catchNow: function () { if (phase !== 'flying') return; flightStart = performance.now() - catchAt; catchStack(); }, miss: function () { if (phase === 'flying') fail('Too late.'); }, finish: finish,
        state: function () { return { phase: phase, count: count, best: best, catchAt: catchAt, windowMs: windowMs(), ended: ended }; } };
    }
    resize(); last = performance.now(); raf = requestAnimationFrame(draw);
  }
  (window.dssShowMinigameRules || function (o) { o.onPlay(); })({ key: 'mats', title: 'BEER MATS', lines: [
    '<div class="claude-draft">A stack of mats on the edge of the bar. Flick them up with the back of your hand, then catch them as they turn over.</div>',
    '<div class="claude-draft">Space or the button. One press to flick, a second to catch. Each flip turns at a different speed, so watch the edge.</div>',
    '<div class="claude-draft">Catch, and a mat is added. Miss, and you try the same number again. Lea’s record is six. Bow out whenever you like.</div>',
    '<div class="claude-draft">Beat Lea and finish: morale +8, the first time only. Anything less costs nothing.</div>'
  ], onPlay: boot });
  var heading = document.querySelector('.dss-rules-title');
  if (heading && heading.textContent === 'BEER MATS') { var draft = document.createElement('div'); draft.className = 'claude-draft'; draft.textContent = heading.textContent; heading.textContent = ''; heading.appendChild(draft); }
})();
</script>

