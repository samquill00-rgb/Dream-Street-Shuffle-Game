  }
  function render(box) {
    box.setAttribute('data-filled', '1');
    var a = load(), n = night(), first = 0;
    try { first = +localStorage.getItem('dssRunFirst') || 0; } catch (e) {} /* 2026-10-25 (Sam, item 3): earlier nights' slips only from this run, the "Last night:" rule; a fresh game opens a clean notebook */
    var tonight = a.filter(function(r) { return r.n === n; }), before = a.filter(function(r) { return r.n !== n && r.n >= first; }).reverse().slice(0, 12);
    tonight.forEach(function(r) { box.appendChild(slipEl(r, 0)); });
    if (before.length) { var hr = document.createElement('div'); hr.className = 'nb-slips-before'; box.appendChild(hr); before.forEach(function(r) { box.appendChild(slipEl(r, Math.max(1, Math.min(3, n - r.n)))); }); }
  }
  setInterval(function() { scan(); Array.prototype.forEach.call(document.querySelectorAll('.nb-slips:not([data-filled])'), render); }, 300);
  return { list: load, night: night, el: slipEl }; // 2026-10-16: el (a slip element) for the Dawn's record
})();
// 2026-10-22 (Sam: "Yes, build the dedication page"): the book's first page. The dedication is chosen on Dedicate Your Book
// after the naming, shown and changeable on the notebook's FINDS page (.nb-dedication), printed under the title at the Dawn
// (.dawn-dedication), and kept in localStorage 'dssDedication' like the slips (a list of {n: night, k: key, t: time}), so a
// return night opens on last night's choice and every earlier choice stays, struck through. The names a night has earned come
// from the header's hidden #dss-dedic-pool and are banked in 'dssDedicPool', so a name once earned stays offered on later
// nights. Names only, no prose. Nothing here touches Harlowe state.
window.dssDedication = (function() {
  var KEY = 'dssDedication', POOL = 'dssDedicPool', mem = null, poolMem = null;
  var NAMES = { aoife: 'AOIFE', daughter: 'my daughter', lily: 'LILY', ashton: 'ASHTON GRANGER', john: 'JOHN ST. JOHN', fetch: 'the Fetch', noone: 'no one' };
  var ORDER = ['aoife', 'daughter', 'lily', 'ashton', 'john', 'fetch', 'noone'], BASE = ['aoife', 'daughter', 'noone']; /* 2026-10-24 (Sam): LILY joins only once Night Ahead Part Two has named her (the header's pool span carries her then); dssLilyKnown remembers that across nights, and a bank filled before this rule (when LILY was always offered) drops her until then */
  function night() { try { return +localStorage.getItem('dssNightNo') || 0; } catch (e) { return 0; } }
  function load() { if (mem) return mem; try { return JSON.parse(localStorage.getItem(KEY) || '[]') || []; } catch (e) { return []; } }
  function save(a) { try { localStorage.setItem(KEY, JSON.stringify(a)); mem = null; } catch (e) { mem = a; } }
  function current() { var a = load(); return a.length ? a[a.length - 1] : null; }
  function label(k) { return NAMES[k] || ''; }
  function line(k) { return k && NAMES[k] ? 'For ' + NAMES[k] + '.' : ''; }
  function refill() { Array.prototype.forEach.call(document.querySelectorAll('.nb-dedication[data-filled], .dawn-dedication[data-filled]'), function(el) { el.removeAttribute('data-filled'); }); }
  function set(k) {
    if (!NAMES[k]) return;
    var a = load(), c = a.length ? a[a.length - 1] : null;
    if (!c || c.k !== k) { a.push({ n: night(), k: k, t: Date.now() }); save(a); }
    refill();
  }
  function pool() {
    var banked = [];
    try { banked = JSON.parse(localStorage.getItem(POOL) || '[]') || []; } catch (e) { banked = poolMem || []; }
    var span = document.getElementById('dss-dedic-pool'), fresh = span ? span.textContent.split(',').map(function(k) { return String(k).trim(); }) : [], known = false;
    try { if (fresh.indexOf('lily') >= 0) localStorage.setItem('dssLilyKnown', '1'); known = localStorage.getItem('dssLilyKnown') === '1'; } catch (e) { known = fresh.indexOf('lily') >= 0; }
    if (!known) banked = banked.filter(function(k) { return k !== 'lily'; });
    var all = banked.slice();
    fresh.concat(BASE).forEach(function(k) { k = String(k).trim(); if (k && NAMES[k] && all.indexOf(k) < 0) all.push(k); });
    if (all.length !== banked.length) { try { localStorage.setItem(POOL, JSON.stringify(all)); } catch (e) { poolMem = all; } }
    return ORDER.filter(function(k) { return all.indexOf(k) >= 0; });
  }
  function history() {
    // every earlier choice, newest first, each name once, the current name left out, at most six
    var a = load(), c = a.length ? a[a.length - 1] : null, out = [], seen = {};
    for (var i = a.length - 2; i >= 0; i--) { var r = a[i]; if (!r || seen[r.k] || (c && r.k === c.k)) continue; seen[r.k] = 1; out.push(r); }
    return out.slice(0, 6);
  }
  function optionRow(onPick) {
    var c = current(), row = document.createElement('div'); row.className = 'nb-dedic-pool';
    pool().forEach(function(k) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'nb-dedic-opt' + (c && c.k === k ? ' on' : ''); b.setAttribute('data-k', k); b.textContent = label(k);
      b.addEventListener('click', function(ev) { ev.preventDefault(); ev.stopPropagation(); set(k); onPick(k); });
      row.appendChild(b);
    });
    return row;
  }
  function renderNotebook(box) {
    box.setAttribute('data-filled', '1'); box.innerHTML = ''; box._pool = null;
    var c = current(), n = night(), now = document.createElement('div'); now.className = 'nb-dedic-now';
    now.appendChild(document.createTextNode(c ? line(c.k) : ''));
    var change = document.createElement('button'); change.type = 'button'; change.className = 'nb-dedic-change'; change.textContent = c ? 'Change' : 'Dedicate';
    change.addEventListener('click', function(ev) {
      ev.preventDefault(); ev.stopPropagation();
      if (box._pool) { box._pool.parentNode.removeChild(box._pool); box._pool = null; return; }
      box._pool = optionRow(function() { box.removeAttribute('data-filled'); });
      box.insertBefore(box._pool, now.nextSibling);
    });
    now.appendChild(change); box.appendChild(now);
    history().forEach(function(r) {
      var o = document.createElement('div'); o.className = 'nb-dedic-old nb-slip-age' + Math.max(1, Math.min(3, n - r.n + 1)); o.textContent = line(r.k); box.appendChild(o);
    });
  }
  function renderDawn(el) {
    el.setAttribute('data-filled', '1');
    var c = current(); if (!c) { el.hidden = true; return; }
    el.textContent = line(c.k); el.hidden = false;
    var title = document.querySelector('.dawn-bookname');
    if (title && title.nextSibling !== el) title.parentNode.insertBefore(el, title.nextSibling);
  }
  function typeInto(span, text) {
    span.textContent = ''; var i = 0, gen = (span._gen = (span._gen || 0) + 1);
    (function step() {
      if (!span.isConnected || span._gen !== gen) return;
      if (i >= text.length) return;
      span.textContent += text.charAt(i++);
      if (window.dssAudio && window.dssAudio.typewriterTick) { try { window.dssAudio.typewriterTick(0.14); } catch (e) {} }
      setTimeout(step, 55 + Math.random() * 45);
    })();
  }
  // Dedicate Your Book: the earned names as buttons; a pick stores it, types "NAME." after For and frees the link
  function page(root) {
    if (!root || root._dd) return; root._dd = true;
    var nameEl = root.querySelector('.nb-dedic-name'), poolEl = root.querySelector('.nb-dedic-pool'), c = current();
    if (!nameEl || !poolEl) return;
    function mark(k) { Array.prototype.forEach.call(root.querySelectorAll('.nb-dedic-opt'), function(b) { b.classList.toggle('on', b.getAttribute('data-k') === k); }); }
    if (c) { nameEl.textContent = label(c.k) + '.'; root.classList.remove('is-empty'); } else { nameEl.textContent = ''; root.classList.add('is-empty'); }
    pool().forEach(function(k) {
      var b = document.createElement('button'); b.type = 'button'; b.className = 'nb-dedic-opt' + (c && c.k === k ? ' on' : ''); b.setAttribute('data-k', k); b.textContent = label(k);
      b.addEventListener('click', function(ev) {
        ev.preventDefault(); ev.stopPropagation();
