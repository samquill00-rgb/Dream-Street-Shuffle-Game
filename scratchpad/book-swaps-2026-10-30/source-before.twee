  var BIOS = window.DSS_WATKINS_BIOS || { her: { name: 'MADAME BLAVATSKY', text: '[Sam: a few lines on Madame Blavatsky]', draft: true }, him: { name: 'THE BEAST', text: '[Sam: a few lines on the Beast]', draft: true } };
  var tip = null;
  function bioShow(k, w) { bioHide(); var b = BIOS[k]; if (!b) return; tip = document.createElement('div'); tip.className = 'wk-bio' + (b.draft ? ' wk-bio-draft' : ''); tip.setAttribute('role', 'tooltip'); tip.innerHTML = '<div class="wk-bio-name"></div><div class="wk-bio-text"></div>'; tip.firstChild.textContent = b.name; tip.lastChild.textContent = b.text; document.body.appendChild(tip); var r = w.getBoundingClientRect(), tw = tip.offsetWidth, th = tip.offsetHeight; tip.style.left = Math.max(8, Math.min(innerWidth - tw - 8, r.left + r.width / 2 - tw / 2)) + 'px'; tip.style.top = (r.top - th - 10 > 8 ? r.top - th - 10 : r.bottom + 10) + 'px'; requestAnimationFrame(function() { if (tip) tip.classList.add('in'); }); }
  function bioHide() { if (tip && tip.parentNode) tip.parentNode.removeChild(tip); tip = null; }
  words.forEach(function(w) { var k = w.classList.contains('wk-her') ? 'her' : w.classList.contains('wk-him') ? 'him' : ''; if (!k) return; w.classList.add('wk-bio-link'); w.tabIndex = 0; w.addEventListener('mouseenter', function() { bioShow(k, w); }); w.addEventListener('mouseleave', bioHide); w.addEventListener('focus', function() { bioShow(k, w); }); w.addEventListener('blur', bioHide); w.addEventListener('click', function(ev) { ev.stopPropagation(); if (tip) bioHide(); else bioShow(k, w); }); });
  var T3 = T2end + 300;
