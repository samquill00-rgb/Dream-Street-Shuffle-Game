(set: $sobriety to ($statLoss: $sobriety, 6))\
<!-- 2026-10-28 (Sam: "could definitely go on its own card, cause it's not a part of the conversation"): the closing line moved, unchanged, to After the dual ring, so the call fits a laptop screen -->\

(after: 15s)[<div class="phone-exit">(link: "Hang up.")[(set: $resumingFromCall to false)(set: $crashedAfterDualRing to true)(set: $blackouts to $blackouts + 1)(if: $sobriety > 8)[(set: $sobriety to 8)](if: $confidence > 18)[(set: $confidence to 18)](go-to: "After the dual ring")]</div>]
(after: 40s)[(set: $resumingFromCall to false)(set: $crashedAfterDualRing to true)(set: $blackouts to $blackouts + 1)(if: $sobriety > 8)[(set: $sobriety to 8)](if: $confidence > 18)[(set: $confidence to 18)](go-to: "After the dual ring")]

:: After the dual ring {"position":"100,1600","size":"100,100"}
<!-- 2026-10-28: the dual ring's closing line on its own card (Sam's words unchanged; it faded in at 22 s on the call, here at once); then on to the blackout as before --><span class="lily-glimpse lily-fade">And the tears and the tears and the tears.</span>

(after: 4s)[<div class="phone-exit">[[Continue|Coach and Horses lock]]</div>]

:: Title {"position":"100,50","size":"100,100"}
<!-- 2026-10-21 (Sam): two looks for the title, one word to switch. "lights": the three blue beams breathing and swaying, the fog, and a slow fall of white petals, the premonition of the dawn (his ruling after a street scene and a pentangle were both tried and turned down). "street": the Ginger Light street scene built under the words (kept as an option; he liked it too). -->(set: _titleMode to "lights")\
<style>/* The title is viewport furniture: a transformed passage would contain its fixed layer. */
tw-passage:has(#dss-title){transform:none!important;animation:dst-arrive 1.4s ease-out both!important;}
@keyframes dst-arrive{from{opacity:0}to{opacity:1}}
#dss-title{font-size:20px;isolation:isolate;}
#dss-title .dst-type{font-size:clamp(32px,4.15vw,60px)!important;}
#dss-title .dst-copy{width:min(850px,90vw);padding:20px;box-sizing:border-box;}
#dss-title .dst-an-top{opacity:.52!important;}
#dss-title .dst-fog{filter:blur(22px);}
@media(max-width:600px){#dss-title{font-size:17px;}#dss-title .dst-copy{width:94vw;padding:14px;}#dss-title .dst-an-top{width:150%!important;left:-25%!important;}}
@media(prefers-reduced-motion:reduce){tw-passage:has(#dss-title){animation:none!important;}#dss-title *{animation:none!important;}}
/* 2026-10-21: with the street scene mounted (.dss-title-3d) the three blue beams and the fog soften over it, and the words get a scrim */
#dss-title.dss-title-3d #dst-light{opacity:.55;}
#dss-title.dss-title-3d .dst-fog{opacity:.45;}
#dss-title.dss-title-3d .dst-copy{background:radial-gradient(ellipse at center,rgba(6,6,8,.66) 0%,rgba(6,6,8,.38) 45%,rgba(6,6,8,0) 72%);text-shadow:0 2px 18px rgba(0,0,0,.95),0 0 2px rgba(0,0,0,.9);}
#dss-title.dss-title-3d .dst-type{text-shadow:0 2px 22px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.9)!important;}
#gl-wrap.gl-title{position:absolute!important;inset:0;width:100%!important;height:100%!important;z-index:1!important;opacity:0;transition:opacity 2.6s ease;}
#gl-wrap.gl-title.gl-in{opacity:1;}
@keyframes dst-fog1{0%,100%{transform:translateX(-5%);opacity:1}50%{transform:translateX(5%);opacity:0.6}}@keyframes dst-fog2{0%,100%{transform:translateX(8%);opacity:1}50%{transform:translateX(-6%);opacity:0.7}}@keyframes dst-breathe{0%,100%{opacity:0.7}50%{opacity:1}}/* Two irregular drift patterns — many keyframes, asymmetric spacing,
   multi-rotation tumbles so the petals look like they're catching air
   unpredictably rather than swaying on a fixed sine wave. */
@keyframes dst-petal-drift-a{0%{transform:translate3d(0,-40px,0) rotate(0deg);opacity:0}6%{opacity:1}13%{transform:translate3d(42px,11vh,0) rotate(75deg)}24%{transform:translate3d(28px,22vh,0) rotate(155deg)}33%{transform:translate3d(-12px,32vh,0) rotate(195deg)}45%{transform:translate3d(-58px,46vh,0) rotate(285deg)}54%{transform:translate3d(-32px,55vh,0) rotate(320deg)}66%{transform:translate3d(48px,68vh,0) rotate(430deg)}78%{transform:translate3d(38px,82vh,0) rotate(495deg)}90%{transform:translate3d(-22px,95vh,0) rotate(560deg);opacity:1}100%{transform:translate3d(10px,110vh,0) rotate(605deg);opacity:0}}@keyframes dst-petal-drift-b{0%{transform:translate3d(0,-40px,0) rotate(20deg);opacity:0}7%{opacity:1}14%{transform:translate3d(-50px,10vh,0) rotate(-65deg)}26%{transform:translate3d(-22px,24vh,0) rotate(-145deg)}38%{transform:translate3d(48px,38vh,0) rotate(-250deg)}48%{transform:translate3d(20px,50vh,0) rotate(-300deg)}59%{transform:translate3d(-62px,62vh,0) rotate(-410deg)}71%{transform:translate3d(-35px,76vh,0) rotate(-470deg)}84%{transform:translate3d(42px,90vh,0) rotate(-555deg)}92%{opacity:1}100%{transform:translate3d(15px,110vh,0) rotate(-610deg);opacity:0}}@keyframes dst-petal-drift-c{0%{transform:translate3d(0,-40px,0) rotate(-10deg);opacity:0}6%{opacity:1}15%{transform:translate3d(18px,12vh,0) rotate(40deg)}29%{transform:translate3d(-14px,27vh,0) rotate(95deg)}44%{transform:translate3d(26px,43vh,0) rotate(170deg)}58%{transform:translate3d(-8px,57vh,0) rotate(230deg)}72%{transform:translate3d(20px,72vh,0) rotate(300deg)}86%{transform:translate3d(-16px,88vh,0) rotate(350deg)}93%{opacity:1}100%{transform:translate3d(4px,110vh,0) rotate(390deg);opacity:0}}.dst-drip{position:absolute;top:-30px;pointer-events:none;z-index:1;animation-iteration-count:infinite;animation-timing-function:ease-in-out;will-change:transform,opacity}tw-passage tw-link{border-left:none!important;padding-left:0!important;}</style>
<div id="dss-title" style="position:fixed;top:0;left:0;width:100vw;height:100vh;background:#060608;z-index:0;overflow:hidden;">
(if: _titleMode is "street")[<div id="ga-container" data-title="1" style="display:none"></div>]<!-- street mode: the approach scene's watcher sees this marker and buildGLScene's title mode mounts the canvas inside #dss-title beneath the copy, with no button; if WebGL fails the page stays as it was -->
<div style="position:absolute;top:0;left:0;width:100%;height:100%;background:radial-gradient(ellipse at 10% 30%,rgba(20,28,50,0.6) 0%,transparent 50%),radial-gradient(ellipse at 90% 45%,rgba(18,24,45,0.4) 0%,transparent 45%),radial-gradient(ellipse at 30% 85%,rgba(15,20,40,0.5) 0%,transparent 40%);"></div>
