    placed.forEach(function(c,i){if(c)card(geometry(i,cardAngle(i)),i%4,i===editing);});
    gild=0;
    fallen.forEach(function(f,i){
      var t=reduced?1:clamp((elapsed-f.t)/.55,0,1), g=f.g;
      card({x:g.x+(45+i*4-g.x)*t,y:g.y+(394+i%4*3-g.y)*t,theta:g.theta*(1-t)+(i%3-1)*.09*t,length:g.length},f.suit,false);
    });
