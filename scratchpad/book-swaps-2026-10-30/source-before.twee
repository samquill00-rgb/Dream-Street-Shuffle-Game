    src.connect(f2); f2.connect(g2); g2.connect(g);
    src.connect(f3); f3.connect(g3); g3.connect(g);
    g.connect(ac.destination);
    src.start(now);
    _ambient = { src: src, g: g, kind: 'wind', lfo: lfo, lfo2: lfo2 };
    });
  }
  // Fire — pink noise with slow flicker, plus sparse crackle events baked in.
  // Modelled after Farnell's fire chapter. Tuned for the Dido pyre: louder
  // body, denser crackle, two filter bands (low rumbling heat + brighter
  // mids) so the fire reads as substantial, not a campfire.
  function fireFarnell() {
    _play(function(ac) {
    if (_ambient && _ambient.kind === 'fire') return;
    _stopAmbient();
    var now = ac.currentTime;
    var dur = 15.0;
    var bufLen = Math.floor(ac.sampleRate * dur);
    var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
    var d = buf.getChannelData(0);
    var b0=0, b1=0, b2=0;
    for (var i = 0; i < bufLen; i++) {
      var w = Math.random()*2-1;
      b0 = 0.99*b0 + 0.07*w;
      b1 = 0.96*b1 + 0.10*w;
      b2 = 0.85*b2 + 0.12*w;
