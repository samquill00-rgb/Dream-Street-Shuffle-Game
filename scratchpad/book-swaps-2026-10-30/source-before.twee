addBuzzerRow(1.68, '');
/* 2026-10-25 (Sam: "sexy airs of night"): somebody else's trade, a white card in biro Sellotaped to the wall above the bells */
var modelCardTex = makeCanvasTexture(512, 192, function(cx, w, h) {
cx.fillStyle = '#ece6d4'; cx.fillRect(0, 0, w, h);
cx.fillStyle = 'rgba(120, 100, 60, 0.10)'; cx.fillRect(0, h - 28, w, 28);
cx.fillStyle = 'rgba(240, 236, 220, 0.55)'; cx.fillRect(w * 0.36, 0, w * 0.28, 24);
cx.fillStyle = '#9a1c22'; cx.textAlign = 'center'; cx.textBaseline = 'middle';
cx.font = 'italic 600 68px Georgia'; cx.fillText('Model', w / 2, h * 0.42);
cx.fillStyle = '#26306a'; cx.font = '36px Georgia'; cx.fillText('2nd FLOOR', w / 2, h * 0.78);
});
var modelCard = new THREE.Mesh(new THREE.PlaneGeometry(0.3, 0.11), new THREE.MeshStandardMaterial({ map: modelCardTex, roughness: 0.7 }));
modelCard.position.set(1.25, 1.97, 0.1);
modelCard.rotation.z = 0.06;
doorGroup.add(modelCard);
/* 2026-10-25 (Sam: "can we make this zoomable?"): click the card and the camera steps up to read it; click again to step back */
/* 2026-10-25 (Sam: "it should have a coloured sprite like the rest, just to the side of it. A bright red one"): the rooms' resting glow (dssRoomPlay), a light's falloff with a white-hot core, breathing, beside the card */
var loMarkTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var g = cx.createRadialGradient(64, 64, 0, 64, 64, 64);
g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(0.12, 'rgba(255,255,255,0.92)'); g.addColorStop(0.28, 'rgba(255,255,255,0.58)'); g.addColorStop(0.5, 'rgba(255,255,255,0.26)'); g.addColorStop(0.75, 'rgba(255,255,255,0.08)'); g.addColorStop(1, 'rgba(255,255,255,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var loMarkCoreTex = makeCanvasTexture(64, 64, function(cx, w, h) {
var g = cx.createRadialGradient(32, 32, 0, 32, 32, 32);
g.addColorStop(0, 'rgba(255,255,255,1)'); g.addColorStop(0.35, 'rgba(255,255,255,0.55)'); g.addColorStop(1, 'rgba(255,255,255,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var loMark = new THREE.Sprite(new THREE.SpriteMaterial({ map: loMarkTex, color: 0xff1414, transparent: true, opacity: 0.9, depthWrite: false, depthTest: false, blending: THREE.NormalBlending, toneMapped: false, fog: false })); /* drawn normally, not added as light: on Lackland's warm lit wall an additive red barely shows */
var loMarkCore = new THREE.Sprite(new THREE.SpriteMaterial({ map: loMarkCoreTex, transparent: true, opacity: 0.7, depthWrite: false, depthTest: false, blending: THREE.AdditiveBlending, toneMapped: false, fog: false }));
loMark.renderOrder = 998; loMarkCore.renderOrder = 999;
var loMarkAt = new THREE.Vector3(1.52, 2.09, 0.14); /* just right of the card; doorGroup is lifted 0.12 later, so set in world terms */
loMark.position.copy(loMarkAt); loMarkCore.position.copy(loMarkAt);
var loMarkD = camera.position.distanceTo(loMarkAt), loMarkS = 2 * loMarkD * Math.tan(camera.fov * Math.PI / 360) * 0.155;
loMark.scale.set(loMarkS, loMarkS, 1); loMarkCore.scale.set(loMarkS * 0.27, loMarkS * 0.27, 1);
scene.add(loMark); scene.add(loMarkCore);
var loCamHome = { pos: camera.position.clone(), look: new THREE.Vector3(0, 2.8, 0) };
var loCamLook = loCamHome.look.clone();
var loCardZoom = { on: false, k: 0, pos: new THREE.Vector3(), look: new THREE.Vector3() };
var loRay = new THREE.Raycaster(), loPtr = new THREE.Vector2();
function loHitsCard(ev) {
var rc = renderer.domElement.getBoundingClientRect();
loPtr.set(((ev.clientX - rc.left) / rc.width) * 2 - 1, -((ev.clientY - rc.top) / rc.height) * 2 + 1);
loRay.setFromCamera(loPtr, camera);
return loRay.intersectObjects([modelCard, loMarkCore]).length > 0;
}
renderer.domElement.addEventListener('pointermove', function(ev) { renderer.domElement.style.cursor = (loCardZoom.on || loHitsCard(ev)) ? 'pointer' : ''; });
renderer.domElement.addEventListener('click', function(ev) {
if (loCardZoom.on) { loCardZoom.on = false; return; }
if (!loHitsCard(ev)) return;
modelCard.getWorldPosition(loCardZoom.look);
loCardZoom.pos.set(loCardZoom.look.x + 0.04, loCardZoom.look.y + 0.02, loCardZoom.look.z + 0.42);
loCardZoom.on = true;
});

var stepTex = makeCanvasTexture(512, 128, function(cx, w, h) {
cx.fillStyle = '#8a8878';
cx.fillRect(0, 0, w, h);
var wornGrad = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w * 0.4);
wornGrad.addColorStop(0, 'rgba(70, 68, 60, 0.35)');
wornGrad.addColorStop(0.6, 'rgba(80, 78, 68, 0.15)');
wornGrad.addColorStop(1, 'rgba(90, 88, 78, 0)');
cx.fillStyle = wornGrad;
cx.fillRect(0, 0, w, h);
cx.fillStyle = 'rgba(40, 35, 25, 0.3)';
cx.fillRect(0, 0, w, 8);
cx.fillRect(0, h - 6, w, 6);
cx.fillRect(0, 0, 10, h);
cx.fillRect(w - 10, 0, 10, h);
cx.strokeStyle = 'rgba(55, 50, 40, 0.2)';
cx.lineWidth = 1;
for (var sc = 0; sc < 20; sc++) {
cx.beginPath();
var sx = Math.random() * w;
cx.moveTo(sx, Math.random() * h);
cx.lineTo(sx + 10 + Math.random() * 30, Math.random() * h);
cx.stroke();
}
cx.fillStyle = 'rgba(30, 25, 18, 0.2)';
for (var st = 0; st < 4; st++) {
cx.beginPath();
cx.ellipse(50 + Math.random() * (w - 100), 20 + Math.random() * (h - 40), 8 + Math.random() * 15, 4 + Math.random() * 8, Math.random(), 0, Math.PI * 2);
cx.fill();
}
cx.fillStyle = 'rgba(25, 20, 10, 0.4)';
cx.beginPath();
cx.arc(w * 0.7, h * 0.6, 3, 0, Math.PI * 2);
cx.fill();
});
