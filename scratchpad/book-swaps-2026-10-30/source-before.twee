rsVig = document.createElement('canvas');
rsVig.width = 256; rsVig.height = 256;
var vigCtx = rsVig.getContext('2d');
var vigGrad = vigCtx.createRadialGradient(128, 128, 0, 128, 128, 180);
vigGrad.addColorStop(0, 'rgba(0,0,0,0)');
vigGrad.addColorStop(1, 'rgba(0,0,0,0.6)');
vigCtx.fillStyle = vigGrad;
vigCtx.fillRect(0, 0, 256, 256);

// ============================================================
// GRAIN EFFECT
// ============================================================
rsGrain = document.createElement('canvas');
rsGrain.width = 512; rsGrain.height = 512;
rsGrainCtx = rsGrain.getContext('2d');

// ============================================================
// DATE STAMP & LOCATION LABEL
// ============================================================

rsLoc = document.createElement('div');
rsLoc.id = 'rs-location';
rsLoc.style.cssText = 'position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New", monospace;color:rgba(200,180,140,0.4);letter-spacing:2px;pointer-events:none;z-index:9001;';
rsLoc.textContent = "RONNIE’S, FRITH STREET, SOHO";
rsWrap.appendChild(rsLoc);

// ============================================================
// ENTER BUTTON
// ============================================================
rsBtn = document.createElement('div');
rsBtn.id = 'rs-enter-btn';
rsBtn.style.cssText = 'position:absolute;bottom:60px;left:50%;transform:translateX(-50%);font:13px "Courier New",monospace;color:rgba(200,140,100,0.85);cursor:pointer;user-select:none;z-index:9001;letter-spacing:2px;padding:8px 18px;border:1px solid rgba(200,140,100,0.35);opacity:0;transition:opacity 1.2s ease, color 0.3s ease, border-color 0.3s ease;';
rsBtn.textContent = "ENTER RONNIE SCOTT’S";
rsBtn.addEventListener('mouseenter', function() { rsBtn.style.color = 'rgba(255,160,100,0.95)'; rsBtn.style.borderColor = 'rgba(232,120,24,0.6)'; });
rsBtn.addEventListener('mouseleave', function() { rsBtn.style.color = 'rgba(200,140,100,0.85)'; rsBtn.style.borderColor = 'rgba(200,140,100,0.35)'; });
rsBtn.addEventListener('click', function() {
  rsAnimId = null;
  rsActive = false;
  rsWrap.remove();
  // Find the · navigation link specifically — NOT the first tw-link in the
  // passage, which would be the ← Back link sitting above the
  // rs-container in the source. That bug used to take the player back to
  // whatever passage they came from (e.g. the Colony) instead of into the
  // club.
  var cont = document.getElementById('rs-container');
  if (!cont) return;
  var links = cont.parentElement.querySelectorAll('tw-link, .enchantment-link');
  for (var i = 0; i < links.length; i++) {
    if (links[i].textContent.trim() === '·') { links[i].click(); return; }
  }
});
rsWrap.appendChild(rsBtn);
setTimeout(function() { rsBtn.style.opacity = '1'; }, 1500);

// ============================================================
// ANIMATION LOOP WITH EFFECTS
// ============================================================
var animFrame = 0;
function renderRS() {
  rsAnimId = requestAnimationFrame(renderRS);
  
  if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
  
  /* 2026-10-29 nightwork: the per-frame 1440x900 temp canvas (never used) is gone, and the grain
     no longer makes 262,144 fillRect calls every 8th frame; the same 3% grey source-over blend is
     done in a typed array and put once. Scene measured 36 fps headless before. */
  animFrame++;
  rsGrainFrame = (rsGrainFrame + 1) % 8;
  if (rsGrainFrame === 0 && !(rsStill && animFrame > 8)) {
    if (!rsGrain._img) rsGrain._img = rsGrainCtx.getImageData(0, 0, rsGrain.width, rsGrain.height);
    var gd = rsGrain._img.data;
    for (var gi = 0; gi < gd.length; gi += 4) {
      var gv = Math.floor(Math.random() * 256), ga = gd[gi + 3] / 255, go = 0.03 + ga * 0.97;
      var gc = (gv * 0.03 + gd[gi] * ga * 0.97) / go;
      gd[gi] = gc; gd[gi + 1] = gc; gd[gi + 2] = gc; gd[gi + 3] = go * 255;
    }
    rsGrainCtx.putImageData(rsGrain._img, 0, 0);
  }
}

renderRS();

}

// ============================================================
// CONTAINER WATCHER — polls for appear/disappear
// ============================================================
setInterval(function() {
  var cont = document.getElementById('rs-container');
  if (cont && !rsActive) {
    initRonnieScotts();
  } else if (!cont) {
    if (rsAnimId !== null) { cancelAnimationFrame(rsAnimId); rsAnimId = null; }
    rsActive = false;
    window._dssDisposeWrap('rs-wrap');
  }
}, 300);

})();

// ====== COPPER'S LAIR SCENE — INLINE ======
(function() {
var clActive = false;
var clAnimId = null;

function initCoppersLair() {
if (clActive) return;
clActive = true;
if (typeof THREE === 'undefined') {
var s = document.createElement('script');
s.src = 'vendor/three/three.min.js';
s.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildCLScene) : buildCLScene()); };
document.head.appendChild(s);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildCLScene) : buildCLScene());
}
}

function buildCLScene() {
// Reduced-motion: hold one settled frame (bulb steady, drip swelling at the ceiling).
var clStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var clWrap = document.createElement('div');
clWrap.id = 'cl-wrap';
clWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#06060a;';

// ============================================================
// SCENE SETUP
// ============================================================
var scene = new THREE.Scene();
scene.background = new THREE.Color(0x06060a);
scene.fog = new THREE.Fog(0x05050a, 5, 26);

var camera = new THREE.PerspectiveCamera(54, window.innerWidth / window.innerHeight, 0.1, 200);
camera.position.set(0.3, 1.5, 8.5);
camera.lookAt(0, 1.4, -6);

var renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
renderer.toneMappingExposure = 0.45;
clWrap.appendChild(renderer.domElement);
window._dssBindScene('cl-wrap', scene, renderer, camera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(scene, camera, renderer, { bokeh: true, focus: 6, aperture: 0.0005, maxblur: 0.005, bloomStrength: 0.55, bloomThreshold: 0.3 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(document.getElementById('cl-wrap'));

// ============================================================
// MATERIALS
// ============================================================
var concreteMat = new THREE.MeshStandardMaterial({ color: 0x5a5850, roughness: 0.95 });
var concreteFloor = new THREE.MeshStandardMaterial({ color: 0x3a3835, roughness: 0.95 });
var concreteDark = new THREE.MeshStandardMaterial({ color: 0x484540, roughness: 0.9 });
var ceilTex = makeCanvasTexture(256, 256, function(cx, w, h) {
cx.fillStyle = '#443b33'; cx.fillRect(0, 0, w, h);
for (var ci = 0; ci < 10; ci++) {
var ccx = Math.random() * w, ccy = Math.random() * h, ccr = 22 + Math.random() * 58;
var cg = cx.createRadialGradient(ccx, ccy, 0, ccx, ccy, ccr);
cg.addColorStop(0, 'rgba(20,16,12,' + (0.2 + Math.random() * 0.22).toFixed(2) + ')');
cg.addColorStop(1, 'rgba(20,16,12,0)');
cx.fillStyle = cg; cx.fillRect(ccx - ccr, ccy - ccr, ccr * 2, ccr * 2);
}
// Water-stain rings
for (var wr = 0; wr < 4; wr++) {
var wrx = Math.random() * w, wry = Math.random() * h, wrr = 12 + Math.random() * 26;
cx.strokeStyle = 'rgba(60,48,32,' + (0.25 + Math.random() * 0.2).toFixed(2) + ')';
cx.lineWidth = 1.5; cx.beginPath(); cx.arc(wrx, wry, wrr, 0, Math.PI * 2); cx.stroke();
cx.fillStyle = 'rgba(52,42,30,0.12)'; cx.beginPath(); cx.arc(wrx, wry, wrr, 0, Math.PI * 2); cx.fill();
}
});
ceilTex.wrapS = ceilTex.wrapT = THREE.RepeatWrapping; ceilTex.repeat.set(3, 3);
var ceilingMat = new THREE.MeshStandardMaterial({ map: ceilTex, roughness: 0.9 });
var woodBeam = new THREE.MeshStandardMaterial({ color: 0x6a4a2a, roughness: 0.85 });
var darkWood = new THREE.MeshStandardMaterial({ color: 0x3a2515, roughness: 0.8 });
var pipeMat = new THREE.MeshStandardMaterial({ color: 0x555550, roughness: 0.6, metalness: 0.3 });
var ironMat = new THREE.MeshStandardMaterial({ color: 0x2a2a28, roughness: 0.7, metalness: 0.4 });
var wireMat = new THREE.MeshStandardMaterial({ color: 0x888878, roughness: 0.7 });
var bulbGlass = new THREE.MeshStandardMaterial({
color: 0xeeeee8, roughness: 0.2, emissive: 0xccbbaa, emissiveIntensity: 0.55,
transparent: true, opacity: 0.9
});
var silhouetteMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 0.9 });
var tableMat = new THREE.MeshStandardMaterial({ color: 0x2a2018, roughness: 0.85 });

// ============================================================
// HELPERS
// ============================================================
function box(group, w, h, d, mat, x, y, z) {
var geo = new THREE.BoxGeometry(w, h, d);
var m = new THREE.Mesh(geo, mat);
m.position.set(x, y, z);
m.castShadow = true;
m.receiveShadow = true;
group.add(m);
return m;
}

function cyl(group, rTop, rBot, h, segs, mat, x, y, z) {
var geo = new THREE.CylinderGeometry(rTop, rBot, h, segs);
var m = new THREE.Mesh(geo, mat);
m.position.set(x, y, z);
m.castShadow = true;
m.receiveShadow = true;
group.add(m);
return m;
}

function makeCanvasTexture(w, h, drawFunc) {
var c = document.createElement('canvas');
c.width = w; c.height = h;
var cx = c.getContext('2d');
drawFunc(cx, w, h);
var tex = new THREE.CanvasTexture(c);
tex.minFilter = THREE.LinearFilter;
return tex;
}

// ============================================================
// ROOM DIMENSIONS
// ============================================================
var roomLength = 20;
var roomWidth = 6;
var roomHeight = 2.8;
var halfW = roomWidth / 2;
var halfL = roomLength / 2;

// ============================================================
// FLOOR
// ============================================================
var floorGroup = new THREE.Group();
scene.add(floorGroup);

var floorTex = makeCanvasTexture(512, 512, function(cx, w, h) {
cx.fillStyle = '#3a3835';
cx.fillRect(0, 0, w, h);
var i;
for (i = 0; i < 200; i++) {
var px = Math.random() * w;
var py = Math.random() * h;
var shade = Math.floor(Math.random() * 20) + 45;
cx.fillStyle = 'rgba(' + shade + ',' + shade + ',' + (shade - 5) + ',0.4)';
cx.fillRect(px, py, Math.random() * 30 + 5, Math.random() * 30 + 5);
}
for (i = 0; i < 8; i++) {
cx.strokeStyle = 'rgba(30,28,25,0.5)';
cx.lineWidth = 0.5 + Math.random();
cx.beginPath();
cx.moveTo(Math.random() * w, Math.random() * h);
cx.lineTo(Math.random() * w, Math.random() * h);
cx.stroke();
}
// Cellar filth: oil and damp stains, drag marks, dirt banked at the walls
for (i = 0; i < 12; i++) {
var stx = Math.random() * w, sty = Math.random() * h, str = 14 + Math.random() * 46;
var sg = cx.createRadialGradient(stx, sty, 0, stx, sty, str);
sg.addColorStop(0, 'rgba(18,16,13,' + (0.22 + Math.random() * 0.22).toFixed(2) + ')');
sg.addColorStop(1, 'rgba(18,16,13,0)');
cx.fillStyle = sg; cx.fillRect(stx - str, sty - str, str * 2, str * 2);
}
for (i = 0; i < 6; i++) {
var dgx = Math.random() * w, dgy = Math.random() * h, dgl = 40 + Math.random() * 90, dga = Math.random() * Math.PI;
cx.strokeStyle = 'rgba(22,20,17,' + (0.18 + Math.random() * 0.15).toFixed(2) + ')';
cx.lineWidth = 3 + Math.random() * 5;
cx.beginPath(); cx.moveTo(dgx, dgy); cx.lineTo(dgx + Math.cos(dga) * dgl, dgy + Math.sin(dga) * dgl); cx.stroke();
}
var edgeG = cx.createRadialGradient(w/2, h/2, h * 0.30, w/2, h/2, h * 0.72);
edgeG.addColorStop(0, 'rgba(14,12,10,0)'); edgeG.addColorStop(1, 'rgba(14,12,10,0.4)');
cx.fillStyle = edgeG; cx.fillRect(0, 0, w, h);
});
var floorMatTex = new THREE.MeshStandardMaterial({ map: floorTex, roughness: 0.95 });
var floor = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomLength), floorMatTex);
floor.rotation.x = -Math.PI / 2;
floor.position.set(0, 0, 0);
floor.receiveShadow = true;
floorGroup.add(floor);

// ============================================================
// WALLS
// ============================================================
var wallGroup = new THREE.Group();
scene.add(wallGroup);

function makeBlockWallTex(w, h) {
return makeCanvasTexture(w, h, function(cx, cw, ch) {
cx.fillStyle = '#585550';
cx.fillRect(0, 0, cw, ch);
var blockH = 32;
var blockW = 64;
var row, col, ox;
for (row = 0; row < ch / blockH + 1; row++) {
ox = (row % 2 === 0) ? 0 : blockW / 2;
for (col = -1; col < cw / blockW + 1; col++) {
var bx = col * blockW + ox;
var by = row * blockH;
var shade = 75 + Math.floor(Math.random() * 20);
cx.fillStyle = 'rgb(' + shade + ',' + (shade - 2) + ',' + (shade - 5) + ')';
cx.fillRect(bx + 1, by + 1, blockW - 2, blockH - 2);
cx.strokeStyle = 'rgba(40,38,35,0.7)';
cx.lineWidth = 1.5;
cx.strokeRect(bx, by, blockW, blockH);
}
}
var i;
for (i = 0; i < 30; i++) {
cx.fillStyle = 'rgba(50,45,35,' + (Math.random() * 0.3) + ')';
cx.beginPath();
cx.arc(Math.random() * cw, Math.random() * ch, Math.random() * 30 + 5, 0, Math.PI * 2);
cx.fill();
}
var d;
for (d = 0; d < 6; d++) {
var dx = 40 + Math.random() * (cw - 80);
var dWidth = 3 + Math.random() * 5;
var dLen = ch * (0.4 + Math.random() * 0.6);
var grd = cx.createLinearGradient(dx, 0, dx, dLen);
grd.addColorStop(0, 'rgba(20,18,12,0.85)');
grd.addColorStop(0.3, 'rgba(25,20,14,0.7)');
grd.addColorStop(0.7, 'rgba(20,18,12,0.4)');
grd.addColorStop(1, 'rgba(20,18,12,0)');
cx.fillStyle = grd;
cx.beginPath();
cx.moveTo(dx - dWidth/2, 0);
cx.quadraticCurveTo(dx + dWidth, dLen * 0.3, dx - dWidth * 0.3, dLen * 0.6);
cx.quadraticCurveTo(dx + dWidth * 0.5, dLen * 0.85, dx, dLen);
cx.lineTo(dx + dWidth, dLen);
cx.quadraticCurveTo(dx + dWidth * 1.5, dLen * 0.85, dx + dWidth * 1.3, dLen * 0.6);
cx.quadraticCurveTo(dx - dWidth * 0.5, dLen * 0.3, dx + dWidth/2, 0);
cx.closePath();
cx.fill();
cx.fillStyle = 'rgba(80,75,65,0.2)';
cx.fillRect(dx - dWidth/2, 0, dWidth, 8);
}
});
}

var leftWallTex = makeBlockWallTex(512, 256);
var leftWallMat = new THREE.MeshStandardMaterial({ map: leftWallTex, roughness: 0.9 });
var leftWall = new THREE.Mesh(new THREE.PlaneGeometry(roomLength, roomHeight), leftWallMat);
leftWall.position.set(-halfW, roomHeight / 2, 0);
leftWall.rotation.y = Math.PI / 2;
leftWall.receiveShadow = true;
wallGroup.add(leftWall);

var rightWallTex = makeBlockWallTex(512, 256);
var rightWallMat = new THREE.MeshStandardMaterial({ map: rightWallTex, roughness: 0.9 });
var rightWall = new THREE.Mesh(new THREE.PlaneGeometry(roomLength, roomHeight), rightWallMat);
rightWall.position.set(halfW, roomHeight / 2, 0);
rightWall.rotation.y = -Math.PI / 2;
rightWall.receiveShadow = true;
wallGroup.add(rightWall);

var farWallTex = makeBlockWallTex(512, 256);
var farWallMat = new THREE.MeshStandardMaterial({ map: farWallTex, roughness: 0.9 });
var farWall = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomHeight), farWallMat);
farWall.position.set(0, roomHeight / 2, -halfL);
farWall.receiveShadow = true;
wallGroup.add(farWall);

var nearWall = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomHeight), concreteMat);
nearWall.position.set(0, roomHeight / 2, halfL);
nearWall.rotation.y = Math.PI;
nearWall.receiveShadow = true;
wallGroup.add(nearWall);

// ============================================================
// CEILING
// ============================================================
var ceilGroup = new THREE.Group();
scene.add(ceilGroup);

var ceilingTex = makeCanvasTexture(512, 256, function(cx, cw, ch) {
cx.fillStyle = '#4a4038';
cx.fillRect(0, 0, cw, ch);
var i;
for (i = 0; i < 15; i++) {
cx.fillStyle = 'rgba(60,50,35,' + (Math.random() * 0.3 + 0.1) + ')';
cx.beginPath();
cx.ellipse(Math.random() * cw, Math.random() * ch, Math.random() * 50 + 20, Math.random() * 20 + 10, 0, 0, Math.PI * 2);
cx.fill();
}
});
var ceilMatTex = new THREE.MeshStandardMaterial({ map: ceilingTex, roughness: 0.9, side: THREE.DoubleSide });
var ceiling = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomLength), ceilMatTex);
ceiling.rotation.x = Math.PI / 2;
ceiling.position.set(0, roomHeight, 0);
ceiling.receiveShadow = true;
ceilGroup.add(ceiling);

// ============================================================
// JOISTS
// ============================================================
var joistGroup = new THREE.Group();
scene.add(joistGroup);

var jz;
for (jz = -halfL + 1; jz <= halfL - 1; jz += 1.8) {
box(joistGroup, roomWidth - 0.2, 0.12, 0.08, woodBeam, 0, roomHeight - 0.06, jz);
}
box(joistGroup, 0.15, 0.2, roomLength - 0.4, woodBeam, -1.5, roomHeight - 0.1, 0);
box(joistGroup, 0.15, 0.2, roomLength - 0.4, woodBeam, 1.5, roomHeight - 0.1, 0);

// ============================================================
// SUPPORT POSTS
// ============================================================
var postGroup = new THREE.Group();
scene.add(postGroup);

box(postGroup, 0.12, roomHeight, 0.12, woodBeam, -1.2, roomHeight / 2, 2);
box(postGroup, 0.12, roomHeight, 0.12, woodBeam, 1.2, roomHeight / 2, -2);
box(postGroup, 0.12, roomHeight, 0.12, darkWood, -1.2, roomHeight / 2, -5);

// ============================================================
// PIPES
// ============================================================
var pipeGroup = new THREE.Group();
scene.add(pipeGroup);

var pipe1 = cyl(pipeGroup, 0.04, 0.04, roomLength - 2, 8, pipeMat, -halfW + 0.15, roomHeight - 0.3, 0);
pipe1.rotation.x = Math.PI / 2;

var pipe2 = cyl(pipeGroup, 0.05, 0.05, roomLength - 4, 8, pipeMat, halfW - 0.2, 1.0, -1);
pipe2.rotation.x = Math.PI / 2;

cyl(pipeGroup, 0.04, 0.04, roomHeight, 8, ironMat, halfW - 0.15, roomHeight / 2, 3);

box(pipeGroup, 0.3, 0.3, 0.5, ironMat, halfW - 0.25, roomHeight - 0.5, 1);
cyl(pipeGroup, 0.08, 0.08, 0.6, 8, ironMat, halfW - 0.15, roomHeight - 0.5, 0.3);

var cp;
for (cp = -6; cp < 7; cp += 4) {
var cpipe = cyl(pipeGroup, 0.02, 0.02, roomWidth * 0.6, 6, wireMat, 0, roomHeight - 0.15, cp);
cpipe.rotation.z = Math.PI / 2;
}

// ============================================================
// LIGHT BULB
// ============================================================
var bulbGroup = new THREE.Group();
scene.add(bulbGroup);

var wireGeo = new THREE.CylinderGeometry(0.005, 0.005, 1.0, 4);
var wire = new THREE.Mesh(wireGeo, wireMat);
wire.position.set(0, roomHeight - 0.5, 1.5);
bulbGroup.add(wire);

cyl(bulbGroup, 0.025, 0.02, 0.08, 8, ironMat, 0, roomHeight - 1.04, 1.5);

var bulbSphere = new THREE.Mesh(new THREE.SphereGeometry(0.06, 12, 8), bulbGlass);
bulbSphere.position.set(0, roomHeight - 1.12, 1.5);
bulbGroup.add(bulbSphere);

var bulbLight = new THREE.PointLight(0xccbbaa, 2.5, 25, 1.5);
bulbLight.position.set(0, roomHeight - 1.15, 1.5);
bulbLight.castShadow = true;
// ── Cellar atmosphere: cigarette-and-damp haze ──
// A faint cone of smoky light under the bulb, plus slow-drifting haze
// sprites; the air in this room should be visible.
var clShaft = new THREE.Mesh(
  new THREE.ConeGeometry(1.5, 1.9, 20, 1, true),
  new THREE.MeshBasicMaterial({ color: 0xbbaa90, transparent: true, opacity: 0.045, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide, fog: false })
);
clShaft.position.set(0, roomHeight - 1.15 - 0.95, 1.5);
scene.add(clShaft);
var clHazeTex = makeCanvasTexture(128, 128, function(cx, w, h) {
  var g = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
  g.addColorStop(0, 'rgba(160,150,130,0.30)');
  g.addColorStop(0.55, 'rgba(140,130,115,0.12)');
  g.addColorStop(1, 'rgba(120,112,100,0)');
  cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var clHaze = [];
for (var hz = 0; hz < 6; hz++) {
  var hs = new THREE.Sprite(new THREE.SpriteMaterial({ map: clHazeTex, transparent: true, opacity: 0.07 + Math.random() * 0.05, depthWrite: false }));
  hs.position.set((Math.random() - 0.5) * 7, 0.9 + Math.random() * 1.3, -1 + Math.random() * 5);
  var hscale = 4.5 + Math.random() * 4;
  hs.scale.set(hscale, hscale * 0.6, 1);
  hs.userData = { ph: Math.random() * 6.28, sp: 0.00012 + Math.random() * 0.0002 };
  scene.add(hs); clHaze.push(hs);
}
bulbLight.shadow.mapSize.set(512, 512);
bulbLight.shadow.radius = 8;
bulbLight.shadow.bias = -0.002;
scene.add(bulbLight);

var glowMat = new THREE.MeshBasicMaterial({ color: 0xccbbaa, transparent: true, opacity: 0.1 });
var glowSphere = new THREE.Mesh(new THREE.SphereGeometry(0.15, 16, 12), glowMat);
glowSphere.position.copy(bulbSphere.position);
scene.add(glowSphere);

// ============================================================
// LIGHTING
// ============================================================
var ambientLight = new THREE.AmbientLight(0x0a0810, 0.14); // was 0.08 — the figures and the chesterfield should loom, not vanish
scene.add(ambientLight);

var farFill = new THREE.PointLight(0x8090aa, 0.9, 10, 1.5);
farFill.position.set(0, 2.2, -halfL + 0.5);
scene.add(farFill);

var rimLight = new THREE.PointLight(0x506080, 0.4, 8, 2);
rimLight.position.set(0.3, 1.2, -halfL + 3.5);
scene.add(rimLight);

var floorGlow = new THREE.PointLight(0x182030, 0.2, 6, 2);
floorGlow.position.set(0, 0.05, -halfL + 4);
scene.add(floorGlow);

// ============================================================
// TABLE
// ============================================================
var tableGroup = new THREE.Group();
scene.add(tableGroup);

var tableZ = -halfL + 4.5;
var tableY = 0.7;
box(tableGroup, 1.4, 0.06, 0.7, tableMat, 0, tableY, tableZ);
box(tableGroup, 0.06, tableY, 0.06, darkWood, -0.6, tableY / 2, tableZ - 0.25);
box(tableGroup, 0.06, tableY, 0.06, darkWood, 0.6, tableY / 2, tableZ - 0.25);
box(tableGroup, 0.06, tableY, 0.06, darkWood, -0.6, tableY / 2, tableZ + 0.25);
box(tableGroup, 0.06, tableY, 0.06, darkWood, 0.6, tableY / 2, tableZ + 0.25);

// ============================================================
// FIGURES
// ============================================================
var figureGroup = new THREE.Group();
scene.add(figureGroup);

var womanGroup = new THREE.Group();
womanGroup.position.set(-0.4, 0, tableZ);
figureGroup.add(womanGroup);

var wBodyGeo = new THREE.BoxGeometry(0.26, 0.7, 0.16);
var wBody = new THREE.Mesh(wBodyGeo, silhouetteMat);
wBody.position.set(0, tableY + 0.12, 0);
wBody.castShadow = false;
womanGroup.add(wBody);

var wHeadGeo = new THREE.SphereGeometry(0.09, 12, 8);
var wHeadMesh = new THREE.Mesh(wHeadGeo, silhouetteMat);
wHeadMesh.position.set(0, tableY + 0.56, 0);
wHeadMesh.scale.set(1, 1.15, 0.95);
wHeadMesh.castShadow = false;
womanGroup.add(wHeadMesh);

var manGroup = new THREE.Group();
