keysRow.style.cssText = 'position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;';
HOTSPOTS.forEach(function(sp) {
var kb = document.createElement('button'); kb.type = 'button'; kb.textContent = roomObjectLabel(sp);
kb.addEventListener('focus', function() { if (camMode !== 'idle' || roomBlocked() || !available(sp)) return; hoverSpot = sp; haloAt(sp); halo.visible = true; var r = canvas.getBoundingClientRect(), v = halo.position.clone().project(camera); hoverName(roomObjectLabel(sp), { clientX: r.left + (v.x + 1) / 2 * r.width, clientY: r.top + (1 - v.y) / 2 * r.height }); });
