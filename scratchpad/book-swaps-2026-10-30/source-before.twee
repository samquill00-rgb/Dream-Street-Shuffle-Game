        c.quadraticCurveTo(sx0 + Math.sin(ph) * 5, 150, sx0 + Math.sin(ph + 1.2) * 8, 132 - i * 8);
        c.stroke();
      }
    }
    // The figure: solid silhouette from behind, coat on, feet planted
    var lean = Math.sin(t * 0.9) * 1.2;
    var fx = 70 + lean, fy = 40;
    if (spew) { c.save(); c.translate(fx, fy + 136); c.rotate(0.22 + (this.retching ? Math.sin(t * 7) * 0.025 : 0)); c.translate(-fx, -(fy + 136)); }
    c.fillStyle = 'rgba(28,25,20,0.95)';
    c.beginPath(); c.arc(fx + sway * 0.6, fy, 8.5, 0, Math.PI * 2); c.fill();
    c.beginPath();
    c.moveTo(fx - 6, fy + 7);
    c.quadraticCurveTo(fx - 18, fy + 14, fx - 19, fy + 30);
    c.lineTo(fx - 17, fy + 92);
    c.quadraticCurveTo(fx - 16, fy + 98, fx - 12, fy + 98);
    c.lineTo(fx + 15, fy + 98);
    c.quadraticCurveTo(fx + 19, fy + 98, fx + 20, fy + 92);
    c.lineTo(fx + 21, fy + 30);
    c.quadraticCurveTo(fx + 20, fy + 14, fx + 8, fy + 7);
    c.closePath(); c.fill();
    // Near arm angled in front (unseen hands); retching, it is braced out against the jamb
    c.strokeStyle = 'rgba(28,25,20,0.95)'; c.lineWidth = 7; c.lineCap = 'round';
    c.beginPath();
    c.moveTo(fx + 16, fy + 22);
    if (spew) c.quadraticCurveTo(fx + 34, fy + 18, fx + 50, fy + 8); else c.quadraticCurveTo(fx + 27, fy + 42, fx + 18, fy + 62);
    c.stroke();
    // Legs
    c.lineWidth = 8;
    c.beginPath(); c.moveTo(fx - 8, fy + 96); c.lineTo(fx - 11, fy + 134); c.stroke();
    c.beginPath(); c.moveTo(fx + 10, fy + 96); c.lineTo(fx + 14, fy + 134); c.stroke();
    c.fillStyle = 'rgba(28,25,20,0.95)';
    c.beginPath(); c.ellipse(fx - 12, fy + 136, 6.5, 3, 0, 0, Math.PI * 2); c.fill();
    c.beginPath(); c.ellipse(fx + 15, fy + 136, 6.5, 3, 0, 0, Math.PI * 2); c.fill();
    // Lamp-side rim light
    c.strokeStyle = 'rgba(200,180,132,0.18)'; c.lineWidth = 1.3;
    c.beginPath();
    c.moveTo(fx - 7, fy - 7);
    c.quadraticCurveTo(fx - 13, fy - 2, fx - 14, fy + 6);
    c.moveTo(fx - 19, fy + 16);
    c.lineTo(fx - 17, fy + 92);
    c.stroke();
    if (spew) {
      c.restore();
      /* what comes up: a thick, broken fall from the mouth to the step */
      if (this.retching && wl > 0) {
        var va = Math.min(1, 0.55 + wl * 0.5), cx1 = 114 + Math.sin(t * 6) * 3;
        c.lineCap = 'round';
        c.strokeStyle = 'rgba(112,98,44,' + (va * 0.45).toFixed(2) + ')'; c.lineWidth = 2.2;
        c.beginPath(); c.moveTo(103, 54); c.quadraticCurveTo(cx1, 110, 99, 166); c.stroke();
        /* chunks falling down that curve: broken, murky, not a clean stream */
        for (var vk = 0; vk < 16; vk++) {
          var vu = ((vk / 16) + t * 1.7) % 1, vm = 1 - vu;
          var vx = vm * vm * 103 + 2 * vm * vu * cx1 + vu * vu * 99, vy = vm * vm * 54 + 2 * vm * vu * 110 + vu * vu * 166;
          var vr = 1.6 + (Math.sin(t * 13 + vk * 2.3) + 1) * 1.1 + vu * 0.8;
          c.fillStyle = (vk % 3 === 0) ? 'rgba(138,118,52,' + va.toFixed(2) + ')' : 'rgba(118,104,46,' + (va * 0.9).toFixed(2) + ')';
          c.beginPath(); c.arc(vx + Math.sin(t * 11 + vk) * 1.6, vy, vr, 0, Math.PI * 2); c.fill();
        }
      }
    }
    // The stream, past his side to the door foot
    if (this.retching && wl > 0 && !spew) {
      var pa = Math.min(1, 0.5 + wl * 0.6);
      c.lineCap = 'round';
      c.strokeStyle = 'rgba(186,156,54,' + pa.toFixed(2) + ')';
      c.lineWidth = 2.8 + Math.sin(t * 3) * 0.6;
      c.beginPath();
      c.moveTo(fx + 22, fy + 66);
      c.quadraticCurveTo(fx + 40 + Math.sin(t * 4) * 4, fy + 96, 104, 164);
      c.stroke();
      c.strokeStyle = 'rgba(214,192,88,' + (pa * 0.55).toFixed(2) + ')';
      c.lineWidth = 1.3;
      c.beginPath();
      c.moveTo(fx + 21, fy + 68);
      c.quadraticCurveTo(fx + 37 + Math.sin(t * 4) * 3, fy + 98, 101, 165);
      c.stroke();
    }
  }
  // Splatter particles (shared)
  for (i = 0; i < this.particles.length; i++) {
    p = this.particles[i];
    c.globalAlpha = p.life * 0.7;
    c.fillStyle = p.col;
    c.beginPath(); c.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2); c.fill();
  }
  c.globalAlpha = 1;
}
};
window.showSpewPopup = function(mode) { new window.SpewPopup(mode); };
// Safe variant: defers the gen snapshot by one task (see showDrinkPopupSafe for
// the race rationale) and cancels if the player navigates away — e.g. hits the
// browser Back button — before the delay fires, so the overlay can never spawn
// on top of a passage the player has already rewound to.
window.showSpewPopupSafe = function(mode, delay) {
  setTimeout(function() {
    var gen = window._passageGen; // snapshot after MO has fired for this passage
    setTimeout(function go() {
      if (window._passageGen !== gen) return; // navigated away — cancel
      if (window.dssDeferIfBusy && window.dssDeferIfBusy(go)) return; /* 2026-10-24: waits behind a lore card, gate flash or another hold instead of opening over it */
      if (window.showSpewPopup) window.showSpewPopup(mode);
    }, delay !== undefined ? delay : 50);
  }, 0);
};

// ====== EAT POPUP (hold-to-eat animation for the Chinese Fish and Chips) ======
window.EatPopup = class EatPopup {
constructor(foodType, onDone) {
  this.type = foodType || 'chips';
  this.onDone = (typeof onDone === 'function') ? onDone : null;
  this.done = false;
  this.closing = false;
  this.eating = false;
  this.hasEaten = false;
  this.t = 0;
  this.eaten = 0;
  this.wobbleDecay = 0;
  this.steam = [];
  this._build();
  for (var i = 0; i < 5; i++) this.steam.push(this._newSteam(true));
  this._startLoop();
}
_newSteam(scatter) {
  return {
    x: 52 + Math.random() * 56,
    y: scatter ? (20 + Math.random() * 50) : (55 + Math.random() * 20),
    speed: 14 + Math.random() * 14,
    life: scatter ? Math.random() : (0.1 + Math.random() * 0.3),
    size: 2.5 + Math.random() * 3.5,
    drift: 0.7 + Math.random() * 1.3,
    phase: Math.random() * Math.PI * 2
  };
}
_build() {
  this.overlay = document.createElement('div');
  this.overlay.id = 'eat-overlay';
  this.overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:99999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0);transition:background 0.5s;';
  document.body.appendChild(this.overlay);
  // Cancel-on-navigate: this overlay lives on document.body, not inside the
  // tw-passage, so Harlowe's undo (the browser Back button) would otherwise
  // strand it on top of whatever passage the player rewinds to — the
  // "stuck in the chippy" trap. Watch for tw-passage replacement and tear the
  // overlay down at once. (Same guard the astral modal uses.)
  this._navObs = null;
  var _eoStory = document.querySelector('tw-story');
  if (_eoStory) {
    var _eoPassage = _eoStory.querySelector('tw-passage');
    var _eoSelf = this;
    this._navObs = new MutationObserver(function() {
      if (_eoStory.querySelector('tw-passage') !== _eoPassage) _eoSelf._teardownNow();
    });
    this._navObs.observe(_eoStory, { childList: true, subtree: true });
  }
  this.card = document.createElement('div');
  this.card.style.cssText = [
    'display:flex;flex-direction:column;align-items:center;',
    'padding:0 0 20px;',
    'background:rgba(14,9,4,0.97);',
    'border:1px solid rgba(200,168,106,0.35);',
    'border-top:2px solid rgba(200,168,106,0.65);',
    'border-radius:10px;',
    'opacity:0;transform:translateY(18px);',
    'transition:opacity 0.45s,transform 0.45s;',
    'min-width:180px;',
  ].join('');
  this.overlay.appendChild(this.card);
  this.nameLabel = document.createElement('div');
  this.nameLabel.style.cssText = [
    'width:100%;box-sizing:border-box;',
    'padding:12px 28px 10px;text-align:center;',
    'font:small-caps 600 13px Cinzel,Georgia,serif;',
    'letter-spacing:0.12em;color:rgba(200,168,106,0.85);',
    'border-bottom:1px solid rgba(200,168,106,0.15);',
  ].join('');
  this.nameLabel.textContent = 'Fish & Chips';
  this.card.appendChild(this.nameLabel);
  var canvasWrap = document.createElement('div');
  canvasWrap.style.cssText = 'padding:18px 28px 0;';
  this.card.appendChild(canvasWrap);
  this.canvas = document.createElement('canvas');
  this.canvas.width = 160;
  this.canvas.height = 200;
  this.canvas.style.cssText = 'cursor:pointer;display:block;';
  this.ctx = this.canvas.getContext('2d');
  canvasWrap.appendChild(this.canvas);
  this.prompt = document.createElement('div');
  this.prompt.style.cssText = 'margin-top:10px;font:italic 13px Georgia,serif;color:rgba(212,165,116,0.75);letter-spacing:0.04em;';
  this.prompt.textContent = 'Hold to eat';
  this.card.appendChild(this.prompt);
  var self = this;
  setTimeout(function() {
    self.overlay.style.background = 'rgba(0,0,0,0.6)';
    self.card.style.opacity = '1';
    self.card.style.transform = 'translateY(0)';
  }, 30);
  var startEat = function(e) {
    e.preventDefault();
    if (self.closing || self.done || self.eaten >= 0.95) return;
    self.eating = true;
    self.hasEaten = true;
    self.wobbleDecay = 0.5;
    self.prompt.textContent = '';
  };
  var stopEat = function(e) {
    e.preventDefault();
    if (!self.eating) return;
    self.eating = false;
    if (self.hasEaten && self.eaten >= 0.5 && !self.closing) {
      self.closing = true;
      setTimeout(function() { self._fadeOut(); }, 800);
    }
  };
  this.canvas.addEventListener('mousedown', startEat);
  this.canvas.addEventListener('mouseup', stopEat);
  this.canvas.addEventListener('mouseleave', stopEat);
  this.canvas.addEventListener('touchstart', startEat);
  this.canvas.addEventListener('touchend', stopEat);
  this.canvas.addEventListener('touchcancel', stopEat);
}
_fadeOut() {
  if (this._navObs) { this._navObs.disconnect(); this._navObs = null; }
  this.overlay.style.background = 'rgba(0,0,0,0)';
  this.card.style.opacity = '0';
  this.card.style.transform = 'translateY(-12px)';
  var self = this;
  setTimeout(function() {
    self.done = true;
    if (self.overlay.parentNode) self.overlay.parentNode.removeChild(self.overlay);
    if (self.onDone) { var cb = self.onDone; self.onDone = null; try { cb(); } catch(e) {} }
  }, 480);
}
// Immediate teardown when the player navigates away (e.g. browser Back) while
// the overlay is open — no fade, just stop the loop, drop the observer, and
// remove the overlay so it can't sit stranded over the rewound-to passage.
_teardownNow() {
  if (this.done) return;
  this.done = true;
  this.closing = true;
  if (this._navObs) { this._navObs.disconnect(); this._navObs = null; }
  if (this.overlay && this.overlay.parentNode) this.overlay.parentNode.removeChild(this.overlay);
}
_startLoop() {
  var self = this;
  var lt = performance.now();
  function loop() {
    if (self.done) return;
    var now = performance.now();
    var dt = Math.min(now - lt, 50) * 0.001;
    lt = now;
    self.t += dt;
    if (self.eating) {
      var rate = 0.28 * Math.min(1.0, (1.0 - self.eaten) * 3.5);
      self.eaten = Math.min(1, self.eaten + rate * dt);
      if (self.eaten >= 0.95 && !self.closing) {
        self.eating = false;
        self.closing = true;
        setTimeout(function() { self._fadeOut(); }, 600);
      }
    }
    // Steam particles
    self.steam.forEach(function(s) {
      s.y -= s.speed * dt;
      s.x += Math.sin(self.t * s.drift + s.phase) * 9 * dt;
      s.life -= dt * 0.38;
      if (s.life <= 0) { Object.assign(s, self._newSteam(false)); }
    });
    if (self.wobbleDecay > 0.01) self.wobbleDecay *= (1 - 2 * dt);
    self._draw();
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
}
_draw() {
  var c = this.ctx, W = 160, H = 200, t = this.t;
  c.clearRect(0, 0, W, H);
  var eaten = this.eaten;
  // Warm amber glow under the cone
  var grd = c.createRadialGradient(W / 2, 152, 0, W / 2, 152, 70);
  grd.addColorStop(0, 'rgba(210,158,38,0.24)');
  grd.addColorStop(1, 'rgba(0,0,0,0)');
  c.fillStyle = grd; c.fillRect(0, 0, W, H);

  c.save();
  c.translate(W / 2, 132);

  // ── ROLLED NEWSPAPER CONE — narrow twisted point at the bottom,
  //    wide flared opening at the top, paper rolled into a cornet. ──

  // Soft shadow under the point
  c.fillStyle = 'rgba(0,0,0,0.28)';
  c.beginPath();
  c.ellipse(2, 36, 16, 4, 0, 0, Math.PI * 2);
  c.fill();

  // Outer paper cone — greaseproof / off-white newsprint
  var paperGrad = c.createLinearGradient(0, -52, 0, 36);
  paperGrad.addColorStop(0, '#f0e8d2');
  paperGrad.addColorStop(0.55, '#dccfa8');
  paperGrad.addColorStop(0.85, '#b8a878');
  paperGrad.addColorStop(1, '#8c7c52');
  c.fillStyle = paperGrad;
  c.beginPath();
  // Top edge — crinkled rim, slightly flared open
  c.moveTo(-50, -50);
  c.quadraticCurveTo(-44, -54, -32, -50);
  c.quadraticCurveTo(-18, -56, -4, -52);
  c.quadraticCurveTo(10, -56, 24, -50);
  c.quadraticCurveTo(38, -54, 50, -48);
  // Right side — tapering down to twisted point
  c.quadraticCurveTo(46, -28, 34, -8);
  c.quadraticCurveTo(22, 14, 10, 30);
  c.quadraticCurveTo(6, 36, 2, 38);
  // Twisted point at the bottom
  c.quadraticCurveTo(0, 40, -2, 38);
  c.quadraticCurveTo(-6, 36, -10, 30);
  // Left side — back up
  c.quadraticCurveTo(-22, 14, -34, -8);
  c.quadraticCurveTo(-46, -28, -50, -50);
  c.closePath();
  c.fill();
  c.strokeStyle = 'rgba(95,78,42,0.55)';
  c.lineWidth = 1.0;
  c.stroke();

  // ── Newsprint texture (clipped to the cone) ──
  c.save();
  c.beginPath();
  c.moveTo(-50, -50);
  c.quadraticCurveTo(-44, -54, -32, -50);
  c.quadraticCurveTo(-18, -56, -4, -52);
  c.quadraticCurveTo(10, -56, 24, -50);
  c.quadraticCurveTo(38, -54, 50, -48);
  c.quadraticCurveTo(46, -28, 34, -8);
  c.quadraticCurveTo(22, 14, 10, 30);
  c.quadraticCurveTo(6, 36, 2, 38);
  c.quadraticCurveTo(0, 40, -2, 38);
  c.quadraticCurveTo(-6, 36, -10, 30);
  c.quadraticCurveTo(-22, 14, -34, -8);
  c.quadraticCurveTo(-46, -28, -50, -50);
  c.closePath();
  c.clip();

  // Body-text dashes in two suggested columns — purely abstract, no readable text
  c.fillStyle = 'rgba(40,30,18,0.38)';
  var rows = [
    [-22, -44], [-22, -40], [-22, -36], [-22, -32], [-22, -28], [-22, -24],
    [-22, -20], [-22, -16], [-22, -12], [-22,  -8], [-22,  -4], [-22,   0],
    [-22,   4], [-22,   8], [-22,  12],
    [  4, -44], [  4, -40], [  4, -36], [  4, -32], [  4, -28], [  4, -24],
    [  4, -20], [  4, -16], [  4, -12], [  4,  -8], [  4,  -4], [  4,   0],
    [  4,   4], [  4,   8], [  4,  12]
  ];
  for (var ri = 0; ri < rows.length; ri++) {
    var rx = rows[ri][0], ry = rows[ri][1];
    // Lines narrow as we go down (taper into the cone)
    var taper = Math.max(0.25, 1 - (ry + 50) / 100);
    var lenA = (4 + (Math.sin(ri * 1.7) * 1.5 + 3)) * taper;
    var gap = 2 * taper;
    var lenB = (3 + (Math.cos(ri * 1.3) * 1.2 + 2.5)) * taper;
    c.fillRect(rx, ry, lenA, 0.55);
    c.fillRect(rx + lenA + gap, ry, lenB, 0.55);
  }
  // Small dark photo-ish patch (abstract, no recognizable content)
  c.fillStyle = 'rgba(60,46,28,0.4)';
  c.fillRect(-16, -48, 12, 5);
  c.fillStyle = 'rgba(40,30,18,0.5)';
  for (var dy = 0; dy < 5; dy += 1) {
    for (var dx = 0; dx < 12; dx += 1.6) {
      if ((dx + dy) % 2 < 1) c.fillRect(-16 + dx, -48 + dy, 0.55, 0.55);
    }
  }

  // Diagonal seam — where the paper has been rolled (overlap line)
  c.strokeStyle = 'rgba(95,72,40,0.45)';
  c.lineWidth = 0.7;
  c.beginPath();
  c.moveTo(10, -50);
  c.quadraticCurveTo(6, -20, 2, 18);
  c.stroke();

  // Shadowed crease running down the back of the cone (interior dimness)
  c.strokeStyle = 'rgba(60,42,18,0.35)';
  c.lineWidth = 0.8;
  c.beginPath();
  c.moveTo(-16, -52);
  c.quadraticCurveTo(-8, -16, -2, 30);
  c.stroke();

  // Grease translucency — darker patches where the paper has soaked through
  c.fillStyle = 'rgba(140,98,52,0.22)';
  c.beginPath(); c.ellipse(-18, 6, 8, 12, -0.3, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.ellipse(14, 10, 6, 10, 0.4, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.ellipse(-4, 22, 5, 7, 0, 0, Math.PI * 2); c.fill();

  c.restore(); // end clip

  // Paper-fold highlights along the rolled edges
  c.strokeStyle = 'rgba(255,245,210,0.55)';
  c.lineWidth = 0.7;
  c.beginPath(); c.moveTo(-46, -46); c.quadraticCurveTo(-30, -18, -10, 28); c.stroke();
  c.beginPath(); c.moveTo(46, -44); c.quadraticCurveTo(30, -18, 8, 28); c.stroke();

  // ── Dark interior at the cone opening (so the contents read as "inside" the cone) ──
  c.fillStyle = 'rgba(35,22,10,0.55)';
  c.beginPath();
  c.ellipse(0, -48, 46, 6, 0, 0, Math.PI * 2);
  c.fill();

  // (Fish is drawn AFTER chips, below, so it sits on top of the pile.)

  // ── CHIPS — a dense handful clustered at and above the cone opening.
  //    All chips sit at or above the rim (y ≥ -75, y ≤ -48). Paper is
  //    opaque — nothing should be visible "through" the cone wall.
  //    Array is ordered BOTTOM-OF-PILE first → drawn behind. Eating order
  //    is computed from y so the topmost (highest) chips disappear first. ──
  var chipDefs = [
    // ── Bottom row, sitting in the cone opening ──
    { x: -38, y: -48, w:  9, h: 5, a:  0.34, hi: 0.50 },
    { x: -27, y: -48, w: 18, h: 6, a:  0.06, hi: 0.55 },
    { x: -10, y: -48, w: 11, h: 6, a: -0.10, hi: 0.55 },
    { x:   3, y: -48, w: 16, h: 6, a:  0.04, hi: 0.55 },
    { x:  17, y: -48, w: 13, h: 6, a: -0.18, hi: 0.55 },
    { x:  29, y: -48, w:  8, h: 5, a: -0.36, hi: 0.50 },
    // ── Mid stack ──
    { x: -31, y: -54, w: 11, h: 6, a:  0.18, hi: 0.55 },
    { x: -19, y: -55, w: 19, h: 6, a: -0.06, hi: 0.55 },
    { x:  -4, y: -56, w: 13, h: 6, a:  0.10, hi: 0.55 },
    { x:   9, y: -55, w: 17, h: 6, a: -0.14, hi: 0.55 },
    { x:  22, y: -54, w: 10, h: 6, a:  0.22, hi: 0.55 },
    // ── Upper pile ──
    { x: -22, y: -62, w: 16, h: 6, a:  0.04, hi: 0.55 },
    { x:  -9, y: -63, w: 11, h: 6, a: -0.10, hi: 0.55 },
    { x:   5, y: -62, w: 17, h: 6, a:  0.16, hi: 0.55 },
    { x:  19, y: -60, w:  9, h: 5, a: -0.22, hi: 0.55 },
    // ── Top crown — chips poking up highest ──
    { x: -14, y: -69, w: 18, h: 6, a: -0.18, hi: 0.60 },
    { x:   1, y: -71, w: 10, h: 6, a:  0.06, hi: 0.60 },
    { x:  11, y: -68, w: 15, h: 6, a:  0.24, hi: 0.60 },
    { x:  -3, y: -73, w: 14, h: 5, a:  0.14, hi: 0.65 },
  ];
  var vis = 1 - eaten;
  for (var ci = 0; ci < chipDefs.length; ci++) {
    var ch = chipDefs[ci];
    // Eating order from y — higher in the pile (more negative y) = eaten first.
    // Range maps y from -77 (top) → frac=1, to y=-48 (rim) → frac=0.
    var frac = Math.max(0, Math.min(1, (-ch.y - 48) / 29));
    var ca = Math.min(1, Math.max(0, (vis - frac + 0.18) / 0.14));
    if (ca <= 0) continue;
    c.save();
    c.translate(ch.x + ch.w / 2, ch.y + ch.h / 2);
    c.rotate(ch.a);
    c.globalAlpha = ca;
    // Chip body — golden gradient
    var chipGrad = c.createLinearGradient(0, -ch.h/2, 0, ch.h/2);
    chipGrad.addColorStop(0, '#e8b048');
    chipGrad.addColorStop(0.5, '#c88820');
    chipGrad.addColorStop(1, '#8a5808');
    c.fillStyle = chipGrad;
    c.beginPath();
    c.moveTo(-ch.w/2, -ch.h/2 + 1);
    c.lineTo(-ch.w/2 + 1, -ch.h/2);
    c.lineTo(ch.w/2 - 1, -ch.h/2);
    c.lineTo(ch.w/2, -ch.h/2 + 1);
    c.lineTo(ch.w/2, ch.h/2 - 1);
    c.lineTo(ch.w/2 - 1, ch.h/2);
    c.lineTo(-ch.w/2 + 1, ch.h/2);
    c.lineTo(-ch.w/2, ch.h/2 - 1);
    c.closePath();
    c.fill();
    // Top-edge highlight
    c.fillStyle = 'rgba(255,225,150,' + ch.hi + ')';
    c.fillRect(-ch.w/2 + 1.5, -ch.h/2 + 0.5, ch.w - 3, 1.2);
    // Darker browned edges (where chip met fryer)
    c.fillStyle = 'rgba(90,46,8,0.55)';
    c.fillRect(-ch.w/2, ch.h/2 - 1.2, ch.w, 1.2);
    // Tiny grease shine
    c.fillStyle = 'rgba(255,250,220,0.35)';
    c.fillRect(-ch.w/2 + 2, -ch.h/2 + 1.8, ch.w * 0.3, 0.8);
    c.restore();
  }
  c.globalAlpha = 1;

  // ── FISH — battered piece sitting on top of the chip pile. Long and
  //    tapered: wide rounded "head" on the left, narrowing to a thinner
  //    "tail" end on the right (less oval, more like a real fillet). ──
  if (eaten < 0.85) {
    var fa = Math.max(0, 1 - eaten * 1.6);
    c.globalAlpha = fa;
    var fishGrad = c.createRadialGradient(-10, -61, 2, -4, -59, 32);
    fishGrad.addColorStop(0, '#f0bb50');
    fishGrad.addColorStop(0.55, '#cc8420');
    fishGrad.addColorStop(1, '#8a4e08');
    c.fillStyle = fishGrad;
    c.beginPath();
    // Wide rounded head end (left)
    c.moveTo(-28, -55);
    c.quadraticCurveTo(-34, -63, -28, -69);
    c.quadraticCurveTo(-20, -73, -8, -71);
    // Top edge going right, tapering down
    c.quadraticCurveTo(8, -70, 22, -65);
    c.quadraticCurveTo(32, -62, 34, -59);
    // Narrow tail end
    c.quadraticCurveTo(34, -56, 30, -55);
    // Bottom edge returning left
    c.quadraticCurveTo(18, -54, 4, -53);
    c.quadraticCurveTo(-12, -52, -22, -53);
    c.quadraticCurveTo(-30, -53, -28, -55);
    c.closePath();
    c.fill();
    // Crispy darker spots (batter blisters) — denser at the head end
    c.fillStyle = 'rgba(90,52,12,0.55)';
    c.beginPath(); c.ellipse(-20, -65, 2.6, 1.6, 0.3, 0, Math.PI*2); c.fill();
    c.beginPath(); c.ellipse(-10, -68, 2.2, 1.4, -0.2, 0, Math.PI*2); c.fill();
    c.beginPath(); c.ellipse( -4, -61, 1.8, 1.2, 0.5, 0, Math.PI*2); c.fill();
    c.beginPath(); c.ellipse( 10, -63, 1.8, 1.1, 0.0, 0, Math.PI*2); c.fill();
    c.beginPath(); c.ellipse( 22, -61, 1.4, 0.9, -0.2, 0, Math.PI*2); c.fill();
    // Lighter batter ridges — follow the taper
    c.strokeStyle = 'rgba(255,225,150,0.6)';
    c.lineWidth = 0.7;
    c.beginPath(); c.moveTo(-24, -69); c.quadraticCurveTo(-6, -71, 18, -66); c.stroke();
    c.beginPath(); c.moveTo(-22, -57); c.quadraticCurveTo(0, -59, 26, -58); c.stroke();
    // Tiny salt grains
    c.fillStyle = 'rgba(255,255,250,0.85)';
    c.beginPath(); c.arc(-15, -66, 0.5, 0, Math.PI*2); c.fill();
    c.beginPath(); c.arc(  0, -65, 0.45, 0, Math.PI*2); c.fill();
    c.beginPath(); c.arc( 14, -62, 0.45, 0, Math.PI*2); c.fill();
    c.beginPath(); c.arc( 26, -60, 0.4, 0, Math.PI*2); c.fill();
    c.globalAlpha = 1;
  }

  c.restore();

  // ── Steam particles drifting up from the opening ──
  this.steam.forEach(function(s) {
    var sa = s.life > 0.5 ? 0.26 : s.life * 0.5;
    if (sa <= 0) return;
    c.globalAlpha = sa * (1 - eaten * 0.65);
    c.fillStyle = 'rgba(220,210,200,0.85)';
    c.beginPath(); c.arc(s.x, s.y, s.size, 0, Math.PI * 2); c.fill();
  });
  c.globalAlpha = 1;
}
};
window.showEatPopup = function(foodType, onDone) { new window.EatPopup(foodType || 'chips', onDone); };
// Safe variant: defers the gen snapshot by one task (see showDrinkPopupSafe for
// the race rationale) and cancels if the player navigates away — e.g. hits the
// browser Back button — before the delay fires, so the overlay can never spawn
// on top of a passage the player has already rewound to.
window.showEatPopupSafe = function(foodType, delay) {
  setTimeout(function() {
    var gen = window._passageGen; // snapshot after MO has fired for this passage
    setTimeout(function go() {
      if (window._passageGen !== gen) return; // navigated away — cancel
      if (window.dssDeferIfBusy && window.dssDeferIfBusy(go)) return; /* 2026-10-24: waits behind a lore card, gate flash or another hold instead of opening over it */
      if (window.showEatPopup) window.showEatPopup(foodType || 'chips');
    }, delay !== undefined ? delay : 50);
  }, 0);
};

// ====== LIVER POPUP (guide the eagle to Prometheus's liver) ======
// The player steers an eagle from the top-left toward Shelley's liver on a
// rock in the bottom-right. Mouse/touch position drives the eagle with easing.
// When it reaches the liver, the eagle tilts down, the liver shrinks, and the
// popup fades. Draws on Prometheus Unbound — the eagle, the crag, the pulse.
window.LiverPopup = class LiverPopup {
constructor() {
  this.done = false;
  this.closing = false;
  this.eating = false;
  this.eatProgress = 0;
  this.liverSize = 1.0;
  this.t = 0;
  // Eagle state
  this.eagleX = 25; this.eagleY = 25;
  this.eagleTargetX = 25; this.eagleTargetY = 25;
  this.eagleTilt = 0;
  this.hasMoved = false;
  // Cloud drift (set in _initClouds after canvas sized)
  this.clouds = [];
  // Liver target position (bottom-right of canvas)
  this.liverX = 172; this.liverY = 128;
  this._build();
  this._initClouds();
  this._startLoop();
}
_initClouds() {
  for (var i = 0; i < 5; i++) {
    this.clouds.push({
      x: Math.random() * 200,
      y: 18 + Math.random() * 75,
      vx: 3 + Math.random() * 5,
      size: 16 + Math.random() * 14,
      alpha: 0.06 + Math.random() * 0.10
    });
  }
}
_build() {
  this.overlay = document.createElement('div');
  this.overlay.id = 'liver-eat-overlay';   // watched by the popup serializer (dssOverlayBusy)
  // z-index 999999 keeps the eagle popup ABOVE the notebook dialog (and its
  // close button at 100000), so it can be invoked from inside the notebook
  // as a popup-within-popup. Matches the napkin popup pattern.
  this.overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:999999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0);transition:background 0.5s;';
  document.body.appendChild(this.overlay);
  // Cancel-on-navigate: this overlay lives on document.body, not inside the
  // tw-passage, so Harlowe's undo (the browser Back button) would otherwise
  // strand it on top of whatever passage the player rewinds to. Watch for
  // tw-passage replacement and tear the overlay down at once. (Same guard the
  // eat popup and astral modal use.)
  this._navObs = null;
  var _loStory = document.querySelector('tw-story');
  if (_loStory) {
    var _loPassage = _loStory.querySelector('tw-passage');
    var _loSelf = this;
    this._navObs = new MutationObserver(function() {
      if (_loStory.querySelector('tw-passage') !== _loPassage) _loSelf._teardownNow();
    });
    this._navObs.observe(_loStory, { childList: true, subtree: true });
  }
  this.card = document.createElement('div');
  this.card.style.cssText = [
    'position:relative;',
    'display:flex;flex-direction:column;align-items:center;',
    'padding:10px 10px 16px;',
    'background:radial-gradient(ellipse at center, rgba(30,18,10,0.98) 0%, rgba(10,6,3,0.99) 100%);',
    'border:1px solid rgba(200,168,106,0.6);',
    'border-radius:3px;',
    'box-shadow:',
    '  0 0 0 1px rgba(50,34,18,0.9),',
    '  0 0 0 5px rgba(200,168,106,0.14),',
    '  0 0 0 6px rgba(50,34,18,0.85),',
    '  0 12px 42px rgba(0,0,0,0.75),',
    '  inset 0 0 40px rgba(0,0,0,0.55),',
    '  inset 0 0 0 1px rgba(200,168,106,0.22);',
    'opacity:0;transform:translateY(18px);',
    'transition:opacity 0.6s,transform 0.6s;',
    'min-width:200px;',
  ].join('');
  this.overlay.appendChild(this.card);
  // Gold filigree corner ornaments — antiquarian reliquary vibe
  var cornerSVG = '<svg viewBox="0 0 32 32" width="30" height="30" xmlns="http://www.w3.org/2000/svg">' +
    '<path d="M4 4 L16 4 M4 4 L4 16" stroke="rgba(210,175,110,0.75)" stroke-width="0.9" fill="none" stroke-linecap="round"/>' +
    '<path d="M4 4 Q12 4, 14 8 Q16 12, 12 14 Q7 16, 4 12" fill="none" stroke="rgba(200,168,106,0.55)" stroke-width="0.7"/>' +
    '<path d="M4 4 Q8 6, 10 10" fill="none" stroke="rgba(220,185,120,0.4)" stroke-width="0.5"/>' +
    '<circle cx="7" cy="7" r="1.4" fill="none" stroke="rgba(220,185,120,0.8)" stroke-width="0.45"/>' +
    '<circle cx="7" cy="7" r="0.55" fill="rgba(235,205,140,0.9)"/>' +
    '</svg>';
  var cornerPositions = [
    'top:2px;left:2px;',
    'top:2px;right:2px;transform:scaleX(-1);',
    'bottom:2px;left:2px;transform:scaleY(-1);',
    'bottom:2px;right:2px;transform:scale(-1,-1);'
  ];
  var _card = this.card;
  cornerPositions.forEach(function(pos) {
    var d = document.createElement('div');
    d.style.cssText = 'position:absolute;pointer-events:none;z-index:2;opacity:0.9;' + pos;
    d.innerHTML = cornerSVG;
    _card.appendChild(d);
  });
  var canvasWrap = document.createElement('div');
  canvasWrap.style.cssText = 'padding:14px 14px;';
  this.card.appendChild(canvasWrap);
  this.canvas = document.createElement('canvas');
  this.canvas.width = 200;
  this.canvas.height = 160;
  this.canvas.style.cssText = 'cursor:crosshair;display:block;';
  this.ctx = this.canvas.getContext('2d');
  canvasWrap.appendChild(this.canvas);
  // Gold caps quote — flashes up when the eagle finishes feeding.
  this.quote = document.createElement('div');
  this.quote.style.cssText = [
    'font-family:"Playfair Display",Georgia,serif;',
    'color:#f5d070;',
    'font-size:11px;',
    'letter-spacing:0.18em;',
    'text-align:center;',
    'padding:2px 16px 6px;',
    'text-transform:uppercase;',
    'opacity:0;',
    'transition:opacity 0.7s ease;',
    'text-shadow:0 0 8px rgba(245,208,112,0.55),0 0 16px rgba(245,208,112,0.25),0 0 2px rgba(8,6,4,0.95);',
    'max-width:220px;',
    'line-height:1.55;'
  ].join('');
  this.quote.textContent = 'There is no part of me that is not of the Gods.';
  this.card.appendChild(this.quote);
  // Intentionally no label and no prompt — the myth speaks for itself.
  this.prompt = { textContent: '' };
  var self = this;
  setTimeout(function() {
    self.overlay.style.background = 'rgba(0,0,0,0.6)';
    self.card.style.opacity = '1';
    self.card.style.transform = 'translateY(0)';
  }, 30);
  var handleMove = function(e) {
    if (self.closing || self.done || self.eating) return;
    var rect = self.canvas.getBoundingClientRect();
    var cx, cy;
    if (e.touches && e.touches.length) {
      cx = e.touches[0].clientX; cy = e.touches[0].clientY;
    } else {
      cx = e.clientX; cy = e.clientY;
    }
    self.eagleTargetX = Math.max(8, Math.min(192, cx - rect.left));
    self.eagleTargetY = Math.max(8, Math.min(152, cy - rect.top));
    if (!self.hasMoved) {
      self.hasMoved = true;
      self.prompt.textContent = '';
    }
    // Bright-chord sparkle on movement. Throttled by time + distance so
    // mousemove storms turn into an evolving chord rather than a buzz.
    var nowT = performance.now();
    if (self._lastChordT === undefined) {
      self._lastChordT = 0;
      self._lastChordX = self.eagleTargetX;
      self._lastChordY = self.eagleTargetY;
    }
    var cdx = self.eagleTargetX - self._lastChordX;
    var cdy = self.eagleTargetY - self._lastChordY;
    if (nowT - self._lastChordT > 170 && (cdx * cdx + cdy * cdy) > 100) {
      self._lastChordT = nowT;
      self._lastChordX = self.eagleTargetX;
      self._lastChordY = self.eagleTargetY;
      if (window.dssAudio && window.dssAudio.brightChord) window.dssAudio.brightChord();
    }
  };
  this.canvas.addEventListener('mousemove', handleMove);
  this.canvas.addEventListener('mousedown', handleMove);
  this.canvas.addEventListener('touchstart', function(e) { e.preventDefault(); handleMove(e); });
  this.canvas.addEventListener('touchmove', function(e) { e.preventDefault(); handleMove(e); });
}
_fadeOut() {
  if (this._navObs) { this._navObs.disconnect(); this._navObs = null; }
  this.overlay.style.background = 'rgba(0,0,0,0)';
  this.card.style.opacity = '0';
  this.card.style.transform = 'translateY(-12px)';
  var self = this;
  setTimeout(function() {
    self.done = true;
    if (self.overlay.parentNode) self.overlay.parentNode.removeChild(self.overlay);
    window.dispatchEvent(new CustomEvent('liverpopup:closed'));
  }, 480);
}
// Immediate teardown when the player navigates away (e.g. browser Back) while
// the overlay is open — no fade, just stop the loop, drop the observer, and
// remove the overlay so it can't sit stranded over the rewound-to passage.
// Deliberately does NOT dispatch 'liverpopup:closed': backing out is not the
// same as finishing the liver, so it must not trigger the completion go-to.
_teardownNow() {
  if (this.done) return;
  this.done = true;
  this.closing = true;
  if (this._navObs) { this._navObs.disconnect(); this._navObs = null; }
  if (this.overlay && this.overlay.parentNode) this.overlay.parentNode.removeChild(this.overlay);
}
_startLoop() {
  var self = this;
  var lt = performance.now();
  function loop() {
    if (self.done) return;
    var now = performance.now();
    var dt = Math.min(now - lt, 50) * 0.001;
    lt = now;
    self.t += dt;
    // Eagle eases toward target position
    var prevX = self.eagleX;
    self.eagleX += (self.eagleTargetX - self.eagleX) * 3.2 * dt;
    self.eagleY += (self.eagleTargetY - self.eagleY) * 3.2 * dt;
    // Tilt follows horizontal velocity
    var vx = self.eagleX - prevX;
    self.eagleTilt += (vx * 0.04 - self.eagleTilt) * 5 * dt;
    // Check for arrival at liver
    if (!self.eating && !self.closing) {
      var dx = self.eagleX - self.liverX, dy = self.eagleY - self.liverY;
      if (Math.sqrt(dx * dx + dy * dy) < 20) {
        self.eating = true;
        self.eatProgress = 0;
      }
    }
    // Eating progression
    if (self.eating) {
      self.eatProgress = Math.min(1, self.eatProgress + 1.4 * dt);
      self.liverSize = Math.max(0, 1 - self.eatProgress);
      // Eagle head bobs toward liver while eating
      self.eagleTargetX = self.liverX;
      self.eagleTargetY = self.liverY - 4;
      if (self.eatProgress >= 1 && !self.closing) {
        self.closing = true;
        if (self.quote) self.quote.style.opacity = '1';
        setTimeout(function() { self._fadeOut(); }, 2500);
      }
    }
    // Drift clouds
    self.clouds.forEach(function(cl) {
      cl.x += cl.vx * dt;
      if (cl.x > 230) { cl.x = -30; cl.y = 18 + Math.random() * 75; }
    });
    self._draw();
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
}
_draw() {
  var c = this.ctx, W = 200, H = 160, t = this.t;
  // Stormy sky
  var sky = c.createLinearGradient(0, 0, 0, H);
  sky.addColorStop(0, '#282636');
  sky.addColorStop(0.55, '#423748');
  sky.addColorStop(1, '#362d3a');
  c.fillStyle = sky;
  c.fillRect(0, 0, W, H);
  // Clouds
  for (var i = 0; i < this.clouds.length; i++) {
    var cl = this.clouds[i];
    c.fillStyle = 'rgba(205,200,215,' + cl.alpha.toFixed(2) + ')';
    c.beginPath();
    c.ellipse(cl.x, cl.y, cl.size, cl.size * 0.38, 0, 0, Math.PI * 2);
    c.fill();
  }
  // Distant crag hint (far background)
  c.fillStyle = 'rgba(50,48,58,0.55)';
  c.beginPath();
  c.moveTo(0, 160); c.lineTo(0, 135);
  c.lineTo(28, 125); c.lineTo(50, 130); c.lineTo(72, 125); c.lineTo(90, 132);
  c.lineTo(90, 160); c.closePath(); c.fill();
  // The main rock / crag (bottom-right, where Prometheus is bound)
  c.fillStyle = '#3a3840';
  c.beginPath();
  c.moveTo(118, 160);
  c.lineTo(126, 142);
  c.lineTo(138, 130);
  c.lineTo(152, 122);
  c.lineTo(168, 118);
  c.lineTo(182, 122);
  c.lineTo(195, 135);
  c.lineTo(200, 152);
  c.lineTo(200, 160);
  c.closePath();
  c.fill();
  // Rock highlights (moonlight catches the edges)
  c.fillStyle = 'rgba(100,92,105,0.5)';
  c.beginPath();
  c.moveTo(152, 124); c.lineTo(168, 120); c.lineTo(178, 126); c.lineTo(164, 134); c.closePath();
  c.fill();
  c.fillStyle = 'rgba(70,65,75,0.7)';
  c.beginPath();
  c.moveTo(128, 143); c.lineTo(140, 134); c.lineTo(144, 145); c.lineTo(132, 152); c.closePath();
  c.fill();
  // Chain (going off-frame right, suggesting Prometheus bound)
  c.strokeStyle = 'rgba(130,110,90,0.65)';
  c.lineWidth = 1.3;
  for (var k = 0; k < 5; k++) {
    var kx = 186 + k * 3, ky = 130 + Math.sin(k * 1.1) * 1.2;
    c.beginPath();
    c.ellipse(kx, ky, 1.6, 1, k * 0.3, 0, Math.PI * 2);
    c.stroke();
  }
  // Wrist silhouette, bound (small, just visible at rock edge)
  c.fillStyle = 'rgba(65,50,38,0.88)';
  c.beginPath();
  c.ellipse(184, 132, 5, 3, 0.3, 0, Math.PI * 2);
  c.fill();
  // The liver — pulsing red on the rock
  if (this.liverSize > 0.04) {
    var lv = this.liverSize;
    var pulse = 1 + Math.sin(t * 2.4) * 0.10 * lv;
    // Ambient glow
    var lg = c.createRadialGradient(this.liverX, this.liverY, 0, this.liverX, this.liverY, 18 * pulse * lv);
    lg.addColorStop(0, 'rgba(120,30,38,0.42)');
    lg.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = lg;
    c.fillRect(this.liverX - 25, this.liverY - 25, 50, 50);
    // Liver body
    c.fillStyle = '#6a1820';
    c.beginPath();
    c.ellipse(this.liverX, this.liverY, 9 * pulse * lv, 6 * pulse * lv, 0.2, 0, Math.PI * 2);
    c.fill();
    // Highlight
    c.fillStyle = '#8a2e34';
    c.beginPath();
    c.ellipse(this.liverX - 2, this.liverY - 1.5, 3.2 * lv, 1.8 * lv, 0.2, 0, Math.PI * 2);
    c.fill();
    // Darker lobe suggestion
    c.fillStyle = 'rgba(60,10,18,0.5)';
    c.beginPath();
    c.ellipse(this.liverX + 3, this.liverY + 1.5, 3 * lv, 1.5 * lv, 0.3, 0, Math.PI * 2);
    c.fill();
  }
  // Blood flecks during eating
  if (this.eating && this.eatProgress < 0.85) {
    var flecks = 4;
    for (var f = 0; f < flecks; f++) {
      var fa = Math.max(0, (0.4 - this.eatProgress * 0.35)) * (0.7 + Math.sin(t * 8 + f) * 0.3);
      c.fillStyle = 'rgba(120,28,32,' + fa.toFixed(2) + ')';
      c.beginPath();
      c.arc(this.liverX + (f - 1.5) * 4, this.liverY - 6 - this.eatProgress * 8 + Math.sin(t * 11 + f * 2) * 2, 1.3, 0, Math.PI * 2);
      c.fill();
    }
  }
  // The eagle/harpy — silhouette with flapping wings
  if (!this.eating || this.eatProgress < 0.75) {
    var ex = this.eagleX, ey = this.eagleY;
    var flap = Math.sin(t * 13);
    var wingSpan = 14 + flap * 5;
    var wingRise = -5 - flap * 5;
    c.save();
    c.translate(ex, ey);
    c.rotate(this.eagleTilt);
    // Body
    c.fillStyle = '#16101a';
    c.beginPath();
    c.ellipse(0, 0, 4.5, 2.2, 0, 0, Math.PI * 2);
    c.fill();
    // Tail feathers
    c.beginPath();
    c.moveTo(-4, 0); c.lineTo(-8, -1.5); c.lineTo(-8, 1.5); c.closePath();
    c.fill();
    // Head (tilts down when eating)
    var headY = this.eating ? 2.5 : 0;
    var headX = this.eating ? 3 : 3.5;
    c.beginPath();
    c.ellipse(headX, headY, 2.3, 1.8, 0, 0, Math.PI * 2);
    c.fill();
    // Beak (hooked)
    c.fillStyle = '#2e1c14';
    c.beginPath();
    c.moveTo(headX + 1.8, headY);
    c.lineTo(headX + 4.5, headY + (this.eating ? 1.5 : 0.8));
    c.lineTo(headX + 2, headY + 1.2);
    c.closePath();
    c.fill();
    // Wings — curved, flapping
    c.strokeStyle = '#16101a';
    c.lineWidth = 2.8;
    c.lineCap = 'round';
    c.lineJoin = 'round';
    // Left wing
    c.beginPath();
    c.moveTo(-2, -0.5);
    c.quadraticCurveTo(-wingSpan * 0.5, wingRise, -wingSpan - 2, wingRise - 1);
    c.stroke();
    // Right wing
    c.beginPath();
    c.moveTo(2, -0.5);
    c.quadraticCurveTo(wingSpan * 0.5, wingRise, wingSpan + 2, wingRise - 1);
    c.stroke();
    // Feather tips
    c.lineWidth = 1.2;
    c.strokeStyle = 'rgba(40,28,42,0.85)';
    c.beginPath();
    c.moveTo(-wingSpan * 0.55, wingRise * 0.55);
    c.lineTo(-wingSpan - 2, wingRise - 1);
    c.stroke();
    c.beginPath();
    c.moveTo(wingSpan * 0.55, wingRise * 0.55);
    c.lineTo(wingSpan + 2, wingRise - 1);
    c.stroke();
    c.restore();
  }
}
};
window.showLiverPopup = function() { new window.LiverPopup(); };

// ====== HEAL EXIT LINK HANDLER ======
// Fires the stat heal animation then navigates via a hidden Harlowe link.
// Used in recovery passages because <script> inside (link:) hooks isn't reliable.
document.addEventListener('click', function(e) {
  if (!e.target || !e.target.classList || !e.target.classList.contains('heal-exit-link')) return;
  var el = e.target;
  var gains = { confidence: 0, sobriety: 0 };
  var valsId = el.getAttribute('data-vals');
  if (valsId) {
    var valsEl = document.getElementById(valsId);
    if (valsEl) {
      var p = valsEl.textContent.split(',');
      gains.confidence = parseInt(p[0]) || 0;
      gains.sobriety   = parseInt(p[1]) || 0;
    }
  } else {
    gains.confidence = parseInt(el.getAttribute('data-conf')) || 0;
    gains.sobriety   = parseInt(el.getAttribute('data-sobr')) || 0;
  }
  if (window.showHealAnimation) window.showHealAnimation(gains);
  var navEl = document.getElementById(el.getAttribute('data-nav') || '');
  var twLink = navEl && navEl.querySelector('tw-link');
  if (twLink) twLink.click();
});

/* ===== FIGHT MINIGAME ENGINE ===== */
window.FightGame = class FightGame {
constructor(canvasId, sobriety) {
this.canvas = document.getElementById(canvasId);
this.ctx = this.canvas.getContext('2d');
this.W = this.canvas.width;
this.H = this.canvas.height;
this.sobriety = sobriety;

this.round = 0;
// Composure model: you and Copper each carry a bar (0–100). Every REAL
// exchange deals/takes damage by magnitude rather than a flat win/lose. You
// win by emptying his bar (a knockout — the new "perfect") or by being ahead
// when the bell rings after REAL_EXCHANGES exchanges; you go down if your own
// bar empties or you trail at the bell. Practice exchanges are not scored.
this.REAL_EXCHANGES = 4; // 2026-10-16 (a tester, Sam: "goes on too long to be fun"): four real exchanges (were six), the three practice rounds kept because COPPER says "Three rounds to find your feet", shorter pauses
this.playerHP = 100;
this.copperHP = 100;
this.playerHPShown = 100;   // eased display values, for a smooth bar drain
this.copperHPShown = 100;
this.rounds = [];           // legacy; no longer scored
this.gameOver = false;
this.phase = 'idle';
this.phaseTimer = 0;
this.punchType = '';
this.resultText = '';
this.resultClass = '';
this.narrativeText = '';
this.clickable = false;
this.acted = false;
this.copperHit = false;
this.cleanChain = 0;

this.copperBaseX = this.W / 2;
this.copperBaseY = 80;
this.telegraphT = 0;
this.punchT = 0;
this.resultFlash = 0;
this.hoveredZone = '';

// Impact feel: camera kick on hits taken, slow "damage ghost" trails on the
// bars, and the knockout fall.
this.shakeStart = 0;
this.shakeMag = 0;
this.playerHPGhost = 100;
this.copperHPGhost = 100;
this.playerBarFlash = 0;
this.copperBarFlash = 0;
this.ko = false;
this.koStart = 0;
this._loopUntil = 0;

// Tightened from 2000ms — the player has less time to read the
// telegraph and pick a side. Tuned with the per-round difficulty
// scaling below so round 3 lands inside ~1100ms.
this.EZ = window.dssEase ? window.dssEase.level('fight') : 0; /* 2026-10-28 (dssEase): lost fights make the next slower to read and softer to take */
this.baseTelegraphDuration = 1150 + this.EZ * 150; // 2026-10-16 (Sam: "make the whole thing happen more speedily"): was 1550
this.telegraphDuration = this.baseTelegraphDuration;

this.roundPunches = ['right_cross', 'left_hook', 'uppercut', 'right_cross', 'left_hook', 'uppercut', 'left_hook', 'right_cross', 'uppercut'];

this.practiceIntros = [
"Watch his RIGHT glove glow. The punch will swing ACROSS and land on your left. Dodge to the SAME side as the glowing glove (right).",
"Now his LEFT glove glows. The punch swings across to land on your right. Dodge to the SAME side as the glove (left).",
"This time he crouches. The glove drops low for an uppercut. Dodge either side."
];

this.realIntros = [
"COPPER feints left. You clock it; he clocks you clocking it. The right cross comes.",
"COPPER works behind the jab until he steps in: a straight right to your nose.",
"You both breathe heavy as sports. An uppercut emits straight from his stomach."
];

this.practiceNarr = [
{ clean: "Good. You read it.", block: "Blocked it. Safe, but dodging scores more.", caught: "He pulls the punch. Click the SAME side as the glowing glove next time." },
{ clean: "Quick feet. You’ve got it.", block: "Covered up. Try dodging for more points.", caught: "Wrong side. Click the SAME side as the glowing glove — it shows where the punch is coming FROM." },
{ clean: "Sidestepped it clean.", block: "Absorbed it. Either side works for an uppercut.", caught: "Too slow. Step sideways when he crouches." }
];

this.realDodgeNarr = [
{ clean: "You slip under it so as to suggest a vacuum.",
block: "You shell up and take a hit, with the general grace of the crayfish.",
caught: "You give ground and feel the wall behind you. No room. A hook finds your shoulder." },
{ clean: "Your neck rolls. His knuckles are pinking your cheek.",
block: "You parry at the wrist. A jab goes wide.",
caught: "'Careful, clever cunt,' says COPPER." },
{ clean: "You swerve it and he stumbles.",
block: "You smother him on the inside. The uppercut dies on your shoulder.",
caught: "His experienced punch,\nTakes you to lunch,\nAnd hey, nonnie, nonie!" }
];

this.practiceCounterNarr = [
{ success: "You swing and COPPER leans back. He grins.", fail: "COPPER catches your wrist. 'Timing,' he says." },
{ success: "COPPER nods. 'Not bad.'", fail: "He swats your hand away. 'Watch the glove first.'" },
{ success: "You step inside. COPPER grunts approval.", fail: "He rides it. 'Patience.'" }
];

this.realCounterNarr = [
{ success: "You let the right come. Your own left hook finds the unclaimed territory of his diaphragm.",
fail: "You swing — COPPER saw it coming a street away." },
{ success: "You step inside his reach and land one clean to the ribs.",
fail: "'Careful, clever cunt,' says COPPER." },
{ success: "Your forehead to his nose, which powders like a shingle under its force.",
fail: "His experienced punch,\nTakes you to lunch,\nAnd hey, nonnie, nonie!" }
];

this.setupInput();
this.startRound();
this.loop();
}

isPractice() { return this.round < 3; }
realRoundIndex() { return this.round - 3; }

setupInput() {
this.canvas.addEventListener('mousemove', (e) => {
if (!this.clickable) { this.hoveredZone = ''; return; }
var rect = this.canvas.getBoundingClientRect();
var mx = (e.clientX - rect.left) * (this.W / rect.width);
var my = (e.clientY - rect.top) * (this.H / rect.height);
this.hoveredZone = this.getZone(mx, my);
this.canvas.style.cursor = this.hoveredZone ? 'pointer' : 'crosshair';
});

this.canvas.addEventListener('click', (e) => {
if (!this.clickable || this.acted) return;
var rect = this.canvas.getBoundingClientRect();
var mx = (e.clientX - rect.left) * (this.W / rect.width);
var my = (e.clientY - rect.top) * (this.H / rect.height);
var zone = this.getZone(mx, my);
if (zone) this.handleAction(zone);
});

// Touch: act on touchstart so taps land without the synthetic-click delay —
// the reaction windows are tight enough that tap latency decides exchanges.
// preventDefault (passive:false) suppresses the duplicate click that follows.
this.canvas.addEventListener('touchstart', (e) => {
if (!this.clickable || this.acted) return;
var touch = e.changedTouches && e.changedTouches[0];
if (!touch) return;
var rect = this.canvas.getBoundingClientRect();
var mx = (touch.clientX - rect.left) * (this.W / rect.width);
var my = (touch.clientY - rect.top) * (this.H / rect.height);
var zone = this.getZone(mx, my);
if (zone) { e.preventDefault(); this.handleAction(zone); }
}, { passive: false });

// Keyboard: arrows dodge/counter, down or space blocks. Document-level (the
// canvas never takes focus); removed at endGame and self-removing once the
// canvas has left the DOM, so it can't leak across passages.
this._keyHandler = (e) => {
if (!this.canvas.isConnected) { document.removeEventListener('keydown', this._keyHandler); return; }
if (!this.clickable || this.acted || this.gameOver) return;
var zone = null;
if (e.key === 'ArrowLeft') zone = 'dodge_left';
else if (e.key === 'ArrowRight') zone = 'dodge_right';
else if (e.key === 'ArrowDown' || e.key === ' ') zone = 'block';
else if (e.key === 'ArrowUp') zone = 'counter';
if (zone) { e.preventDefault(); this.handleAction(zone); }
};
document.addEventListener('keydown', this._keyHandler);
}

getZone(mx, my) {
if (mx < 130 && my > 120 && my < 350) return 'dodge_left';
if (mx > this.W - 130 && my > 120 && my < 350) return 'dodge_right';
if (mx > 150 && mx < this.W - 150 && my > 330) return 'block';
if (mx > 210 && mx < this.W - 210 && my > 80 && my < 280) return 'counter';
return '';
}

startRound() {
this.phase = 'intro';
this.phaseTimer = Date.now();
this.telegraphT = 0;
this.punchT = 0;
this.resultFlash = 0;
this.clickable = false;
this.acted = false;
this.copperHit = false;
this.hoveredZone = '';

if (this.isPractice()) {
// Practice rounds stay slow — they're the teaching moments.
this.telegraphDuration = 1800; // practice swings, were 3200
} else {
// Real exchanges quicken as the fight wears on (a gentle curve now there are
// six of them), and sobriety still shaves milliseconds off your reaction.
var roundSpeed = 1 - (this.realRoundIndex() * 0.07);
var sobPenalty = (100 - this.sobriety) * 4;
this.telegraphDuration = Math.max(650 + this.EZ * 90, Math.round(this.baseTelegraphDuration * roundSpeed - sobPenalty * (1 - this.EZ * 0.25)));
}

this.updateRoundDisplay();
var introDelay = this.isPractice() ? 1400 : (this.realRoundIndex() === 0 ? 1000 : 600);

setTimeout(() => {
if (this.gameOver) return;
this.phase = 'telegraph';
this.phaseTimer = Date.now();
this.punchType = this.roundPunches[this.round];
this.clickable = true;
if (!this.isPractice()) this.clearNarrative();
}, introDelay);
}

getCorrectDodge() {
if (this.punchType === 'right_cross') return 'dodge_right';
if (this.punchType === 'left_hook') return 'dodge_left';
if (this.punchType === 'uppercut') return 'either';
return 'dodge_left';
}

handleAction(zone) {
this.acted = true;
this.clickable = false;
var practice = this.isPractice();

// impactSound fires at the end of the punching animation, when the result
// lands. Composure damage is applied immediately below via applyDamage().
var impactSound = null;
// Composure damage for this exchange: dmgYou is what you take, dmgHim what
// Copper takes. `t` is how far the telegraph had run when you committed (0–1)
// — timing decides clean vs. graze, and whether a counter lands or trades.
var dmgYou = 0, dmgHim = 0;
var t = this.telegraphT;

if (zone === 'counter') {
// Counter is a timing commit now, not a coin-flip: swing as he commits
// (mid-to-late telegraph) and you land it clean for the big damage that can
// drop him; mistime it and you both land, but he gets the better of it.
var inWindow = (t >= 0.50 && t <= 0.82);
if (inWindow) {
this.resultText = '★ COUNTER ★';
this.resultClass = 'win';
this.copperHit = true;
impactSound = 'counter_win';
dmgHim = 26;
} else {
this.resultText = 'TRADE';
this.resultClass = 'lose';
impactSound = 'punchImpact';
dmgHim = 10;
dmgYou = 16;
}
} else if (zone === 'block') {
// Safe: soaks a small chip and lands nothing back.
this.resultText = 'ABSORBED';
this.resultClass = 'neutral';
impactSound = 'muffledThud';
dmgYou = 5;
} else {
var correct = this.getCorrectDodge();
var isCorrect = (zone === correct) || (correct === 'either');
if (isCorrect && t <= 0.80) {
// Clean slip — and you tag him on the way out.
this.resultText = 'CLEAN';
this.resultClass = 'win';
this.copperHit = true;
impactSound = 'counter_win';
dmgHim = 14;
} else if (isCorrect) {
// Right read but late — you slip most of it and still get clipped.
this.resultText = 'GRAZE';
this.resultClass = 'neutral';
impactSound = 'muffledThud';
dmgYou = 7;
} else {
// Wrong side — full in the face.
this.resultText = 'CAUGHT';
this.resultClass = 'lose';
impactSound = 'punchImpact';
dmgYou = 20;
}
}
if (!practice) this.applyDamage(dmgYou, dmgHim);
if (this.resultClass === 'win') this.cleanChain++; else if (this.resultClass === 'lose') this.cleanChain = 0;
this._impactSound = impactSound;

this.phase = 'punching';
this.phaseTimer = Date.now();

setTimeout(() => {
this.phase = 'result';
this.phaseTimer = Date.now();
this.resultFlash = 1;
this.showResult(this.resultText, this.resultClass);
// Camera kick — scaled to what just landed on YOU; his hits shake the room.
var kick = this.resultText === 'CAUGHT' ? 7 : this.resultText === 'TRADE' ? 5
         : this.resultText === 'GRAZE' ? 2.5 : this.resultText === 'ABSORBED' ? 2 : 0;
if (kick && !practice) { this.shakeStart = Date.now(); this.shakeMag = kick; }
// in-round narrative stripped
// Impact sound — fires when the punch lands or whiffs past
if (window.dssAudio) {
  if (this._impactSound === 'counter_win') {
    window.dssAudio.dodgeWhoosh();
    setTimeout(function(){ if (window.dssAudio) window.dssAudio.punchImpact(); }, 180);
  } else if (this._impactSound && window.dssAudio[this._impactSound]) {
    window.dssAudio[this._impactSound]();
  }
}

setTimeout(() => {
if (practice && this.round === 2) {
this.showNarrative("Practice over. This time it’s real.");
setTimeout(() => { this.round = 3; this.startRound(); }, 1800);
} else if (!practice && (this.playerHP <= 0 || this.copperHP <= 0 || this.round >= 2 + this.REAL_EXCHANGES)) {
this.endGame();
} else {
this.round++;
this.startRound();
}
}, 800);
}, 350);
}

timeOut() {
this.acted = true;
this.clickable = false;
var practice = this.isPractice();

this.resultText = 'CAUGHT';
this.resultClass = 'lose';
// Froze — you ate it flat-footed.
if (!practice) this.applyDamage(18, 0);

this.phase = 'punching';
this.phaseTimer = Date.now();

setTimeout(() => {
this.phase = 'result';
this.phaseTimer = Date.now();
this.resultFlash = 1;
this.showResult(this.resultText, this.resultClass);
if (!practice) { this.shakeStart = Date.now(); this.shakeMag = 7; }
// Timeout = caught flat-footed — punch lands
if (window.dssAudio) window.dssAudio.punchImpact();

setTimeout(() => {
if (practice && this.round === 2) {
this.showNarrative("Practice over. This time it’s real.");
setTimeout(() => { this.round = 3; this.startRound(); }, 1800);
} else if (!practice && (this.playerHP <= 0 || this.copperHP <= 0 || this.round >= 2 + this.REAL_EXCHANGES)) {
this.endGame();
} else {
this.round++;
this.startRound();
}
}, 800);
}, 350);
}

endGame() {
if (this.gameOver) return; // guard against double-call (round + timeOut paths)
this.gameOver = true;
// Verdict from the composure bars: a knockout (his bar emptied) is the
// emphatic win; otherwise you're standing only if you finished ahead. Your
// own bar at zero, or trailing at the bell, and you go down.
var ko = this.copperHP <= 0;
var youDown = this.playerHP <= 0;
var won = ko || (!youDown && this.copperHP < this.playerHP);
var perfect = ko;
window._lastFightScore = perfect ? 2 : (won ? 1 : 0);
this.ko = ko;
if (this._keyHandler) document.removeEventListener('keydown', this._keyHandler);
if (ko) {
// The knockout plays out on canvas: Copper goes over (drawCopper's fall
// transform), loop() runs on past gameOver to animate it, the body lands
// with a thud, and the label waits for him to hit the boards.
this.koStart = Date.now();
this._loopUntil = Date.now() + 6000;
if (window.dssAudio) setTimeout(function(){ if (window.dssAudio) window.dssAudio.muffledThud(); }, 650);
}
var endEl = document.getElementById('fight-end');
var inst = document.getElementById('fight-instructions');
if (inst) inst.style.display = 'none';

if (won) {
var label = perfect ? '🤜 KNOCKOUT 🤜' : '🤜 STANDING 🤜';
var showEnd = () => {
endEl.innerHTML = '<span style="color:#f0dca0;text-shadow:0 0 15px rgba(232,196,110,0.6);">' + label + '</span>';
this.showNarrative("‘It’s alright,’ says COPPER, ‘Alright. Tell whoever sent you that I know that they sent you.’");
};
if (ko) setTimeout(showEnd, 600); else showEnd();
} else {
endEl.innerHTML = '<span style="color:#d8a090;text-shadow:0 0 10px rgba(200,110,90,0.4);">🤜 DOWN 🤜</span>';
}

// On loss, auto-advance after a one-second beat — no narrative, no button.
// The cellar light dies with you: _downDim drives a darkness wash in draw(),
// and the loop runs on briefly so the dim can animate before navigation.
if (!won) {
this._downDim = Date.now();
this._loopUntil = Date.now() + 1300;
var goDown = function() {
var targetPassage = 'Fight Defeat';
var wrap = document.getElementById('go-fight-defeat');
var link = wrap && wrap.querySelector('tw-link');
if (link) {
  try { link.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window })); return; }
  catch(e) { try { link.click(); return; } catch(e2) {} }
}
var anyLink = document.querySelector('tw-link[passage-name="' + targetPassage + '"]');
if (anyLink) {
  try { anyLink.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window })); return; }
  catch(e) {}
}
var storyEl = document.querySelector('tw-story') || document.body;
var injected = document.createElement('tw-link');
injected.setAttribute('passage-name', targetPassage);
injected.style.display = 'none';
storyEl.appendChild(injected);
injected.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
setTimeout(function(){ if (injected.parentNode) injected.parentNode.removeChild(injected); }, 50);
};
/* 2026-10-28 (Sam: "Easier each retry"): a lost fight offers TRY AGAIN (a gentler fight) or MOVE ON (going down, as before) */
if (window.dssEase) {
window.dssEase.lost('fight');
var cvF = this.canvas || document.getElementById('fight-canvas');
setTimeout(function() {
if (!cvF || !cvF.isConnected) { goDown(); return; }
window.dssEase.offer(cvF.parentElement, { onAgain: function() { endEl.innerHTML = ''; if (inst) inst.style.display = ''; window.startFightGame(); }, onMove: goDown });
}, 1000);
return;
}
setTimeout(goDown, 1000);
return;
}

setTimeout(function() {
// Guard against double-fire (round + timeOut paths can both call endGame).
var existing = document.getElementById('fight-continue-btn');
if (existing && existing.parentNode) existing.parentNode.removeChild(existing);
var btn = document.createElement('button');
btn.id = 'fight-continue-btn';
btn.className = 'fight-continue-btn';
btn.textContent = won ? 'Get out' : 'Take the count';
var targetPassage = won ? (perfect ? 'Fight Victory Perfect' : 'Fight Victory') : 'Fight Defeat';
var wrapId = won ? (perfect ? 'go-fight-victory-perfect' : 'go-fight-victory') : 'go-fight-defeat';
btn.onclick = function() {
// Strategy 1: click the real Harlowe-processed tw-link inside the hidden
// wrapper. This is the same pattern used by heal-exit links and the bar
// canvas. Dispatch a real bubbling MouseEvent — some Harlowe builds bind
// click via document-level delegation, so we need bubbles: true.
var wrap = document.getElementById(wrapId);
var link = wrap && wrap.querySelector('tw-link');
if (link) {
  try {
    link.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
    return;
  } catch(e) { try { link.click(); return; } catch(e2) {} }
}
// Strategy 2: search the whole document for a tw-link to this passage
// (covers the case where the hidden wrapper got destroyed somehow).
var anyLink = document.querySelector('tw-link[passage-name="' + targetPassage + '"]');
if (anyLink) {
  try {
    anyLink.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
    return;
  } catch(e) {}
}
// Strategy 3: inject a fresh tw-link and click it.
var storyEl = document.querySelector('tw-story') || document.body;
var injected = document.createElement('tw-link');
injected.setAttribute('passage-name', targetPassage);
injected.style.display = 'none';
storyEl.appendChild(injected);
injected.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
setTimeout(function(){ if (injected.parentNode) injected.parentNode.removeChild(injected); }, 50);
};
endEl.appendChild(document.createElement('br'));
endEl.appendChild(btn);
}, 2000);
}

updateRoundDisplay() { this._renderBoard(null, null); }

// Single source of truth for the scoreboard, used by both the round-start
// refresh (updateRoundDisplay) and the result flash (showResult). callText is
// the centre call-line ('CLEAN' etc.) shown only when a result has landed.
_renderBoard(callText, callClass) {
var el = document.getElementById('round-display');
if (!el) return;
var label, key;
if (this.isPractice()) {
label = 'PRACTICE &middot; ROUND&nbsp;' + (this.round + 1) + '&nbsp;OF&nbsp;3'; // 2026-10-14: no lone 3 on a phone
key = 'PRACTICE &mdash; NOT SCORED';
} else {
label = 'EXCHANGE&nbsp;' + Math.min(this.realRoundIndex() + 1, this.REAL_EXCHANGES) + '&nbsp;OF&nbsp;' + this.REAL_EXCHANGES;
    key = this.gameOver ? '' : 'PUT HIM DOWN &middot; OR LEAD AT THE BELL' + (this.cleanChain > 1 ? ' &middot; CLEAN CHAIN ' + this.cleanChain : '');
}
var col = callClass === 'win' ? '#f0dca0' : callClass === 'lose' ? '#d8a090' : '#eeddaa';
var callHTML = callText ? '<div class="fight-board-call" style="color:' + col + ';">' + callText + '</div>' : '';
el.innerHTML =
  '<div class="fight-board">' +
    '<div class="fight-board-label">' + label + '</div>' +
    callHTML +
    '<div class="fight-board-key">' + key + '</div>' +
  '</div>';
}

showNarrative(text) {
var el = document.getElementById('fight-narrative');
if (el) { el.style.opacity = '1'; el.textContent = text; }
}

clearNarrative() {
var el = document.getElementById('fight-narrative');
if (el) el.style.opacity = '0';
}

showResult(text, cls) { this._renderBoard(text, cls); }

draw() {
var ctx = this.ctx;
var W = this.W, H = this.H;

// Camera kick — decays over ~340ms after an impact lands. The background
// fill is oversized so the shaken frame never shows bare canvas at the edges.
var sx = 0, sy = 0;
if (this.shakeStart) {
var st = (Date.now() - this.shakeStart) / 340;
if (st < 1) {
var mag = this.shakeMag * (1 - st);
sx = (Math.random() * 2 - 1) * mag;
sy = (Math.random() * 2 - 1) * mag;
} else { this.shakeStart = 0; }
}
ctx.save();
if (sx || sy) ctx.translate(sx, sy);

ctx.fillStyle = '#0e0808';
ctx.fillRect(-10, -10, W + 20, H + 20);

ctx.strokeStyle = '#1e1212';
ctx.lineWidth = 0.5;
for (var row = 0; row < H; row += 30) {
ctx.beginPath(); ctx.moveTo(0, row); ctx.lineTo(W, row); ctx.stroke();
var off = (Math.floor(row / 30) % 2) * 35;
for (var col = off; col < W; col += 70) {
ctx.beginPath(); ctx.moveTo(col, row); ctx.lineTo(col, row + 30); ctx.stroke();
}
}

// ---- The cellar itself ----
var envT = Date.now() / 1000;
// Damp stains soaking through the brick (fixed positions)
var stains = [[W * 0.16, H * 0.3, 60], [W * 0.85, H * 0.5, 75], [W * 0.55, H * 0.12, 48]];
for (var sn = 0; sn < stains.length; sn++) {
var sg = ctx.createRadialGradient(stains[sn][0], stains[sn][1], 4, stains[sn][0], stains[sn][1], stains[sn][2]);
sg.addColorStop(0, 'rgba(0,0,0,0.28)');
sg.addColorStop(1, 'rgba(0,0,0,0)');
ctx.fillStyle = sg;
ctx.fillRect(0, 0, W, H);
}
// Floor: a darker band with a skirting line — the Copper stands on ground
ctx.fillStyle = 'rgba(4,2,2,0.55)';
ctx.fillRect(-10, H - 46, W + 20, 56);
ctx.strokeStyle = 'rgba(60,40,30,0.5)';
ctx.lineWidth = 2;
ctx.beginPath(); ctx.moveTo(-10, H - 46); ctx.lineTo(W + 10, H - 46); ctx.stroke();
// The rat, watching from the skirting — slinks out, watches, slips back
var ratOut = Math.sin(envT * 0.13) > 0.15;
if (ratOut) {
var ratX = W - 46 + Math.sin(envT * 0.9) * 4;
var ratY = H - 50;
ctx.fillStyle = 'rgba(10,6,5,0.9)';
ctx.beginPath();
ctx.ellipse(ratX, ratY, 11, 5, 0, 0, Math.PI * 2);
ctx.fill();
ctx.beginPath();
ctx.ellipse(ratX - 10, ratY - 2, 4.5, 3.5, 0, 0, Math.PI * 2);
ctx.fill();
ctx.beginPath();
ctx.arc(ratX - 12, ratY - 5, 1.8, 0, Math.PI * 2);
ctx.fill();
ctx.strokeStyle = 'rgba(10,6,5,0.8)';
ctx.lineWidth = 1.4;
ctx.beginPath();
ctx.moveTo(ratX + 10, ratY);
ctx.quadraticCurveTo(ratX + 22, ratY + 2 + Math.sin(envT * 2.1) * 2, ratX + 30, ratY - 2);
ctx.stroke();
// A pin of eye catching the bulb light
ctx.fillStyle = 'rgba(255,190,120,0.8)';
ctx.fillRect(ratX - 13, ratY - 6, 1.4, 1.4);
}
// The bare bulb — hung off-centre, swinging; every landed hit kicks it
if (this.shakeStart) {
var swSt = (Date.now() - this.shakeStart) / 340;
if (swSt < 1) this._swayAmp = Math.max(this._swayAmp || 0, this.shakeMag * 0.02);
}
this._swayAmp = (this._swayAmp || 0) * 0.985;
var bulbAng = Math.sin(envT * 4.2) * (0.025 + this._swayAmp);
var cordTopX = W * 0.32, cordLen = 62;
var bulbX = cordTopX + Math.sin(bulbAng) * cordLen;
var bulbY = Math.cos(bulbAng) * cordLen;
ctx.strokeStyle = 'rgba(20,14,10,0.9)';
ctx.lineWidth = 1.6;
ctx.beginPath();
ctx.moveTo(cordTopX, -6);
ctx.lineTo(bulbX, bulbY);
ctx.stroke();
ctx.fillStyle = 'rgba(30,22,16,0.95)';
ctx.fillRect(bulbX - 3, bulbY - 2, 6, 6);
var bulbGrad = ctx.createRadialGradient(bulbX, bulbY + 9, 1, bulbX, bulbY + 9, 9);
bulbGrad.addColorStop(0, 'rgba(255,236,180,0.95)');
bulbGrad.addColorStop(0.5, 'rgba(240,190,110,0.55)');
bulbGrad.addColorStop(1, 'rgba(200,140,70,0)');
ctx.fillStyle = bulbGrad;
ctx.beginPath();
ctx.arc(bulbX, bulbY + 9, 9, 0, Math.PI * 2);
ctx.fill();
// Its pool of light sways across the cellar with it
var lg = ctx.createRadialGradient(bulbX, bulbY + 10, 10, bulbX, bulbY + 10, 380);
lg.addColorStop(0, 'rgba(180, 140, 80, 0.13)');
lg.addColorStop(1, 'rgba(0, 0, 0, 0)');
ctx.fillStyle = lg;
ctx.fillRect(0, 0, W, H);
// Corner vignette seats the room
var envVig = ctx.createLinearGradient(0, 0, W, 0);
envVig.addColorStop(0, 'rgba(0,0,0,0.34)');
envVig.addColorStop(0.2, 'rgba(0,0,0,0)');
envVig.addColorStop(0.8, 'rgba(0,0,0,0)');
envVig.addColorStop(1, 'rgba(0,0,0,0.34)');
ctx.fillStyle = envVig;
ctx.fillRect(0, 0, W, H);

this.drawCopper(ctx);
this.drawBars(ctx);

if (this.phase === 'telegraph' && this.clickable) {
// Punch-path arrow removed — was counterintuitive (eye followed it as a
// "click here" cue when the player needed to do the opposite).
// drawZones now lights up the safe dodge zone instead.
this.drawZones(ctx);
this.drawTimerBar(ctx);
}

if (this.phase === 'result' && this.resultFlash > 0) {
this.resultFlash -= 0.02;
if (this.resultClass === 'win') ctx.fillStyle = 'rgba(170, 255, 170, ' + (this.resultFlash * 0.08) + ')';
else if (this.resultClass === 'lose') ctx.fillStyle = 'rgba(255, 100, 100, ' + (this.resultFlash * 0.1) + ')';
else ctx.fillStyle = 'rgba(220, 200, 120, ' + (this.resultFlash * 0.06) + ')';
ctx.fillRect(0, 0, W, H);
}

if (this.sobriety < 35) {
var str = (35 - this.sobriety) / 35;
var vig = ctx.createRadialGradient(W/2, H/2, H*0.2, W/2, H/2, H*0.6);
vig.addColorStop(0, 'rgba(0,0,0,0)');
vig.addColorStop(1, 'rgba(0,0,0,' + (str * 0.45) + ')');
ctx.fillStyle = vig;
ctx.fillRect(0, 0, W, H);
}

// Big cartoon K.O.! — slams in as the body lands (~480ms into the fall),
// overshooting from 2.6× down to full size, then settling to a slow throb.
// Starburst rays behind, cream-gold letters with a deep-red and near-black
// double outline. Drawn last so it sits over everything.
if (this.ko && this.koStart) {
var kot = Date.now() - this.koStart - 480;
if (kot > 0) {
var kp = Math.min(kot / 240, 1);
var settle = 1 - kp;
var koScale = 1 + settle * settle * 1.6;
var koAlpha = kp < 0.25 ? kp / 0.25 : 1;
var throb = kp >= 1 ? 1 + 0.025 * Math.sin(Date.now() / 170) : 1;
ctx.save();
ctx.translate(W / 2, H * 0.42);
ctx.rotate(-0.10);
ctx.scale(koScale * throb, koScale * throb);
ctx.globalAlpha = koAlpha;
ctx.fillStyle = 'rgba(255, 214, 110, 0.30)';
for (var kr = 0; kr < 12; kr++) {
var kAng = (kr / 12) * Math.PI * 2 + Date.now() / 4000;
var kLen = (kr % 2 === 0) ? 168 : 118;
ctx.beginPath();
ctx.moveTo(Math.cos(kAng - 0.06) * 42, Math.sin(kAng - 0.06) * 42);
ctx.lineTo(Math.cos(kAng) * kLen, Math.sin(kAng) * kLen);
ctx.lineTo(Math.cos(kAng + 0.06) * 42, Math.sin(kAng + 0.06) * 42);
ctx.closePath(); ctx.fill();
}
ctx.font = 'bold 92px Georgia, serif';
ctx.textAlign = 'center';
ctx.textBaseline = 'middle';
ctx.lineJoin = 'round';
ctx.strokeStyle = '#160606'; ctx.lineWidth = 16; ctx.strokeText('K.O.!', 0, 0);
ctx.strokeStyle = '#8a1f1f'; ctx.lineWidth = 8; ctx.strokeText('K.O.!', 0, 0);
ctx.fillStyle = '#ffe9a8'; ctx.fillText('K.O.!', 0, 0);
ctx.restore();
}
}
// Going down: the overhead light dies — darkness falls over the whole
// scene in the beat before the defeat passage (where the hanging bulb
// carries the dimness on).
if (this._downDim) {
var ddt = Math.min((Date.now() - this._downDim) / 900, 1);
ctx.fillStyle = 'rgba(0,0,0,' + (ddt * 0.72) + ')';
ctx.fillRect(-10, -10, W + 20, H + 20);
}
ctx.restore();
}

drawCopper(ctx) {
ctx.save();
// Knockout fall — he goes over like a felled tree, hinged at his feet,
// easing in over ~700ms and staying down. Animates past gameOver via the
// loop()'s _loopUntil extension.
if (this.ko && this.koStart) {
var kt = Math.min((Date.now() - this.koStart) / 700, 1);
var ke = kt * kt;
ctx.translate(this.copperBaseX, 340);
ctx.rotate(ke * 1.25);
ctx.translate(-this.copperBaseX, -340 + ke * 26);
}
var cx = this.copperBaseX;
var cy = this.copperBaseY;
var lean = 0, crouch = 0, fistPull = 0;

if (this.phase === 'telegraph') {
var t = Math.min((Date.now() - this.phaseTimer) / this.telegraphDuration, 1);
this.telegraphT = t;
if (this.punchType === 'right_cross') { lean = -35 * t; fistPull = t; }
else if (this.punchType === 'left_hook') { lean = 35 * t; fistPull = t; }
else if (this.punchType === 'uppercut') { crouch = 30 * t; fistPull = t; }
if (t >= 1 && !this.acted) this.timeOut();
}

if (this.phase === 'punching') {
var pt = Math.min((Date.now() - this.phaseTimer) / 500, 1);
this.punchT = pt;
if (this.copperHit) {
// Recoil — head/body jerks UP and back from the player's counter.
// Sin curve peaks at pt=0.5 then settles, like a natural snap.
var recoilCurve = Math.sin(pt * Math.PI);
cy -= 34 * recoilCurve;
lean = 6 * recoilCurve;
fistPull = 1;
} else {
cy += 40 * pt;
fistPull = 1 - pt;
}
}

cx += lean;
cy += crouch;

// ═══ COPPER COLOUR CONSTANTS ═══
var SKIN = '#c4a07a', SKIN_SHADOW = '#a88060', SKIN_OUTLINE = '#8e6e52', SKIN_DARK = '#7a6050';
var HAIR = '#2a1e14', HAIR_HI = '#3e3020';
var SUIT = '#1e1e24', SUIT_DARK = '#101016', SUIT_LIGHT = '#2e2e36';
var STRIPE = 'rgba(150,150,160,0.06)', SHIRT_WHITE = '#d8d4cc';
var TIE = '#2a1a1a', TIE_HI = '#3e2828';
var TROUSERS = '#1a1a20', TROUSERS_DARK = '#0e0e14';

// ═══ SHADOW ═══
ctx.fillStyle = 'rgba(0,0,0,0.25)';
ctx.beginPath(); ctx.ellipse(this.copperBaseX, 340, 95, 22, 0, 0, Math.PI * 2); ctx.fill();

// ═══ TROUSERS with pinstripes ═══
ctx.fillStyle = TROUSERS; ctx.strokeStyle = TROUSERS_DARK; ctx.lineWidth = 1;
ctx.beginPath(); ctx.moveTo(cx - 70, cy + 195); ctx.lineTo(cx - 74, cy + 320); ctx.lineTo(cx - 2, cy + 320); ctx.lineTo(cx - 2, cy + 205); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 70, cy + 195); ctx.lineTo(cx + 74, cy + 320); ctx.lineTo(cx + 2, cy + 320); ctx.lineTo(cx + 2, cy + 205); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.save(); ctx.strokeStyle = STRIPE; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx - 70, cy + 195); ctx.lineTo(cx - 74, cy + 320); ctx.lineTo(cx - 2, cy + 320); ctx.lineTo(cx - 2, cy + 205); ctx.closePath(); ctx.clip(); for (var s = -75; s <= -2; s += 8) { ctx.beginPath(); ctx.moveTo(cx + s, cy + 195); ctx.lineTo(cx + s - 1, cy + 320); ctx.stroke(); } ctx.restore();
ctx.save(); ctx.strokeStyle = STRIPE; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx + 70, cy + 195); ctx.lineTo(cx + 74, cy + 320); ctx.lineTo(cx + 2, cy + 320); ctx.lineTo(cx + 2, cy + 205); ctx.closePath(); ctx.clip(); for (var s = 2; s <= 75; s += 8) { ctx.beginPath(); ctx.moveTo(cx + s, cy + 195); ctx.lineTo(cx + s - 1, cy + 320); ctx.stroke(); } ctx.restore();
ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.lineWidth = 1;
ctx.beginPath(); ctx.moveTo(cx - 36, cy + 200); ctx.lineTo(cx - 38, cy + 320); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 36, cy + 200); ctx.lineTo(cx + 38, cy + 320); ctx.stroke();

// ═══ BELT ═══
ctx.fillStyle = '#1a1210'; ctx.strokeStyle = '#0e0a08'; ctx.lineWidth = 1;
ctx.beginPath(); ctx.moveTo(cx - 72, cy + 192); ctx.lineTo(cx + 72, cy + 192); ctx.lineTo(cx + 72, cy + 204); ctx.lineTo(cx - 72, cy + 204); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.fillStyle = '#c0a040'; ctx.strokeStyle = '#a08830'; ctx.lineWidth = 0.8; ctx.beginPath(); ctx.rect(cx - 8, cy + 194, 16, 8); ctx.fill(); ctx.stroke();
ctx.fillStyle = '#d4b050'; ctx.beginPath(); ctx.rect(cx - 5, cy + 196, 10, 4); ctx.fill();

// ═══ SUIT JACKET — shorter, shaped, dark pinstripe ═══
ctx.fillStyle = SUIT; ctx.strokeStyle = SUIT_DARK; ctx.lineWidth = 1.5;
ctx.beginPath(); ctx.moveTo(cx - 32, cy + 58); ctx.lineTo(cx - 78, cy + 68); ctx.quadraticCurveTo(cx - 82, cy + 120, cx - 78, cy + 160); ctx.quadraticCurveTo(cx - 76, cy + 185, cx - 72, cy + 195); ctx.lineTo(cx - 10, cy + 195); ctx.lineTo(cx - 10, cy + 88); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 32, cy + 58); ctx.lineTo(cx + 78, cy + 68); ctx.quadraticCurveTo(cx + 82, cy + 120, cx + 78, cy + 160); ctx.quadraticCurveTo(cx + 76, cy + 185, cx + 72, cy + 195); ctx.lineTo(cx + 10, cy + 195); ctx.lineTo(cx + 10, cy + 88); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.save(); ctx.strokeStyle = STRIPE; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx - 82, cy + 68); ctx.quadraticCurveTo(cx - 82, cy + 120, cx - 78, cy + 160); ctx.quadraticCurveTo(cx - 76, cy + 185, cx - 72, cy + 195); ctx.lineTo(cx - 10, cy + 195); ctx.lineTo(cx - 10, cy + 88); ctx.lineTo(cx - 32, cy + 58); ctx.lineTo(cx - 78, cy + 68); ctx.closePath(); ctx.clip(); for (var s = -85; s <= -5; s += 8) { ctx.beginPath(); ctx.moveTo(cx + s, cy + 58); ctx.lineTo(cx + s - 2, cy + 200); ctx.stroke(); } ctx.restore();
ctx.save(); ctx.strokeStyle = STRIPE; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx + 82, cy + 68); ctx.quadraticCurveTo(cx + 82, cy + 120, cx + 78, cy + 160); ctx.quadraticCurveTo(cx + 76, cy + 185, cx + 72, cy + 195); ctx.lineTo(cx + 10, cy + 195); ctx.lineTo(cx + 10, cy + 88); ctx.lineTo(cx + 32, cy + 58); ctx.lineTo(cx + 78, cy + 68); ctx.closePath(); ctx.clip(); for (var s = 5; s <= 85; s += 8) { ctx.beginPath(); ctx.moveTo(cx + s, cy + 58); ctx.lineTo(cx + s - 2, cy + 200); ctx.stroke(); } ctx.restore();
ctx.strokeStyle = SUIT_LIGHT; ctx.lineWidth = 0.8; ctx.beginPath(); ctx.moveTo(cx - 72, cy + 194); ctx.lineTo(cx - 10, cy + 194); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx + 10, cy + 194); ctx.lineTo(cx + 72, cy + 194); ctx.stroke();
ctx.fillStyle = SUIT_LIGHT; ctx.beginPath(); ctx.arc(cx - 12, cy + 140, 2.5, 0, Math.PI * 2); ctx.fill();

// ═══ SHOULDERS — broad ═══
ctx.fillStyle = SUIT; ctx.strokeStyle = SUIT_DARK; ctx.lineWidth = 1.5;
ctx.beginPath(); ctx.ellipse(cx, cy + 72, 88, 28, 0, 0, Math.PI * 2); ctx.fill(); ctx.stroke();

// ═══ SHIRT ═══
ctx.fillStyle = SHIRT_WHITE; ctx.strokeStyle = '#b8b4ac'; ctx.lineWidth = 0.8;
ctx.beginPath(); ctx.moveTo(cx - 28, cy + 50); ctx.lineTo(cx - 12, cy + 195); ctx.lineTo(cx + 12, cy + 195); ctx.lineTo(cx + 28, cy + 50); ctx.closePath(); ctx.fill(); ctx.stroke();

// ═══ KIPPER TIE ═══
ctx.fillStyle = TIE;
ctx.beginPath(); ctx.moveTo(cx - 8, cy + 54); ctx.lineTo(cx + 8, cy + 54); ctx.lineTo(cx + 7, cy + 70); ctx.lineTo(cx - 7, cy + 70); ctx.closePath(); ctx.fill();
ctx.strokeStyle = TIE_HI; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx - 2, cy + 55); ctx.lineTo(cx - 1, cy + 69); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx + 2, cy + 55); ctx.lineTo(cx + 1, cy + 69); ctx.stroke();
ctx.fillStyle = TIE;
ctx.beginPath(); ctx.moveTo(cx - 7, cy + 70); ctx.lineTo(cx - 13, cy + 170); ctx.lineTo(cx, cy + 182); ctx.lineTo(cx + 13, cy + 170); ctx.lineTo(cx + 7, cy + 70); ctx.closePath(); ctx.fill();
ctx.strokeStyle = TIE_HI; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(cx, cy + 72); ctx.lineTo(cx, cy + 178); ctx.stroke();
ctx.strokeStyle = 'rgba(0,0,0,0.25)'; ctx.lineWidth = 0.8; ctx.beginPath(); ctx.moveTo(cx - 8, cy + 72); ctx.lineTo(cx - 13, cy + 170); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx + 8, cy + 72); ctx.lineTo(cx + 13, cy + 170); ctx.stroke();
ctx.strokeStyle = 'rgba(60,30,30,0.3)'; ctx.lineWidth = 0.5; for (var ty = cy + 80; ty < cy + 168; ty += 12) { var tw = 7 + ((ty - cy - 70) / 100) * 6; ctx.beginPath(); ctx.moveTo(cx - tw, ty); ctx.lineTo(cx + tw, ty + 6); ctx.stroke(); }

// ═══ COLLAR ═══
ctx.fillStyle = SHIRT_WHITE; ctx.strokeStyle = '#b0aca4'; ctx.lineWidth = 1;
ctx.beginPath(); ctx.moveTo(cx - 5, cy + 50); ctx.lineTo(cx - 32, cy + 46); ctx.lineTo(cx - 36, cy + 54); ctx.lineTo(cx - 30, cy + 62); ctx.lineTo(cx - 8, cy + 56); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 5, cy + 50); ctx.lineTo(cx + 32, cy + 46); ctx.lineTo(cx + 36, cy + 54); ctx.lineTo(cx + 30, cy + 62); ctx.lineTo(cx + 8, cy + 56); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.fillStyle = SHIRT_WHITE; ctx.beginPath(); ctx.moveTo(cx - 10, cy + 48); ctx.lineTo(cx + 10, cy + 48); ctx.lineTo(cx + 8, cy + 55); ctx.lineTo(cx - 8, cy + 55); ctx.closePath(); ctx.fill();

// ═══ LAPELS ═══
ctx.fillStyle = SUIT; ctx.strokeStyle = SUIT_DARK; ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.moveTo(cx - 26, cy + 48); ctx.lineTo(cx - 52, cy + 76); ctx.lineTo(cx - 68, cy + 66); ctx.lineTo(cx - 38, cy + 40); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 26, cy + 48); ctx.lineTo(cx + 52, cy + 76); ctx.lineTo(cx + 68, cy + 66); ctx.lineTo(cx + 38, cy + 40); ctx.closePath(); ctx.fill(); ctx.stroke();
ctx.strokeStyle = SUIT_LIGHT; ctx.lineWidth = 0.6; ctx.beginPath(); ctx.moveTo(cx - 26, cy + 48); ctx.lineTo(cx - 52, cy + 76); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx + 26, cy + 48); ctx.lineTo(cx + 52, cy + 76); ctx.stroke();

// ═══ GOLD CHAIN ═══
ctx.save(); ctx.strokeStyle = '#d4b050'; ctx.lineWidth = 3; ctx.shadowColor = 'rgba(220,180,60,0.5)'; ctx.shadowBlur = 8;
ctx.beginPath(); ctx.moveTo(cx - 14, cy + 50); ctx.quadraticCurveTo(cx - 8, cy + 68, cx - 5, cy + 74); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 14, cy + 50); ctx.quadraticCurveTo(cx + 8, cy + 68, cx + 5, cy + 74); ctx.stroke(); ctx.shadowBlur = 0; ctx.restore();

// ═══ NECK — bull neck ═══
ctx.fillStyle = SKIN; ctx.beginPath(); ctx.moveTo(cx - 22, cy + 38); ctx.lineTo(cx - 24, cy + 56); ctx.lineTo(cx + 24, cy + 56); ctx.lineTo(cx + 22, cy + 38); ctx.closePath(); ctx.fill();
ctx.strokeStyle = SKIN_DARK; ctx.lineWidth = 0.8; ctx.beginPath(); ctx.moveTo(cx - 12, cy + 42); ctx.lineTo(cx - 14, cy + 53); ctx.stroke(); ctx.beginPath(); ctx.moveTo(cx + 12, cy + 42); ctx.lineTo(cx + 14, cy + 53); ctx.stroke();

// ═══ HEAD ═══
ctx.fillStyle = SKIN;
ctx.beginPath(); ctx.moveTo(cx - 32, cy + 10); ctx.lineTo(cx - 34, cy + 30); ctx.quadraticCurveTo(cx - 30, cy + 44, cx - 18, cy + 44); ctx.lineTo(cx + 18, cy + 44); ctx.quadraticCurveTo(cx + 30, cy + 44, cx + 34, cy + 30); ctx.lineTo(cx + 32, cy + 10); ctx.closePath(); ctx.fill();
ctx.beginPath(); ctx.ellipse(cx, cy + 10, 34, 36, 0, Math.PI, Math.PI * 2); ctx.fill();
ctx.strokeStyle = SKIN_OUTLINE; ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.moveTo(cx - 34, cy + 10); ctx.lineTo(cx - 34, cy + 30); ctx.quadraticCurveTo(cx - 30, cy + 44, cx - 18, cy + 44); ctx.lineTo(cx + 18, cy + 44); ctx.quadraticCurveTo(cx + 30, cy + 44, cx + 34, cy + 30); ctx.lineTo(cx + 34, cy + 10); ctx.stroke();

// ═══ HAIR — short-back-and-sides with quiff, M-shaped receding hairline ═══
ctx.fillStyle = HAIR;
ctx.beginPath();
ctx.moveTo(cx - 36, cy + 22);
ctx.lineTo(cx - 37, cy + 6); ctx.lineTo(cx - 37, cy - 4);
ctx.quadraticCurveTo(cx - 36, cy - 18, cx - 24, cy - 26);
ctx.quadraticCurveTo(cx - 10, cy - 30, cx, cy - 30);
ctx.quadraticCurveTo(cx + 10, cy - 30, cx + 24, cy - 26);
ctx.quadraticCurveTo(cx + 36, cy - 18, cx + 37, cy - 4);
ctx.lineTo(cx + 37, cy + 6); ctx.lineTo(cx + 36, cy + 22);
// M-shaped hairline
ctx.lineTo(cx + 30, cy + 2);
ctx.quadraticCurveTo(cx + 26, cy - 2, cx + 20, cy - 6);
ctx.quadraticCurveTo(cx + 10, cy - 12, cx + 4, cy - 10);
ctx.quadraticCurveTo(cx, cy - 13, cx - 4, cy - 10);
ctx.quadraticCurveTo(cx - 10, cy - 12, cx - 20, cy - 6);
ctx.quadraticCurveTo(cx - 26, cy - 2, cx - 30, cy + 2);
ctx.closePath(); ctx.fill();

// Messy low curls - base dome
ctx.fillStyle = HAIR;
ctx.beginPath();
ctx.moveTo(cx - 24, cy - 8);
ctx.quadraticCurveTo(cx - 28, cy - 15, cx - 22, cy - 20);
ctx.quadraticCurveTo(cx - 10, cy - 24, cx, cy - 24);
ctx.quadraticCurveTo(cx + 10, cy - 24, cx + 22, cy - 20);
ctx.quadraticCurveTo(cx + 28, cy - 15, cx + 24, cy - 8);
ctx.closePath(); ctx.fill();

// Individual curl bumps - arc clusters
var curlPositions = [[cx - 20, cy - 16, 6], [cx - 14, cy - 20, 5], [cx - 6, cy - 21, 7], [cx + 4, cy - 20, 6], [cx + 12, cy - 18, 5], [cx + 18, cy - 14, 6], [cx - 16, cy - 12, 4], [cx + 8, cy - 12, 4], [cx - 2, cy - 10, 5]];
for (var ci = 0; ci < curlPositions.length; ci++) {
  var cp = curlPositions[ci];
  ctx.beginPath(); ctx.arc(cp[0], cp[1], cp[2], 0, Math.PI * 2); ctx.fill();
}

// Curl highlights
ctx.strokeStyle = HAIR_HI; ctx.lineWidth = 1.5;
for (var ci = 0; ci < curlPositions.length; ci++) {
  var cp = curlPositions[ci];
  ctx.beginPath(); ctx.arc(cp[0] - 1, cp[1] - 1.5, cp[2] - 1, 0.3, 1.8); ctx.stroke();
}

// Grey curls mixed in
ctx.fillStyle = 'rgba(145,140,130,0.3)';
ctx.beginPath(); ctx.arc(cx - 18, cy - 15, 5, 0, Math.PI * 2); ctx.fill();
ctx.beginPath(); ctx.arc(cx + 6, cy - 19, 5.5, 0, Math.PI * 2); ctx.fill();
ctx.beginPath(); ctx.arc(cx + 14, cy - 12, 4, 0, Math.PI * 2); ctx.fill();

// Grey curl highlight arcs
ctx.strokeStyle = 'rgba(155,150,140,0.45)'; ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.arc(cx - 17, cy - 16, 4, 0.3, 1.8); ctx.stroke();
ctx.beginPath(); ctx.arc(cx + 7, cy - 20, 4.5, 0.3, 1.8); ctx.stroke();
ctx.beginPath(); ctx.arc(cx + 15, cy - 13, 3, 0.3, 1.8); ctx.stroke();

// Messy wisps falling over forehead
ctx.fillStyle = HAIR;
ctx.beginPath(); ctx.moveTo(cx - 20, cy - 4); ctx.quadraticCurveTo(cx - 24, cy + 2, cx - 22, cy + 8); ctx.quadraticCurveTo(cx - 20, cy + 6, cx - 18, cy - 2); ctx.closePath(); ctx.fill();
ctx.beginPath(); ctx.moveTo(cx + 18, cy - 2); ctx.quadraticCurveTo(cx + 24, cy + 4, cx + 20, cy + 10); ctx.quadraticCurveTo(cx + 18, cy + 6, cx + 16, cy + 0); ctx.closePath(); ctx.fill();

// Heavy grey temple streaks
ctx.strokeStyle = 'rgba(135,130,120,0.6)'; ctx.lineWidth = 3;
ctx.beginPath(); ctx.moveTo(cx - 34, cy + 2); ctx.lineTo(cx - 30, cy - 6); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 35, cy + 6); ctx.lineTo(cx - 31, cy - 2); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 36, cy + 10); ctx.lineTo(cx - 32, cy + 2); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 34, cy + 2); ctx.lineTo(cx + 30, cy - 6); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 35, cy + 6); ctx.lineTo(cx + 31, cy - 2); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 36, cy + 10); ctx.lineTo(cx + 32, cy + 2); ctx.stroke();

// Grey creeping into sides
ctx.strokeStyle = 'rgba(140,135,125,0.45)'; ctx.lineWidth = 2.5;
ctx.beginPath(); ctx.moveTo(cx - 34, cy - 2); ctx.lineTo(cx - 32, cy + 8); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 34, cy - 2); ctx.lineTo(cx + 32, cy + 8); ctx.stroke();

// Sideburns - mostly grey with dark roots
ctx.fillStyle = HAIR;
ctx.beginPath(); ctx.moveTo(cx - 35, cy + 8); ctx.lineTo(cx - 36, cy + 12); ctx.lineTo(cx - 33, cy + 12); ctx.lineTo(cx - 34, cy + 8); ctx.closePath(); ctx.fill();
ctx.fillStyle = 'rgba(145,140,130,0.4)';
ctx.beginPath(); ctx.moveTo(cx - 35, cy + 12); ctx.lineTo(cx - 36, cy + 24); ctx.lineTo(cx - 33, cy + 24); ctx.lineTo(cx - 34, cy + 12); ctx.closePath(); ctx.fill();
ctx.fillStyle = HAIR;
ctx.beginPath(); ctx.moveTo(cx + 35, cy + 8); ctx.lineTo(cx + 36, cy + 12); ctx.lineTo(cx + 33, cy + 12); ctx.lineTo(cx + 34, cy + 8); ctx.closePath(); ctx.fill();
ctx.fillStyle = 'rgba(145,140,130,0.4)';
ctx.beginPath(); ctx.moveTo(cx + 35, cy + 12); ctx.lineTo(cx + 36, cy + 24); ctx.lineTo(cx + 33, cy + 24); ctx.lineTo(cx + 34, cy + 12); ctx.closePath(); ctx.fill();

// ═══ EARS — cauliflower bumps ═══
ctx.fillStyle = SKIN; ctx.strokeStyle = SKIN_OUTLINE; ctx.lineWidth = 1;
ctx.beginPath(); ctx.ellipse(cx - 37, cy + 12, 6, 10, -0.2, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
ctx.beginPath(); ctx.ellipse(cx + 37, cy + 12, 6, 10, 0.2, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
ctx.fillStyle = SKIN_OUTLINE;
ctx.beginPath(); ctx.arc(cx - 39, cy + 14, 2.5, 0, Math.PI * 2); ctx.fill();
ctx.beginPath(); ctx.arc(cx + 39, cy + 14, 2.5, 0, Math.PI * 2); ctx.fill();

// ═══ FOREHEAD WRINKLES ═══
ctx.strokeStyle = SKIN_SHADOW; ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.moveTo(cx - 18, cy - 4); ctx.quadraticCurveTo(cx, cy - 5.5, cx + 18, cy - 4); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 16, cy - 8); ctx.quadraticCurveTo(cx, cy - 9.5, cx + 16, cy - 8); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 13, cy - 12); ctx.quadraticCurveTo(cx, cy - 13, cx + 13, cy - 12); ctx.stroke();
// Extra weathering line
ctx.strokeStyle = 'rgba(100,70,55,0.25)'; ctx.lineWidth = 0.8;
ctx.beginPath(); ctx.moveTo(cx - 20, cy - 0); ctx.quadraticCurveTo(cx, cy - 1.5, cx + 20, cy - 0); ctx.stroke();
// Frown furrows
ctx.strokeStyle = SKIN_SHADOW; ctx.lineWidth = 1.5;
ctx.beginPath(); ctx.moveTo(cx - 5, cy - 2); ctx.lineTo(cx - 4, cy + 5); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 5, cy - 2); ctx.lineTo(cx + 4, cy + 5); ctx.stroke();

// ═══ EYEBROWS — Heavy angry brows with outer droop ═══
// Left eyebrow
ctx.fillStyle = HAIR;
ctx.beginPath();
ctx.moveTo(cx - 7, cy + 5);
ctx.quadraticCurveTo(cx - 13, cy + 2, cx - 18, cy + 0);
ctx.lineTo(cx - 27, cy + 3);
ctx.lineTo(cx - 27, cy + 7);
ctx.quadraticCurveTo(cx - 18, cy + 4, cx - 7, cy + 9);
ctx.closePath(); ctx.fill();
// Bushy hair strokes
ctx.strokeStyle = HAIR; ctx.lineWidth = 2;
ctx.beginPath(); ctx.moveTo(cx - 8, cy + 5); ctx.lineTo(cx - 18, cy - 2); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 14, cy + 4); ctx.lineTo(cx - 23, cy + 0); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 20, cy + 6); ctx.lineTo(cx - 26, cy + 4); ctx.stroke();
// Bristle hairs
ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.moveTo(cx - 10, cy + 4); ctx.lineTo(cx - 12, cy - 1); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 16, cy + 3); ctx.lineTo(cx - 18, cy - 2); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 22, cy + 5); ctx.lineTo(cx - 24, cy + 1); ctx.stroke();

// Right eyebrow
ctx.fillStyle = HAIR;
ctx.beginPath();
ctx.moveTo(cx + 7, cy + 5);
ctx.quadraticCurveTo(cx + 13, cy + 2, cx + 18, cy + 0);
ctx.lineTo(cx + 27, cy + 3);
ctx.lineTo(cx + 27, cy + 7);
ctx.quadraticCurveTo(cx + 18, cy + 4, cx + 7, cy + 9);
ctx.closePath(); ctx.fill();
// Bushy hair strokes
ctx.strokeStyle = HAIR; ctx.lineWidth = 2;
ctx.beginPath(); ctx.moveTo(cx + 8, cy + 5); ctx.lineTo(cx + 18, cy - 2); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 14, cy + 4); ctx.lineTo(cx + 23, cy + 0); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 20, cy + 6); ctx.lineTo(cx + 26, cy + 4); ctx.stroke();
// Bristle hairs
ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.moveTo(cx + 10, cy + 4); ctx.lineTo(cx + 12, cy - 1); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 16, cy + 3); ctx.lineTo(cx + 18, cy - 2); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 22, cy + 5); ctx.lineTo(cx + 24, cy + 1); ctx.stroke();

// ═══ EYES — negative canthal tilt ═══
ctx.fillStyle = '#d0c8b8';
ctx.beginPath(); ctx.ellipse(cx - 14, cy + 12, 6, 2.2, -0.12, 0, Math.PI * 2); ctx.fill();
ctx.beginPath(); ctx.ellipse(cx + 14, cy + 12, 6, 2.2, 0.12, 0, Math.PI * 2); ctx.fill();
ctx.fillStyle = '#1a0a08';
ctx.beginPath(); ctx.ellipse(cx - 14, cy + 12, 3, 2.2, -0.12, 0, Math.PI * 2); ctx.fill();
ctx.beginPath(); ctx.ellipse(cx + 14, cy + 12, 3, 2.2, 0.12, 0, Math.PI * 2); ctx.fill();

// Dark under-eye shadows - two layers
ctx.fillStyle = 'rgba(80,50,50,0.25)';
ctx.beginPath(); ctx.ellipse(cx - 14, cy + 15, 8, 3, -0.12, 0, Math.PI * 2); ctx.fill();
ctx.beginPath(); ctx.ellipse(cx + 14, cy + 15, 8, 3, 0.12, 0, Math.PI * 2); ctx.fill();
ctx.fillStyle = 'rgba(70,40,50,0.2)';
ctx.beginPath(); ctx.ellipse(cx - 14, cy + 16, 7, 2.5, -0.12, 0, Math.PI * 2); ctx.fill();
ctx.beginPath(); ctx.ellipse(cx + 14, cy + 16, 7, 2.5, 0.12, 0, Math.PI * 2); ctx.fill();

// Heavy under-eye eyelids
ctx.strokeStyle = SKIN_SHADOW; ctx.lineWidth = 2.5;
ctx.beginPath(); ctx.moveTo(cx - 21, cy + 10); ctx.quadraticCurveTo(cx - 14, cy + 7.5, cx - 7, cy + 10); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 7, cy + 10); ctx.quadraticCurveTo(cx + 14, cy + 7.5, cx + 21, cy + 10); ctx.stroke();

// Under-eye bags
ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.moveTo(cx - 20, cy + 14); ctx.quadraticCurveTo(cx - 14, cy + 17, cx - 8, cy + 14); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 8, cy + 14); ctx.quadraticCurveTo(cx + 14, cy + 17, cx + 20, cy + 14); ctx.stroke();

// Heavier under-eye creases
ctx.strokeStyle = 'rgba(100,70,55,0.5)'; ctx.lineWidth = 1.5;
ctx.beginPath(); ctx.moveTo(cx - 19, cy + 17); ctx.quadraticCurveTo(cx - 14, cy + 19, cx - 9, cy + 17); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 9, cy + 17); ctx.quadraticCurveTo(cx + 14, cy + 19, cx + 19, cy + 17); ctx.stroke();

// ═══ CROW'S FEET ═══
ctx.strokeStyle = SKIN_SHADOW; ctx.lineWidth = 1;
ctx.beginPath(); ctx.moveTo(cx - 21, cy + 10); ctx.lineTo(cx - 26, cy + 6); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 21, cy + 11); ctx.lineTo(cx - 27, cy + 10); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 21, cy + 13); ctx.lineTo(cx - 26, cy + 15); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 21, cy + 10); ctx.lineTo(cx + 26, cy + 6); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 21, cy + 11); ctx.lineTo(cx + 27, cy + 10); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 21, cy + 13); ctx.lineTo(cx + 26, cy + 15); ctx.stroke();

// ═══ POCKMARKS ═══
ctx.fillStyle = 'rgba(100,70,55,0.15)';
var pockmarkPositions = [[cx - 28, cy + 14], [cx - 24, cy + 18], [cx - 18, cy + 22], [cx - 12, cy + 20], [cx + 12, cy + 20], [cx + 18, cy + 22], [cx + 24, cy + 18], [cx + 28, cy + 14]];
for (var pi = 0; pi < pockmarkPositions.length; pi++) {
  var pp = pockmarkPositions[pi];
  ctx.beginPath(); ctx.arc(pp[0], pp[1], 1.5 + Math.random() * 0.8, 0, Math.PI * 2); ctx.fill();
}

// ═══ NOSE — battered, broader ═══
ctx.strokeStyle = SKIN_OUTLINE; ctx.lineWidth = 2;
ctx.beginPath(); ctx.moveTo(cx - 1, cy + 12); ctx.quadraticCurveTo(cx - 5, cy + 22, cx - 7, cy + 26); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 2, cy + 12); ctx.quadraticCurveTo(cx + 3, cy + 22, cx + 6, cy + 26); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 10, cy + 28); ctx.quadraticCurveTo(cx, cy + 31, cx + 10, cy + 28); ctx.stroke();
ctx.lineWidth = 1;
ctx.beginPath(); ctx.moveTo(cx - 3, cy + 18); ctx.quadraticCurveTo(cx - 5, cy + 20, cx - 3, cy + 22); ctx.stroke();

// ═══ NASOLABIAL FOLDS ═══
ctx.strokeStyle = SKIN_SHADOW; ctx.lineWidth = 1.5;
ctx.beginPath(); ctx.moveTo(cx - 10, cy + 27); ctx.quadraticCurveTo(cx - 14, cy + 32, cx - 15, cy + 38); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx + 10, cy + 27); ctx.quadraticCurveTo(cx + 14, cy + 32, cx + 15, cy + 38); ctx.stroke();

// ═══ DOUBLE CHIN ═══
ctx.fillStyle = SKIN;
ctx.beginPath();
ctx.moveTo(cx - 28, cy + 42);
ctx.quadraticCurveTo(cx - 30, cy + 50, cx, cy + 52);
ctx.quadraticCurveTo(cx + 30, cy + 50, cx + 28, cy + 42);
ctx.closePath(); ctx.fill();
// Crease lines
ctx.strokeStyle = SKIN_SHADOW; ctx.lineWidth = 1.5;
ctx.beginPath(); ctx.moveTo(cx - 20, cy + 46); ctx.quadraticCurveTo(cx, cy + 48, cx + 20, cy + 46); ctx.stroke();
ctx.beginPath(); ctx.moveTo(cx - 24, cy + 50); ctx.quadraticCurveTo(cx, cy + 51, cx + 24, cy + 50); ctx.stroke();

// ═══ SCARS ═══
ctx.strokeStyle = '#d49898'; ctx.lineWidth = 2;
ctx.beginPath(); ctx.moveTo(cx - 24, cy + 16); ctx.lineTo(cx - 13, cy + 27); ctx.stroke();
ctx.lineWidth = 1.2;
ctx.beginPath(); ctx.moveTo(cx + 18, cy + 20); ctx.lineTo(cx + 22, cy + 24); ctx.stroke();

// ═══ MOUTH — tight closed scowl ═══
ctx.strokeStyle = SKIN_DARK; ctx.lineWidth = 2.2;
ctx.beginPath(); ctx.moveTo(cx - 13, cy + 37);
ctx.quadraticCurveTo(cx - 5, cy + 36, cx, cy + 36.5);
ctx.quadraticCurveTo(cx + 5, cy + 36, cx + 13, cy + 37); ctx.stroke();
// Thin dark crack - no teeth showing
ctx.strokeStyle = 'rgba(40,20,15,0.6)'; ctx.lineWidth = 0.8;
ctx.beginPath(); ctx.moveTo(cx - 13, cy + 37);
ctx.quadraticCurveTo(cx - 5, cy + 37.5, cx, cy + 37.5);
ctx.quadraticCurveTo(cx + 5, cy + 37.5, cx + 13, cy + 37); ctx.stroke();

// ═══ HEAVY STUBBLE ═══
ctx.fillStyle = 'rgba(50, 35, 25, 0.25)';
for (var si = 0; si < 200; si++) {
var sx = cx + (Math.random() - 0.5) * 62;
var sy2 = cy + 28 + Math.random() * 18;
var dx = Math.abs(sx - cx);
if (dx < 34 && sy2 > cy + 28) { ctx.beginPath(); ctx.arc(sx, sy2, 0.7 + Math.random() * 0.3, 0, Math.PI * 2); ctx.fill(); }
}
ctx.fillStyle = 'rgba(50, 35, 25, 0.3)';
for (var sj = 0; sj < 60; sj++) {
var sx3 = cx + (Math.random() - 0.5) * 30;
var sy3 = cy + 38 + Math.random() * 10;
ctx.beginPath(); ctx.arc(sx3, sy3, 0.5 + Math.random() * 0.3, 0, Math.PI * 2); ctx.fill();
}

var lfx = cx - 65, lfy = cy + 140;
var rfx = cx + 65, rfy = cy + 140;

var glowPulse = 0.5 + 0.5 * Math.sin(Date.now() / 100);
var glowStrength = fistPull;

var glowAlpha = glowStrength;
if (!this.isPractice()) {
if (this.sobriety < 25) glowAlpha *= 0.5;
else if (this.sobriety < 50) glowAlpha *= 0.7;
}

if (this.punchType === 'right_cross') {
rfx = cx + 65 + 30 * fistPull;
rfy = cy + 130 - 25 * fistPull;

if (this.phase === 'punching' && !this.copperHit) {
rfx = cx + 65 + 30 * (1 - this.punchT) - 60 * this.punchT;
rfy = cy + 105 + 95 * this.punchT;
var fs = 1 + 1.2 * this.punchT;
this.drawFist(ctx, rfx, rfy, 16 * fs, 20 * fs, -0.2, 0);
this.drawFist(ctx, lfx, lfy, 16, 20, 0.2, 0);
ctx.restore(); return;
}

this.drawFist(ctx, lfx, lfy, 16, 20, 0.2, 0);
this.drawFist(ctx, rfx, rfy, 16, 20, -0.2, glowAlpha * glowPulse);

} else if (this.punchType === 'left_hook') {
lfx = cx - 65 - 30 * fistPull;
lfy = cy + 130 - 25 * fistPull;

if (this.phase === 'punching' && !this.copperHit) {
lfx = cx - 65 - 30 * (1 - this.punchT) + 60 * this.punchT;
lfy = cy + 105 + 95 * this.punchT;
var fs = 1 + 1.2 * this.punchT;
this.drawFist(ctx, lfx, lfy, 16 * fs, 20 * fs, 0.2, 0);
this.drawFist(ctx, rfx, rfy, 16, 20, -0.2, 0);
ctx.restore(); return;
}

this.drawFist(ctx, rfx, rfy, 16, 20, -0.2, 0);
this.drawFist(ctx, lfx, lfy, 16, 20, 0.2, glowAlpha * glowPulse);

} else if (this.punchType === 'uppercut') {
rfx = cx + 30;
rfy = cy + 160 + 35 * fistPull;

if (this.phase === 'punching' && !this.copperHit) {
rfx = cx + 30 * (1 - this.punchT);
rfy = cy + 195 - 110 * this.punchT;
var fs = 1 + 1.5 * this.punchT;
this.drawFist(ctx, rfx, rfy, 16 * fs, 20 * fs, 0, 0);
this.drawFist(ctx, lfx, lfy, 16, 20, 0.2, 0);
ctx.restore(); return;
}

this.drawFist(ctx, lfx, lfy, 16, 20, 0.2, 0);
this.drawFist(ctx, rfx, rfy, 16, 20, 0, glowAlpha * glowPulse);

} else {
this.drawFist(ctx, lfx, lfy, 16, 20, 0.2, 0);
this.drawFist(ctx, rfx, rfy, 16, 20, -0.2, 0);
}

ctx.restore();
}

drawFist(ctx, x, y, rx, ry, rot, glow) {
// Strong, large telegraph glow — was too small and dim to be noticed.
if (glow > 0.05) {
ctx.save();
// Outer halo (very wide and bright)
var glowR = Math.max(rx, ry) * 6;
var grad = ctx.createRadialGradient(x, y, Math.max(rx, ry) * 0.6, x, y, glowR);
grad.addColorStop(0, 'rgba(255, 220, 120, ' + (glow * 0.95) + ')');
grad.addColorStop(0.18, 'rgba(255, 140, 60, ' + (glow * 0.78) + ')');
grad.addColorStop(0.50, 'rgba(255, 80, 40, ' + (glow * 0.42) + ')');
grad.addColorStop(1, 'rgba(255, 30, 10, 0)');
ctx.fillStyle = grad;
ctx.beginPath();
ctx.ellipse(x, y, glowR, glowR, 0, 0, Math.PI * 2);
ctx.fill();
// Pulsing ring around the glove itself
var ringPulse = 0.5 + 0.5 * Math.sin(Date.now() / 110);
ctx.strokeStyle = 'rgba(255, 200, 100, ' + (glow * (0.55 + 0.45 * ringPulse)) + ')';
ctx.lineWidth = 3.5;
ctx.beginPath();
ctx.ellipse(x, y, rx + 5 + ringPulse * 3, ry + 5 + ringPulse * 3, rot, 0, Math.PI * 2);
ctx.stroke();
ctx.restore();
}

// Fist fill — when glowing, it goes bright red-orange instead of just slightly warmer beige.
if (glow > 0.05) {
var fillIntensity = Math.min(1, glow * 1.2);
ctx.fillStyle = 'rgba(' + Math.round(220 + 35 * fillIntensity) + ', ' + Math.round(70 + 30 * (1 - fillIntensity)) + ', ' + Math.round(40 + 20 * (1 - fillIntensity)) + ', 1)';
} else {
ctx.fillStyle = '#c4a07a';
}
ctx.beginPath();
ctx.ellipse(x, y, rx, ry, rot, 0, Math.PI * 2);
ctx.fill();
ctx.strokeStyle = glow > 0.05 ? '#ffd060' : '#8e6e52';
ctx.lineWidth = glow > 0.05 ? 2.5 : 1.5;
ctx.stroke();

ctx.strokeStyle = glow > 0.05 ? '#ffe080' : '#8e6e52';
ctx.lineWidth = 1;
ctx.beginPath(); ctx.moveTo(x - 6, y - 3); ctx.lineTo(x + 6, y - 3); ctx.stroke();
}

drawPunchPath(ctx) {
var t = this.telegraphT;
if (t < 0.15) return;
var progress = Math.min((t - 0.15) / 0.6, 1);

var pulse = 0.5 + 0.5 * Math.sin(Date.now() / 130);
var alpha = progress * 0.55 * pulse;

if (!this.isPractice()) {
if (this.sobriety < 25) alpha *= 0.4;
else if (this.sobriety < 50) alpha *= 0.65;
}

ctx.save();
ctx.strokeStyle = 'rgba(255, 120, 60, ' + alpha + ')';
ctx.fillStyle = 'rgba(255, 120, 60, ' + alpha + ')';
ctx.lineWidth = 2.5;
ctx.setLineDash([8, 6]);

var W = this.W, H = this.H;
var cx = this.copperBaseX;
var lean = 0, crouch = 0;
if (this.punchType === 'right_cross') lean = -35 * Math.min(t, 1);
else if (this.punchType === 'left_hook') lean = 35 * Math.min(t, 1);
else if (this.punchType === 'uppercut') crouch = 30 * Math.min(t, 1);

cx += lean;
var cy = this.copperBaseY + crouch;

if (this.punchType === 'right_cross') {
var fx = cx + 65 + 30 * t;
var fy = cy + 130 - 25 * t;
var landX = 100;
var landY = H * 0.75;
var cpx = W * 0.35;
var cpy = fy + 40;
ctx.beginPath();
ctx.moveTo(fx, fy);
ctx.quadraticCurveTo(cpx, cpy, landX, landY);
ctx.stroke();
this.drawPathArrowhead(ctx, cpx, cpy, landX, landY, alpha);

} else if (this.punchType === 'left_hook') {
var fx = cx - 65 - 30 * t;
var fy = cy + 130 - 25 * t;
var landX = W - 100;
var landY = H * 0.75;
var cpx = W * 0.65;
var cpy = fy + 40;
ctx.beginPath();
ctx.moveTo(fx, fy);
ctx.quadraticCurveTo(cpx, cpy, landX, landY);
ctx.stroke();
this.drawPathArrowhead(ctx, cpx, cpy, landX, landY, alpha);

} else if (this.punchType === 'uppercut') {
var fx = cx + 30;
var fy = cy + 160 + 35 * t;
var landX = W / 2;
var landY = H * 0.85;
ctx.beginPath();
ctx.moveTo(fx, fy);
ctx.quadraticCurveTo(fx - 10, landY - 20, landX, landY);
ctx.stroke();
this.drawPathArrowhead(ctx, fx - 10, landY - 20, landX, landY, alpha);
}

ctx.setLineDash([]);
ctx.restore();
}

drawPathArrowhead(ctx, cpx, cpy, tx, ty, alpha) {
var angle = Math.atan2(ty - cpy, tx - cpx);
var headLen = 14;
ctx.setLineDash([]);
ctx.fillStyle = 'rgba(255, 120, 60, ' + alpha + ')';
ctx.beginPath();
ctx.moveTo(tx, ty);
ctx.lineTo(tx - headLen * Math.cos(angle - 0.45), ty - headLen * Math.sin(angle - 0.45));
ctx.lineTo(tx - headLen * Math.cos(angle + 0.45), ty - headLen * Math.sin(angle + 0.45));
ctx.closePath();
ctx.fill();
}

drawTimerBar(ctx) {
var t = this.telegraphT;
var remaining = 1 - t;
var barW = this.W * remaining;
var pulse = 0.4 + 0.6 * Math.abs(Math.sin(Date.now() / 120));

ctx.fillStyle = 'rgba(234, 100, 100, 0.5)';
ctx.fillRect((this.W - barW) / 2, this.H - 10, barW, 5);
if (remaining < 0.3) {
ctx.fillStyle = 'rgba(255, 50, 50, ' + (0.3 + 0.7 * pulse) * 0.5 + ')';
ctx.fillRect((this.W - barW) / 2, this.H - 10, barW, 5);
}
}

drawZones(ctx) {
var alpha = 0.16;   // baseline zone fill — was 0.05 (barely visible)
var ha = 0.35;      // hover alpha
var practice = this.isPractice();
var correct = this.getCorrectDodge();

// Safe-zone telegraph glow — replaces the old punch-trajectory arrow.
// The CORRECT dodge zone lights up so the player's eye is drawn to where
// they should click, rather than to where the punch is going.
var safeGlow = 0;
if (this.phase === 'telegraph' && this.telegraphT > 0.15) {
  var progress = Math.min((this.telegraphT - 0.15) / 0.6, 1);
  var pulse = 0.5 + 0.5 * Math.sin(Date.now() / 200);
  safeGlow = progress * 0.45 * pulse;
  if (!practice) {
    if (this.sobriety < 25) safeGlow *= 0.4;
    else if (this.sobriety < 50) safeGlow *= 0.65;
  }
}

var leftCue  = (correct === 'dodge_left'  || correct === 'either') ? safeGlow : 0;
var rightCue = (correct === 'dodge_right' || correct === 'either') ? safeGlow : 0;

// ─── DODGE LEFT ───
var aL = Math.max(alpha, leftCue);
if (this.hoveredZone === 'dodge_left') aL = Math.max(aL, ha);
ctx.fillStyle = 'rgba(170, 255, 170, ' + aL + ')';
this.roundRect(ctx, 10, 130, 115, 210, 8); ctx.fill();
ctx.strokeStyle = 'rgba(170, 255, 170, ' + (aL + 0.25) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
ctx.font = 'bold 16px Georgia';
ctx.textAlign = 'center';
var labelL = this.hoveredZone === 'dodge_left' ? 1 : (leftCue > 0.04 ? Math.min(1, 0.7 + leftCue * 1.4) : 0.7);
ctx.lineWidth = 3;
ctx.strokeStyle = 'rgba(0, 0, 0, 0.6)';
ctx.strokeText('← DODGE', 67, 240);
ctx.fillStyle = 'rgba(190, 255, 190, ' + labelL + ')';
ctx.fillText('← DODGE', 67, 240);

// ─── DODGE RIGHT ───
var aR = Math.max(alpha, rightCue);
if (this.hoveredZone === 'dodge_right') aR = Math.max(aR, ha);
ctx.fillStyle = 'rgba(170, 255, 170, ' + aR + ')';
this.roundRect(ctx, this.W - 125, 130, 115, 210, 8); ctx.fill();
ctx.strokeStyle = 'rgba(170, 255, 170, ' + (aR + 0.25) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
var labelR = this.hoveredZone === 'dodge_right' ? 1 : (rightCue > 0.04 ? Math.min(1, 0.7 + rightCue * 1.4) : 0.7);
ctx.lineWidth = 3;
ctx.strokeStyle = 'rgba(0, 0, 0, 0.6)';
ctx.strokeText('DODGE →', this.W - 67, 240);
ctx.fillStyle = 'rgba(190, 255, 190, ' + labelR + ')';
ctx.fillText('DODGE →', this.W - 67, 240);

// ─── BLOCK ───
var aB = this.hoveredZone === 'block' ? ha : alpha;
ctx.fillStyle = 'rgba(220, 200, 120, ' + aB + ')';
this.roundRect(ctx, 155, 335, this.W - 310, 55, 8); ctx.fill();
ctx.strokeStyle = 'rgba(220, 200, 120, ' + (aB + 0.25) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
ctx.lineWidth = 3;
ctx.strokeStyle = 'rgba(0, 0, 0, 0.6)';
ctx.strokeText('BLOCK', this.W / 2, 370);
ctx.fillStyle = 'rgba(240, 218, 138, ' + (this.hoveredZone === 'block' ? 1 : 0.75) + ')';
ctx.fillText('BLOCK', this.W / 2, 370);

// Counter-window cue: the ellipse warms while a swing would actually land —
// the same 0.50–0.82 stretch of the telegraph that handleAction scores. In
// practice it also pulses gently from early on (discoverability); in real
// exchanges only the live window shows, faster and hotter, and drink dims
// it exactly like the dodge cue. The KO route is readable now, not secret.
var counterPulse = 0;
if (this.phase === 'telegraph') {
  var ct = this.telegraphT;
  var inWindow = (ct >= 0.50 && ct <= 0.82);
  if (practice && ct > 0.15) {
    var cp = Math.min((ct - 0.15) / 0.6, 1);
    counterPulse = cp * (inWindow ? 0.34 : 0.16) * (0.5 + 0.5 * Math.sin(Date.now() / 320));
  } else if (!practice && inWindow) {
    counterPulse = 0.30 * (0.6 + 0.4 * Math.sin(Date.now() / 140));
    if (this.sobriety < 25) counterPulse *= 0.4;
    else if (this.sobriety < 50) counterPulse *= 0.65;
  }
}
var aC = this.hoveredZone === 'counter' ? ha : Math.max(alpha, counterPulse);
ctx.fillStyle = 'rgba(255, 150, 100, ' + aC + ')';
ctx.beginPath(); ctx.ellipse(this.W / 2, 190, 60, 65, 0, 0, Math.PI * 2); ctx.fill();
ctx.strokeStyle = 'rgba(255, 150, 100, ' + (aC + 0.30) + ')'; ctx.lineWidth = 1.5; ctx.stroke();
var labelC = this.hoveredZone === 'counter' ? 1 : (counterPulse > 0.04 ? Math.min(1, 0.7 + counterPulse * 1.6) : 0.75);
ctx.lineWidth = 3;
ctx.strokeStyle = 'rgba(0, 0, 0, 0.6)';
ctx.strokeText('COUNTER', this.W / 2, 195);
ctx.fillStyle = 'rgba(255, 178, 130, ' + labelC + ')';
ctx.fillText('COUNTER', this.W / 2, 195);
}

roundRect(ctx, x, y, w, h, r) {
ctx.beginPath();
ctx.moveTo(x + r, y);
ctx.lineTo(x + w - r, y);
ctx.quadraticCurveTo(x + w, y, x + w, y + r);
ctx.lineTo(x + w, y + h - r);
ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
ctx.lineTo(x + r, y + h);
ctx.quadraticCurveTo(x, y + h, x, y + h - r);
ctx.lineTo(x, y + r);
ctx.quadraticCurveTo(x, y, x + r, y);
ctx.closePath();
}

applyDamage(toYou, toHim) {
if (toYou > 0) this.playerBarFlash = 1;
if (toHim > 0) this.copperBarFlash = 1;
this.playerHP = Math.max(0, this.playerHP - Math.round(toYou * (1 - (this.EZ || 0) * 0.15)));
this.copperHP = Math.max(0, this.copperHP - toHim);
}

// Two composure bars across the top — YOU (left) and COPPER (right). Drawn on
// canvas so they drain smoothly; only shown once the real fight starts.
drawBars(ctx) {
if (this.isPractice()) return;
this.playerHPShown += (this.playerHP - this.playerHPShown) * 0.16;
this.copperHPShown += (this.copperHP - this.copperHPShown) * 0.16;
// Damage ghosts trail far slower than the fill, leaving a bright wake the
// size of the chunk just lost; the border flashes on the frame it lands.
this.playerHPGhost += (this.playerHP - this.playerHPGhost) * 0.045;
this.copperHPGhost += (this.copperHP - this.copperHPGhost) * 0.045;
this.playerBarFlash *= 0.94;
this.copperBarFlash *= 0.94;
this._drawBar(ctx, 14, 'YOU', this.playerHPShown, false, this.playerHPGhost, this.playerBarFlash);
this._drawBar(ctx, this.W - 214, 'COPPER', this.copperHPShown, true, this.copperHPGhost, this.copperBarFlash);
}

_drawBar(ctx, x, label, hp, rightAlign, ghost, flash) {
var w = 200, h = 12, y = 16;
var frac = Math.max(0, Math.min(1, hp / 100));
ctx.fillStyle = 'rgba(0,0,0,0.55)';
this.roundRect(ctx, x, y, w, h, 3); ctx.fill();
ctx.strokeStyle = 'rgba(220,200,150,0.35)'; ctx.lineWidth = 1;
this.roundRect(ctx, x, y, w, h, 3); ctx.stroke();
if (flash > 0.02) {
ctx.strokeStyle = 'rgba(255,245,220,' + (flash * 0.9) + ')'; ctx.lineWidth = 1.5;
this.roundRect(ctx, x, y, w, h, 3); ctx.stroke();
}
var col = frac > 0.55 ? 'rgba(150,230,140,0.92)'
        : frac > 0.28 ? 'rgba(235,200,110,0.94)'
        : 'rgba(235,110,90,0.96)';
var gfrac = Math.max(0, Math.min(1, (ghost || 0) / 100));
if (gfrac > frac + 0.004) {
var gw = (w - 2) * gfrac;
var fwG = (w - 2) * frac;
ctx.fillStyle = 'rgba(255,235,210,0.4)';
var gx = rightAlign ? (x + w - 1 - gw) : (x + 1 + fwG);
this.roundRect(ctx, gx, y + 1, gw - fwG, h - 2, 2); ctx.fill();
}
var fw = (w - 2) * frac;
if (fw > 0.5) {
ctx.fillStyle = col;
var fx = rightAlign ? (x + w - 1 - fw) : (x + 1);
this.roundRect(ctx, fx, y + 1, fw, h - 2, 2); ctx.fill();
}
ctx.font = 'bold 11px "Courier New", monospace';
ctx.textAlign = rightAlign ? 'right' : 'left';
ctx.fillStyle = 'rgba(232,212,172,0.9)';
ctx.fillText(label, rightAlign ? (x + w) : x, y - 4);
ctx.textAlign = 'left';
}

loop() {
this.draw();
if (!this.gameOver || Date.now() < this._loopUntil) {
requestAnimationFrame(() => this.loop());
}
}
};

window.startFightGame = function() {
document.getElementById('pre-fight').style.display = 'none';
document.getElementById('fight-arena').style.display = 'block';
var sobriety = parseInt(document.getElementById('sob-data').textContent) || 55;
new window.FightGame('fight-canvas', sobriety);
};

// ====== TYPEWRITER EFFECT ======
(function() {
function typewriterEffect(container) {
var textEntries = [];
// Gather Harlowe links to hide during typing. `tw-expression` wraps
// (link:)/(link-goto:) style macros; `tw-link` is the bare [[bracket]]
// link Harlowe renders directly. Both must be hidden — otherwise the
// bracket link sits dead on the page while text types in around it.
var linkEls = container.querySelectorAll('tw-expression, tw-link');
linkEls.forEach(function(el) {
el.style.opacity = '0';
el.style.transition = 'none';
el.style.pointerEvents = 'none';
});

// `fast` propagates down from any ancestor carrying class "tw-fast" — a marker
// the author can wrap a paragraph in to make it type unusually quickly.
function collectTextNodes(el, fast) {
var children = el.childNodes;
for (var i = 0; i < children.length; i++) {
var child = children[i];
// Skip Harlowe link expressions — revealed after typing
if (child.nodeType === 1 && child.tagName === 'TW-EXPRESSION') continue;
// Skip bare [[bracket]] links too — same treatment, hidden until done
if (child.nodeType === 1 && child.tagName === 'TW-LINK') continue;
// Skip flash-reveal elements — triggered separately after typing completes
if (child.nodeType === 1 && child.classList && child.classList.contains('flash-reveal')) continue;
if (child.nodeType === 1 && child.tagName === 'BR') { textEntries.push({ br: true }); continue; }
// <span class="tw-pause" data-ms="600"></span> — an author-placed beat mid-paragraph.
if (child.nodeType === 1 && child.classList && child.classList.contains('tw-pause')) { var pms = parseInt(child.getAttribute('data-ms'), 10); textEntries.push({ pause: (pms > 0 ? pms : 600) }); continue; }
if (child.nodeType === 3) {
var text = child.textContent;
if (text.length > 0) {
textEntries.push({ node: child, fullText: text, fast: fast });
child.textContent = '';
}
} else if (child.nodeType === 1) {
collectTextNodes(child, fast || (child.classList && child.classList.contains('tw-fast')));
}
}
}

collectTextNodes(container, false);

// Group the collected tokens into paragraphs: runs of text separated by one
// or more <br> breaks. Each paragraph is revealed as a single block, with a
// short burst of typewriter clicks - keeping the sound, dropping the slow
// per-character pacing that made longer passages hard to read (Lea's note).
var paragraphs = [];
var paraCur = [];
for (var pi = 0; pi < textEntries.length; pi++) {
if (textEntries[pi].br) { if (paraCur.length) { paragraphs.push(paraCur); paraCur = []; } }
else paraCur.push(textEntries[pi]);
}
if (paraCur.length) paragraphs.push(paraCur);

// === PAPER ROLL WRAPPER ===
// Wrap the text content of .typewriter-page in an inner div that we can
// translate upward as text reveals. Using transform (rather than
// scrollTop) lets the page itself keep overflow:visible + clip-path,
// which is what allows the SVG wine stains to stray off the paper's
// left/right edges onto the dark background.
//
// IMPORTANT: leave any <svg> decorations as direct children of the page
// — they're position:absolute relative to the page's padding box, and
// moving them into the wrapper would shift their containing block to
// the wrapper's narrower content box (offsetting the stains/burns).
var rollWrapper = document.createElement('div');
rollWrapper.className = 'typewriter-paper-roll';
var kids = Array.prototype.slice.call(container.childNodes);
for (var ki = 0; ki < kids.length; ki++) {
  var kid = kids[ki];
  if (kid.nodeType === 1 && kid.tagName && kid.tagName.toLowerCase() === 'svg') {
    continue; // leave SVG decorations on the page
  }
  rollWrapper.appendChild(kid);
}
container.appendChild(rollWrapper);
var currentRoll = 0;

// ── Tunables — all the typing feel lives here, easy to dial after a playtest.
// Each paragraph TYPES OUT over roughly TARGET_MS (about 2-2.5s), but the
// per-key speed is clamped: the floor keeps the clicks far enough apart that
// you hear individual keys (the click sound is ~20ms), and the ceiling stops
// very short paragraphs from plodding. So a long paragraph naturally takes a
// little longer — "adjusted for its length".
var TARGET_MS   = 1550;  // desired type-out time per paragraph (~1.5s — sped up per Dr Quill; sentence/para pauses unchanged)
var MIN_CHAR_MS = 22;    // fastest per key — floor that keeps the clicks distinct
var MAX_CHAR_MS = 74;    // slowest per key — so short paragraphs aren't draggy
var FAST_CHAR_MS = 16;   // override for the single tw-fast line ("Soho, London." on The Night Ahead) — slightly slowed from 6ms per Dr Quill so it reads as a quick type, not an instant flash (still the fastest line, below the 22ms body floor)
var PARA_PAUSE  = 1500;  // base breath AFTER a paragraph finishes (the slower typing
                         // already gives reading time, so this is a short rest)
var PARA_JITTER = 1300;  // +/- variation on PARA_PAUSE so the between-paragraph rhythm isn't metronomic
var SENTENCE_PAUSE = 500; // a clear breath after . ! ? mid-paragraph (between sentences) — applies to
                          // every typewriter page so the reflective passages breathe like the opening.
                          // tw-fast paragraphs skip it (see curFast check below).
var START_DELAY = 320;   // settle beat before the first character
// THE FIRST ONE TAKES ITS TIME (2026-09-14, Sam: "a bit quicker on all but the
// first time it happens"). The opening earns its slowness; every typewriter
// page after it in the same sitting runs at about two-thirds the pace. The flag
// lives in sessionStorage, so Play Again (which clears it) gets the slow one
// back, and a page reload mid-night does not.
var _twSeen = false;
try { _twSeen = sessionStorage.getItem('dssTypewriterSeen') === '1'; } catch(e) { _twSeen = !!window.__dssTypewriterSeen; }
if (_twSeen) {
  TARGET_MS   = Math.round(TARGET_MS   * 0.64);
  MIN_CHAR_MS = Math.round(MIN_CHAR_MS * 0.64);
  MAX_CHAR_MS = Math.round(MAX_CHAR_MS * 0.64);
  PARA_PAUSE  = Math.round(PARA_PAUSE  * 0.60);
  PARA_JITTER = Math.round(PARA_JITTER * 0.60);
  SENTENCE_PAUSE = Math.round(SENTENCE_PAUSE * 0.62);
  START_DELAY = Math.round(START_DELAY * 0.60);
}
window.__dssTypewriterSeen = true;
try { sessionStorage.setItem('dssTypewriterSeen', '1'); } catch(e) {}
var silent = container.classList.contains('typewriter-silent');
var myGen = (window._passageGen || 0);
var curCharMs = MIN_CHAR_MS; // recomputed per paragraph from its length
var curFast = false;         // is the current paragraph a tw-fast one? (skips sentence pauses)

// Block cursor that follows the typing position and rests (blinking, via the
// .tw-cursor CSS) during the between-paragraph pause; fades out at the end.
var cursor = document.createElement('span');
cursor.className = 'tw-cursor';
cursor.textContent = '█';

// Paper-roll carriage: keep the cursor around ~72% of the fixed-height sheet,
// feeding the roll upward as typing descends so the newest line — and finally
// the link — stays in view. Short passages that fit never roll.
function rollToCursor() {
if (!cursor.getBoundingClientRect) return;
var carriageY = container.clientHeight * 0.72;
var pageRect = container.getBoundingClientRect();
var overshoot = (cursor.getBoundingClientRect().bottom - pageRect.top) - carriageY;
if (overshoot > 0) {
  currentRoll += overshoot;
  rollWrapper.style.transform = 'translateY(-' + currentRoll + 'px)';
}
}

// Reveal the links (and any flash-reveal elements) once typing is fully done —
// same completion behaviour as before, so nothing that waited on "done" is
// stranded.
function finish() {
unhookSkip(); dropSkipHint();
if (myGen !== (window._passageGen || 0)) return;
cursor.classList.add('tw-cursor-fade');
setTimeout(function() { cursor.style.display = 'none'; }, 800);
linkEls.forEach(function(el) {
el.style.transition = 'opacity 1.2s ease-in';
el.style.opacity = '1';
el.style.pointerEvents = 'auto';
});
if (linkEls.length) rollToCursor();
var flashEls = container.querySelectorAll('.flash-reveal');
flashEls.forEach(function(el) { el.classList.add('flash-reveal-active'); });
}

// Type the page out fast, character by character, but pause for a couple of
// seconds at each paragraph break so the reader can catch up before the next
// paragraph begins (the playtest note: keep the typewriter, much faster, with
// a breath between paragraphs). Indices walk paragraph -> node -> character.
var pIdx = 0, nIdx = 0, cIdx = 0;
// 2026-10-12 (Sam, the overnight list item 4): the opening page took about 40 s and could not be hurried. A click or
// tap on the page (not on a button or link), or Space or Enter, now sets the whole page at once and shows its links.
var skipped = false;
/* 2026-10-29 nightwork (smoothness): measured, typewriter pages hold a new player 9 to 43 s and nothing said a click sets the page; after 6 s of typing a
   quiet line says so, until the player has once skipped (dssTwSkipKnown). The typing pace is unchanged. */
var skipHint = null, skipHintT = setTimeout(function() { try { if (localStorage.getItem('dssTwSkipKnown') === '1') return; } catch (e) {} if (skipped || myGen !== (window._passageGen || 0) || !container.isConnected) return; skipHint = document.createElement('div'); skipHint.className = 'tw-skip-hint'; skipHint.textContent = 'Click anywhere to set the whole page.'; document.body.appendChild(skipHint); requestAnimationFrame(function() { if (skipHint) skipHint.classList.add('in'); }); }, 6000);
function dropSkipHint() { clearTimeout(skipHintT); if (skipHint) { var h = skipHint; skipHint = null; h.classList.remove('in'); setTimeout(function() { if (h.parentNode) h.parentNode.removeChild(h); }, 600); } }
function skipAll() {
if (skipped) return;
try { localStorage.setItem('dssTwSkipKnown', '1'); } catch (e) {}
if (myGen !== (window._passageGen || 0) || !container.isConnected) { unhookSkip(); return; }
skipped = true; unhookSkip();
var last = null;
for (var sp = 0; sp < paragraphs.length; sp++) for (var sn = 0; sn < paragraphs[sp].length; sn++) {
var se = paragraphs[sp][sn]; if (se.node) { se.node.textContent = se.fullText; last = se.node; }
}
if (last && last.parentNode) last.parentNode.insertBefore(cursor, last.nextSibling);
pIdx = paragraphs.length;
finish();
}
function onSkipPointer(ev) { if (ev.target && ev.target.closest && ev.target.closest('button, a, input, textarea, select, tw-link, tw-expression, [role="button"]')) return; skipAll(); }
function onSkipKey(ev) { if (ev.target && ev.target.closest && ev.target.closest('input, textarea, select')) return; if (ev.key === ' ' || ev.key === 'Enter') { ev.preventDefault(); ev.stopPropagation(); skipAll(); } }
function unhookSkip() { document.removeEventListener('pointerdown', onSkipPointer, true); document.removeEventListener('keydown', onSkipKey, true); if (myGen !== (window._passageGen || 0) || !container.isConnected) dropSkipHint(); }
document.addEventListener('pointerdown', onSkipPointer, true);
document.addEventListener('keydown', onSkipKey, true);
function typeStep() {
if (skipped) return;
if (myGen !== (window._passageGen || 0)) { unhookSkip(); return; } // passage swapped — abort
if (!container.isConnected) return; // container removed from DOM
if (pIdx >= paragraphs.length) { finish(); return; }
var para = paragraphs[pIdx];
// At the start of a paragraph, derive its per-key speed from its length so the
// whole paragraph types out in ~TARGET_MS (clamped to keep keys audible).
if (nIdx === 0 && cIdx === 0) {
var cc = 0, fast = false;
for (var k = 0; k < para.length; k++) { if (para[k].fullText) cc += para[k].fullText.replace(/\s/g, '').length; if (para[k].fast) fast = true; }
curCharMs = fast ? FAST_CHAR_MS : Math.max(MIN_CHAR_MS, Math.min(MAX_CHAR_MS, Math.round(TARGET_MS / Math.max(1, cc))));
curFast = fast;
}
if (nIdx >= para.length) {
// Paragraph finished — rest a beat (cursor blinking), then the next one.
// The pause is jittered around PARA_PAUSE so the rhythm feels human.
pIdx++; nIdx = 0; cIdx = 0;
setTimeout(typeStep, Math.max(300, PARA_PAUSE + Math.floor(Math.random() * PARA_JITTER) - Math.floor(PARA_JITTER / 2)));
return;
}
var entry = para[nIdx];
if (entry.pause) { nIdx++; cIdx = 0; setTimeout(typeStep, entry.pause); return; } // author-placed beat
if (cIdx >= entry.fullText.length) { nIdx++; cIdx = 0; setTimeout(typeStep, curCharMs); return; }
var ch = entry.fullText.charAt(cIdx++);
entry.node.textContent = entry.fullText.slice(0, cIdx);
if (entry.node.parentNode && entry.node.nextSibling !== cursor) {
entry.node.parentNode.insertBefore(cursor, entry.node.nextSibling);
}
if (!silent && window.dssAudio && window.dssAudio.typewriterTick && ch !== ' ' && ch !== '\n' && ch !== '\t') {
try { window.dssAudio.typewriterTick(); } catch (e) {}
}
rollToCursor();
// A slight pause after a sentence ends (mid-paragraph), so sentences breathe.
// Only breathe at a REAL sentence end: a . ! ? immediately followed by a space,
// newline, closing quote/paren, or the end of the text — and NOT part of an
// ellipsis or a mid-word/decimal period. Otherwise the (now faster) typing
// stalls on every "…", abbreviation and decimal point, which reads as choppy.
var _nx = entry.fullText.charAt(cIdx);
var _sentenceEnd = (ch === '.' || ch === '!' || ch === '?')
  && (_nx === '' || _nx === ' ' || _nx === '\n' || _nx === '\t' || _nx === '"' || _nx === '”' || _nx === '’' || _nx === ')' || _nx === ']')
  && !(ch === '.' && (_nx === '.' || entry.fullText.charAt(cIdx - 2) === '.'));
var extra = (!curFast && _sentenceEnd) ? SENTENCE_PAUSE : 0;
setTimeout(typeStep, curCharMs + extra + Math.floor(Math.random() * 6) - 2);
}

// Pre-warm the audio context (a silent tick) so the first click isn't dropped
// while the context is still waking from the navigation click.
if (window.dssAudio && window.dssAudio.typewriterTick) {
  try { window.dssAudio.typewriterTick(0); } catch(e) {}
}
setTimeout(typeStep, START_DELAY);
}

// Watch for .typewriter-page appearing in the DOM
var observer = new MutationObserver(function() {
var page = document.querySelector('.typewriter-page');
if (page && !page.dataset.twTyping) {
page.dataset.twTyping = 'true';
// Force Courier on the container and every child element
var twFont = "'Courier New', Courier, monospace";
page.style.fontFamily = twFont;
var allEls = page.querySelectorAll('*');
for (var k = 0; k < allEls.length; k++) {
allEls[k].style.fontFamily = twFont;
}
// Per-page opt-out: pages marked .typewriter-static skip the type-on
// animation entirely — useful for short atmosphere reflections where
// the slow type-out feels like a wait rather than a beat.
var skipTypewriter = page.classList.contains('typewriter-static');
if (skipTypewriter) {
// Just make sure links are visible straight away — both macro and
// bracket forms, so future opacity-hiding CSS on .typewriter-static
// can't strand bracket links the way it stranded animated ones.
var linkEls = page.querySelectorAll('tw-expression, tw-link');
linkEls.forEach(function(el) {
el.style.opacity = '1';
el.style.pointerEvents = 'auto';
});
} else {
// Small delay to let Harlowe finish rendering
setTimeout(function() { typewriterEffect(page); }, 100);
}
}
});

observer.observe(document.body, { childList: true, subtree: true });
})();

// ====== LILY-GLIMPSE FADE ======
// .lily-glimpse spans fade in via the `lilyFadeIn` CSS animation on
// `.lily-glimpse.lily-fade` — handled entirely in CSS, no JS needed.
// (A previous session typed them out character-by-character; Dr Quill
// preferred the single opacity bloom.)

// ====== ALBA GOLDEN FLASH + MEMORY DISSOLVE ======
// Fires per-element (data-flashed marker) so each revelation / memory
// gets its own transition. Overlays self-remove once animation ends.
(function() {
function spawnFlash(cls) {
var el = document.createElement('div');
el.className = cls;
document.body.appendChild(el);
el.addEventListener('animationend', function() {
if (el.parentNode) el.parentNode.removeChild(el);
});
}
function albaTypewriter(em, startDelay) {
// Pre-warm the audio engine — same reason as the main typewriter: keeps
// the first soft click of the alba reveal from being swallowed by a
// still-suspending AudioContext.
if (window.dssAudio && window.dssAudio.typewriterTick) {
  try { window.dssAudio.typewriterTick(0); } catch(e) {}
}
var fullText = em.textContent;
em.textContent = '';
// Capture passage generation so a passage swap mid-reveal stops the chain
// — otherwise the soft alba clicks bleed onto the next passage.
var myAlbaGen = (window._passageGen || 0);
var cursor = document.createElement('span');
cursor.className = 'alba-tw-cursor';
cursor.textContent = '\u2588';
em.appendChild(cursor);
var i = 0;
function step() {
if (myAlbaGen !== (window._passageGen || 0)) return; // passage swapped
if (!em.isConnected) return; // element removed from DOM
if (i >= fullText.length) {
setTimeout(function() {
cursor.classList.add('alba-tw-cursor-fade');
}, 600);
return;
}
var ch = fullText[i++];
cursor.insertAdjacentText('beforebegin', ch);
// Soft typewriter click under the morning bell — quieter than the main
// typewriter (vol 0.09 vs default 0.18) so it sits under the chime rather
// than fighting it. Spaces and newlines stay silent (no key-strike for
// the space bar — the carriage doesn't click on whitespace travel).
if (window.dssAudio && window.dssAudio.typewriterTick && ch !== ' ' && ch !== '\n' && ch !== '\t') {
  try { window.dssAudio.typewriterTick(0.09); } catch(e) {}
}
var delay;
if (ch === '.' || ch === '!' || ch === '?') delay = 240;
else if (ch === ',' || ch === ';' || ch === ':') delay = 90;
else delay = 55 + Math.floor(Math.random() * 14) - 5;
setTimeout(step, delay);
}
setTimeout(step, startDelay || 1100);
}
var flashObserver = new MutationObserver(function() {
// Golden flash for alba revelation-box
var revBoxes = document.querySelectorAll('.revelation-box:not([data-flashed])');
revBoxes.forEach(function(rb) {
rb.setAttribute('data-flashed', '1');
spawnFlash(rb.classList.contains('revelation-lily') ? 'alba-flash-lily' : 'alba-flash-overlay');
// The "big noise" of an alba being caught — distant bell, four-and-a-
// half-second decay, rings under the typewriter's lead-in pause.
if (window.dssAudio && window.dssAudio.distantBell) window.dssAudio.distantBell();
// Kindle the matching header jewel in sync with the gong. The [header]
// passage (which fills the jewels from $alba) renders BEFORE the line is
// caught — on LINE 1 the (set:) runs in the passage body; on LINE 2/3 it
// runs on a (link:) click — so the jewel can't reflect the new line until
// the next navigation. Light it here so it swells the moment the line lands
// (the .alba-jewel 0.7s transition rides the bell); the next header render
// makes it permanent. Deferred ~200ms so the stat-bars lift has settled.
var albaIdx = rb.getAttribute('data-alba');
if (albaIdx) {
var jewelGen = (window._passageGen || 0);
setTimeout(function() {
if ((window._passageGen || 0) !== jewelGen) return;
var jewels = document.querySelectorAll('#stat-bars-lifted .alba-jewel');
if (!jewels.length) jewels = document.querySelectorAll('.alba-jewel');
var j = jewels[albaIdx - 1];
if (j) j.classList.add('alba-jewel-filled');
// 2026-10-14 (regression run: two stars beside "1/3" in the Cave): the count and the line under the header follow
// the star at once, in the header's own words for that count (the third line's wording waits on the header, as before)
var n = Array.prototype.filter.call(jewels, function(e) { return e.classList.contains('alba-jewel-filled'); }).length;
Array.prototype.forEach.call(document.querySelectorAll('.alba-count'), function(c) { c.textContent = n + '/3'; });
/* 2026-10-23: the live swap to "Two lines, now…" went with the header's running count */
}, 200);
}
var em = rb.querySelector('em');
if (em && !em.dataset.albaTyped) {
em.dataset.albaTyped = '1';
albaTypewriter(em, 1100);
}
});
// Violet dissolve for memory moments (lily-window OR inline .memory-moment)
var memories = document.querySelectorAll('.lily-window:not([data-flashed]), .memory-moment:not([data-flashed])');
memories.forEach(function(m) {
m.setAttribute('data-flashed', '1');
spawnFlash('alba-flash-violet');
});
});
flashObserver.observe(document.body, { childList: true, subtree: true });
})();

// ====== AUTO-GLOW SOLO LINK ======
// If a passage has exactly one active link (not greyed-out, not already
// a guided-link), glow it — same pulse as a manually-marked guided-link.
(function() {
var soloDebounce = null;
function checkSoloLink() {
var passage = document.querySelector('tw-passage');
if (!passage) return;
var allLinks = Array.from(passage.querySelectorAll('tw-link'));
allLinks.forEach(function(l) { l.classList.remove('auto-guided'); });
var active = allLinks.filter(function(l) {
return !l.closest('.greyed-out') && !l.closest('.guided-link') && !l.closest('.notebook-link');
});
if (active.length === 1) {
active[0].classList.add('auto-guided');
}
}
new MutationObserver(function() {
clearTimeout(soloDebounce);
soloDebounce = setTimeout(checkSoloLink, 350);
}).observe(document.body, { childList: true, subtree: true });
})();

// ====== ORNAMENT PASS (2026-09-12) ======
// Any tw-link, .haunt-header, .vh-label or heading whose text reads "⟡ … ⟡" gets its two
// lozenges replaced by drawn gold flourishes (CSS .dss-orn); the words are untouched, so
// the click-audio checks on link text and Harlowe's own handling are unaffected.
(function() {
  var ORN_RX = /^\s*⟡\s*([\s\S]*?)\s*⟡\s*$/;
  function decorate() {
    var els = document.querySelectorAll('tw-link, .haunt-header, .vh-label, .dss-rules-title, h1, h2, h3, h4');
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      if (el.getAttribute('data-orn') === '1' || el.children.length) continue;
      var bt = (el.textContent || '');
      if (el.tagName === 'TW-LINK' && /^\s*←\s*BACK\s*$/.test(bt)) { el.setAttribute('data-orn', '1'); el.textContent = ''; var ba = document.createElement('span'); ba.className = 'dss-back-arrow'; el.appendChild(ba); el.appendChild(document.createTextNode('BACK')); continue; }
      var m = ORN_RX.exec(bt);
      if (!m) continue;
      el.setAttribute('data-orn', '1');
      el.textContent = '';
      var l = document.createElement('span'); l.className = 'dss-orn dss-orn-l';
      var r = document.createElement('span'); r.className = 'dss-orn dss-orn-r';
      el.appendChild(l); el.appendChild(document.createTextNode(' ' + m[1] + ' ')); el.appendChild(r);
    }
  }
  function worldMinis() {
    var rows = document.querySelectorAll('.dream-ledger-entry');
    for (var i = 0; i < rows.length; i++) {
      var sym = rows[i].querySelector('.dream-ledger-symbol'), w = rows[i].querySelector('.dream-ledger-world');
      if (!sym || !w || sym.getAttribute('data-orn') === '1') continue;
      var key = { HIMALAYAS:'himalayas', NAZCA:'nazca', 'EASTER ISLAND':'easter', PYRAMID:'pyramid', EZEKIEL:'ezekiel', 'THE WHEEL':'ezekiel', GIZA:'pyramid', 'RAPA NUI':'easter' }[(w.textContent || '').trim().toUpperCase()];
      if (!key) continue;
      sym.setAttribute('data-orn', '1'); sym.classList.add('dream-world-' + key);
    }
  }
  var ornTimer = null;
  new MutationObserver(function() { clearTimeout(ornTimer); ornTimer = setTimeout(function(){ decorate(); worldMinis(); }, 120); }).observe(document.body, { childList: true, subtree: true });
  setTimeout(decorate, 300);
})();

// ====== THE AFTER-IMAGE (polish loop 2026-09-23) ======
// When a passage is left, a faint copy of it stays on the retina for under a
// second, fading and lifting a few pixels while the new passage waits its
// 0.55s before fading in. Nothing in the copy is live: links become spans,
// ids are dropped, scripts, frames, canvases and the stat bars are cut.
// Off entirely under prefers-reduced-motion. Set window.DSS_AFTERIMAGE = false
// (before the story starts) to switch it off.
(function() {
  if (window.DSS_AFTERIMAGE === false) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var STRIP = 'script, style, iframe, canvas, video, audio, .stat-bars, .header-links, #dss-notebook, ' +
    '.soho-map-wrap, .soho-map-stage, tw-dialog, .dss-ghost, [id$="-wrap"], .stat-bars-spacer, .dss-key-offer, ' +
    // 2026-10-07: the minigame frames styled by their own id (house of cards, beer mats, Harmony) lose that
    // style once the copy drops ids and styles, and their hidden result links ("cards-win") showed in the ghost
    '#dss-house-cards, #dss-beer-mats, #dss-harmony';
  var last = null, lastNb = null, ghost = null, ticking = false;
  function sample() {
    ticking = false;
    var nb = document.querySelector('tw-dialog .nb-page');
    if (nb) { var nr = nb.getBoundingClientRect(); if (nr.width) lastNb = { el: nb, top: nr.top, left: nr.left, width: nr.width, height: nr.height, when: Date.now() }; }
    var tp = document.querySelector('tw-story > tw-passage');
    if (!tp) return;
    var r = tp.getBoundingClientRect();
    if (r.width === 0) return;
    var cs = getComputedStyle(tp);
    last = { el: tp, top: r.top, left: r.left, width: r.width, height: r.height, padTop: cs.paddingTop, maxW: cs.maxWidth, when: Date.now() };
  }
  function queue() { if (!ticking) { ticking = true; requestAnimationFrame(sample); } }
  ['click', 'pointerdown', 'keydown', 'scroll', 'resize'].forEach(function(ev) {
    window.addEventListener(ev, queue, { capture: true, passive: true });
  });
  setInterval(queue, 400);
  function show(old) {
    if (!last || last.el !== old || Date.now() - last.when > 4000) return;
    if (last.top > window.innerHeight || last.top + last.height < 0) return;
    if (ghost) { ghost.remove(); ghost = null; }
    var g = document.createElement('div');
    g.className = 'dss-ghost';
    g.setAttribute('aria-hidden', 'true');
    var inner = old.cloneNode(true);
    inner.querySelectorAll(STRIP).forEach(function(n) { n.remove(); });
    inner.querySelectorAll('[id]').forEach(function(n) { n.removeAttribute('id'); });
    inner.querySelectorAll('tw-link, .enchantment-link, button, a').forEach(function(n) {
      var sp = document.createElement('span');
      sp.className = 'dss-ghost-link ' + (n.className || '');
      sp.innerHTML = n.innerHTML;
      n.parentNode.replaceChild(sp, n);
    });
    inner.style.cssText = 'padding-top:' + last.padTop + ';max-width:' + last.maxW + ';width:' + last.width + 'px;animation:none;opacity:1;margin:0;';
    var top = Math.max(0, last.top), bottom = Math.min(window.innerHeight, last.top + last.height);
    g.style.cssText = 'top:' + last.top + 'px;left:' + last.left + 'px;width:' + last.width + 'px;height:' + last.height + 'px;' +
      'clip-path: inset(' + (top - last.top) + 'px 0 ' + (last.top + last.height - bottom) + 'px 0);';
    g.appendChild(inner);
    (document.querySelector('tw-story') || document.body).appendChild(g);
    settle(g, last);
    // anything the passage pinned to the viewport (margin notes, badges) is not part of the page's after-image
    var pinned = [];
    inner.querySelectorAll('*').forEach(function(n) { var ps = getComputedStyle(n).position; if (ps === 'fixed' || ps === 'sticky') pinned.push(n); });
    pinned.forEach(function(n) { if (n.parentNode) n.remove(); });
    ghost = g;
    setTimeout(function() { if (g.parentNode) g.remove(); if (ghost === g) ghost = null; }, 1100);
  }
  // a fixed box inside tw-story sits relative to tw-story where a backdrop-filter makes it the containing block (WebKit); measure and nudge
  function settle(g, r) {
    var gr = g.getBoundingClientRect();
    if (Math.abs(gr.top - r.top) > 0.5 || Math.abs(gr.left - r.left) > 0.5) { g.style.top = (parseFloat(g.style.top) + (r.top - gr.top)) + 'px'; g.style.left = (parseFloat(g.style.left) + (r.left - gr.left)) + 'px'; }
  }
  // the notebook, closed: the page stays on the eye a moment
  function showNb(page) {
    if (!lastNb || lastNb.el !== page || Date.now() - lastNb.when > 4000) return;
    var g = document.createElement('div');
    g.className = 'dss-ghost dss-ghost-nb';
    g.setAttribute('aria-hidden', 'true');
    var inner = page.cloneNode(true);
    inner.querySelectorAll(STRIP).forEach(function(n) { n.remove(); });
    inner.querySelectorAll('[id]').forEach(function(n) { n.removeAttribute('id'); });
    inner.querySelectorAll('[onclick]').forEach(function(n) { n.removeAttribute('onclick'); });
    [].slice.call(inner.attributes).forEach(function(a) { if (/^data-/.test(a.name)) inner.removeAttribute(a.name); });
    inner.querySelectorAll('tw-link, .enchantment-link, button, a').forEach(function(n) {
      var sp = document.createElement('span');
      sp.className = 'dss-ghost-link ' + (n.className || '');
      sp.innerHTML = n.innerHTML;
      n.parentNode.replaceChild(sp, n);
    });
    g.style.cssText = 'top:' + lastNb.top + 'px;left:' + lastNb.left + 'px;width:' + lastNb.width + 'px;height:' + lastNb.height + 'px;';
    g.appendChild(inner);
    (document.querySelector('tw-story') || document.body).appendChild(g);
    settle(g, lastNb);
    setTimeout(function() { if (g.parentNode) g.remove(); }, 1100);
  }
  function watch() {
    var story = document.querySelector('tw-story');
    if (!story) { setTimeout(watch, 200); return; }
    new MutationObserver(function(muts) {
      for (var i = 0; i < muts.length; i++) {
        var rm = muts[i].removedNodes;
        for (var j = 0; j < rm.length; j++) {
          if (rm[j].nodeType === 1 && rm[j].tagName === 'TW-PASSAGE') { try { show(rm[j]); } catch (e) {} return; }
          if (rm[j].nodeType === 1 && (rm[j].tagName === 'TW-BACKDROP' || rm[j].tagName === 'TW-DIALOG')) { var nbp = rm[j].querySelector('.nb-page'); if (nbp) { try { showNb(nbp); } catch (e) {} return; } }
        }
      }
    }).observe(story, { childList: true });
    queue();
  }
  watch();
})();

// ====== THE COLOUR OF THE ROOM JUST LEFT (beauty loop 2026-09-24) ======
// Step out of the Colony and its green is still on the eye; wake from the
// mountain and the blue is still there for a few seconds. When a passage
// that carries a room's or a world's colour is left for one that does not
// carry the same colour, a fixed wash of that colour arrives with the new
// passage and fades over six seconds. Opacity only, no movement, so it stays
// under reduced motion. Set window.DSS_AFTERGLOW = false to switch it off.
(function() {
  if (window.DSS_AFTERGLOW === false) return;
  var TINTS = {
    'venue-french': '212,165,116', 'venue-colony': '120,150,100', 'venue-cellar': '100,120,160',
    'venue-trishas': '180,100,110', 'venue-ronnies': '140,120,180', 'venue-cecilcourt': '200,160,80',
    'venue-coach': '200,160,100', 'venue-lackland': '190,150,90', 'venue-lackland-back': '190,150,90',
    'himalayan': '150,196,245', 'nazca': '236,168,96', 'easter': '96,214,200', 'pyramid': '226,186,96',
    'ezekiel': '196,128,230', 'sanctum': '214,204,170', 'synthesis': '214,204,170', 'dream': '150,160,210',
    'pyre': '226,140,70', 'green-sea': '96,190,190',
    // the strangers at the edges (2026-09-25): their pool's colour comes back to Dean Street with you
    'stranger-gooch': '232,190,96', 'stranger-fetch': '170,190,220', 'stranger-truze': '168,196,150', 'stranger-line': '150,196,196',
    'stranger-longshanks': '180,160,220', 'stranger-songstrong': '220,150,120'
  };
  var ORDER = Object.keys(TINTS);
  function keyOf(tags) {
    tags = ' ' + (tags || '') + ' ';
    if (tags.indexOf(' venue-gents ') !== -1) return null;
    for (var i = 0; i < ORDER.length; i++) if (tags.indexOf(' ' + ORDER[i] + ' ') !== -1) return ORDER[i];
    return null;
  }
  var glow = null;
  function show(oldTags, newTags) {
    var k = keyOf(oldTags);
    if (!k || keyOf(newTags) === k) return;
    if (glow) { glow.remove(); glow = null; }
    var g = document.createElement('div');
    g.className = 'dss-afterglow';
    g.setAttribute('aria-hidden', 'true');
    g.style.background = 'radial-gradient(ellipse 60% 50% at 50% 42%, rgba(' + TINTS[k] + ',' + (window.DSS_AFTERGLOW_ALPHA || 0.32) + '), transparent 72%)';
    document.body.appendChild(g);
    glow = g;
    requestAnimationFrame(function() { requestAnimationFrame(function() { g.style.opacity = '0'; }); });
    setTimeout(function() { if (g.parentNode) g.remove(); if (glow === g) glow = null; }, 6500);
  }
  function watch() {
    var story = document.querySelector('tw-story');
    if (!story) { setTimeout(watch, 200); return; }
    var lastTags = story.getAttribute('tags') || '';
    new MutationObserver(function(muts) {
      for (var i = 0; i < muts.length; i++) {
        var rm = muts[i].removedNodes;
        for (var j = 0; j < rm.length; j++) {
          if (rm[j].nodeType === 1 && rm[j].tagName === 'TW-PASSAGE') {
            var oldTags = rm[j].getAttribute('tags') || lastTags;
            setTimeout(function() {
              var np = document.querySelector('tw-story > tw-passage');
              try { show(oldTags, np ? (np.getAttribute('tags') || '') : (story.getAttribute('tags') || '')); } catch (e) {}
            }, 30);
            return;
          }
        }
      }
    }).observe(story, { childList: true });
  }
  watch();
})();

// ====== SIGNPOSTED CHOICES (2026-09-23) ======
// Every plain navigation link at the end of a passage is marked by where it
// leads, so the eye can tell an onward step from a retreat to the street or
// a door into a dream: data-dss-way="on" | "street" | "dream". The first
// link of the run gets data-dss-first (the ornament rule is drawn above it)
// and each gets --dss-i for the staggered reveal. The words are untouched.
// Targets are read from the story data at boot (Harlowe 3.3 puts no
// passage-name on <tw-link>), keyed on the passage's tags + the link text.
// Links inside bespoke containers (choice boxes, drink menus, minigame exits,
// dialogs, the notebook…) and links that only reveal text are left alone.
(function() {
  var byTagsText = {}, byText = {}, tagsOf = {};
  var SKIP = '.choice-box, .colony-drinks, .french-drinks, .drink-menu, .dss-mini-exit, .approach-back, ' +
    '.back-one-link, .notebook-link, .phone-exit, .phone-ringing, .guided-link, .gents-side-action, ' +
    '.title-begin, .dream-sequence, .reclamation-invite, .book-naming, .nb-inv-eat, ' +
    '.canvas-bail, .typewriter-page, .worm-payment, .dss-night-choice, .dss-dawn-choice, ' +
    'tw-dialog, .lore-box, .greyed-out, .soho-map-wrap, #dean-lamp, .night-record, .critic-replies'; /* 2026-10-19 overnight: the critic's replies are buttons of their own */
  var DREAM_TAGS = /\b(dream|minigame|waltz-game|pong|reclamation|nazca|pyramid|easter|himalayan|ezekiel|pyre|sanctum|synthesis|green-sea|carthage-shore)\b/;
  var STREET_TAGS = /\b(outdoor|street-night)\b/;
  function add(map, key, target) {
    if (!map[key]) map[key] = [];
    if (map[key].indexOf(target) === -1) map[key].push(target);
  }
  function index() {
    var data = document.querySelectorAll('tw-passagedata');
    for (var i = 0; i < data.length; i++) {
      var name = data[i].getAttribute('name'), tags = data[i].getAttribute('tags') || '';
      tagsOf[name] = ' ' + tags + ' ';
      var src = data[i].textContent || '', m;
      var rx1 = /\[\[([^\]\|]+?)\s*(?:\||->)\s*([^\]\|]+?)\]\]/g;              // [[text|target]] / [[text->target]]
      var rx2 = /\(link-goto:\s*"([^"]+)"\s*,\s*"([^"]+)"\s*\)/g;                 // (link-goto: "text", "target")
      var rx3 = /\(link:\s*"([^"]+)"\s*\)\[(?:(?!\]\]|\(link)[\s\S]){0,400}?\(go-to:\s*"([^"]+)"\s*\)/g; // (link: "text")[…(go-to: "target")]
      var rx4 = /\[\[([^\]\|>]+?)\]\]/g;                                          // [[target]]
      [rx1, rx2, rx3, rx4].forEach(function(rx) {
        while ((m = rx.exec(src))) {
          var text = m[1].trim(), target = (m[2] || m[1]).trim();
          if (rx === rx3 && /\(set:/.test(m[0])) target = '!' + target;   // a link with a cost is a choice, not a retreat
          add(byTagsText, tags + '\u0001' + text, target);
          add(byText, text, target);
        }
      });
    }
  }
  function classify(target, here) {
    if (target.charAt(0) === '!') return 'on';
    var t = tagsOf[target];
    if (!t) return null;
    if (/ hub /.test(t)) return 'street';
    if (DREAM_TAGS.test(t) && !DREAM_TAGS.test(here)) return 'dream';
    if (STREET_TAGS.test(t) && !STREET_TAGS.test(here) && !/ hub /.test(here)) return 'street';
    return 'on';
  }
  function wayFor(text, here) {
    var here0 = here.trim();
    var cands = byTagsText[here0 + '\u0001' + text] || byText[text] || [];
    var way = null;
    for (var i = 0; i < cands.length; i++) {
      var w = classify(cands[i], here);
      if (!w) continue;
      if (way && way !== w) { way = null; break; }
      way = w;
    }
    if (way) return way;
    if (!cands.length) return null;                  // reveal-only (link:) — not navigation
    return /^(back\b|not (yet|tonight)\b|leave\b|dean street\b|the street\b)/i.test(text) ? 'street' : 'on';
  }
  // afternoon loop 2026-10-05: the departure fade asks the same index whether a pressed link goes anywhere
  window.dssLinkNavigates = function(text, here) {
    var cands = byTagsText[(here || '').trim() + '\u0001' + text] || byText[text] || [];
    return cands.length > 0;
  };
  function mark() {
    var passage = document.querySelector('tw-passage');
    if (!passage) return;
    var here = ' ' + (passage.getAttribute('tags') || '') + ' ';
    if (/ (hub|system|startup|night-ahead|white-page|black-page|dawn-approach) /.test(here)) return;
    var links = passage.querySelectorAll('tw-link'), batch = 0;
    var ruled = !!passage.querySelector('.dss-choice-rule');
    for (var i = 0; i < links.length; i++) {
      var l = links[i];
      if (l.hasAttribute('data-dss-way') || l.hasAttribute('data-dss-skip')) continue;
      var text = (l.textContent || '').trim();
      if (!text || text === '·' || /^\s*⟡/.test(text) || /^(?:←\s*)?BACK$/.test(text) || l.closest(SKIP) || l.getAttribute('style')) { l.setAttribute('data-dss-skip', '1'); continue; }
      var way = wayFor(text, here);
      if (!way) { l.setAttribute('data-dss-skip', '1'); continue; }
      l.setAttribute('data-dss-way', way);
      l.style.setProperty('--dss-i', String(batch++));
      if (!ruled) {
        ruled = true;
        var rule = document.createElement('span'); rule.className = 'dss-choice-rule';
        var at = (l.parentElement && l.parentElement.tagName === 'TW-EXPRESSION') ? l.parentElement : l;
        at.parentNode.insertBefore(rule, at);
      }
    }
  }
  var timer = null;
  function schedule() { clearTimeout(timer); timer = setTimeout(mark, 60); }
  function boot() {
    index();
    new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true });
    schedule();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  window.dssSignpost = { mark: mark, wayFor: wayFor };
})();

// ====== LORE BOX OPENING SOUND ======
// Lore boxes are wrapped in (link: "⟡ LORE: ...")[<div class="lore-box">...]
// Harlowe replaces the link with the hook contents on click. We use the
// capture phase so we definitely get the event before Harlowe consumes it
// or replaces the element. Belt-and-braces: also a MutationObserver that
// fires the rustle whenever a NEW .lore-box appears in the DOM that wasn't
// already there at passage load.
(function() {
  // Uniform link-click tick — every tw-link gets a soft typewriter
  // tap when clicked. The writer is at his notebook all night.
  // Skip hidden navigation links (the '·' dots) and the BACK link
  // since they have their own audio identities or are silent by design.
  // Also skip links inside .ending-pane (Centre Point endings) — those
  // moments are silent by design.
  var _lastTick = 0;
  document.addEventListener('click', function(e) {
    var link = e.target && e.target.closest && e.target.closest('tw-link');
    if (!link) return;
    if (link.closest('.next-poke')) return; // the footer's hidden NEXT redraw is silent
    var txt = (link.textContent || '').trim();
    if (txt === '·' || txt === '·' || txt === '') return;
    if (/^(?:←\s*)?BACK$/.test(txt)) return; // ← BACK has its own implication
    if (txt === 'BEGIN') return; // start-of-game BEGIN is silent
    if (link.getAttribute('data-auto-expand') === '1') return; // auto-expand on revisit is silent
    if (link.closest('.ending-pane')) return;
    if (window._dssDepartReplay) return; /* 2026-10-19 (Sam, playtest: "it seems to make a 'double click' sound ... it should be only one click"): the depart's replay of the same press is silent */
    var now = Date.now();
    if (now - _lastTick < 80) return;
    _lastTick = now;
    if (window.dssAudio && window.dssAudio.typewriterTick) {
      window.dssAudio.typewriterTick(0.10);
    }
  }, true);
  // Window-level Set tracks which lore titles the player has opened this
  // session. Lives in memory only (resets on page reload, which we treat as
  // "starting fresh"). Harlowe's $seenLore array proved unreliable for
  // mutate-from-JS-then-read-on-next-passage; this avoids the round-trip.
  if (!window.dssSeenLore) window.dssSeenLore = new Set();
  document.addEventListener('click', function(e) {
    var link = e.target && e.target.closest && e.target.closest('tw-link');
    if (!link) return;
    var txt = (link.textContent || '').toUpperCase();
    if (txt.indexOf('LORE') === -1) return;
    // Suppress unravel sound for auto-expansions on revisit — those are
    // restorations, not fresh discoveries.
    if (link.getAttribute('data-auto-expand') === '1') return;
    if (window.dssAudio && window.dssAudio.loreUnravel) {
      window._dssLoreRustleAt = Date.now(); /* 2026-10-19 overnight: the box watcher below stays quiet for this one (it was a double rustle) */
      window.dssAudio.loreUnravel();
    }
    var title = (link.textContent || '').trim();
    if (title) window.dssSeenLore.add(title);
  }, true);
  // Tap on an already-taken lily — play a soft hollow chime so the player
  // gets feedback (the flower's gone, there's nothing to pick). Quieter
  // than the collection lilyChime and pitched lower. Throttled so a quick
  // double-tap doesn't fire twice.
  var _lastTakenChime = 0;
  document.addEventListener('click', function(e) {
    var taken = e.target && e.target.closest && e.target.closest('.lily-taken');
    if (!taken) return;
    // Fade the spent flower on every poke (even inside the throttle window)
    // so the visual feedback always tracks the click.
    if (window.dssLilyBlip) window.dssLilyBlip(taken.querySelector('.lily-prompt') || taken);
    var now = Date.now();
    if (now - _lastTakenChime < 400) return;
    _lastTakenChime = now;
    if (!window.dssAudio) return;
    // The flower's already gone — a low, dull "block" thunk rather than the
    // bright collection chime, so the player reads it as "nothing to pick".
    if (window.dssAudio.lilyBlock) {
      window.dssAudio.lilyBlock();
    } else if (window.dssAudio.lilyChime) {
      window.dssAudio.lilyChime();
    }
  }, true);

  // Fallback: watch for lore-boxes appearing AFTER initial passage render.
  // We tag every box that's already in the DOM at the time a new passage
  // loads as "seen" so the haunt-explainer (rendered inline on first haunt)
  // doesn't trigger the rustle.
  var seen = new WeakSet();
  function tagExisting() {
    var boxes = document.querySelectorAll('.lore-box');
    for (var i = 0; i < boxes.length; i++) seen.add(boxes[i]);
  }
  // Re-tag whenever Harlowe swaps in a new passage.
  new MutationObserver(function(mutations) {
    var passageSwapped = false;
    for (var i = 0; i < mutations.length; i++) {
      var m = mutations[i];
      for (var j = 0; j < m.addedNodes.length; j++) {
        var n = m.addedNodes[j];
        if (n.nodeType !== 1) continue;
        if (n.tagName === 'TW-PASSAGE') passageSwapped = true;
      }
    }
    if (passageSwapped) {
      /* Auto-expand any LORE link that the player has opened before. Tag
         the link with data-auto-expand BEFORE clicking so the click-tick
         and unravel sound both skip it. Pre-snapshot the existing
         lore-boxes so we can tag the newly-revealed ones with .lore-seen
         (greyed) once Harlowe replaces the links with their hook bodies.
         Delay 250ms is enough for Harlowe to wire up tw-link click
         handlers on the freshly-rendered passage. */
      setTimeout(function(){
        tagExisting();
        try {
          var seenSet = window.dssSeenLore;
          if (window.dssLore) return; // 2026-10-13: LORE notes are footnotes now (dssLore); a note read before is not printed inline again
          if (!seenSet || !seenSet.size) return;
          var preBoxes = new Set();
          var preDoc = document.querySelectorAll('.lore-box');
          for (var pb = 0; pb < preDoc.length; pb++) preBoxes.add(preDoc[pb]);
          var links = document.querySelectorAll('tw-link');
          var clickedAny = false;
          for (var i = 0; i < links.length; i++) {
            var ln = links[i];
            var lnTxt = (ln.textContent || '').trim();
            if (!lnTxt || lnTxt.toUpperCase().indexOf('LORE') === -1) continue;
            if (!seenSet.has(lnTxt)) continue;
            ln.setAttribute('data-auto-expand', '1');
            try { ln.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); }
            catch(e) { try { ln.click(); } catch(e2) {} }
            clickedAny = true;
          }
          if (clickedAny) {
            setTimeout(function() {
              var post = document.querySelectorAll('.lore-box');
              for (var pp = 0; pp < post.length; pp++) {
                if (!preBoxes.has(post[pp])) {
                  post[pp].classList.add('lore-seen');
                  // Also tag for the existing 'seen' WeakSet so the sound
                  // observer doesn't fire the unravel rustle for it.
                  seen.add(post[pp]);
                }
              }
            }, 60);
          }
        } catch(e) {}
      }, 250);
    } else {
      // No passage swap — any lore-box added now is from a click expansion.
      var boxes = document.querySelectorAll('.lore-box');
      for (var b = 0; b < boxes.length; b++) {
        /* 2026-10-19 overnight: a hidden box (the header's copy of THE GREAT WORK) or a page-turn after-image's clone is not a note
           being opened; without this the rustle played on nearly every page turn */
        if (boxes[b].closest('[hidden], .dss-ghost, #dss-lore-greatwork')) { seen.add(boxes[b]); continue; }
        if (!seen.has(boxes[b])) {
          seen.add(boxes[b]);
          if (Date.now() - (window._dssLoreRustleAt || 0) < 900) continue; /* the link's own click just rustled */
          if (window.dssAudio && window.dssAudio.loreUnravel) {
            window._dssLoreRustleAt = Date.now();
            window.dssAudio.loreUnravel();
            break; // only one rustle per click expansion
          }
        }
      }
    }
  }).observe(document.body, { childList: true, subtree: true });
  // Initial tag pass
  tagExisting();
})();

// ====== PASSAGE FADE LOCK ======
// tw-passage has a CSS `passageFadeIn` animation (0.55s delay + 0.55s fade).
// If anything mutates the element's animation/style after that — including
// some Harlowe (link:) click expansions which can briefly reset opacity on
// the parent during the in-place hook swap — the animation can re-trigger
// and the player sees a flash that looks like a full passage reload.
// Once a passage has finished fading in, we lock its opacity to 1 and clear
// the animation so any later in-place mutation can't replay the fade.
// New passages (real navigation) get a fresh tw-passage element and run
// the animation normally before being locked again.
(function() {
  document.addEventListener('animationend', function(e) {
    if (e.animationName !== 'passageFadeIn') return;
    var p = e.target;
    if (!p || p.tagName !== 'TW-PASSAGE') return;
    p.style.animation = 'none';
    p.style.opacity = '1';
  }, true);
})();

// ====== PASSAGE DEPART (afternoon loop 2026-10-05) ======
// A page used to switch off the instant a link was pressed and the next one faded in
// half a second later. Now the leaving page dims for a quarter of a second first: a
// click on a passage link is held, tw-story is marked departing (the passage, a plain
// page's panel and a room's veil fade together, see the stylesheet), and the same
// link is clicked again when the fade is done. Only tw-links that name a passage
// take part, so (link:) hooks that change words in place still answer at once. The
// held click never reaches Harlowe, so no script ever sees two passages. Under
// reduced motion nothing is held. (The first try keyed on tw-link[passage-name]; Harlowe
// 3.3.9 writes no such attribute, see the test below.) The dim stops at the after-image's
// starting opacity so the ghost continues the same movement; without the after-image it
// goes to black (--dss-depart-to, read by the stylesheet).
(function() {
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var MS = 240, passing = false, pending = null;
  if (window.DSS_AFTERIMAGE === false) { var st = document.querySelector('tw-story'); if (st) st.style.setProperty('--dss-depart-to', '0'); }
  document.addEventListener('click', function(e) {
    if (passing || e.defaultPrevented) return;
    var link = e.target && e.target.closest && e.target.closest('tw-link');
    if (!link || !link.closest('tw-passage, .dss-threshold, .dss-room-veil')) return; // the lifted header's NOTEBOOK stays instant
    if (link.closest('.next-poke')) return; // the footer's hidden NEXT redraw is not a step
    var story = link.closest('tw-story'), tp = document.querySelector('tw-passage');
    if (!story || !tp) return;
    // Harlowe 3.3 puts no passage name on a link: a [[link]] sits in a link-goto expression; a
    // (link:) hook that ends in (go-to:) is known from the signposting index of the story data
    var pe = link.parentElement, goes = !!(pe && pe.tagName === 'TW-EXPRESSION' && /^link-goto$/.test(pe.getAttribute('name') || ''));
    if (!goes && window.dssLinkNavigates) goes = window.dssLinkNavigates((link.textContent || '').trim(), tp.getAttribute('tags') || '');
    if (!goes) return;
    e.stopPropagation(); e.preventDefault();
    if (pending) return; // a second press during the fade is the same press
    pending = link;
    story.classList.add('dss-departing');
    setTimeout(function() {
      pending = null;
      story.classList.remove('dss-departing');
      if (!link.isConnected) return;
      passing = true; window._dssDepartReplay = true; /* the replayed press makes no second tick (2026-10-19) */
      try { link.click(); } finally { passing = false; window._dssDepartReplay = false; }
    }, MS);
  }, true);
})();

// ====== DEAN STREET LAMP DYNAMIC HEIGHT ======
// The pole must end exactly at the bottom of the last visible text or link
// on the page. We measure by finding the actual bottom pixel of the last
// visible content element, ignoring padding, empty hooks, and the lamp itself.
(function() {
var sizeTimer = null;

function findContentBottom(passage, lamp) {
var passageTop = passage.getBoundingClientRect().top;
var els = passage.getElementsByTagName('*');

// PASS A: find the first block that CLEARS the float. Everything from there
// down sits below the lamp by definition and is none of its business —
// measuring to it feeds the lamp's own height back into the measurement.
var clearEl = null;
for (var i = 0; i < els.length; i++) {
var el = els[i];
if (el === lamp || lamp.contains(el)) continue;
var cs = window.getComputedStyle(el);
if (cs.display === 'none' || cs.visibility === 'hidden') continue;
var r = el.getBoundingClientRect();
// 2026-10-05 overnight: the hub's door links are docked off-screen in a 1 px box once the map
// takes them; their wrapped text still measures a thousand pixels tall under overflow:hidden,
// and the pole was sizing to it (a 500 px dead column under the map at 1440x900)
if (r.right <= 0 || (el.closest && el.closest('.soho-hub-dock'))) continue;
// Zero-size first, deliberately: an EMPTY block that happens to clear is not
// really below the float, and halting on one stopped the whole measurement at
// the date strap — the pole came out ~250px, cut off above where it starts,
// and every line under it ran across the lamp's gutter (Sam, 2026-09-15).
if (r.height === 0 || r.width === 0) continue;
if (cs.clear && cs.clear !== 'none') { clearEl = el; break; }
}

// PASS B: the bottom of the last real content ABOVE that block.
var maxBottom = passageTop;
for (var k = 0; k < els.length; k++) {
var e = els[k];
if (e === lamp || lamp.contains(e)) continue;
if (clearEl) {
  if (e === clearEl) break;
  // ...AND SKIP ANY WRAPPER THAT CONTAINS IT. This is the one that bit:
  // Harlowe wraps passage content in nested tw-hooks, and one of them encloses
  // both the prose AND the map container. Its own box therefore includes the
  // map — the very thing the clear was pushing out of range — so the "content
  // bottom" tracked the lamp's height one-for-one. Measured: with the lamp at
  // 20000px this returned 20592. Two passes landed short of it (a dead strip
  // at 600px wide) and iterating chased it off the page. Excluding wrappers
  // that straddle the clear makes the measurement a fixed point, which is what
  // it was always supposed to be.
  if (e.contains(clearEl)) continue;
}
var cs2 = window.getComputedStyle(e);
if (cs2.display === 'none' || cs2.visibility === 'hidden') continue;
var r2 = e.getBoundingClientRect();
if (r2.right <= 0 || (e.closest && e.closest('.soho-hub-dock'))) continue;
if (r2.height === 0 || r2.width === 0) continue;
if (r2.bottom > maxBottom) maxBottom = r2.bottom;
}
return maxBottom - passageTop;
}

function sizeLamp() {
var lamp = document.getElementById('dean-lamp-svg');
var passage = document.querySelector('tw-passage');
if (!lamp || !passage || !lamp.parentNode) return;

// Below 640px the Soho map wrap CLEARS this float (CSS), so the map sits under
// the lamp. Sizing the lamp to the whole passage then feeds back: the map is
// pushed below the lamp, the content bottom grows, the lamp grows to meet it,
// until the map is ~2000px down a black column. On the narrow layout the lamp
// only keeps the title block company: measure to the top of the map instead.
function measure() {
  // Below the stylesheet's breakpoint the map CLEARS this float and sits under
  // it, so the lamp's business ends at the top of the map, not at the bottom of
  // the passage -- measuring to the passage bottom there would include the map
  // the lamp has itself pushed down, and the page grows a dead column.
  //
  // Which side of the breakpoint we are on is a CSS decision. This used to
  // repeat it as a matchMedia('(max-width: 640px)') string: two copies of one
  // number, kept in step by hand, and when the breakpoint moved to 1100 they
  // would have silently disagreed across the whole new band. Read the computed
  // `clear` off the container instead and the number lives in one place.
  var mapC = document.getElementById('soho-map-container');
  var cleared = false;
  try {
    if (mapC && window.getComputedStyle) {
      var cs = window.getComputedStyle(mapC);
      cleared = !!cs.clear && cs.clear !== 'none';
    }
  } catch (e) {}
  if (cleared && mapC) {
    return mapC.getBoundingClientRect().top - passage.getBoundingClientRect().top - 8;
  }
  return findContentBottom(passage, lamp);
}

// measure() reports the content bottom relative to the PASSAGE top, but the
// lamp starts lower than that (below the header rule). Subtract its own offset
// or the pole always overshoots by that much — which pushed every cleared
// block down the page and opened the dead column (Sam, 2026-09-13).
function lampOffset() {
return lamp.getBoundingClientRect().top - passage.getBoundingClientRect().top;
}
// TWO PASSES, DELIBERATELY BOUNDED. Pass 1 collapses the float and measures the
// natural content bottom; pass 2 re-measures once, because with the float active
// the text has reflowed narrower and grown. It is tempting to iterate to
// convergence instead, and it does not work: below the breakpoint the target is
// the top of a block that CLEARS this float, so every pixel added to the lamp
// moves the target by a pixel and the loop chases its own tail. Tried, measured,
// reverted -- it reached 5254px on a 600px-wide window. Two passes cannot run
// away, which matters more here than landing exactly.
lamp.setAttribute('height', '1');
var h = measure() - lampOffset();
if (h < 50) h = 50;
lamp.setAttribute('height', Math.ceil(h));

// rAF stalls in a backgrounded tab, so a timeout backs it up.
var repassed = false;
function pass2() {
if (repassed) return; repassed = true;
var h2 = measure() - lampOffset();
if (h2 < 50) h2 = 50;
lamp.setAttribute('height', Math.ceil(h2));
}
requestAnimationFrame(pass2);
setTimeout(pass2, 120);
}

// Debounced: waits 600ms after last DOM change (after gap cleanup at 300ms)
var deanLampObs = new MutationObserver(function() {
if (!document.getElementById('dean-lamp-svg')) return;
if (sizeTimer) clearTimeout(sizeTimer);
sizeTimer = setTimeout(sizeLamp, 150);
});
deanLampObs.observe(document.body, { childList: true, subtree: true });
/* 2026-10-25 (Sam, note 12, the Dean Street gap): nothing re-sized the lamp when the window changed size, so a lamp sized
   beside the map on a wide window stayed that tall after the window narrowed past 1100px, and the map, which clears it there,
   dropped below it under a dead column. A resize now sizes it again. */
window.addEventListener('resize', function() {
if (!document.getElementById('dean-lamp-svg')) return;
if (sizeTimer) clearTimeout(sizeTimer);
sizeTimer = setTimeout(sizeLamp, 150);
});
})();

// ====== WHITESPACE GAP CLEANUP ======
// When Harlowe conditionals evaluate to false, the hooks are hidden but
// <br> elements between them remain visible, creating blank gaps.
// This aggressively collapses BR runs to max 1 between hidden blocks,
// and also trims trailing BRs at the end of passages (gap before links).
(function() {
function cleanGaps() {
var passage = document.querySelector('tw-passage');
if (!passage || passage.dataset.gapCleaned) return;
passage.dataset.gapCleaned = '1';

// Walk the passage DOM and find "effective BR runs" — sequences of <br>
// elements with only invisible nodes between them
cleanContainer(passage);

// Also clean inside visible tw-hooks (nested conditionals)
var hooks = passage.querySelectorAll('tw-hook');
for (var h = 0; h < hooks.length; h++) {
if (hooks[h].offsetParent !== null || window.getComputedStyle(hooks[h]).display !== 'none') {
cleanContainer(hooks[h]);
}
}

// Trim trailing BRs at end of passage (gap before final links)
trimTrailingBRs(passage);

// Trim leading BRs at start of passage (gap after invisible opening macros)
trimLeadingBRs(passage);
// 2026-10-05: all three passes run while Harlowe still holds the new
// passage inside a tw-transition-container, so the passage-level walk
// above only ever saw the sidebar and that container. Walk the
// container too, so the blank lines after the header bar go (the
// hidden style survives Harlowe unwrapping the container).
for (var tc = 0; tc < passage.children.length; tc++) {
if (passage.children[tc].tagName === 'TW-TRANSITION-CONTAINER') { trimLeadingBRs(passage.children[tc]); break; }
}

// Trim trailing/leading BRs inside visible hooks too
for (var h2 = 0; h2 < hooks.length; h2++) {
if (hooks[h2].offsetParent !== null || window.getComputedStyle(hooks[h2]).display !== 'none') {
trimTrailingBRs(hooks[h2]);
trimLeadingBRs(hooks[h2]);
}
}

// Hide haunt/lore boxes that have escaped their (if:) hooks.
// Harlowe's HTML parser pushes <div> block elements outside their tw-hook
// container. On repeat visits the hook is hidden but the escaped div is not,
// creating invisible-but-space-occupying elements. We detect them by checking
// that (a) they have no tw-hook ancestor and (b) the nearest preceding
// tw-expression contains a hidden conditional hook (not a link hook).
hideEscapedConditionals(passage);
}

function cleanContainer(container) {
var nodes = [];
var child = container.firstChild;
while (child) { nodes.push(child); child = child.nextSibling; }

var i = 0;
while (i < nodes.length) {
if (isBR(nodes[i])) {
// Start of a potential BR run
var brIndices = [i];
var j = i + 1;
while (j < nodes.length) {
if (isBR(nodes[j])) {
brIndices.push(j);
j++;
} else if (isInvisibleNode(nodes[j])) {
j++;
} else {
break;
}
}

// Check if this BR run sits between two visible content blocks,
// or is adjacent to hidden blocks. Be more aggressive near hidden content.
var prevVisible = hasPrecedingVisibleContent(nodes, i);
var nextVisible = hasFollowingVisibleContent(nodes, j);

// Allow max 1 BR between content (single paragraph break).
// If the run borders hidden content, allow at most 1.
var maxBRs = (prevVisible && nextVisible) ? 1 : 1;
if (brIndices.length > maxBRs) {
for (var k = maxBRs; k < brIndices.length; k++) {
nodes[brIndices[k]].style.display = 'none';
}
}
i = j;
} else {
i++;
}
}
}

function trimTrailingBRs(container) {
// Walk backward from end, hiding BRs and invisible nodes
var nodes = [];
var child = container.firstChild;
while (child) { nodes.push(child); child = child.nextSibling; }

for (var i = nodes.length - 1; i >= 0; i--) {
if (isBR(nodes[i])) {
nodes[i].style.display = 'none';
} else if (isInvisibleNode(nodes[i])) {
continue;
} else {
break; // hit visible content, stop
}
}
}

function trimLeadingBRs(container) {
// Walk forward from start, hiding BRs and invisible nodes
// until we hit the first real visible content
var nodes = [];
var child = container.firstChild;
while (child) { nodes.push(child); child = child.nextSibling; }

for (var i = 0; i < nodes.length; i++) {
if (isBR(nodes[i])) {
nodes[i].style.display = 'none';
} else if (isInvisibleNode(nodes[i])) {
continue;
} else if (nodes[i].tagName === 'TW-INCLUDE' && nodes[i].getAttribute('type') === 'header') {
// 2026-10-05: the header bar is visible content, but the blank lines
// after it (the header passage's last newline plus the body's first
// blank line) are the same gap as any other leading run: keep trimming.
continue;
} else {
break; // hit visible content, stop
}
}
}

function hideEscapedConditionals(passage) {
// When Harlowe sets innerHTML on a tw-hook containing <div> elements,
// the browser's HTML parser pushes block-level elements outside the
// inline tw-hook. On repeat visits the (if:) is false so the hook is
// hidden, but the escaped div is a sibling at passage level with
// opacity:0 (from its CSS animation), taking up full layout height.
//
// Detection: box has NO tw-hook ancestor AND the nearest preceding
// sibling tw-expression contains a hidden conditional hook (not a
// link hook — link hooks contain a tw-link alongside the tw-hook).
var boxes = passage.querySelectorAll('.haunt-box, .lore-box');
for (var b = 0; b < boxes.length; b++) {
var box = boxes[b];
// Step 1: check for any tw-hook ancestor
var el = box.parentElement;
var inHook = false;
while (el && el !== passage) {
if (el.tagName === 'TW-HOOK') { inHook = true; break; }
el = el.parentElement;
}
if (inHook) continue; // properly inside a hook — leave alone
// Step 2: walk backwards to find nearest tw-expression sibling
var sib = box.previousSibling;
while (sib) {
if (sib.nodeType === 1 && sib.tagName !== 'BR') {
if (sib.tagName === 'TW-EXPRESSION') {
// Link hooks contain a tw-link — leave those alone
if (sib.querySelector('tw-link')) break;
// Conditional hook: check if the tw-hook inside is hidden
var innerHook = sib.querySelector('tw-hook');
if (innerHook && window.getComputedStyle(innerHook).display === 'none') {
box.style.display = 'none';
}
break;
}
// Stop if we hit any other visible element
if (!isInvisibleNode(sib)) break;
}
sib = sib.previousSibling;
}
}
}

function hasPrecedingVisibleContent(nodes, idx) {
for (var i = idx - 1; i >= 0; i--) {
if (!isInvisibleNode(nodes[i]) && !isBR(nodes[i])) return true;
if (isBR(nodes[i])) return false;
}
return false;
}

function hasFollowingVisibleContent(nodes, idx) {
for (var i = idx; i < nodes.length; i++) {
if (!isInvisibleNode(nodes[i]) && !isBR(nodes[i])) return true;
}
return false;
}

function isBR(node) {
return node && node.nodeType === 1 && node.tagName === 'BR';
}

function isInvisibleNode(node) {
if (node.nodeType === 3) return node.textContent.trim() === '';
if (node.nodeType !== 1) return true;
var tag = node.tagName;
var style = window.getComputedStyle(node);
if (style.display === 'none') return true;
// Hidden tw-hooks (Harlowe hides them with inline style)
if (tag === 'TW-HOOK' && node.getAttribute('style') &&
node.getAttribute('style').indexOf('display') !== -1 &&
style.display === 'none') return true;
// tw-expression wrapping only hidden content
if (tag === 'TW-EXPRESSION') {
var visibleChild = false;
var ch = node.firstChild;
while (ch) {
if (ch.nodeType === 1) {
var chStyle = window.getComputedStyle(ch);
if (chStyle.display !== 'none' && ch.textContent.trim() !== '') {
// Check if it has any visible tw-link or real content
if (ch.querySelector && ch.querySelector('tw-link, a, canvas, img, svg, button, input')) {
visibleChild = true; break;
}
if (ch.textContent.trim() !== '') { visibleChild = true; break; }
}
} else if (ch.nodeType === 3 && ch.textContent.trim() !== '') {
visibleChild = true; break;
}
ch = ch.nextSibling;
}
if (!visibleChild) return true;
}
// Check for empty elements with no meaningful content
if (node.textContent.trim() === '' &&
!node.querySelector('canvas, img, svg, button, input, tw-link, a')) {
return true;
}
return false;
}

// Run cleanup on each passage load — three passes to catch late-rendering
// hooks. All three fire while the passage is still invisible (the
// passageFadeIn animation has a matching delay, see CSS).
var gapObs = new MutationObserver(function(mutations) {
for (var m = 0; m < mutations.length; m++) {
var added = mutations[m].addedNodes;
for (var n = 0; n < added.length; n++) {
if (added[n].nodeType === 1 &&
(added[n].tagName === 'TW-PASSAGE' ||
(added[n].querySelector && added[n].querySelector('tw-passage')))) {
setTimeout(cleanGaps, 30);
setTimeout(function() {
var p = document.querySelector('tw-passage');
if (p) { delete p.dataset.gapCleaned; cleanGaps(); }
}, 200);
setTimeout(function() {
var p = document.querySelector('tw-passage');
if (p) { delete p.dataset.gapCleaned; cleanGaps(); }
}, 450);
return;
}
}
}
});
gapObs.observe(document.body, { childList: true, subtree: true });
window.dssCleanGaps = cleanGaps;
})();

// ============================================================
// ====== dssScene — REUSABLE 3D ATMOSPHERE TOOLKIT ===========
// ============================================================
// Procedural materials and props extracted from the Chippy /
