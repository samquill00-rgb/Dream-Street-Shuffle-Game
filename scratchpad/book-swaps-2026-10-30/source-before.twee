:: Next Target [system] {"position":"3200,2600","size":"100,100"}
{<!-- NEXT (Sam, 2026-10-12: "it's not clear enough what your next task is ... it needs to be much more clear when you have
     a next task"). One place, the most useful next, worked out from the night's state in order (first match wins): the
     forced roads, the dawn when the night is lived, Red, the cow, the dream world, a key, the page quest, then the flowers
     and haunts the Fetch now asks for. Sets $nextId (a Soho map door id) and $nextLabel (its name in capitals); the
     header prints NEXT · label and Dean Street hands the id to the map, which marks that door. -->
(unless: $needLilies is a number)[(set: $needLilies to 3)](unless: $needHaunts is a number)[(set: $needHaunts to 6)]
(display: "Who Will Read")<!-- 2026-10-15: who still has something to say about the book, and whether the player's pick ($pitchTarget) still stands -->
(set: $nextId to "")(set: $nextLabel to "")(set: $nextId2 to "")
(unless: $lastVenueId is a string)[(set: $lastVenueId to "")](set: _here to "")(set: _vh to (dm: "pillars", "venue-pillars", "cecil", "venue-cecilcourt", "french", "venue-french", "colony", "venue-colony", "ronnies", "venue-ronnies", "coach", "venue-coach", "trishas", "venue-trishas", "lackland", "venue-lackland", "chippy", "venue-chippy"))(for: each _vk, ...(dm-names: _vh))[(if: (passage:)'s tags contains (_vh's (_vk)))[(set: _here to _vk)]](if: _here is not "")[(set: $lastVenueId to _here)]
(set: _a1 to ($alba is an array and $alba contains $alba1))(set: _a2 to ($alba is an array and $alba contains $alba2))(set: _a3 to ($alba is an array and $alba contains $alba3))
(set: _hn to 0)(if: $haunts is an array)[(set: _hn to $haunts's length)]
<!-- 2026-10-17 (Sam: "once you meet one character in a venue you should be directed elsewhere before you return"): a meeting (a haunt caught inside a venue, or DAVY or the agent met in the Colony) rests that venue ($venueRest, its door id); the rest lifts inside any other venue. While a venue rests, its waiting people are hidden there, NEXT and the pitch question pass it by, and NEXT does not hold HERE inside it. -->(unless: $venueRest is a string)[(set: $venueRest to "")]<!-- 2026-10-25 (Sam, item 4): COPPER's cellar lifts the rest too (a real meeting elsewhere); the alleys still do not -->(if: (passage:)'s tags contains "venue-cellar")[(set: $venueRest to "")](set: _met to _hn + (cond: $metDavy is true, 1, 0) + (cond: ($knowsRonnies is true) or ($pitchedAgent is true), 1, 0))(unless: $restMet is a number)[(set: $restMet to _met)](if: (_here is not "") and (_here is not $venueRest))[(set: $venueRest to "")](if: (_met > $restMet) and (_here is not ""))[(set: $venueRest to _here)](set: $restMet to _met)
(set: _lived to ($lilyCount is a number and $lilyCount >= $needLilies and _hn >= $needHaunts))
<!-- 2026-10-15: the book is in the bag and unsold (the readers' rungs below want it) -->(unless: $bookLent is a string)[(set: $bookLent to "")](set: _bookIn to (($bookAt is a string) and ($bookAt is "") and ($bookSold is not true) and ($bookLent is "")))
(set: _sober to ($sobriety is a number and $sobriety >= 30))
<!-- the place Dean Street itself offers for sobering up or a bite (its low-state chain: low both, then low morale, then low sobriety), or "" when it offers none (the wanderer playthrough: NEXT pointed at a doorway or a greyed chippy the street wasn't offering) -->(set: _soberTo to "")
(if: $returns is a number and $returns >= 3 and ($blackouts is not a number or $blackouts < 2) and ($hutBurnt is not true))[(if: $confidence < 30 and $sobriety < 30 and (($hadChippy is not true) or ($hadBreather is not true)))[(if: ($hadBreather is not true))[(set: _soberTo to "doorway")](else:)[(set: _soberTo to "chippy")]](else-if: $confidence < 40 and ($hadChippy is not true))[(set: _soberTo to "chippy")](else-if: $sobriety < 40)[(if: ($hadBreather is not true))[(set: _soberTo to "doorway")](else-if: ($hadChippy is not true))[(set: _soberTo to "chippy")]]]
<!-- 2026-10-14 (overnight report, Sam: fix): under 30 with nothing on the street's chain, NEXT sent the player to a flower too drunk to gather; the doorway in Diadem Court, always open, is the place to sober up -->(if: (_soberTo is "") and ($sobriety is a number) and ($sobriety < 30) and ($hutBurnt is not true))[(unless: ($blackouts is a number) and ($blackouts >= 2))[(set: _soberTo to "dwdiadem")]]
(if: $notebook is "stolen")[(set: $nextId to "foyles")(set: $nextLabel to "CHARING CROSS ROAD")]
(else-if: ($bookAt is a string) and ($bookAt is not ""))[(set: $nextId to $bookAt)(set: $nextLabel to "YOUR BOOK")](else-if: $bookLent is "lackland")[(set: $nextId to "lackland")(set: $nextLabel to "LACKLAND")]<!-- 2026-10-17 (Sam's lines; lend the book, design note 5.4): --><!-- 2026-10-14: the book left behind or at the fence leads NEXT -->
(else-if: $hutBurnt is true and ($coachBurnt is not true))[(set: $nextId to "coach")(set: $nextLabel to "THE COACH AND HORSES")]
(else-if: $coachUrgent is true)[(set: $nextId to "coach")(set: $nextLabel to "THE COACH AND HORSES")]
(else-if: $blackouts is a number and $blackouts >= 2)[(set: $nextId to "north")(set: $nextLabel to "CENTRE POINT")]
(else-if: _a1 and _a2 and _a3 and _lived)[(set: $nextId to "north")(set: $nextLabel to "CENTRE POINT")]
(else-if: $sobriety is a number and (_soberTo is not "") and ($sobriety < 30 or (((passage:)'s tags contains "hub" or (_soberTo is "chippy" and ((passage:)'s name is "Approach Chinese Fish and Chips" or (passage:)'s tags contains "venue-chippy"))) and ($sobriety < 40 or ($confidence is a number and $confidence < 40)))))[(set: $nextId to _soberTo)]<!-- 2026-10-12 (the opening playthrough): under 40 the detour is the street's advice, so it leads only on Dean Street; inside a quest it waits unless sobriety is under 30. 2026-10-14 overnight: and on the chippy's own approach and room when the chippy is the detour, or NEXT flipped to the next errand on the way in and said that errand, not HERE, inside -->
(else-if: ($metRed is not true))[(set: $nextId to "ginger")(set: $nextLabel to "THE GINGER LIGHT")]
<!-- 2026-10-15 (Sam: the manuscript is the main thing; the readers' ladder is NEXT's spine). Once RED is met and the forced
     roads and the sobering detour have had their say, NEXT names the next READER of the book, by name rather than by
     door, in the order the night opens them: the Ham (lap two, as before), the novelist (the French, any time), LACKLAND
     (once his office is open and the night is lived enough for his near-yes, the Fetch's own gate), SHANA (Trisha's opens
     with the pong's matchbook, so she is the last). A reader is named only while the book is in the bag and unsold; the
     book left behind already leads above. The dawn rule above still outranks the ladder once the poem is complete and the
     night lived. The plot roads below (the cow, the crossing, the keys, page 93) come when no reader is waiting. -->
<!-- 2026-10-15 (Sam): the player's own pick, from the question on Dean Street, outranks the ladder's order -->(else-if: _bookIn and ($pitchOn is true) and ($pitchTarget is not $venueRest))[(set: $nextId to $pitchTarget)(set: $nextLabel to $pitchName)]
<!-- 2026-10-17 (Sam: two options, and NEXT and the map show both until you pick): while the question offers a choice and none is made, NEXT names the first two readers in the ladder's order and the map marks both doors ($nextId2, the 'next2' hub flag; empty when they share a door) -->(else-if: _bookIn and ($pitchAvail is an array) and ($pitchAvail's length > 1))[(set: $nextId to $pitchAvail's 1st's id)(set: $nextLabel to $pitchAvail's 1st's name + " or " + $pitchAvail's 2nd's name)(if: $pitchAvail's 2nd's id is not $nextId)[(set: $nextId2 to $pitchAvail's 2nd's id)]](else-if: _bookIn and ($pitchAvail is an array) and ($pitchAvail's length is 1) and ($pitchList's length > 1))[(set: $nextId to $pitchAvail's 1st's id)(set: $nextLabel to $pitchAvail's 1st's name)]<!-- 2026-10-17: one reader left while the other's venue rests: NEXT names them -->
(else-if: _bookIn and ($metCritic is not true) and ($venueRest is not "pillars"))[(set: $nextId to "pillars")(set: $nextLabel to "THE BELLETRIST")]
(else-if: _bookIn and not ($haunts contains $haunt4) and ($venueRest is not "french"))[(set: $nextId to "french")(set: $nextLabel to "JOHN ST. JOHN")]
(else-if: _bookIn and not ($haunts contains $haunt1) and ($venueRest is not "french"))[(set: $nextId to "french")(set: $nextLabel to "BENITO")]
(else-if: _bookIn and not ($haunts contains $haunt2) and ($venueRest is not "french"))[(set: $nextId to "french")(set: $nextLabel to "THE NOVELIST")]
(else-if: _bookIn and ($lkOpen is true) and ($lacklandRead is not true) and _lived and ($venueRest is not "lackland"))[(set: $nextId to "lackland")(set: $nextLabel to "LACKLAND")]<!-- 2026-10-17: $lkOpen (Who Will Read) is the hub's condition for his door, so the rung waits while the office reads NOT NOW -->
(else-if: _bookIn and ($hasTrishaMatchbook is true) and ($metShana is not true) and ($venueRest is not "trishas"))[(set: $nextId to "trishas")(set: $nextLabel to "SHANA")]
(else-if: _a1 and _a2 and ($cowRideDone is not true))[(set: $nextId to "coach")(set: $nextLabel to "THE COACH AND HORSES")]
(else-if: (not _a2) and $inisToldOfPillars is true and $dreamKey is a string and ($dreamKey is not ""))[(if: _sober or (_soberTo is ""))[(set: $nextId to "pillars")(set: $nextLabel to "THE PILLARS")](else:)[(set: $nextId to _soberTo)]]
(else-if: (not _a2) and $inisToldOfPillars is true)[(if: $keyLighter is "seed")[(set: $nextId to "french")(set: $nextLabel to "THE FRENCH")](else-if: $keySlip is "seed")[(set: $nextId to "coach")(set: $nextLabel to "THE COACH AND HORSES")](else-if: $keyTicket is "seed")[(set: $nextId to "chippy")(set: $nextLabel to "THE HALIBUT")](else-if: $keyCocaine is "seed" and $hasTrishaMatchbook is true)[(set: $nextId to "trishas")(set: $nextLabel to "TRISHA’S")]]
(else-if: (not _a2) and $hasMissingPage is true and ($returnedPage is not true))[(set: $nextId to "cecil")(set: $nextLabel to "CECIL COURT")]
(else-if: (not _a2) and $knowsAboutPage is true and ($hasMissingPage is not true))[(set: $nextId to "pillars")(set: $nextLabel to "THE PILLARS · SEEK THE SHORE")]
(else-if: (not _a2) and $knowsCecilCourt is true and ($knowsAboutPage is not true))[(set: $nextId to "cecil")(set: $nextLabel to "CECIL COURT")]
(else-if: (not _a2) and ($knowsCecilCourt is not true))[(if: ($metCritic is not true))[(set: $nextId to "pillars")(set: $nextLabel to "THE PILLARS")](else:)[(set: $nextId to "french")(set: $nextLabel to "THE FRENCH")]]
(if: $nextId is "" and not _lived)[
(if: ($lilyCount is not a number) or $lilyCount < $needLilies)[(if: (not _sober) and (_soberTo is not ""))[(set: $nextId to _soberTo)](else-if: ($tookLily5 is not true))[(set: $nextId to "french")(set: $nextLabel to "THE FRENCH")](else-if: ($tookLily2 is not true))[(set: $nextId to "pillars")(set: $nextLabel to "THE PILLARS")](else-if: ($tookLily4 is not true) and ($haunts is an array) and ($haunts contains $haunt1))[(set: $nextId to "colony")(set: $nextLabel to "THE COLONY ROOM")](else-if: ($tookLily3 is not true) and ($knowsRonnies is true))[(set: $nextId to "ronnies")(set: $nextLabel to "RONNIE SCOTT’S")](else-if: ($tookLily1 is not true))[(set: $nextId to "chippy")(set: $nextLabel to "THE HALIBUT")]]
<!-- 2026-10-12 (Sam, item 16): the haunts came in a fixed order, so NEXT could send you straight back to the place you had just left (the French, three times over for its three haunts). The places still owing a haunt are listed in the same order; if the first is the venue you were last inside and another is on the list, NEXT names that one instead. Inside a venue it is unchanged (HERE). $lastVenueId is the last venue you were in. -->(if: $nextId is "")[(set: _hc to (a:))(unless: ($haunts contains $haunt1) and ($haunts contains $haunt2) and ($haunts contains $haunt4))[(set: _hc to _hc + (a: "french"))](if: ($knowsRonnies is true) and ($completedSetlist is not true))[(set: _hc to _hc + (a: "ronnies"))](if: ($hasTrishaMatchbook is true) and ($metShana is not true))[(set: _hc to _hc + (a: "trishas"))](if: ($knowsLackland is true) and ($knowsCopperSecret is true))[(unless: $haunts contains $haunt5)[(set: _hc to _hc + (a: "lackland"))]]<!-- 2026-10-14 (regression run): only when its door is open, which also wants COPPER's secret -->(if: _hc's length is 0)[(set: _hc to (a: "colony"))](set: _pick to _hc's 1st)(if: _hc's length > 1 and _here is "")[(if: _pick is $lastVenueId)[(set: _pick to _hc's 2nd)]](set: $nextId to _pick)(set: $nextLabel to (dm: "french", "THE FRENCH", "ronnies", "RONNIE SCOTT’S", "trishas", "TRISHA’S", "lackland", "LACKLAND’S", "colony", "THE COLONY ROOM")'s (_pick))]
]
(if: $nextId is "")[(set: $nextId to "french")(set: $nextLabel to "THE FRENCH")]
(if: $nextId is "doorway" or $nextId is "dwdiadem")[(set: $nextLabel to "A DOORWAY")](else-if: $nextId is "chippy")[(set: $nextLabel to "THE HALIBUT")]
<!-- 2026-10-13 (Sam: "The 'next' shows too soon ... when I entered the French the first time it already said: 'Next The pillars'
     before I had any idea what that is. It should change/appear when I leave"): inside a venue NEXT holds what it said as you
     walked in (HERE, when it sent you there); it moves on when you leave. $nextHoldId/$nextHoldLabel keep the last outside answer. -->(unless: $nextId2 is a string)[(set: $nextId2 to "")](unless: $nextHoldId2 is a string)[(set: $nextHoldId2 to "")](if: (_here is not "") and (_here is $venueRest))[](else-if: _here is not "")[(if: ($nextHoldId is a string) and ($nextHoldId is not ""))[(set: $nextId to $nextHoldId)(set: $nextLabel to $nextHoldLabel)(set: $nextId2 to $nextHoldId2)]](else:)[(set: $nextHoldId to $nextId)(set: $nextHoldLabel to $nextLabel)(set: $nextHoldId2 to $nextId2)]<!-- 2026-10-17: the second reader's door is held with the first -->
<!-- 2026-10-12 (the opening playthrough): inside the place it names, NEXT says HERE (the map still marks the door by its id) -->(set: _vt to (dm: "pillars", "venue-pillars", "cecil", "venue-cecilcourt", "french", "venue-french", "colony", "venue-colony", "ronnies", "venue-ronnies", "coach", "venue-coach", "trishas", "venue-trishas", "lackland", "venue-lackland", "chippy", "venue-chippy"))(if: _vt contains $nextId)[(if: (passage:)'s tags contains (_vt's ($nextId)))[(set: $nextLabel to "HERE")]](if: ($nextId2 is not "") and (_vt contains $nextId2))[(if: (passage:)'s tags contains (_vt's ($nextId2)))[(set: $nextLabel to "HERE")]]<!-- 2026-10-17: HERE inside either of the two readers' venues -->
}

:: Who Will Read [system] {"position":"3050,2600","size":"100,100"}
{<!-- 2026-10-15 (Sam: "when you are deciding which venue to go to next, surely the idea of who you might meet and who you
     want to pitch it to could be involved"). Who still has something to say about the book tonight, by door: the people a
     reading or a refusal is still owed from, behind doors that are open on Dean Street (the same conditions as the hub's
     links). $whoList feeds the hub's question, the notebook and NEXT; $whoFlag names them on the map's door plates and in
     its caption bar (the 'who' hub flag). A pick ($pitchTarget, a door id, $pitchName, and $pitchLink, the figure's own
     link text, for the room to light that figure) stays on only while that person is still here; once they have had
     their say it clears and the question comes back. 2026-10-16: each entry carries "k", its slip key in dssRefusals
     (empty for JOHN and BENITO, who talk about the book without reading it), and "link". The French in Sam's order:
     JOHN ST. JOHN first, then the painter, then the novelist; the door names whoever is next. -->
(set: $whoList to (a:))
(set: _wP to "")(set: _wF to "")(set: _wC to "")(set: _wE to "")(set: _wO to "")(set: _wR to "")(set: _wT to "")(set: _wL to "")
(if: ($metCritic is not true))[(set: _wP to "THE BELLETRIST")(set: $whoList to it + (a: (dm: "id", "pillars", "name", "THE BELLETRIST", "place", "the Pillars of Hercules", "k", "ham", "link", "Talk to the Great Ham")))<!-- 2026-10-21 (Sam): on the hub, the plates and NEXT he is THE BELLETRIST until met; his name comes from his card and lore -->]
(if: ($haunts is an array) and not ($haunts contains $haunt4))[(set: _wF to "JOHN ST. JOHN")(set: $whoList to it + (a: (dm: "id", "french", "name", "JOHN ST. JOHN", "place", "the French", "k", "", "link", "Approach")))](else-if: ($haunts is an array) and not ($haunts contains $haunt1))[(set: _wF to "BENITO")(set: $whoList to it + (a: (dm: "id", "french", "name", "BENITO", "place", "the French", "k", "", "link", "Approach the artists|Sketch him on a napkin")))](else-if: ($haunts is an array) and not ($haunts contains $haunt2))[(set: _wF to "THE NOVELIST")(set: $whoList to it + (a: (dm: "id", "french", "name", "THE NOVELIST", "place", "the French", "k", "novelist", "link", "Speak to him")))]
(set: _colonyOpen to (($coachUrgent is not true) and ($haunts is an array) and ($haunts contains $haunt1) and not (($knowsRonnies is true) and ($knowsCopperSecret is true) and ($metSalvu is true))))
(if: _colonyOpen and ($metDavy is not true))[(set: _wC to "DAVY MERKIN")(set: $whoList to it + (a: (dm: "id", "colony", "name", "DAVY MERKIN", "place", "the Colony Room", "k", "davy", "link", "Get a drink with the man at the bar")))]
(if: _colonyOpen and ($knowsRonnies is not true) and ($pitchedAgent is not true))[(set: _wC to (cond: _wC is "", "THE AGENT", _wC + ", THE AGENT"))(set: $whoList to it + (a: (dm: "id", "colony", "name", "THE AGENT", "place", "the Colony Room", "k", "agent", "link", "Talk to the famous agent")))]
(if: ($knowsCecilCourt is true) and ($knowsAboutPage is not true))[(set: _wE to "INIS O’FLATTERLY")(set: $whoList to it + (a: (dm: "id", "cecil", "name", "INIS O’FLATTERLY", "place", "Cecil Court", "k", "inis", "link", "The Great Ham sent me|Approach")))]
(set: _coachOpen to (($coachUrgent is true) or (($inisToldOfPillars is true) and ($keySlip is "seed")) or (($alba is an array) and ($alba contains $alba1) and ($alba contains $alba2) and ($cowRideDone is not true))))
(if: _coachOpen and ($sawJeffrey is not true))[(set: _wO to "JEFFREY BERNARD")(set: $whoList to it + (a: (dm: "id", "coach", "name", "JEFFREY BERNARD", "place", "the Coach and Horses", "k", "jeffrey", "link", "")))]
(if: ($knowsRonnies is true) and ($completedSetlist is not true))[(set: _wR to "MOE")(set: $whoList to it + (a: (dm: "id", "ronnies", "name", "MOE", "place", "Ronnie Scott’s", "k", "moe", "link", "")))]
(if: ($hasTrishaMatchbook is true) and ($metShana is not true))[(set: _wT to "SHANA")(set: $whoList to it + (a: (dm: "id", "trishas", "name", "SHANA", "place", "Trisha’s", "k", "shana", "link", "Approach Shana")))]
<!-- 2026-10-17 (played live): after the back room's game the hub reads "Lackland's Office [NOT NOW]" (its door opens again only in the eye's window), yet the question and NEXT still named him. $lkOpen is the hub's own condition for his door. -->(set: $lkOpen to (($knowsLackland is true) and ($knowsCopperSecret is true) and ((($inisToldOfPillars is true) and ($keyEye is "seed") and ($alba is an array) and ($alba contains $alba3) and ($worldsVisited is an array) and ($worldsVisited's length >= 4)) or not (($haunts is an array) and ($haunts contains $haunt5)))))
(if: ($lkOpen is true) and ($lacklandRead is not true))[(set: _wL to "LACKLAND")(set: $whoList to it + (a: (dm: "id", "lackland", "name", "LACKLAND", "place", "Frith Street", "k", "lackland", "link", "Lay it down|Not yet.")))]
<!-- 2026-10-16 (Sam, from Astra's playtest: the pitch question offered JOHN, who never reads the book): $pitchList is $whoList without the entries that carry no slip key (JOHN and BENITO), for the hub's question only; the door plates, the notebook and NEXT keep $whoList -->
<!-- 2026-10-17 (Sam: "it only gives one choice. The whole idea is that it should give two options"): THE NOVELIST is offered from the start, while JOHN or BENITO still stands before him in the French (his entry carries their link, so the room lights whoever is next on the way to him); and the list is in the ladder's order (the Ham, the novelist, LACKLAND, SHANA, then the rest), so NEXT can name the first two before a pick -->
(set: _pc to (a:))(if: $whoList's length > 0)[(for: each _w, ...$whoList)[<!-- 2026-10-27 (Sam, playtest note 28: "Why does it keep directing me to the French?"): the novelist was offered as the French's reader while JOHN or BENITO still came first, so a pick sent you back three visits running; now he joins the list only when he is next (his own entry, k "novelist") -->(if: _w's k is not "")[(set: _pc to it + (a: _w))]]]
(set: $pitchList to (a:))(if: _pc's length > 0)[(for: each _pk, "ham", "novelist", "lackland", "shana", "inis", "davy", "agent", "jeffrey")[(for: each _w, ..._pc)[(if: _w's k is _pk)[(set: $pitchList to it + (a: _w))]]]]
(unless: $venueRest is a string)[(set: $venueRest to "")](set: $pitchAvail to (a:))(if: $pitchList's length > 0)[(for: each _w, ...$pitchList)[(if: _w's id is not $venueRest)[(set: $pitchAvail to it + (a: _w))]]]<!-- 2026-10-17: $pitchAvail, the readers not behind a resting door: the question and NEXT's two -->
(set: $whoFlag to "pillars:" + _wP + "|french:" + _wF + "|colony:" + _wC + "|cecil:" + _wE + "|coach:" + _wO + "|ronnies:" + _wR + "|trishas:" + _wT + "|lackland:" + _wL)
(unless: $pitchTarget is a string)[(set: $pitchTarget to "")](unless: $pitchName is a string)[(set: $pitchName to "")](unless: $pitchLink is a string)[(set: $pitchLink to "")]
(set: $pitchOn to false)(if: ($pitchTarget is not "") and ($pitchList's length > 0))[(for: each _w, ...$pitchList)[(if: (_w's id is $pitchTarget) and (_w's name is $pitchName))[(set: $pitchOn to true)(set: $pitchLink to _w's link)]]](unless: $pitchOn)[(set: $pitchTarget to "")(set: $pitchName to "")(set: $pitchLink to "")]
}

:: Pitch Question [system] {"position":"3050,2750","size":"100,100"}
{<!-- 2026-10-16 (Sam: a pick should not throw you back to the door; a red path should light up on the map that you
     follow). The question and its names, rendered inside Dean Street's |pitchq> hook. A pick sets the target and then
     replaces, in place, this hook (so the picked name turns gold), the 'pitch' hub flag (the map draws the red path from
     where you stand) and the 'next' hub flag (the door's glow and the edge pointer). The street itself is not re-rendered,
     so the figure stays where it is. The header's NEXT line follows through the footer's next-poke. Later the same day:
     a name tried on an earlier night carries that night's verdict beside it, small (the hidden .book-pitch-k span holds
     the slip key; the script reads dssRefusals). -->
(display: "Who Will Read")
<span class="book-pitch-q">Who will you pitch the book to next?</span>(for: each _w, ...$pitchAvail)[(if: (_w's id is $pitchTarget) and (_w's name is $pitchName))[<span class="book-pitch-on"><span class="book-pitch-k" hidden>(print: _w's k)</span>(print: _w's name) · (print: _w's place)</span>](else:)[<span class="book-pitch-opt"><span class="book-pitch-k" hidden>(print: _w's k)</span>(link: _w's name + " · " + _w's place)[(set: $pitchTarget to _w's id)(set: $pitchName to _w's name)(set: $pitchLink to _w's link)(replace: ?pitchflag)[(print: $pitchTarget)](replace: ?nextflag)[(display: "Next Target")](replace: ?next2flag)[](replace: ?pitchq)[(display: "Pitch Question")]]</span>]]<!-- 2026-10-28 (note 40): no one, for now; the path and the glow clear and the question comes back next lap --><span class="book-pitch-opt book-pitch-no">(link: "No one yet.")[(set: $pitchTarget to "")(set: $pitchName to "")(set: $pitchLink to "")(replace: ?pitchflag)[](replace: ?nextflag)[(display: "Next Target")](replace: ?next2flag)[](replace: ?pitchq)[]]</span>
<script>(function(){ var R = window.dssRefusals; if (!R) return; var all = R.list(), n = R.night(), first = 0; try { first = +localStorage.getItem('dssRunFirst') || 0; } catch (e) {} all = all.filter(function(r) { return r.n >= first; }); /* 2026-10-23: earlier nights of this run only */ Array.prototype.forEach.call(document.querySelectorAll('.book-pitch .book-pitch-opt:not([data-ago]), .book-pitch .book-pitch-on:not([data-ago])'), function(el) { el.setAttribute('data-ago', '1'); var kEl = el.querySelector('.book-pitch-k'), k = kEl ? kEl.textContent.trim() : ''; if (!k) return; var prev = all.filter(function(r) { return r.k === k && r.n < n; }); if (!prev.length) return; var last = prev[prev.length - 1]; var s = document.createElement('span'); s.className = 'book-pitch-ago'; s.textContent = (n - last.n === 1 ? 'Last night: ' : 'On an earlier night: ') + last.line; el.appendChild(s); }); })();</script>
}

:: Next Shown [system] {"position":"3200,2750","size":"100,100"}
{<!-- where the NEXT line shows: not inside the dream worlds, Carthage's shore, the endings or the night's opening pages -->
