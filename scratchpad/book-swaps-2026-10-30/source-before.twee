},
// TRAILS: one a dream key. Each step's line shows once the step before it has been seen (the first
// step's always); the last step is where the key lies, and that object's card offers it. A walked
// step's next object breathes a little warmer at rest, wherever it is. gate: true would hold the key
// back until the step before it has been seen (off, so a key is never harder to find than before).
trails: {
'lighter': { world: 'Himalayas', gate: false, steps: [
{ at: 'ci/A piano', then: 'Some sheets of music rest on the piano; an old torch song in French, printed in Tunis, the work of some old pied-noir, no doubt. You\'ll find your own next step on the way to Carthage.' },
{ at: 'pi/A lattice window', then: 'On the sill beneath the window is a sheet of the same old song that was on the piano before. If you sang the chorus it would say: « Il y a un briquet sur le comptoir ! » \'There is a lighter on the bar\', in French.' },
{ at: 'fi/A bar', then: 'Here. The brass lighter by the till. This is what the piano sent you for.' }
] },
'cocaine': { world: 'Nazca', gate: false, steps: [
{ at: 'cu/A bulb', then: 'This bulb is scratched with a single, straight, thin line. There the light looks whiter than the rest. It recalls the jukebox in Trisha\'s; you\'ll know it when you see it.' },
{ at: 'ti/A jukebox', then: 'From the jukebox, lines of thin wild mercury and their ghosts atop it. Too much for this small room; make a covert exit.' },
{ at: 'ti/A door to the back', then: 'At the threshold you clock something by your boot. That should be in South America. Wouldn\'t it be fun to take it home?' }
] },
'ticket': { world: 'Easter Island', gate: false, steps: [
{ at: 'oi/A globe', then: 'See how half the world is water; fishes had no need for Noah’s ark. Go where the sea touches most close to Soho.' },
{ at: 'cf/A menu', then: 'There is, you think, some tedious irony in the menu\'s disorder. What did the globe in the bookshop show you? Order now and bear it in mind.' },
{ at: 'cf/A ticket', then: 'Fish is good for Friday, but this is the third step in the path you\'re walking. Saturday was hell; go to Easter Island.' }
] },
'slip': { world: 'the Pyramid', gate: false, steps: [
{ at: 'cu/A chesterfield', then: 'This is an old, fine Chesterfield. They say it used to belong to Howard Carter. Next, like him, you must go underground. Get drunk, until Osiris gathers you.' },
{ at: 'cb/The Gents', then: 'Someone etched a sigil on the door. A pyramid with an all-seeing eye. And what are all these letters?' },
{ at: 'cb/JEFFREY BERNARD’S glass', then: 'Here is the bedrock, an end of the road; gambling\'s the most squalid of the vices. But take the betting slip, you might as well; dream of the gold it promises.' }
] },
'eye': { world: 'Ezekiel', gate: false, steps: [
{ at: 'oi/A glass case', then: 'In the cabinet, beneath the glass – the nictitating membrane, third eyelid – a glass eye looks back at you through your navel and browses the shelves. Its iris is blue, electric blue. Eventually you clock that the book it’s reading isn’t in this room at all but somewhere else, elsewhere in Soho. Look for other books then, a green eye to make a pair like Major Tom.' },
{ at: 'lk/Shelves', then: 'In front of a bookshelf, you\'re always in the third person. Something in the room\'s eyeballing you. Look for it!' },
{ at: 'lk/A dish', then: 'Immanentise the vision, pocket it. This one is a real angelic key.' }
] }
},
// CALLBACKS: at this object, once that one has been seen, these lines replace its own
callbacks: [
{ at: 'cf/A window', after: 'fi/A window', now: 'Maybe LILY\'S in this window, too.' },
{ at: 'oi/A window', after: 'cf/A window', now: '' },
{ at: 'pi/A telephone', after: 'fi/A telephone', now: 'Another phone behind another bar. You always notice phones in pubs; they rarely bring good news.', back: 'Another phone behind another bar. You always notice phones in pubs, you like how they promise news.' },
{ at: 'ri/A telephone', after: 'ci/A telephone', now: 'Why must all these bars have telephones? A vision of hell: you can always be contacted.' },
{ at: 'cb/A telephone', after: 'pi/A telephone', now: 'One day they\'ll make a phone that brings you good news.' },
{ at: 'ri/Photographs', after: 'fi/Photographs', now: 'That\'s the same man you saw in a photo in The French, though there he was younger and with another woman.' },
{ at: 'ti/Photographs', after: 'ri/Photographs', then: 'What a photo: Ronnie Scott, Les Paul and Fender Rhodes, together! Maybe they drank here.' },
{ at: 'ti/Stairs', after: 'cu', now: 'Downstairs again? Are you sure that\'s wise?' },
{ at: 'cf/An empty table', after: 'ri/An empty table', now: 'Enough of this Les Misérables.' }
]
};
// ---------- the engine: reads the table above, keeps what has been seen ----------
window.dssVoices = (function() {
// a phone's card: smaller words, smaller key picture
try {
var css = document.createElement('style'); css.id = 'dss-voices-css';
css.textContent = '.dss-room-card.dss-card-narrow{font-size:13.5px!important;line-height:1.4!important;padding:10px 14px 9px!important}' +
'.dss-card-narrow .dss-voices{font-size:13px!important;margin-top:5px!important}' +
'.dss-card-narrow .dss-card-keyart svg{height:36px!important}' +
'.soho-next-arrow{position:absolute;z-index:40;pointer-events:none;white-space:nowrap;font:bold 10px \'Courier New\',monospace;letter-spacing:2px;color:#ffe2a0;background:rgba(10,8,6,0.82);border:1px solid rgba(255,210,130,0.55);padding:3px 7px;border-radius:2px;text-shadow:0 0 8px rgba(255,205,120,0.7);animation:dssNextDoor 2.4s ease-in-out infinite}' +
'@media (prefers-reduced-motion: reduce){.soho-next-arrow{animation:none}}' +
'.soho-door-label.soho-door-next{color:#ffe2a0!important;text-shadow:0 0 10px rgba(255,205,120,0.85),0 0 2px #000!important;animation:dssNextDoor 2.4s ease-in-out infinite}' +
/* 2026-10-13 (Sam): no small NEXT over the door's name, the glowing name says it once */
'@keyframes dssNextDoor{0%,100%{opacity:1}50%{opacity:0.62}}' +
'@media (prefers-reduced-motion: reduce){.soho-door-label.soho-door-next{animation:none}}' +
'.soho-door-label.soho-door-trail::after{content:"";display:inline-block;width:5px;height:5px;margin-left:6px;border-radius:50%;vertical-align:middle;background:rgba(236,196,120,0.95);box-shadow:0 0 6px rgba(236,196,120,0.9)}';
(document.head || document.documentElement).appendChild(css);
} catch (e) {}
var V = window.DSS_VOICES, KEY = 'dssVoicesSeen', ORDER = ['now', 'then', 'id'], SW = V.switches || {};
var SR_NAME = { now: 'you now', then: 'you then', id: 'the id' };
var ROOM_NAME = { fi: 'The French', ci: 'The Colony Room', pi: 'The Pillars of Hercules', ri: 'Ronnie Scott’s', cf: 'the chippy', cb: 'the Coach', ti: 'Trisha’s', lk: 'Lackland’s office', oi: 'O’Flatterly’s shop', cu: 'the cellar' };
// the Dean Street map door each room is reached by (the cellar lies through the Colony's door)
var MAP_DOOR = { fi: 'french', ci: 'colony', cu: 'colony', pi: 'pillars', ri: 'ronnies', cf: 'chippy', cb: 'coach', ti: 'trishas', lk: 'lackland', oi: 'cecil' };
var PINK = 'color:#ff3aa8;text-shadow:0 0 4px rgba(255,58,168,0.45);';
// the pink of an unwritten line on the parchment box: deeper, no glow
var PINK_INK = 'color:#c2187e;';
// read fresh each time (a second tab, the dev panel's forget), kept in memory only when storage is refused
var mem = {};
var lastRaw = null, lastArr = [];
function load() {
var seen = {};
for (var m in mem) seen[m] = true;
try {
var raw = localStorage.getItem(KEY) || '[]';
// the room's rest glow asks every frame under reduced motion: parse only when the stored list changes
if (raw !== lastRaw) { var a = JSON.parse(raw); lastArr = Array.isArray(a) ? a : []; lastRaw = raw; }
lastArr.forEach(function(p) { seen[p] = true; });
} catch (e) {}
return seen;
}
function has(p) { return !!load()[p]; }
function unwritten(t) { return String(t).indexOf('[Sam:') >= 0; }
// the visit: each build of a room is one (dssRoomPlay calls enter()). Nothing reads the count any more: the
// turns and the opener that chose between THE PRIME and THE OLDBOY went on 2026-10-21 (Sam: every voice speaks on every look).
var curVisit = 0;
function enter() { curVisit++; return curVisit; }
function see(p) { var s = load(); if (s[p]) return; s[p] = true; try { localStorage.setItem(KEY, JSON.stringify(Object.keys(s))); } catch (e) { mem[p] = true; } }
// the voices already met (their about line shown once): kept like the seen objects
var KEYM = 'dssVoicesMet', memMet = {};
function metList() { var m = {}; for (var k in memMet) m[k] = true; try { (JSON.parse(localStorage.getItem(KEYM) || '[]') || []).forEach(function(v) { m[v] = true; }); } catch (e) {} return m; }
function meet(room, name) {
var m = metList(), add = false, fresh = [];
lines(room, name).forEach(function(l) { if (!m[l.voice]) { m[l.voice] = true; add = true; fresh.push(l.voice); } });
if (!add) return;
try { localStorage.setItem(KEYM, JSON.stringify(Object.keys(m))); } catch (e) { for (var k in m) memMet[k] = true; }
/* 2026-10-28 (Sam, playtest note 30: "OLDBOY and PRIME are too much. Simplify."): a voice's about line no longer sits under its
   line on the look card; the first time a voice speaks, one VOICES slip carries the introduction, the way STATS and HAUNTS come */
var intro = ORDER.filter(function(v) { return fresh.indexOf(v) >= 0 && V.cast[v] && V.cast[v].about; }).map(function(v) { return V.cast[v].label + '\n' + V.cast[v].about; });
if (intro.length && window.dssInlineHint) setTimeout(function() { window.dssInlineHint('VOICES\n\n' + intro.join('\n\n'), { sticky: true }); }, 800);
}
// 2026-10-11 (Sam, structure pass 3): "Dream worlds shouldn't be available until you have done the trip to
// Carthage ... This also means the trails shouldn't open." The header carries the night: data-trails is
// $visitedCarthage (the trails open once you have been to Carthage, so the return to O'Flatterly's shop with
// page 93 still shows the globe and the glass case), data-keys is $inisToldOfPillars (a trail's last step, the
// key itself, waits for INIS as the key does), data-gone the rooms closed to you for the night.
function vstate(a) { var el = document.getElementById('dss-voice-state'); return el ? el.getAttribute(a) : null; }
function trailsOpen() { var v = vstate('data-trails'); return v === null || v === 'true'; }
// the keys that may be offered now: the eye waits for four worlds and the third line, as its card does, and so
// does every step of its trail after the glass case (the shelves would send you looking for an eye not yet there)
function keysOpen(key) { var v = vstate('data-keys'); return v === null || (' ' + v).indexOf(' ' + key + ' ') >= 0; }
// a trail runs only while its key still lies where the trail ends (once pocketed, set down elsewhere or spent, its clues go quiet)
function keyLying(key) { var v = vstate('data-lying'); return v === null || (' ' + v).indexOf(' ' + key + ' ') >= 0; }
// the trail a path stands on: { key, trail, i } or null
function stepAt(p) {
if (!trailsOpen()) return null;
var fk = followed();
for (var k in V.trails) { var st = V.trails[k].steps; for (var i = 0; i < st.length; i++) if (st[i].at === p) return (!keyLying(k) || (fk && k !== fk) || ((i === st.length - 1 || (k === 'eye' && i > 0)) && !keysOpen(k))) ? null : { key: k, trail: V.trails[k], i: i }; }
return null;
}
// 2026-10-23 overnight (Sam, playtest: "What happens when you get 1/3 steps in the same room? Is the first cancelled?" and at the chippy
// "The 1 2 3 step paths need to be made much clearer. Maybe some sort of 'accept quest' button that shuts out other possibilities, at
// least for the first one. Then some sort of indicator as to which stage you are on"): a trail's first step offers FOLLOW THIS TRAIL.
// Once one is followed (for the night, localStorage 'dssTrailFollow'), the other trails go quiet until its key is taken (or set down
// elsewhere, or spent), and the header shows where you are on it. Before any is followed every trail runs side by side, as before.
var KEYF = 'dssTrailFollow';
function nightNo() { try { return +localStorage.getItem('dssNightNo') || 0; } catch (e) { return 0; } }
function followed() { try { var f = JSON.parse(localStorage.getItem(KEYF) || 'null'); if (f && f.n === nightNo() && V.trails[f.k] && keyLying(f.k)) return f.k; } catch (e) {} return null; }
function follow(k) { try { localStorage.setItem(KEYF, JSON.stringify({ n: nightNo(), k: k })); } catch (e) {} }
function trailStage() { var k = followed(); if (!k) return null; var st = V.trails[k].steps, w = 0; st.forEach(function(s) { if (walked(s.at)) w++; }); return { key: k, walked: w, n: st.length }; }
document.addEventListener('click', function(e) {
var b = e.target && e.target.closest && e.target.closest('.dss-trail-follow'); if (!b) return;
e.preventDefault(); e.stopPropagation(); follow(b.getAttribute('data-k')); b.textContent = 'Following'; b.disabled = true; b.classList.add('on'); trailChip();
}, true);
var CHIP_ON = false;
function trailChip() {
var strip = Array.prototype.find.call(document.querySelectorAll('#stat-bars-lifted .stat-bars, #stat-bars-lifted, .stat-bars'), function(x) { return x.getClientRects().length; });
if (!strip) return;
var chip = strip.querySelector('.dss-trail-chip'), t = CHIP_ON ? trailStage() : null; /* 2026-10-24 (Sam: "drop the header trail tag; keep FOLLOW THIS TRAIL and the quieting"): the step card's green sign carries the stage; CHIP_ON true brings the tag back */
if (!t) { if (chip) chip.remove(); return; }
if (!chip) { chip = document.createElement('span'); chip.className = 'dss-trail-chip'; strip.appendChild(chip); }
var txt = 'Trail · ' + Math.max(1, t.walked) + ' of ' + t.n; if (chip.textContent !== txt) chip.textContent = txt;
chip.title = t.walked ? (t.walked + ' of ' + t.n + ' steps walked; the next one is warmer when you see it.') : 'The first step is walked when you look at it.';
}
setInterval(trailChip, 800);
// A room closed to you for the rest of the night (COPPER's cellar once left, O'Flatterly's shop once the page is
// back, the Colony once its business is done): a trail step lying there counts as walked, so the trail can still
// be followed from its next step (2026-10-11, structure pass 3).
function walked(at) { return has(at) || (' ' + (vstate('data-gone') || '')).indexOf(' ' + at.split('/')[0] + ' ') >= 0; }
function trailOpen(s) { return s.i === 0 || walked(s.trail.steps[s.i - 1].at); }
// the stat bars and the night, from the header's hidden note (no Harlowe internals)
function state() {
var el = document.getElementById('dss-voice-state');
if (!el) return null;
return { sob: +el.getAttribute('data-sob'), mor: +el.getAttribute('data-mor'), phase: +el.getAttribute('data-phase') };
}
function idAwake() {
var s = state(), w = V.idWhen || {};
if (!s) return false;
