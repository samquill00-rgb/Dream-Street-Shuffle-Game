      } else if (rWarmLit) {
        placeMesh(rightBuilding, new THREE.PlaneGeometry(0.62, 1.10),
          new THREE.MeshBasicMaterial({ color: 0xffd699, transparent: true, opacity: 0.28 }), rwx, rwy, 0.08);
      } else {
        // dim curtain or unlit
        var curtainDraw = Math.random() > 0.5;
        placeMesh(rightBuilding, new THREE.PlaneGeometry(0.62, 1.10),
          new THREE.MeshBasicMaterial({
            color: curtainDraw ? 0x3a2818 : 0x2a3a55,
            transparent: true,
            opacity: curtainDraw ? 0.55 : 0.13
          }), rwx, rwy, 0.08);
      }
      // Glazing bars
      placeMesh(rightBuilding, new THREE.BoxGeometry(0.02, 1.10, 0.02), windowFrame, rwx, rwy, 0.09);
      placeMesh(rightBuilding, new THREE.BoxGeometry(0.65, 0.03, 0.02), windowFrame, rwx, rwy + 0.08, 0.09);
      // Sill (below window) + lintel (above)
      placeMesh(rightBuilding, new THREE.BoxGeometry(0.92, 0.07, 0.15), sillMat, rwx, rwy - 0.72, 0.10);
      placeMesh(rightBuilding, new THREE.BoxGeometry(0.92, 0.10, 0.05),
        new THREE.MeshStandardMaterial({ color: 0x8a5a48, roughness: 0.8 }), rwx, rwy + 0.72, 0.06);
    }
  }

  // String courses
  placeMesh(rightBuilding, new THREE.BoxGeometry(4.52, 0.06, 0.09), whiteTrim, 5.5, 5.5, 0.08);
  placeMesh(rightBuilding, new THREE.BoxGeometry(4.52, 0.06, 0.09), whiteTrim, 5.5, 8.4, 0.08);

  // Cornice (multi-layer)
  placeMesh(rightBuilding, new THREE.BoxGeometry(4.6, 0.14, 0.25),
    new THREE.MeshStandardMaterial({ color: 0x6a4838, roughness: 0.8 }), 5.5, 13.05, 0.12);
  placeMesh(rightBuilding, new THREE.BoxGeometry(4.65, 0.08, 0.32),
    new THREE.MeshStandardMaterial({ color: 0x5a3828, roughness: 0.82 }), 5.5, 13.15, 0.16);

  // Drainpipe with brackets + soot streak
  placeMesh(rightBuilding, new THREE.CylinderGeometry(0.04, 0.04, 13, 8), pipeMat, 7.7, 6.5, 0.13);
  for (var rpb = 1.5; rpb < 13; rpb += 3.5) {
    placeMesh(rightBuilding, new THREE.BoxGeometry(0.10, 0.04, 0.10), pipeMat, 7.7, rpb, 0.10);
  }
  placeMesh(rightBuilding, new THREE.PlaneGeometry(0.18, 12),
    new THREE.MeshBasicMaterial({ color: 0x0a0805, transparent: true, opacity: 0.35 }), 7.7, 6.5, 0.115);

  // Small "OPEN" placard hanging behind the door glass
  var rdOpenTex = makeCanvasTexture(64, 32, function(cx, w, h) {
    cx.fillStyle = '#1a0808'; cx.fillRect(0, 0, w, h);
    cx.fillStyle = '#d4b048';
    cx.font = 'bold 18px "PingFang TC", serif';
    cx.textAlign = 'center'; cx.textBaseline = 'middle';
    cx.fillText('營業中', w / 2, h / 2 + 1);
  });
  placeMesh(rightBuilding, new THREE.PlaneGeometry(0.5, 0.18),
    new THREE.MeshBasicMaterial({ map: rdOpenTex, transparent: true }),
    5.5, 1.85, 0.516);

  scene.add(rightBuilding);

  var farRight = new THREE.Mesh(new THREE.BoxGeometry(5, 12, 6),
    new THREE.MeshStandardMaterial({ color: 0x7a5840, roughness: 0.9 }));
  farRight.position.set(10, 6, -3);
  scene.add(farRight);

  // Opposite side
  var oppSide = new THREE.Mesh(new THREE.BoxGeometry(30, 12, 4),
    new THREE.MeshStandardMaterial({ color: 0x403830, roughness: 0.9 }));
  oppSide.position.set(0, 6, 22);
  scene.add(oppSide);
  // Dim windows opposite
  for (var owi = -8; owi < 10; owi += 3) {
    if (Math.random() > 0.5) {
      placeMesh(scene, new THREE.PlaneGeometry(0.7, 1.0),
        new THREE.MeshBasicMaterial({ color: 0xffd699, transparent: true, opacity: 0.06 }), owi, 4 + Math.random() * 4, 19.98);
    }
  }

  // ============================================================
  // PAVEMENTS & STREET DETAIL
  // ============================================================
  var kerbMat = new THREE.MeshStandardMaterial({ color: 0x666666, roughness: 0.8 });
  var paveMat2 = new THREE.MeshStandardMaterial({ color: 0x4a4a4a, roughness: 0.85 });

  var pubPave = new THREE.Mesh(new THREE.BoxGeometry(30, 0.15, 3), paveMat2);
  pubPave.position.set(0, 0.075, 2);
  pubPave.receiveShadow = true;
  scene.add(pubPave);
  var pubKerb = new THREE.Mesh(new THREE.BoxGeometry(30, 0.18, 0.12), kerbMat);
  pubKerb.position.set(0, 0.09, 3.5);
  scene.add(pubKerb);

  // Paving slab grid
  for (var psx = -8; psx < 12; psx += 0.8) {
    placeMesh(scene, new THREE.PlaneGeometry(0.015, 3),
      new THREE.MeshStandardMaterial({ color: 0x555555, roughness: 0.9, transparent: true, opacity: 0.25 }),
      psx, 0.16, 2);
    scene.children[scene.children.length - 1].rotation.x = -Math.PI / 2;
  }

  var oppPave = new THREE.Mesh(new THREE.BoxGeometry(30, 0.15, 3), paveMat2);
  oppPave.position.set(0, 0.075, 11);
  scene.add(oppPave);
  var oppKerb = new THREE.Mesh(new THREE.BoxGeometry(30, 0.18, 0.12), kerbMat);
  oppKerb.position.set(0, 0.09, 9.5);
  scene.add(oppKerb);

  // Puddles (extra reflective near the chippy to pick up that bright glow)
  var puddleMat = new THREE.MeshStandardMaterial({
    color: 0x1a1a2a, roughness: 0.08, metalness: 0.7, transparent: true, opacity: 0.4
  });
  var puddlePos = [[0.5, 4.5, 2.5, 1.5], [-2, 6, 1.5, 0.8], [3, 7, 1.8, 1.0], [-1, 9, 2.0, 1.2], [2, 5.5, 1.0, 0.6]];
  for (var pi = 0; pi < puddlePos.length; pi++) {
    var pp = puddlePos[pi];
    var puddle = new THREE.Mesh(new THREE.PlaneGeometry(pp[2], pp[3]), puddleMat);
    puddle.rotation.x = -Math.PI / 2;
    puddle.position.set(pp[0], 0.02, pp[1]);
    scene.add(puddle);
  }

  // Drain grate
  var grateMat = new THREE.MeshStandardMaterial({ color: 0x2a2a2a, roughness: 0.6, metalness: 0.3 });
  placeMesh(scene, new THREE.BoxGeometry(0.4, 0.02, 0.3), grateMat, -1, 0.08, 3.3);
  for (var gbi = -0.12; gbi <= 0.12; gbi += 0.06) {
    placeMesh(scene, new THREE.BoxGeometry(0.35, 0.025, 0.015), grateMat, -1, 0.09, 3.3 + gbi);
  }

  // The recessed dark gaps beneath the existing grate bars.
  for(var ds=-0.09;ds<0.13;ds+=0.06)outsideFine.box(0.31,0.002,0.03,0x0d1112,-1,0.103,3.3+ds);
  // Bollard
  placeMesh(scene, new THREE.CylinderGeometry(0.06, 0.08, 0.7, 8), ironMat, -2.2, 0.35, 3.2);
  placeMesh(scene, new THREE.SphereGeometry(0.07, 6, 6), ironMat, -2.2, 0.72, 3.2);

  outsideFine.ring(0.077,0.01,0x555448,-2.2,0.07,3.2);
  // Dustbin — moved to the chippy side of the pavement (used to sit
  // outside the Red Dawn). Sits to the left of the chippy door, near
  // the chalkboard-side cluster of streetfurniture.
  placeMesh(scene, new THREE.CylinderGeometry(0.18, 0.16, 0.55, 24),
    new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.7 }), -1.8, 0.28, 1.6);
  placeMesh(scene, new THREE.CylinderGeometry(0.2, 0.2, 0.03, 24),
    new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.7 }), -1.8, 0.57, 1.6);

  outsideFine.ring(0.196,0.01,0x676a60,-1.8,0.587,1.6);
  outsideFine.wire([[-1.85,0.59,1.6],[-1.85,0.63,1.6],[-1.75,0.63,1.6],[-1.75,0.59,1.6]],0.008,0x676a60);
  // Bicycle leaning against wall (like Fryer's Delight)
  var bikeFirstChild=scene.children.length;
  var bikeMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.5, metalness: 0.3 });
  // Frame (simple triangular suggestion)
  placeMesh(scene, new THREE.BoxGeometry(0.8, 0.02, 0.02), bikeMat, -1.8, 0.55, 1.2);
  placeMesh(scene, new THREE.BoxGeometry(0.02, 0.45, 0.02), bikeMat, -2.15, 0.35, 1.2);
  placeMesh(scene, new THREE.BoxGeometry(0.02, 0.5, 0.02), bikeMat, -1.45, 0.38, 1.2);
  placeMesh(scene, new THREE.BoxGeometry(0.5, 0.02, 0.02), bikeMat, -1.8, 0.32, 1.2);
  // Wheels
  placeMesh(scene, new THREE.TorusGeometry(0.23,0.02,6,28).rotateX(Math.PI/2),
    new THREE.MeshStandardMaterial({ color: 0x2a2a2a, roughness: 0.4, metalness: 0.3 }),
    -2.15, 0.25, 1.2);
  scene.children[scene.children.length - 1].rotation.x = Math.PI / 2;
  placeMesh(scene, new THREE.TorusGeometry(0.23,0.02,6,28).rotateX(Math.PI/2),
    new THREE.MeshStandardMaterial({ color: 0x2a2a2a, roughness: 0.4, metalness: 0.3 }),
    -1.45, 0.25, 1.2);
  scene.children[scene.children.length - 1].rotation.x = Math.PI / 2;
  [-2.15,-1.45].forEach(function(x){
    outsideFine.ring(0.211,0.006,0x828782,x,0.25,1.2,null,true);
    outsideFine.put(new THREE.SphereGeometry(0.024,8,6),outsideFine.mat(0x74786e,true),x,0.25,1.217);
    for(var spoke=0;spoke<12;spoke++){var sa=spoke*Math.PI/6;outsideFine.wire([[x,0.25,1.213],[x+Math.cos(sa)*0.208,0.25+Math.sin(sa)*0.208,1.213]],0.0018,0x8c9085);}
  });
  outsideFine.box(0.19,0.035,0.09,0x3d3427,-1.45,0.65,1.2);
  outsideFine.wire([[-1.8,0.32,1.2],[-1.8,0.21,1.24],[-1.73,0.21,1.24]],0.008,0x62675d);
  // Handlebars
  placeMesh(scene, new THREE.BoxGeometry(0.35, 0.02, 0.02), bikeMat, -2.15, 0.7, 1.2);

  // Existing pavement is 0.15 high: seat the whole bicycle on it.
  for(var bikePart=bikeFirstChild;bikePart<scene.children.length;bikePart++)scene.children[bikePart].position.y+=0.15;

  // ============================================================
  // STREETLAMPS
  // ============================================================
  var streetLampLights = [];

  // Victorian cast-iron gas-lamp — stepped base, fluted shaft,
  // mid-band, ladder rest, capital, 4-sided glass lantern,
  // pyramidal cap, crown finial.
  function createLamp(x, z) {
    var g = new THREE.Group();
    var castIron = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.78, metalness: 0.22 });
    var darkIron = new THREE.MeshStandardMaterial({ color: 0x121212, roughness: 0.7, metalness: 0.3 });
    var brassish = new THREE.MeshStandardMaterial({ color: 0x6a4a1a, roughness: 0.6, metalness: 0.35 });

    // ---- Stepped base / plinth ----
    placeMesh(g, new THREE.CylinderGeometry(0.24, 0.28, 0.10, 16), castIron, 0, 0.05, 0);  // ground flange
    placeMesh(g, new THREE.CylinderGeometry(0.20, 0.24, 0.18, 16), castIron, 0, 0.19, 0);  // base drum
    placeMesh(g, new THREE.CylinderGeometry(0.17, 0.20, 0.05, 16), darkIron, 0, 0.31, 0);  // collar
    placeMesh(g, new THREE.BoxGeometry(0.32, 0.32, 0.32), castIron, 0, 0.50, 0);           // dado block
    placeMesh(g, new THREE.CylinderGeometry(0.11, 0.16, 0.06, 16), darkIron, 0, 0.69, 0);  // taper out of dado

    // ---- Fluted main shaft (subtle taper) ----
    placeMesh(g, new THREE.CylinderGeometry(0.058, 0.10, 3.9, 16), castIron, 0, 2.65, 0);

    // Mid-shaft decorative band
    placeMesh(g, new THREE.CylinderGeometry(0.082, 0.082, 0.06, 16), darkIron, 0, 1.55, 0);
    placeMesh(g, new THREE.CylinderGeometry(0.090, 0.090, 0.02, 16), darkIron, 0, 1.58, 0);
    placeMesh(g, new THREE.CylinderGeometry(0.090, 0.090, 0.02, 16), darkIron, 0, 1.52, 0);

    // ---- Ladder rest (horizontal cross-bar near top, for the lamplighter) ----
    placeMesh(g, new THREE.BoxGeometry(0.52, 0.018, 0.018), castIron, 0, 4.45, 0);
    placeMesh(g, new THREE.BoxGeometry(0.018, 0.018, 0.52), castIron, 0, 4.45, 0);
    // tiny finial blobs at the rod ends
    placeMesh(g, new THREE.SphereGeometry(0.024, 6, 4), castIron,  0.26, 4.45, 0);
    placeMesh(g, new THREE.SphereGeometry(0.024, 6, 4), castIron, -0.26, 4.45, 0);
    placeMesh(g, new THREE.SphereGeometry(0.024, 6, 4), castIron, 0, 4.45,  0.26);
    placeMesh(g, new THREE.SphereGeometry(0.024, 6, 4), castIron, 0, 4.45, -0.26);

    // ---- Capital ring (transition from shaft to lantern) ----
    placeMesh(g, new THREE.CylinderGeometry(0.085, 0.062, 0.08, 16), castIron, 0, 4.66, 0);
    placeMesh(g, new THREE.CylinderGeometry(0.105, 0.085, 0.04, 16), darkIron, 0, 4.72, 0);
    placeMesh(g, new THREE.CylinderGeometry(0.045, 0.045, 0.14, 12), castIron, 0, 4.81, 0);

    // ---- LANTERN: 4-sided glass box (4 brightly-lit emissive panes) ----
    // Base plate
    placeMesh(g, new THREE.BoxGeometry(0.34, 0.04, 0.34), darkIron, 0, 4.91, 0);
    // 4 emissive glow panes — one for each face of the lantern.
    // Solid unlit (MeshBasic) so they read as glowing windows, not
    // dark transparent glass.
    var paneMat = new THREE.MeshBasicMaterial({ color: 0xfff0c8 });
    var paneFront = new THREE.Mesh(new THREE.PlaneGeometry(0.26, 0.40), paneMat);
    paneFront.position.set(0, 5.16, 0.134);
    g.add(paneFront);
    var paneBack = new THREE.Mesh(new THREE.PlaneGeometry(0.26, 0.40), paneMat);
    paneBack.position.set(0, 5.16, -0.134);
    paneBack.rotation.y = Math.PI;
    g.add(paneBack);
    var paneLeft = new THREE.Mesh(new THREE.PlaneGeometry(0.26, 0.40), paneMat);
    paneLeft.position.set(-0.134, 5.16, 0);
    paneLeft.rotation.y = Math.PI / 2;
    g.add(paneLeft);
    var paneRight = new THREE.Mesh(new THREE.PlaneGeometry(0.26, 0.40), paneMat);
    paneRight.position.set(0.134, 5.16, 0);
    paneRight.rotation.y = -Math.PI / 2;
    g.add(paneRight);
    // 4 vertical corner posts
    var cornerXZ = [[0.135, 0.135], [-0.135, 0.135], [0.135, -0.135], [-0.135, -0.135]];
    for (var cp = 0; cp < 4; cp++) {
      placeMesh(g, new THREE.BoxGeometry(0.028, 0.44, 0.028), darkIron, cornerXZ[cp][0], 5.16, cornerXZ[cp][1]);
    }
    // Mid horizontal frame
    placeMesh(g, new THREE.BoxGeometry(0.28, 0.018, 0.018), darkIron, 0, 5.16,  0.135);
    placeMesh(g, new THREE.BoxGeometry(0.28, 0.018, 0.018), darkIron, 0, 5.16, -0.135);
    placeMesh(g, new THREE.BoxGeometry(0.018, 0.018, 0.28), darkIron,  0.135, 5.16, 0);
    placeMesh(g, new THREE.BoxGeometry(0.018, 0.018, 0.28), darkIron, -0.135, 5.16, 0);

    // ---- Top plate ----
    placeMesh(g, new THREE.BoxGeometry(0.36, 0.045, 0.36), darkIron, 0, 5.40, 0);

    // ---- Pyramidal cap ----
    var capMesh = new THREE.Mesh(new THREE.ConeGeometry(0.24, 0.20, 4), castIron);
    capMesh.position.set(0, 5.52, 0);
    capMesh.rotation.y = Math.PI / 4;
    g.add(capMesh);

    // ---- Crown finial: ball + spike + small ball ----
    placeMesh(g, new THREE.SphereGeometry(0.034, 8, 6), darkIron, 0, 5.66, 0);
    placeMesh(g, new THREE.CylinderGeometry(0.008, 0.008, 0.12, 8), darkIron, 0, 5.74, 0);
    placeMesh(g, new THREE.SphereGeometry(0.018, 6, 4), brassish,  0, 5.82, 0);

    // ---- Faint point light: just enough to feel real, doesn't
    //      flood the scene. The lantern panes carry the visible glow.
    var light = new THREE.PointLight(0xffd6a0, 0.75, 11);
    light.position.set(0, 5.16, 0);
    light.castShadow = false; // 2026-10-14 (speed): no mesh here takes its shadow
    g.add(light);
    streetLampLights.push(light);

    // ---- Tight halo sprite around the lantern itself ----
    var glowTex = makeCanvasTexture(128, 128, function(cx, w, h) {
      var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
      grad.addColorStop(0, 'rgba(255, 220, 150, 0.85)');
      grad.addColorStop(0.25, 'rgba(255, 200, 110, 0.40)');
      grad.addColorStop(0.6, 'rgba(220, 160, 70, 0.08)');
      grad.addColorStop(1, 'rgba(180, 120, 50, 0)');
      cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
    });
    var glowSprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTex, transparent: true, opacity: 0.7 }));
    glowSprite.position.set(0, 5.16, 0);
    glowSprite.scale.set(2.2, 2.2, 1);
    g.add(glowSprite);

    // ---- Bright inner-core sprite (small, hot centre) ----
    var innerGlowTex = makeCanvasTexture(64, 64, function(cx, w, h) {
      var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
      grad.addColorStop(0, 'rgba(255, 245, 200, 1)');
      grad.addColorStop(0.3, 'rgba(255, 220, 140, 0.55)');
      grad.addColorStop(1, 'rgba(255, 200, 110, 0)');
      cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
    });
    var innerGlow = new THREE.Sprite(new THREE.SpriteMaterial({ map: innerGlowTex, transparent: true, opacity: 0.9 }));
    innerGlow.position.set(0, 5.16, 0);
    innerGlow.scale.set(0.9, 0.9, 1);
    g.add(innerGlow);

    g.position.set(x, 0, z);
    scene.add(g);
  }

  createLamp(-4, 3.5);
  createLamp(5, 3.5);
  createLamp(1, 10);
  createLamp(-4.6, 6.5); // was (-5,10) — sat on the camera axis, a giant dark post square across the shopfront

  // ============================================================
  // SILHOUETTES IN CHIPPY WINDOWS (people at counter)
  // ============================================================
  var silhouettes = [];

  function makeChippySilhouette(seed) {
    return makeCanvasTexture(256, 256, function(cx, w, h) {
      // Bright warm interior background
      var bg = cx.createRadialGradient(w / 2, h * 0.4, 10, w / 2, h * 0.5, w);
      bg.addColorStop(0, 'rgba(255, 220, 140, 0.5)');
      bg.addColorStop(0.4, 'rgba(240, 190, 100, 0.35)');
      bg.addColorStop(0.8, 'rgba(200, 150, 70, 0.15)');
      bg.addColorStop(1, 'rgba(150, 100, 40, 0.05)');
      cx.fillStyle = bg;
      cx.fillRect(0, 0, w, h);

      var figureCount = 1 + Math.floor(seed * 2);
      for (var f = 0; f < figureCount; f++) {
        var fx = (w / (figureCount + 1)) * (f + 1);
        var baseY = h * 0.98;
        var headR = 12 + seed * 5;
        var shoulderW = 30 + seed * 12;

        cx.fillStyle = 'rgba(10, 5, 0, 0.8)';
        // Body
        cx.beginPath();
        cx.moveTo(fx - shoulderW / 2, baseY - h * 0.3);
        cx.lineTo(fx + shoulderW / 2, baseY - h * 0.3);
        cx.lineTo(fx + shoulderW / 2 + 5, baseY);
        cx.lineTo(fx - shoulderW / 2 - 5, baseY);
        cx.closePath(); cx.fill();
        // Shoulders
        cx.beginPath();
        cx.ellipse(fx, baseY - h * 0.33, shoulderW / 2 + 3, 12, 0, 0, Math.PI, true);
        cx.fill();
        // Neck
        cx.fillRect(fx - 5, baseY - h * 0.42, 10, h * 0.09);
        // Head
        cx.beginPath();
        cx.arc(fx + (f - 1) * 3, baseY - h * 0.47, headR, 0, Math.PI * 2);
        cx.fill();

        // Person leaning on counter / eating
        if (f === 0 && seed > 0.3) {
          // Arm reaching forward (to counter)
          cx.fillStyle = 'rgba(10, 5, 0, 0.75)';
          cx.beginPath();
          cx.moveTo(fx - shoulderW / 2, baseY - h * 0.32);
          cx.lineTo(fx - shoulderW / 2 - 15, baseY - h * 0.2);
          cx.lineTo(fx - shoulderW / 2 - 10, baseY - h * 0.18);
          cx.lineTo(fx - shoulderW / 2 + 5, baseY - h * 0.3);
          cx.closePath(); cx.fill();
        }
      }

      // Counter silhouette at bottom (the serving counter seen through glass)
      cx.fillStyle = 'rgba(60, 40, 20, 0.4)';
      cx.fillRect(0, h * 0.75, w, h * 0.25);
    });
  }

  // Silhouettes in both large windows
  var chipWinXs = [-0.7, 1.7];
  var chipSeeds = [0.7, 0.5];
  for (var i = 0; i < chipWinXs.length; i++) {
    var sTex = makeChippySilhouette(chipSeeds[i]);
    var sMat = new THREE.MeshBasicMaterial({
      map: sTex, transparent: true, side: THREE.DoubleSide, depthWrite: false
    });
    var sPlane = new THREE.Mesh(new THREE.PlaneGeometry(2.0, 2.3), sMat);
    sPlane.position.set(chipWinXs[i], 1.9, 0.32);
    shop.add(sPlane);
    silhouettes.push({
      mesh: sPlane, baseX: chipWinXs[i],
      swayPhase: Math.random() * Math.PI * 2,
      swaySpeed: 0.25 + Math.random() * 0.3,
      swayAmt: 0.01 + Math.random() * 0.015
    });
  }

  // ============================================================
  // STEAM SPRITES (from extractor vent — chippy steam!)
  // ============================================================
  var steamSprites = [];
  var steamTex = makeCanvasTexture(64, 64, function(cx, w, h) {
    var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
    grad.addColorStop(0, 'rgba(220, 210, 190, 0.25)');
    grad.addColorStop(0.4, 'rgba(200, 190, 170, 0.1)');
    grad.addColorStop(1, 'rgba(180, 170, 150, 0)');
    cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
  });
  for (var si = 0; si < 8; si++) {
    var steamMat = new THREE.SpriteMaterial({ map: steamTex, transparent: true, opacity: 0.15 + Math.random() * 0.1 });
    var steam = new THREE.Sprite(steamMat);
    steam.position.set(2.8 + (Math.random() - 0.5) * 0.5, 5.5 + Math.random() * 2, 0.5 + Math.random() * 0.5);
    var ss = 1.0 + Math.random() * 1.5;
    steam.scale.set(ss, ss * 1.2, 1);
    shop.add(steam);
    steamSprites.push({
      sprite: steam,
      baseY: steam.position.y,
      baseX: steam.position.x,
      rise: 0.003 + Math.random() * 0.005,
      drift: (Math.random() - 0.5) * 0.002,
      sway: Math.random() * Math.PI * 2,
      resetY: 5.0
    });
  }

  // ============================================================
  // LIGHTING
  // ============================================================
  scene.add(new THREE.AmbientLight(0x121218, 0.25));
  var moonLight = new THREE.DirectionalLight(0x4455aa, 0.08);
  moonLight.position.set(5, 20, 10);
  moonLight.castShadow = true;
  scene.add(moonLight);
  // Blue fill
  var fillLight = new THREE.DirectionalLight(0x2233aa, 0.04);
  fillLight.position.set(-5, 10, -5);
  scene.add(fillLight);

  // ============================================================
  // FOG VOLUMES (4 layers — the chippy glow cuts through the fog)
  // ============================================================
  var thickFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
    var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
    grad.addColorStop(0, 'rgba(180, 170, 155, 0.22)');
    grad.addColorStop(0.4, 'rgba(150, 140, 130, 0.1)');
    grad.addColorStop(1, 'rgba(120, 110, 100, 0)');
    cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
  });
  var thinFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
    var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
    grad.addColorStop(0, 'rgba(140, 135, 125, 0.15)');
    grad.addColorStop(0.6, 'rgba(120, 115, 105, 0.06)');
    grad.addColorStop(1, 'rgba(100, 95, 85, 0)');
    cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
  });
  var warmFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
    var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
    grad.addColorStop(0, 'rgba(255, 220, 140, 0.1)');
    grad.addColorStop(0.5, 'rgba(240, 190, 100, 0.04)');
    grad.addColorStop(1, 'rgba(200, 150, 60, 0)');
    cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
  });

  var fogSprites = [];

  // Layer 1: Ground-hugging
  for (var i = 0; i < 50; i++) {
    var fogMat = new THREE.SpriteMaterial({ map: thickFogTex, transparent: true, opacity: 0.16 + Math.random() * 0.16 });
    var fogSprite = new THREE.Sprite(fogMat);
    fogSprite.position.set(Math.random() * 40 - 15, 0.3 + Math.random() * 2, Math.random() * 30 - 5);
    var s = 5 + Math.random() * 12;
    fogSprite.scale.set(s, s * 0.35, 1);
    scene.add(fogSprite);
    fogSprites.push({ sprite: fogSprite, baseX: fogSprite.position.x, drift: 0.002 + Math.random() * 0.006, sway: Math.random() * Math.PI * 2, swaySpeed: 0.001 + Math.random() * 0.004, swayAmt: 0.4 + Math.random() * 1.0 });
  }

  // Layer 2: Mid-height
  for (var i = 0; i < 28; i++) {
    var midFogMat = new THREE.SpriteMaterial({ map: thinFogTex, transparent: true, opacity: 0.1 + Math.random() * 0.1 });
    var midFog = new THREE.Sprite(midFogMat);
    midFog.position.set(Math.random() * 35 - 12, 2 + Math.random() * 6, Math.random() * 30 - 5);
    var ms = 6 + Math.random() * 14;
    midFog.scale.set(ms, ms * 0.3, 1);
    scene.add(midFog);
    fogSprites.push({ sprite: midFog, baseX: midFog.position.x, drift: 0.001 + Math.random() * 0.004, sway: Math.random() * Math.PI * 2, swaySpeed: 0.0008 + Math.random() * 0.003, swayAmt: 0.5 + Math.random() * 1.5 });
  }

  // Layer 3: Warm fog near chippy (picks up the bright glow)
  for (var i = 0; i < 18; i++) {
    var warmFogMat = new THREE.SpriteMaterial({ map: warmFogTex, transparent: true, opacity: 0.1 + Math.random() * 0.12 });
    var warmFog = new THREE.Sprite(warmFogMat);
    warmFog.position.set(Math.random() * 10 - 3, 0.5 + Math.random() * 3, 1 + Math.random() * 6);
    var ws = 4 + Math.random() * 8;
    warmFog.scale.set(ws, ws * 0.3, 1);
    scene.add(warmFog);
    fogSprites.push({ sprite: warmFog, baseX: warmFog.position.x, drift: 0.001 + Math.random() * 0.003, sway: Math.random() * Math.PI * 2, swaySpeed: 0.001 + Math.random() * 0.003, swayAmt: 0.3 + Math.random() * 0.8 });
  }

  // Layer 4: High wisps
  for (var i = 0; i < 12; i++) {
    var highFogMat = new THREE.SpriteMaterial({ map: thinFogTex, transparent: true, opacity: 0.06 + Math.random() * 0.07 });
    var highFog = new THREE.Sprite(highFogMat);
    highFog.position.set(Math.random() * 30 - 10, 8 + Math.random() * 8, Math.random() * 20 - 5);
    var hs = 10 + Math.random() * 15;
    highFog.scale.set(hs, hs * 0.2, 1);
    scene.add(highFog);
    fogSprites.push({ sprite: highFog, baseX: highFog.position.x, drift: 0.003 + Math.random() * 0.005, sway: Math.random() * Math.PI * 2, swaySpeed: 0.0005 + Math.random() * 0.002, swayAmt: 1.0 + Math.random() * 2.0 });
  }

  // ============================================================
  // ANIMATION LOOP
  // ============================================================
  var clock = new THREE.Clock();
  var neonFlickerPhase = 0;

  var fcWaitTick = fcWaitRoot ? fcWaitingLayer(fcWaitRoot, fcWrap, renderer) : null, fcWaitLast = 0;
  function fcAnimate(now) {
    if (fcWaitRoot && !fcWaitRoot.isConnected) { fcAnimId = null; return; }
    fcAnimId = requestAnimationFrame(fcAnimate);
    if (fcWaitTick) {
      // Thirty frames a second is plenty for a street seen while standing still.
      now = now || performance.now(); if (now - fcWaitLast < 32) return; fcWaitLast = now;
      if (fcWaitPhone !== (window.innerWidth < 600)) { fcWaitPhone = !fcWaitPhone; fcWaitView(); }
      fcWaitTick(now);
    }
    var t = fcStill ? 5 : clock.getElapsedTime();
    // Fog drift
    for (var i = 0; i < (fcStill ? 0 : fogSprites.length); i++) {
      var f = fogSprites[i];
      f.sway += f.swaySpeed;
      f.sprite.position.x = f.baseX + Math.sin(f.sway) * f.swayAmt;
      f.baseX += f.drift;
      if (f.baseX > 25) f.baseX = -25;
    }

    // Fascia spotlight flicker (slight)
    for (var i = 0; i < fasciaLamps.length; i++) {
      var fl = fasciaLamps[i];
      fl.intensity = fl.userData.baseIntensity + Math.sin(t * 4 + i * 1.5) * 0.06;
    }

    // Street lamp flicker
    for (var i = 0; i < streetLampLights.length; i++) {
      streetLampLights[i].intensity = 0.5 + Math.sin(t * 2 + i * 1.5) * 0.05;
    }

    // Interior glow pulse (subtle — bright and steady, comforting)
    interiorLight1.intensity = 0.85 + Math.sin(t * 1.2) * 0.08;
    interiorLight2.intensity = 0.55 + Math.sin(t * 1.5 + 0.5) * 0.05;
    interiorLight3.intensity = 0.55 + Math.sin(t * 1.8 + 1.0) * 0.05;
    doorSpill.intensity = 0.8 + Math.sin(t * 1.3) * 0.1;
    pavementSpill.intensity = 0.6 + Math.sin(t * 1.0) * 0.08;
    fcSheen.material.opacity = 0.075 + (pavementSpill.intensity - 0.6) * 0.3 + (doorSpill.intensity - 0.8) * 0.12;

    // Neon flicker (the "FISH & CHIPS" neon and fish shapes)
    neonFlickerPhase += 0.05;
    var neonPulse = 0.85 + Math.sin(t * 6) * 0.1 + Math.sin(t * 13) * 0.05;
    // Occasional random flicker
    if (!fcStill && Math.random() > 0.995) neonPulse *= 0.4;
    neonFish.material.opacity = neonPulse;
    neonBlueLight.intensity = 0.3 * neonPulse;
    neonFishL.material.opacity = neonPulse * 0.9;
    neonFishR.material.opacity = neonPulse * 0.9;
    neonRedL.intensity = 0.15 * neonPulse;
    neonRedR.intensity = 0.15 * neonPulse;

    // OPEN sign pulse
    openSign.material.opacity = 0.8 + Math.sin(t * 4) * 0.15;
    fc29Steam.position.y = 2.55 + Math.sin(t * 0.7) * 0.08; fc29Steam.material.opacity = 0.11 + Math.sin(t * 0.9) * 0.04; /* 2026-10-28 (note 29) */

    // Silhouette sway
    for (var i = 0; i < silhouettes.length; i++) {
      var s = silhouettes[i];
      s.mesh.position.x = s.baseX + Math.sin(t * s.swaySpeed + s.swayPhase) * s.swayAmt;
    }

    // Steam rise and drift
    for (var i = 0; i < (fcStill ? 0 : steamSprites.length); i++) {
      var st = steamSprites[i];
      st.sprite.position.y += st.rise;
      st.sprite.position.x += st.drift + Math.sin(t * 0.5 + i) * 0.001;
      st.sprite.material.opacity *= 0.9995;
      // Reset when too high or faded
      if (st.sprite.position.y > st.resetY + 4 || st.sprite.material.opacity < 0.02) {
        st.sprite.position.y = st.resetY;
        st.sprite.position.x = st.baseX + (Math.random() - 0.5) * 0.3;
        st.sprite.material.opacity = 0.12 + Math.random() * 0.1;
      }
    }

    // Hanging sign sway
    hangSign.rotation.z = Math.sin(t * 0.9) * 0.04;

    // Fluorescent light very subtle flicker
    if (!fcStill) fluoro.material.color.setHex(Math.random() > 0.998 ? 0xe0e0d0 : 0xf0f0e8);

    // The fly-killer crackle: a flash (sometimes a double-crack) on a
    // random cycle
    var zapBoost = 0;
    if (t > zapState.next) {
      zapState.start = t;
      zapState.dbl = Math.random() < 0.4;
      zapState.next = t + 8 + Math.random()*14;
    }
    var zapAge = t - zapState.start;
    if (zapAge < 0.28) zapBoost = Math.sin(zapAge/0.28*Math.PI);
    else if (zapState.dbl && zapAge > 0.42 && zapAge < 0.62) zapBoost = Math.sin((zapAge - 0.42)/0.2*Math.PI)*0.8;
    fkHalo.material.opacity = 0.85 + zapBoost*0.15;
    fkHalo.scale.set(1.3 + zapBoost*2.9, 0.5 + zapBoost*1.2, 1);
    fkCore.scale.set(1 + zapBoost*0.8, 1 + zapBoost*4.2, 1);
    flyKillerGlow.intensity = 0.55 + zapBoost*4.5;

    // The woman at the red window: fade in, watch, one lean, withdraw
    if (t > rwState.until) {
      if (rwState.mode === 'away') { rwState.mode = 'in'; rwState.until = t + 0.85; }
      else if (rwState.mode === 'in') {
        rwState.mode = 'present';
        var rwDur = 12 + Math.random()*9;
        rwState.until = t + rwDur;
        rwState.leanAt = t + 3 + Math.random()*(rwDur - 7);
      }
      else if (rwState.mode === 'present') { rwState.mode = 'out'; rwState.until = t + 0.7; }
      else { rwState.mode = 'away'; rwState.until = t + 8 + Math.random()*10; }
      rwState.start = t;
    }
    if(fcStill){rwState.mode='present';rwState.until=Infinity;rwState.start=0;}
    var rwP = Math.min((t - rwState.start) / (rwState.mode === 'in' ? 0.85 : 0.7), 1);
    var rwQ = rwP*rwP*(3 - 2*rwP);
    rwMat.opacity = rwState.mode === 'present' ? 0.94 : rwState.mode === 'in' ? rwQ*0.94 : rwState.mode === 'out' ? (1 - rwQ)*0.94 : 0;
    var rwLean=0;
    if(rwState.mode==='present'){
      var rwDl=(t-rwState.leanAt)/4;
      if(rwDl>0&&rwDl<1)rwLean=Math.sin(rwDl*Math.PI);
    }
    var rwEntering=rwState.mode==='in'?1-rwQ:rwState.mode==='out'?rwQ:rwState.mode==='away'?1:0;
    // Step in/out, then watch and lean; only the figure moves, never the wallpaper.
    rwWoman.position.set(2.4+rwEntering*0.11,9.5-rwEntering*0.055,0.15);
    rwHairMat.opacity=rwMat.opacity;rwEdgeMat.opacity=rwMat.opacity;rwFaceMat.opacity=rwMat.opacity;
    rwBodyPivot.rotation.z=fcStill?0:Math.sin(t*.35)*.018-rwLean*.035;
    rwBodyPivot.rotation.x=-rwLean*.035;
    rwHead.rotation.z=fcStill?-.10:-.10+Math.sin(t*.23)*.055+rwLean*.055;
    rwArm.rotation.z=-.24+rwLean*.24;
    rwHand.rotation.y=-.35+rwLean*.35;
    redBrothelLight.intensity=0.32-rwMat.opacity*0.05;

    if(!fcWaitRoot){
      rwBlend=fcStill?(rwClose?1:0):rwBlend+((rwClose?1:0)-rwBlend)*0.065;
      if(Math.abs(rwBlend-(rwClose?1:0))<0.001)rwBlend=rwClose?1:0;
      var rwDistance=window.innerWidth<600?2.35:1.95;
      camera.position.copy(rwStreetPos).lerp(new THREE.Vector3(2.25,9.46,rwDistance),rwBlend);
      camera.fov=rwStreetFov+(42-rwStreetFov)*rwBlend;camera.updateProjectionMatrix();
      camera.lookAt(rwStreetTarget.clone().lerp(rwTarget,rwBlend));camera.updateMatrixWorld();
      rwProjected.copy(rwTarget).project(camera);
      var rwTop=new THREE.Vector3(2.4,10.2,0.15).project(camera),rwBottom=new THREE.Vector3(2.4,8.8,0.15).project(camera);
      var rwHeight=Math.max(42,Math.abs(rwTop.y-rwBottom.y)*window.innerHeight/2),rwWidth=Math.max(32,rwHeight*0.64);
      rwHotspot.style.left=((rwProjected.x+1)*window.innerWidth/2-rwWidth/2)+'px';
      rwHotspot.style.top=((1-rwProjected.y)*window.innerHeight/2-rwHeight/2)+'px';
      rwHotspot.style.width=rwWidth+'px';rwHotspot.style.height=rwHeight+'px';
    }
    if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
  }


  // ── ENTER BUTTON ──
  var fcBtn = document.createElement('div');
  fcBtn.textContent = 'ENTER THE HALIBUT';
  // Ginger-Light style: transparent dark background, coloured text +
  // border, no infill. Hover just brightens the border/text.
  fcBtn.style.cssText = [
    'position:fixed', 'bottom:60px', 'left:50%', 'transform:translateX(-50%)',
    'font:13px "Courier New",monospace',
    'color:rgba(232,180,80,0.85)',
    'letter-spacing:4px', 'cursor:pointer', 'padding:12px 28px',
    'border:1px solid rgba(232,180,80,0.3)',
    'background:rgba(0,0,0,0.4)',
    'z-index:9004', 'white-space:nowrap',
    'opacity:0', 'transition:opacity 1.5s ease, color 0.3s ease, border-color 0.3s ease'
  ].join(';');
  setTimeout(function() { fcBtn.style.opacity = '1'; }, 1800);
  fcBtn.addEventListener('mouseenter', function() {
    this.style.color = 'rgba(255,210,120,0.95)';
    this.style.borderColor = 'rgba(232,180,80,0.6)';
  });
  fcBtn.addEventListener('mouseleave', function() {
    this.style.color = 'rgba(232,180,80,0.85)';
    this.style.borderColor = 'rgba(232,180,80,0.3)';
  });
  fcBtn.addEventListener('click', function() {
    fcWrap.style.transition = 'opacity 1.5s ease';
    fcWrap.style.opacity = '0';
    setTimeout(function() {
      if (fcWrap && fcWrap.parentNode) fcWrap.parentNode.removeChild(fcWrap);
      var TARGET = 'Chinese Fish and Chips';
      if (window.Engine && Engine.go) { Engine.go(TARGET); }
      else {
        var links = document.querySelectorAll('tw-link, .enchantment-link');
        for (var i = 0; i < links.length; i++) {
          if (links[i].textContent.trim() === '\u00b7') { links[i].click(); break; }
        }
      }
    }, 1500);
  });
  if (!fcWaitRoot) fcWrap.appendChild(fcBtn);
  // Keep the exterior choices above its full-screen canvas; proxy their own Harlowe links.
  var outsideChoices=document.querySelector('.bevan-chippy-choices');
  if(outsideChoices&&!fcWaitRoot){var choicesDock=document.createElement('div');choicesDock.className='bevan-chippy-choices';
    Array.prototype.forEach.call(outsideChoices.querySelectorAll('tw-link'),function(link){var choice=document.createElement('button');choice.type='button';choice.textContent=link.textContent;choice.addEventListener('click',function(){link.click();});choicesDock.appendChild(choice);});
    outsideChoices.style.visibility='hidden';fcWrap.appendChild(choicesDock);
  }
  document.body.appendChild(fcWrap);
  fcAnimate();
}

setInterval(function() {
  var container = document.getElementById('fc-container');
  if(container && fcActive && container!==fcSource){if(fcAnimId)cancelAnimationFrame(fcAnimId);window._dssDisposeWrap('fc-wrap');fcActive=false;}
  if (container && !fcActive) { initFc(); }
  else if (!container) {
    fcActive = false;
    if (fcAnimId) { cancelAnimationFrame(fcAnimId); fcAnimId = null; }
    window._dssDisposeWrap('fc-wrap');
  }
}, 300);
})();

// ====== PILLARS SCENE LAYOUT FIX ======
(function() {
  var DECO_DIVS = ['pillars-light','pillars-smoke','pillars-dust'];

  function isDecorative(node) {
    if (node.nodeType === 3) return node.textContent.trim() === '';
    if (node.nodeType !== 1) return true;
    var tag = node.tagName.toUpperCase();
    if (tag === 'SVG') return true; // pillars + lattice are all SVGs
    if (tag === 'STYLE' || tag === 'BR') return true;
    if (tag === 'TW-EXPRESSION' || tag === 'TW-HOOK' || tag === 'TW-MACRO') {
      return node.textContent.trim() === '';
    }
    var cn = typeof node.className === 'string' ? node.className : '';
    for (var i = 0; i < DECO_DIVS.length; i++) {
      if (cn.indexOf(DECO_DIVS[i]) >= 0) return true;
    }
    return false;
  }

  function fixScene(scene) {
    if (scene.dataset.pFixed) return;
    var parent = scene.parentNode;
    if (!parent) return;
    var kids = Array.prototype.slice.call(scene.childNodes);
    var toMove = [];
    for (var i = 0; i < kids.length; i++) {
      if (!isDecorative(kids[i])) toMove.push(kids[i]);
    }
    if (toMove.length === 0) return; // Harlowe hasn't added text yet — wait
    scene.dataset.pFixed = '1';
    var wrapper = document.createElement('div');
    wrapper.style.cssText = 'padding: 0 2.4em;';
    for (var j = 0; j < toMove.length; j++) { wrapper.appendChild(toMove[j]); }
    parent.insertBefore(wrapper, scene);
  }

  var pillarsObs = new MutationObserver(function(muts) {
    for (var i = 0; i < muts.length; i++) {
      var target = muts[i].target;
      var scene = null;
      if (target.className && typeof target.className === 'string' &&
          target.className.indexOf('pillars-scene') >= 0) { scene = target; }
      else if (target.closest) { scene = target.closest('.pillars-scene'); }
      if (scene && !scene.dataset.pFixed) fixScene(scene);
      var added = muts[i].addedNodes;
      for (var j = 0; j < added.length; j++) {
        var n = added[j];
        if (n.nodeType !== 1) continue;
        var cn = typeof n.className === 'string' ? n.className : '';
        if (cn.indexOf('pillars-scene') >= 0 && !n.dataset.pFixed) { fixScene(n); continue; }
        if (n.querySelectorAll) {
          var found = n.querySelectorAll('.pillars-scene');
          for (var k = 0; k < found.length; k++) {
            if (!found[k].dataset.pFixed) fixScene(found[k]);
          }
        }
      }
    }
  });

  pillarsObs.observe(document.body, { childList: true, subtree: true });
})();

// ====== PHONE CALL FADE-IN ======
// The bell now plays on a separate ringing passage, so dialogue can
// start immediately on the call passage with no extra offset.
(function() {
  var PHONE_FADE_OFFSET_MS = 0;
  function runPhoneFades(els) {
    for (var i = 0; i < els.length; i++) {
      (function(el) {
        var dStr = el.style.getPropertyValue('--d') || '0s';
        var tStr = el.style.getPropertyValue('--t') || '1s';
        var delay = parseFloat(dStr) * 1000 + PHONE_FADE_OFFSET_MS;
        setTimeout(function() {
          el.style.transition = 'opacity ' + tStr + ' ease';
          el.style.opacity = '1';
        }, delay);
      })(els[i]);
    }
  }

  var phoneObserver = new MutationObserver(function(mutations) {
    for (var i = 0; i < mutations.length; i++) {
      var added = mutations[i].addedNodes;
      for (var j = 0; j < added.length; j++) {
        var node = added[j];
        if (node.nodeType === 1 && node.querySelectorAll) {
          var phoneEls = node.querySelectorAll('.phone-type');
          if (phoneEls.length > 0) {
            runPhoneFades(phoneEls);
          }
        }
      }
    }
  });

  phoneObserver.observe(document.body, { childList: true, subtree: true });
})();

// ====== STAT BARS LIFT ======
// Move .stat-bars out of tw-passage immediately after Harlowe creates it.
// tw-passage runs a passageFadeIn animation (opacity 0→1); because opacity
// compositing in CSS applies to ALL descendants regardless of position:fixed,
// the stat bars would fade in and out on every navigation.  By reparenting
// .stat-bars directly onto document.body, it is no longer a descendant of
// tw-passage and is completely unaffected by the animation.
(function() {
  new MutationObserver(function() {
    var bars = document.querySelector('tw-passage .stat-bars');
    if (!bars) return;
    // Remove any stale copy left from the previous passage
    var old = document.getElementById('stat-bars-lifted');
    if (old) old.parentNode.removeChild(old);
    // Mark and move to tw-story (not body — links must stay inside tw-story
    // for Harlowe's event delegation to reach them, e.g. the NOTEBOOK link)
    bars.id = 'stat-bars-lifted';
    (document.querySelector('tw-story') || document.body).appendChild(bars);
  }).observe(document.body, { childList: true, subtree: true });
})();

// LORE BOX PERSISTENCE removed 2026-05-20 per Dr Quill — the auto-expand
// behaviour was making the Watkins lore (and others) open on subsequent
// visits without the click. Reverted to click-to-open every time. If
// re-enabling later: see git history for the localStorage + auto-click
// MutationObserver implementation. Also clear any stale storage:
//   localStorage.removeItem('dss-lores-opened')
// is run below so existing playthroughs don't carry the saved set.
(function(){
  try { localStorage.removeItem('dss-lores-opened'); } catch(e) {}
})();

// ====== PASSWORD MECHANIC ======
/* 2026-10-17 (Sam): the prompt line under the box opens the notebook, where Deploy waits; Deploy closes the
   notebook, types the word into the box letter by letter and says it. A wrong word clears the box and flashes
   the prompt; at COPPER's a second wrong word carries on into the confrontation; at LACKLAND's door nothing
   happens but the flash. 2026-10-16 (a tester, "won't let you type password 'i said hello'"): only the letters count. */
var DSS_PWD = {
  copper:   { input: 'copper-pwd-input',   hint: 'copper-pwd-hint',   wrap: 'copper-pwd-wrap',   word: 'I said hello', yes: '#go-copper-yes',   key: 'i said hello', norm: function(v) { return v.toLowerCase().replace(/[^a-z\s]/g, '').trim().replace(/\s+/g, ' '); } },
  lackland: { input: 'lackland-pwd-input', hint: 'lackland-pwd-hint', wrap: 'lackland-pwd-wrap', word: 'Valletta',     yes: '#go-lackland-yes', key: 'valletta',     norm: function(v) { return v.toLowerCase().replace(/[^a-z]/g, ''); } }
};
function dssPwdLink(sel) { return document.querySelector(sel + ' tw-link') || document.querySelector(sel + ' a'); }
function dssPwdFlash(type, text) {
  var h = document.getElementById(DSS_PWD[type].hint); if (!h) return;
  if (text) h.textContent = text;
  h.classList.remove('dss-pwd-flash'); void h.offsetWidth; h.classList.add('dss-pwd-flash');
}
window.dssPwdCheck = function(type) {
  var P = DSS_PWD[type], inp = document.getElementById(P.input), wrap = document.getElementById(P.wrap);
  if (!P || !inp || !wrap || wrap.dataset.typing === '1') return;
  if (P.norm(inp.value || '') === P.key) {
    if (window.dssAudio && window.dssAudio.passwordSuccess) window.dssAudio.passwordSuccess();
    var yes = dssPwdLink(P.yes); if (yes) yes.click();
    return;
  }
  var miss = (parseInt(wrap.dataset.miss, 10) || 0) + 1; wrap.dataset.miss = miss;
  inp.value = '';
  /* at LACKLAND's door nothing happens but the flash, however many times (Sam) */
  if (miss < 2 || type !== 'copper') { dssPwdFlash(type, 'That’s not it. Check your notebook.'); return; }
  var no = dssPwdLink('#go-copper-no'); if (no) no.click();
};
window.checkCopperPwd = function() { window.dssPwdCheck('copper'); };
window.checkLacklandPwd = function() { window.dssPwdCheck('lackland'); };
/* the prompt line opens the notebook (the header's own link) */
window.dssPwdNotebook = function() {
  var nb = document.querySelector('.notebook-link tw-link') || document.querySelector('.notebook-link a') || document.querySelector('.notebook-link');
  if (nb) nb.click();
};
window.deployPwd = function(type) {
  var P = DSS_PWD[type]; if (!P) return;
  var closeLink = document.querySelector('tw-dialog-links tw-link');
  if (closeLink) closeLink.click();
  var attempts = 0;
  var fill = function() {
    if (document.querySelector('tw-dialog') && ++attempts < 40) { setTimeout(fill, 50); return; }
    var inp = document.getElementById(P.input), wrap = document.getElementById(P.wrap);
    if (!inp || !wrap) return;
    /* the room's words may be away: bring the panel, and the box with it, back first */
    if (!inp.getClientRects().length && window.dssRoomProseReopen) window.dssRoomProseReopen();
    wrap.dataset.typing = '1'; inp.value = '';
    try { inp.focus({ preventScroll: true }); } catch (e) {}
    var i = 0, word = P.word;
    (function tick() {
      if (!inp.isConnected) { wrap.dataset.typing = ''; return; }
      inp.value = word.slice(0, ++i);
      if (window.dssAudio && window.dssAudio.typeKey) { try { window.dssAudio.typeKey(); } catch (e) {} }
      if (i < word.length) { setTimeout(tick, 70 + Math.random() * 60); return; }
      setTimeout(function() { wrap.dataset.typing = ''; window.dssPwdCheck(type); }, 500);
    })();
  };
  setTimeout(fill, 80);
};
document.addEventListener('click', function(e) {
  if (e.target && e.target.id === 'copper-pwd-btn')  window.checkCopperPwd();
  if (e.target && e.target.id === 'lackland-pwd-btn') window.checkLacklandPwd();
});
document.addEventListener('keydown', function(e) {
  if (e.key !== 'Enter') return;
  if (document.activeElement && document.activeElement.id === 'copper-pwd-input')  window.checkCopperPwd();
  if (document.activeElement && document.activeElement.id === 'lackland-pwd-input') window.checkLacklandPwd();
});

// ===== DAWN PETALS =====
// One bounded canvas: pearl-white petals lift on a shared thermal, turn
// edge-on, gather into a flood, then leave a quiet drift behind the ending.
(function() {
  var trigger = null, observer = null, fallback = 0, delay = 0, dispose = null;
  function clearWatch() {
    if (observer) observer.disconnect();
    observer = null;
    clearTimeout(fallback); clearTimeout(delay);
  }
  function startPetalStorm() {
    if (dispose || !trigger || !trigger.isConnected) return;
    clearWatch();
    if (window.dssAudio && window.dssAudio.letBedFinish) {
      try { window.dssAudio.letBedFinish('piano-eoin'); } catch(e) {}
    }
    var wrap = document.createElement('div');
    wrap.className = 'dawn-petal-wrap';
    wrap.setAttribute('aria-hidden', 'true');
    var canvas = document.createElement('canvas');
    wrap.appendChild(canvas);
    document.body.appendChild(wrap);
    var ctx = canvas.getContext('2d');
    var finis = document.createElement('div');
    finis.className = 'ending-finis dawn-petal-finis';
    finis.textContent = 'THE END';
    document.body.appendChild(finis);
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var width = 0, height = 0, ratio = 1, frame = 0, last = 0, elapsed = 0, carry = 0;
    var particles = [], sprites = [], stopped = false, dawnLight = null;
    var daylight = document.querySelector(".dawn-daylight"), lastDayStep = -1;
    var dawnPane = trigger.closest('.ending-pane');
    var restart = document.getElementById('dawn-play-again'), restartHome = null;
    var oldPaneOpacity = dawnPane ? dawnPane.style.getPropertyValue('opacity') : '';
    var oldPanePriority = dawnPane ? dawnPane.style.getPropertyPriority('opacity') : '';
    var oldPaneInert = dawnPane ? dawnPane.inert : false;
    // Keep the real restart control, including its original handler and label.
    if (restart) {
      restartHome = document.createComment('Dawn restart home');
      restart.parentNode.insertBefore(restartHome, restart);
      restart.classList.add('dawn-petal-restart');
      document.body.appendChild(restart);
    }
    var TAU = Math.PI * 2;

    // Painted once: irregular cupped silhouettes, a shaded fold and a fine
    // translucent edge. Reuse the little paintings rather than filtering
    // hundreds of DOM elements or rebuilding gradients every frame.
    for (var variant = 0; variant < 3; variant++) {
      var tile = document.createElement('canvas'); tile.width = 80; tile.height = 100;
      var g = tile.getContext('2d');
      var pearl = g.createLinearGradient(17, 10, 61, 78);
      pearl.addColorStop(0, '#fff4de'); pearl.addColorStop(0.38, '#fffefa');
      pearl.addColorStop(0.65, '#f1e6e9'); pearl.addColorStop(0.84, '#d6dce9');
      pearl.addColorStop(1, '#aebbc9');
      g.beginPath();
      if (variant === 0) {
        g.moveTo(40, 87); g.bezierCurveTo(12, 68, 6, 39, 23, 18);
        g.bezierCurveTo(31, 9, 43, 17, 47, 12);
        g.bezierCurveTo(75, 24, 68, 65, 40, 87);
      } else if (variant === 1) {
        g.moveTo(36, 88); g.bezierCurveTo(6, 56, 18, 14, 43, 13);
        g.bezierCurveTo(66, 11, 71, 28, 58, 46);
        g.bezierCurveTo(49, 59, 46, 79, 36, 88);
      } else {
        g.moveTo(43, 87); g.bezierCurveTo(11, 72, 8, 28, 29, 15);
        g.bezierCurveTo(39, 28, 51, 6, 61, 23);
        g.bezierCurveTo(71, 49, 51, 65, 43, 87);
      }
      g.closePath(); g.fillStyle = pearl; g.fill();
      g.strokeStyle = 'rgba(255,255,245,0.65)'; g.lineWidth = 1; g.stroke();
      g.beginPath(); g.moveTo(41, 80); g.bezierCurveTo(32, 61, 43, 40, 38, 23);
      g.strokeStyle = 'rgba(145,160,149,0.27)'; g.lineWidth = 1.1; g.stroke();
      g.beginPath(); g.moveTo(42, 77); g.bezierCurveTo(47, 57, 44, 35, 40, 24);
      g.strokeStyle = 'rgba(255,255,248,0.62)'; g.lineWidth = 1.5; g.stroke();
      sprites.push(tile);
    }
    function resize() {
      width = window.innerWidth; height = window.innerHeight;
      ratio = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * ratio); canvas.height = Math.round(height * ratio);
      canvas.style.width = width + 'px'; canvas.style.height = height + 'px';
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      // 2026-10-26: a broad pearly opening in the sky, painted behind the
      // flowers. No opaque wash: the existing slate/rose dawn stays visible.
      dawnLight = ctx.createRadialGradient(width * 0.64, height * 0.12, 0,
        width * 0.64, height * 0.12, Math.max(width, height) * 0.78);
      dawnLight.addColorStop(0, 'rgba(255,241,211,0.24)');
      dawnLight.addColorStop(0.24, 'rgba(249,218,210,0.13)');
      dawnLight.addColorStop(0.6, 'rgba(219,205,230,0.045)');
      dawnLight.addColorStop(1, 'rgba(219,205,230,0)');
      if (reduced) paint();
    }
    function spawn(scattered) {
      var depth = Math.random();
      var near = depth > 0.82, far = depth < 0.28;
      var size = near ? 34 + Math.random() * 34 : far ? 8 + Math.random() * 9 : 17 + Math.random() * 20;
      var speed = (near ? 105 : far ? 53 : 78) * 0.8 * Math.max(0.65, height / 800);
      var np = {
        x: Math.random() * (width + 120) - 60,
        y: scattered ? Math.random() * height : height + size,
        age: 0, speed: speed * (0.8 + Math.random() * 0.5), size: size,
        phase: Math.random() * TAU, spin: (Math.random() - 0.5) * 1.8,
        lean: Math.random() * TAU, flutter: 0.9 + Math.random() * 1.6,
        alpha: near ? 0.86 : far ? 0.34 : 0.72,
        sprite: sprites[Math.floor(Math.random() * sprites.length)],
        depth: depth, origin: Math.random() * TAU
      };
      // kept in depth order as they arrive (far first), so paint never re-sorts thousands of petals a frame
      var lo = 0, hi = particles.length;
      while (lo < hi) { var mid = (lo + hi) >> 1; if (particles[mid].depth < depth) lo = mid + 1; else hi = mid; }
      particles.splice(lo, 0, np);
    }
    function paint() {
      if (!ctx) return;
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      ctx.clearRect(0, 0, width, height);
      var dissolve = reduced ? 0 : Math.max(0, Math.min(1, (elapsed - 9) / 24));
      dissolve = dissolve * dissolve * (3 - 2 * dissolve);
      if (dawnPane) {
        dawnPane.style.setProperty('opacity', (1 - dissolve).toFixed(3), 'important');
        dawnPane.inert = oldPaneInert || dissolve >= 0.99;
      }
      var endReveal = reduced ? 1 : Math.max(0, Math.min(1, (elapsed - 36) / 6));
      finis.style.opacity = (endReveal * endReveal * (3 - 2 * endReveal)).toFixed(3);
      // Same elapsed clock as the rising flowers; background tabs pause both.
      // Quantise updates to avoid invalidating a large SVG on every frame.
      var dayStep = reduced ? 76 : Math.min(100, Math.floor(elapsed / 36 * 100));
      if (daylight && dayStep !== lastDayStep) {
        lastDayStep = dayStep;
        var dayProgress = dayStep / 100;
        var daylightEase = dayProgress * dayProgress * (3 - 2 * dayProgress);
        daylight.setAttribute('opacity', (daylightEase * 0.72).toFixed(3));
        if (dawnPane) dawnPane.style.setProperty('--dawn-ink-progress', (daylightEase * 100).toFixed(1) + '%');
        finis.style.setProperty('--dawn-ink-progress', (daylightEase * 100).toFixed(1) + '%');
      }
      ctx.globalAlpha = reduced ? 0.7 : Math.min(1, elapsed / 14);
      ctx.fillStyle = dawnLight; ctx.fillRect(0, 0, width, height);
      ctx.globalAlpha = 1;
      // Far-to-near rendering makes overlapping translucent petals read as depth (spawn keeps them in that order).
      particles.forEach(function(p) {
        var sway = Math.sin(p.age * 0.75 + p.phase) * (18 + p.depth * 42);
        // Broad rising ribbons share a current, with small individual eddies.
        // The upward taper is deliberately slight: the whole screen still floods.
        var lift = Math.max(0, Math.min(1, 1 - p.y / height));
        var thermal = Math.sin(elapsed * 0.22 + p.y / height * 3.2) * (30 + p.depth * 56);
        var eddy = Math.sin(p.age * 0.46 + p.origin) * 16 * p.depth;
        var x = p.x + (width * 0.64 - p.x) * lift * lift * 0.16 + sway + thermal + eddy;
        var fade = Math.min(1, p.age / 1.4, Math.max(0, (p.y + p.size) / (height * 0.19)));
        var ang = p.lean + p.age * p.spin + Math.sin(p.age * 1.1 + p.phase) * 0.28;
        // A thin profile between two broad faces: the petal turns in the air.
        var face = Math.cos(p.age * p.flutter + p.phase);
        var sx = 0.18 + Math.abs(face) * 0.82, co = Math.cos(ang) * ratio, si = Math.sin(ang) * ratio;
        // one transform per petal (translate, rotate, then squash on x), in place of save/translate/rotate/scale/restore
        ctx.setTransform(co * sx, si * sx, -si, co, x * ratio, p.y * ratio);
        ctx.globalAlpha = p.alpha * (reduced ? 0.6 : fade) * (0.78 + Math.abs(face) * 0.22);
        ctx.drawImage(p.sprite, -p.size * 0.4, -p.size * 0.5, p.size * 0.8, p.size);
      });
      ctx.globalAlpha = 1;
    }
    function tick(now) {
      if (stopped) return;
      if (!trigger || !trigger.isConnected) { dispose(); return; }
      var dt = last ? Math.min((now - last) / 1000, 0.05) : 0; last = now;
      elapsed += dt;
      // 2026-10-12 (Sam: "too few rising petals at the Dawn close: I want the screen flooded"). About three times
      // the old flood (115 a second, capped at 1000; 320 on a phone): a quicker swell to ~330 a second, held to 26 s,
      // then the same slow ebb to a quiet drift. The cap scales with the screen, never under 1300.
      var rate = elapsed < 6 ? 30 + elapsed * 50 :
        elapsed < 26 ? 330 : 6 + 324 * Math.exp(-(elapsed - 26) / 2.5);
      var cap = Math.min(3000, Math.max(1300, Math.round(width * height / 400)));
      carry += rate * dt;
      while (carry >= 1) { if (particles.length < cap) spawn(false); carry--; }
      particles.forEach(function(p){
        p.age += dt;
        p.y -= p.speed * (0.9 + 0.13 * Math.sin(p.age * 0.65 + p.phase)) * dt;
      });
      particles = particles.filter(function(p){ return p.y > -p.size; });
      paint();
      frame = requestAnimationFrame(tick);
    }
    function visibility() {
      cancelAnimationFrame(frame); last = 0;
      if (!document.hidden && !reduced && !stopped) frame = requestAnimationFrame(tick);
    }
    dispose = function() {
      if (stopped) return;
      stopped = true; cancelAnimationFrame(frame);
      window.removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', visibility);
      if (daylight) daylight.setAttribute('opacity', '0');
      if (dawnPane) dawnPane.style.removeProperty('--dawn-ink-progress');
      if (dawnPane) {
        if (oldPaneOpacity) dawnPane.style.setProperty('opacity', oldPaneOpacity, oldPanePriority);
        else dawnPane.style.removeProperty('opacity');
        dawnPane.inert = oldPaneInert;
      }
      if (restart) {
        restart.classList.remove('dawn-petal-restart');
        if (restartHome && restartHome.parentNode) restartHome.replaceWith(restart);
        else restart.remove();
      }
      wrap.remove(); finis.remove(); particles = []; sprites = []; dispose = null;
    };
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', visibility);
    resize();
    if (reduced) {
      for (var j = 0; j < 45; j++) spawn(true);
      paint();
    } else frame = requestAnimationFrame(tick);
  }
  function watchDawn() {
    var next = document.getElementById('dawn-petal-trigger');
    if (next === trigger) return;
    clearWatch();
    if (dispose) dispose();
    trigger = next;
    if (!trigger) return;
    var fired = false;
    function fire(wait) {
      if (fired) return;
      fired = true; clearWatch();
      delay = setTimeout(startPetalStorm, wait);
    }
    observer = new IntersectionObserver(function(entries){
      if (entries.some(function(e){return e.isIntersecting;})) fire(18000);
    }, {threshold:0.3});
    observer.observe(trigger);
    fallback = setTimeout(function(){fire(18000);},36000);
  }
  // Only a changed passage trigger starts a new lifecycle. Canvas frames do
  // not mutate the DOM, and leaving Dawn cancels every pending timer/animation.
  new MutationObserver(watchDawn).observe(document.body,{childList:true,subtree:true});
  watchDawn();
})();


// Small material and fitting details shared by the dream scenes; no hit targets.
window.dssDreamDetail = function(scene) {
 var mats={};
 function mat(c,metal){var k=c+':'+!!metal;return mats[k]||(mats[k]=new THREE.MeshStandardMaterial({color:c,roughness:metal?0.67:0.94,metalness:metal?0.48:0}));}
 function put(geo,m,x,y,z,parent){var o=new THREE.Mesh(geo,m);o.position.set(x,y,z);(parent||scene).add(o);return o;}
 function box(w,h,d,c,x,y,z,p,metal){return put(new THREE.BoxGeometry(w,h,d),mat(c,metal),x,y,z,p);}
 function ring(r,t,c,x,y,z,p,vertical){var o=put(new THREE.TorusGeometry(r,t,5,24),mat(c,true),x,y,z,p);if(!vertical)o.rotation.x=Math.PI/2;return o;}
 function wire(points,r,c,p){return put(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(points.map(function(v){return new THREE.Vector3(v[0],v[1],v[2]);})),20,r,5,false),mat(c,false),0,0,0,p);}
 function pin(x,y,z,p){return put(new THREE.SphereGeometry(0.018,6,4),mat(0x777268,true),x,y,z,p);}
 return {mat:mat,put:put,box:box,ring:ring,wire:wire,pin:pin};
};

// ====== THE ENLIGHTENMENT — AIRPORT PUB SCENE — INLINE ======
// The Enlightenment: an open bay cut into the terminal's south wall,
// seen across the concourse. Bunting up for something that finished.
// Ported 2026-09-14 from airport-pub-3d-static.html, the standalone
// prototype built on 2026-09-12. Standard lifecycle: ap-container / ap-wrap /
// _dssDisposeWrap. The overlay fades in place to reveal the passage prose;
// each world is entered once, from the Third Pillar Portal.
(function() {
var apActive = false;
var apAnimId = null;

function initap() {
if (apActive) return;
apActive = true;
if (typeof THREE === 'undefined') {
var sc = document.createElement('script');
sc.src = 'vendor/three/three.min.js';
sc.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildapScene) : buildapScene()); };
document.head.appendChild(sc);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildapScene) : buildapScene());
}
}

function buildapScene() {
var apWrap = document.createElement('div');
apWrap.id = 'ap-wrap';
apWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#0b0d13;';

// the prototype's fixed labels, re-homed inside the overlay
var apStamp = document.createElement('div');
apStamp.textContent = 'DEPARTURES';
apStamp.style.cssText = 'position:absolute;top:18px;right:24px;font:14px "Courier New",monospace;color:rgba(212,178,88,0.5);letter-spacing:2px;pointer-events:none;z-index:9002;';
apWrap.appendChild(apStamp);
var apLoc = document.createElement('div');
apLoc.classList.add('dss-room-caption');
apLoc.textContent = 'THE ENLIGHTENMENT — AIRPORT PUB';
apLoc.style.cssText = 'position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New",monospace;color:rgba(212,178,88,0.4);letter-spacing:2px;pointer-events:none;z-index:9002;';
apWrap.appendChild(apLoc);
var apTip = document.createElement('div');
apTip.style.cssText = 'position:fixed;padding:6px 14px;background:rgba(20,17,16,0.94);border:1px solid rgba(212,178,88,0.45);font:italic 13px Georgia,serif;color:#e8d5b7;pointer-events:none;opacity:0;transition:opacity 0.3s;z-index:9003;';
apTip.classList.add('ap-tip');
apWrap.appendChild(apTip);
// the prototype toggles the tooltip with a .visible class
var apTipObs = new MutationObserver(function() {
apTip.style.opacity = apTip.classList.contains('visible') ? '1' : '0';
});
apTipObs.observe(apTip, { attributes: true, attributeFilter: ['class'] });

// Reduced motion: hold the loop's clock (t pinned, dt 0) so the pendants,
// bunting, drinkers and departures board settle, and skip the random
// flickers (tube, neon) and the fog drift.
var apStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var apEntered = false;
function apEnter() {
if (apEntered) return;
apEntered = true;
apWrap.style.transition = 'opacity 1.6s ease';
apWrap.style.opacity = '0';
setTimeout(function() {
if (apAnimId) { cancelAnimationFrame(apAnimId); apAnimId = null; }
try { apTipObs.disconnect(); } catch(e) {}
window._dssDisposeWrap('ap-wrap');
}, 1600);
}

  // ============================================================
  // SCENE SETUP
  // ============================================================
  var scene = new THREE.Scene();
  var fine = window.dssDreamDetail(scene);
  scene.background = new THREE.Color(0x0d0e0c); /* 2026-10-23 (Sam): India, nicotine departure lounge with silver */
  scene.fog = new THREE.Fog(0x0d0e0c, 6, 27);

  // ============================================================
  // LAYOUT
  // ============================================================
  // The pub is an open bay cut into the terminal's south wall.
  // Frontage runs along z = 0 from x = -7 to x = 7; interior z in [-14, 0].
  // The concourse is everything z > 0. The camera stands on the concourse
  // off to the RIGHT of the bay, looking across and in: near cage pier at
  // the right edge, sign running across the top and off the left, tables
  // and the bar receding on the diagonal. Fixed, no drag.
  var camera = new THREE.PerspectiveCamera(64, window.innerWidth / window.innerHeight, 0.1, 200);
  camera.position.set(6.8, 1.8, 6.6);
  camera.lookAt(-1.4, 2.0, -6);

  var renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
  renderer.toneMappingExposure = 0.74;
  apWrap.appendChild(renderer.domElement);
  renderer.domElement.style.display = 'block';
  window._dssBindScene('ap-wrap', scene, renderer, camera);

  // resize is handled by _dssBindScene above.

  // ============================================================
  // CLICK TO ENTER
  // ============================================================
  var clickableObjects = [], venueData = new Map(), mouseNDC = new THREE.Vector2(-2, -2);
  var raycaster = new THREE.Raycaster(), hoveredVenue = null, tooltip = apTip, mouseMoved = false;
  function makeClickable(mesh, info) { clickableObjects.push(mesh); venueData.set(mesh, info); }
  apWrap.addEventListener('mousemove', function(e) {
    mouseMoved = true; mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
    tooltip.style.left = (e.clientX + 15) + 'px'; tooltip.style.top = (e.clientY - 30) + 'px';
  });
  apWrap.addEventListener('click', function() { if (hoveredVenue) apEnter(); });

  // ============================================================
  // HELPERS
  // ============================================================
  function canvasTex(w, h, draw, rep) {
    var c = document.createElement('canvas'); c.width = w; c.height = h;
    draw(c.getContext('2d'), w, h);
    var t = new THREE.CanvasTexture(c);
    if (rep) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rep[0], rep[1]); }
    t.anisotropy = 8;
    return t;
  }
  function box(w, h, d, mat, x, y, z, opts) {
    var m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    m.position.set(x, y, z);
    opts = opts || {};
    m.castShadow = opts.cast !== false; m.receiveShadow = opts.receive !== false;
    if (opts.ry) m.rotation.y = opts.ry;
    (opts.parent || scene).add(m); return m;
  }
  function cyl(rt, rb, h, seg, mat, x, y, z, parent) {
    var m = new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, seg), mat);
    m.position.set(x, y, z); m.castShadow = true; (parent || scene).add(m); return m;
  }
  function glowSprite(color, size, x, y, z, parent) {
    var t = canvasTex(64, 64, function(ctx) {
      var g = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
      g.addColorStop(0, color + '0.85)'); g.addColorStop(0.4, color + '0.35)'); g.addColorStop(1, color + '0)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, 64, 64);
    });
    var s = new THREE.Sprite(new THREE.SpriteMaterial({ map: t, blending: THREE.AdditiveBlending, transparent: true, depthWrite: false }));
    s.scale.set(size, size, 1); s.position.set(x, y, z); (parent || scene).add(s); return s;
  }
  function rand(a, b) { return a + Math.random() * (b - a); }

  // ============================================================
  // TEXTURES (all procedural)
  // ============================================================
  // Concourse: big pale ceramic tiles, grout, scuffs
  var terminalTileTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#6e6c66'; ctx.fillRect(0, 0, w, h);
    var n = 4, s = w / n;
    for (var i = 0; i < n; i++) for (var j = 0; j < n; j++) {
      var v = 98 + Math.floor(Math.random() * 12);
      ctx.fillStyle = 'rgb(' + v + ',' + (v - 2) + ',' + (v - 9) + ')';
      ctx.fillRect(i * s + 2, j * s + 2, s - 4, s - 4);
      for (var k = 0; k < 20; k++) {
        ctx.fillStyle = 'rgba(60,52,44,' + (Math.random() * 0.07) + ')';
        ctx.fillRect(i * s + Math.random() * s, j * s + Math.random() * s, Math.random() * 22, 1 + Math.random() * 2);
      }
    }
    ctx.strokeStyle = '#3a3834'; ctx.lineWidth = 3;
    for (var g = 0; g <= n; g++) { ctx.beginPath(); ctx.moveTo(g * s, 0); ctx.lineTo(g * s, h); ctx.stroke(); ctx.beginPath(); ctx.moveTo(0, g * s); ctx.lineTo(w, g * s); ctx.stroke(); }
  }, [20, 20]);

  // Pub boards: reclaimed, worn
  var boardTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#3e2a1a'; ctx.fillRect(0, 0, w, h);
    var bw = 40;
    for (var x = 0; x < w; x += bw) {
      var r = 84 + Math.floor(Math.random() * 40), g = 54 + Math.floor(Math.random() * 20), b = 28 + Math.floor(Math.random() * 12);
      ctx.fillStyle = 'rgb(' + r + ',' + g + ',' + b + ')'; ctx.fillRect(x + 1, 0, bw - 2, h);
      for (var k = 0; k < 50; k++) {
        ctx.strokeStyle = 'rgba(28,16,6,' + (0.08 + Math.random() * 0.16) + ')'; ctx.lineWidth = 1; ctx.beginPath();
        var yy = Math.random() * h; ctx.moveTo(x + 2, yy); ctx.lineTo(x + bw - 2, yy + (Math.random() - 0.5) * 8); ctx.stroke();
      }
      ctx.fillStyle = 'rgba(18,10,4,0.75)'; ctx.fillRect(x + 1, Math.random() * h, bw - 2, 2);
      for (var n = 0; n < 3; n++) { ctx.fillStyle = 'rgba(30,20,10,0.6)'; ctx.beginPath(); ctx.arc(x + 6 + Math.random() * (bw - 12), Math.random() * h, 1.5, 0, 6.3); ctx.fill(); }
    }
  }, [5, 5]);

  // The pub carpet: a proper airport-pub carpet, swirls in maroon, teal and gold
  var carpetTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#4a1e2c'; ctx.fillRect(0, 0, w, h);
    var cols = ['#2a6a66', '#b58a2a', '#7a2a3a', '#1c3a4a', '#c9a24a'];
    for (var i = 0; i < 160; i++) {
      ctx.strokeStyle = cols[i % cols.length]; ctx.lineWidth = 3 + Math.random() * 4; ctx.globalAlpha = 0.55 + Math.random() * 0.35;
      ctx.beginPath();
      var cx = Math.random() * w, cy = Math.random() * h, r = 12 + Math.random() * 40;
      ctx.arc(cx, cy, r, Math.random() * 6, Math.random() * 6); ctx.stroke();
    }
    ctx.globalAlpha = 1;
    for (var k = 0; k < 4000; k++) { ctx.fillStyle = 'rgba(0,0,0,' + Math.random() * 0.25 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 2, 2); }
  }, [4, 4]);

  // Concourse ceiling tiles
  var ceilingTex = canvasTex(256, 256, function(ctx, w, h) {
    ctx.fillStyle = '#cfd0ca'; ctx.fillRect(0, 0, w, h);
    for (var k = 0; k < 1200; k++) { ctx.fillStyle = 'rgba(110,110,105,' + Math.random() * 0.3 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 1, 1); }
    ctx.strokeStyle = '#8c8c88'; ctx.lineWidth = 5; ctx.strokeRect(0, 0, w, h);
  }, [30, 30]);

  // Pub back wall: painted brick, dark
  var pubBrickTex = canvasTex(512, 256, function(ctx, w, h) {
    ctx.fillStyle = '#2e2220'; ctx.fillRect(0, 0, w, h);
    var bh = 22, bw = 64;
    for (var row = 0; row < h / bh; row++) {
      var off = (row % 2) * bw / 2;
      for (var x = -bw; x < w + bw; x += bw) {
        var v = 62 + Math.floor(Math.random() * 34);
        ctx.fillStyle = 'rgb(' + (v + 24) + ',' + (v - 2) + ',' + (v - 14) + ')';
        ctx.fillRect(x + off + 2, row * bh + 2, bw - 4, bh - 4);
        ctx.fillStyle = 'rgba(0,0,0,' + Math.random() * 0.25 + ')'; ctx.fillRect(x + off + 2, row * bh + 2, bw - 4, 4);
      }
    }
  }, [6, 3]);

  // Riveted dark steel for the fascia
  var steelTex = canvasTex(512, 128, function(ctx, w, h) {
    ctx.fillStyle = '#1a1614'; ctx.fillRect(0, 0, w, h);
    for (var k = 0; k < 3000; k++) { ctx.fillStyle = 'rgba(80,70,60,' + Math.random() * 0.12 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 2, 1); }
    for (var x = 12; x < w; x += 48) for (var y = 12; y < h; y += 104) {
      ctx.fillStyle = '#3a332e'; ctx.beginPath(); ctx.arc(x, y, 4, 0, 6.3); ctx.fill();
      ctx.fillStyle = '#5a504a'; ctx.beginPath(); ctx.arc(x - 1, y - 1, 2, 0, 6.3); ctx.fill();
    }
  }, [4, 1]);

  // Timber cladding for the cage shelves and pier sides
  var timberTex = canvasTex(256, 256, function(ctx, w, h) {
    ctx.fillStyle = '#6a4a2c'; ctx.fillRect(0, 0, w, h);
    for (var y = 0; y < h; y += 32) {
      var v = 90 + Math.floor(Math.random() * 40);
      ctx.fillStyle = 'rgb(' + v + ',' + (v - 28) + ',' + (v - 50) + ')'; ctx.fillRect(0, y + 1, w, 30);
      for (var k = 0; k < 30; k++) { ctx.strokeStyle = 'rgba(30,18,8,' + Math.random() * 0.25 + ')'; ctx.beginPath(); var yy = y + Math.random() * 30; ctx.moveTo(0, yy); ctx.lineTo(w, yy + (Math.random() - 0.5) * 4); ctx.stroke(); }
    }
  }, [2, 2]);

  // 2026-10-28: the same restrained material finish as the Soho interiors.
  window.dssInteriorSurface(terminalTileTex, 'tile', 90);
  window.dssInteriorSurface(boardTex, 'wood', 91);
  window.dssInteriorSurface(carpetTex, 'carpet', 92);
  window.dssInteriorSurface(ceilingTex, 'plaster', 93);
  window.dssInteriorSurface(pubBrickTex, 'stone', 94);
  window.dssInteriorSurface(steelTex, 'metal', 95);
  window.dssInteriorSurface(timberTex, 'wood', 96);

  // Sign lettering: dark ground, warm lit letters
  function signTex(text, w, h, opts) {
    opts = opts || {};
    return canvasTex(w, h, function(ctx, cw, ch) {
      ctx.fillStyle = opts.bg || '#15100c'; ctx.fillRect(0, 0, cw, ch);
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.shadowColor = opts.glow || 'rgba(255,175,85,0.95)'; ctx.shadowBlur = opts.blur || 30;
      ctx.fillStyle = opts.color || '#ffdca6';
      ctx.font = (opts.weight || 'bold ') + Math.floor(ch * (opts.scale || 0.62)) + 'px ' + (opts.font || '"Playfair Display", Georgia, serif');
      ctx.fillText(text, cw / 2, ch / 2 + (opts.dy || 0));
      ctx.shadowBlur = 0;
    });
  }

  function clockTex(hh, mm, label) {
    return canvasTex(256, 256, function(ctx, w, h) {
      ctx.clearRect(0, 0, w, h);
      ctx.beginPath(); ctx.arc(128, 116, 94, 0, Math.PI * 2); ctx.fillStyle = '#ece2cc'; ctx.fill();
      ctx.lineWidth = 9; ctx.strokeStyle = '#241c14'; ctx.stroke();
      ctx.strokeStyle = '#241c14'; ctx.lineWidth = 4;
      for (var i = 0; i < 12; i++) { var a = i / 12 * Math.PI * 2; ctx.beginPath(); ctx.moveTo(128 + Math.sin(a) * 78, 116 - Math.cos(a) * 78); ctx.lineTo(128 + Math.sin(a) * 88, 116 - Math.cos(a) * 88); ctx.stroke(); }
      var ha = ((hh % 12) + mm / 60) / 12 * Math.PI * 2, ma = mm / 60 * Math.PI * 2;
      ctx.lineWidth = 7; ctx.beginPath(); ctx.moveTo(128, 116); ctx.lineTo(128 + Math.sin(ha) * 48, 116 - Math.cos(ha) * 48); ctx.stroke();
      ctx.lineWidth = 4; ctx.beginPath(); ctx.moveTo(128, 116); ctx.lineTo(128 + Math.sin(ma) * 74, 116 - Math.cos(ma) * 74); ctx.stroke();
      ctx.fillStyle = '#e8c58c'; ctx.textAlign = 'center'; ctx.font = 'bold 22px Georgia, serif'; ctx.fillText(label, 128, 244);
    });
  }

  // Departures board (also shown on the pub's TV)
  var departuresRows = [['DELHI', 'BOARDING'], ['LIMA', 'GATE 7'], ['HANGA ROA', 'DELAYED'], ['CAIRO', 'WAIT IN LOUNGE'], ['BABYLON', 'SEE AGENT']];
  var departuresCanvas = document.createElement('canvas'); departuresCanvas.width = 512; departuresCanvas.height = 384;
  function drawDepartures(flipRow, flipPhase) {
    var ctx = departuresCanvas.getContext('2d'), w = 512, h = 384;
    ctx.fillStyle = '#06070a'; ctx.fillRect(0, 0, w, h);
    ctx.fillStyle = '#181a22'; ctx.fillRect(0, 0, w, 54);
    ctx.textBaseline = 'middle'; ctx.textAlign = 'left';
    ctx.fillStyle = '#c8c8d0'; ctx.font = 'bold 26px Georgia, serif'; ctx.fillText('DEPARTURES', 22, 27);
    ctx.shadowColor = 'rgba(255,190,90,0.9)'; ctx.shadowBlur = 8;
    for (var i = 0; i < departuresRows.length; i++) {
      var y = 92 + i * 60; ctx.fillStyle = '#ffbb55'; ctx.font = 'bold 28px "Courier New", monospace';
      var dest = departuresRows[i][0], stat = departuresRows[i][1];
      if (i === flipRow) { var scr = ''; for (var c = 0; c < stat.length; c++) scr += (Math.random() < flipPhase) ? stat[c] : String.fromCharCode(65 + Math.floor(Math.random() * 26)); stat = scr; }
      ctx.fillText(dest, 22, y); ctx.textAlign = 'right'; ctx.fillText(stat, w - 22, y); ctx.textAlign = 'left';
    }
    ctx.shadowBlur = 0;
  }
  drawDepartures(-1, 1);
  var departuresTex = new THREE.CanvasTexture(departuresCanvas);

  var chalkTex = canvasTex(256, 384, function(ctx, w, h) {
    ctx.fillStyle = '#1b1e1b'; ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = '#5a4030'; ctx.lineWidth = 12; ctx.strokeRect(6, 6, w - 12, h - 12);
    ctx.fillStyle = '#e6dfcc'; ctx.textAlign = 'center';
    ctx.font = 'italic 30px Georgia, serif'; ctx.fillText('The', 128, 70);
    ctx.font = 'bold 30px Georgia, serif'; ctx.fillText('Enlightenment', 128, 112);
    ctx.strokeStyle = '#e6dfcc'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(60, 132); ctx.lineTo(196, 132); ctx.stroke();
    ctx.fillStyle = '#d9c9a0'; for (var i = 0; i < 6; i++) ctx.fillRect(48 + Math.random() * 20, 160 + i * 30, 120 + Math.random() * 40, 3);
    ctx.fillStyle = '#f0c060'; ctx.font = 'bold 40px Georgia, serif'; ctx.fillText('OPEN', 128, 350);
  });

  // Seated / standing dark figures, like the Soho window silhouettes
  function figureTex(seated, seed) {
    return canvasTex(128, 256, function(ctx, w, h) {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(12,8,4,0.92)';
      var cx = 64, headR = 14 + seed * 4, top = seated ? 70 : 30;
      ctx.beginPath(); ctx.arc(cx + (seed - 0.5) * 6, top, headR, 0, 6.3); ctx.fill();
      ctx.fillRect(cx - 6, top + headR - 2, 12, 14);
      ctx.beginPath(); ctx.ellipse(cx, top + headR + 18, 30 + seed * 8, 12, 0, Math.PI, 0); ctx.fill();
      ctx.beginPath();
      ctx.moveTo(cx - 30 - seed * 8, top + headR + 18); ctx.lineTo(cx + 30 + seed * 8, top + headR + 18);
      if (seated) { ctx.lineTo(cx + 34, h * 0.72); ctx.lineTo(cx - 34, h * 0.72); }
      else { ctx.lineTo(cx + 26, h); ctx.lineTo(cx - 26, h); }
      ctx.closePath(); ctx.fill();
      if (seed > 0.5) { ctx.beginPath(); ctx.moveTo(cx + 28, top + headR + 22); ctx.lineTo(cx + 46, top + headR + 4); ctx.lineTo(cx + 52, top + headR + 10); ctx.lineTo(cx + 36, top + headR + 34); ctx.fill(); }
    });
  }

  // ============================================================
  // LIGHTING
  // ============================================================
  scene.add(new THREE.AmbientLight(0x4a4c40, 0.22));
  scene.add(new THREE.HemisphereLight(0xb8b49a, 0x2a2820, 0.16));
  var concourseFill = new THREE.DirectionalLight(0xc8ccd4, 0.08); concourseFill.position.set(6, 18, 22); scene.add(concourseFill);

  // Warm interior fill so the far tables don't sink
  var wallWash = new THREE.PointLight(0xc8ccd4, 0.35, 10, 2); wallWash.position.set(9.5, 4.2, 3.0); scene.add(wallWash);
  var pubFill = new THREE.PointLight(0xc08a48, 0.6, 20, 2); pubFill.position.set(0, 3.0, -7); scene.add(pubFill);

  function addSpot(x, y, z, tx, ty, tz, color, intensity, angle, dist, shadow) {
    var s = new THREE.SpotLight(color, intensity, dist, angle, 0.6, 2);
    s.position.set(x, y, z); s.target.position.set(tx, ty, tz);
    if (shadow) { s.castShadow = true; s.shadow.mapSize.set(1024, 1024); s.shadow.bias = -0.0005; }
    scene.add(s); scene.add(s.target); return s;
  }
  // Fascia downlights washing the threshold
  addSpot(-4.5, 3.3, 0.5, -4.5, 0, 0.8, 0xd8b878, 2.2, 0.7, 12);
  addSpot(0, 3.3, 0.5, 0, 0, 0.8, 0xd8b878, 2.6, 0.7, 12, true);
  addSpot(4.5, 3.3, 0.5, 4.5, 0, 0.8, 0xd8b878, 2.2, 0.7, 12, true);

  // ============================================================
  // CONCOURSE
  // ============================================================
  var terminalFloor = new THREE.Mesh(new THREE.PlaneGeometry(90, 90), new THREE.MeshStandardMaterial({ map: terminalTileTex, roughness: 0.18, metalness: 0.12 }));
  terminalFloor.rotation.x = -Math.PI / 2; terminalFloor.position.set(0, 0, 44); terminalFloor.receiveShadow = true; scene.add(terminalFloor);
  // The sign's light lying on the polished concourse tile in front of the
  // bay: one additive plane from the frontage out to z 3.3, a warm wash
  // under THE ENLIGHTENMENT (x -4.6..3.8) and a red pool under the neon
  // (x 5.5), fading with distance from the frontage and cut by the grout
  // lines (tiles are 1.125 units square here). Opacity follows the neon's
  // buzz in animate.
  var apSheenTex = canvasTex(512, 128, function(ctx, w, h) {
    var px = function(x) { return (x + 4.8) / 11.4 * w; };
    var warm = ctx.createLinearGradient(px(-4.6), 0, px(3.8), 0);
    warm.addColorStop(0, 'rgba(255,176,96,0)'); warm.addColorStop(0.12, 'rgba(255,184,110,0.7)'); warm.addColorStop(0.5, 'rgba(255,200,130,0.85)'); warm.addColorStop(0.88, 'rgba(255,184,110,0.7)'); warm.addColorStop(1, 'rgba(255,176,96,0)');
    ctx.fillStyle = warm; ctx.fillRect(0, 0, w, h);
    var red = ctx.createRadialGradient(px(5.5), 0, 2, px(5.5), 0, w * 0.13);
    red.addColorStop(0, 'rgba(255,90,60,0.8)'); red.addColorStop(0.5, 'rgba(255,70,50,0.3)'); red.addColorStop(1, 'rgba(255,70,50,0)');
    ctx.fillStyle = red; ctx.fillRect(0, 0, w, h);
    var fade = ctx.createLinearGradient(0, 0, 0, h);
    fade.addColorStop(0, 'rgba(0,0,0,0.15)'); fade.addColorStop(0.35, 'rgba(0,0,0,0.5)'); fade.addColorStop(1, 'rgba(0,0,0,1)');
    ctx.globalCompositeOperation = 'destination-out';
    ctx.fillStyle = fade; ctx.fillRect(0, 0, w, h);
    ctx.fillStyle = 'rgba(0,0,0,0.7)';
    for (var gx = -4.5 + 1.125 * 0.5; gx < 6.8; gx += 1.125) ctx.fillRect(px(gx) - 1, 0, 2.5, h);
    for (var gz = 0.3; gz < 3.3; gz += 1.125) ctx.fillRect(0, gz / 3.0 * h - 1, w, 2.5);
  });
  var apSheen = new THREE.Mesh(new THREE.PlaneGeometry(11.4, 3.0), new THREE.MeshBasicMaterial({ map: apSheenTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0.1, depthWrite: false }));
  apSheen.rotation.x = -Math.PI / 2; apSheen.position.set(0.9, 0.015, 1.8); scene.add(apSheen);

  var terminalCeiling = new THREE.Mesh(new THREE.PlaneGeometry(90, 100), new THREE.MeshLambertMaterial({ map: ceilingTex, emissive: 0x0e1016, color: 0x555860 }));
  terminalCeiling.rotation.x = Math.PI / 2; terminalCeiling.position.set(0, 5.6, 36); scene.add(terminalCeiling);

  // Troffers: emissive panels in the concourse ceiling; a couple are real lights
  var troffers = [];
  (function() {
    var geo = new THREE.PlaneGeometry(2.4, 0.6), mat = new THREE.MeshBasicMaterial({ color: 0xd8d4b0 });
    for (var x = -14; x <= 14; x += 7) for (var z = 3; z <= 24; z += 7) {
      var p = new THREE.Mesh(geo, mat.clone()); p.rotation.x = Math.PI / 2; p.position.set(x, 5.58, z); scene.add(p); troffers.push(p);
      if (x === 0 && z <= 10) { var l = new THREE.PointLight(0xd0ccaa, 0.3, 14, 2); l.position.set(x, 5.2, z); scene.add(l); }
      glowSprite('rgba(210,225,255,', 2.6, x, 5.45, z).material.opacity = 0.35;
    }
  })();
  // A ceiling duct and sprinkler heads out on the concourse
  (function() {
    var ductMat = new THREE.MeshStandardMaterial({ color: 0x9a9ea6, roughness: 0.35, metalness: 0.7 });
    var d = cyl(0.28, 0.28, 30, 14, ductMat, 3.5, 5.15, 16); d.rotation.x = Math.PI / 2;
    var domeMat = new THREE.MeshStandardMaterial({ color: 0x0a0a0c, roughness: 0.1, metalness: 0.4 });
    var dome = new THREE.Mesh(new THREE.SphereGeometry(0.14, 14, 8, 0, 6.3, Math.PI / 2, Math.PI / 2), domeMat); dome.position.set(6, 5.58, 2.5); scene.add(dome);
  })();

  // Terminal wall either side of the bay, with skirting and the bulkhead over the bay
  var wallMat = new THREE.MeshStandardMaterial({ color: 0x6a665e, roughness: 0.92 });
  box(26, 5.6, 0.6, wallMat, -20, 2.8, 0.3);
  box(26, 5.6, 0.6, wallMat, 20, 2.8, 0.3);
  box(14, 1.5, 0.6, new THREE.MeshStandardMaterial({ color: 0x4e4a44, roughness: 0.9 }), 0, 4.85, 0.3);
  var skirtMat = new THREE.MeshStandardMaterial({ color: 0x3a3a3c, roughness: 0.6 });
  box(26, 0.14, 0.04, skirtMat, -20, 0.07, 0.62); box(26, 0.14, 0.04, skirtMat, 20, 0.07, 0.62);

  // Fire exit sign on the right wall, glowing green
  (function() {
    var t = canvasTex(256, 128, function(ctx, w, h) {
      ctx.fillStyle = '#1c8a3a'; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = '#ffffff';
      ctx.beginPath(); ctx.arc(70, 34, 12, 0, 6.3); ctx.fill();
      ctx.fillRect(58, 50, 22, 40); ctx.fillRect(80, 60, 30, 8); ctx.fillRect(40, 90, 18, 30); ctx.fillRect(74, 90, 26, 12);
      ctx.fillRect(140, 52, 60, 20); ctx.beginPath(); ctx.moveTo(200, 40); ctx.lineTo(236, 62); ctx.lineTo(200, 84); ctx.fill();
    });
    var s = new THREE.Mesh(new THREE.PlaneGeometry(0.8, 0.4), new THREE.MeshBasicMaterial({ map: t })); s.position.set(9.2, 3.2, 0.62); scene.add(s);
    /* 2026-10-14 (speed): left out; its bulb and glow sprite carry the look */
    glowSprite('rgba(80,255,140,', 1.6, 9.2, 3.2, 0.75).material.opacity = 0.5;
  })();

  // Hanging gates sign in the foreground, top left
  (function() {
    var t = canvasTex(512, 128, function(ctx, w, h) {
      ctx.fillStyle = '#f0bf1a'; ctx.fillRect(0, 0, w, h);
      ctx.fillStyle = '#111'; ctx.font = 'bold 58px Arial, Helvetica, sans-serif'; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      ctx.fillText('←  Gates 1–24', 26, 64);
      ctx.fillStyle = '#111'; ctx.fillRect(0, h - 10, w, 10);
    });
    var side = new THREE.MeshLambertMaterial({ color: 0xd2a512 });
    var s = new THREE.Mesh(new THREE.BoxGeometry(3.6, 0.9, 0.08), [side, side, side, side, new THREE.MeshBasicMaterial({ map: t }), new THREE.MeshBasicMaterial({ map: t })]);
    s.position.set(12.4, 3.9, 0.9); s.rotation.y = -0.55; scene.add(s);
    var rodMat = new THREE.MeshStandardMaterial({ color: 0x2a2a2a, roughness: 0.5, metalness: 0.6 });
    cyl(0.02, 0.02, 1.5, 6, rodMat, 11.0, 4.9, 0.3); cyl(0.02, 0.02, 1.5, 6, rodMat, 13.6, 4.9, 1.6);
    makeClickable(s, { name: 'Gates 1–24', passage: 'The Road to India' });
  })();

  // Foreground: an abandoned luggage trolley and a bin
  (function() {
    var mat = new THREE.MeshStandardMaterial({ color: 0x8c9198, roughness: 0.35, metalness: 0.8 });
    var g = new THREE.Group();
    box(0.62, 0.05, 0.92, mat, 0, 0.2, 0, { parent: g });
    box(0.62, 0.04, 0.04, mat, 0, 1.0, 0.46, { parent: g });
    cyl(0.02, 0.02, 0.82, 6, mat, -0.29, 0.6, 0.46, g); cyl(0.02, 0.02, 0.82, 6, mat, 0.29, 0.6, 0.46, g);
    box(0.62, 0.35, 0.03, mat, 0, 0.42, -0.45, { parent: g });
