function stepBack() {
var steppingFrom=activeSpot;
if (words) words.setMode('idle');
capAway(false);
if (activeSpot && activeSpot.onLook) activeSpot.onLook(false);
card.style.transform = 'translate(' + cardX() + ', 8px)'; hideVoiceBox();
activeSpot = null; card.style.opacity = '0'; card.style.pointerEvents = 'none'; card.setAttribute('aria-hidden', 'true'); card.inert=true;
Array.prototype.forEach.call(card.querySelectorAll('.fi-action'), function(b) { b.tabIndex = -1; });
