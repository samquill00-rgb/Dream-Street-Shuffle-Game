(set: _nb to _nb + '</div>')\
(set: _dH to (cond: $mantraComplete, ' dream-ledger-done', ''))(set: _dN to (cond: $nazcaTracing, ' dream-ledger-done', ''))(set: _dE to (cond: $easterGlyph, ' dream-ledger-done', ''))(set: _dP to (cond: $pyramidNumber, ' dream-ledger-done', ''))(set: _dZ to (cond: $ezekielVision, ' dream-ledger-done', ''))\
(set: _tH to (cond: $mantraComplete, 'the mantra', '—'))(set: _tN to (cond: $nazcaTracing, 'the tracing', '—'))(set: _tE to (cond: $easterGlyph, 'the glyph', '—'))(set: _tP to (cond: $pyramidNumber, 'the proportion', '—'))(set: _tZ to (cond: $ezekielVision, 'the vision', '—'))\
(set: _eH to (cond: $goochMet, ' dream-echo-done', ''))(set: _eN to (cond: $truzeMet, ' dream-echo-done', ''))(set: _eE to (cond: $longshanksMet, ' dream-echo-done', ''))(set: _eP to (cond: $songstrongMet, ' dream-echo-done', ''))(set: _eZ to (cond: $fetchSeen, ' dream-echo-done', ''))\
<!-- THE POCKET KEY ON ITS WORLD (2026-09-14). Sam went looking for the key
     under DREAMS, which is the right instinct: the key IS the ticket to one
     particular world. Only the key in hand is shown, so the other four
     key-to-world pairings are still something to find out. -->\
(set: _kH to '')(set: _kN to '')(set: _kE to '')(set: _kP to '')(set: _kZ to '')\
(if: $dreamKey is not "" and $keyNames is a datamap and $keyNames contains $dreamKey)[\
(set: _kTxt to '<span class="dream-ledger-key">&#9906; ' + ($keyNames's ($dreamKey)) + ', in your pocket</span>')\
(if: $dreamKey is "lighter")[(set: _kH to _kTxt)]\
(else-if: $dreamKey is "cocaine")[(set: _kN to _kTxt)]\
(else-if: $dreamKey is "ticket")[(set: _kE to _kTxt)]\
(else-if: $dreamKey is "slip")[(set: _kP to _kTxt)]\
(else-if: $dreamKey is "eye")[(set: _kZ to _kTxt)]]\
(set: _nb to _nb + '<div class="nb-panel nb-panel-dreams"><div class="dream-ledger"><div class="dream-ledger-entry' + _dH + '"><span class="dream-ledger-symbol">☸</span><span class="dream-ledger-world">HIMALAYAS</span><span class="dream-ledger-thread">' + _tH + '</span><span class="dream-ledger-echo' + _eH + '">THE CRITIC</span>' + _kH + '</div><div class="dream-ledger-entry' + _dN + '"><span class="dream-ledger-symbol">⌁</span><span class="dream-ledger-world">NAZCA</span><span class="dream-ledger-thread">' + _tN + '</span><span class="dream-ledger-echo' + _eN + '">LACKLAND</span>' + _kN + '</div><div class="dream-ledger-entry' + _dE + '"><span class="dream-ledger-symbol">☉</span><span class="dream-ledger-world">EASTER ISLAND</span><span class="dream-ledger-thread">' + _tE + '</span><span class="dream-ledger-echo' + _eE + '">RED</span>' + _kE + '</div><div class="dream-ledger-entry' + _dP + '"><span class="dream-ledger-symbol">△</span><span class="dream-ledger-world">PYRAMID</span><span class="dream-ledger-thread">' + _tP + '</span><span class="dream-ledger-echo' + _eP + '">INIS</span>' + _kP + '</div><div class="dream-ledger-entry' + _dZ + '"><span class="dream-ledger-symbol">◉</span><span class="dream-ledger-world">EZEKIEL</span><span class="dream-ledger-thread">' + _tZ + '</span><span class="dream-ledger-echo' + _eZ + '">BENITO</span>' + _kZ + '</div></div>')\
(unless: $mantra is an array)[(set: $mantra to (a: "Datta", "Dayadhvam", "Damyata", "Shantih", "Shantih", "Shantih"))](unless: $haunts is an array)[(set: $haunts to (a:))]\
(set: _nb to _nb + '<div class="nb-section nb-chant-section"><strong class="nb-heading">CHANT</strong><div class="nb-mantra-row">')\
(set: _nb to _nb + (cond: $haunts's length >= 1, '<span class="nb-mantra-syl heard">' + (1 of $mantra) + '</span>', '<span class="nb-mantra-syl silent">·</span>'))\
(set: _nb to _nb + (cond: $haunts's length >= 2, '<span class="nb-mantra-syl heard">' + (2 of $mantra) + '</span>', '<span class="nb-mantra-syl silent">·</span>'))\
(set: _nb to _nb + (cond: $haunts's length >= 3, '<span class="nb-mantra-syl heard">' + (3 of $mantra) + '</span>', '<span class="nb-mantra-syl silent">·</span>'))\
(set: _nb to _nb + (cond: $haunts's length >= 4, '<span class="nb-mantra-syl heard">' + (4 of $mantra) + '</span>', '<span class="nb-mantra-syl silent">·</span>'))\
(set: _nb to _nb + (cond: $haunts's length >= 5, '<span class="nb-mantra-syl heard">' + (5 of $mantra) + '</span>', '<span class="nb-mantra-syl silent">·</span>'))\
(set: _nb to _nb + (cond: $haunts's length >= 6, '<span class="nb-mantra-syl heard">' + (6 of $mantra) + '</span>', '<span class="nb-mantra-syl silent">·</span>'))\
(set: _nb to _nb + '</div><div class="nb-mantra-caption">One syllable for each haunt caught.</div></div>')\
(set: _nb to _nb + '</div>')\
(set: _nb to _nb + '<div class="nb-panel nb-panel-inventory">')\
(set: _nb to _nb + '<div class="nb-section nb-inv-section"><strong class="nb-heading nb-inv-heading">EFFECTS</strong>')\
(if: $benitoDrawing is true)[(display: "BENITO Drawing Art")(set: _nb to _nb + '<div class="nb-inv-item benito-notebook-drawing"><div class="nb-inv-name nb-item">◈ BENITO’s drawing</div>' + $benitoDrawingArt + '</div>')]\
(if: $davyTicketFragment is true)[(set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ DAVY’s ticket</div><div class="davy-ticket-fragment" role="img" aria-label="Two crossed-out rows from the Rongorongo glyph"><svg class="easter-glyph-svg" viewBox="0 28 240 146" width="240" height="146"><defs><linearGradient id="rrPaper" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#241e16"/><stop offset="1" stop-color="#120f0a"/></linearGradient><linearGradient id="rrRub" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity="0.35"/><stop offset="0.3" stop-color="#000" stop-opacity="0"/><stop offset="0.7" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity="0.3"/></linearGradient><pattern id="rrGrain" width="3" height="3" patternUnits="userSpaceOnUse"><rect width="1" height="1" x="0" y="1" fill="rgba(255,240,210,0.045)"/><rect width="1" height="1" x="2" y="0" fill="rgba(0,0,0,0.25)"/></pattern></defs><path d="M8,10 L232,6 L234,272 L6,274 Z" fill="url(#rrPaper)" stroke="rgba(200,168,106,0.32)" stroke-width="0.6"/><path d="M8,10 L232,6 L234,272 L6,274 Z" fill="url(#rrGrain)"/><path d="M8,10 L232,6 L234,272 L6,274 Z" fill="url(#rrRub)"/><rect x="16" y="46" width="208" height="48" fill="rgba(0,0,0,0.22)"/><line x1="16" y1="96" x2="224" y2="96" stroke="rgba(232,220,192,0.18)" stroke-width="0.6"/><rect x="16" y="116" width="208" height="48" fill="rgba(0,0,0,0.22)"/><line x1="16" y1="166" x2="224" y2="166" stroke="rgba(232,220,192,0.18)" stroke-width="0.6"/><rect x="16" y="186" width="208" height="48" fill="rgba(0,0,0,0.22)"/><line x1="16" y1="236" x2="224" y2="236" stroke="rgba(232,220,192,0.18)" stroke-width="0.6"/><g transform="translate(40.0,70)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><circle cx="0" cy="-10" r="4"/><path d="M4,-10 L9,-8 M0,-6 L0,6 M0,-2 L-7,3 M0,-2 L7,3 M0,6 L-4,14 M0,6 L4,14"/></g><g transform="translate(80.0,70)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M-9,0 Q0,-7 9,0 Q0,7 -9,0 Z M9,0 L13,-4 M9,0 L13,4"/><circle cx="-5" cy="-1" r="0.8" fill="#dcdfe4" stroke="none"/></g><g transform="translate(120.0,70)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M0,12 L0,0 M0,0 L-6,-9 M0,0 L-2,-11 M0,0 L2,-11 M0,0 L6,-9 M0,0 L8,-2"/></g><g transform="translate(160.0,70)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M0,-12 L0,12 M0,-6 L-7,-10 M0,-6 L7,-10 M0,4 L-7,0 M0,4 L7,0"/><circle cx="0" cy="-13" r="2.5"/></g><g transform="translate(200.0,70)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M4,-10 A10,10 0 1,0 4,10 A7,7 0 1,1 4,-10 Z"/></g><g transform="translate(40.0,140) rotate(180)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><circle cx="0" cy="-10" r="3.5"/><path d="M0,-6 L0,5 M0,-3 L-8,-9 M0,-3 L8,-9 M0,5 L-5,13 M0,5 L5,13"/></g><g transform="translate(80.0,140) rotate(180)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><ellipse cx="0" cy="0" rx="8" ry="5"/><path d="M8,0 L12,0 M-8,0 L-12,0 M-5,4 L-7,8 M5,4 L7,8 M-5,-4 L-7,-8 M5,-4 L7,-8"/></g><g transform="translate(120.0,140) rotate(180)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M-8,4 Q0,-10 8,4 M-2,-4 L-2,8 M-2,8 L-6,12 M-2,8 L2,12 M6,-2 L10,-5"/></g><g transform="translate(160.0,140) rotate(180)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><circle cx="0" cy="-10" r="4"/><path d="M4,-10 L9,-8 M0,-6 L0,6 M0,-2 L-7,3 M0,-2 L7,3 M0,6 L-4,14 M0,6 L4,14"/></g><g transform="translate(200.0,140) rotate(180)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M-9,0 Q0,-7 9,0 Q0,7 -9,0 Z M9,0 L13,-4 M9,0 L13,4"/><circle cx="-5" cy="-1" r="0.8" fill="#dcdfe4" stroke="none"/></g><g transform="translate(40.0,210)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M0,-12 L0,12 M0,-6 L-7,-10 M0,-6 L7,-10 M0,4 L-7,0 M0,4 L7,0"/><circle cx="0" cy="-13" r="2.5"/></g><g transform="translate(80.0,210)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M0,12 L0,0 M0,0 L-6,-9 M0,0 L-2,-11 M0,0 L2,-11 M0,0 L6,-9 M0,0 L8,-2"/></g><g transform="translate(120.0,210)" fill="none" stroke="#eef0f3" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.98"><path d="M0,12 L0,-2 M0,-2 C4,-6 6,-10 5,-14 C2,-16 -2,-16 -5,-14 C-6,-10 -4,-6 0,-2 Z M-5,-14 Q0,-11 5,-14 M-4,12 L4,12"/></g><g transform="translate(160.0,210)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><path d="M-8,4 Q0,-10 8,4 M-2,-4 L-2,8 M-2,8 L-6,12 M-2,8 L2,12 M6,-2 L10,-5"/></g><g transform="translate(200.0,210)" fill="none" stroke="#c8ccd2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.82"><circle cx="0" cy="-10" r="3.5"/><path d="M0,-6 L0,5 M0,-3 L-8,-9 M0,-3 L8,-9 M0,5 L-5,13 M0,5 L5,13"/></g><path d="M8,10 L232,6 L234,272 L6,274 Z" fill="none" stroke="rgba(0,0,0,0.5)" stroke-width="2"/><path d="M23 58 L217 83 M24 132 L216 153" stroke="#a78165" stroke-width="2.2" opacity="0.8"/></svg></div><div class="nb-napkin-caption">A fragment of Rongorongo · the sixth moai.</div></div>')]\
(if: $hasCoin is true)[(set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ A &#39;Donkey&#39; Coin</div><div class="nb-coin-display"><div class="nb-coin-3d" title="Turn it over"><div class="nb-coin-edge"></div><div class="nb-coin-face nb-coin-front"><img src="__DSS_COIN_HEADS_DATA_URI__" alt="The Donkey, heads" class="nb-coin-img"/><span class="nb-coin-sheen"></span></div><div class="nb-coin-face nb-coin-back"><img src="__DSS_COIN_TAILS_DATA_URI__" alt="The Donkey, tails" class="nb-coin-img-back"/><span class="nb-coin-sheen"></span></div></div><div class="nb-coin-shadow"></div></div><div class="nb-inv-btn" onclick="window.flipCoinPopup()">Toss it</div></div>')](else:)[(set: _nb to _nb + '<div class="nb-inv-item nb-inv-locked"><div class="nb-grey">○ A &#39;Donkey&#39; coin</div></div>')]\
<!-- v2 KEYS (phase 2): the pocket slot, and where a set-down key rests. -->
\
(display: "Key Guards")(set: _nb to _nb + '<div class="nb-inv-divider"></div>')(if: $dreamKey is "cocaine")[(set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ In Your Pocket</div><div class="nb-inv-graphic-wrap"><svg class="nb-inv-keyobj" viewBox="0 0 100 80" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkWrapP" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4ecd8"/><stop offset="1" stop-color="#cdc1a2"/></linearGradient></defs><ellipse cx="50" cy="69" rx="27" ry="3" fill="rgba(0,0,0,0.3)"/><g transform="rotate(-7 50 42)"><path d="M26,22 L74,22 L78,58 L22,58 Z" fill="url(#pkWrapP)" stroke="rgba(120,100,70,0.6)" stroke-width="1" stroke-linejoin="round"/><path d="M26,22 L50,41 L74,22" fill="none" stroke="rgba(120,100,70,0.5)" stroke-width="0.9"/><path d="M22,58 L50,41 L78,58" fill="none" stroke="rgba(120,100,70,0.34)" stroke-width="0.7"/><g opacity="0.4"><line x1="30" y1="27" x2="44" y2="27" stroke="#6a5a3a" stroke-width="0.8"/><line x1="57" y1="27" x2="70" y2="27" stroke="#6a5a3a" stroke-width="0.8"/><line x1="28" y1="49" x2="40" y2="49" stroke="#6a5a3a" stroke-width="0.8"/><line x1="60" y1="49" x2="72" y2="49" stroke="#6a5a3a" stroke-width="0.8"/><line x1="26" y1="53" x2="37" y2="53" stroke="#6a5a3a" stroke-width="0.7"/><line x1="62" y1="53" x2="74" y2="53" stroke="#6a5a3a" stroke-width="0.7"/></g><path d="M74,22 L78,58 L69,51 Z" fill="rgba(158,138,102,0.34)"/><path d="M27,24 L31,26" stroke="rgba(255,255,255,0.4)" stroke-width="0.7"/></g></svg></div><div class="nb-napkin-caption">The bag of cocaine, folded from a racing paper.</div></div>')](else-if: $dreamKey is "ticket")[(set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ In Your Pocket</div><div class="nb-inv-graphic-wrap"><svg class="nb-inv-keyobj" viewBox="0 0 90 100" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkTkt" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fdf6e2"/><stop offset="1" stop-color="#e0d3ae"/></linearGradient></defs><ellipse cx="45" cy="91" rx="23" ry="2.6" fill="rgba(0,0,0,0.26)"/><g transform="rotate(4 45 52)"><path d="M24,14 L28,18 L24,22 L28,26 L24,30 L66,30 L66,86 L24,86 Z" fill="url(#pkTkt)" stroke="rgba(130,105,60,0.55)" stroke-width="0.8" stroke-linejoin="round"/><line x1="29" y1="36" x2="61" y2="36" stroke="rgba(60,45,20,0.28)" stroke-width="0.5"/><text x="45" y="60" text-anchor="middle" font-family="Georgia,serif" font-weight="bold" font-size="21" fill="rgba(150,32,24,0.82)">31</text><g opacity="0.5" stroke="rgba(50,40,25,0.85)" stroke-width="1" stroke-linecap="round" fill="none"><path d="M33,70 L47,70 M40,66 L40,78 M35,76 L45,76"/><path d="M53,68 L61,68 M57,65 L57,78 M52,74 L62,74"/></g><circle cx="56" cy="82" r="7" fill="rgba(150,120,60,0.17)"/><circle cx="56" cy="82" r="3.6" fill="rgba(150,120,60,0.14)"/><circle cx="31" cy="79" r="3" fill="rgba(150,120,60,0.1)"/></g></svg></div><div class="nb-napkin-caption">The chippy order ticket, from the counter.</div></div>')](else-if: $dreamKey is "slip")[(set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ In Your Pocket</div><div class="nb-inv-graphic-wrap"><svg class="nb-inv-keyobj" viewBox="0 0 116 78" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkSlip" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f6eccd"/><stop offset="1" stop-color="#ddcda4"/></linearGradient></defs><ellipse cx="58" cy="70" rx="33" ry="2.8" fill="rgba(0,0,0,0.25)"/><g transform="rotate(-3 58 40)"><rect x="16" y="14" width="84" height="48" rx="1.5" fill="url(#pkSlip)" stroke="rgba(128,102,58,0.6)" stroke-width="0.9"/><rect x="19" y="17" width="78" height="42" fill="none" stroke="rgba(150,40,32,0.42)" stroke-width="0.6"/><text x="58" y="28" text-anchor="middle" font-family="Georgia,serif" font-size="5.2" letter-spacing="1.2" fill="rgba(150,40,32,0.7)">TO WIN</text><line x1="24" y1="33" x2="92" y2="33" stroke="rgba(60,45,20,0.26)" stroke-width="0.5"/><text x="26" y="42" font-family="Georgia,serif" font-style="italic" font-size="8.5" fill="rgba(48,34,16,0.82)">Gallowglass</text><line x1="24" y1="47" x2="92" y2="47" stroke="rgba(60,45,20,0.22)" stroke-width="0.5"/><text x="26" y="55" font-family="Georgia,serif" font-size="5.6" fill="rgba(48,34,16,0.6)">4.30  KEMPTON</text><text x="84" y="55" text-anchor="end" font-family="Georgia,serif" font-size="5.6" fill="rgba(48,34,16,0.6)">10/1</text><circle cx="80" cy="40" r="15" fill="none" stroke="rgba(126,92,40,0.28)" stroke-width="2.4"/><circle cx="80" cy="40" r="15" fill="rgba(150,116,58,0.07)"/></g></svg></div><div class="nb-napkin-caption">The betting slip, from under the glass at the Coach.</div></div>')](else-if: $dreamKey is "lighter")[(set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ In Your Pocket</div><div class="nb-inv-graphic-wrap"><svg class="nb-inv-keyobj" viewBox="0 0 70 104" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkBrass" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#7d5f1c"/><stop offset="0.22" stop-color="#d9b45c"/><stop offset="0.46" stop-color="#f4e0a4"/><stop offset="0.72" stop-color="#c49a3c"/><stop offset="1" stop-color="#684d14"/></linearGradient><linearGradient id="pkBrassLid" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8d6c22"/><stop offset="0.24" stop-color="#e6c674"/><stop offset="0.5" stop-color="#f7e6b0"/><stop offset="0.74" stop-color="#cfa646"/><stop offset="1" stop-color="#725417"/></linearGradient></defs><ellipse cx="35" cy="81" rx="16" ry="2.4" fill="rgba(0,0,0,0.34)"/><rect x="19" y="29" width="32" height="15.4" rx="2.6" fill="url(#pkBrassLid)" stroke="rgba(70,50,12,0.75)" stroke-width="0.8"/><rect x="19" y="43.6" width="32" height="35.4" rx="2.6" fill="url(#pkBrass)" stroke="rgba(70,50,12,0.75)" stroke-width="0.8"/><line x1="19.4" y1="44.4" x2="50.6" y2="44.4" stroke="rgba(52,38,8,0.75)" stroke-width="1.1"/><line x1="19.4" y1="43" x2="50.6" y2="43" stroke="rgba(255,244,206