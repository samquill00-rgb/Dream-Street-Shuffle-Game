    if(n===2){ctx.moveTo(-2,4);ctx.lineTo(-1,-7);ctx.lineTo(1,-10);ctx.lineTo(2,4);ctx.closePath();ctx.moveTo(-5,4);ctx.lineTo(5,4);ctx.moveTo(0,4);ctx.lineTo(0,9);}
