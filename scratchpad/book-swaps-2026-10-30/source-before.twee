  { x: -0.5, y: 8, w: 0.12, h: 5 },
  { x: 0.8, y: 9, w: 0.08, h: 4 },
  { x: 2.6, y: 8.5, w: 0.1, h: 4.5 },
  { x: 3.5, y: 9.5, w: 0.06, h: 3 }
];
for (var si = 0; si < streakPositions.length; si++) {
