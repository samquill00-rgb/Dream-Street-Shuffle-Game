      else { x.moveTo(COLS * T, g.y0 + 1); x.lineTo(COLS * T - T * 1.1, g.y0 + 1); x.moveTo(COLS * T, g.y1 - 1); x.lineTo(COLS * T - T * 1.1, g.y1 - 1); x.moveTo(COLS * T - T * 1.1 + 0.5, g.y0 + 1); x.lineTo(COLS * T - T * 1.1 + 0.5, g.y1 - 1); }
