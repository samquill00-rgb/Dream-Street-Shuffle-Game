}

// Manhole cover
var manhole = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 0.5),
new THREE.MeshStandardMaterial({ color: 0x2a2a2a, roughness: 0.5, metalness: 0.3 }));
manhole.rotation.x = -Math.PI / 2;
manhole.position.set(2, 0.015, 6.5);
scene.add(manhole);

// ---- STREET FURNITURE ----
// Bollard near pub
var bollardMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.6, metalness: 0.2 });
placeMesh(scene, new THREE.CylinderGeometry(0.06, 0.08, 0.7, 8), bollardMat, 2.5, 0.35, 3.2);
placeMesh(scene, new THREE.SphereGeometry(0.07, 6, 6), bollardMat, 2.5, 0.72, 3.2);

// Dustbin / rubbish bin
var binMat = new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.7 });
placeMesh(scene, new THREE.CylinderGeometry(0.2, 0.18, 0.6, 8), binMat, 5.5, 0.3, 1.5);
placeMesh(scene, new THREE.CylinderGeometry(0.22, 0.22, 0.04, 8), binMat, 5.5, 0.62, 1.5);

// Post box (red, classic British)
var postBoxMat = new THREE.MeshStandardMaterial({ color: 0x8a1a1a, roughness: 0.6 });
placeMesh(scene, new THREE.CylinderGeometry(0.15, 0.15, 1.0, 8), postBoxMat, -10, 0.5, 3.0);
placeMesh(scene, new THREE.CylinderGeometry(0.17, 0.15, 0.15, 8), postBoxMat, -10, 1.05, 3.0);
// Post slot
placeMesh(scene, new THREE.BoxGeometry(0.15, 0.02, 0.04),
new THREE.MeshStandardMaterial({ color: 0x0a0a0a }), -10, 0.8, 3.16);

// ============================================================
// STREETLAMPS
// ============================================================
var streetLampLights = [];

function createLamp(x, z) {
var g = new THREE.Group();
var castIron = new THREE.MeshStandardMaterial({ color: 0x1a1a18, roughness: 0.7, metalness: 0.4 });
var warmIron = new THREE.MeshStandardMaterial({ color: 0x2a2520, roughness: 0.6, metalness: 0.3 });

// Victorian fluted column — tapers elegantly
placeMesh(g, new THREE.CylinderGeometry(0.035, 0.06, 4.2, 8), castIron, 0, 2.1, 0);
// Decorative bulge at mid-height
placeMesh(g, new THREE.CylinderGeometry(0.065, 0.065, 0.12, 8), warmIron, 0, 2.8, 0);
// Ornate base plinth (stepped)
placeMesh(g, new THREE.CylinderGeometry(0.12, 0.16, 0.15, 8), castIron, 0, 0.075, 0);
placeMesh(g, new THREE.CylinderGeometry(0.1, 0.13, 0.1, 8), castIron, 0, 0.2, 0);
placeMesh(g, new THREE.BoxGeometry(0.35, 0.06, 0.35), castIron, 0, 0.0, 0);
// Collar below lantern
placeMesh(g, new THREE.CylinderGeometry(0.055, 0.04, 0.08, 8), warmIron, 0, 4.24, 0);
// Scroll brackets (4 curved supports meeting the lantern)
for (var sb = 0; sb < 4; sb++) {
var ang = sb * Math.PI / 2;
var sx = Math.cos(ang) * 0.07;
var sz = Math.sin(ang) * 0.07;
placeMesh(g, new THREE.BoxGeometry(0.015, 0.25, 0.015), warmIron, sx, 4.4, sz);
}

// Lantern — hexagonal gas lamp housing
placeMesh(g, new THREE.CylinderGeometry(0.1, 0.12, 0.04, 6), castIron, 0, 4.28, 0);  // base plate
placeMesh(g, new THREE.CylinderGeometry(0.1, 0.1, 0.04, 6), castIron, 0, 4.72, 0);   // top plate
// Lantern frame bars (6 vertical bars)
for (var lb = 0; lb < 6; lb++) {
var la = lb * Math.PI / 3;
var lbx = Math.cos(la) * 0.1;
var lbz = Math.sin(la) * 0.1;
placeMesh(g, new THREE.BoxGeometry(0.015, 0.42, 0.015), castIron, lbx, 4.5, lbz);
}
// Crown / finial on top
placeMesh(g, new THREE.CylinderGeometry(0.0, 0.06, 0.12, 6), castIron, 0, 4.82, 0);
placeMesh(g, new THREE.SphereGeometry(0.025, 6, 4), castIron, 0, 4.9, 0);

// Warm gas flame glow inside lantern (visible through glass)
var gasGlow = new THREE.MeshBasicMaterial({ color: 0xffcc66, transparent: true, opacity: 0.92 }); // warmer + brighter (was 0xffdd88 / 0.7) so the flame reads amber, not pale
// Glass panels (6 sides, warm amber)
for (var gp = 0; gp < 6; gp++) {
var ga = gp * Math.PI / 3 + Math.PI / 6;
var gpx = Math.cos(ga) * 0.085;
var gpz = Math.sin(ga) * 0.085;
var glassPanel = new THREE.Mesh(new THREE.PlaneGeometry(0.09, 0.36), gasGlow);
glassPanel.position.set(gpx, 4.5, gpz);
glassPanel.rotation.y = -ga + Math.PI / 2;
g.add(glassPanel);
}
// Inner flame (tiny bright core)
var flameMat = new THREE.MeshBasicMaterial({ color: 0xffeedd });
placeMesh(g, new THREE.SphereGeometry(0.02, 4, 4), flameMat, 0, 4.5, 0);

// Warm gas light — pools of amber on the wet street
// 2026-10-14 (speed, Sam: yes): one light a lamp, not two, and no cube shadow (19 point lights, four of them
// shadowing, made this the slowest approach); a little brighter to stand for the fill light it absorbs
var light = new THREE.PointLight(0xffcc70, 1.05, 18);
light.position.set(0, 4.5, 0);
light.castShadow = false;
g.add(light);
streetLampLights.push(light);

// Atmospheric halo — large soft glow around the lamp
var haloTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
grad.addColorStop(0, 'rgba(255, 210, 120, 0.6)');
grad.addColorStop(0.15, 'rgba(255, 190, 90, 0.3)');
grad.addColorStop(0.4, 'rgba(200, 150, 60, 0.08)');
grad.addColorStop(1, 'rgba(150, 100, 40, 0)');
cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
});
var halo = new THREE.Sprite(new THREE.SpriteMaterial({ map: haloTex, transparent: true, opacity: 0.85 })); // was 0.6
halo.position.set(0, 4.5, 0);
halo.scale.set(5, 5, 1);
g.add(halo);
// The lantern had glowing glass but NO light — nothing kissed the post,
// the flags, or the pavement. A modest gas-warm point fixes that.
// (2026-10-14 speed: this second light at the same spot is folded into the one above)

// Secondary smaller halo (misty diffusion — post-rain moisture in air)
var mistTex = makeCanvasTexture(64, 64, function(cx, w, h) {
var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
grad.addColorStop(0, 'rgba(255, 220, 160, 0.15)');
grad.addColorStop(0.5, 'rgba(200, 170, 120, 0.05)');
grad.addColorStop(1, 'rgba(150, 120, 80, 0)');
cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
});
var mist = new THREE.Sprite(new THREE.SpriteMaterial({ map: mistTex, transparent: true, opacity: 0.4 }));
mist.position.set(0, 3.5, 0);
mist.scale.set(8, 6, 1);
g.add(mist);

g.position.set(x, 0, z);
scene.add(g);
}

// Front street lamps moved far out so they don't block shop signs
createLamp(-14, 3.5);
createLamp(13, 3.5);
createLamp(3, 12);
createLamp(-10, 12);

// ---- THE GREEN FAIRY ----
// A little emerald fairy-moth flitting about the centre lamp's lantern
var fairyTex = makeCanvasTexture(64, 64, function(cx, w, h) {
// Soft emerald halo
var fg = cx.createRadialGradient(w / 2, h / 2, 1, w / 2, h / 2, w / 2);
fg.addColorStop(0, 'rgba(190, 255, 210, 0.95)');
fg.addColorStop(0.25, 'rgba(110, 240, 160, 0.55)');
fg.addColorStop(0.6, 'rgba(60, 190, 110, 0.18)');
fg.addColorStop(1, 'rgba(30, 140, 80, 0)');
cx.fillStyle = fg; cx.fillRect(0, 0, w, h);
// Wings — two pairs, pale luminous green
cx.fillStyle = 'rgba(180, 255, 205, 0.75)';
cx.save(); cx.translate(w / 2, h / 2);
cx.rotate(-0.6);
cx.beginPath(); cx.ellipse(-7, -4, 9, 4, 0, 0, Math.PI * 2); cx.fill();
cx.rotate(1.2);
cx.beginPath(); cx.ellipse(7, -4, 9, 4, 0, 0, Math.PI * 2); cx.fill();
cx.restore();
cx.fillStyle = 'rgba(150, 240, 180, 0.6)';
cx.save(); cx.translate(w / 2, h / 2);
cx.rotate(-0.25);
cx.beginPath(); cx.ellipse(-5, 4, 6, 3, 0, 0, Math.PI * 2); cx.fill();
cx.rotate(0.5);
cx.beginPath(); cx.ellipse(5, 4, 6, 3, 0, 0, Math.PI * 2); cx.fill();
cx.restore();
// Body — slender, bright
cx.fillStyle = 'rgba(230, 255, 235, 0.98)';
cx.beginPath(); cx.ellipse(w / 2, h / 2 + 1, 1.8, 6.5, 0, 0, Math.PI * 2); cx.fill();
// Head
cx.beginPath(); cx.arc(w / 2, h / 2 - 6.5, 2, 0, Math.PI * 2); cx.fill();
});
var fairyMat = new THREE.SpriteMaterial({ map: fairyTex, transparent: true, opacity: 0.95, depthWrite: false });
var greenFairy = new THREE.Sprite(fairyMat);
greenFairy.scale.set(0.17, 0.17, 1);
greenFairy.position.set(3, 4.5, 12);
scene.add(greenFairy);
// The emerald light she carries — a faint green kiss on the lantern ironwork
var fairyLight = new THREE.PointLight(0x50e890, 0.35, 2.2);
fairyLight.position.copy(greenFairy.position);
scene.add(fairyLight);

// ============================================================
// SILHOUETTES IN PUB WINDOWS
// ============================================================
var silhouettes = [];

function makeSilhouetteTex(seed) {
return makeCanvasTexture(256, 256, function(cx, w, h) {
var bg = cx.createRadialGradient(w / 2, h * 0.4, 10, w / 2, h * 0.5, w);
bg.addColorStop(0, 'rgba(200, 140, 50, 0.5)');
bg.addColorStop(0.5, 'rgba(160, 100, 30, 0.3)');
bg.addColorStop(1, 'rgba(80, 50, 15, 0.15)');
cx.fillStyle = bg; cx.fillRect(0, 0, w, h);

var figureCount = 1 + Math.floor(seed * 2.5);
for (var f = 0; f < figureCount; f++) {
var fx = (w / (figureCount + 1)) * (f + 1);
var baseY = h * 0.98;
var headR = 14 + seed * 6;
var shoulderW = 35 + seed * 15;

cx.fillStyle = 'rgba(10, 5, 0, 0.85)';
// Body
cx.beginPath();
cx.moveTo(fx - shoulderW / 2, baseY - h * 0.35);
cx.lineTo(fx + shoulderW / 2, baseY - h * 0.35);
cx.lineTo(fx + shoulderW / 2 + 8, baseY);
cx.lineTo(fx - shoulderW / 2 - 8, baseY);
cx.closePath(); cx.fill();
// Shoulders
cx.beginPath();
cx.ellipse(fx, baseY - h * 0.38, shoulderW / 2 + 5, 14, 0, 0, Math.PI, true);
cx.fill();
// Neck
cx.fillRect(fx - 6, baseY - h * 0.48, 12, h * 0.1);
// Head
cx.beginPath();
cx.arc(fx + (f - 1) * 4, baseY - h * 0.52, headR, 0, Math.PI * 2);
cx.fill();

// Raised arm with glass (some figures)
if ((seed > 0.4 && f === 0) || (seed > 0.6 && f === 1)) {
cx.fillStyle = 'rgba(10, 5, 0, 0.8)';
cx.beginPath();
cx.moveTo(fx + shoulderW / 2, baseY - h * 0.38);
cx.lineTo(fx + shoulderW / 2 + 12, baseY - h * 0.6);
cx.lineTo(fx + shoulderW / 2 + 22, baseY - h * 0.6);
cx.lineTo(fx + shoulderW / 2 + 10, baseY - h * 0.35);
cx.closePath(); cx.fill();
// Glass
cx.fillRect(fx + shoulderW / 2 + 8, baseY - h * 0.7, 16, 22);
cx.fillStyle = 'rgba(180, 130, 40, 0.4)';
cx.fillRect(fx + shoulderW / 2 + 10, baseY - h * 0.68, 12, 14);
}

// Cigarette smoke (some figures)
if (seed > 0.5 && f === figureCount - 1) {
cx.strokeStyle = 'rgba(120, 120, 120, 0.2)';
cx.lineWidth = 2;
cx.beginPath();
cx.moveTo(fx + headR + 5, baseY - h * 0.52);
cx.quadraticCurveTo(fx + headR + 15, baseY - h * 0.6, fx + headR + 10, baseY - h * 0.7);
cx.stroke();
}
}
});
}

// Ground floor silhouettes
var gfWinXs = [-2.2, 0.5, 2.5];
var gfSeeds = [0.7, 0.3, 0.8];
for (var i = 0; i < gfWinXs.length; i++) {
var sTex = makeSilhouetteTex(gfSeeds[i]);
var sMat = new THREE.MeshBasicMaterial({
map: sTex, transparent: true, side: THREE.DoubleSide, depthWrite: false
});
// First bay narrowed to fit beside the moved door; z=0.325 puts the drinkers
// between the painted interior (0.315) and the glass tint (0.335) — the old
// 0.28 was buried inside the frame boxes and never showed.
// Texture cropped to its top 60% so only heads and shoulders show above
// the half-height panelling, matching the real French's windows.
sTex.repeat.set(1, 0.6);
sTex.offset.set(0, 0.4);
var sPlane = new THREE.Mesh(new THREE.PlaneGeometry(i === 0 ? 1.05 : 1.5, 1.3), sMat);
sPlane.position.set(gfWinXs[i], 2.0, 0.325);
pub.add(sPlane);
silhouettes.push({
mesh: sPlane, baseX: gfWinXs[i],
swayPhase: Math.random() * Math.PI * 2,
swaySpeed: 0.3 + Math.random() * 0.4,
swayAmt: 0.015 + Math.random() * 0.02
});
}

// Also add silhouettes in 1st floor windows (upstairs bar)
for (var i = 0; i < 2; i++) {
var upTex = makeSilhouetteTex(0.4 + i * 0.3);
var upMat = new THREE.MeshBasicMaterial({
map: upTex, transparent: true, side: THREE.DoubleSide, depthWrite: false, opacity: 0.6
});
var upPlane = new THREE.Mesh(new THREE.PlaneGeometry(0.8, 1.5), upMat);
upPlane.position.set(winXs[i + 1], 5.2, 0.12);
pub.add(upPlane);
silhouettes.push({
mesh: upPlane, baseX: winXs[i + 1],
swayPhase: Math.random() * Math.PI * 2,
swaySpeed: 0.2 + Math.random() * 0.3,
swayAmt: 0.01 + Math.random() * 0.015
});
}

// ============================================================
// WALKING FIGURE (distant silhouette crossing the street)
// ============================================================
var walkerTex = makeCanvasTexture(64, 128, function(cx, w, h) {
cx.fillStyle = 'rgba(10, 8, 5, 0.7)';
// Head
cx.beginPath(); cx.arc(w / 2, 20, 8, 0, Math.PI * 2); cx.fill();
// Body
cx.fillRect(w / 2 - 8, 28, 16, 40);
// Legs
cx.fillRect(w / 2 - 8, 68, 7, 35);
cx.fillRect(w / 2 + 1, 68, 7, 35);
// Hat brim
cx.fillRect(w / 2 - 12, 13, 24, 4);
});
var walkerMat = new THREE.MeshBasicMaterial({ map: walkerTex, transparent: true, side: THREE.DoubleSide, depthWrite: false });
var walker = new THREE.Mesh(new THREE.PlaneGeometry(0.6, 1.2), walkerMat);
walker.position.set(8, 0.6, 7);
scene.add(walker);

// ============================================================
// LIGHTING
// ============================================================
// Gloomy but visible — low ambient with cold moonlight. Moonlight now has
// a properly configured shadow camera so the facade actually casts shadows
// onto the pavement and surrounding surfaces.
scene.add(new THREE.AmbientLight(0x1f1f38, 0.46));
var moonLight = new THREE.DirectionalLight(0x6a78b8, 0.35);
moonLight.position.set(6, 22, 12);
moonLight.target.position.set(-1, 3, 0);
scene.add(moonLight.target);
moonLight.castShadow = true;
moonLight.shadow.mapSize.width = 2048;
moonLight.shadow.mapSize.height = 2048;
moonLight.shadow.camera.near = 0.5;
moonLight.shadow.camera.far = 60;
moonLight.shadow.camera.left = -20;
moonLight.shadow.camera.right = 20;
moonLight.shadow.camera.top = 20;
moonLight.shadow.camera.bottom = -5;
moonLight.shadow.bias = -0.0008;
moonLight.shadow.normalBias = 0.04;
scene.add(moonLight);

// Cold blue fill — very dim so the moonlight shadows still read
var fillLight = new THREE.DirectionalLight(0x2233aa, 0.04);
fillLight.position.set(-5, 10, -5);
scene.add(fillLight);

// After all geometry is built, enable shadow casting/receiving on every
// solid mesh so the moonlight actually paints shadows on the street.
function enableFhSceneShadows(root) {
  root.traverse(function(obj) {
    if (!(obj instanceof THREE.Mesh)) return;
    var mat = obj.material;
    if (mat && (mat.transparent === true && (mat.opacity || 1) < 0.7)) return;
    obj.receiveShadow = true;
    if (obj.position.y > 0.2 || (obj.geometry && obj.geometry.type !== 'PlaneGeometry')) {
      obj.castShadow = true;
    }
  });
}
setTimeout(function() { enableFhSceneShadows(scene); }, 0);

// ============================================================
// FOG VOLUMES (4 layers)
// ============================================================
var thickFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
grad.addColorStop(0, 'rgba(180, 170, 155, 0.25)');
grad.addColorStop(0.4, 'rgba(150, 140, 130, 0.12)');
grad.addColorStop(1, 'rgba(120, 110, 100, 0)');
cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
});
var thinFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
grad.addColorStop(0, 'rgba(140, 135, 125, 0.15)');
grad.addColorStop(0.6, 'rgba(120, 115, 105, 0.06)');
grad.addColorStop(1, 'rgba(100, 95, 85, 0)');
cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
});
var warmFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2);
grad.addColorStop(0, 'rgba(200, 160, 100, 0.12)');
grad.addColorStop(0.5, 'rgba(180, 140, 80, 0.05)');
grad.addColorStop(1, 'rgba(150, 120, 60, 0)');
cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
});

var fogSprites = [];

// Layer 1: Ground-hugging fog — much more subtle, placed BEHIND camera (z > 5)
// to avoid passing in front of the pub windows and causing flashing
for (var i = 0; i < 20; i++) {
var fogMat = new THREE.SpriteMaterial({ map: thickFogTex, transparent: true, opacity: 0.06 + Math.random() * 0.06 });
var fogSprite = new THREE.Sprite(fogMat);
// Place behind / to sides — NOT in front of pub windows
var fz = 6 + Math.random() * 20;
fogSprite.position.set(Math.random() * 40 - 15, 0.3 + Math.random() * 1.5, fz);
var s = 5 + Math.random() * 10;
fogSprite.scale.set(s, s * 0.3, 1);
scene.add(fogSprite);
fogSprites.push({ sprite: fogSprite, baseX: fogSprite.position.x, drift: 0.0005 + Math.random() * 0.001, sway: Math.random() * Math.PI * 2, swaySpeed: 0.0005 + Math.random() * 0.001, swayAmt: 0.3 + Math.random() * 0.5 });
}

// Layer 2: Mid-height fog — fewer, further back
for (var i = 0; i < 12; i++) {
var midFogMat = new THREE.SpriteMaterial({ map: thinFogTex, transparent: true, opacity: 0.04 + Math.random() * 0.05 });
var midFog = new THREE.Sprite(midFogMat);
midFog.position.set(Math.random() * 35 - 12, 2 + Math.random() * 5, 8 + Math.random() * 20);
var ms = 6 + Math.random() * 12;
midFog.scale.set(ms, ms * 0.25, 1);
scene.add(midFog);
fogSprites.push({ sprite: midFog, baseX: midFog.position.x, drift: 0.0003 + Math.random() * 0.001, sway: Math.random() * Math.PI * 2, swaySpeed: 0.0004 + Math.random() * 0.001, swayAmt: 0.3 + Math.random() * 0.8 });
}

// Layer 3: Warm tinted fog — only at ground level near pub, very faint
for (var i = 0; i < 6; i++) {
var warmFogMat = new THREE.SpriteMaterial({ map: warmFogTex, transparent: true, opacity: 0.04 + Math.random() * 0.04 });
var warmFog = new THREE.Sprite(warmFogMat);
warmFog.position.set(Math.random() * 8 - 2, 0.3 + Math.random() * 1, 3 + Math.random() * 4);
var ws = 3 + Math.random() * 5;
warmFog.scale.set(ws, ws * 0.2, 1);
scene.add(warmFog);
fogSprites.push({ sprite: warmFog, baseX: warmFog.position.x, drift: 0.0003 + Math.random() * 0.0008, sway: Math.random() * Math.PI * 2, swaySpeed: 0.0005 + Math.random() * 0.001, swayAmt: 0.2 + Math.random() * 0.4 });
}

// Layer 4: High wisps — very faint, background only
for (var i = 0; i < 6; i++) {
var highFogMat = new THREE.SpriteMaterial({ map: thinFogTex, transparent: true, opacity: 0.03 + Math.random() * 0.04 });
var highFog = new THREE.Sprite(highFogMat);
highFog.position.set(Math.random() * 30 - 10, 10 + Math.random() * 6, 10 + Math.random() * 15);
var hs = 8 + Math.random() * 12;
highFog.scale.set(hs, hs * 0.15, 1);
scene.add(highFog);
fogSprites.push({ sprite: highFog, baseX: highFog.position.x, drift: 0.001 + Math.random() * 0.002, sway: Math.random() * Math.PI * 2, swaySpeed: 0.0003 + Math.random() * 0.001, swayAmt: 0.5 + Math.random() * 1.0 });
}

// ============================================================
// FILM GRAIN (animated canvas noise)
// ============================================================
var grainCanvas = document.createElement('canvas');
grainCanvas.width = 256; grainCanvas.height = 256;
var grainCtx = grainCanvas.getContext('2d');
var grainEl = document.getElementById('grain');
grainEl.style.backgroundSize = '256px 256px';
var grainFrame = 0;

function updateGrain() {
if (++grainFrame % 3 !== 0) return; // update every 3rd frame for subtlety
var imgData = grainCtx.createImageData(256, 256);
var d = imgData.data;
for (var i = 0; i < d.length; i += 4) {
var v = Math.random() * 255;
d[i] = d[i+1] = d[i+2] = v;
d[i+3] = 255;
}
grainCtx.putImageData(imgData, 0, 0);
grainEl.style.backgroundImage = 'url(' + grainCanvas.toDataURL() + ')';
}

// ============================================================
// ENHANCED WET REFLECTIONS
// ============================================================
// Add more prominent puddle reflections near the pub
// Broken window colours in the existing wet patch, not another reflection pass.
var fhReflectionTex=makeCanvasTexture(128,256,function(cx,w,h){
  for(var r=0;r<64;r++){
    var v=r/64,envelope=Math.sin(v*Math.PI);
    for(var col=0;col<3;col++){
      var xx=18+col*38+Math.sin(r*.71+col)*3,ww=10+Math.sin(r*1.9+col)*4;
      cx.fillStyle='rgba(232,173,91,'+(envelope*(.12+(r%5)*.035))+')';
      cx.fillRect(xx,v*h,ww,1+(r%3));
    }
  }
});
var reflectMat = new THREE.MeshBasicMaterial({map:fhReflectionTex,color:0xe6c494,transparent:true,opacity:.25,depthWrite:false,blending:THREE.AdditiveBlending});
var bigReflect = new THREE.Mesh(new THREE.PlaneGeometry(8, 4), reflectMat);
bigReflect.rotation.x = -Math.PI / 2;
bigReflect.position.set(0.5, 0.015, 5);
scene.add(bigReflect);

// ============================================================
// ANIMATION LOOP
// ============================================================
// Twenty-four grains of damp air; all but one settle. One returns to the light.
var fhMoteTex=makeCanvasTexture(16,16,function(cx,w,h){var g=cx.createRadialGradient(8,8,0,8,8,8);g.addColorStop(0,'rgba(255,255,255,1)');g.addColorStop(.25,'rgba(255,255,255,.65)');g.addColorStop(1,'rgba(255,255,255,0)');cx.fillStyle=g;cx.fillRect(0,0,w,h);});
var fhMotePos=new Float32Array(24*3),fhMoteBase=new Float32Array(24*3);
for(var mi=0;mi<24;mi++){fhMoteBase[mi*3]=-2.5+Math.random()*6;fhMoteBase[mi*3+1]=.5+Math.random()*4;fhMoteBase[mi*3+2]=2+Math.random()*4;fhMotePos.set(fhMoteBase.subarray(mi*3,mi*3+3),mi*3);}
var fhMoteGeo=new THREE.BufferGeometry();fhMoteGeo.setAttribute('position',new THREE.BufferAttribute(fhMotePos,3));
var fhMotes=new THREE.Points(fhMoteGeo,new THREE.PointsMaterial({map:fhMoteTex,color:0xe3c69b,size:.045,transparent:true,opacity:.3,depthWrite:false}));scene.add(fhMotes);
var clock = new THREE.Clock();
var cameraBase = { x: camera.position.x, y: camera.position.y, z: camera.position.z };
// Camera base already set above

function fhAnimate() {
fhAnimId = requestAnimationFrame(fhAnimate);
var t = fhStill ? 0 : clock.getElapsedTime();

// Film grain — update very infrequently to avoid flashing
if (Math.floor(t * 2) !== Math.floor((t - 0.016) * 2)) {
updateGrain();
}

// Camera is COMPLETELY STATIC — no breathing, no movement
// (Camera movement was causing light angle changes that looked like flashing)

// Fog — completely static (drift was causing flashing as fog crossed windows)
// Fog sprites stay in their initial positions for atmosphere without movement

// Only non-shadow doorway lights breathe, by a few percent over many seconds.
// Keep the camera, fog and shadow lights fixed: no full-scene flashing.
pubGlow.intensity=.9+Math.sin(t*.43)*.018;
doorLight.intensity=.5+Math.sin(t*.43-.8)*.012;
for(var gi=0;gi<fhWindowMats.length;gi++)fhWindowMats[gi].emissiveIntensity=.82+Math.sin(t*.32+gi*.7)*.012;
if(!fhStill){for(var mi=0;mi<24;mi++){var mb=mi*3;fhMotePos[mb]=fhMoteBase[mb]+Math.sin(t*.17+mi)*.09;fhMotePos[mb+1]=.45+((fhMoteBase[mb+1]+(mi===0?1:-1)*t*.065)%4.2+4.2)%4.2;}fhMoteGeo.attributes.position.needsUpdate=true;}

// Silhouettes — completely static (movement was causing flashing)
// They stay in their initial positions

// The Green Fairy — erratic moth-flight around the centre lantern,
// wings shivering, drifting near the glass then darting away
var fairyR = 0.32 + Math.sin(t * 0.23) * 0.14;
greenFairy.position.set(
3 + Math.cos(t * 1.3) * fairyR + Math.sin(t * .79) * 0.05 + Math.sin(t * 1.37) * 0.025,
4.5 + Math.sin(t * 2.1) * 0.26 + Math.sin(t * .89) * 0.04 + Math.cos(t * 1.51) * 0.02,
12 + Math.sin(t * 1.7) * fairyR * 0.8 + Math.cos(t * .93) * 0.04
);
greenFairy.scale.x = 0.17 * (.8 + Math.sin(t * 6) * .15);
greenFairy.material.rotation = Math.sin(t * 1.3) * 0.2;
greenFairy.material.opacity = .84 + Math.sin(t * .7) * .035;
fairyLight.position.copy(greenFairy.position);
fairyLight.intensity = .28 + Math.sin(t * .7) * .018;

// Flag flutter — gentle, post-rain calm
for (var i = 0; i < flagMeshes.length; i++) {
var fm = flagMeshes[i];
fm.mesh.rotation.z = fm.baseRotZ + Math.sin(t * 0.8 + fm.phase) * 0.02;
fm.mesh.rotation.x = -0.3 + Math.sin(t * 0.5 + fm.phase) * 0.01;
}
for (var i = 0; i < bigFlagMeshes.length; i++) {
var bfm = bigFlagMeshes[i];
bfm.mesh.rotation.z = Math.sin(t * 0.6 + bfm.phase) * 0.015;
}

// Walking figure (slower, more contemplative pace)
walker.position.x = 8 - ((t * 0.15) % 20);
if (walker.position.x < -12) walker.position.x = 8;

// Hanging sign — barely moving, damp and heavy
hangSign.rotation.z = Math.sin(t * 0.3) * 0.01;

// A slight ripple within the wet patch; the slab edges stay completely still.
fhReflectionTex.offset.x=Math.sin(t*.27)*.009;
reflectMat.opacity=.25+Math.sin(t*.43-1.4)*.012;

if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
}

fhAnimate();

// Approach button — fades in after 1.5s
var fhBtn = document.createElement('div');
fhBtn.textContent = 'ENTER THE FRENCH';
fhBtn.style.cssText = [
'position:absolute','bottom:60px','left:50%','transform:translateX(-50%)',
'font:13px \'Courier New\',monospace','color:rgba(200,170,100,0.85)',
'letter-spacing:4px','cursor:pointer','padding:12px 28px',
'border:1px solid rgba(200,170,100,0.3)','background:rgba(0,0,0,0.4)',
'z-index:9003','white-space:nowrap','opacity:0','transition:opacity 1.5s ease'
].join(';');
fhWrap.appendChild(fhBtn);
setTimeout(function() { fhBtn.style.opacity = '1'; }, 1500);

fhBtn.addEventListener('mouseenter', function() {
this.style.color = 'rgba(230,200,120,0.95)';
this.style.borderColor = 'rgba(200,170,100,0.6)';
});
fhBtn.addEventListener('mouseleave', function() {
this.style.color = 'rgba(200,170,100,0.85)';
this.style.borderColor = 'rgba(200,170,100,0.3)';
});

fhBtn.addEventListener('click', function() {
fhWrap.style.transition = 'opacity 1.2s ease';
fhWrap.style.opacity = '0';
setTimeout(function() {
cancelAnimationFrame(fhAnimId);
fhWrap.remove();
var TARGET = 'The French';
var link = document.querySelector('tw-link[passage-name="' + TARGET + '"]');
if (!link) {
var allLinks = document.querySelectorAll('tw-passage tw-link');
for (var i = 0; i < allLinks.length; i++) {
if (allLinks[i].textContent.trim() === '\u00B7') { link = allLinks[i]; break; }
}
}
if (link) {
link.click();
} else {
var storyEl = document.querySelector('tw-story') || document.body;
var injected = document.createElement('tw-link');
injected.setAttribute('passage-name', TARGET);
injected.style.display = 'none';
storyEl.appendChild(injected);
injected.click();
storyEl.removeChild(injected);
}
}, 1200);
});
}

// Watch for fh-container. Cleanup mirrors Pillars/Lackland: when the
// container disappears (passage change), cancel the animate loop and
// remove the body-appended wrap so the canvas + listeners don't leak.
setInterval(function() {
var container = document.getElementById('fh-container');
if (container && !fhActive) {
initFrenchHouse();
} else if (!container) {
fhActive = false;
if (fhAnimId) { cancelAnimationFrame(fhAnimId); fhAnimId = null; }
window._dssDisposeWrap('fh-wrap');
}
}, 300);
})();

// ====== THE ROOM'S WORDS — the passage lives inside the room (2026-09-28; the modal 2026-10-04) ======
// Sam (2026-09-28): "When you click on the zoomable objects that should give you
// the options to move through the game. It shouldn't still require the bottom
// text ... it should do similar but more central." So the ten venue rooms hold
// their passage: the passage's rendered nodes (his prose, the lily, the lore
// link, the bar game, the phone) move into one panel inside the room, and every
// link a close-up claims is hidden there, reachable only through its object.
// Sam (2026-10-04): "make sure that they show cleanly after you enter. Any text
// that happened before you reach the inside bit where you have a choice of
// which focus to pick should appear in a modal window that you read and then
// which disappears when you click to send it away." So the panel now arrives
// as a modal over the dimmed room, with one pink line under it to send it away;
// after that the room shows clean but for a thin strip low down that offers
// the links no object claims (as buttons pressing the passage's own links) and
// a pink control to read the words again. The words come back of their own
// accord when the passage puts new ones in the panel (a lily taken, a line
// revealed), and the strip offers every link when the WebGL context is lost
// for good, so the room stays playable without 3D. Nothing is decided here:
// the nodes are the passage's own, every (set:) and gate stays Harlowe's, and
// the card and the strip only press the real link.
// No transform, filter or backdrop on the veil or the panel: the phone's fixed
// modal lives inside the panel and must stay pinned to the viewport.
// 2026-10-05 overnight: since the veil moved beside the passage into tw-story (PR #27), the passage's
// words and links live in the veil's panel, not under tw-passage. Every room's link matcher looked in
// tw-passage and found nothing, so no close-up card offered a choice and the strip carried every link.
// A room now searches the panel when it exists, the passage otherwise.
window.dssRoomScope = function(host) {
var box = document.querySelector('tw-story > .dss-room-fixed .dss-room-prose');
if (box) return box;
return (host && host.closest('tw-passage')) || document.querySelector('tw-passage');
};
// 2026-10-20 (Sam: "I'd rather people used the in-world exits"; "can we just add working doors? That would be the idea"):
// every room's way out ends at the header's "← Out onto the street", which stays in the page but hidden (.dss-exit-reserve,
// shown only where nothing else leads on). A door offers its passage's own exit when there is one and this link otherwise;
// a hidden link still takes the click.
window.dssStreetExit = function() { var l = document.querySelector('.header-links .back-one-link tw-link'); return l ? [l] : []; };
// 2026-10-20 (Sam: "an arrow on the floor that indicates the exit as behind you but still doesn't totally break the world"):
// in the rooms whose door is behind the camera (the Colony, Lackland's office) a chalked arrow on the floor points back at it.
// The group is the hotspot's root; the hotspot's close-up turns the camera round to the door.
window.dssWayOutArrow = function(scene, x, z, toX, toZ) {
var c = document.createElement('canvas'); c.width = 256; c.height = 384;
var cx = c.getContext('2d'), seed = 7;
function r() { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; }
function chalk(x0, y0, x1, y1, w) {
for (var p = 0; p < 12; p++) { /* a dozen thin passes, each a little off the line */
cx.lineWidth = w * (0.35 + r() * 0.5); cx.strokeStyle = 'rgba(236,230,214,' + (0.1 + r() * 0.16).toFixed(3) + ')';
cx.beginPath(); cx.moveTo(x0 + (r() - 0.5) * w * 0.6, y0 + (r() - 0.5) * w * 0.6);
cx.quadraticCurveTo((x0 + x1) / 2 + (r() - 0.5) * w * 0.8, (y0 + y1) / 2 + (r() - 0.5) * w * 0.8, x1 + (r() - 0.5) * w * 0.6, y1 + (r() - 0.5) * w * 0.6); cx.stroke();
}
}
cx.lineCap = 'round';
chalk(130, 356, 127, 70, 30); chalk(127, 46, 52, 142, 28); chalk(127, 46, 206, 138, 28);
cx.globalCompositeOperation = 'destination-out'; /* the floor shows through: specks lifted out of the chalk */
for (var i = 0; i < 900; i++) { cx.fillStyle = 'rgba(0,0,0,' + (0.3 + r() * 0.6).toFixed(2) + ')'; cx.fillRect(r() * 256, r() * 384, 1 + r() * 2.5, 1 + r() * 1.5); }
cx.globalCompositeOperation = 'source-over';
var g = new THREE.Group(); g.position.set(x, 0.012, z); g.rotation.y = Math.atan2(-(toX - x), -(toZ - z)); scene.add(g);
var m = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 0.78), new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(c), transparent: true, opacity: 0.95, color: 0xe2dac6, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -2 }));
m.rotation.x = -Math.PI / 2; g.add(m);
var hit = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.2, 0.95), new THREE.MeshBasicMaterial({ visible: false })); hit.position.y = 0.1; g.add(hit);
return g;
};
// 2026-10-07 (found while moving the lily onto the room's objects): Harlowe finds a hook a passage
// names (the lily's (click-replace: ?lily1), the phone's (replace: ?lilyring)) by searching the passage's
// own element, and since the words moved into the veil it found nothing there, so pressing a lily in a
// room did nothing at all. While a room's panel holds the current passage's words, a search of the
// passage also searches the panel. Nothing else changes: the nodes, the macros and the (set:)s are his.
(function() {
var jq = window.jQuery;
if (!jq || !jq.fn || !jq.fn.findAndFilter || jq.fn.findAndFilter._dssRoom) return;
var ff = jq.fn.findAndFilter;
var wrapped = function(sel) {
var r = ff.call(this, sel);
if (this.length !== 1 || !this[0] || this[0].tagName !== 'TW-PASSAGE') return r;
var pass = this[0];
Array.prototype.forEach.call(document.querySelectorAll('tw-story > .dss-room-fixed'), function(veil) {
var box = veil.querySelector('.dss-room-prose');
if (box && veil._dssWrap && pass.contains(veil._dssWrap)) r = r.add(ff.call(jq(box), sel));
});
// 2026-10-09 (found wiring the ship calls): the plain pages' panel (.dss-threshold) holds a passage's
// words the same way, so "Ignore it" on the ringing box and both buttons on the answered call did
// nothing; a passage's own threshold panel is searched too.
Array.prototype.forEach.call(document.querySelectorAll('tw-story > .dss-threshold'), function(veil) {
var box = veil.querySelector('.dss-room-prose');
if (box && veil._pass === pass) r = r.add(ff.call(jq(box), sel));
});
return r;
};
wrapped._dssRoom = true;
jq.fn.findAndFilter = wrapped;
})();
window.dssRoomProse = function(host, wrap, canvas) {
var root = host.parentNode; if (!root) return null;
// 2026-10-05 (the tighten pass's first recommendation, Sam: "The entry modal is short. In an 800 px
// window it shows about three lines in a box over the room ... let it cover the whole screen, which
// also hides any flicker as the room warms up"): the veil is fixed to the viewport, not the room's
// box, and lives beside the passage in tw-story like the plain pages' panel (a passage can carry a
// transform, and a fixed veil inside a transformed box is drawn at the box's size). It is taken away
// with the room (see the watcher at the end).
var veil = document.createElement('div'); veil.className = 'dss-room-veil dss-room-fixed'; veil._dssWrap = wrap;
var sheet = document.createElement('div'); sheet.className = 'dss-room-sheet';
var box = document.createElement('div'); box.className = 'dss-room-prose';
Array.prototype.slice.call(root.childNodes).forEach(function(n) {
if (n === host || n === wrap) return;
if (n.nodeType === 1 && /^(TW-SIDEBAR|SCRIPT|STYLE)$/.test(n.tagName)) return;
// the header and footer passages are the page's frame, not the room's words
if (n.nodeType === 1 && n.tagName === 'TW-INCLUDE' && /^(header|footer|startup|debug)/.test(n.getAttribute('type') || '')) return;
box.appendChild(n);
});
sheet.appendChild(box);
var dismiss = document.createElement('div'); dismiss.className = 'dss-room-dismiss';
// 2026-10-11 (Sam, structure pass 3: the modal over the room "says 'back' and this makes no sense, You aren't moving 'back'")
// 2026-10-13 (Sam: "Close" breaks the spell; "To the bar"): the room's own way in, by the passage's venue tag
dismiss.textContent = (function() {
var tp = host.closest('tw-passage') || document.querySelector('tw-passage'), tags = ' ' + ((tp && tp.getAttribute('tags')) || '') + ' ';
var by = { 'venue-chippy': 'To the counter', 'venue-cellar': 'Into the cellar', 'venue-gents': 'Into the gents', 'venue-lackland': 'Into the office', 'venue-cecilcourt': 'Into the shop', 'green-sea': 'Into the café' };
for (var k in by) if (tags.indexOf(' ' + k + ' ') >= 0) return by[k];
return /\svenue-(coach|colony|french|pillars|ronnies|trishas)\s/.test(tags) ? 'To the bar' : 'Step inside';
})();
sheet.appendChild(dismiss);
veil.appendChild(sheet);
var story = wrap.closest('tw-story') || wrap;
story.appendChild(veil);
// 2026-10-11 structure pass 3: a pickup card the passage raises on entry (the chippy's matches) was carried into the
// panel with the words and drawn tangled up with them, two overlays at once. Such a card is lifted out to sit above
// the room on its own dark ground; the panel's words wait behind it and are read once it is pocketed.
var lifted = Array.prototype.slice.call(box.querySelectorAll('#match-overlay, #coin-overlay, #cig-overlay, #eat-overlay'));
lifted.forEach(function(o) { story.appendChild(o); });
if (lifted.length) { var heldT = setInterval(function() { var up = lifted.some(function(o) { return o.isConnected && o.style.display !== 'none' && !o.classList.contains('coin-overlay-fade'); }); veil.classList.toggle('dss-room-held', up); if (!lifted.some(function(o) { return o.isConnected; }) || !wrap.isConnected) { veil.classList.remove('dss-room-held'); clearInterval(heldT); } }, 150); }
var gone = setInterval(function() { if (wrap.isConnected) return; clearInterval(gone); if (veil.parentNode) veil.parentNode.removeChild(veil); lifted.forEach(function(o) { if (o.parentNode) o.parentNode.removeChild(o); }); }, 300);
// the panel starts below whatever the fixed header shows (its exit link hangs under the stat bar)
function clearHeader() {
var under = 0;
Array.prototype.forEach.call(document.querySelectorAll('.stat-bars tw-link, #stat-bars-lifted tw-link'), function(l) { var r = l.getBoundingClientRect(); if (r.height) under = Math.max(under, r.bottom); });
veil.style.paddingTop = under ? Math.max(parseFloat(getComputedStyle(veil).paddingTop) || 0, under + 12) + 'px' : '';
}
var strip = document.createElement('div'); strip.className = 'dss-room-strip';
wrap.appendChild(strip);
// Harlowe's line breaks around the passage's silent hooks leave a run of blank
// lines before the first word and after the last; those are hidden here, and
// nothing between the words is touched.
function trim() {
Array.prototype.forEach.call(box.querySelectorAll('.dss-trim'), function(e) { e.classList.remove('dss-trim'); });
var all = []; var w = document.createTreeWalker(box, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
while (w.nextNode()) all.push(w.currentNode);
function solid(n) {
if (n.nodeType === 3) return !!n.nodeValue.trim() && !n.parentNode.closest('.dss-claimed, .dss-claimed-wrap, script, style');
return /^(svg|canvas|img|button|input|select|textarea|video)$/i.test(n.tagName) && !n.closest('.dss-claimed, .dss-claimed-wrap');
}
function blankLine(n) { return n.nodeType === 1 && /^(BR|TW-CONSECUTIVE-BR)$/.test(n.tagName); }
var i, j;
for (i = 0; i < all.length && !solid(all[i]); i++) if (blankLine(all[i])) all[i].classList.add('dss-trim');
for (j = all.length - 1; j > i && !solid(all[j]); j--) if (blankLine(all[j])) all[j].classList.add('dss-trim');
// between the words, a run of blank lines left by silent hooks (the ringing phone's (if:), a (set:) on its
// own line) keeps one paragraph's gap and no more
function gap(n) { return !solid(n); }
var breaks = 0;
for (var q = i; q < j; q++) {
if (!gap(all[q])) { breaks = 0; continue; }
if (blankLine(all[q]) && ++breaks > 2) all[q].classList.add('dss-trim');
}
}
trim();
function hasContent(el) {
for (var n = el.firstChild; n; n = n.nextSibling) {
if (n.nodeType === 3) { if (n.nodeValue.trim()) return true; }
else if (n.nodeType === 1) {
if (n.classList.contains('dss-claimed') || n.classList.contains('dss-claimed-wrap')) continue;
if (/^(svg|canvas|img|button|input|select|textarea|video)$/i.test(n.tagName)) return true;
if (hasContent(n)) return true;
}
}
return false;
}
// the words as the reader sees them: the text outside links, the phone's own modal and anything hidden
// (2026-10-07: and the key offers, parked off-screen: pocketing a key from its object's card put its note
// in the offer, which counted as new words and brought the room's opening panel back over the room;
// the note goes on a notice slip instead)
function prose() {
var out = [], w = document.createTreeWalker(box, NodeFilter.SHOW_TEXT);
while (w.nextNode()) {
var t = w.currentNode, pe = t.parentNode;
if (!t.nodeValue.trim() || !pe || pe.nodeType !== 1) continue;
// (2026-10-07, Sam: "when you collect a flower it should just show the fact that it's collected, not take
// you back to the start prose": the lily's glimpse, once the hook is taken, goes on a notice slip from the
// object's card, in a modal of its own (dssLilyPopup), and does not count as new words here either)
if (pe.closest('tw-link, .phone-ringing, script, style, .dss-claimed, .dss-claimed-wrap, .dss-trim, .dss-key-offer, tw-hook[name^="lily"]')) continue;
if (!pe.getClientRects().length) continue;
out.push(t.nodeValue.replace(/\s+/g, ' '));
}
// 2026-10-14 (overnight report, Sam: fix): marks with no words (the "~", an ornament) are not words to open the panel for
var said = out.join(' ').trim();
return /[A-Za-z0-9\u00C0-\u024F]/.test(said) ? said : '';
}
var full = false, mode = 'room', camMode = 'idle', shownProse = null;
// If the browser takes the room's WebGL context and does not give it back (Safari does this
// across tabs of the same site), the objects that hold the passage's choices cannot be drawn,
// so after a few seconds without it the strip offers every link itself; they are claimed
// again the moment the context is restored.
var lostAt = 0, lostLong = false, dead = false;
if (canvas) {
canvas.addEventListener('webglcontextlost', function() { lostAt = Date.now(); }, true);
canvas.addEventListener('webglcontextrestored', function() { lostAt = 0; }, true);
}
function render() {
var modal = full || (mode === 'modal' && camMode === 'idle');
veil.classList.toggle('dss-room-veil-on', modal);
veil.classList.toggle('dss-room-veil-full', full);
box.classList.toggle('dss-room-prose-away', !modal);
box.classList.toggle('dss-room-prose-full', full);
var stripOn = !full && mode === 'room' && (camMode === 'idle' || lostLong);
strip.classList.toggle('dss-room-strip-on', stripOn);
wrap.dataset.words = full ? 'full' : (modal ? 'modal' : 'room');
}
function open() { mode = 'modal'; veil.scrollTop = 0; clearHeader(); render(); }
window.dssRoomProseReopen = function() { if (veil.isConnected) open(); }; /* 2026-10-17: with 'Take it in again' cut, the password Deploy reopens the panel through this */
function close() { mode = 'room'; shownProse = prose(); render(); try { wrap.dispatchEvent(new CustomEvent('dss-room-words-away')); } catch (e) {} }
veil.addEventListener('pointerdown', function(ev) { if (ev.target === veil || ev.target === sheet || ev.target === dismiss) { ev.stopPropagation(); if (!full) close(); } });
dismiss.addEventListener('click', function(ev) { ev.stopPropagation(); if (!full) close(); });
// 2026-10-11 structure pass 3: the panel's Close could only be clicked. It is a real button for the keyboard now
// (Tab to it, Enter or Space), and Escape closes the panel too, unless a field or another modal holds the keyboard.
dismiss.setAttribute('role', 'button'); dismiss.tabIndex = 0;
// closed from the keyboard, the focus lands on the strip's Look again button, not back at the top of the page
function keyClose() { close(); setTimeout(function() { var a = wrap.querySelector('.dss-room-strip-on .dss-room-strip-btn'); if (a && a.getClientRects().length) { try { a.focus({ preventScroll: true }); } catch (e) {} } else wrap.dispatchEvent(new CustomEvent('dss-room-key-entry')); }, 0); }
dismiss.addEventListener('keydown', function(ev) { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); ev.stopPropagation(); if (!full) keyClose(); } });
function onPanelEsc(ev) {
if (!veil.isConnected) { document.removeEventListener('keydown', onPanelEsc); return; }
if (ev.key !== 'Escape' || ev.defaultPrevented || full || !veil.classList.contains('dss-room-veil-on')) return;
var f = document.activeElement;
if (f && /^(INPUT|TEXTAREA|SELECT)$/.test(f.tagName)) return;
if (window.dssOverlayBusy && window.dssOverlayBusy()) return;
// the NOTEBOOK (a Harlowe dialog) closes on Escape itself; the panel under it stays (structure pass 3)
if (document.querySelector('tw-dialog')) return;
ev.preventDefault(); keyClose();
}
document.addEventListener('keydown', onPanelEsc);
// the strip: a button for each link the room's objects leave to the passage, pressing the real one
var stripKey = null;
function offer(claimedNow) {
var items = [];
Array.prototype.forEach.call(box.querySelectorAll('tw-link, button, a[href], tw-hook[name^="lily"]'), function(e) {
if (claimedNow.indexOf(e) >= 0 || e.closest('.phone-ringing, .dss-claimed, .dss-claimed-wrap, .dss-trim, script, .dss-pwd-box')) return; /* 2026-10-17 (Sam): the password's Say it stays in its box, not on the strip (an empty Say it from the strip went straight to the fight) */
if (e.tagName === 'TW-HOOK' && !e.querySelector('svg')) return;
if (e.closest('tw-link, button, a[href]') !== e && e.tagName !== 'TW-HOOK') return;
if (!e.getClientRects().length) return;
var label = e.tagName === 'TW-HOOK' ? '' : e.textContent.replace(/\s+/g, ' ').trim();
if (e.tagName === 'TW-HOOK') { var lp = e.querySelector('.lily-prompt'); if (lp) label = lp.textContent.replace(/\s+/g, ' ').trim(); if (!label) return; }
if (!label || label === 'AUDIT READ') return;
items.push({ el: e, label: label });
});
var key = items.map(function(it) { return it.label; }).join('\u0001');
if (key === stripKey) return;
stripKey = key;
strip.innerHTML = '';
items.forEach(function(it) {
var b = document.createElement('button'); b.type = 'button'; b.className = 'dss-room-strip-btn';
b.textContent = it.label;
b.addEventListener('pointerdown', function(ev) { ev.stopPropagation(); });
b.addEventListener('click', function(ev) { ev.stopPropagation(); if (it.el.isConnected) it.el.click(); });
strip.appendChild(b);
});
/* 2026-10-17 (Sam: "I don't think we need an option to read again"): the strip's 'Take it in again' button (it reopened the room's prose panel) is cut. To restore: create a button with class 'dss-room-strip-btn dss-room-strip-again', text 'Take it in again', whose click (after ev.stopPropagation()) calls open(), and append it to strip here. */
}
function refresh(claimed) {
var lostNow = dead || (!!lostAt && (Date.now() - lostAt > 2500)), lostTurned = false;
if (lostNow !== lostLong) {
lostLong = lostNow; lostTurned = true;
box.classList.toggle('dss-room-prose-lost', lostLong);
strip.classList.toggle('dss-room-strip-lost', lostLong);
var c = wrap.querySelector('.dss-room-card');
if (c) { c.style.opacity = lostLong ? '0' : c.style.opacity; if (lostLong) c.style.pointerEvents = 'none'; }
if (lostLong) { try { console.warn('DSS: room context lost; the strip offers the passage\'s links itself'); } catch (e) {} }
}
if (lostLong) claimed = [];
claimed = (claimed || []).filter(function(e) { return e && e.nodeType === 1 && box.contains(e) && !e.closest('.phone-ringing'); });
// 2026-10-07 (Sam: "I want it moved entirely to the clickable object part"): the lily the room's object offers
// is claimed like a link, so it is gathered at the object only; once taken (or lost to drink) it leaves the
// object's actions and its glimpse shows in the words as before
var claimedLinks = claimed;
Array.prototype.forEach.call(box.querySelectorAll('.dss-claimed'), function(e) { if (claimedLinks.indexOf(e) < 0) e.classList.remove('dss-claimed'); });
Array.prototype.forEach.call(box.querySelectorAll('.dss-claimed-wrap'), function(e) { e.classList.remove('dss-claimed-wrap'); });
claimedLinks.forEach(function(e) { e.classList.add('dss-claimed'); });
// a wrapper left with nothing to show once its link is hidden (a choice box, an (if:) hook, a line of its own) goes with it
claimedLinks.forEach(function(e) {
var p = e.parentNode;
while (p && p !== box && p.nodeType === 1 && !hasContent(p)) { p.classList.add('dss-claimed-wrap'); p = p.parentNode; }
});
// the bar game, once it starts, takes the whole panel and the pointer with it
var game = box.querySelector('#bar-canvas');
var wasFull = full;
full = !!(game && game.style.display !== 'none');
trim();
offer(claimed);
// the words come up on arrival, and again whenever the passage has put new ones in the panel
var now = prose();
// 2026-10-05 overnight: when the context goes (or comes back) the links change hands, and the words a
// wrapper shows with them; that is not new prose, so the modal does not come back over the strip
if (lostTurned && shownProse !== null) shownProse = now;
if (shownProse === null) { if (now) { mode = 'modal'; clearHeader(); } shownProse = now; }
else if (mode === 'room' && now !== shownProse && !full) { shownProse = now; open(); }
render();
// as the round begins the panel scrolls to the arena, so the game is in view and not the words above it
if (full && !wasFull) { var arena = box.querySelector('#bar-arena'); if (arena) veil.scrollTop += arena.getBoundingClientRect().top - veil.getBoundingClientRect().top - 6; }
}
function setMode(m) { camMode = m; render(); }
function down() { try { wrap.dispatchEvent(new CustomEvent('dss-room-emptytap')); } catch (e) {} }
// the room's frame or build has failed (see dssSceneFailed): the panel comes up with every link, for the rest of the visit
function fail() { dead = true; camMode = 'idle'; mode = 'modal'; refresh([]); }
return { box: box, veil: veil, strip: strip, refresh: refresh, setMode: setMode, down: down, open: open, close: close, fail: fail };
};

// ====== PLAIN PAGES AS PANELS — the words of a plain passage show in the rooms' dark panel (2026-10-05) ======
// Sam: "any parts that are on the 'main basic backgound' of the game passages now look a bit lame and
// old fashioned. Can you lift all that text onto a modal that you read before you see the internal 3d
// render and its choices?" and then "Any text which is sort of on the back basic level of the passages
// now looks a bit old fashioned and underworked. Could it be in a modal too?" So every passage that is
// plain words (no 3D scene, no minigame canvas or stage, no iframe, not the hub or the title) keeps every
// gate, (set:) and link exactly where it is, but its rendered nodes move into the same dark panel the
// rooms use, over the dimmed page, with its links inside the panel. A passage tagged `threshold` always
// gets the panel; one tagged `flat` never does. Nothing is decided here.
window.dssThreshold = (function() {
// 2026-10-12: the two ending pages (white-page, black-page) are their own full screens: the panel put a dark box over the
// white page's cream and hid its words
var SKIP_TAGS = /(^|\s)(hub|header|footer|startup|debug|flat|system|dawn-end|dawn-approach|white-page|black-page)(\s|$)/;
// 2026-10-05: a passage that already frames itself (the typewriter letters, Shana's neon table, the
// gents' worm wall) keeps its own plain page rather than sitting as a sheet inside a second dark box
// (Sam, 01:24: "plain for typewriter").
// 2026-10-07: the street scenes' holders are matched by id, and three of them (Cecil Court, the Green Sea,
// Carthage) end in -approach rather than -container, so the panel mounted behind their scene: an empty
// bordered bar with the door's dot in it, shown for the second and a half the scene takes to fade out
// after ENTER CECIL COURT (Sam: "the same gold box/bar").
var SKIP_IN = '[id$="-container"], [id$="-approach"], canvas, iframe, #dss-title, .hc-stage, .soho-map-stage, [class*="-stage"], [class*="-arena"], .dawn-approach, .typewriter-page, .trishas-frame, .worm-wall';
function wants(pass) {
var tags = pass.getAttribute('tags') || '';
if (/(^|\s)threshold(\s|$)/.test(tags)) return true;
if (SKIP_TAGS.test(tags)) return false;
if (pass.querySelector(SKIP_IN)) return false;
return true;
}
// 2026-10-07: a panel only for words. A passage that shows none (Shelley's liver: its popup over a hidden
// door dot; a pass-through page on its go-to) drew the empty gold bar with the dot in it (Sam: "get rid of
// all in that family"). Text inside script, style, hidden elements or the header strip does not count, nor
// a lone dot or ornament: a letter or a digit has to be on show. The watcher asks again until one is.
function hasWords(pass) {
var w = document.createTreeWalker(pass, NodeFilter.SHOW_TEXT), n;
while ((n = w.nextNode())) {
if (!/[A-Za-z0-9\u00C0-\u024F]/.test(n.nodeValue)) continue;
var el = n.parentNode;
if (el.closest('script, style, tw-sidebar, .stat-bars, #stat-bars-lifted, tw-include[type="header"], tw-include[type="footer"]')) continue;
if (!el.getClientRects().length) continue;
return true;
}
return false;
}
function blankLine(n) { return n.nodeType === 1 && /^(BR|TW-CONSECUTIVE-BR)$/.test(n.tagName); }
function solid(n) {
if (n.nodeType === 3) return !!n.nodeValue.trim() && !n.parentNode.closest('script, style');
return /^(svg|canvas|img|button|input|select|textarea|video|iframe)$/i.test(n.tagName);
}
function trim(box) {
var all = [], w = document.createTreeWalker(box, NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT);
while (w.nextNode()) all.push(w.currentNode);
var i, j;
for (i = 0; i < all.length && !solid(all[i]); i++) if (blankLine(all[i])) all[i].classList.add('dss-trim');
for (j = all.length - 1; j > i && !solid(all[j]); j--) if (blankLine(all[j])) all[j].classList.add('dss-trim');
// 2026-10-05 overnight: between the words, a run of blank lines broken only by hidden hooks (an alley's
// (if:) chain left seventeen of them) keeps two, so the panel holds the words and not the gates' spaces
var kept = 0;
for (var k = i; k <= j; k++) {
var n = all[k];
if (blankLine(n)) { if (!n.classList.contains('dss-trim')) { kept++; if (kept > 2) n.classList.add('dss-trim'); } }
else if (solid(n) || (n.nodeType === 1 && !n.children.length && !n.textContent.trim() && n.offsetHeight > 8 && n.getClientRects().length)) kept = 0;
}
}
function mount(pass) {
pass.setAttribute('data-dss-threshold', '1');
var veil = document.createElement('div'); veil.className = 'dss-room-veil dss-room-veil-on dss-threshold';
var box = document.createElement('div'); box.className = 'dss-room-prose';
Array.prototype.slice.call(pass.childNodes).forEach(function(n) {
if (n.nodeType === 1 && /^(TW-SIDEBAR|SCRIPT|STYLE)$/.test(n.tagName)) return;
if (n.nodeType === 1 && n.tagName === 'TW-INCLUDE' && /^(header|footer|startup|debug)/.test(n.getAttribute('type') || '')) return;
if (n.nodeType === 1 && (n.classList.contains('stat-bars') || n.id === 'stat-bars-lifted')) return;
box.appendChild(n);
});
veil.appendChild(box);
// the veil lives beside the passage in tw-story, not inside it: a passage can carry a transform (the
// entrance slide, the drunk sway on the Maritime interlude), and a fixed veil inside a transformed box
// would be drawn at the box's size. The watcher below removes the veil when its passage has gone.
veil._pass = pass; (pass.closest('tw-story') || pass.parentElement || pass).appendChild(veil);
// 2026-10-05: a venue's exit link hangs under the fixed header strip and sat across the panel's
// first line; the panel starts below whatever the header shows
var under = 0;
Array.prototype.forEach.call(document.querySelectorAll('.stat-bars tw-link, #stat-bars-lifted tw-link, .stat-bars .alba-hint, #stat-bars-lifted .alba-hint'), function(l) { var r = l.getBoundingClientRect(); if (r.height) under = Math.max(under, r.bottom); });
if (under) veil.style.paddingTop = Math.max(parseFloat(getComputedStyle(veil).paddingTop) || 0, under + 12) + 'px';
trim(box);
// a (link:) or (replace:) that adds words later keeps the panel tidy too
var again = null;
new MutationObserver(function() { if (again) return; again = setTimeout(function() { again = null; Array.prototype.forEach.call(box.querySelectorAll('.dss-trim'), function(e) { e.classList.remove('dss-trim'); }); trim(box); }, 60); }).observe(box, { childList: true, subtree: true });
}
// the header strip is lifted out of the passage by the cleanup passes in the first half second; wait for that,
// or the exit link and the stat bar would come into the panel with the words
// The cleanup passes (30, 200, 450 ms: the header lift, the ornament pass, the lamp) look inside
// tw-passage, so the words move only after half a second; the passage's own entrance fade is still
// in its delay then, so nothing shows twice.
var seen = null, seenAt = 0;
setInterval(function() {
Array.prototype.forEach.call(document.querySelectorAll('.dss-threshold'), function(v) { if (v._pass && !v._pass.isConnected) v.parentNode.removeChild(v); });
// 2026-10-07: only the live passage, the one tw-story holds directly. The after-image clones the passage
// just left into .dss-ghost, and a clone of a pass-through passage (Start, gone in a tick on its go-to,
// so never marked) has no typewriter page, so the panel mounted on the clone: the page went dark and an
// empty bordered box sat over the first letter for a second before the ghost was removed (Sam: "the bar").
var p = document.querySelector('tw-story > tw-passage:not([data-dss-threshold])');
if (!p) { seen = null; return; }
if (p !== seen) { seen = p; seenAt = Date.now(); }
if (!wants(p)) { p.setAttribute('data-dss-threshold', '0'); return; }
if (!hasWords(p)) return;
if (Date.now() - seenAt > 520 && (!p.querySelector('.stat-bars') || Date.now() - seenAt > 900)) mount(p);
}, 100);
return { mount: mount, wants: wants };
})();

/* ====== CHARACTER DECO (2026-10-22, Sam: "Yeah i like this, build them") ======
   The line portraits came off the character scenes and left the panel bare. A plain page tagged
   char-<id> gets stepped Art Deco corners on its panel, grown out of the frame's after-image line,
   and a character with a motif has it drawn faint behind the words: JOHN ST. JOHN's Zippo flame,
   stepped, and INIS O'FLATTERLY's open book, fanned. Both draw themselves in, hold, then settle.
   Later the same night (Sam: "Draw the rest of the motifs you proposed"): LACKLAND the Garrard's
   rings and tonearm, THE GREAT HAM a proscenium arch, RED a lyre with a fan behind it, the novelist
   a typewriter's typebars, SHANA a fanned hand of cards, AOIFE and LILY a telephone dial, and the
   dual ring two dials interlocked.
   The corners hang in the veil beside the panel, not inside it, where the panel's trim would count
   them as content. The motif is the panel's own background image, fixed to the window as the
   portraits were, so a long scene scrolls over it. Add a character to MOTIFS to give them one. */
window.dssCharDeco = (function() {
var reduce = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches), n = 0, live = null;
function r1(v) { return Math.round(v * 10) / 10; }
function seg(d) { return '<path pathLength="1" d="' + d + '"/>'; }
function flame() {
var c = 130, b = 332, s = '';
[1, 0.8, 0.6, 0.4, 0.22].forEach(function(k) {
var h = 320 * k, w = 118 * k, y1 = r1(b - h), y2 = r1(b - h * 0.74), y3 = r1(b - h * 0.48);
s += seg('M' + c + ',' + y1 + ' L' + r1(c + w * 0.35) + ',' + y2 + ' H' + r1(c + w * 0.6) + ' V' + y3 + ' H' + r1(c + w) + ' V' + b + ' H' + r1(c - w) + ' V' + y3 + ' H' + r1(c - w * 0.6) + ' V' + y2 + ' H' + r1(c - w * 0.35) + ' Z');
});
[-48, -24, 0, 24, 48].forEach(function(x) { s += seg('M' + (c + x) + ',' + b + ' V' + (b + 12)); });
s += seg('M10,' + (b + 12) + ' H250') + seg('M24,' + (b + 18) + ' H236');
return { w: 260, h: 360, cap: 440, body: s };
}
function book() {
var cx = 260, cy = 250, R = 230, s = '';
for (var a = 186; a <= 354; a += 6) {
var t = a * Math.PI / 180, q = t + (a < 270 ? 0.14 : -0.14);
s += seg('M' + cx + ',' + cy + ' Q' + r1(cx + 130 * Math.cos(q)) + ',' + r1(cy + 130 * Math.sin(q)) + ' ' + r1(cx + R * Math.cos(t)) + ',' + r1(cy + R * Math.sin(t)));
}
[R, R + 10, 56].forEach(function(rr) { s += seg('M' + (cx - rr) + ',' + cy + ' A' + rr + ',' + rr + ' 0 0 1 ' + (cx + rr) + ',' + cy); });
s += seg('M0,' + cy + ' H520') + seg('M12,' + (cy + 7) + ' H508');
return { w: 520, h: 262, cap: 300, body: s };
}
function circ(cx, cy, r) { return seg('M' + r1(cx - r) + ',' + r1(cy) + ' A' + r + ',' + r + ' 0 1 0 ' + r1(cx + r) + ',' + r1(cy) + ' A' + r + ',' + r + ' 0 1 0 ' + r1(cx - r) + ',' + r1(cy)); }
function polar(cx, cy, r, deg) { var t = deg * Math.PI / 180; return [r1(cx + r * Math.cos(t)), r1(cy + r * Math.sin(t))]; }
function ray(cx, cy, r0, r, deg) { return seg('M' + polar(cx, cy, r0, deg) + ' L' + polar(cx, cy, r, deg)); }
function arc(cx, cy, r, a0, a1) { return seg('M' + polar(cx, cy, r, a0) + ' A' + r + ',' + r + ' 0 0 1 ' + polar(cx, cy, r, a1)); }
function garrard() {
var cx = 150, cy = 160, s = '';
[128, 120, 104, 92, 80, 68, 56, 34, 4].forEach(function(r) { s += circ(cx, cy, r); });
for (var a = 0; a < 360; a += 10) s += ray(cx, cy, 129, 135, a);
s += circ(318, 50, 12) + circ(318, 50, 5) + seg('M310,24 H326 V36 H310 Z') + seg('M318,62 V176 L262,204') + seg('M262,197 L246,205 L252,216 L268,208 Z');
return { w: 340, h: 300, cap: 360, body: s };
}
function proscenium() {
var cx = 180, base = 286, s = '';
[[150, 160], [124, 172], [98, 184], [72, 196]].forEach(function(p) { s += seg('M' + (cx - p[0]) + ',' + base + ' V' + p[1] + ' A' + p[0] + ',' + p[0] + ' 0 0 1 ' + (cx + p[0]) + ',' + p[1] + ' V' + base); });
s += seg('M168,10 V2 H192 V10');
/* a scalloped valance under the inner arch and the curtains drawn to the sides; curtains swept into
   the middle left a vase between them that read as two faces in profile */
s += seg('M125,150 Q143,170 161.7,150 Q180,170 198.3,150 Q217,170 235,150');
s += seg('M110,200 Q122,240 112,286') + seg('M118,176 Q132,232 122,286') + seg('M250,200 Q238,240 248,286') + seg('M242,176 Q228,232 238,286');
s += seg('M10,' + base + ' H350') + seg('M24,' + (base + 8) + ' H336') + seg('M40,' + (base + 16) + ' H320');
for (var x = 132; x <= 228; x += 16) s += seg('M' + (x - 5) + ',' + (base - 1) + ' A5,5 0 0 1 ' + (x + 5) + ',' + (base - 1));
return { w: 360, h: 306, cap: 400, body: s };
}
function lyre() {
/* S-curved arms rising from a sound box and curling out at the tips, the strings fanning down from the
   yoke to the tailpiece: the fan is the strings. Drawn first as a cup with a fan on top, it read as an urn */
var s = seg('M112,270 C70,240 66,190 88,150 C100,128 90,108 70,102 C58,99 54,110 62,114') + seg('M188,270 C230,240 234,190 212,150 C200,128 210,108 230,102 C242,99 246,110 238,114');
s += seg('M88,140 H212') + seg('M136,266 H164') + seg('M112,270 H188 L178,294 H122 Z');
[0, 1, 2, 3, 4, 5, 6].forEach(function(i) { s += seg('M' + r1(100 + i * 100 / 6) + ',140 L' + (141 + i * 3) + ',266'); });
s += seg('M114,304 H186') + seg('M104,312 H196') + seg('M94,320 H206');
return { y: 90, w: 300, h: 236, cap: 360, body: s };
}
function typebars() {
var cx = 180, cy = 30, s = seg('M60,8 H300') + seg('M60,16 H300');
for (var a = 40; a <= 140; a += 3.125) s += ray(cx, cy, 46, 218, a);
s += arc(cx, cy, 222, 40, 140) + arc(cx, cy, 230, 40, 140) + arc(cx, cy, 42, 40, 140) + seg('M170,22 H190 V34 H170 Z');
for (var x = 72; x <= 288; x += 24) s += circ(x, 274, 7);
for (x = 84; x <= 276; x += 24) s += circ(x, 294, 7);
return { w: 360, h: 304, cap: 360, body: s };
}
function cards() {
var px = 180, py = 316, s = '';
/* each card is filled with the panel's dark, so a card laid over another hides the lines beneath it */
[-36, -18, 0, 18, 36].forEach(function(a) {
var t = a * Math.PI / 180, c = Math.cos(t), sn = Math.sin(t), ox = px + 180 * sn, oy = py - 180 * c;
function q(x, y) { return r1(ox + x * c - y * sn) + ',' + r1(oy + x * sn + y * c); }
s += '<path pathLength="1" fill="#0a0705" d="M' + q(-42, -66) + ' L' + q(42, -66) + ' L' + q(42, 66) + ' L' + q(-42, 66) + ' Z"/>';
s += seg('M' + q(-35, -59) + ' L' + q(35, -59) + ' L' + q(35, 59) + ' L' + q(-35, 59) + ' Z');
s += seg('M' + q(0, -16) + ' L' + q(11, 0) + ' L' + q(0, 16) + ' L' + q(-11, 0) + ' Z');
});
return { w: 360, h: 260, cap: 300, body: s };
}
function dialAt(cx, cy) {
var s = '';
[140, 132, 120, 72, 52, 44, 4].forEach(function(r) { s += circ(cx, cy, r); });
for (var i = 0; i < 10; i++) { var p = polar(cx, cy, 96, -30 - 30 * i); s += circ(p[0], p[1], 16); }
return s + ray(cx, cy, 108, 138, 30);
}
var MOTIFS = { john: flame(), inis: book(), lack: garrard(), ham: proscenium(), red: lyre(), novelist: typebars(), shana: cards(),
aoife: { w: 300, h: 300, cap: 320, body: dialAt(150, 150) }, lily: { w: 300, h: 300, cap: 320, body: dialAt(150, 150) },
dual: { w: 520, h: 300, cap: 300, body: dialAt(150, 150) + dialAt(370, 150) } };
/* 2026-10-23 (Sam, playtest: "it should be more faint. Atm it disrupts the text"; "the lines should not draw again every time, not if
   it's the same interlocutor. They are the constant"): fainter (peak .26, settled .09), and with the same person as last time the
   motif and the corners are simply there, settled, with no draw-in */
function image(m, still) {
var css = (reduce || still) ? 'g{opacity:.09}' : 'path{stroke-dasharray:1;stroke-dashoffset:1;animation:d 2.8s cubic-bezier(.3,.6,.3,1) 1s forwards}g{opacity:0;animation:o 6.5s ease-out forwards}@keyframes d{to{stroke-dashoffset:0}}@keyframes o{0%,15%{opacity:0}24%{opacity:.26}58%{opacity:.26}100%{opacity:.09}}';
/* the count makes each mount a new image, so the draw-in plays again on the next visit */
var svg = '<svg xmlns="http://www.w3.org/2000/svg" id="m' + (++n) + '" viewBox="0 ' + (m.y || 0) + ' ' + m.w + ' ' + m.h + '"><style>' + css + '</style><g fill="none" stroke="#c8a86a" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">' + m.body + '</g></svg>';
return 'url("data:image/svg+xml,' + encodeURIComponent(svg) + '")';
}
/* fixed to the window: centred in the part of the panel on screen when it opens, never taller than two
   thirds of the window, never wider than the panel's text */
/* 2026-10-24 (Sam, playtest at RED: "they begin off centre and low then they centre. They should not move"): measured without the
   panel's own rise (its transform), and only shown once the panel has stopped moving */
function rectNoTf(box) {
var r = box.getBoundingClientRect(), tx = 0, ty = 0;
try { var mt = new DOMMatrixReadOnly(getComputedStyle(box).transform); tx = mt.m41; ty = mt.m42; } catch (e) {}
return { left: r.left - tx, top: r.top - ty, right: r.right - tx, bottom: r.bottom - ty, width: r.width, height: r.height };
}
function place(box, m) {
var r = rectNoTf(box), vh = window.innerHeight || 600;
var top = Math.max(r.top, 0), bot = Math.min(r.bottom, vh);
if (bot - top < 80) return;
var h = Math.min(bot - top - 36, vh * 0.66, m.cap), w = h * m.w / m.h, wmax = r.width - 48;
if (w > wmax) { w = wmax; h = w * m.h / m.w; }
box.style.backgroundSize = Math.round(w) + 'px ' + Math.round(h) + 'px';
box.style.backgroundPosition = Math.round(r.left + (r.width - w) / 2) + 'px ' + Math.round(top + (bot - top - h) / 2) + 'px';
}
var lastWho = ''; /* the person on the last decorated page (2026-10-23) */
var CORNER = '<path pathLength="1"d="M-4.5,62 V30 H-12 V18 H-18 V-18 H18 V-12 H30 V-4.5 H62"/><path pathLength="1" d="M-14,10 V-14 H10"/>';
function decorate(veil) {
veil._dssDeco = 1;
var tags = veil._pass.getAttribute('tags') || '', ids = tags.match(/(^|\s)char-[a-z]+/g), box = veil.querySelector('.dss-room-prose');
if (!ids || !box) return;
var f = document.createElement('div'), m = null;
f.className = 'dss-deco-frame'; f.setAttribute('aria-hidden', 'true');
['tl', 'tr', 'bl', 'br'].forEach(function(c) { f.insertAdjacentHTML('beforeend', '<svg class="dss-deco-c dss-deco-' + c + '" viewBox="-20 -20 86 86">' + CORNER + '</svg>'); });
veil.appendChild(f);
ids = ids.map(function(t) { return t.trim().slice(5); });
var who = ids.slice().sort().join('+'), still = who === lastWho; lastWho = who;
if (still) f.classList.add('dss-deco-still');
/* the dual ring carries both wives' tags: two dials, interlocked */
if (ids.indexOf('aoife') > -1 && ids.indexOf('lily') > -1) m = MOTIFS.dual;
for (var i = 0; i < ids.length && !m; i++) m = MOTIFS[ids[i]] || null;
var img = m ? image(m, still) : '';
if (m) box.classList.add('dss-deco-motif');
function fit() {
if (!box.isConnected) return;
/* a call card draws its own rotary dial, so a panel holding one keeps only the corners (checked again as
   the panel grows, in case the card comes in after the ring) */
if (m && box.querySelector('.phone-scene')) { m = null; box.classList.remove('dss-deco-motif'); box.style.backgroundImage = ''; }
/* 2026-10-28 (the panel fit): a panel too tall for the window is zoomed, and offsetLeft/Top/Width/Height are its size before
   the zoom, so the corners stood round the full-size box and hung below the window; they now take the box as it is drawn */
var z = parseFloat(box.style.zoom) || 1;
if (z === 1) { f.style.left = box.offsetLeft + 'px'; f.style.top = box.offsetTop + 'px'; f.style.width = box.offsetWidth + 'px'; f.style.height = box.offsetHeight + 'px'; }
else { var bq = rectNoTf(box), vq = veil.getBoundingClientRect(); f.style.left = (bq.left - vq.left + veil.scrollLeft) + 'px'; f.style.top = (bq.top - vq.top + veil.scrollTop) + 'px'; f.style.width = bq.width + 'px'; f.style.height = bq.height + 'px'; }
if (m) place(box, m);
}
/* the panel rises 14px into place over 0.9 s; measure again once it has settled */
var lastK = '', same = 0, t0 = Date.now();
(function settle() {
if (!box.isConnected) return;
var q = rectNoTf(box), k = [q.left, q.top, q.width, q.height].map(Math.round).join(',');
if (k === lastK) same++; else { same = 0; lastK = k; }
if (same >= 2 || Date.now() - t0 > 1600) { fit(); if (m) box.style.backgroundImage = img; } else setTimeout(settle, 120);
})();
fit(); setTimeout(fit, 1000); live = fit; box._dssDecoFit = fit; /* the panel fit calls it when it changes the zoom */
if (window.ResizeObserver) new ResizeObserver(fit).observe(box);
}
setInterval(function() {
Array.prototype.forEach.call(document.querySelectorAll('tw-story > .dss-threshold'), function(v) { if (!v._dssDeco && v._pass) decorate(v); });
}, 150);
window.addEventListener('resize', function() { if (live) live(); });
return { motifs: MOTIFS, image: image };
})();

// ====== THE REVEAL — every clickable shows itself, named, for a few seconds (2026-10-05) ======
// Sam: "the clickable things in the 3d renders aren't very obvious. In Disco Elysium they are much more
// obvious. I want it more like that." So when the words are sent away, and again on a tap on empty room,
// every object with a choice or a look shows a small ring with its name beside it (the name its card
// already carries), holds, then fades back to the resting glow. Names only while the reveal lasts.
// 2026-10-05: the hint used to come up 2.6 s after the room was built, behind the entry modal where
// nobody saw it (the tighten pass's second recommendation). Now it waits for the words to be sent away
// and shows a moment after the reveal's rings; a room that opens without words shows it as before.
window.dssRoomHint = function(wrap, hint, peak) {
var shown = false, t1 = null, t2 = null;
function show() {
if (shown) return; shown = true;
t1 = setTimeout(function() { hint.style.opacity = String(hint.dataset.keep ? 0.95 : (peak == null ? 0.6 : peak)); }, 900);
t2 = setTimeout(function() { if (!hint.dataset.keep) hint.style.opacity = '0'; }, 7300);
}
wrap.addEventListener('dss-room-words-away', show);
// a room that opens without words (nothing to send away) shows the hint 2.6 s after its first frame;
// the first frame itself can be seconds away on a night's first room, so the wait starts from it
var born = null, poll = setInterval(function() {
var st = wrap.dataset.words;
if (!wrap.isConnected) { clearInterval(poll); return; }
if (!st) return;
if (born === null) born = Date.now();
if (st === 'modal') { clearInterval(poll); return; }
if (Date.now() - born > 2600) { clearInterval(poll); show(); }
}, 300);
return { show: show };
};

window.dssRoomReveal = function(wrap, camera, glows, idle) {
var layer = document.createElement('div'); layer.className = 'dss-room-reveal'; wrap.appendChild(layer);
var marks = glows.map(function(g) {
var m = document.createElement('div'); m.className = 'dss-room-mark dss-room-mark-free';
var ring = document.createElement('i'); var name = document.createElement('span'); name.textContent = g.spot.label || g.spot.name || ''; /* 2026-10-19 overnight: the label (WAY OUT) as the hover, card and keys show it */
var lead = document.createElement('b'); lead.className = 'dss-room-lead';
m.appendChild(lead); m.appendChild(ring); m.appendChild(name); layer.appendChild(m);
return { g: g, el: m, ring: ring, name: name, lead: lead, shown: true };
});
var until = 0, shown = false, v = new THREE.Vector3();
function show(ms) { until = performance.now() + (ms || 4200); }
wrap.addEventListener('dss-room-words-away', function() { show(4800); });
wrap.addEventListener('dss-room-emptytap', function() { show(3200); });
function tick() {
var on = idle() && performance.now() < until;
if (on !== shown) { shown = on; layer.classList.toggle('dss-room-reveal-on', on); }
if (!on) return;
var w = wrap.clientWidth, h = wrap.clientHeight;
marks.forEach(function(m) {
var vis = !!m.g.on;
if (vis) { v.copy(m.g.sp.position).project(camera); vis = v.z < 1 && Math.abs(v.x) < 1.02 && Math.abs(v.y) < 1.02; }
if (vis !== m.shown) { m.shown = vis; m.el.style.display = vis ? '' : 'none'; }
if (vis) { m.x = (v.x + 1) / 2 * w; m.y = (1 - v.y) / 2 * h; }
});
// names that would print over one another step down a line, left to right, so each stays legible;
// 2026-10-11 (phone check): a mark is slid in from the screen's edge so its name is never cut off, and on a
// narrow screen the step between lines is wider (the mark is centred on its object, ring and name together)
// 2026-10-14 (Sam: "the circle should be on the thing the label names"): every ring stays on its object; the name
// sits beside it, and where names would crowd, a name moves to the nearest clear line (up or down, or to the other
// side of its ring) with a thin leader back to the ring. No name is printed over another name or another ring.
var shownM = marks.filter(function(m) { return m.shown; });
var placed = shownM.map(function(m) { return { l: m.x - 9, t: m.y - 9, r: m.x + 9, b: m.y + 9, own: m }; }); // the rings
var step = w < 480 ? 20 : 17, OFFS = [0, 1, -1, 2, -2, 3, -3, 4, -4];
shownM.sort(function(a, b) { return a.x - b.x; }).forEach(function(m) {
m.ring.style.left = (m.x - 7).toFixed(1) + 'px'; m.ring.style.top = (m.y - 7).toFixed(1) + 'px';
var NW = m.name.offsetWidth || 90, NH = 14, best = null, i, side, k, nx, ny, rect;
for (i = 0; i < OFFS.length && !best; i++) for (side = 0; side < 2 && !best; side++) {
k = OFFS[i];
nx = (side === 0) === (m.x + 14 + NW <= w - 4) ? m.x + 14 : m.x - 14 - NW; // the right of the ring first, unless it runs off
if (nx < 4) nx = 4; if (nx + NW > w - 4) nx = w - 4 - NW;
ny = m.y + k * step;
rect = { l: nx - 3, t: ny - NH / 2 - 2, r: nx + NW + 3, b: ny + NH / 2 + 2 };
if (rect.t < 2 || rect.b > h - 2) continue;
if (!placed.some(function(o) { return rect.l < o.r && rect.r > o.l && rect.t < o.b && rect.b > o.t; })) best = { nx: nx, ny: ny, k: k, rect: rect }; // its own ring too: a name squeezed by the screen's edge never covers its ring
}
if (!best) best = { nx: Math.min(w - 4 - NW, m.x + 14), ny: m.y, k: 0, rect: { l: 0, t: 0, r: 0, b: 0 } };
placed.push(best.rect);
m.name.style.left = best.nx.toFixed(1) + 'px'; m.name.style.top = (best.ny - NH / 2).toFixed(1) + 'px';
// the leader: from the ring's edge to the near end of the name, only when the name has left the ring's side
var ex = Math.max(best.nx - 3, Math.min(best.nx + NW + 3, m.x)), ey = (ex > best.nx - 3 && ex < best.nx + NW + 3) ? best.ny + (m.y > best.ny ? NH / 2 + 1 : -NH / 2 - 1) : best.ny, dx = ex - m.x, dy = ey - m.y, len = Math.sqrt(dx * dx + dy * dy); // to the name's nearest edge
if (best.k !== 0 || len > 22) { var a = Math.atan2(dy, dx); m.lead.style.display = 'block'; m.lead.style.left = (m.x + Math.cos(a) * 8).toFixed(1) + 'px'; m.lead.style.top = (m.y + Math.sin(a) * 8).toFixed(1) + 'px'; m.lead.style.width = Math.max(0, len - 8).toFixed(1) + 'px'; m.lead.style.transform = 'rotate(' + a.toFixed(3) + 'rad)'; }
else m.lead.style.display = 'none';
});
}
return { tick: tick, show: show };
};

// The object's name, faint, beside the pointer while it rests on something that can be looked at.
// A trace rather than a label: Courier, letterspaced, low alpha, gone the moment the pointer leaves.
window.dssRoomHoverName = function(wrap) {
var el = document.createElement('div');
el.className = 'dss-room-hovername';
wrap.appendChild(el);
var shown = null;
wrap.addEventListener('pointerdown', function() { if (shown !== null) { shown = null; el.style.opacity = '0'; } }, true);
return function(name, ev, at) {
if (!name || !ev) { if (shown !== null) { shown = null; el.style.opacity = '0'; } return; }
if(at && (at.z < -1 || at.z > 1)){shown=null;el.style.opacity='0';return;}
var r=wrap.getBoundingClientRect();
if(shown!==name){shown=name;el.textContent=name;el.style.opacity='1';}
el.style.maxWidth=Math.max(40,r.width-16)+'px';
var width=el.offsetWidth,height=el.offsetHeight;
var x=at?at.x-width/2:ev.clientX-r.left+16;
var y=at?at.y-16-height:ev.clientY-r.top+20;
if(at && y<8)y=at.y+20;
x=Math.max(8,Math.min(r.width-width-8,x));y=Math.max(8,Math.min(r.height-height-8,y));
el.style.left=x+'px';el.style.top=y+'px';el.style.transform='none';
};
};

// >>>> DSS GHOST TEX BEGIN
// The people in the rooms, as traces. One drawing for all ten rooms: a figure built from a head, a neck,
// sloped shoulders, a torso and arms, legs or a lap, with a posture picked by the seed; drawn as a soft
// aura, a faint core, a rim of lamplight down one side, a hollow chest and a slipped after-image, grained
// like film and dissolving towards the floor. `tex(w, h, draw)` and `rnd(seed)` are the room's own helpers.
window.dssGhostTex = function(tex, rnd, seed, seated, bright, tint) {
return tex(192, 384, function(cx, w, h) {
var r = function(k) { return rnd(seed + k); };
var col = tint || (bright ? [255, 236, 204] : [228, 214, 186]);
var C = function(a) { return 'rgba(' + col[0] + ',' + col[1] + ',' + col[2] + ',' + a + ')'; };
var hx = 96 + (r(0) - 0.5) * 14, hy = seated ? 118 : 76, hr = 16 + r(1) * 5;
var lean = (r(2) - 0.5) * 0.16, tilt = (r(3) - 0.5) * 0.3, pose = Math.floor(r(4) * 4);
var sw = 46 + r(5) * 10, slope = 10 + r(6) * 10, slopeR = slope + (r(12) - 0.5) * 10, waist = sw * (0.72 + r(7) * 0.14), hip = sw * (0.86 + r(8) * 0.12);
var ny = hy + hr * 0.9, sy = ny + 16, wy = sy + 92, hy2 = wy + 36;
function body(k) {
// k is the copy: 0 the figure, 1 the after-image slipped a little
cx.save(); cx.translate(hx, sy); cx.rotate(lean * (k ? 1.35 : 1)); cx.translate(-hx, -sy);
if (k) cx.translate(6 + r(9) * 6, -3);
// torso and lap or legs, one closed path from the left shoulder round
cx.beginPath();
cx.moveTo(hx - sw / 2, sy + slope);
cx.quadraticCurveTo(hx - sw * 0.55, wy - 20, hx - waist / 2, wy);
if (seated) {
// thighs forward, foreshortened, knees high, the lower legs dropping away
cx.quadraticCurveTo(hx - hip / 2 - 4, wy + 10, hx - hip * 0.78, wy + 30);
cx.quadraticCurveTo(hx - hip * 0.86, wy + 52, hx - hip * 0.62, wy + 66);
cx.lineTo(hx - hip * 0.5, h); cx.lineTo(hx - 6, h); cx.lineTo(hx - 4, wy + 72); cx.lineTo(hx + 4, wy + 72); cx.lineTo(hx + 6, h); cx.lineTo(hx + hip * 0.5, h);
cx.lineTo(hx + hip * 0.62, wy + 66);
cx.quadraticCurveTo(hx + hip * 0.86, wy + 52, hx + hip * 0.78, wy + 30);
cx.quadraticCurveTo(hx + hip / 2 + 4, wy + 10, hx + waist / 2, wy);
} else {
cx.quadraticCurveTo(hx - hip / 2 - 2, hy2 - 10, hx - hip / 2, hy2);
cx.lineTo(hx - hip / 2 + 2, h); cx.lineTo(hx - 4, h); cx.lineTo(hx - 2, hy2 + 50); cx.lineTo(hx + 2, hy2 + 50); cx.lineTo(hx + 4, h); cx.lineTo(hx + hip / 2 - 2, h);
cx.lineTo(hx + hip / 2, hy2);
cx.quadraticCurveTo(hx + hip / 2 + 2, hy2 - 10, hx + waist / 2, wy);
}
cx.quadraticCurveTo(hx + sw * 0.55, wy - 20, hx + sw / 2, sy + slopeR);
// shoulders up over the neck
cx.quadraticCurveTo(hx + sw * 0.3, sy - 6, hx + 9, ny);
cx.lineTo(hx - 9, ny);
cx.quadraticCurveTo(hx - sw * 0.3, sy - 6, hx - sw / 2, sy + slope);
cx.closePath(); cx.fill();
// arms: 0 hanging, 1 one hand raised (a glass, a cigarette), 2 folded or on the bar, 3 one hand to the face
cx.lineCap = 'round'; cx.lineWidth = 13 + r(10) * 3;
var ax = hx - sw / 2 + 4, bx = hx + sw / 2 - 4, ay = sy + slope + 2, by = sy + slopeR + 2;
cx.beginPath();
if (pose === 0) { cx.moveTo(ax, ay); cx.quadraticCurveTo(ax - 10, ay + 50, ax - 6, ay + 104); cx.moveTo(bx, by); cx.quadraticCurveTo(bx + 10, by + 50, bx + 6, by + 104); }
else if (pose === 1) { cx.moveTo(ax, ay); cx.quadraticCurveTo(ax - 10, ay + 50, ax - 6, ay + 104); cx.moveTo(bx, ay); cx.quadraticCurveTo(bx + 22, ay + 40, bx + 2, ay + 64); cx.lineTo(hx + 12, hy + hr * 0.6); }
else if (pose === 2) { cx.moveTo(ax, ay); cx.quadraticCurveTo(ax - 12, ay + 46, ax + 10, ay + 78); cx.lineTo(bx - 10, ay + 74); cx.moveTo(bx, ay); cx.quadraticCurveTo(bx + 12, ay + 46, bx - 10, ay + 74); }
else { cx.moveTo(ax, ay); cx.quadraticCurveTo(ax - 20, ay + 44, ax + 2, ay + 60); cx.lineTo(hx - 10, hy + hr * 0.5); cx.moveTo(bx, ay); cx.quadraticCurveTo(bx + 10, ay + 50, bx + 6, ay + 104); }
cx.stroke();
// the head, a little tilted, with the neck
cx.save(); cx.translate(hx, hy); cx.rotate(tilt);
cx.beginPath(); cx.ellipse(0, 0, hr * 0.86, hr, 0, 0, 6.3); cx.fill();
cx.beginPath(); cx.rect(-7, hr * 0.5, 14, hr * 0.7); cx.fill();
cx.restore();
cx.restore();
}
// 1. the aura: the whole figure, wide and soft
try { cx.filter = 'blur(10px)'; } catch (e) {}
cx.fillStyle = C(bright ? 0.3 : 0.22); cx.strokeStyle = C(bright ? 0.3 : 0.22); body(0);
// 2. the after-image, slipped, soft
try { cx.filter = 'blur(4px)'; } catch (e) {}
cx.fillStyle = C(0.16); cx.strokeStyle = C(0.16); body(1);
// 3. the core, nearly sharp
try { cx.filter = 'blur(1.2px)'; } catch (e) {}
cx.fillStyle = C(bright ? 0.8 : 0.56); cx.strokeStyle = C(bright ? 0.8 : 0.56); body(0);
try { cx.filter = 'none'; } catch (e) {}
// 4. hollow the chest and the middle so the figure reads as a shell, a trace, not a solid
cx.globalCompositeOperation = 'destination-out';
var hol = cx.createRadialGradient(hx, sy + 46, 4, hx, sy + 46, 46); hol.addColorStop(0, 'rgba(0,0,0,0.42)'); hol.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = hol; cx.fillRect(0, 0, w, h);
var hh = cx.createRadialGradient(hx, hy, 2, hx, hy, hr * 0.8); hh.addColorStop(0, 'rgba(0,0,0,0.3)'); hh.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = hh; cx.fillRect(0, 0, w, h);
// 5. the rim of lamplight: the figure again, brighter, kept only along one edge
cx.globalCompositeOperation = 'source-over';
var side = r(11) < 0.5 ? -1 : 1;
var rimC = document.createElement('canvas'); rimC.width = w; rimC.height = h; var rx = rimC.getContext('2d');
var save = cx; cx = rx;
try { cx.filter = 'blur(1px)'; } catch (e) {}
cx.fillStyle = C(1); cx.strokeStyle = C(1); body(0);
try { cx.filter = 'none'; } catch (e) {}
cx.globalCompositeOperation = 'destination-out';
try { cx.filter = 'blur(1.5px)'; } catch (e) {}
cx.fillStyle = 'rgba(0,0,0,1)'; cx.strokeStyle = 'rgba(0,0,0,1)'; cx.save(); cx.translate(side * 8, 3); body(0); cx.restore();
try { cx.filter = 'none'; } catch (e) {}
var lg = cx.createLinearGradient(hx - side * 60, 0, hx + side * 60, 0); lg.addColorStop(0, 'rgba(0,0,0,1)'); lg.addColorStop(0.5, 'rgba(0,0,0,0.4)'); lg.addColorStop(1, 'rgba(0,0,0,0)');
cx.fillStyle = lg; cx.fillRect(0, 0, w, h);
cx = save;
cx.globalAlpha = 1; cx.drawImage(rimC, 0, 0); cx.globalAlpha = 1;
// 6. grain, so it sits in the film of the room
cx.globalCompositeOperation = 'destination-in';
var gr = cx.createImageData(w, h), d = gr.data, s = seed * 977 + 13;
for (var i = 0; i < d.length; i += 4) { s = (s * 1103515245 + 12345) & 0x7fffffff; d[i + 3] = 200 + (s >> 16) % 56; d[i] = d[i + 1] = d[i + 2] = 255; }
var grC = document.createElement('canvas'); grC.width = w; grC.height = h; grC.getContext('2d').putImageData(gr, 0, 0);
cx.drawImage(grC, 0, 0);
// 7. dissolve towards the floor
cx.globalCompositeOperation = 'destination-out';
var g = cx.createLinearGradient(0, 0, 0, h); g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(seated ? 0.42 : 0.3, 'rgba(0,0,0,0.05)'); g.addColorStop(seated ? 0.72 : 0.62, 'rgba(0,0,0,0.45)'); g.addColorStop(seated ? 0.92 : 0.86, 'rgba(0,0,0,0.9)'); g.addColorStop(1, 'rgba(0,0,0,1)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
cx.globalCompositeOperation = 'source-over';
});
};
// <<<< DSS GHOST TEX END

// >>>> DSS VOICES BEGIN
// ====== INNER VOICES — what every room object says (2026-10-07) ======
// Sam (2026-10-07): "in e.g. Inis's shop, most of the clickable nodes give you nothing. I want them
// all to give something when you click." Then: "I NEED TO DO INTERNAL DIALOGUE." Two voices: you NOW,
// and you THEN (the idealised you: the child, and the imagined future); sometimes the ID, dark and
// destructive. Objects connect two ways: TRAILS (a short chain of objects whose voices lead to a dream
// key, the key itself the trail's last object) and CALLBACKS (an object speaks differently once you
// have looked at a certain other object, in any room).
// EVERY LINE IS SAM'S TO WRITE. A line still holding '[Sam:' shows pink; once rewritten it takes its
// voice's own colour and type (cast, below). Leave a line '' to keep that voice quiet on that object.
// Which line wins, per voice: the trail's line, then a callback's, then the object's own.
// WHO SPEAKS (Sam, 2026-10-21: "show both"): EVERY voice with a line speaks, in voice order, on every look.
// THE PRIME and THE OLDBOY share the card, so a pair written as an exchange (the optics, the glass) lands as
// one; THE THIRST joins them when its gate (idWhen) is met. Until 2026-10-21 one voice spoke per look (THE
// THIRST alone when awake, else THE PRIME and THE OLDBOY by turns across entries, the opener drawn at random
// and kept): that served the pairs as solos on different visits, so it went, with its storage
// ('dssVoicesTurns', 'dssVoicesOpen'). An object marked chorus (the cow, Sam 2026-10-11) is the same but is
// never used up, and THE THIRST speaks on it whether awake or not.
// USED UP (Sam, 23:24): "once all the voices are used up if there is no reason to allow a return it
// should just not be clickable anymore." Every line spoken is remembered (localStorage
// 'dssVoicesSpoken'); when an object has nothing left to say (its own lines, any trail or callback
// line it could still come to, the thirst's only while the thirst is awake) and no choice to press,
// the room stops offering it: no halo, no glow, no card, no keyboard button. spent(room, name).
// What has been seen is kept in this browser across nights (localStorage 'dssVoicesSeen'), like the
// gifts. window.dssVoices.forget() clears it. ?dev=1 adds a 'Forget the voices' button to the dev panel.
window.DSS_VOICES = {
// who speaks, and how each looks once its words are written. label: the voice's name, printed small
// in capitals before each of its lines, as Disco Elysium names its voices (Sam's names, 2026-10-07:
// THE MAN, THE BOY, THE THIRST; since 2026-10-11 THE PRIME, THE OLDBOY, THE THIRST); '' would show the dot alone. about: one line saying who the voice
// is, shown under its name the FIRST time it ever speaks in this browser, then never again
// (localStorage 'dssVoicesMet'; forget() clears it too). Sam's to write; pink until then.
// css: the voice on the dark card (a phone). ink: the same voice on the parchment box beside the object
// (Sam, 23:41: "parchment colour like the side instructions are, so it really stands out").
cast: {
now:  { label: 'THE PRIME', about: 'That is, you, here and tonight. THE PRIME speaks with the first voice in your head.', mark: 'rgba(215,220,230,0.75)', css: 'color:rgba(232,226,210,0.95);', ink: 'color:#2a2118;' },
then: { label: 'THE OLDBOY', about: 'The voice of THE OLDBOY’S younger than you are, but he speaks to you from both your past and future. He is the second voice you carry in you. He speaks from the unformed world you had, and from the big dark mirror in the future.', mark: 'rgba(232,196,120,0.9)',  css: 'color:rgba(236,214,160,0.95);font-style:italic;', ink: 'color:#6b4a12;font-style:italic;' },
id:   { label: 'THE THIRST', about: 'You only hear this voice in the bad times. Be wary of it, listen to it hard; it tells you plainly what you really want.', mark: 'rgba(190,40,40,0.95)',   css: 'color:rgba(222,96,84,0.96);letter-spacing:0.4px;', ink: 'color:#9a1f1f;letter-spacing:0.4px;' }
},
// when the id breaks in: any one of these (sobriety and morale are the stat bars, 0-100;
// phase is the night: 0 before midnight, 1 after midnight, 2 small hours, 3 dawn awaits)
idWhen: { sobrietyBelow: 30, moraleBelow: 30, fromPhase: 2 },
// SWITCHES (each is one word to change). Sam's ruling 2026-10-07: callbacksBothWays ON, keyCardOneLine ON, mapMark off for now:
// callbacksBothWays: a callback also speaks back at its earlier object once the later one is seen
//   (its line: the callback's 'back', or a pink slot until written)
// mapMark: on the Dean Street map, a small warm dot by the door of a venue holding a trail's next step
// keyCardOneLine: a key's card shows only the key's own line, not the object's line above it
switches: { callbacksBothWays: true, mapMark: false, keyCardOneLine: true },
// DÉJÀ VU (Sam, 2026-10-11): one line per room. On a later night an object used up on an earlier night comes back
