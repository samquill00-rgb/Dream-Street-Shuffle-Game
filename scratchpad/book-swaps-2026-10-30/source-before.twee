  placeMesh(rightBuilding, new THREE.BoxGeometry(4.5, 0.04, 1.0), rdRoomMat, 5.5, 3.45, 0.0);
  // the light of a paper lamp on the back wall of each window, and shelves of jars
  var rdGlowTex = makeCanvasTexture(128, 128, function(cx, w, h) { var g = cx.createRadialGradient(w / 2, h * 0.4, 0, w / 2, h * 0.4, w * 0.55); g.addColorStop(0, 'rgba(255,120,70,0.85)'); g.addColorStop(0.45, 'rgba(200,60,40,0.4)'); g.addColorStop(1, 'rgba(120,30,20,0)'); cx.fillStyle = g; cx.fillRect(0, 0, w, h); });
  [4.3, 6.7].forEach(function(wx) {
