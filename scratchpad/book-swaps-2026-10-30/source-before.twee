    x.restore();
  }
  function drawOneThread(x, cx, cy, spec) {
    if (!spec.always && hubFlag(spec.flag) !== 'on') return;
    if (!doors[spec.id] || doors[spec.id].status !== 'open') return;
    var d = doorById(spec.id);
    if (!d) return;
    var path = routeToCecil(d);
    if (!path || path.length < 4) return;
    var n = path.length, col = spec.col, drawn = true; /* 2026-10-19 overnight: returns true when drawn, so the red route's sound waits for a real route */
    // the pulse travels away from the player, then rests before setting off again
    var head = (S.t * 0.5) % (n + 30);
    x.save();
    x.globalCompositeOperation = 'lighter';
    for (var i = 1; i < n; i++) {
      var px = path[i][0] * T + 8, py = path[i][1] * T + 8;
      if (px < cx - T || px > cx + W + T || py < cy - T || py > cy + VR * T + T) continue;
      var lead = head - i;
      var a = 0.10 + ((lead >= 0 && lead < 10) ? (1 - lead / 10) * 0.30 : 0);
      if (spec.always) a = Math.min(1, a * 2.2 + 0.08); // a slip's directions burn brighter than the errands' threads
      if (spec.strong) a = Math.min(1, a * 1.6 + 0.22);  // 2026-10-16: the red path to the person you chose to pitch to reads as a line, not a hint
      if (i < 4) a *= i / 4;                       // don't pool around the player's own feet
      if (n - i < 3) a += 0.08;                    // and gather a little at the mouth
