// Puddles on the wet street — just stopped raining, reflecting streetlamps and pub glow
var puddleMat = new THREE.MeshStandardMaterial({
  color: 0x111118, roughness: 0.05, metalness: 0.7, transparent: true, opacity: 0.4
});
var puddlePositions = [
  [1.5, 4.5, 2.2, 1.4],
  [-2, 5, 1.8, 1.0],
  [3, 7, 2.0, 1.2],
  [-1, 8.5, 2.8, 1.6],
  [4, 6, 1.4, 0.9],
  [-3.5, 6.5, 1.5, 0.8],
  [0.5, 9, 1.6, 1.0],
  [5, 8, 1.2, 0.7],
  [-4, 4.5, 1.0, 0.6]
];
for (var pi = 0; pi < puddlePositions.length; pi++) {
  var pp = puddlePositions[pi];
  var puddle = new THREE.Mesh(new THREE.CircleGeometry((pp[2] + pp[3]) / 4, 16), puddleMat);
  puddle.rotation.x = -Math.PI / 2;
  puddle.position.set(pp[0], 0.02, pp[1]);
  scene.add(puddle);
}

// Pavement puddles (smaller, closer to buildings)
