card.setAttribute('aria-label',roomObjectLabel(spot));
card.innerHTML = '<div class="dss-room-card-body" tabindex="0" role="region" aria-label="Object details">'+html+'</div>'+backHTML;
card.querySelector('.dss-room-back').addEventListener('click',function(ev){ev.stopPropagation();if(roomBlocked())return;byKey=openedByKey;stepBack();});
voicePrep(card.querySelector('.dss-voices'));
