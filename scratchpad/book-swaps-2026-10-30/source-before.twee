    if(outcomeKind!=='loss'){
      var halo=ctx.createRadialGradient(300,285,10,300,285,230);halo.addColorStop(0,'rgba(240,200,120,'+(.4*k)+')');halo.addColorStop(1,'rgba(240,200,120,0)');
      ctx.fillStyle=halo;ctx.fillRect(0,0,W,H);
    } else { ctx.fillStyle='rgba(4,9,10,'+(.38*k)+')';ctx.fillRect(0,0,W,H); }
  }
  function draw() {
