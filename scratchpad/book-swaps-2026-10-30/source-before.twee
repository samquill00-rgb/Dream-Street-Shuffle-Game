})();
// 2026-10-12 (Sam, the overnight list item 5): NEXT is redrawn after a click that stays on the same passage. A
// click on a link or a clickable hook, and the passage still the same a moment later, presses the footer's hidden
// "next-poke" link (Next Footer), which runs Next Redraw in place.
(function() {
  document.addEventListener('click', function(ev) {
    if (!ev.target || !ev.target.closest) return; // a room's object cards and strip press the real link by script, so untrusted clicks count too
    if (!ev.target.closest('tw-link, tw-enchantment, tw-hook, .enchantment-link, [data-raw]')) return;
    if (ev.target.closest('.next-poke, .bevan-waiting-clock, .bw-tick')) return;
    var gen = window._passageGen;
    setTimeout(function() {
      if (window._passageGen !== gen) return;
      var poke = document.querySelector('.next-poke tw-link');
      if (poke) poke.click();
    }, 160);
  }, true);
})();
// 2026-10-23 overnight (Sam, playtest at The Reclamation: "You should not need to scroll down here. In full screen laptop you should
// never need to scroll down"; the night's sweep at 1440x900 found the same in most of the minigames): when a passage holds a game
// canvas in the page's flow and the page runs past the window, the canvas (or the frame wrapped tight round it) is narrowed, keeping
// its shape, until the page fits, to no less than 55% of its size. Fullscreen ("Expand") and the 3D rooms are left alone.
(function() {
  var gen = -1, tries = 0, boxes = [];
  function inFlow(el) { for (var e = el; e && e.tagName !== 'TW-STORY'; e = e.parentElement) { var ps = getComputedStyle(e).position; if (ps === 'fixed' || ps === 'absolute' || ps === 'sticky') return false; if (e.tagName === 'TW-PASSAGE') return true; } return false; }
  function fit() {
    if (window._passageGen !== gen) { gen = window._passageGen; tries = 0; boxes = []; settle = Date.now() + 1600; /* the page leaving is still in the DOM for a moment */ var st0 = document.querySelector('tw-story'); if (st0 && st0._dssFitPad) { st0._dssFitPad = 0; st0.style.paddingBottom = ''; } }
    if (tries > 14 || document.fullscreenElement || Date.now() < settle) return; tries++;
    var over = document.scrollingElement.scrollHeight - window.innerHeight;
    if (over <= 4) return;
    var cvs = Array.prototype.filter.call(document.querySelectorAll('tw-passage canvas'), function(c) { var r = c.getBoundingClientRect(); return r.height > 220 && r.width > 220 && inFlow(c) && !c.closest('.soho-map-wrap'); }); /* not the Soho map: pixel art at its own scale */
    var dom = document.getElementById('dss-worm-game'); /* the worm hut's game is laid out in the page, not on a canvas */
    if (!cvs.length && !(dom && inFlow(dom))) return;
    cvs.sort(function(a, b) { return b.getBoundingClientRect().height - a.getBoundingClientRect().height; });
    var c = cvs.length ? cvs[0] : dom;
    /* first the slack under the game: the story's foot padding and the line breaks left after the game's block */
    var st = document.querySelector('tw-story'), top = c; while (top.parentElement && top.parentElement.tagName !== 'TW-PASSAGE') top = top.parentElement;
    if (st && !st._dssFitPad) { st._dssFitPad = 1; st.style.paddingBottom = '4px'; }
    for (var sib = top.nextElementSibling; sib; sib = sib.nextElementSibling) if ((sib.tagName === 'BR' || sib.tagName === 'TW-CONSECUTIVE-BR') && sib.style.display !== 'none') sib.style.display = 'none';
    over = document.scrollingElement.scrollHeight - window.innerHeight;
    if (over <= 4) return;
    if (c === dom) { /* CSS zoom scales its layout and its clicks together */
      var dh = dom.getBoundingClientRect().height, z0 = parseFloat(dom.style.zoom) || 1, z = Math.max(0.6, z0 * (dh - over - 6) / dh);
      if (z < z0 - 0.01) { if (dom._dssFit == null) { dom._dssFit = { zoom: dom.style.zoom }; boxes.push(dom); } dom.style.zoom = z.toFixed(3); settle = Date.now() + 500; }
