    ['jukebox', jukeboxClunk], ['bulb', filamentPing], ['globe', globeSpin], ['ladder', woodCreak], ['chesterfield', woodCreak],
    ['counter', woodKnock], ['table', woodKnock], ['range', gasHiss], ['plate', crockery], ['dish', crockery], ['cow', cowMooShort],
    ['photograph', pageRustle], ['book', pageRustle], ['menu', pageRustle], ['ticket', pageRustle], ['shelves', pageRustle],
    ['bell', doorShopBell], ['window', distantTraffic], ['stairs', flagstoneSteps], ['door', doorCreak]
  ];
  function spotSound(name) {
