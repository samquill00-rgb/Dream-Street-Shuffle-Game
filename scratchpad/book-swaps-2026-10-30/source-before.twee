    swayAmt: 0.8 + Math.random() * 2.0
  });
}

// ============================================================
// ANIMATION
// ============================================================
var clock = new THREE.Clock();

function glAnimate() {
  glAnimId = requestAnimationFrame(glAnimate);
  var t = glStill ? 9 : clock.getElapsedTime();

  // --- CAMERA BREATHING ---
  // Very subtle sway, like someone standing still on a cold night
  camera.position.x = cameraBase.x + Math.sin(t * 0.15) * 0.03;
  camera.position.y = cameraBase.y + Math.sin(t * 0.22) * 0.015;
  camera.position.z = cameraBase.z + Math.cos(t * 0.18) * 0.02;

  // --- HERO LAMP FLICKER ---
  // Ginger gaslight flicker — irregular, organic
  // 2026-10-24 (Sam, playtest: "In the 3d render for the Ginger Light everything is flashing strangely"): the old terms
  // (1.7, 4.3, 7.1, 11.3 per second, ±0.15) swung the lantern glass about fivefold several times a second; now a slow,
  // shallow breath around the same mean
  var flicker = 0.85
    + Math.sin(t * 0.9) * 0.035
    + Math.sin(t * 2.3) * 0.018
    + Math.sin(t * 5.1) * 0.005;
  gingerLight.intensity = 3.2 * flicker;
  gingerFill.intensity = 1.2 * flicker;
  gingerWash.intensity = 0.5 * flicker;
  downSpot.intensity = 2.0 * flicker;

  // Glow sprite pulses with the flicker
  gingerGlow.material.opacity = 0.7 + (flicker - 0.85) * 2;
  innerGlow.material.opacity = 0.8 + (flicker - 0.85) * 3;

  // Lantern glass emissive flicker
  gingerGlassMat.emissiveIntensity = 0.65 + (flicker - 0.85) * 3;

  // Puddle reflection emissive flicker
  heroReflect.emissiveIntensity = 0.02 + (flicker - 0.85) * 0.15;
  glGlint.material.opacity = 0.14 + (flicker - 0.85) * 0.9;

  // --- SECONDARY LAMP FLICKER ---
  for (var i = 1; i < lampLights.length; i++) {
    var lFlicker = 0.85 + Math.sin(t * (0.7 + i * 0.37)) * 0.03 + Math.sin(t * (1.9 + i * 0.6)) * 0.012; /* 2026-10-24: slowed with the hero lamp */
    lampLights[i].intensity = 0.3 * lFlicker;
  }

  // --- FOG DRIFT --- (held under reduced motion)
  for (var i = 0; i < (glStill ? 0 : fogSprites.length); i++) {
    var f = fogSprites[i];
    f.sway += f.swaySpeed;
    f.sprite.position.x = f.baseX + Math.sin(f.sway) * f.swayAmt;
    f.baseX += f.drift;
    if (f.baseX > 25) f.baseX = -20;
  }

  // --- CHIMNEY SMOKE --- (held under reduced motion)
  for (var i = 0; i < (glStill ? 0 : smokeSprites.length); i++) {
    var sm = smokeSprites[i];
    var sprite = sm.sprite;
    // Rise upward
    sprite.position.y += sm.rise;
    // Drift sideways with a gentle sway
    sprite.position.x = sm.baseX + Math.sin(sm.phase + t * 0.3) * 0.8;
    sprite.position.z = sm.baseZ + Math.cos(sm.phase + t * 0.2) * 0.3;
    // Grow as it rises
    var age = (sprite.position.y - sm.startY) / sm.maxHeight;
    var scale = sm.baseScale + age * 2.5;
    sprite.scale.set(scale, scale, 1);
    // Fade out as it rises
    sprite.material.opacity = Math.max(0, (1 - age) * 0.2);
    // Reset when too high
    if (sprite.position.y > sm.startY + sm.maxHeight) {
      sprite.position.y = sm.startY;
      sprite.position.x = sm.baseX + (Math.random() - 0.5) * 0.3;
    }
  }

  // --- THE GINGER CAT ---
  var catDt = Math.min(t - (window._glCatLastT || t), 0.1);
  window._glCatLastT = t;
  // Breath
  gingerCat.scale.y = 1 + Math.sin(t * 1.4) * 0.012;
  // Tail sweeps in slow figure strokes
  catTail.rotation.y = Math.sin(t * 0.35) * .035 + Math.sin(t * .9) * .01; /* 2026-10-24: wrapped round the paws now, so a slow stir rather than a sweep */
  catTail.rotation.x = Math.sin(t * .6) * .025;
  // Occasional slow head turn between street and phone box
  catState.headTurnT -= catDt;
  if (catState.headTurnT <= 0) {
    catState.headTarget = (Math.random() - 0.4) * 0.8;
    catState.headTurnT = 6 + Math.random() * 9;
  }
  catHead.rotation.y += (catState.headTarget - catHead.rotation.y) * Math.min(1, catDt * 2.2);
  // Blink: eyes wink out for a beat
  catState.blinkT -= catDt;
  if (catState.blinkT <= 0) {
    catState.blinkHold = 0.14;
    catState.blinkT = 3 + Math.random() * 5;
  }
  if (catState.blinkHold > 0) {
    catState.blinkHold -= catDt;
    eyeL.visible = eyeR.visible = false;
  } else {
    eyeL.visible = eyeR.visible = true;
  }

  // --- WARM GLASS PULSE ---
  warmGlass.emissiveIntensity = 0.34 + Math.sin(t * 0.6) * 0.06 + Math.sin(t * 1.9) * 0.03; // was 0.10 base — the lit rooms (and their swaying drinkers) were invisible

  // --- SILHOUETTE SWAY ---
  for (var i = 0; i < (glStill ? 0 : silhouettes.length); i++) {
    var s = silhouettes[i];
    s.swayPhase += s.swaySpeed * 0.016;
    var swayOffset = Math.sin(s.swayPhase) * s.swayAmt;
    s.mesh.position.y = s.baseY + Math.sin(s.swayPhase * 0.7) * 0.01;
    if (s.faceX) {
      s.mesh.position.z = s.baseZ + swayOffset;
    } else {
      s.mesh.position.x = s.baseX + swayOffset;
    }
  }

  // --- WINDOW GLOW ---
  winGlow1.intensity = 0.42 + Math.sin(t * 0.4) * 0.07;
  winGlow2.intensity = 0.28 + Math.sin(t * 0.7) * 0.05;

  if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
}


// ====== GAME NAVIGATION BUTTON ======
var approachBtn = document.createElement('div');
approachBtn.id = 'approach-btn';
approachBtn.textContent = 'APPROACH THE GINGER LIGHT';
approachBtn.style.cssText = [
  'position:fixed',
  'bottom:60px',
  'left:50%',
  'transform:translateX(-50%)',
  'font:13px "Courier New",monospace',
  'color:rgba(232,120,24,0.85)',
  'letter-spacing:4px',
  'cursor:pointer',
  'padding:12px 28px',
  'border:1px solid rgba(232,120,24,0.3)',
  'background:rgba(0,0,0,0.4)',
  'z-index:100',
  'white-space:nowrap',
  'opacity:0',
  'transition:opacity 1.5s ease'
].join(';');

if (!glTitleHost) glWrap.appendChild(approachBtn);

// Fade in after a brief pause
setTimeout(function() { approachBtn.style.opacity = '1'; }, 1500);

approachBtn.addEventListener('mouseenter', function() {
  this.style.color = 'rgba(255,160,50,0.95)';
  this.style.borderColor = 'rgba(232,120,24,0.6)';
});
approachBtn.addEventListener('mouseleave', function() {
  this.style.color = 'rgba(232,120,24,0.85)';
  this.style.borderColor = 'rgba(232,120,24,0.3)';
});

approachBtn.addEventListener('click', function() {
  // Fade out
  glWrap.style.transition = 'opacity 1.2s ease';
  glWrap.style.opacity = '0';
  setTimeout(function() {
    if (glAnimId) cancelAnimationFrame(glAnimId);
    glAnimId = null;
    if (glWrap.parentNode) glWrap.parentNode.removeChild(glWrap);
    var TARGET = 'At the Corner of Dean Street and Greek Street';
    if (window.Engine && Engine.go) { Engine.go(TARGET); }
    else {
      var links = document.querySelectorAll('tw-link, .enchantment-link');
      for (var i = 0; i < links.length; i++) {
        if (links[i].textContent.trim() === '\u00b7') { links[i].click(); break; }
      }
    }
  }, 1200);
});

if (glTitleHost) { var glL = document.getElementById('dst-light'); if (glL && glL.parentNode === glTitleHost) glTitleHost.insertBefore(glWrap, glL); else glTitleHost.appendChild(glWrap); glTitleHost.classList.add('dss-title-3d'); setTimeout(function() { glWrap.classList.add('gl-in'); }, 80); }
else document.body.appendChild(glWrap);
glAnimate();
}

// Watch for ga-container
setInterval(function() {
var container = document.getElementById('ga-container');
if (container && !glActive) {
initGingerLight();
} else if (!container) {
glActive = false;
if (glAnimId) { cancelAnimationFrame(glAnimId); glAnimId = null; }
window._dssDisposeWrap('gl-wrap');
}
}, 300);
})();


// ====== SOHO SQUARE — THE HUT, ITS FIRE AND AFTERIMAGE ======
// A disposable 2D last frame bridges the two text exits; no WebGL context survives.
window.dssFireTrace = function(renderer, render, seconds) {
  var old=document.getElementById('dss-fire-trace');if(old)old.remove();
  var trace=document.createElement('canvas');trace.id='dss-fire-trace';
  trace.width=renderer.domElement.width;trace.height=renderer.domElement.height;
  try{render();trace.getContext('2d').drawImage(renderer.domElement,0,0);}catch(e){return;}
  trace.setAttribute('aria-hidden','true');
