'JEFFREY BERNARD': { now: 'JEFFREY BERNARD is trying to remember your name.', then: 'JEFFREY BERNARD is still here.' },
'JEFFREY BERNARD’S glass': { now: 'What\'s that beneath his glass?', then: 'To meet your heroes looks like carelessness.',
