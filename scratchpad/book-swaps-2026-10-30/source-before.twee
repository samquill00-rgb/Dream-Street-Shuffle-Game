  { id:'ginger',   c:19, r:26, fc:19, fr:26, name:'THE GINGER LIGHT',           label:'The Ginger Light',  col:[232,134,42],  rx:/See who|Ginger Light/i, spot:true },
  { id:'north',    c:17, r:0,  fc:17, fr:0,  name:'CENTRE POINT',               label:'Centre Point',      col:[226,178,148], rx:/Head towards dawn|dawn is coming|Give up on the night/i, spot:true, lc:18, lr:1.2 }, // 2026-10-16: the gate in the top edge spans tiles 17 and 18; the plate is centred on it, just inside the map
  { id:'phonebox',  c:19, r:22, fc:19, fr:22, name:'THE PHONE BOX',    label:'', col:[196,60,52],   rx:/^The phone box$/i,   spot:true, event:true },
  // Strangers at the edges (2026-09-24, Sam): each dream world leaves someone on a corner of the
