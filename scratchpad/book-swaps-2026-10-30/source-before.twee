    var sox = 0, soy = 0; if (nl && nd < (6*T)*(6*T)) { var dl = Math.sqrt(nd) || 1; sox = -(nl.c*T + 8 - fx) / dl * 3; soy = -(nl.r*T + 3 - fy) / dl * 2; }
