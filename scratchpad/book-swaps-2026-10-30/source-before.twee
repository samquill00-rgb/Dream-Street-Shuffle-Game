(link: "Hand him page 93 (found on an earlier night)")[(set: $hasMissingPage to true)(set: $visitedCarthage to true)<!-- 2026-10-29 nightwork, played live: the skip left $visitedCarthage false, which keeps the voices' key trails shut all night and drops a line from SHANA's reading; the page was found in Carthage on an earlier night, so the night counts it as visited -->(go-to: "Return the page")]</span><script>(function(){ try { if (localStorage.getItem('dssPage93Done') === '1') { var e = Array.prototype.filter.call(document.querySelectorAll('.dss-skip93'), function(x){ return !x.closest('.dss-ghost'); }).pop(); if (e) e.hidden = false; } } catch (err) {} })();</script>

