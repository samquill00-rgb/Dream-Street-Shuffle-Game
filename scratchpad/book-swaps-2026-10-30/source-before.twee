    swaySpeed: 0.0005 + Math.random() * 0.002,
    swayAmt: 1.0 + Math.random() * 2.0
  });
}

// ============================================================
// ANIMATION LOOP
// ============================================================
var clock = new THREE.Clock();

function phAnimate() {
  phAnimId = requestAnimationFrame(phAnimate);
  var t = phStill ? 14 : clock.getElapsedTime();
  phThisT = t; t = t + phCarryT;
  phWaterTime.value = t;

  // Fog drift (held still under reduced motion)
  for (var i = 0; i < (phStill ? 0 : fogSprites.length); i++) {
    var f = fogSprites[i];
    f.sway += f.swaySpeed;
    f.sprite.position.x = f.baseX + Math.sin(f.sway) * f.swayAmt;
    f.baseX += f.drift;
    // Wrap fog that drifts too far
    if (f.baseX > 25) f.baseX = -25;
  }

  // Flickering pub lights
  for (var i = 0; i < lampLightsOnPub.length; i++) {
    var ll = lampLightsOnPub[i];
    if (ll.userData.dead) { ll.intensity = 0; continue; }
    ll.intensity = ll.userData.baseIntensity + Math.sin(t * 3 + i) * 0.08 + Math.sin(t * 7.3 + i * 2) * 0.04;
  }

  // Street lamp flicker (dual-frequency for naturalistic gas flicker)
  for (var i = 0; i < streetLampLights.length; i++) {
    if (streetLampLights[i].userData.dead) { streetLampLights[i].intensity = 0; continue; }
    var base = streetLampLights[i].userData.baseIntensity || 3;
    streetLampLights[i].intensity = base + Math.sin(t * 2.5 + i * 1.5) * 0.15 + Math.sin(t * 5.7 + i * 3) * 0.08;
  }

  // Pub interior glow pulse
  pubGlow.intensity = 1.2 + Math.sin(t * 1.5) * 0.18;
  pubGlow2.intensity = 0.6 + Math.sin(t * 1.8 + 0.5) * 0.1;
  pubGlow3.intensity = 0.35 + Math.sin(t * 2.0 + 1.0) * 0.06;
  doorLight.intensity = 0.8 + Math.sin(t * 2.2) * 0.12;
  pavementSpill.intensity = 0.3 + Math.sin(t * 1.2) * 0.05;
  phSheen.material.opacity = 0.095 + Math.sin(t * 1.5) * 0.02 + Math.sin(t * 3.7 + 1) * 0.008;

  // The flood — two sources only: the blocked drain in the road, and the
  // passage. The storm is coming; Carthage is close behind it.
  var flP = Math.min(1, t / 20);
  flP = flP * flP * (3 - 2 * flP);
  // Main spread over 20s as before, then a permanent slow creep (log) —
  // the flood never finishes, it just stops hurrying
  // Growth is LINEAR and endless — the boundaries in phSpreadVerts are
  // what slow it down, so it presses harder forever rather than stopping
  var flG = 0.15 + flP * 3.55 + 0.085 * Math.max(0, t - 18);
  // 2026-10-29 (Sam): fill the street, then overtop the kerb and door.
  // One rising level across both sources; carried time preserves it on return.
  var phRise = Math.max(0, Math.min(1, (t - 20) / 100));
  phRise = phRise * phRise * (3 - 2 * phRise);
  var phLevel = 0.02 + 0.52 * phRise;
  phFlood.position.y = phLevel;
  phDeepPool.position.y = phLevel + 0.004;
  phCrown.position.y = phLevel + 0.008;
  phAlleyPool.position.y = phLevel + 0.002;
  phAlleyInner.position.y = Math.max(0.035, phLevel);
  phAlleyStream.position.y = Math.max(0.158, phLevel + 0.001);
  phRip.forEach(function(ripple) { ripple.position.y = phLevel + 0.006; });
  phSpreadVerts(phFlood, flG, t, 0, 3.15 + phRise * 1.8);
  phSpreadVerts(phFloodDamp, flG * 1.18, t, 2.1, 3.35);
  phFlood.material.opacity = 0.55 + flP * 0.22 + Math.sin(t * 2.6) * 0.04;
  // The deep core: SMALL, ROUND, and capped. It is the source puddle, not
  // a sheet — the moment it elongates or keeps growing, its smooth scaled
  // edge becomes a dark straight line at the grate (that exact bug shipped
  // and was caught by Dr Quill; the big vertex-driven pool alone does the
  // spreading).
  var dpP = Math.min(1, t / 8);
  dpP = dpP * dpP * (3 - 2 * dpP);
  var dpR = (0.2 + dpP * 0.72) * (1 + 0.045 * Math.sin(t * 1.3) + 0.03 * Math.sin(t * 2.9));
  phDeepPool.scale.set(dpR * 1.12, dpR, 1);
  phDeepPool.material.opacity = 0.42 + dpP * 0.28;
  var crownAmp = 1 + 0.6 * Math.min(Math.max(phVisit - 1, 0), 5);
  var crownPulse = 1 + 0.13 * crownAmp * Math.sin(t * 5.1) + 0.06 * crownAmp * Math.sin(t * 8.7);
  phCrown.scale.set(0.46 * crownPulse, 0.64 * crownPulse, 1);
  phCrown.material.opacity = 0.5 + 0.22 * Math.min(1, t / 4) + 0.12 * Math.sin(t * 5.1);
  phCrown.material.emissiveIntensity = 0.22 + 0.2 * crownAmp * (0.5 + 0.5 * Math.sin(t * 5.1));

  // Water from the passage: advances INSIDE the alley from the dark,
  // reaches the mouth, then fans out across the pavement with a rounded
  // front and a second pool spreads in the gutter
  var aiP = Math.min(1, t / 7);
  aiP = aiP * aiP * (3 - 2 * aiP);
  var aiLen = aiP * 3.5;
  if (aiLen > 0.02) {
    phAlleyInner.scale.set(0.9 + aiP * 0.9 + Math.sin(t * 2.1) * 0.03, aiLen, 1);
    phAlleyInner.position.z = -3 + aiLen / 2;
    phAlleyInner.material.opacity = 0.45 + aiP * 0.25 + Math.sin(t * 3.1) * 0.05;
  }
  var alP = Math.max(0, Math.min(1, (t - 5) / 14));
  alP = alP * alP * (3 - 2 * alP);
  var alLen = alP * 2.9 + 0.5 * Math.tanh(Math.max(0, t - 19) / 70);
  if (alLen > 0.02) {
    phAlleyStream.scale.set(0.7 + alP * 1.0 + Math.sin(t * 1.9) * 0.03, alLen, 1);
    phAlleyStream.material.opacity = 0.5 + alP * 0.2 + Math.sin(t * 2.9) * 0.04;
  }
  var agP = Math.max(0, Math.min(1, (t - 9) / 18));
  agP = agP * agP * (3 - 2 * agP);
  var agR = agP * 2.1 + 2.6 * Math.tanh(Math.max(0, t - 27) / 110);
  if (agR > 0.02) {
    phAlleyPool.scale.set(agR * 1.1, agR, 1);
    phAlleyPool.material.opacity = 0.5 + agP * 0.2 + Math.sin(t * 2.3 + 1) * 0.04;
  }
  // Local +y points towards the pub (-world z). Start after the shared
  // level clears the 0.18m kerb; reach past the door at z=0.7 by ~2 minutes.
  var pvT = Math.max(0, t - 58);
  phPaveFlood.visible = pvT > 0;
  if (pvT > 0) {
    var pvP = Math.min(1, pvT / 65);
    pvP = pvP * pvP * (3 - 2 * pvP);
    var pvLen = 5.0 * pvP;
    phPaveFlood.position.y = phLevel + 0.002;
    phPaveFlood.scale.set(1.2 + pvLen * 1.35 + Math.sin(t * 1.7) * 0.03, pvLen, 1);
  }

  // Visit 2+: ripples working off the drain
  if (phVisit >= 2) {
    for (var phri2 = 0; phri2 < phRip.length; phri2++) {
      var rpP = ((t * (phVisit >= 3 ? 0.38 : 0.28) + phri2 * 0.5) % 1);
      var rpS = (0.35 + rpP * 1.5) * dpR;
      phRip[phri2].scale.set(rpS * 1.12, rpS, 1);
      phRip[phri2].material.opacity = (phVisit >= 3 ? 0.32 : 0.22) * (1 - rpP);
    }
  }

  // Visit 2+: the chop — churning surface patches, more and wilder each visit
  if (phVisit >= 2) {
    var chopN = Math.min(4 * (phVisit - 1), 12);
    var chopAmp = 0.5 + 0.5 * Math.min(phVisit - 1, 5);
    for (var pci2 = 0; pci2 < phChop.length; pci2++) {
      var pc = phChop[pci2];
      if (pci2 >= chopN) { pc.material.opacity = 0; continue; }
      var pcT = t * pc.userData.sp + pc.userData.ph;
      var pcR = 0.25 + 0.55 * ((pci2 * 0.618) % 1);
      var pcA = pc.userData.ph + t * 0.15 * (pci2 % 2 ? 1 : -1);
      var pcX = 2.2 + Math.cos(pcA) * pcR * flG * 0.5 + pc.userData.ox;
      var pcZ = 6.4 - Math.sin(pcA) * pcR * Math.min(flG * 0.25, 2.0) - pc.userData.oz;
      pc.position.set(pcX, phLevel + 0.003, pcZ);
      var pcS = (0.3 + 0.25 * Math.abs(Math.sin(pcT))) * (0.7 + 0.3 * chopAmp);
      pc.scale.set(pcS * 1.4, pcS, 1);
      pc.material.opacity = (0.1 + 0.14 * Math.abs(Math.sin(pcT * 1.3))) * chopAmp;
      pc.material.emissiveIntensity = 0.15 * chopAmp * Math.abs(Math.sin(pcT));
    }
  }

  // Visit 3+: the storm arrives — double-strike lightning, silvered water
  if (phVisit >= 3) {
    if (t > phBoltNext) {
      phBoltT = t;
      phBoltNext = t + Math.max(4.5, 8 - (phVisit - 3) * 1.5) + Math.random() * 9;
      if (window.dssAudio && window.dssAudio.thunderClap) setTimeout(function(){ if (window.dssAudio) window.dssAudio.thunderClap(); }, 900 + Math.random() * 1200);
    }
    var phbAge = t - phBoltT;
    var phbI = 0;
    if (phbAge >= 0 && phbAge < 0.6) {
      phbI = Math.max(0, Math.sin(Math.min(phbAge * 22, Math.PI))) * 0.9;
      if (phbAge > 0.2 && phbAge < 0.46) phbI = Math.max(phbI, Math.sin((phbAge - 0.2) * 12) * 1.0);
    }
    phLightning.intensity = phbI * 2.2;
    for (var phwi2 = 0; phwi2 < phWaterMats.length; phwi2++) { if (phWaterMats[phwi2].emissive) phWaterMats[phwi2].emissiveIntensity = phbI * 0.9; }
    if (phFogBase) scene.fog.color.copy(phFogBase).lerp(phFlashCol, phbI * 0.9);
    if (phBgBase) scene.background.copy(phBgBase).lerp(phFlashCol, phbI * 0.9);
  }

  // Silhouette sway
  for (var i = 0; i < silhouettes.length; i++) {
    var s = silhouettes[i];
    s.mesh.position.x = s.baseX + Math.sin(t * s.swaySpeed + s.swayPhase) * s.swayAmt;
  }

  // Hanging sign: pendulum swing + slow wind-twist about its bracket
  signPivot.rotation.z = Math.sin(t * 0.9) * 0.045;
  signPivot.rotation.y = 1.05 + Math.sin(t * 0.31) * 0.16 + Math.sin(t * 0.73) * 0.05;

  // Alley light flicker (subtle, eerie)
  alleyLight.intensity = 0.25 + Math.sin(t * 1.8) * 0.05 + Math.sin(t * 4.1) * 0.03;
  alleyLight2.intensity = 0.15 + Math.sin(t * 2.5 + 1) * 0.03;
  alleyEndGlow.intensity = 1.2 + Math.sin(t * 0.8) * 0.15;
  alleyEndGlow2.intensity = 0.6 + Math.sin(t * 1.1 + 0.5) * 0.08;

  if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
}
// ---- ENTRY BUTTON ----
var phBtn = document.createElement('div');
phBtn.textContent = 'GO TO THE PILLARS';
phBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(200,170,100,0.85);border:1px solid rgba(200,170,100,0.3);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
// Show button after delay
setTimeout(function() { phBtn.style.opacity = '1'; }, 2500);
// Hover effects
phBtn.addEventListener('mouseenter', function() {
phBtn.style.color = 'rgba(230,200,120,0.95)';
phBtn.style.borderColor = 'rgba(200,170,100,0.6)';
});
phBtn.addEventListener('mouseleave', function() {
phBtn.style.color = 'rgba(200,170,100,0.85)';
phBtn.style.borderColor = 'rgba(200,170,100,0.3)';
});
// Click handler - fade out and navigate
phBtn.addEventListener('click', function() {
phWrap.style.transition = 'opacity 1.5s ease';
phWrap.style.opacity = '0';
setTimeout(function() {
if (phAnimId) cancelAnimationFrame(phAnimId);
phAnimId = null;
if (phWrap.parentNode) phWrap.parentNode.removeChild(phWrap);
// Navigate to target passage
var TARGET = 'Entering The Pillars of Hercules';
if (window.Engine && Engine.go) { Engine.go(TARGET); }
else {
var links = document.querySelectorAll('tw-link, .enchantment-link');
for (var i = 0; i < links.length; i++) {
if (links[i].textContent.trim() === '·') { links[i].click(); break; }
}
}
}, 1500);
});
phWrap.appendChild(phBtn);

document.body.appendChild(phWrap);
phAnimate();
}

// Watch for ph-container
setInterval(function() {
var container = document.getElementById('ph-container');
if (container && !phActive) {
initPillars();
} else if (!container) {
phActive = false;
phLeftAt = Date.now(); phCarryT += phThisT; phThisT = 0;
if (phAnimId) { cancelAnimationFrame(phAnimId); phAnimId = null; }
window._dssDisposeWrap('ph-wrap');
}
}, 300);
})();


// ====== LACKLAND'S OFFICE SCENE — INLINE ======
(function() {
var loActive = false;
var loAnimId = null;
var loWrap = null;
var loVig = null;
var loGrain = null;
var loGrainCtx = null;
var loGrainFrame = 0;
var loWash = null;
var loDate = null;
var loLoc = null;
var loBtn = null;

function initLackland() {
if (loActive) return;
loActive = true;
if (typeof THREE === 'undefined') {
var s = document.createElement('script');
s.src = 'vendor/three/three.min.js';
s.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildLOScene) : buildLOScene()); };
document.head.appendChild(s);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildLOScene) : buildLOScene());
}
}

function buildLOScene() {
// Create full-screen overlay wrapper
loWrap = document.createElement('div');
loWrap.id = 'lo-wrap';
loWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#040408;overflow:hidden;';
var loStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ============================================================
// SCENE SETUP
// ============================================================
var scene = new THREE.Scene();
scene.background = new THREE.Color(0x04040a);
scene.fog = new THREE.Fog(0x04040a, 4, 22);

var camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 200);
camera.position.set(2.8, 2.0, 6.5);
camera.lookAt(0, 2.8, 0);

var renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 0.54;
loWrap.appendChild(renderer.domElement);
window._dssBindScene('lo-wrap', scene, renderer, camera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(scene, camera, renderer, { focus: 10 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(document.getElementById('lo-wrap'));

// ============================================================
// MATERIALS
// ============================================================
var stuccoTex = makeCanvasTexture(512, 1024, function(cx, w, h) {
cx.fillStyle = '#d5ccb8';
cx.fillRect(0, 0, w, h);
var sootWash = cx.createLinearGradient(0, 0, 0, h);
sootWash.addColorStop(0, 'rgba(50, 45, 35, 0.15)');
sootWash.addColorStop(0.1, 'rgba(60, 55, 45, 0.05)');
sootWash.addColorStop(0.5, 'rgba(0, 0, 0, 0)');
sootWash.addColorStop(0.85, 'rgba(50, 45, 30, 0.08)');
sootWash.addColorStop(1, 'rgba(40, 35, 25, 0.2)');
cx.fillStyle = sootWash;
cx.fillRect(0, 0, w, h);
cx.strokeStyle = 'rgba(90, 85, 70, 0.06)';
cx.lineWidth = 2;
for (var rs = 0; rs < 20; rs++) {
cx.beginPath();
var rx = Math.random() * w;
cx.moveTo(rx, 0);
for (var ry = 0; ry < h; ry += 30) {
rx += (Math.random() - 0.5) * 4;
cx.lineTo(rx, ry);
}
cx.stroke();
}
cx.fillStyle = 'rgba(160, 150, 130, 0.08)';
for (var pc = 0; pc < 6; pc++) {
cx.beginPath();
cx.ellipse(Math.random() * w, Math.random() * h, 30 + Math.random() * 60, 20 + Math.random() * 40, Math.random(), 0, Math.PI * 2);
cx.fill();
}
});
// Toolkit-grade weathering — the old flat MeshStandard colors read as
// clean plastic against the reviewed scenes (2026-07-29 audit).
var loKit = window.dssScene || null;
var creamStucco = (loKit && loKit.makeWeatheredStucco)
  ? loKit.makeWeatheredStucco({ baseColor: 0xd5ccb8, repeat: [2, 2.5] })
  : new THREE.MeshStandardMaterial({ map: stuccoTex, roughness: 0.85 });
var darkStucco = (loKit && loKit.makeWeatheredStucco)
  ? loKit.makeWeatheredStucco({ baseColor: 0xb0a890, repeat: [2, 2.5] })
  : new THREE.MeshStandardMaterial({ color: 0xb0a890, roughness: 0.85 });
var sootBrick = (loKit && loKit.makeGrimyBrick)
  ? loKit.makeGrimyBrick({ baseColor: 0x2a2520, repeat: [2, 4], sootStreaks: 9, dampPatches: 5 })
  : new THREE.MeshStandardMaterial({ color: 0x2a2520, roughness: 0.9 });
var darkBrick = (loKit && loKit.makeGrimyBrick)
  ? loKit.makeGrimyBrick({ baseColor: 0x3a2a22, repeat: [2, 4], sootStreaks: 7 })
  : new THREE.MeshStandardMaterial({ color: 0x3a2a22, roughness: 0.9 });
var redBrick = (loKit && loKit.makeGrimyBrick)
  ? loKit.makeGrimyBrick({ baseColor: 0x6b3a2a, repeat: [2, 4], sootStreaks: 6, dampPatches: 4 })
  : new THREE.MeshStandardMaterial({ color: 0x6b3a2a, roughness: 0.85 });
var greyStone = new THREE.MeshStandardMaterial({ color: 0x9a9488, roughness: 0.75 });
var whiteStone = (loKit && loKit.makeWeatheredStucco)
  ? loKit.makeWeatheredStucco({ baseColor: 0xc8c0b0, repeat: [1.5, 2] })
  : new THREE.MeshStandardMaterial({ color: 0xc8c0b0, roughness: 0.7 });
var paveTex = makeCanvasTexture(512, 512, function(cx, w, h) {
cx.fillStyle = '#555550';
cx.fillRect(0, 0, w, h);
var flagRows = [
{ y: 0, h: 128 },
{ y: 128, h: 110 },
{ y: 238, h: 140 },
{ y: 378, h: 134 }
];
for (var ri = 0; ri < flagRows.length; ri++) {
var row = flagRows[ri];
var slabs = (ri % 2 === 0) ? [0, 200, 380] : [0, 260, 420];
for (var si = 0; si < slabs.length; si++) {
var sx = slabs[si];
var sw = (si < slabs.length - 1) ? slabs[si + 1] - sx : w - sx;
var tone = 60 + Math.random() * 25;
cx.fillStyle = 'rgb(' + tone + ',' + tone + ',' + (tone - 3) + ')';
cx.fillRect(sx + 2, row.y + 2, sw - 4, row.h - 4);
cx.fillStyle = 'rgba(80, 78, 72, 0.06)';
for (var sp = 0; sp < 8; sp++) {
cx.beginPath();
cx.ellipse(sx + Math.random() * sw, row.y + Math.random() * row.h, 10 + Math.random() * 25, 5 + Math.random() * 12, Math.random(), 0, Math.PI * 2);
cx.fill();
}
}
}
cx.strokeStyle = 'rgba(25, 22, 18, 0.6)';
cx.lineWidth = 3;
for (var ri = 0; ri < flagRows.length; ri++) {
cx.beginPath();
cx.moveTo(0, flagRows[ri].y);
cx.lineTo(w, flagRows[ri].y);
cx.stroke();
}
var vertLines1 = [200, 380];
var vertLines2 = [260, 420];
for (var ri = 0; ri < flagRows.length; ri++) {
var row = flagRows[ri];
var vlines = (ri % 2 === 0) ? vertLines1 : vertLines2;
for (var vi = 0; vi < vlines.length; vi++) {
cx.beginPath();
cx.moveTo(vlines[vi], row.y);
cx.lineTo(vlines[vi], row.y + row.h);
cx.stroke();
}
}
cx.fillStyle = 'rgba(15, 12, 8, 0.25)';
for (var ri = 0; ri < flagRows.length; ri++) {
cx.fillRect(0, flagRows[ri].y - 1, w, 4);
}
cx.fillStyle = 'rgba(30, 28, 22, 0.2)';
for (var st = 0; st < 8; st++) {
cx.beginPath();
cx.ellipse(Math.random() * w, Math.random() * h, 8 + Math.random() * 20, 6 + Math.random() * 15, Math.random() * Math.PI, 0, Math.PI * 2);
cx.fill();
}
cx.fillStyle = 'rgba(90, 88, 82, 0.35)';
for (var gm = 0; gm < 5; gm++) {
cx.beginPath();
cx.arc(Math.random() * w, Math.random() * h, 2 + Math.random() * 4, 0, Math.PI * 2);
cx.fill();
}
cx.fillStyle = 'rgba(35, 35, 38, 0.12)';
for (var dp = 0; dp < 3; dp++) {
cx.beginPath();
cx.ellipse(Math.random() * w, Math.random() * h, 25 + Math.random() * 40, 20 + Math.random() * 30, Math.random(), 0, Math.PI * 2);
cx.fill();
}
});
var pavementMat = new THREE.MeshStandardMaterial({ map: paveTex, roughness: 0.9 });
// Road — grimy tarmac with aggregate, cracks, repair patches, tar-seal
var roadFaceTexLo = makeCanvasTexture(512, 512, function(cx, w, h) {
cx.fillStyle = '#181818'; cx.fillRect(0, 0, w, h);
for (var p = 0; p < 4200; p++) {
var pg = 25 + Math.floor(Math.random() * 70);
cx.fillStyle = 'rgba(' + pg + ',' + pg + ',' + pg + ',0.42)';
cx.fillRect(Math.random() * w, Math.random() * h, 1.5, 1.5);
}
for (var rp = 0; rp < 6; rp++) {
var rx = Math.random() * w, ry = Math.random() * h;
var rwd = 50 + Math.random() * 100, rht = 35 + Math.random() * 70;
cx.fillStyle = 'rgba(72, 72, 72, ' + (0.16 + Math.random() * 0.22).toFixed(3) + ')';
cx.fillRect(rx, ry, rwd, rht);
cx.strokeStyle = 'rgba(100, 100, 100, 0.18)'; cx.lineWidth = 0.6;
cx.strokeRect(rx, ry, rwd, rht);
}
cx.strokeStyle = 'rgba(6, 6, 6, 0.8)'; cx.lineWidth = 1.2;
for (var c = 0; c < 10; c++) {
cx.beginPath();
var cx0 = Math.random() * w, cy0 = Math.random() * h;
cx.moveTo(cx0, cy0);
var ang = Math.random() * Math.PI * 2, len = 30 + Math.random() * 80;
cx.lineTo(cx0 + Math.cos(ang) * len, cy0 + Math.sin(ang) * len);
cx.lineTo(cx0 + Math.cos(ang + 0.4) * len * 1.4, cy0 + Math.sin(ang + 0.4) * len * 1.4);
cx.stroke();
}
cx.strokeStyle = 'rgba(0, 0, 0, 0.9)'; cx.lineWidth = 2.6;
for (var tm = 0; tm < 5; tm++) {
cx.beginPath();
var tx = Math.random() * w, ty = Math.random() * h;
cx.moveTo(tx, ty);
for (var ts = 0; ts < 5; ts++) {
tx += (Math.random() - 0.5) * 30;
ty += 8 + Math.random() * 16;
cx.lineTo(tx, ty);
}
cx.stroke();
}
cx.fillStyle = 'rgba(220, 220, 200, 0.5)';
cx.fillRect(w * 0.5 - 2, h * 0.3, 4, h * 0.4);
cx.fillStyle = 'rgba(220, 220, 200, 0.18)';
cx.fillRect(w * 0.5 - 2, h * 0.05, 4, h * 0.2);
cx.fillRect(w * 0.5 - 2, h * 0.75, 4, h * 0.2);
for (var os = 0; os < 4; os++) {
var ox = Math.random() * w, oy = Math.random() * h;
var orr = 8 + Math.random() * 18;
var og = cx.createRadialGradient(ox, oy, 0, ox, oy, orr);
og.addColorStop(0, 'rgba(0, 0, 0, 0.62)');
og.addColorStop(0.7, 'rgba(15, 12, 5, 0.22)');
og.addColorStop(1, 'rgba(15, 12, 5, 0)');
cx.fillStyle = og; cx.fillRect(ox - orr, oy - orr, orr * 2, orr * 2);
}
});
roadFaceTexLo.wrapS = roadFaceTexLo.wrapT = THREE.RepeatWrapping;
roadFaceTexLo.repeat.set(1, 8);
var roadMat = new THREE.MeshStandardMaterial({ map: roadFaceTexLo, roughness: 0.78, metalness: 0.15 });
var kerbMat = new THREE.MeshStandardMaterial({ color: 0x555555, roughness: 0.8 });
var paveMat = new THREE.MeshStandardMaterial({ map: paveTex, roughness: 0.85 });
var windowFrame = new THREE.MeshStandardMaterial({ color: 0x8a8070, roughness: 0.7 });
var darkGlass = new THREE.MeshStandardMaterial({ color: 0x0a0a12, roughness: 0.2, metalness: 0.3 });
var warmGlass = new THREE.MeshStandardMaterial({ color: 0x2a1505, roughness: 0.3, emissive: 0xe87818, emissiveIntensity: 0.12 });
var ironMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.6, metalness: 0.4 });
var doorTex = makeCanvasTexture(256, 512, function(cx, w, h) {
