// 2026-10-23 overnight (Sam, playtest: "This 3d render feels a bit more basic than the others. Need improvement."): the two far
// buildings were bare boxes and both streets ran off into black, so the pub stood alone in a void. Each now has dressed sash
// windows (a few lit), the next-door ground floors carry warm shop glass, and every lit pane has a soft additive glow that holds
// through the fog, so both streets read as lived-in Soho going on into the murk. No new lights (the scene's budget is spent).
(function() {
var dw = window.dssScene && window.dssScene.makeDressedWindow;
var gc = document.createElement('canvas'); gc.width = gc.height = 64;
var gx = gc.getContext('2d'), gg = gx.createRadialGradient(32, 32, 0, 32, 32, 32);
gg.addColorStop(0, 'rgba(255,214,150,1)'); gg.addColorStop(0.35, 'rgba(255,180,100,0.45)'); gg.addColorStop(1, 'rgba(255,160,80,0)');
gx.fillStyle = gg; gx.fillRect(0, 0, 64, 64);
var glowTex = new THREE.CanvasTexture(gc);
function glow(x, y, z, sc, op) {
var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTex, color: 0xffc887, transparent: true, opacity: op, depthWrite: false, blending: THREE.AdditiveBlending, fog: false }));
sp.position.set(x, y, z); sp.scale.set(sc, sc, 1); scene.add(sp); return sp;
}
function frame(w, h, d) { return new THREE.Mesh(new THREE.BoxGeometry(w, h, d), windowFrame); }
// Greek St, the far building (face at x = 0, facing +X)
var gLit = [[false, true, false], [true, false, false], [false, false, true]];
for (var r = 0; r < 3; r++) for (var c = 0; c < 3; c++) {
var lit = gLit[r][c], y = 3.6 + r * 3.1, z = -12.2 - c * 2.3;
var g = new THREE.Mesh(new THREE.PlaneGeometry(0.7, 1.25), dw ? dw(lit, (r + c) % 3, (r * 3 + c) % 4) : darkGlass);
g.rotation.y = Math.PI / 2; g.position.set(0.04, y, z); scene.add(g);
var f = frame(0.06, 1.38, 0.82); f.position.set(0.005, y, z); scene.add(f); /* its face stays behind the glass */
if (lit) glow(0.6, y, z, 2.2, 0.32);
}
// Romilly St, the far building (face at z = 0, facing +Z)
var rLit = [[true, false, false], [false, false, true], [false, true, false]];
for (var r2 = 0; r2 < 3; r2++) for (var c2 = 0; c2 < 3; c2++) {
var lit2 = rLit[r2][c2], y2 = 3.4 + r2 * 3.0, x2 = -16.3 - c2 * 2.4;
var g2 = new THREE.Mesh(new THREE.PlaneGeometry(0.7, 1.25), dw ? dw(lit2, (r2 * 2 + c2) % 3, (r2 + c2 * 2) % 4) : darkGlass);
g2.position.set(x2, y2, 0.04); scene.add(g2);
var f2 = frame(0.82, 1.38, 0.06); f2.position.set(x2, y2, 0.005); scene.add(f2);
if (lit2) glow(x2, y2, 0.6, 2.2, 0.32);
}
// the next-door ground floors: a lit shop window each, with its glow on the pavement side
var sc = document.createElement('canvas'); sc.width = 256; sc.height = 160; var sx = sc.getContext('2d');
var sg = sx.createRadialGradient(128, 60, 8, 128, 80, 170); sg.addColorStop(0, '#d9a25a'); sg.addColorStop(0.55, '#7a4a1e'); sg.addColorStop(1, '#2a160a');
sx.fillStyle = sg; sx.fillRect(0, 0, 256, 160);
sx.fillStyle = 'rgba(30,16,6,0.75)'; sx.fillRect(0, 112, 256, 48); /* a counter */
sx.fillStyle = 'rgba(40,22,8,0.55)'; for (var sh = 0; sh < 3; sh++) sx.fillRect(14, 22 + sh * 26, 228, 4); /* shelves */
sx.fillStyle = 'rgba(20,10,4,0.85)'; sx.beginPath(); sx.ellipse(176, 70, 9, 11, 0, 0, Math.PI * 2); sx.fill(); sx.fillRect(164, 80, 24, 34); /* someone at the counter */
sx.fillStyle = 'rgba(255,240,210,0.08)'; sx.fillRect(0, 0, 256, 4);
var shopMat = new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(sc), fog: true }); /* a lit shop, someone at the counter */
var gs = new THREE.Mesh(new THREE.PlaneGeometry(2.6, 1.7), shopMat); gs.rotation.y = Math.PI / 2; gs.position.set(0.05, 1.45, -7.6); scene.add(gs);
var gsf = frame(0.08, 1.9, 2.8); gsf.position.set(0.005, 1.45, -7.6); scene.add(gsf);
glow(0.9, 1.4, -7.6, 3.6, 0.28);
var rs = new THREE.Mesh(new THREE.PlaneGeometry(2.6, 1.7), shopMat); rs.position.set(-12.2, 1.45, 0.05); scene.add(rs);
var rsf = frame(2.8, 1.9, 0.08); rsf.position.set(-12.2, 1.45, 0.005); scene.add(rsf);
glow(-12.2, 1.4, 0.9, 3.6, 0.28);
})();

// --- BUILDINGS ACROSS THE STREETS ---
// Across Greek St (east side — well behind camera so it doesn't block the view)
