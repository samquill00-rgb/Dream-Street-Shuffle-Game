  function startRoom() {
    var stage = $('.mats-stage');
    function go() { if (disposed || room3d) return; try { room3d = buildRoom(stage); } catch (e) { room3d = null; console.error('Beer mats room:', e); } }
    if (typeof THREE === 'undefined') { var s = document.createElement('script'); s.src = 'vendor/three/three.min.js'; s.onload = go; document.head.appendChild(s); }
    else go();
  }
  function key(e) {
    if (!root.isConnected) return;
    if (e.code === 'Space' && e.target.tagName !== 'BUTTON' && e.target.tagName !== 'INPUT') { e.preventDefault(); if (!e.repeat) down(); }
  }
