      if (n.nodeType !== 3 || !n.nodeValue.trim()) continue;
      if (n.nodeValue.indexOf('\n') >= 0) return;
      n.nodeValue = n.nodeValue.replace(/,\s+|\s+[—–]\s+/, '\n');
      return;
    }
  }
  setInterval(function() { Array.prototype.forEach.call(document.querySelectorAll('.dss-room-caption:not([data-br])'), function(c) { if (/[,—–]/.test(c.textContent)) split(c); }); }, 250);
})();
// 2026-10-13 (Sam): THE NIGHT ON THE NOTEBOOK MAP. Tonight's walk (localStorage 'dssRouteNow', kept by the street map)
// drawn in gold on the notebook's plan, as on the Dawn page. The two maps agree street by street, so the walk is carried
// over by them: the street map's road columns 6/18/30/42 are Wardour, Dean, Frith and Greek; rows 2/16/28/42 are
// Oxford Street, Bateman, Old Compton and Shaftesbury (piecewise between them).
(function() {
  var XS = [[0, 35], [6, 100], [18, 230], [30, 360], [42, 490], [50, 545], [52, 560]];
  var YS = [[0, 118], [2, 140], [16, 370], [28, 520], [42, 620], [44, 640]];
  function lerp(A, v) { for (var i = 1; i < A.length; i++) if (v <= A[i][0] || i === A.length - 1) { var a = A[i-1], b = A[i]; return a[1] + (b[1] - a[1]) * (v - a[0]) / (b[0] - a[0]); } return A[0][1]; }
  function draw(svg) {
    svg.setAttribute('data-trace', '1');
    var R = null, n = 0;
    try { R = JSON.parse(localStorage.getItem('dssRouteNow') || 'null'); n = +localStorage.getItem('dssNightNo') || 0; } catch (e) {}
    if (!R || !R.p || R.n !== n || R.p.length < 2) return;
    var NS = 'http://www.w3.org/2000/svg', g = document.createElementNS(NS, 'g'); g.setAttribute('class', 'nb-trace');
    var pts = R.p.map(function(st) { var q = st.split(','); return [+q[0], +q[1]]; }), segs = [], cur = [pts[0]];
    for (var i = 1; i < pts.length; i++) { var a = pts[i-1], b = pts[i]; if (Math.abs(a[0]-b[0]) + Math.abs(a[1]-b[1]) === 1) cur.push(b); else { segs.push(cur); cur = [b]; } }
    segs.push(cur);
    var total = 0, done = 0; segs.forEach(function(sg) { total += Math.max(1, sg.length - 1); });
    segs.forEach(function(sg) {
      var len = Math.max(1, sg.length - 1), d = 'M' + sg.map(function(q) { return lerp(XS, q[0] + 0.5).toFixed(1) + ' ' + lerp(YS, q[1] + 0.5).toFixed(1); }).join(' L');
