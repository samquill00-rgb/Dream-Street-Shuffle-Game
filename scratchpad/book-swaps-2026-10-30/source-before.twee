:: You speak to the poet [outdoor char-red] {"position":"1400,450","size":"100,100"}
(set: $metRed to true)\
<!-- Ginger light -->
<div class="ginger-lamp-wrap">
<svg width="96" height="168" viewBox="0 0 96 168"><defs><radialGradient id="glGlow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#ffb43c" stop-opacity="0.55"/><stop offset="0.35" stop-color="#ff9a1e" stop-opacity="0.22"/><stop offset="1" stop-color="#ff8c14" stop-opacity="0"/></radialGradient><radialGradient id="glPane" cx="50%" cy="45%" r="55%"><stop offset="0" stop-color="#fff0b8"/><stop offset="0.3" stop-color="#ffc24a"/><stop offset="0.75" stop-color="#e07a10" stop-opacity="0.85"/><stop offset="1" stop-color="#8a3c04" stop-opacity="0.6"/></radialGradient><linearGradient id="glIron" x1="0" x2="1"><stop offset="0" stop-color="#3a2810"/><stop offset="0.5" stop-color="#6a4a1c"/><stop offset="1" stop-color="#2a1a06"/></linearGradient></defs><ellipse cx="48" cy="46" rx="48" ry="40" fill="url(#glGlow)"/><path d="M48,2 L51,7 L48,12 L45,7 Z" fill="#5a3a10"/><rect x="46.5" y="11" width="3" height="4" fill="#2a1a06"/><path d="M28,20 Q48,12 68,20 L64,26 L32,26 Z" fill="#2a1a06"/><path d="M30,20 Q48,14 66,20" fill="none" stroke="#c8a86a" stroke-width="0.6" opacity="0.7"/><path d="M32,26 L64,26 L60,66 L36,66 Z" fill="url(#glPane)"/><path d="M32,26 L64,26 L60,66 L36,66 Z" fill="none" stroke="#2a1a06" stroke-width="1.6" stroke-linejoin="round"/><path d="M48,26 L48,66 M33.2,38 L62.8,38 M34.4,52 L61.6,52" stroke="#2a1a06" stroke-width="1.1"/><path d="M40,29 L38.8,40 M41,56 L40.4,63" stroke="rgba(255,255,255,0.35)" stroke-width="0.8" stroke-linecap="round"/><ellipse cx="48" cy="46" rx="6" ry="9" fill="#fff4c8" opacity="0.75"/><ellipse cx="48" cy="45" rx="2.6" ry="4.2" fill="#ffffff" opacity="0.9"/><rect x="34" y="66" width="28" height="5" rx="1.5" fill="#2a1a06"/><rect x="40" y="71" width="16" height="4" rx="1" fill="#5a3a10"/><path d="M30,80 L66,80" stroke="#5a3a10" stroke-width="2.2" stroke-linecap="round"/><path d="M30,80 q-4,-4 0,-8 M66,80 q4,-4 0,-8" fill="none" stroke="#5a3a10" stroke-width="1.6" stroke-linecap="round"/><path d="M44,75 L44,86 Q48,90 52,86 L52,75" fill="url(#glIron)" stroke="#2a1a06" stroke-width="0.6"/><rect x="44.5" y="88" width="7" height="60" rx="1.5" fill="url(#glIron)" stroke="#2a1a06" stroke-width="0.5"/><path d="M47,90 L47,146 M49.5,90 L49.5,146" stroke="rgba(255,220,160,0.14)" stroke-width="0.8"/><path d="M42,148 L54,148 L56,154 L40,154 Z" fill="#5a3a10"/><path d="M38,154 L58,154 L60,162 L36,162 Z" fill="#2a1a06"/><rect x="34" y="162" width="28" height="4" rx="1" fill="#2a1a06"/><path d="M45,88 L45,146" stroke="rgba(255,180,80,0.35)" stroke-width="1.2" stroke-linecap="round"/><ellipse cx="48" cy="166" rx="30" ry="2.4" fill="rgba(255,160,60,0.12)"/></svg>
</div>
<div class="ginger-scene">
<div class="ginger-light"></div>
‘RED!’ you say. He looks up, at first, then towards you without looking at you.

‘What’s the trouble, cock?’

‘I need to sell a book.’

‘Don’t look so merly. Things turn up.’

<!-- 2026-10-17 (Sam's line, the worlds wired to the readers): --><span class="dss-gift-line" data-gift="easter" hidden>RED looks at you, phlegmatic as a leech. ‘There’s a word in your mouth,’ he says, ‘my professional advice is: don’t cough up.’<br><br></span>(if: $easterGlyph is true)[<span class="dss-gift-now" data-gift="easter" hidden></span>]You don’t understand and smiling and then retreating, you strike, in the nifty, brisket air, a vein of his perfume, which you recognise, because you once loved a woman who wore the very same, as lily-of-the-valley.

[[Walk on|Night Ahead: LILY]]<!-- 2026-10-28: LILY's page before LINE 1 -->
</div>

:: header header [header] {"position":"700,50","size":"100,100"}
<span id="dss-pn" style="display:none;">(print: (passage:)'s name)</span>\
<div id="dss-lore-greatwork" hidden>(display: "Lore The Great Work")</div>\
<span class="dss-gw-read" hidden>(link: "gw-read")[(set: _lore to "The Great Work")(display: "Lore Read")]</span>\
<span id="dss-lily-n" hidden>(if: $lilyCount is a number)[(print: $lilyCount)]</span>\
<!-- 2026-10-21: the haunts caught before this page, for the gold wheel after a haunt (THE GATE FLASH). Pipe-delimited, as at the Dawn. -->(set: _dssHeld to "")(if: $haunts is an array)[(if: $haunts's length > 0)[(for: each _dssH, ...$haunts)[(set: _dssHeld to _dssHeld + _dssH + "|")]]]<span id="dss-haunts-held" hidden>(print: _dssHeld)</span>\
<!-- 2026-10-22 (the dedication page): the names tonight has earned for the book's first page, read by dssDedication and banked across nights. Always AOIFE, your daughter, LILY, no one; ASHTON GRANGER once the cellar has named her; JOHN after his round or his rescue; the Fetch after the Sanctum. -->(set: _dssDedicPool to "aoife,daughter,noone")<!-- 2026-10-24 (Sam: "keep LILY off the dedication page until Night Ahead Part Two has shown") -->(if: $lilyNamed is true)[(set: _dssDedicPool to _dssDedicPool + ",lily")](if: (history:) contains "Turn to Copper")[(set: _dssDedicPool to _dssDedicPool + ",ashton")](if: ((history:) contains "His round") or ($savedBy is "john"))[(set: _dssDedicPool to _dssDedicPool + ",john")](if: $sanctumDone is true)[(set: _dssDedicPool to _dssDedicPool + ",fetch")]<span id="dss-dedic-pool" hidden>(print: _dssDedicPool)</span>\
(display: "Dream Progress")(display: "Davy Ticket Progress")\
<!-- 2026-09-16: has the player been INSIDE a venue yet? Gates the dawn door on Dean Street. Old mid-night saves: treat a second hub visit as yes. -->\
(unless: $enteredVenue is a boolean)[(set: $enteredVenue to ($returns is a number and $returns >= 2))]\
(if: $enteredVenue is false and ((passage:)'s tags contains any of (a: "venue-french", "venue-colony", "venue-ronnies", "venue-coach", "venue-gents", "venue-trishas", "venue-lackland", "venue-lackland-back", "venue-cecilcourt", "venue-pillars", "venue-cellar") or (a: "Chinese Fish and Chips", "At the Corner of Dean Street and Greek Street", "Maltese Gangsters") contains (passage:)'s name))[(set: $enteredVenue to true)]\
<!-- BACK-FILL: heal $knowsCecilCourt on EVERY passage. Older saves from before the (set:) was added in The critic's judgement may have $metCritic=true with $knowsCecilCourt=false. NOTE 2026-09-14: this comment is on ONE line and the two macros below end in backslashes on purpose. Harlowe turns every un-suppressed newline here into a <br>, and because this passage is tagged [header] it prepends to EVERY passage in the game: these few lines were putting four blank lines and about 88px of dead space above the top of every page. -->\
(unless: $knowsCecilCourt is a boolean)[(set: $knowsCecilCourt to false)]\
<!-- 2026-09-28 betrayal fork: $crossed = who you turned on tonight ("", "ashton" = broke the agreement, "red" or "john" = gave Copper the name); $savedBy = who got you out of the cellar ("john", "ashton", "nobody"), set in Beaten / Standing. -->\
(unless: $crossed is a string)[(set: $crossed to "")](unless: $savedBy is a string)[(set: $savedBy to "")]\
<!-- 2026-10-04 the ship (Sam, thread "Devon Truze replaces Misty Minor"): $shipFate rolled once a night ("afloat" / "sunk", two nights in three, his ruling 2026-10-09); $shipNews = what you have heard ("", "rumour", "asked", "afloat", "sunk"); $shipCall = what became of the call in the box after midnight ("", "refused", "news", "kept", "given", "slipped"); $holdsAshtonName = she half told you on the stairs; $ashtonSold = you gave the cellar her name. -->\
(unless: $shipFate is a string)[(set: $shipFate to (cond: (random: 1, 3) is not 1, "sunk", "afloat"))](unless: $shipNews is a string)[(set: $shipNews to "")](unless: $shipCall is a string)[(set: $shipCall to "")](unless: $holdsAshtonName is a boolean)[(set: $holdsAshtonName to false)](unless: $ashtonSold is a boolean)[(set: $ashtonSold to false)](unless: $lineWomanMet is a boolean)[(set: $lineWomanMet to false)](unless: $hamRumour is a boolean)[(set: $hamRumour to false)]\
(unless: $brokenWindows is an array)[(set: $brokenWindows to (a:))](unless: $coachBurnt is a boolean)[(set: $coachBurnt to false)]\
(unless: $drinksTonight is a number)[(set: $drinksTonight to 0)](unless: $blackouts is a number)[(set: $blackouts to 0)](unless: $lostToDrink is an array)[(set: $lostToDrink to (a:))](unless: $blackedOut is a boolean)[(set: $blackedOut to false)]\
(if: ($knowsCecilCourt is false) and (($metCritic is true) or (($haunts is an array) and ($haunts contains $haunt2))))[(set: $knowsCecilCourt to true)]\
<!-- INVARIANT: every passage in _hideStats has its WHOLE header suppressed (stats + ← BACK + NOTEBOOK), so its body MUST contain its own exit — a body link or (go-to:) — or be a true terminal ending (e.g. Dawn). There is no sidebar Undo, so a _hideStats passage with no body exit is an unrecoverable hard-trap. Confirm a body exit before adding any passage to this list. -->\
(set: _hideStats to (a: "The Coach Burns", "White page", "Black page", "Title", "Start", "The Night Ahead", "Name Your Book", "Dedicate Your Book", "A Doorway on Dean Street", "Dawn", "Dawn Approach White", "Dawn Approach Black", "Alba Complete", "Alba Incomplete", "Approach Centre Point", "The Fetch", "PP Pong", "Fight starts", "Fight Victory", "Fight Defeat", "Fight Victory Perfect", "Cecil Court Waltz", "Ride Jeffrey Bernard's cow", "Cow ride success", "Cow ride fail"))\
(if: $returns is a number and $returns >= 1 and not (_hideStats contains (passage:)'s name))[(set: _saved to (savegame: "auto", "Auto save"))(unless: _saved)[(text-colour:#e0a85a)[//Heads up: this browser isn’t saving your progress — most likely private/incognito mode. If you leave now, you’ll lose your place.//]]](if: (passage:)'s name is "Dean Street")[<div id="dss-save-toast" style="position:fixed;bottom:14px;right:16px;z-index:99999;font-family:'Crimson Text',Georgia,serif;font-size:0.8em;letter-spacing:0.06em;color:#c8b89c;background:rgba(10,12,18,0.78);border:1px solid rgba(160,128,96,0.28);border-radius:4px;padding:5px 11px;opacity:0;pointer-events:none;box-shadow:0 2px 12px rgba(0,0,0,0.45);transition:opacity 0.6s ease;">✓ Progress saved</div>]<script>(function(){var el=document.getElementById("dss-save-toast");if(!el)return;var ifid='E3F7C9E2-3617-469A-AE5C-210AFB87B930',found=false;try{for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i)||'';if(k.indexOf('Saved Game')===-1)continue;if(k.toLowerCase().indexOf('auto')===-1)continue;if(ifid&&k.indexOf(ifid)===-1)continue;var v=localStorage.getItem(k);if(v&&v.length>50){found=true;break;}}}catch(e){}if(!found){if(el.parentNode)el.parentNode.removeChild(el);return;}requestAnimationFrame(function(){el.style.opacity='0.85';});setTimeout(function(){if(el)el.style.opacity='0';},2200);setTimeout(function(){if(el&&el.parentNode)el.parentNode.removeChild(el);},3000);})();</script>\
(unless: _hideStats contains (passage:)'s name)[\
(if: $confidence is a number and $confidence < 0)[(set: $confidence to 0)](if: $confidence is a number and $confidence > 100)[(set: $confidence to 100)](if: $sobriety is a number and $sobriety < 0)[(set: $sobriety to 0)](if: $sobriety is a number and $sobriety > 100)[(set: $sobriety to 100)]\
(unless: $alba is an array)[(set: $alba to (a:))]\
<!-- BACK-FILL (S8): the ALBA strip below reads $alba1/2/3; heal the line strings for any save predating their StoryInit defaults, so $alba contains $albaN stays a like-for-like comparison. -->\
(unless: $alba1 is a string)[(set: $alba1 to "As cool as the pale wet leaves")(set: $alba2 to "of lily-of-the-valley")(set: $alba3 to "She lay beside me in the dawn.")]\
(unless: $haunts is an array)[(set: $haunts to (a:))]\
<!-- BACK-FILL: heal saves made before the StoryInit [startup] fix.
     If $haunt1 isn't a string, StoryInit never ran (old [init] tag),
     so all $hauntN are 0 and $haunts may contain 0s. Reset both. -->
(unless: $haunt1 is a string)[(set: $haunt1 to "The Sketch")(set: $haunt2 to "The Refusal")(set: $haunt3 to "The Beast")(set: $haunt4 to "The Debt")(set: $haunt5 to "The Game")(set: $haunt6 to "The Delivery")(set: $haunt7 to "The Head")(set: $haunt8 to "The Wound")(set: $haunt9 to "The Sorting")(set: $haunt10 to "The Feeding")(set: $haunt11 to "The Spread")(set: $haunt12 to "The Crown")(set: $haunts to (a:))]\
(if: $haunts is an array)[\
(if: $haunts's length >= 12)[(enchant: ?page, (css: "background: linear-gradient(180deg, #1a1e2a 0%, #2a3350 50%, #1a1e2a 100%); background-attachment: fixed"))]\
(else-if: $haunts's length >= 9)[(enchant: ?page, (css: "background: linear-gradient(180deg, #15181f 0%, #222a3e 50%, #15181f 100%); background-attachment: fixed"))]\
(else-if: $haunts's length >= 6)[(enchant: ?page, (css: "background: linear-gradient(180deg, #171618 0%, #272430 50%, #171618 100%); background-attachment: fixed"))]\
(else-if: $haunts's length >= 3)[(enchant: ?page, (css: "background: linear-gradient(180deg, #181412 0%, #2a221c 50%, #181412 100%); background-attachment: fixed"))]
]\
(if: (passage:)'s name is "Maritime interlude")[(enchant: ?passage, (css: "animation: dssDrunkMid 9.5s ease-in-out infinite; transform-origin: 50% 30%;"))]\
<!-- INNER VOICES (2026-10-07): the stats and the night for the room cards (window.dssVoices calls up the id) -->\
(print: "<span id='dss-voice-state' hidden data-sob='" + (text: $sobriety) + "' data-mor='" + (text: $confidence) + "' data-phase='" + (text: $nightPhase) + "' data-trails='" + (text: $visitedCarthage is true) + "' data-lying='" + (cond: $keyLighter is "seed", "lighter ", "") + (cond: $keyCocaine is "seed", "cocaine ", "") + (cond: $keyTicket is "seed", "ticket ", "") + (cond: $keySlip is "seed", "slip ", "") + (cond: $keyEye is "seed", "eye ", "") + "' data-keys='" + (cond: $inisToldOfPillars is true, "lighter cocaine ticket slip " + (cond: ($alba contains $alba3) and ($worldsVisited is an array) and ($worldsVisited's length >= 4), "eye ", ""), "") + "' data-gone='" + (cond: (history:) contains "Turn to Copper", "cu ", "") + (cond: $returnedPage is true, "oi ", "") + (cond: $knowsRonnies is true and $knowsCopperSecret is true and $metSalvu is true and $tookLily4 is true, "ci ", "") + "'></span>")\
<div class="stat-bars">
<svg class="header-lily" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 210 68" preserveAspectRatio="xMinYMid slice" aria-hidden="true"><defs><linearGradient id="hlFade" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="white"/><stop offset="50%" stop-color="white"/><stop offset="80%" stop-color="white" stop-opacity="0.3"/><stop offset="100%" stop-color="black"/></linearGradient><mask id="hlMask"><rect x="0" y="0" width="210" height="68" fill="url(#hlFade)"/></mask></defs><g mask="url(#hlMask)"><!-- Main stem --><path d="M40,-4 Q45,8 52,20 Q60,34 72,42 Q88,52 110,56 Q135,60 165,58 Q185,54 210,48" fill="none" stroke="#0a0a0a" stroke-width="3.5" stroke-linecap="round"/><path d="M72,42 Q68,50 62,58 Q58,64 54,72" fill="none" stroke="#0a0a0a" stroke-width="2.8" stroke-linecap="round"/><!-- Left leaf --><path d="M38,-2 Q28,6 18,18 Q10,30 8,40 Q6,50 14,56 Q24,60 36,54 Q46,46 50,34 Q52,24 48,14 Q44,6 38,-2 Z" fill="#2a5c22" fill-opacity="0.22" stroke="#0a0a0a" stroke-width="3.2" stroke-linejoin="round"/><!-- Left leaf veins --><path d="M38,-2 Q30,14 22,30 Q16,42 14,56" fill="none" stroke="#0a0a0a" stroke-width="2" opacity="0.6"/><path d="M30,10 Q24,14 18,20" fill="none" stroke="#0a0a0a" stroke-width="1.2" opacity="0.35"/><path d="M26,22 Q20,28 14,34" fill="none" stroke="#0a0a0a" stroke-width="1.2" opacity="0.3"/><path d="M22,34 Q18,40 14,46" fill="none" stroke="#0a0a0a" stroke-width="1" opacity="0.25"/><!-- Right leaf --><path d="M44,0 Q56,8 66,20 Q74,32 76,42 Q78,52 72,58 Q62,64 50,60 Q42,54 40,44 Q38,34 40,22 Q42,12 44,0 Z" fill="#1e4a18" fill-opacity="0.18" stroke="#0a0a0a" stroke-width="3.2" stroke-linejoin="round"/><!-- Right leaf veins --><path d="M44,0 Q56,16 66,32 Q72,44 72,58" fill="none" stroke="#0a0a0a" stroke-width="2" opacity="0.55"/><path d="M50,10 Q58,16 64,22" fill="none" stroke="#0a0a0a" stroke-width="1.2" opacity="0.3"/><path d="M54,22 Q62,28 68,34" fill="none" stroke="#0a0a0a" stroke-width="1.2" opacity="0.28"/><path d="M58,34 Q66,40 72,46" fill="none" stroke="#0a0a0a" stroke-width="1" opacity="0.22"/><!-- Flower 1 --><path d="M80,38 Q76,42 72,50 Q70,56 74,60 Q78,64 84,62 Q90,58 88,50 Q86,42 80,38 Z" fill="#d4cdb8" fill-opacity="0.35" stroke="#0a0a0a" stroke-width="2.8" stroke-linejoin="round"/><path d="M76,50 L80,60" fill="none" stroke="#0a0a0a" stroke-width="1.2" opacity="0.4"/><path d="M84,48 L82,60" fill="none" stroke="#0a0a0a" stroke-width="1" opacity="0.35"/><path d="M80,38 Q82,34 86,30 Q90,26 92,22" fill="none" stroke="#0a0a0a" stroke-width="2.2" stroke-linecap="round"/><!-- Flower 2 --><path d="M102,34 Q98,38 96,44 Q94,50 98,54 Q102,56 106,52 Q110,48 108,42 Q106,36 102,34 Z" fill="#c8c0a8" fill-opacity="0.3" stroke="#0a0a0a" stroke-width="2.6" stroke-linejoin="round"/><path d="M100,44 L100,54" fill="none" stroke="#0a0a0a" stroke-width="1" opacity="0.35"/><path d="M102,34 Q104,30 108,26" fill="none" stroke="#0a0a0a" stroke-width="2" stroke-linecap="round"/><!-- Flower 3 --><path d="M126,30 Q122,34 120,40 Q118,46 122,48 Q126,50 130,46 Q132,40 130,34 Q128,30 126,30 Z" fill="#d0c8b0" fill-opacity="0.25" stroke="#0a0a0a" stroke-width="2.4" stroke-linejoin="round"/><path d="M126,30 Q128,26 132,22" fill="none" stroke="#0a0a0a" stroke-width="1.8" stroke-linecap="round"/><!-- Flower 4 --><path d="M152,26 Q148,30 148,36 Q150,40 154,38 Q158,34 156,28 Q154,26 152,26 Z" fill="#c4bca4" fill-opacity="0.2" stroke="#0a0a0a" stroke-width="2.2" stroke-linejoin="round"/><path d="M152,26 Q154,22 158,18" fill="none" stroke="#0a0a0a" stroke-width="1.6" stroke-linecap="round"/><!-- Flower 5 --><path d="M170,22 Q168,26 168,30 Q170,34 174,30 Q176,26 172,22 Z" fill="#beb6a0" fill-opacity="0.18" stroke="#0a0a0a" stroke-width="2" stroke-linejoin="round"/><path d="M170,22 Q172,18 176,14" fill="none" stroke="#0a0a0a" stroke-width="1.4" stroke-linecap="round"/><!-- Small leaf --><path d="M110,56 Q118,52 124,56 Q128,62 122,66 Q114,68 110,62 Q108,58 110,56 Z" fill="#2a5c22" fill-opacity="0.12" stroke="#0a0a0a" stroke-width="2" stroke-linejoin="round" opacity="0.6"/><!-- Background lead --><path d="M0,20 Q10,18 20,22 Q30,26 36,30" fill="none" stroke="#0a0a0a" stroke-width="1.5" opacity="0.18"/><path d="M0,50 Q8,46 16,48 Q24,52 30,50" fill="none" stroke="#0a0a0a" stroke-width="1.3" opacity="0.14"/><path d="M160,58 Q172,54 186,56 Q200,60 210,56" fill="none" stroke="#0a0a0a" stroke-width="1.4" opacity="0.1"/></g></svg>
<div class="stat-group">
(set: _confClass to "")(set: _confGhost to "")(set: _confPct to "")(set: _confDelta to "")(if: $prevConfidence is a number)[(if: $confidence > $prevConfidence)[(set: _confClass to " bar-flash-up")(set: _confGhost to "<span class='bar-ghost bar-ghost-gain' style='width:" + (text: $prevConfidence) + "%'></span>")(set: _confPct to " pct-gain")(set: _confDelta to "<span class='stat-delta delta-gain'>+" + (text: $confidence - $prevConfidence) + "</span>")](else-if: $confidence < $prevConfidence)[(set: _confClass to " bar-flash-down")(set: _confGhost to "<span class='bar-ghost bar-ghost-loss' style='width:" + (text: $prevConfidence) + "%'></span>")(set: _confPct to " pct-loss")(set: _confDelta to "<span class='stat-delta delta-loss'>" + (text: $confidence - $prevConfidence) + "</span>")]]
(set: _sobClass to "")(set: _sobGhost to "")(set: _sobPct to "")(set: _sobDelta to "")(if: $prevSobriety is a number)[(if: $sobriety > $prevSobriety)[(set: _sobClass to " bar-flash-up")(set: _sobGhost to "<span class='bar-ghost bar-ghost-gain' style='width:" + (text: $prevSobriety) + "%'></span>")(set: _sobPct to " pct-gain")(set: _sobDelta to "<span class='stat-delta delta-gain'>+" + (text: $sobriety - $prevSobriety) + "</span>")](else-if: $sobriety < $prevSobriety)[(set: _sobClass to " bar-flash-down")(set: _sobGhost to "<span class='bar-ghost bar-ghost-loss' style='width:" + (text: $prevSobriety) + "%'></span>")(set: _sobPct to " pct-loss")(set: _sobDelta to "<span class='stat-delta delta-loss'>" + (text: $sobriety - $prevSobriety) + "</span>")]]
<div class="stat-row">
(if: $haunts's length >= 12)[<span class="stat-label stat-label-opus">OPUS</span>](else:)[<span class="stat-label">MORALE</span>]
<span class="stat-bar">(if: $haunts's length >= 12)[(print: "<span class='bar-fill bar-opus' style='width:100%'></span>")](else:)[(print: _confGhost)(if: $confidence >= 50)[(print: "<span class='bar-fill bar-good" + _confClass + "' style='width:" + (text: $confidence) + "%'></span>")](else-if: $confidence >= 25)[(print: "<span class='bar-fill bar-warning" + _confClass + "' style='width:" + (text: $confidence) + "%'></span>")](else:)[(print: "<span class='bar-fill bar-danger" + _confClass + "' style='width:" + (text: $confidence) + "%'></span>")]](print: _confDelta)</span>
(if: $haunts's length >= 12)[(print: "<span class='stat-pct pct-opus'>100%</span>")](else:)[(print: "<span class='stat-pct" + _confPct + "'>" + (text: $confidence) + "%</span>")]
</div>
<div class="stat-row">
(if: $haunts's length >= 12)[<span class="stat-label stat-label-opus">STATE</span>](else:)[<span class="stat-label">SOBRIETY</span>]
<span class="stat-bar">(if: $haunts's length >= 12)[(print: "<span class='bar-fill bar-opus' style='width:100%'></span>")](else:)[(print: _sobGhost)(if: $sobriety >= 50)[(print: "<span class='bar-fill bar-good" + _sobClass + "' style='width:" + (text: $sobriety) + "%'></span>")](else-if: $sobriety >= 25)[(print: "<span class='bar-fill bar-warning" + _sobClass + "' style='width:" + (text: $sobriety) + "%'></span>")](else:)[(print: "<span class='bar-fill bar-danger" + _sobClass + "' style='width:" + (text: $sobriety) + "%'></span>")]](print: _sobDelta)</span>
(if: $haunts's length >= 12)[(print: "<span class='stat-pct pct-opus'>100%</span>")](else:)[(print: "<span class='stat-pct" + _sobPct + "'>" + (text: $sobriety) + "%</span>")]
</div>
</div>
(display: "Night Progress")\
<div class="alba-strip">
<span class="stat-label">ALBA</span>
<span class="alba-jewels">(set: _j1 to "alba-jewel")(if: $alba contains $alba1)[(set: _j1 to _j1 + " alba-jewel-filled")](set: _j2 to "alba-jewel")(if: $alba contains $alba2)[(set: _j2 to _j2 + " alba-jewel-filled")](set: _j3 to "alba-jewel")(if: $alba contains $alba3)[(set: _j3 to _j3 + " alba-jewel-filled")](print: "<span class='" + _j1 + "'></span><span class='" + _j2 + "'></span><span class='" + _j3 + "'></span>")</span>
<span class="alba-count">(set: _ac to 0)(if: $alba contains $alba1)[(set: _ac to _ac + 1)](if: $alba contains $alba2)[(set: _ac to _ac + 1)](if: $alba contains $alba3)[(set: _ac to _ac + 1)](print: _ac)/3</span>
<!-- POCKET KEY (2026-09-14, Sam: "it's still not clear when you have a dream
     pocket key"). One small cell in the header that names what is in the pocket,
     so it is visible everywhere rather than only inside the notebook. -->\
(unless: $dreamKey is a string)[(set: $dreamKey to "")]\
(if: $dreamKey is not "" and $keyNames is a datamap and $keyNames contains $dreamKey)[<span class="pocket-cell" title="In your pocket. The third pillar wants paying."><span class="pocket-glyph" aria-hidden="true">&#9906;</span>(print: $keyNames's ($dreamKey))</span>]\
<span class="night-cell" title="The night deepens through discoveries. There is no time limit."><!-- 2026-10-09, Sam: "get rid of the other after midnight", then "just get rid of the reader". No phase label shows at all now. The hidden span keeps the 0–3 number that the map darkening, the dawn birdsong and THE THIRST's small-hours gate still read, so that logic is parked with midnight, not cut. The old labels were "Before midnight", "After midnight", "Small hours", "Dawn awaits". -->\
(print: "<span class='night-phase' data-night-phase='" + (text: $nightPhase) + "' hidden></span>")</span>
</div>
<!-- 2026-10-12 (Sam, the overnight list item 7): the whole poem's line says Centre Point waits, but the Fetch only leads you
     on once the night is lived ($needLilies flowers, $needHaunts haunts; the weighting), so until then it showed above a NEXT
     still pointing at a flower or a haunt. It now waits for both; until then the hint is silent and NEXT leads. -->(set: _hlived to (($lilyCount is a number) and ($needLilies is not a number or $lilyCount >= $needLilies) and ($haunts is an array) and ($needHaunts is not a number or $haunts's length >= $needHaunts)))\
<!-- 2026-10-23 (Sam: the alba stays in view, but quieter): the running counts under the header ("One line is caught…", "Two lines, now…") are gone, since the stars already say it on every page; the line now speaks only when something changes the way out --><div class="alba-hint">(if: $notebook is "stolen")[Your notebook is gone, and the poem with it.](else-if: _ac >= 3 and _hlived)[The Alba is complete. Centre Point waits.]</div>
<!-- 2026-10-16 (Sam: carry the pick indoors): inside the venue of the person you chose on Dean Street, a hidden span the room reads on build; that figure is lit red and the room's caption says who you came for --><!-- 2026-10-23 (the first-night map): not while that venue rests (the one-person rule has hidden the people), so the caption no longer says "YOU CAME FOR … / Talk to others first." over a room where no one else will talk -->(display: "Who Will Read")(if: ($pitchOn is true) and ($pitchTarget is a string) and ($pitchTarget is not "") and ($venueRest is not $pitchTarget))[(set: _cfTags to (dm: "pillars", "venue-pillars", "french", "venue-french", "colony", "venue-colony", "cecil", "venue-cecilcourt", "coach", "venue-coach", "ronnies", "venue-ronnies", "trishas", "venue-trishas", "lackland", "venue-lackland"))(if: (_cfTags contains $pitchTarget) and ((passage:)'s tags contains (_cfTags's ($pitchTarget))))[<span class="dss-came-for" hidden><span class="dss-came-for-name">(print: $pitchName)</span><span class="dss-came-for-link">(print: $pitchLink)</span>(if: ($pitchName is "THE NOVELIST") and ($pitchLink is not "Speak to him"))[<span class="dss-came-for-first"></span>]</span>]]<!-- 2026-10-17 (Sam): the novelist picked while JOHN or BENITO stands before him; the room adds "Talk to others first." under its caption -->\
<!-- 2026-10-12 (Sam: the next task must be much clearer): the one place to go next, from Next Target; hidden on the hub's map screen's own bar, the endings and the night's opening pages --><!-- 2026-10-23 (Sam: "get rid of the next for now, unless you choose an option and get the highlighted path. Otherwise it is over determined"): the NEXT line is gone; Next Target still runs, for the rest rule and the primer's timing -->(display: "Next Shown")(if: $nextShown)[(display: "Next Target")]
(if: $hasLiver is true and ($confidence is a number and $sobriety is a number) and ($confidence < 10 or $sobriety < 10))[<div class="liver-hint">‘You’re running on fumes. Remember: Shelley’s liver in your notebook.’</div>]
(set: _backHide to (a: "Talk to the critic", "The critic's judgement", "None of us likes it!", "Turn to Copper", "Copper confronts", "Beaten", "St. John's Word", "Standing", "His round", "Talk to the Artists", "The Spanish Artist", "Sketch the Painter", "Shana Looks Again", "O'Flatterly introduction", "Lackland's Back Room", "Watch the decider", "You notice her", "You give him Red", "You give him John", "Title", "Start", "The Night Ahead", "Name Your Book", "Dedicate Your Book", "Dawn", "White page", "Black page", "Dawn Approach White", "Dawn Approach Black", "Alba Complete", "Alba Incomplete", "PP Pong", "Ride Jeffrey Bernard's cow", "Fight starts", "Fight Victory", "Fight Defeat", "The phone call", "Lily phone call 1", "The dual ring", "After the dual ring", "After the call", "After Aoife", "The Painter's Gaze", "The Set", "Shana Reads", "Davy Merkin", "Return the page", "Give him the painting", "Bar Canvas Win", "Bar Canvas Lose", "Shana's Verdict", "Copper Word Accepted", "Stand your ground", "Approach the novelist", "Benito's Hour"))
<div class="header-links">(unless: _backHide contains (passage:)'s name)[(set: _exitTo to "")(if: (passage:)'s tags contains "venue-french")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-colony")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-ronnies")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-coach")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-gents")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-trishas")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-lackland")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-lackland-back")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-cecilcourt")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-pillars")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-cellar")[(set: _exitTo to "Dean Street")](else-if: (passage:)'s tags contains "venue-chippy")[(set: _exitTo to "Dean Street")](unless: _exitTo is "")[<div class="back-one-link dss-exit-reserve">(link-goto: "← Out onto the street", _exitTo)</div><script>(function(){ /* 2026-10-20 (Sam: "I'd rather people used the in-world exits"): this way out stays in the page, hidden, for the rooms' doors to press. It shows only where nothing else leads on: a room whose 3D did not come up, or a page with no link of its own. Lost WebGL shows it by CSS. */ if (window._dssExitGuard) { window._dssExitGuard(); return; } var ROOMS = '#fi-container, #ci-container, #pi-container, #ri-container, #cb-container, #ti-container, #lk-container, #oi-container, #cf-container'; var SKIP = '.header-links, .stat-bars, #stat-bars-lifted, tw-dialog, .notebook-link, .lore-box, #dss-notebook'; var timer = null; function check() { timer = null; var d = document.querySelector('.header-links .back-one-link.dss-exit-reserve'); if (!d) return; var p = document.querySelector('tw-passage'); var room = p && p.querySelector(ROOMS); var need = true; if (room) need = !room.querySelector('canvas'); else { var ls = document.querySelectorAll('tw-passage tw-link, tw-passage .enchantment-link, tw-story > .dss-threshold tw-link, tw-story > .dss-threshold .enchantment-link'); /* a plain page's words move into its panel (.dss-threshold) */ for (var i = 0; i < ls.length; i++) { if (ls[i].closest(SKIP) || !ls[i].getClientRects().length) continue; need = false; break; } } d.classList.toggle('dss-exit-needed', need); } function soon() { if (!timer) timer = setTimeout(check, 700); } window._dssExitGuard = soon; new MutationObserver(soon).observe(document.querySelector('tw-story') || document.body, { childList: true, subtree: true }); soon(); })();</script>]]
(unless: $notebook is a string)[(set: $notebook to "held")](if: $notebook is "stolen")[<div class="notebook-link notebook-gone" title="Your notebook was taken in Bourchier Street.">NOTEBOOK</div>](else:)[<div class="notebook-link">(link-repeat: "NOTEBOOK")[(display: "Build Notebook")]</div>]
</div>
</div>
(unless: $prevCigsTonight is a number)[(set: $prevCigsTonight to ($cigsTonight + 0))]\
(if: $cigsTonight is a number and $cigsTonight > $prevCigsTonight)[<script>if(window.startBurningCigarette)window.startBurningCigarette();</script>]\
(set: $prevCigsTonight to $cigsTonight)\
(set: $prevConfidence to $confidence)(set: $prevSobriety to $sobriety)<script>(function(){try{var b=document.getElementById('stat-bars-lifted')||document.querySelector('.stat-bars');if(!b)return;var d=b.querySelectorAll('.stat-delta');if(!d.length)return;/* 2026-10-29 (Sam, playtest note 3: the changes "seemed entirely arbitrary"; his pick: show the reason): each change names the choice that brought it */var lc=window._dssLastChoice;if(lc&&Date.now()-lc.at<90000&&lc.text){for(var w=0;w<d.length;w++){if(d[w].querySelector('.stat-why'))continue;var sw=document.createElement('span');sw.className='stat-why';sw.textContent=' · '+lc.text;d[w].appendChild(sw);}}for(var i=0;i<d.length;i++){d[i].style.animationPlayState='paused';}var gen=window._passageGen,done=false,t0=Date.now(),lastSeen=0;function play(){if(done)return;done=true;for(var j=0;j<d.length;j++){d[j].style.animationPlayState='running';}}function up(){if(window._drinkPopupOpen===true)return true;return !!document.querySelector('.dss-rules-overlay,#coin-overlay,#match-overlay,#cig-overlay,#eat-overlay,#dss-key-overlay,#liver-eat-overlay,#napkin-popup-overlay,#drink-popup-overlay,#spew-popup-overlay,.coach-plumbing-intro,#dss-lore-overlay,#dss-gate-flash');}setTimeout(play,25000);(function loop(){if(done)return;if(window._passageGen!==gen){play();return;}var n=Date.now();if(up()){lastSeen=n;setTimeout(loop,100);return;}if(lastSeen===0?(n-t0>750):(n-lastSeen>1200)){play();return;}setTimeout(loop,100);})();}catch(e){}})();</script>
(if: $afterMidnight is true)[<span id="dst-after-midnight" style="display:none"></span>]
