placeMesh(rightBuilding, new THREE.BoxGeometry(0.7, 0.02, 0.02), windowFrame, rwx, rwy - 0.35, 0.09);
placeMesh(rightBuilding, new THREE.BoxGeometry(0.7, 0.015, 0.02), windowFrame, rwx, rwy + 0.55, 0.09);
placeMesh(rightBuilding, new THREE.BoxGeometry(0.7, 0.015, 0.02), windowFrame, rwx, rwy - 0.55, 0.09);
// Stone sill
