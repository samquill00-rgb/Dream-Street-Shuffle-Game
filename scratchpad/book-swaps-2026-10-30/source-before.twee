filter="url(#fsBlurSoft)"/><ellipse cx="0" cy="15" rx="4.5" ry="16" fill="#0b1016" opacity="0.08" filter="url(#fsBlurSoft)"/><path d="M-17,0 C-16,-20 -15,-34 -15,-45 C-16,-70 -19,-80 -20,-88 C-14,-94 -8,-96 -4,-96 C-4.5,-101 -4.5,-104 -4,-105 C-7.5,-108 -8.5,-112 -8.5,-116 C-8.5,-123 -4.5,-127 0,-127 C4.5,-127 8.5,-123 8.5,-116 C8.5,-112 7.5,-108 4,-105 C4.5,-104 4.5,-101 4,-96 C8,-96 14,-94 20,-88 C19,-80 16,-70 15,-45 C15,-34 16,-20 17,0 Z" fill="#0b1016" opacity="0" filter="url(#fsBlurMid)"><animate attributeName="opacity" values="0;0.8;0.95;0.95" keyTimes="0;0.3;0.85;1" begin="0.6s" dur="6.2s" fill="freeze"/><animate attributeName="opacity" values="0.95;0.8" begin="13.7s" dur="6.5s" fill="freeze"/></path><g opacity="0" filter="url(#fsBlurSoft)"><animate attributeName="opacity" values="0;0.75" begin="1.6s" dur="1.8s" fill="freeze"/><animate attributeName="opacity" values="0.75;0" begin="13.0s" dur="0.4s" fill="freeze"/><path d="M-4,-112 Q0,-112.6 4,-112" stroke="#c4d5dc" stroke-width="1.1" stroke-linecap="round" fill="none"><animate attributeName="d" values="M-4,-112 Q0,-112.6 4,-112;M-4,-112 Q0,-111.6 4,-112;M-4,-112 Q0,-112.9 4,-112;M-4,-112 Q0,-112 4,-112;M-4,-112 Q0,-112.6 4,-112" dur="1.7s" repeatCount="indefinite" end="8.6s"/><animate attributeName="d" values="M-4,-112 Q0,-112.3 4,-112;M-5.5,-111.9 Q0,-108.2 5.5,-111.9" begin="8.9s" dur="1.6s" calcMode="spline" keySplines="0.4 0 0.5 1" fill="freeze"/><animate attributeName="d" values="M-5.5,-111.9 Q0,-108.2 5.5,-111.9;M-4,-112 Q0,-112.3 4,-112" begin="11.9s" dur="1s" calcMode="spline" keySplines="0.4 0 0.5 1" fill="freeze"/><animate attributeName="stroke-width" values="1.1;1.5" begin="8.9s" dur="1.6s" fill="freeze"/><animate attributeName="stroke-width" values="1.5;1.1" begin="11.9s" dur="1s" fill="freeze"/></path><path d="M-3.5,-109.6 Q0,-108.9 3.5,-109.6" stroke="#aabfc8" stroke-width="1.2" stroke-linecap="round" fill="none" opacity="0.85"><animate attributeName="d" values="M-3.5,-109.6 Q0,-108.9 3.5,-109.6;M-3.5,-109.6 Q0,-107.9 3.5,-109.6;M-3.5,-109.6 Q0,-109.3 3.5,-109.6;M-3.5,-109.6 Q0,-108.1 3.5,-109.6;M-3.5,-109.6 Q0,-108.9 3.5,-109.6" dur="1.7s" repeatCount="indefinite" end="8.6s"/><animate attributeName="d" values="M-3.5,-109.6 Q0,-108.9 3.5,-109.6;M-5,-110.6 Q0,-106.4 5,-110.6" begin="8.9s" dur="1.6s" calcMode="spline" keySplines="0.4 0 0.5 1" fill="freeze"/><animate attributeName="d" values="M-5,-110.6 Q0,-106.4 5,-110.6;M-3.5,-109.6 Q0,-108.9 3.5,-109.6" begin="11.9s" dur="1s" calcMode="spline" keySplines="0.4 0 0.5 1" fill="freeze"/><animate attributeName="stroke-width" values="1.2;1.5" begin="8.9s" dur="1.6s" fill="freeze"/><animate attributeName="stroke-width" values="1.5;1.2" begin="11.9s" dur="1s" fill="freeze"/></path></g></g></g></g></g></g><ellipse cx="150" cy="152" rx="190" ry="16" fill="#e6eef1" opacity="0.5" filter="url(#fsBlurBig)"><animateTransform attributeName="transform" type="translate" values="0 0; 16 -2; 0 0" dur="19s" repeatCount="indefinite"/><animate attributeName="opacity" values="0.38;0.06" begin="2s" dur="3s" fill="freeze"/><animate attributeName="opacity" values="0.06;0.45" begin="14.2s" dur="5s" fill="freeze"/></ellipse><rect x="0" y="0" width="300" height="240" fill="url(#fsVig)"/></g></g><g font-family="Georgia, serif" font-style="italic" font-size="10.5" fill="#a8c6d2" text-anchor="middle" letter-spacing="0.3"><text x="150" y="266" opacity="0">You see yourself walking to meet you.<animate attributeName="opacity" values="0;0.92" begin="2s" dur="1.4s" fill="freeze"/></text><text x="150" y="282" opacity="0">It looks at you with a shit-eating grin<animate attributeName="opacity" values="0;0.92" begin="9.2s" dur="1.4s" fill="freeze"/></text><text x="150" y="298" opacity="0">then turns away and heads towards Centre Point.<animate attributeName="opacity" values="0;0.92" begin="13.4s" dur="1.5s" fill="freeze"/></text></g></svg>

:: Which drink at the Pillars? [venue-pillars] {"position":"200,1150","size":"100,100"}
<!-- House drink pattern (matches the French/Colony): sobriety -8, morale +5,
     $lastDrink feeds the pour popup + fight dimming. $resumingFromCall set so
     the return to Entering The Pillars skips its per-entry sobriety charge
     (the drink already paid). -->
