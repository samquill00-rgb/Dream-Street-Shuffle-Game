      ctx.fillStyle='#a29986';ctx.fillRect(0,0,w,h);
      for(var f=0;f<75;f++) {
        var x=f*w/75;ctx.strokeStyle=f%4?'rgba(61,57,47,0.25)':'rgba(225,214,189,0.38)';
