Array.prototype.forEach.call(card.querySelectorAll('.dss-card-keyart svg'), function(s) { s.style.cssText = 'display:block;height:54px;width:auto;margin:0 auto 4px;filter:drop-shadow(0 0 6px rgba(240,220,170,0.25));'; });
var row = card.querySelector('.fi-actions');
if (row) acts.forEach(function(link) {
var b = document.createElement('span');
b.className = 'fi-action'; b.textContent = window.dssLoreLabel ? window.dssLoreLabel(link.textContent.trim()) : link.textContent.trim(); b.style.cssText = BTN; keyable(b);
