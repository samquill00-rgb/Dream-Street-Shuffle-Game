function glowNear(ev) {
var wr = wrap.getBoundingClientRect(), px = ev.clientX - wr.left, py = ev.clientY - wr.top, best = null, bd = 26 * 26;
restGlows.forEach(function(g) { if (!g.on || !g.sp) return; var a = glowAt(g); if(a.z < -1 || a.z >= 1 || a.x < 0 || a.y < 0 || a.x > wr.width || a.y > wr.height)return; var d = (a.x - px) * (a.x - px) + (a.y - py) * (a.y - py); if (d < bd) { bd = d; best = g; } });
return best;
}
