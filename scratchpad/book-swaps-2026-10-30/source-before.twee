  x.restore();
}
function drawFrontGlow(halo, pool, doors) {
  var st = function(id){ return doors[id].status; };
  frontageTiles(doorById('ronnies')).forEach(function(n){ if (st('ronnies') !== 'shut') halo(n[0]*T + 8, n[1]*T + 8, 26, [255,92,196], 0.42); });
  if (st('ronnies') !== 'shut') pool(28*T + 8, 23*T + 8, 22, 30, [255,92,196], 0.2);
  frontageTiles(doorById('chippy')).forEach(function(n){ if (st('chippy') === 'open') halo(n[0]*T + 8, n[1]*T + 8, 28, [255,226,140], 0.38); });
  frontageTiles(doorById('french')).forEach(function(n){ halo(n[0]*T + 8, n[1]*T + 8, 18, [220,120,90], st('french') === 'shut' ? 0.05 : 0.16); });
  frontageTiles(doorById('colony')).forEach(function(n){ halo(n[0]*T + 8, n[1]*T + 8, 16, [140,220,120], st('colony') === 'shut' ? 0.03 : 0.14); });
  frontageTiles(doorById('lackland')).forEach(function(n){ halo(n[0]*T + 8, n[1]*T + 8, 14, [120,200,120], st('lackland') === 'shut' ? 0.03 : 0.12); });
  frontageTiles(doorById('trishas')).forEach(function(n){ halo(n[0]*T + 8, n[1]*T + 12, 12, [255,140,200], st('trishas') === 'shut' ? 0.03 : 0.16); });
  frontageTiles(doorById('coach')).forEach(function(n){ halo(n[0]*T + 8, n[1]*T + 8, 18, [232,200,120], st('coach') === 'shut' ? 0.04 : 0.16); });
  frontageTiles(doorById('pillars')).forEach(function(n){ halo(n[0]*T + 8, n[1]*T + 8, 18, [200,220,240], st('pillars') === 'shut' ? 0.04 : 0.14); });
  for (var fr = 10; fr <= 16; fr++) if (fr !== 12) pool(48*T + 4, fr*T + 8, 16, 12, [235,200,130], 0.16);
  halo(45*T, 7*T + 9, 16, [255,208,112], 0.22);
}

// the sky band across the top of the VIEW: stars and moon fixed, the far roofs drifting a
// little, Centre Point standing over the head of Dean Street (half-speed parallax)
function drawSky(x, doors, camX) {
  var sh = SKY*T;
  var g = x.createLinearGradient(0, 0, 0, sh); g.addColorStop(0, '#05050a'); g.addColorStop(1, '#12121c');
  x.fillStyle = g; x.fillRect(0, 0, W, sh);
  for (var i = 0; i < 26; i++) { var sx = Math.floor(seeded(i, 3, 11) * W), sy = Math.floor(seeded(i, 5, 12) * (sh - 14)); x.fillStyle = seeded(i, 7, 13) > 0.6 ? '#d8d4e6' : '#8c8aa0'; x.fillRect(sx, sy, 1, 1); }
  x.fillStyle = '#e9e2cf'; x.beginPath(); x.arc(W - 46, 12, 6, 0, Math.PI*2); x.fill();
  x.fillStyle = '#12121c'; x.beginPath(); x.arc(W - 43, 10, 5, 0, Math.PI*2); x.fill();
  var phaseEl = document.querySelector('.night-phase[data-night-phase]');
  var phase = Math.max(0, Math.min(3, Number(phaseEl && phaseEl.dataset.nightPhase) || 0));
  var nightFrac = 1 - phase * 0.22; window.__dssNightDepth = phase / 3;
  var darkThresh = 0.70 + (1 - nightFrac) * 0.26;
  // 2026-10-13 (Sam): the Alba whole, the dawn starts behind the far roofs
  if (phase >= 3) { var dg = x.createLinearGradient(0, 0, 0, sh); dg.addColorStop(0, 'rgba(110,90,120,0)'); dg.addColorStop(0.5, 'rgba(150,108,122,0.10)'); dg.addColorStop(1, 'rgba(224,162,128,0.32)'); x.fillStyle = dg; x.fillRect(0, 0, W, sh); }
  // far roofs: seeded by world column so they drift with the camera at a third of its speed
  var roofShift = Math.floor(camX / 3);
  x.fillStyle = '#0c0c13';
  for (var c = -1; c <= VC; c++) { var wc = c + Math.floor(roofShift / T); var hgt = 4 + Math.floor(seeded(wc, 9, 14) * 9); var rx = c*T - (roofShift % T); x.fillRect(rx, sh - hgt, T, hgt); if (seeded(wc, 9, 15) > 0.7) x.fillRect(rx + 5, sh - hgt - 4, 3, 4); if (seeded(wc, 11, 17) > (0.55 + (1 - nightFrac) * 0.4)) { x.fillStyle = '#6a5a3a'; x.fillRect(rx + 9, sh - hgt + 2, 2, 2); x.fillStyle = '#0c0c13'; } }
  var tx = 17*T + 3 - Math.round(camX * 0.5), tw = 26, ty = 2, th = sh - 2;
  var open = doors.north.status === 'open';
  if (open) { var hg = x.createRadialGradient(tx + tw/2, sh - 6, 2, tx + tw/2, sh - 6, 46); hg.addColorStop(0, 'rgba(226,178,148,0.5)'); hg.addColorStop(1, 'rgba(226,178,148,0)'); x.fillStyle = hg; x.fillRect(tx - 40, 0, tw + 80, sh); }
  x.fillStyle = '#0a0a11'; x.fillRect(tx, ty, tw, th);
  x.fillStyle = '#16161f'; x.fillRect(tx + 1, ty, 1, th); x.fillRect(tx + tw - 2, ty, 1, th);
  for (var wy = ty + 3; wy < th - 2; wy += 4) for (var wx = tx + 3; wx < tx + tw - 3; wx += 4) {
    var lit = seeded(wx - tx, wy, 16) > (open ? 0.35 : darkThresh);
    x.fillStyle = lit ? (open ? '#e2b294' : '#8a7a5a') : '#14141c'; x.fillRect(wx, wy, 2, 2);
  }
}
function buildBase(doors) {
  var cv = document.createElement('canvas'); cv.width = WW; cv.height = WH;
  var x = cv.getContext('2d');
  WIN_BLINK.length = 0; CHIMNEYS.length = 0; WARM_WINS.length = 0; RED_WINS.length = 0;
  for (var r = 0; r < ROWS; r++) for (var c = 0; c < COLS; c++) {
    x.save(); x.translate(c*T, r*T);
    var d = doorAt(c, r), t = tileAt(c, r);
    if (d && d.id === 'cecil') drawAlley(x, d, doors.cecil.status);
    else if (d && !d.spot) drawDoorTile(x, c, r, d, doors[d.id].status);
    else if (t === 'R') drawRoad(x, c, r);
    else if (t === 'P') drawPave(x, c, r);
    else if (t === 'A') drawAlleyTile(x, c, r);
    else if (t === 'G') drawGarden(x, c, r);
    else if (isFacade(c, r)) drawFacade(x, c, r, null);
    else drawRoof(x, c, r);
    x.restore();
  }
  // railings round the square's garden
  drawSquareFence(x);
  DOORS.forEach(function(d){
    if (d.spot) return;
    if (doors[d.id].status === 'open') {
      var side = doorSide(d), nbs = (side === 'n' || side === 's') ? [[d.c-1, d.r],[d.c+1, d.r]] : [[d.c, d.r-1],[d.c, d.r+1]];
      nbs.forEach(function(n){ if (inBounds(n[0], n[1]) && isFacade(n[0], n[1]) && !doorAt(n[0], n[1])) { x.save(); x.translate(n[0]*T, n[1]*T); drawFacade(x, n[0], n[1], d.col); x.restore(); } });
    }
    x.save(); x.translate(d.fc*T, d.fr*T); drawStep(x, d); x.restore();
  });
  drawFronts(x, doors);
  LAMPS.forEach(function(l){ x.save(); x.translate(l.c*T, l.r*T); drawLampPost(x, l); x.restore(); });
  var pb = doorById('phonebox');
  if (pb) { x.save(); x.translate(pb.c*T, pb.r*T); drawPhoneBox(x, doors.phonebox && doors.phonebox.status === 'open'); x.restore(); }
  // strangers are drawn in the frame loop (2026-09-25), so they can carry an after-image
  x.setTransform(1, 0, 0, 1, 0, 0);
  return cv;
}
function buildGlow(doors) {
  var cv = document.createElement('canvas'); cv.width = WW; cv.height = WH;
  var x = cv.getContext('2d');
  function smear(px, py, col, a) {
    for (var i = 0; i < 9; i++) {
      var sx = px + Math.floor((seeded(px, py, i) - 0.5) * 12), sy = py + 4 + Math.floor(seeded(px, py, i + 30) * 26), len = 2 + Math.floor(seeded(px, py, i + 60) * 6);
      var cc = Math.floor(sx / T), rr = Math.floor(sy / T);
      if (!inBounds(cc, rr) || !isRoad(cc, rr)) continue;
      x.fillStyle = rgba(col, a * (0.35 + 0.4 * seeded(sx, sy, 2))); x.fillRect(sx, sy, 1, len);
    }
  }
  function halo(px, py, rad, col, a) { var g = x.createRadialGradient(px, py, 1, px, py, rad); g.addColorStop(0, rgba(col, a)); g.addColorStop(0.55, rgba(col, a*0.35)); g.addColorStop(1, rgba(col, 0)); x.fillStyle = g; x.fillRect(px - rad, py - rad, rad*2, rad*2); }
  function pool(px, py, rx, ry, col, a) { x.save(); x.translate(px, py); x.scale(rx/ry, 1); var g = x.createRadialGradient(0, 0, 1, 0, 0, ry); g.addColorStop(0, rgba(col, a)); g.addColorStop(1, rgba(col, 0)); x.fillStyle = g; x.fillRect(-ry, -ry, ry*2, ry*2); x.restore(); }
  LAMPS.forEach(function(l){ if (lampOut(l)) return; halo(l.c*T + 8, l.r*T + 3, 30, l.ginger ? [232,134,42] : [217,164,65], l.ginger ? 0.28 : 0.18); [[-1,0],[1,0],[0,1],[0,-1]].forEach(function(d){ if (inBounds(l.c + d[0], l.r + d[1]) && isRoad(l.c + d[0], l.r + d[1])) smear((l.c + d[0])*T + 8, (l.r + d[1])*T - 2, l.ginger ? [232,134,42] : [217,164,65], 0.5); }); });
  // what the corner keeps (2026-09-25): once a stranger is met their pool is gone, and a trace of
  // it stays on the pavement, cold now, a fraction of what it was, the way the rooms leave a colour
  DOORS.forEach(function(d){
    if (!(d.stranger || d.fetch) || doors[d.id].status === 'open') return;
    var el = document.querySelector('.dss-hub-flag[data-k="met-' + d.id + '"]'); if (!el || el.textContent.trim() !== 'on') return;
    pool(d.c*T + 8, d.r*T + 12, 20, 10, d.col, 0.18); halo(d.c*T + 8, d.r*T + 12, 12, [150,170,210], 0.10);
  });
  DOORS.forEach(function(d){
    var st = doors[d.id].status; if (st === 'shut') return;
    var a = st === 'open' ? 0.82 : 0.18;
    // 2026-10-12 (item 6): while NEXT names another open door, a venue's light on the street is turned down too
    var nxEl = document.querySelector('.dss-hub-flag[data-k="next"]'), nxD = nxEl ? nxEl.textContent.trim() : ''; if (st === 'open' && !d.event && nxD && nxD !== d.id && doors[nxD] && doors[nxD].status === 'open') a = a * 0.5;
    if (d.id === 'north') { return; }
    if (d.event) {
      if (d.hidden || st !== 'open') return;
      if (d.id === 'phonebox') { halo(d.c*T + 8, d.r*T + 6, 22, d.col, 0.34); pool(d.c*T + 8, d.r*T + 12, 24, 13, d.col, 0.40); return; }
      if (d.stranger) { halo(d.c*T + 8, d.r*T + 6, 20, d.col, 0.26); pool(d.c*T + 8, d.r*T + 12, 22, 12, d.col, 0.32); [[0,1],[-1,0],[1,0]].forEach(function(o){ if (inBounds(d.c + o[0], d.r + o[1]) && isRoad(d.c + o[0], d.r + o[1])) smear((d.c + o[0])*T + 8, (d.r + o[1])*T - 2, d.col, 0.45); }); return; }
      if (d.fetch) return;
      // A signed doorway is a place you go on purpose, so it carries a doorway's
      // worth of light rather than an alley's hint of one. Unsigned alleys keep
      // the faint smudge — those ARE meant to be stumbled into.
      if (d.sign) { halo(d.c*T + 8, d.r*T + 6, 17, d.col, 0.30); pool(d.c*T + 8, d.r*T + 10, 22, 14, d.col, 0.42); return; }
      pool(d.c*T + 8, d.r*T + 8, 22, 14, d.col, 0.22); return;
    }
    var side = doorSide(d);
    // Quiet doors (a doorway, not a venue) get a fraction of the light.
    if (d.quiet) a = a * 0.28;
    var dx = d.c*T + 8, dy = d.r*T + 8;
