      rwx, rwy, 0.07);
    placeMesh(rightBuilding, new THREE.BoxGeometry(0.02, 1.2, 0.02), windowFrame, rwx, rwy, 0.08);
    placeMesh(rightBuilding, new THREE.BoxGeometry(0.6, 0.02, 0.02), windowFrame, rwx, rwy, 0.08);
