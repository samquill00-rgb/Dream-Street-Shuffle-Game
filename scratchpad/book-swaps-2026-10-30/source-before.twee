function keyTaken(off) {
setTimeout(function() {
var notes = off.querySelectorAll('.claude-draft:not(.dss-key-blurb)'), msg = notes.length ? notes[notes.length - 1].textContent.trim() : '';
if (msg && window.dssInlineHint) window.dssInlineHint(msg);
