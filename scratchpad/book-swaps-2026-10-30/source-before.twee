:: Rescue the page [dream pyre] {"position":"100,1850","size":"100,100"}
You pause, for a whole long minute, and think of yourself, so as to become, Trelawny, salvaging what he thought was Shelley’s heart from the flaming corpse, and punch a fist into the flames to rescue the paper.

(set: $hasMissingPage to true)

<div class="page-found"><svg class="page-emerge" viewBox="0 0 80 110" aria-hidden="true"><defs><radialGradient id="p47Glow" cx="50%" cy="100%" r="80%"><stop offset="0%" stop-color="#ffc068" stop-opacity="0.75"/><stop offset="40%" stop-color="#d4600a" stop-opacity="0.35"/><stop offset="100%" stop-color="#0a0a12" stop-opacity="0"/></radialGradient><linearGradient id="p47Paper" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#f3e5c4"/><stop offset="55%" stop-color="#e6d4a8"/><stop offset="100%" stop-color="#c6ad84"/></linearGradient><linearGradient id="p47Spine" x1="0" x2="1"><stop offset="0%" stop-color="rgba(58,38,18,0.35)"/><stop offset="100%" stop-color="rgba(58,38,18,0)"/></linearGradient><filter id="p47Grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="2.4" numOctaves="2" seed="4"/><feColorMatrix values="0 0 0 0 0.36  0 0 0 0 0.26  0 0 0 0 0.16  0 0 0 0.16 0"/><feComposite in2="SourceGraphic" operator="in"/></filter><path id="p47Shape" d="M15.7,11.4 Q21,10.6 27,11.1 Q34,10.5 40,11.4 Q47,10.6 53,11.3 Q60,10.8 66.3,11.2 L66.7,18 Q66.3,28 66.6,38 Q66.2,50 66.5,62 Q66.3,75 66.5,88 L66.5,93 L15.5,93 L15.3,85 Q15.6,72 15.4,58 Q15.7,46 15.4,34 Q15.6,22 15.4,11.4 Z"/></defs><g filter="url(#dss-ink-fine)"><ellipse cx="40" cy="100" rx="48" ry="18" fill="url(#p47Glow)"/><g transform="rotate(-1.4 40 55)"><use href="#p47Shape" fill="rgba(0,0,0,0.30)" transform="translate(1.5,2)"/><use href="#p47Shape" fill="url(#p47Paper)"/><use href="#p47Shape" filter="url(#p47Grain)" opacity="0.6"/><rect x="15.5" y="11" width="5" height="82" fill="url(#p47Spine)"/><text x="62" y="22.5" text-anchor="end" font-family="Georgia, serif" font-size="6.4" fill="#3a2818" opacity="0.72" font-style="italic">47</text><g fill="#3a2818" opacity="0.66"><rect x="20" y="31" width="9" height="1.2"/><rect x="30.5" y="31" width="13" height="1.2"/><rect x="45" y="31" width="6" height="1.2"/><rect x="52.5" y="31" width="10.5" height="1.2"/><rect x="20" y="36" width="11" height="1.2"/><rect x="32.5" y="36" width="8" height="1.2"/><rect x="42" y="36" width="13" height="1.2"/><rect x="56.5" y="36" width="6.5" height="1.2"/><rect x="20" y="41" width="6" height="1.2"/><rect x="27.5" y="41" width="12" height="1.2"/><rect x="41" y="41" width="9" height="1.2"/><rect x="51.5" y="41" width="11.5" height="1.2"/><rect x="20" y="46" width="14" height="1.2"/><rect x="35.5" y="46" width="7" height="1.2"/><rect x="44" y="46" width="9" height="1.2"/><rect x="23.5" y="54" width="8" height="1.2"/><rect x="33" y="54" width="11" height="1.2"/><rect x="45.5" y="54" width="13" height="1.2"/><rect x="20" y="59" width="10" height="1.2"/><rect x="31.5" y="59" width="14" height="1.2"/><rect x="47" y="59" width="6" height="1.2"/><rect x="54.5" y="59" width="8.5" height="1.2"/><rect x="20" y="64" width="11" height="1.2"/><rect x="32.5" y="64" width="9" height="1.2"/><rect x="43" y="64" width="13" height="1.2"/><rect x="57.5" y="64" width="5.5" height="1.2"/><rect x="20" y="69" width="8" height="1.2"/><rect x="29.5" y="69" width="11" height="1.2"/><rect x="42" y="69" width="10" height="1.2"/><rect x="20" y="74" width="12" height="1.2"/><rect x="33.5" y="74" width="9" height="1.2"/><rect x="44" y="74" width="13" height="1.2"/><rect x="58.5" y="74" width="4.5" height="1.2"/><rect x="20" y="79" width="7" height="1.2"/><rect x="28.5" y="79" width="11" height="1.2"/><rect x="41" y="79" width="14" height="1.2"/></g><path d="M15.5,85 Q26,89 36,86 Q46,90 56,87 Q63,91 66.5,88 L66.5,93 L15.5,93 Z" fill="#2a1408" opacity="0.55"/><path d="M15.5,89 Q26,91 36,90 Q46,92 56,90 Q63,92 66.5,91 L66.5,93 L15.5,93 Z" fill="#0c0502" opacity="0.7"/><path d="M19,89 Q22,93 24,91 Q20,94 19,89 Z" fill="#180802"/><path d="M32,90 Q36,93 38,91 Q33,94 32,90 Z" fill="#180802"/><path d="M49,89 Q53,93 54,90 Q50,94 49,89 Z" fill="#180802"/><path d="M60,90 Q63,93 64,91 Q61,94 60,90 Z" fill="#180802"/></g></g></svg>
<div class="page-found-header">⟡ PAGE 93 ⟡</div>
<div class="page-found-body">You have Page 93. Return it to INIS O’FLATTERLY in Cecil Court.</div>
</div>

