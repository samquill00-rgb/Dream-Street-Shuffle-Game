  function scan() { Array.prototype.forEach.call(document.querySelectorAll('.soho-map svg:not([data-trace])'), draw); }
  var q = false;
  function watch() { new MutationObserver(function() { if (q) return; q = true; setTimeout(function() { q = false; scan(); }, 80); }).observe(document.body, { childList: true, subtree: true }); }
  if (document.body) watch(); else document.addEventListener('DOMContentLoaded', watch);
})();
window.dssLoreLabel = function(t) { return /^\s*(?:⟡\s*)?LORE:/.test(t || '') ? '⟡ ' + String(t).replace(/^\s*(?:⟡\s*)?LORE:\s*/, '').replace(/\s*⟡\s*$/, '').trim() : t; };
// 2026-10-13 (Sam): a refused call leaves its card up ("Back to the bar") over a veil that takes every click,
// so the room behind (the Great Ham) could not be clicked; a click outside the card now goes back to the bar
document.addEventListener('pointerdown', function(ev) {
  var t = ev.target; if (!t || !t.closest || t.closest('.phone-ringing')) return;
  if (t.closest('tw-link, button, a, input, select, textarea, [role="button"], tw-include[type="header"], .stat-bars, #dss-lore-overlay')) return;
  var back = Array.prototype.find.call(document.querySelectorAll('.phone-ringing tw-link'), function(l) { return l.getClientRects().length && /^back to the bar$/i.test(l.textContent.trim()); });
  if (!back) return;
  ev.preventDefault(); ev.stopPropagation(); back.click();
}, true);
// 2026-10-14 (overnight report, Sam: fix): Escape on a hand-held card (coin, matches, key, flower, errand) presses its one
// putting-away button, as the notebook and the slips already close on Escape; a card offering a choice (two buttons) is left alone
document.addEventListener('keydown', function(ev) {
  if (ev.key !== 'Escape' || ev.defaultPrevented) return;
  var f = document.activeElement; if (f && /^(INPUT|TEXTAREA|SELECT)$/.test(f.tagName)) return;
  var cards = document.querySelectorAll('#coin-overlay, #match-overlay, #dss-key-overlay, #dss-quest-overlay, #dss-lily-overlay');
  for (var i = cards.length - 1; i >= 0; i--) {
    var c = cards[i]; if (!c.getClientRects().length || getComputedStyle(c).display === 'none') continue;
    var btns = Array.prototype.filter.call(c.querySelectorAll('button, tw-link'), function(b) { return b.getClientRects().length; });
    // only a button that puts the card away (Pocket them, On., the flower's), never an action such as Toss it
    var b0 = btns.length === 1 && btns[0];
    if (b0 && (b0.matches('.coin-overlay-dismiss, .dss-key-leave, .dss-lily-close') || (b0.matches('.dss-quest-go') && b0.textContent.trim() === 'On.'))) { ev.preventDefault(); ev.stopPropagation(); b0.click(); }
    return;
  }
}, true);
// 2026-10-14 (Sam): the Watkins window as a vision (see the passage). Splits his three paragraphs into letters and
// words without changing a character, then stages them; a click or a key shows everything at once.
// The waltz, twice-muffled (Sam): the waltz minigame's own track, low and filtered as if through the glass, with a fainter
// late copy (the inner ear); it fades as you leave, and the waltz game starts it again properly
window.dssWatkinsMuffled = function() {
  var src = window._waltzMiniDataUri || ''; if (!src || src.indexOf('__DSS_') === 0) return { stop: function() {} };
  var muted = function() { return !!(window.dssAudio && window.dssAudio.isMuted && window.dssAudio.isMuted()); };
  try {
    var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return { stop: function() {} };
    var ac = new AC(), el = new Audio(); el.crossOrigin = 'anonymous'; el.src = src; el.loop = true;
    var node = ac.createMediaElementSource(el), lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 260; lp.Q.value = 0.5;
    var out = ac.createGain(); out.gain.value = 0;
    var dly = ac.createDelay(1.0); dly.delayTime.value = 0.16; var echo = ac.createGain(); echo.gain.value = 0.35;
    var lp2 = ac.createBiquadFilter(); lp2.type = 'lowpass'; lp2.frequency.value = 190;
    node.connect(lp); lp.connect(out); lp.connect(dly); dly.connect(lp2); lp2.connect(echo); echo.connect(out); out.connect(ac.destination);
    var level = 0.42, stopped=false;
    if (ac.state === 'suspended') ac.resume().catch(function() {});
    el.play().catch(function() {});
    out.gain.linearRampToValueAtTime(muted() ? 0 : level, ac.currentTime + 1.6); /* 2026-10-19: a quicker fade in, was 2.5 s */
    var mw = setInterval(function() { try { out.gain.setTargetAtTime(muted() ? 0 : level, ac.currentTime, 0.1); } catch (e) {} }, 300);
    return { el: el, open: function(){if(ac.state==='suspended')ac.resume().catch(function(){});el.play().catch(function(){});lp.frequency.exponentialRampToValueAtTime(16000,ac.currentTime+1.8);lp2.frequency.exponentialRampToValueAtTime(9000,ac.currentTime+1.8);echo.gain.setTargetAtTime(.08,ac.currentTime,.6);}, stop: function() { if(stopped)return;stopped=true;clearInterval(mw); try { out.gain.cancelScheduledValues(ac.currentTime); out.gain.setTargetAtTime(0, ac.currentTime, 0.35); } catch (e) {} setTimeout(function() { try { el.pause(); el.src = ''; if(ac.state!=='closed')ac.close().catch(function(){}); } catch (e) {} }, 1600); } };
  } catch (e) { return { stop: function() {} }; }
};
