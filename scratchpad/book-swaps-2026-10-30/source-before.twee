(link: "Challenge Jack Curtis")[(set: $ppScore to 0)(set: $oppScore to 0)(set: $opponent to "Jack Curtis")(go-to: "PP Pong")]
(link: "Challenge Percy Ritson")[(set: $ppScore to 0)(set: $oppScore to 0)(set: $opponent to "Percy Ritson")(go-to: "PP Pong")]</div>
