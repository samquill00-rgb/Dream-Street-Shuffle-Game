 for(var wear=0;wear<520;wear++){cx.fillStyle=wear%4?'rgba(229,218,191,0.25)':'rgba(88,74,50,0.12)';cx.fillRect((wear*47+style*13)%256,(wear*83)%256,1+wear%4,1+wear%3);}
 cx.globalCompositeOperation='destination-out';
