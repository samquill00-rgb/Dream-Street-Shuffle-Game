bottle(sx + (rnd(row + b * 3) - 0.5) * 0.06, sy, -2.3 + b * 0.25 + (rnd(b + row * 9) - 0.5) * 0.06, botCols[(b + row * 3) % botCols.length], 0.2 + rnd(b * 5 + row) * 0.14, 0.03 + rnd(b * 2 + row) * 0.012);
}
