  // ----- Soho map street life (2026-09-11 sound pass) -----
  // Small, un-ducked sounds for the things that move on the map: the black
  // cab crossing Old Compton Street, pigeons scattering off the pavement,
  // the passer-by's match under a lamp.
  function _noiseBuf(ac, secs, brown) {
    var n = Math.max(1, Math.floor(ac.sampleRate * secs)), buf = ac.createBuffer(1, n, ac.sampleRate), d = buf.getChannelData(0), last = 0;
    for (var i = 0; i < n; i++) { var w = Math.random() * 2 - 1; if (brown) { last = (last + 0.02 * w) / 1.02; d[i] = last * 3.5; } else d[i] = w; }
    return buf;
  }
  function mapCab() {
    _noDuckNext = true;
    _play(function(ac) {
      var now = ac.currentTime, dur = 6.8;
      var src = ac.createBufferSource(); src.buffer = _noiseBuf(ac, dur, true);
      var lp = ac.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 240; lp.Q.value = 0.8;
      var g = ac.createGain(); g.gain.setValueAtTime(0.0001, now);
      g.gain.exponentialRampToValueAtTime(0.04, now + 2.8); g.gain.setValueAtTime(0.04, now + 3.6); /* 2026-10-23 overnight: the cab's brown-noise rush read as wind over the theme; 0.075 -> 0.04, about 5.5 dB down */ g.gain.exponentialRampToValueAtTime(0.0001, now + dur);
      src.connect(lp); lp.connect(g); g.connect(ac.destination); src.start(now); src.stop(now + dur + 0.05);
