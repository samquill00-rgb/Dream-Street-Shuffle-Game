    if (stage && stage.left() && (ev.key === 'Escape' || ev.key === 'Enter' || ev.key === ' ')) { ev.preventDefault(); ev.stopPropagation(); stage.next(); return; }
    if (ev.key === 'Escape') { ev.stopPropagation(); close(); }
