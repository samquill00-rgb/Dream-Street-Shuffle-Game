      var rga = (0.10 + bed * 0.22) * (0.8 + 0.2 * Math.sin(S.t / 40 + rn.k * 2.1));
      x.fillStyle = 'rgba(214,52,44,' + rga.toFixed(3) + ')'; x.fillRect(rn.x - 1, rn.y - 1, 5, 6);
