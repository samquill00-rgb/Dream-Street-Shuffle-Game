<line x1="100" y1="246" x2="100" y2="9999" stroke-width="3.8"/><line x1="96.5" y1="250" x2="96.5" y2="9999" stroke-width="0.7" opacity="0.45"/><ellipse cx="100" cy="385" rx="13" ry="4" stroke-width="1.8"/><ellipse cx="100" cy="530" rx="13" ry="4" stroke-width="1.8"/><rect x="84" y="692" width="32" height="8" rx="2" stroke-width="1.8"/></g></svg>\
<h1 class="game-title">DREAM<br>STREET<br>SHUFFLE</h1>\
{<!-- BOOLEAN GUARDS: ensure vars are correct types on first visit (added §1.1) -->
(unless: $alba is an array)[(set: $alba to (a:))]
(unless: $haunts is an array)[(set: $haunts to (a:))]
(unless: $bookTitle is a string)[(set: $bookTitle to "Untitled Manuscript")]
(if: $bookTitle is "")[(set: $bookTitle to "Untitled Manuscript")]
(unless: $metCritic is a boolean)[(set: $metCritic to false)]
(unless: $hauntExplained is a boolean)[(set: $hauntExplained to false)]
(unless: $statsExplained is a boolean)[(set: $statsExplained to false)]
(unless: $shownLiverTip is a boolean)[(set: $shownLiverTip to false)]<!-- 2026-10-23 (the first-night map: one Dean Street visit could raise five slips into a stack of three): the lap a street slip fired on, and the lap the liver tip did -->(unless: $streetTipLap is a number)[(set: $streetTipLap to -1)](unless: $liverTipLap is a number)[(set: $liverTipLap to -1)]
(unless: $hasMatches is a boolean)[(set: $hasMatches to false)]
(unless: $pillarsMatchesDue is a boolean)[(set: $pillarsMatchesDue to false)]
<!-- THE MATCHBOX: due from the Pillars, shown on the way out (see Entering The Pillars of Hercules). -->
(if: $pillarsMatchesDue is true)[(set: $pillarsMatchesDue to false)(if: $hasMatches is false)[(set: $hasMatches to true)<div id="match-overlay" style="display:none"><div class="coin-overlay-box" role="dialog" aria-modal="true" aria-label="A box of matches"><div class="coin-overlay-stage"><svg class="match-svg" viewBox="0 0 130 84" width="130" height="84" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="mxCard" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e2c56a"/><stop offset="1" stop-color="#c39a3a"/></linearGradient><linearGradient id="mxTop" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f0d98c"/><stop offset="1" stop-color="#d4b050"/></linearGradient><linearGradient id="mxSide" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#a87f2a"/><stop offset="1" stop-color="#7a5818"/></linearGradient><linearGradient id="mxTray" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d9c48e"/><stop offset="1" stop-color="#b89a5c"/></linearGradient><pattern id="mxGrit" width="2" height="2" patternUnits="userSpaceOnUse"><rect width="1" height="1" fill="rgba(255,255,255,0.08)"/><rect x="1" y="1" width="1" height="1" fill="rgba(0,0,0,0.3)"/></pattern></defs><ellipse cx="66" cy="72" rx="52" ry="4" fill="rgba(0,0,0,0.35)"/><rect x="4" y="38" width="44" height="26" fill="url(#mxTray)" stroke="#6e4e18" stroke-width="0.8"/><path d="M4,38 L14,30 L58,30 L48,38 Z" fill="#c9b070" stroke="#6e4e18" stroke-width="0.6" stroke-linejoin="round"/><path d="M6,39.5 L46,39.5 L46,46 L6,46 Z" fill="rgba(0,0,0,0.22)"/><rect x="8.9" y="42" width="2.2" height="20" rx="0.7" fill="#efe6d0" stroke="#a89060" stroke-width="0.3"/><rect x="13.9" y="42" width="2.2" height="20" rx="0.7" fill="#efe6d0" stroke="#a89060" stroke-width="0.3"/><rect x="18.9" y="42" width="2.2" height="20" rx="0.7" fill="#efe6d0" stroke="#a89060" stroke-width="0.3"/><rect x="23.9" y="42" width="2.2" height="20" rx="0.7" fill="#efe6d0" stroke="#a89060" stroke-width="0.3"/><rect x="28.9" y="42" width="2.2" height="20" rx="0.7" fill="#efe6d0" stroke="#a89060" stroke-width="0.3"/><rect x="33.9" y="42" width="2.2" height="20" rx="0.7" fill="#efe6d0" stroke="#a89060" stroke-width="0.3"/><rect x="38.9" y="42" width="2.2" height="20" rx="0.7" fill="#efe6d0" stroke="#a89060" stroke-width="0.3"/><ellipse cx="10" cy="41" rx="1.9" ry="2.4" fill="#b83524"/><ellipse cx="15" cy="41" rx="1.9" ry="2.4" fill="#b83524"/><ellipse cx="20" cy="41" rx="1.9" ry="2.4" fill="#b83524"/><ellipse cx="25" cy="41" rx="1.9" ry="2.4" fill="#b83524"/><ellipse cx="30" cy="41" rx="1.9" ry="2.4" fill="#b83524"/><ellipse cx="35" cy="41" rx="1.9" ry="2.4" fill="#b83524"/><ellipse cx="40" cy="41" rx="1.9" ry="2.4" fill="#b83524"/><ellipse cx="9.4" cy="40.2" rx="0.6" ry="0.8" fill="#f0c9b0" opacity="0.5"/><ellipse cx="19.4" cy="40.2" rx="0.6" ry="0.8" fill="#f0c9b0" opacity="0.5"/><ellipse cx="29.4" cy="40.2" rx="0.6" ry="0.8" fill="#f0c9b0" opacity="0.5"/><ellipse cx="39.4" cy="40.2" rx="0.6" ry="0.8" fill="#f0c9b0" opacity="0.5"/><path d="M46,30 L56,20 L124,20 L114,30 Z" fill="url(#mxTop)" stroke="#6e4e18" stroke-width="0.9" stroke-linejoin="round"/><path d="M114,30 L124,20 L124,54 L114,64 Z" fill="url(#mxSide)" stroke="#6e4e18" stroke-width="0.9" stroke-linejoin="round"/><path d="M116,31 L122,25 L122,52 L116,58 Z" fill="#3a2a22"/><path d="M116,31 L122,25 L122,52 L116,58 Z" fill="url(#mxGrit)"/><rect x="46" y="30" width="68" height="34" fill="url(#mxCard)" stroke="#6e4e18" stroke-width="0.9"/><rect x="52" y="35" width="56" height="24" fill="#1f4a34" stroke="#c89a3e" stroke-width="0.6"/><rect x="54.5" y="37.5" width="51" height="19" fill="none" stroke="#e8c478" stroke-width="0.4" opacity="0.8"/><path d="M80,38.5 q-3,3.2 0,6.4 q3,-3.2 0,-6.4z M80,40.5 q-1.4,1.6 0,3.2 q1.4,-1.6 0,-3.2z" fill="#e8c478"/><text x="80" y="51" text-anchor="middle" font-family="Georgia,serif" font-weight="bold" font-size="6.6" letter-spacing="0.9" fill="#f2e6c4">MATCHES</text><text x="80" y="55.2" text-anchor="middle" font-family="Georgia,serif" font-size="2.4" letter-spacing="0.35" fill="#c8b070">SAFETY &#183; AVERAGE CONTENTS 50</text><g transform="rotate(-14 70 74)"><rect x="56" y="73" width="24" height="2.2" rx="0.8" fill="#efe6d0" stroke="#8a7a50" stroke-width="0.4"/><rect x="56" y="73" width="8" height="2.2" rx="0.8" fill="#2a2018"/><ellipse cx="55.5" cy="74.1" rx="2" ry="2.4" fill="#1a1410"/></g><g transform="rotate(22 104 68)"><rect x="92" y="67" width="22" height="2.2" rx="0.8" fill="#efe6d0" stroke="#8a7a50" stroke-width="0.4"/><ellipse cx="114.5" cy="68.1" rx="2" ry="2.5" fill="#b83524"/></g></svg></div><p class="coin-overlay-text">On the way out you swipe a box of matches from a newly-empty table. You’ve been looking for a light. Now you can smoke again.</p><span class="inventory-note">MATCHES ACQUIRED</span><button class="coin-overlay-btn coin-overlay-dismiss" id="match-keep-btn">Pocket them</button></div></div><script>(function(){var btn=document.getElementById("match-keep-btn"),o=document.getElementById("match-overlay");if(!btn||!o)return;var gen=window._passageGen;function othersBusy(){/* 2026-10-23 (the first-night map: the matches came up over THE RUMOUR): the same list as dssOverlayBusy, less this overlay itself and the three that are never made */return window._drinkPopupOpen===true||!!document.querySelector("#coin-overlay,#cig-overlay,#eat-overlay,#dss-key-overlay,#dss-lily-overlay,#dss-quest-overlay,#liver-eat-overlay,#napkin-popup-overlay,.dss-rules-overlay,#drink-popup-overlay,#spew-popup-overlay,.coach-plumbing-intro,#dss-lore-overlay,#dss-gate-flash");}function reveal(){if(window._passageGen!==gen || window._dssMatchPopupDone){if(o.parentNode)o.parentNode.removeChild(o);return;}if(othersBusy()){setTimeout(reveal,200);return;}window._dssMatchPopupDone=true;o.style.display="flex";}function close(){var box=o.querySelector(".coin-overlay-box");if(box){for(var k=1;k<=12;k++){var m=document.createElement("span");m.className="item-mote item-mote-"+k;box.appendChild(m);}}btn.style.display="none";setTimeout(function(){o.classList.add("coin-overlay-fade");setTimeout(function(){o.remove();},800);},1600);}btn.addEventListener("click",function(){/* 2026-10-29 */if(window.dssAudio&&window.dssAudio.matchboxRattle){try{window.dssAudio.matchboxRattle();}catch(e){}}close();});o.addEventListener("click",function(e){if(e.target===o)close();});reveal();})();</script>]]\
(unless: $afterMidnight is a boolean)[(set: $afterMidnight to false)]
<!-- BACK-FILL: Aoife-rework flags, added later — heal older saves so the
     (if: $aoifeRework ...) guards below never hit an undefined variable. -->
(unless: $aoifeRework is a boolean)[(set: $aoifeRework to false)]
(unless: $sawAoifeMemory2 is a boolean)[(set: $sawAoifeMemory2 to false)]
<!-- BACK-FILL: older saves may have $metCritic=true but $knowsCecilCourt=false
     because the (set:) was added later. Heal them on every Dean Street visit. -->
(if: ($knowsCecilCourt is false) and (($metCritic is true) or (($haunts is an array) and ($haunts contains $haunt2))))[(set: $knowsCecilCourt to true)]
<!-- BACK-FILL: $visited datamap was initialized with only French/Pillars/Colony.
     Add Ronnies so the Ronnie Scott's link condition doesn't throw a "no such
     data name" error on $visited's Ronnies. -->
(unless: $visited is a datamap)[(set: $visited to (dm: "French", false, "Pillars", false, "Colony", false, "Ronnies", false))]
(unless: $visited contains "Ronnies")[(set: $visited's Ronnies to false)]
<!-- STORY PACING: compatibility counter for calls and introductory beats, never a budget. -->
(unless: $alleys is an array)[(set: $alleys to (a:))](unless: $stashSites is an array)[(set: $stashSites to (a:))](unless: $worldsVisited is an array)[(set: $worldsVisited to (a:))](if: $alleyReturn is true)[(set: $alleyReturn to false)](else:)[(set: $returns to $returns + 1)](set: $ringSnoozed to false)(set: $resumingFromCall to false)
<!-- STATS PRIMER moved out of the hub: it now fires on first entering The
     French (your first venue), where confidence first jumps +12 and the bars
     visibly move — so it never lands on the opening Dean Street beat. -->\
<!-- OPEN NIGHT: walking and returning to the hub never drain condition.
     $returns is only a monotonic visit count for introductory beats and calls. -->
<!-- STAT CLAMPS: 0..100 belt-and-braces. The asymptotic $statGain curve
     already prevents stats from sitting on the ceiling, so we no longer
     need an artificial morale ceiling at 90. -->
(if: $confidence > 100)[(set: $confidence to 100)]
(if: $confidence < 0)[(set: $confidence to 0)]
(if: $sobriety > 100)[(set: $sobriety to 100)]
(if: $sobriety < 0)[(set: $sobriety to 0)]
(if: $sobriety <= 0 and $haunts's length >= 10)[(set: $coachUrgent to true)](else:)[(set: $coachUrgent to false)(if: $sobriety <= 0)[(set: $sobriety to 5)]]
<!-- DERIVED FLAGS: computed each visit -->
(set: _towerReady to ($alba contains $alba1) and ($alba contains $alba2) and ($alba contains $alba3))\
(set: _albaCount to 0)(if: $alba contains $alba1)[(set: _albaCount to _albaCount + 1)](if: $alba contains $alba2)[(set: _albaCount to _albaCount + 1)](if: $alba contains $alba3)[(set: _albaCount to _albaCount + 1)]\
(display: "Night Progress")
}\
<!-- Hub date strap. Sits UNDER the DEAN STREET, SOHO, LONDON location line.
     Reads 23.11.73, turning over to 24.11.73 after midnight. On the visit
     where midnight passes, the flip span carries the gold-flare animation
     (paired with the distant Big Ben chime); otherwise it renders plain. -->\
<span class="scene-location">Dean Street, Soho, London.</span>\
(if: $midnightJustPassed is true)[<span class="scene-date scene-date-flip">(if: $afterMidnight)[24.11.73](else:)[23.11.73]</span>(set: $midnightJustPassed to false)](else:)[<span class="scene-date">(if: $afterMidnight)[24.11.73](else:)[23.11.73]</span>]\
<!-- HUB FLAGS: small strings the map reads (window.dssSohoMap's hubFlag). The
     thread-* flags light a pavement path to that door while the errand is live;
     add a flag and a row in THREADS to add a path. -->\
<span class="dss-hub-flag" data-k="notebook" style="display:none">(print: $notebook)</span>\
<!-- 2026-09-28 drink route: the stage the map can read. blackout / far / loose / empty. -->\
<span class="dss-hub-flag" data-k="drunk" style="display:none">(cond: $sobriety < 10, "blackout", $sobriety < 30, "far", $sobriety < 60, "loose", "")</span>\
<!-- 2026-10-23 overnight (Sam, playtest: "You should still get the slip that prompts you to get directions to cecil court"): once THE GREAT HAM has named INIS, the next street visit with no other slip carries one, with Get Directions --><!-- 2026-10-24 sweep: F6, only when THE GREAT HAM was met (the novelist can open Cecil Court too) --><!-- 2026-10-28 (Sam: "move people towards Carthage sooner"; a tester went a long way round before reaching it): the slip comes back on every street visit, one slip a lap as before, until INIS has been spoken to; and the way to Cecil Court is lit once, as the Pillars' is after the errand -->(if: $knowsCecilCourt is true and $metCritic is true and $knowsAboutPage is not true and $cecilDirLit is not true)[(set: $cecilDirLit to true)<script>if(window.dssDirections) window.dssDirections.set("cecil");</script>](if: $knowsCecilCourt is true and $metCritic is true and $knowsAboutPage is not true and $streetTipLap is not $returns)[(set: $cecilTipShown to true)(set: $streetTipLap to $returns)<script>setTimeout(function(){ if(window.dssInlineHint) window.dssInlineHint("THE GREAT HAM told you to look for INIS O&#39;FLATTERLY in Cecil Court.", { go: "cecil" }); }, 1100);</script>]\
<!-- 2026-10-23 overnight (Sam, playtest: "Now I have the errand the path should light up back to the pillars so I can go to carthage"): taking on Page 93 is a chosen path, so the way to the Pillars is lit once, as a slip's Get Directions would light it, until you get there -->(if: $knowsAboutPage is true and $hasMissingPage is not true and $returnedPage is not true and $pillarsDirLit is not true)[(set: $pillarsDirLit to true)<script>if(window.dssDirections) window.dssDirections.set("pillars");</script>]\
(if: $hasMissingPage is true and $returnedPage is false and $pageReminderShown is false)[(set: $pageReminderShown to true)(set: $streetTipLap to $returns)<script>setTimeout(function(){ if(window.dssInlineHint) window.dssInlineHint("Page 93 is in your pocket. INIS O&#39;FLATTERLY is waiting for it in Cecil Court.", { go: "cecil" }); }, 1100);</script>]\
<span class="dss-hub-flag" data-k="thread-cecil" style="display:none">(if: $knowsCecilCourt is true and $returnedPage is false)[on]</span>\
(set: _ronSeen to false)(if: $visited is a datamap and $visited contains "Ronnies" and $visited's Ronnies is true)[(set: _ronSeen to true)]\
<span class="dss-hub-flag" data-k="thread-ronnies" style="display:none">(if: $knowsRonnies is true and _ronSeen is false)[on]</span>\
<span class="dss-hub-flag" data-k="thread-coach" style="display:none">(if: $hutBurnt is true and $coachBurnt is false)[on]</span>\
<!-- 2026-09-25: the corners the strangers stood on keep a trace of their light once they are met -->\
(display: "Drunken Street Actions")\
<!-- 2026-10-08 (Sam): the locked path. Once the hut burns the map shuts every door but the Coach and the six windows; three windows and the Coach offers its fire, every time. The old one-in-five roll is gone. The map prints its own label for this door, so this text is only the matcher. -->(if: $hutBurnt is true and $coachBurnt is false and $visitedCentrePoint is false)[<div class="soho-hub-dock">[[The Coach and Horses|Approach The Coach]]</div>]\
<!-- 2026-10-15: who inside each door still has something to say about the book, and the door you chose to pitch at (the map names them on the plates and lights a thread to the pick) --><span class="dss-hub-flag" data-k="who" style="display:none">(display: "Who Will Read")(print: $whoFlag)</span><span class="dss-hub-flag" data-k="pitch" style="display:none">|pitchflag>[<!-- 2026-10-28 (Sam, note 28/40: the red line back to the French): no path to a venue that is resting; Next Target already skips it -->(if: $pitchTarget is not $venueRest)[(print: $pitchTarget)]]</span><!-- 2026-10-23 (Sam: NEXT is over-determined; only a chosen path shows): the next/next2 flags print nothing, so the map's NEXT glow, edge pointer, "Next:" bar note and dimming stay off; the pitch flag above still draws the red path --><span class="dss-hub-flag" data-k="next" style="display:none">|nextflag>[(display: "Next Target")]</span><span class="dss-hub-flag" data-k="next2" style="display:none">|next2flag>[]</span><span class="dss-hub-flag" data-k="rest" style="display:none">(unless: $venueRest is a string)[(set: $venueRest to "")](if: (($venueRest is "french") or ($venueRest is "colony")) and ($coachUrgent is not true) and ($hutBurnt is not true) and not (($bookAt is a string) and ($bookAt is $venueRest)) and ($nextId is not $venueRest) and ($nextId2 is not $venueRest))[(print: $venueRest)]</span><!-- 2026-10-17: never while NEXT itself points there (a lily, a key, the window: the readers' rungs already pass a resting venue by, the others do not) --><!-- 2026-10-17 (Sam: "if you try to return eg to the french before looking elsewhere you should be blocked and gently prompted"): the resting venue, read by the UserScript's click guard; never while the Coach calls, the hut burns, or the book waits inside --><!-- 2026-10-16: both hooks are replaced in place by a pick (Pitch Question), so the map's red path, glow and pointer follow without the street re-rendering --><span class="dss-hub-flag" data-k="fetch-near" style="display:none">(unless: ($fetchMet is a num) and ($fetchMet >= 1))[(if: ($afterMidnight is true) or ($nightPhase >= 1))[on]]</span><!-- 2026-10-23 (Sam: "first rejection slip brings him onto the map, and each setback makes him come more often and closer"): the night's setbacks besides the slips (the map counts tonight's slips itself from dssRefusals): refused calls (up to two), a beating, each blackout, the book lost --><span class="dss-hub-flag" data-k="fetch-setbacks" style="display:none">(unless: ($fetchMet is a num) and ($fetchMet >= 1))[(print: (cond: ($refusedCalls is a num), (min: $refusedCalls, 2), 0) + (cond: $wasBeaten is true, 1, 0) + (cond: ($blackouts is a num), $blackouts, 0) + (cond: $bookLostTonight is true, 1, 0))]</span><span class="dss-hub-flag" data-k="hut" style="display:none">(if: $hutBurnt is true)[burnt]</span><span class="dss-hub-flag" data-k="cat" style="display:none">(if: $catFollows is true)[on]</span><span class="dss-hub-flag" data-k="fire-only" style="display:none">(if: $blackouts >= 2 and $hutBurnt is false)[on]</span><span class="dss-hub-flag" data-k="square-locked" style="display:none">(if: $sobriety < 30 and $blackouts >= 1 and $hutBurnt is false)[on]</span><span class="dss-hub-flag" data-k="met-gooch" style="display:none">(if: $goochMet is true)[on]</span><span class="dss-hub-flag" data-k="met-fetch" style="display:none">(if: $fetchSeen is true)[on]</span><span class="dss-hub-flag" data-k="met-truze" style="display:none">(if: $truzeMet is true)[on]</span><span class="dss-hub-flag" data-k="met-line" style="display:none">(if: $lineWomanMet is true)[on]</span><span class="dss-hub-flag" data-k="ring" style="display:none">(if: $shipCall is "" and (history:) contains "Turn to Copper")[on]</span><span class="dss-hub-flag" data-k="met-longshanks" style="display:none">(if: $longshanksMet is true)[on]</span><span class="dss-hub-flag" data-k="met-songstrong" style="display:none">(if: $songstrongMet is true)[on]</span>\
<!-- THE CAPTION BAR AS NARRATOR (Sam, 2026-10-12: "1, 2 and 3, flash once"). At three turning points of the night the
     bar on the map gives one line, once, the first time you are back on the street after it: midnight passing, the
     first blackout, the Fetch. One a visit; a line left empty never shows. Sam's lines go in _beatLines. -->\
(set: _beatLines to (dm: "midnight", "A Goblin Story of Some Bells that Rang an Old Night Out and a New Day In.", "blackout", "The time is out of joint.", "fetch", "Je est un autre.", "doorway", "The coast is clear so you spew up your guts with the tact of a bulimic starlette. Well done. You feel much better for that."))\
<!-- 2026-10-16 (Sam: restore): the doorway's line from the 15 April backup, words unchanged; the doorways themselves are silent now (the hold-to-piss card does the act), so the bar says it as you step back onto the street, every time -->\
(unless: $beatShown is an array)[(set: $beatShown to (a:))](set: _beat to "")\
(if: $afterMidnight is true and ($beatShown does not contain "midnight") and _beatLines's midnight is not "")[(set: _beat to "midnight")](else-if: $blackouts >= 1 and ($beatShown does not contain "blackout") and _beatLines's blackout is not "")[(set: _beat to "blackout")](else-if: $fetchSeen is true and ($beatShown does not contain "fetch") and _beatLines's fetch is not "")[(set: _beat to "fetch")]\
(if: _beat is not "")[(set: $beatShown to it + (a: _beat))](if: (_beat is "") and ($justDoorway is true) and ($doorSpew is true))[(set: _beat to "doorway")](set: $justDoorway to false)(set: $doorSpew to false)<span class="dss-hub-flag" data-k="beat" style="display:none">(if: _beat is not "")[(print: _beatLines's (_beat))]</span>\
(if: _towerReady)[<div class="dss-night-choice"><span class="dss-night-ready">The poem is complete. Stay as long as you like.</span></div>]\
<!-- THE WAY OUT (2026-09-13, Sam: "there should be an exit at the edge of the map
     which is towards Centre point. That is the way out of the game and the night").
     The link is parked off-screen in the hub dock, exactly as the alleys are, so
     it is never a line of text on Dean Street. The map scans the rendered links
     and opens its north-edge door with it, so the only way out is to walk to the
     top of the map. Towards Dawn does the warning before you commit. -->\
<div class="soho-hub-dock" aria-hidden="true" style="position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none"><!-- 2026-09-16, Sam: hide the dawn door until the first venue has been visited. $enteredVenue is set by the header the first time a passage tagged venue-* (or one of the three untagged interiors) renders, so approaching a door and turning back does not count; with no link and no greyed span the Centre Point tile draws shut. --><!-- 2026-10-11 (Sam): after the second blackout the dawn door is open whether or not the third pillar has been crossed, as the gents line promises. --><!-- 2026-10-12 (the wanderer playthrough): when "Give up on the night" is on offer (morale 5 or under) it has the north door; the dawn link used to take it first, so a player who couldn't yet finish could never give up -->(set: _givingUp to ($coachUrgent is false and $confidence <= 5))(if: $enteredVenue is true and ($crossedThreshold is true or ($blackouts >= 2 and $hutBurnt is false)) and not _givingUp)[[[Head towards dawn|Towards Dawn]]](if: $shipCall is "" and (history:) contains "Turn to Copper")[[[The phone box|The Phone Box Rings]]](else-if: $refusedCalls > 0 or ($hasCoin is false and $returns >= 3))[<!-- 2026-10-10 (Sam): the box stands on the map all night but only opens once a call has been refused (or the coin has been spent in it); before that it is drawn unlit and cannot be entered. 2026-10-11 structure pass 3: returns >= 3, not 2: the Donkey is handed over on the second lap's hub just below this dock, so on that one screen $hasCoin was still false and the box lit up before you had a coin, then went dark again. -->[[The phone box|The Phone Box]]](if: $mantraComplete is true and $goochMet is false)[[[Helvellyn Gooch|Helvellyn Gooch]]](if: $nazcaTracing is true and $truzeMet is false)[[[Devon Truze|Devon Truze]]]<!-- 2026-10-24 (Sam, Q5: "stagger them"): the phone box rings on the first lap back from the cellar; the Woman comes on the lap after. $cellarHubLap is the first hub after the cellar; alleys and the box do not count as laps --><!-- 2026-10-25 sweep (played live, night 2): the Woman showed on the first hub after the cellar beside the phone box. An unset $cellarHubLap reads as 0 in Harlowe, which "is a number", so the stamp never fired and the gate compared against 0. The lap is 0 until stamped (reset each night in StoryInit/Start) and the gate wants a stamped lap. -->(unless: $cellarHubLap > 0)[(if: (history:) contains "Turn to Copper")[(set: $cellarHubLap to $returns)]](if: ((history:) contains "Turn to Copper") and ($lineWomanMet is false) and ($cellarHubLap > 0) and ($returns > $cellarHubLap))[[[The Woman from the Line|The Woman from the Line]]](if: $easterGlyph is true and $longshanksMet is false)[[[Tom Longshanks|Tom Longshanks]]](if: $pyramidNumber is true and $songstrongMet is false)[[[Guilliam Songstrong|Guilliam Songstrong]]]</div>\
(if: $returns is 2 and $hasCoin is false)[(set: $hasCoin to true)<div id="coin-overlay"><div class="coin-overlay-box" role="dialog" aria-modal="true" aria-label="A coin on the pavement"><div class="coin-overlay-stage"><div class="coin-overlay-disc" id="coin-overlay-disc"><div class="cp-face cp-heads"></div><div class="cp-face cp-tails"></div></div></div><p class="coin-overlay-text">You found a coin on the pavement; a rare one, called a ‘Donkey’. There’s only one. Toss it and pocket it. You’ll want it later.</p><span class="inventory-note">COIN ACQUIRED</span><button class="coin-overlay-btn" id="coin-toss-btn">Toss it</button><span class="coin-overlay-result" id="coin-overlay-result"></span><button class="coin-overlay-btn coin-overlay-dismiss" id="coin-keep-btn" style="visibility:hidden">Pocket it</button></div></div><script>(function(){var tossCount=0,maxToss=1,stage=document.querySelector(".coin-overlay-stage");var sequence=[false];var pocketed=false;function sparks(){for(var i=0;12>i;i++){var s=document.createElement("div");s.className="cp-spark";var a=Math.random()*360,dist=60+Math.random()*40;s.style.setProperty("--sx",(Math.cos(a*Math.PI/180)*dist)+"px");s.style.setProperty("--sy",(Math.sin(a*Math.PI/180)*dist)+"px");s.style.animationDelay=(Math.random()*0.3)+"s";s.style.animationDuration=(0.5+Math.random()*0.5)+"s";stage.appendChild(s);setTimeout(function(el){el.remove();},(1200),s);}}document.getElementById("coin-toss-btn").addEventListener("click",function(){var d=document.getElementById("coin-overlay-disc"),r=document.getElementById("coin-overlay-result"),b=this,o=document.getElementById("coin-overlay");if(pocketed)return;if(d.classList.contains("cp-flipping"))return;if(window.dssAudio)window.dssAudio.coinFlip();var heads=sequence[tossCount];tossCount++;var endDeg=heads?"1440deg":"1620deg";var restDeg=heads?"0deg":"180deg";d.style.setProperty("--cp-end",endDeg);d.classList.remove("cp-flipping");void d.offsetWidth;d.classList.add("cp-flipping");sparks();r.textContent="";b.classList.add("coin-btn-hidden");setTimeout(function(){if(pocketed)return;r.textContent=heads?"Heads.":"Tails.";d.style.transform="rotateX("+restDeg+")";d.classList.remove("cp-flipping");if(tossCount>=maxToss){setTimeout(function(){if(pocketed)return;var kb=document.getElementById("coin-keep-btn"),tb0=document.getElementById("coin-toss-btn");if(kb){if(tb0&&tb0.parentNode){tb0.parentNode.insertBefore(kb,tb0);tb0.style.display="none";}kb.style.visibility="visible";kb.classList.remove("coin-overlay-dismiss");}},1000);}},2000);});var keepBtn=document.getElementById("coin-keep-btn");if(keepBtn){keepBtn.addEventListener("click",function(){if(pocketed)return;pocketed=true;if(window.dssAudio&&window.dssAudio.coinPocket){try{window.dssAudio.coinPocket();}catch(e){}}var o=document.getElementById("coin-overlay");var box=o&&o.querySelector(".coin-overlay-box");if(!o||!box)return;var tb=document.getElementById("coin-toss-btn");if(tb){tb.classList.add("coin-btn-hidden");tb.style.pointerEvents="none";}for(var k=1;k<=12;k++){var m=document.createElement("span");m.className="item-mote item-mote-"+k;box.appendChild(m);}this.style.display="none";setTimeout(function(){o.classList.add("coin-overlay-fade");setTimeout(function(){o.remove();},800);},1600);});}var ov=document.getElementById("coin-overlay");if(ov){ov.addEventListener("click",function(e){if(e.target===ov&&tossCount>0){ov.classList.add("coin-overlay-fade");setTimeout(function(){ov.remove();},800);}});}})();</script>]\
<!-- OPEN NIGHT: one explanation for fresh games and migrated saves. -->\
<!-- 2026-10-13 (Sam, the slip review 4 of 14): the open-night slip cut. It said "The night is yours to explore. Walking and returning to Dean Street cost nothing. Its mood changes as you discover things, but there is no deadline. Games, drinks and encounters still affect your morale and sobriety." $shownOpenNightTip is still set, for anything that reads it. -->(if: $returns >= 2 and $shownOpenNightTip is not true)[(set: $shownOpenNightTip to true)]\
<!-- LEDGER teaching — the filled/hollow rule behind every glyph family on
     the venue links (◆◇ haunts, ❀❁ flowers, ▲△ passwords, ★☆ page, ✦✧
     alba). Fires once, on the first hub visit where haunt pips are actually
     visible ($hauntExplained flips when the haunts modal has shown).
     2026-09-16, spacing: not before hub visit 3, so it never shares the
     screen with the open-night slip on visit 2. One lesson per hub visit:
     open night (2), ledger (3), door marks (4), each still gated on its own
     condition. -->\
<!-- 2026-10-23: the ledger lesson's hook now sits after the flagging tips below -->\
<!-- Sam, 2026-09-14: hide the intro on return visits. It was already dimmed to 60% from the second visit on, which said "you have read this"; hiding it says the same thing and gives the walkable map back about 180px, so the street is in view instead of a scroll below it. The blank line that used to follow the hook is INSIDE the conditional now, or it would print a gap above the bag line on every visit after the first. First visit still reads exactly as written. ONE LINE on purpose: a multi-line HTML comment here emits a <br> per newline. -->\
(if: $returns <= 1)[|deanIntro>[A heavy afternoon lingers in rainfall on the pavements though the sky has cleared now and the newborn night is cut with moonshine.

There is an atmosphere of the silver screen. Brando might emerge in a tight and sodden T-shirt, from any door or alleyway, anytime.]

]\
<!-- 2026-10-24 sweep: the book-lost roll (Book Footer) runs here, before the bag line and the pitch question, and the bag line shows only while the book is in the bag (left behind, fenced, lent or sold it said "In your bag, you have your novel" regardless; played live with the book left at the French) -->(display: "Book Footer")(set: $bookRollLap to $returns)(unless: $bookLent is a string)[(set: $bookLent to "")](set: _bagHas to (($bookAt is a string) and ($bookAt is "") and ($bookSold is not true) and ($bookLent is "")))\
(display: "Key Doors Open Line")(if: $returns is 1)[In your bag, you have your novel, in manuscript. It might open doors.](else-if: _bagHas)[In your bag, you have //(print: $bookTitle)//, your novel, in manuscript. It might open doors.]\
<!-- 2026-10-15 (Sam: "some sort of prompt where it asks you who you want to try to pitch the book to and then gives a choice and even guides you there"): the question under the bag line, from the second lap, while the book is in the bag and no forced road is on. The names come from Who Will Read (the people still owed a reading or a refusal, behind open doors). A pick sets NEXT to that person and the map lights a gold thread to their door; it clears when they have had their say, and the question comes back. -->(unless: $bookLent is a string)[(set: $bookLent to "")](set: _bookInBag to (($bookAt is a string) and ($bookAt is "") and ($bookSold is not true) and ($bookLent is "")))(if: ($metRed is true) and _bookInBag and ($coachUrgent is not true) and ($hutBurnt is not true) and ($blackouts < 2) and ($pitchAvail is an array) and ($pitchAvail's length > 0))[<!-- 2026-10-17 (Sam): a question only when there is a choice; one reader left, and NEXT and the map simply name them --><!-- 2026-10-29 (Sam: "the link choices you can click to guide you to the next venue seem to have entirely disappeared. They should still be there"): since the novelist joins only when he is next (10-27), the early nights had one reader and lost the question; it shows from one reader on --><div class="book-pitch">|pitchq>[(display: "Pitch Question")]</div>]\
<!-- The blank line that used to separate this beat from the bag line sat
     OUTSIDE the hook, so it printed whether or not the beat did, and once the
     map moved below the prose it was one of two stray breaks pushing the street
     off the screen. It lives inside the hook now: a break before "Someone's"
     only when there is a someone. -->\
(if: $coachUrgent is false and $metRed is false)[
Someone’s on the corner.

[[See who’s there|Approach The Ginger Light]]]\
<!-- SOHO MAP (2026-09-01; under the date strap from 2026-09-11; moved again
     2026-09-14 to sit BELOW the night's prose). Sam: "you don't pay any attention
     to the prose if the walkable map is above it." He was right, and it was worse
     than it looked: measured on an 837px viewport the map ran 552 to 1026 and the
     prose began at 1137, so on arriving at the hub the writing was entirely below
     the fold. The prose now comes first and the street is underneath it. Door
     discovery is unaffected: scanHub() reads every tw-link in the passage, wherever
     the container sits. -->\
<div id="soho-map-container"></div>\
