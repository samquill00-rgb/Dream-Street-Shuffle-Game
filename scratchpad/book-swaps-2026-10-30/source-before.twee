      ctx.strokeStyle='#f0d29744';ctx.lineWidth=1;ctx.beginPath();ctx.arc(g.x,g.y,26,-Math.PI,0);ctx.stroke();
      ctx.fillStyle='#ead1a0';ctx.beginPath();ctx.arc(g.x,g.y,3,0,Math.PI*2);ctx.fill();
      ctx.strokeStyle='#ead1a0aa';ctx.beginPath();ctx.arc(g.x,g.y,10,0,Math.PI*2);ctx.stroke();
      ctx.beginPath();ctx.moveTo(g.x-18,g.y);ctx.lineTo(g.x-12,g.y);ctx.moveTo(g.x+12,g.y);ctx.lineTo(g.x+18,g.y);ctx.stroke();
