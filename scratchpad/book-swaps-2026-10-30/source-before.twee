line([-20,1,-25,-1,-24,10,-19,12]); line([20,0,24,1,22,12,18,12]);
var eye = turn === 1 ? 5 : 0;
line([-13+eye,-3,-6+eye,-5,-2+eye,-3]); line([6+eye,-4,13+eye,-3]);
line([2+eye,-2,-1+eye,10,6+eye,12]); line([-6,21,3,20,10,18]); line([-1,25,7,24]);
