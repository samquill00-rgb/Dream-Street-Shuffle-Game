    var lfoG = ac.createGain(); lfoG.gain.value = 400;
    lfo.connect(lfoG); lfoG.connect(f.frequency);
    lfo.start(now);
    src.connect(f); f.connect(g); g.connect(ac.destination);
    src.start(now);
    _ambient = { src: src, g: g, kind: 'dream', lfo: lfo };
      });
  }
  function ambientOff() { _stopAmbient(); }
  function ambientCut() { _stopAmbient(0); }
  // ====== FARNELL-STYLE PROCEDURAL MODELS ======
  // British telephone bell — two iron gongs, magnetic clapper alternates
  // between them at ~25 Hz. Each gong rings with several inharmonic modes.
  // Modelled after Farnell, "Designing Sound" ch. on the telephone bell.
  // Tracks scheduled oscillators in _phoneBellNodes so stopPhoneBell()
  // can kill an in-flight bell when the passage changes.
  var _phoneBellNodes = [];
  function stopPhoneBell() {
    _phoneBellNodes.forEach(function(node) {
      try { if (node.stop) node.stop(); } catch(e) {}
      try { node.disconnect(); } catch(e) {}
    });
    _phoneBellNodes = [];
  }
  function phoneBell(rings) {
    stopPhoneBell();
    _play(function(ac) {
    rings = rings || 2;
    var now = ac.currentTime;
    function strike(t, gongA) {
      // Two gongs of slightly different size — each has 3 inharmonic partials
      var partials = gongA
        ? [{ f: 1380, a: 0.10, d: 0.18 },
           { f: 2050, a: 0.06, d: 0.13 },
           { f: 3120, a: 0.03, d: 0.09 }]
        : [{ f: 1620, a: 0.10, d: 0.18 },
           { f: 2410, a: 0.06, d: 0.13 },
           { f: 3580, a: 0.03, d: 0.09 }];
      partials.forEach(function(p) {
        var o = ac.createOscillator(); o.type='sine';
        // Tiny pitch drift so each strike isn't identical
        o.frequency.value = p.f * (1 + (Math.random()-0.5) * 0.006);
        var g = ac.createGain();
        g.gain.setValueAtTime(0.001, t);
        g.gain.linearRampToValueAtTime(p.a, t + 0.001);
        g.gain.exponentialRampToValueAtTime(0.001, t + p.d);
        o.connect(g); g.connect(ac.destination);
        o.start(t); o.stop(t + p.d + 0.01);
        _phoneBellNodes.push(o);
      });
      // Metallic clapper-tap noise transient
      var nLen = Math.floor(ac.sampleRate * 0.003);
      var nbuf = ac.createBuffer(1, nLen, ac.sampleRate);
      var nd = nbuf.getChannelData(0);
      for (var k = 0; k < nLen; k++) nd[k] = (Math.random()*2-1) * Math.exp(-k/nLen * 8);
      var nsrc = ac.createBufferSource(); nsrc.buffer = nbuf;
      var nf = ac.createBiquadFilter(); nf.type='highpass';
      nf.frequency.value = 2500;
      var ng = ac.createGain(); ng.gain.value = 0.05;
      nsrc.connect(nf); nf.connect(ng); ng.connect(ac.destination);
      nsrc.start(t);
      _phoneBellNodes.push(nsrc);
    }
    // British double-pulse: brrring brrring (0.4s ring, 0.2s gap, 0.4s ring,
    // then 2.0s pause), alternating gongs at ~25 Hz inside each ring.
    for (var r = 0; r < rings; r++) {
      var cycle = now + r * 2.0;
      [0, 0.4].forEach(function(brrOff) {
        var brrStart = cycle + brrOff;
        for (var i = 0; i < 10; i++) {
          strike(brrStart + i * 0.04, i % 2 === 0);
        }
      });
    }
    });
  }
  // Wind — three parallel filters (low howl, mid whistle, high sibilance)
  // driven by white noise, with two LFOs on filter cutoffs to gust.
  // Modelled after Farnell's wind chapter. Tuned somewhere between the
  // original quiet bed and the "shore howling" boost — present and
  // restless, not overwhelming.
  function windFarnell() {
    _play(function(ac) {
    if (_ambient && _ambient.kind === 'wind') return;
    _stopAmbient();
    var now = ac.currentTime;
    var dur = 12.0;
    var bufLen = Math.floor(ac.sampleRate * dur);
    var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
    var d = buf.getChannelData(0);
    for (var i = 0; i < bufLen; i++) d[i] = (Math.random()*2-1) * 0.6;
    var src = ac.createBufferSource(); src.buffer = buf; src.loop = true;
    var f1 = ac.createBiquadFilter(); f1.type='bandpass';
    f1.frequency.value = 240; f1.Q.value = 2.4;          // low howl
    var f2 = ac.createBiquadFilter(); f2.type='bandpass';
    f2.frequency.value = 720; f2.Q.value = 3.0;          // mid whistle
    var f3 = ac.createBiquadFilter(); f3.type='lowpass';
    f3.frequency.value = 3200; f3.Q.value = 0.7;         // high sibilance
    var g1 = ac.createGain(); g1.gain.value = 0.60;
    var g2 = ac.createGain(); g2.gain.value = 0.68;
    var g3 = ac.createGain(); g3.gain.value = 0.30;
    var g = ac.createGain();
    g.gain.setValueAtTime(0, now);
    g.gain.linearRampToValueAtTime(0.22, now + 2.5);
    // Primary gust LFO — slow sweep on the whistle band's cutoff
