  x.fillStyle = '#3e3a3c'; x.fillRect(3, 6, 1, 42); x.fillRect(3, 6, 26, 1);
  x.fillStyle = '#231f21'; x.fillRect(28, 6, 1, 42);
  x.fillStyle = '#1b2030'; x.fillRect(9, 30, 3, 8); x.fillRect(20, 30, 3, 8);
  x.fillStyle = '#e8e0c8'; x.beginPath(); x.arc(16, 20, 5, 0, Math.PI * 2); x.fill();
  x.fillStyle = '#1a1814'; x.fillRect(15, 16, 1, 5); x.fillRect(15, 20, 4, 1);
