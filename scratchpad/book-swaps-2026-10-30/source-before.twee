    }
    if (S.cop) { var cq = S.cop; x.drawImage(copSprites[cq.dir][cq.f], Math.round(cq.x), cq.y - 2); x.fillStyle = '#0d1020'; x.fillRect(Math.round(cq.x) + 3, cq.y - 4, 6, 3); x.fillRect(Math.round(cq.x) + 5, cq.y - 5, 2, 1); x.fillStyle = '#c8c0a0'; x.fillRect(Math.round(cq.x) + 5, cq.y - 3, 2, 1); }
    if (S.drunk) { var dq = S.drunk; x.drawImage(drunkSprites[dq.dir][dq.f], Math.round(dq.x), dq.y - 2); if (dq.pause > 0 && dq.asked) { x.fillStyle = 'rgba(255,240,200,0.9)'; x.fillRect(Math.round(dq.x) + (dq.dir === 'right' ? 12 : -2), dq.y + 3, 1, 1); } }
    // last night's footsteps (see ROUTE): a pair of faint prints a tile, gone once walked over tonight
    for (var gi = 0; gi < ROUTE.ghost.length; gi++) {
