        for(var xx=x0;xx<=x1;xx+=4){var v=yy+Math.sin(xx*.11+ph)*(1+j*.25);if(xx===x0)ctx.moveTo(xx,v);else ctx.lineTo(xx,v);}ctx.stroke();}
