    var c = document.createElement('div'); c.className = 'dss-lore-card dss-rumour-card'; c.setAttribute('role', 'dialog'); c.setAttribute('aria-label', 'The Rumour');
    var x = document.createElement('button'); x.type = 'button'; x.className = 'dss-lore-x'; x.setAttribute('aria-label', 'Close'); x.textContent = '×';
    var h = document.createElement('div'); h.className = 'dss-lore-title'; h.textContent = 'THE RUMOUR';
    var b = document.createElement('div'); b.className = 'dss-lore-body'; b.innerHTML = src.innerHTML;
    c.appendChild(x); c.appendChild(h); c.appendChild(b);
    var ps = Array.prototype.slice.call(b.querySelectorAll('p')), i = 0, ready = 0, more = null;
    var sk = window.dssRumourSketch ? window.dssRumourSketch(first && ps.length > 1 ? 0 : 3) : null; /* 2026-10-28 note 24: the who's-who, built paragraph by paragraph */
