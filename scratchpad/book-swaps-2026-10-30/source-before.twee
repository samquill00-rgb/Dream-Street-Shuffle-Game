        x.fillStyle = PAL.winDark; x.fillRect(wn.x + 3, wn.y + 3, 3, 4); x.fillRect(wn.x + 10, wn.y + 3, 3, 4);
        x.fillStyle = PAL.winGlass; x.fillRect(wn.x + 3, wn.y + 10, 3, 4); x.fillRect(wn.x + 10, wn.y + 10, 3, 4);
        x.fillStyle = PAL.soot; x.fillRect(wn.x + 3, wn.y + 5, 3, 1); x.fillRect(wn.x + 10, wn.y + 5, 3, 1);
      }
    }
