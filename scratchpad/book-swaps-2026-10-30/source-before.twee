    c.fillStyle=side<0?'#17151e':'#201a20';c.beginPath();c.moveTo(vx,vy);c.lineTo(180+side*240,540);c.lineTo(180+side*300,0);c.closePath();c.fill();
    for(var i=0;i<7;i++){
