:: PP Pong [pong] {"position":"1300,1550","size":"100,100"}
<span id="pp-data-opponent" style="display:none;">(print: $opponent)</span>
<span id="pp-data-sobriety" style="display:none;">(print: $sobriety)</span>
<div class="pp-arena">
<div class="pp-score" id="score-display"></div>
<div class="pp-score-sub" id="score-sub"></div>
<canvas id="pong-canvas" aria-label="Tennis Court Oaths minigame" width="540" height="340" style="display:block;max-width:100%;height:auto;margin:0 auto;"></canvas>
<div id="pp-narrative"></div>
<div id="pp-game-end"></div>
<!-- Paddle-control crib line removed — it duplicated the rules popup. The
     #pp-instructions lookup in the game script is if-guarded. -->
</div>
<span id="pp-go-win" style="display:none;">[[Victory|PP Victory]]</span>
<span id="pp-go-lose" style="display:none;">[[Defeat|PP Defeat]]</span>
<!-- Stall safety net: if the canvas auto-nav never fires, reveal a manual escape long after any normal match has ended. -->
<!-- Bail timers count from PASSAGE render, and every game starts behind a
     rules popup the player can dwell on — so all four bails run generous
     (150s) to guarantee they only ever appear on a genuine stall. -->
(after: 150s)[<div class="canvas-bail pp-bail">Your eyes lose the ball for good. [[Concede the table.|PP Defeat]]</div>]
<script>
(function(){var __boot=function(){
var opponent = (document.getElementById('pp-data-opponent') || {}).textContent || 'Opponent';
var sobriety = parseInt((document.getElementById('pp-data-sobriety') || {}).textContent) || 55;
if (window.dssAudio && window.dssAudio.stopBed) { try { window.dssAudio.stopBed('minigame-retro'); } catch(e) {} }
var _pongEl = null;
var _pongMuteWatcher = null;
function _pongMuted() { return !!(window.dssAudio && window.dssAudio.isMuted && window.dssAudio.isMuted()); }
if (window._pongMiniDataUri) {
  _pongEl = new Audio(window._pongMiniDataUri);
  _pongEl.volume = 0.28; _pongEl.loop = true;
  _pongEl.playbackRate = 1.12; /* nudge the loop a touch faster than its native tempo (pitch preserved by default) */
  _pongEl.muted = _pongMuted();
  _pongEl.play().catch(function(){});
  _pongMuteWatcher = setInterval(function() {
    if (!_pongEl) { clearInterval(_pongMuteWatcher); _pongMuteWatcher = null; return; }
    var m = _pongMuted();
    if (_pongEl.muted !== m) _pongEl.muted = m;
  }, 250);
}
var W = 540, H = 340;
var canvas = document.getElementById('pong-canvas');
var ctx = canvas.getContext('2d');
var playerScore = 0, oppScore = 0, rallyCount = 0; // rallyCount escalates ball speed each serve
var playerStreak = 0, rallyBurst = 0, hitSparks = [];
var gameOver = false, paused = false, serving = true, serveTime = Date.now();
document.body.classList.remove('pp-bail-ok');
/* 2026-10-28 (dssEase): each lost match makes the next gentler: a slower ball, a slower and later opponent */
var EZ = window.dssEase ? window.dssEase.level('pong') : 0, EZ_SPEED = 1 - EZ * 0.12, EZ_RT = 1 + EZ * 0.45;
var ball = {x:W/2,y:H/2,dx:0,dy:0,r:5,base:5.0 * (1 - EZ * 0.08)};
var pPad = {x:12,y:H/2-35,w:8,h:70};
var oPad = {x:W-20,y:H/2-35,w:8,h:70};
var mouseY = H/2, actualY = pPad.y;
var aiTarget = H/2, aiLast = 0;
var pointFlashCol = null, pointFlashAt = 0;
var pPadVel = 0; /* paddle velocity this frame — imparts carry-spin on hits */
var endAt = 0, endWon = false; /* end flourish: gold wash on victory, dark on defeat */
// Countdown phase before the first serve — gives the player a beat to settle
// the paddle, and gives the music a moment to be heard before the rally starts.
var phase = 'countdown', countdownStart = Date.now();
var COUNTDOWN_DUR = 1800; // 600ms × three beats: 3, 2, 1, then play
var narr = {
'Jack Curtis':{
win:["JACK CURTIS nods. A veteran’s approval.","Your shot surprises you both.","Even the poet blinks.","A clean winner. JACK CURTIS says nothing."],
lose:["JACK CURTIS places it where you aren’t. He’s done this before.","The ball passes you like a rumour.","JACK CURTIS smiles, unhurried. A poet’s patience.","He reads you like a manuscript."]
},
'Percy Ritson':{
win:["PERCY RITSON overcommits. Wild swing, clean miss.","His brilliance undoes him.","Too much angle. PERCY RITSON curses.","Speed without direction is just noise."],
lose:["PERCY RITSON smashes it. You never saw it.","A wild shot that somehow finds the corner.","PERCY RITSON whoops. The cellar echoes.","He plays like a man with nothing to lose."]
}
};
function setupInput(){
function h(cy){var r=canvas.getBoundingClientRect();mouseY=(cy-r.top)*(H/r.height);}
canvas.addEventListener('mousemove',function(e){h(e.clientY);});
canvas.addEventListener('touchmove',function(e){e.preventDefault();h(e.touches[0].clientY);},{passive:false});
document.addEventListener('mousemove',function(e){var r=canvas.getBoundingClientRect();if(e.clientY>=r.top&&e.clientY<=r.bottom)h(e.clientY);});
}
function serve(){
ball.x=W/2;ball.y=H/2;
/* Serve speed climbs with each point played so the match opens brisk and quickens
   toward the finish; capped at the 9th point so a long decider stays returnable. */
var sp=ball.base+Math.min(rallyCount,9)*0.30*(1 - EZ * 0.2);var a=(Math.random()-0.5)*0.8;var d=(rallyCount%2===0)?-1:1;
ball.dx=d*sp*Math.cos(a);ball.dy=sp*Math.sin(a);
serving=true;serveTime=Date.now();rallyCount++;
}
function callScore(){
/* First to 5, flat (no win-by-2): love for 0, "match point" once a player reaches 4,
   "decider" at 4-4. No deuce/advantage \u2014 there's no win-by-2, so that table-tennis
   wording was misleading. */
if(playerScore===0&&oppScore===0)return'love-all';
if(playerScore===4&&oppScore===4)return'match point \u2014 decider';
if(playerScore>=4&&playerScore>oppScore)return'match point \u2014 you';
if(oppScore>=4&&oppScore>playerScore)return'match point \u2014 '+opponent;
var n=function(x){return x===0?'love':String(x);};
return n(playerScore)+'\u2013'+n(oppScore);
}
function updateScore(){
var el=document.getElementById('score-display');
if(el){
  el.innerHTML =
    '<div class="pp-scoreboard">'+
      '<div class="pp-side pp-side-you">'+
        '<div class="pp-name">YOU</div>'+
        '<div class="pp-num pp-num-you">'+playerScore+'</div>'+
      '</div>'+
      '<div class="pp-middle">'+
        '<div class="pp-vs">\u00b7</div>'+
      '</div>'+
      '<div class="pp-side pp-side-opp">'+
        '<div class="pp-name">'+opponent.toUpperCase()+'</div>'+
        '<div class="pp-num pp-num-opp">'+oppScore+'</div>'+
      '</div>'+
    '</div>';
}
var sub=document.getElementById('score-sub');
if(sub)sub.textContent=callScore();
}
function showNarrative(pw){
var lines=pw?narr[opponent].win:narr[opponent].lose;
var line=lines[Math.floor(Math.random()*lines.length)];
var el=document.getElementById('pp-narrative');
if(!el)return;
el.style.cssText='text-align:center;color:#b8a070;font-size:0.9em;font-style:italic;margin-top:1em;min-height:1.5em;';
el.style.opacity='1';el.textContent=line;
if(sobriety<30&&Math.random()<0.4)el.textContent=line+' Your vision swims.';
}
function updatePlayer(){
var prevPadY=pPad.y;
var ty=mouseY-pPad.h/2;
if(sobriety<25){ty+=(Math.random()-0.5)*40;if(Math.random()<0.15)return;actualY+=(ty-actualY)*0.06;}
else if(sobriety<50){ty+=(Math.random()-0.5)*15;actualY+=(ty-actualY)*0.12;}
else{actualY+=(ty-actualY)*0.25;}
pPad.y=Math.max(0,Math.min(H-pPad.h,actualY));
pPadVel=pPad.y-prevPadY;
}
/* Score-based difficulty is now one-directional: the AI only ever EASES OFF
   when it's ahead (bias <= 0), so falling behind gives you a genuine break. It
   NEVER plays better than its baseline when trailing — that score-catchup was
   the "match point feels unbeatable" bug, because you're almost always ahead at
   match point, so the AI was at full catchup right when you tried to close it
   out. The honest climb in difficulty now comes from the serve-speed ramp in
   serve() (the ball quickens each point, capped at the 9th; the baseline AI must
   chase the faster ball), not from the score. */
function aiBias(){
if (playerScore >= 4 && oppScore >= 4) return 0;
var lead = oppScore - playerScore;
var raw = -lead * 0.8;            // >0 would sharpen the AI when behind — clamped away below
return Math.max(-1.0, Math.min(0.0, raw));
}
function updateAI(){
var now=Date.now();
var bias=aiBias();
/* Difficulty is FLAT across the match — the AI does NOT sharpen as the score climbs.
   The old progress-ramp peaked exactly at match point, which made the deciding point
   a wall. Now score bias only ever EASES the AI when it's ahead (bias <= 0), so the
   AI is at most its baseline at any moment, and easier when it's leading. The
   "speeding up toward the end" comes entirely from the ball's serve-speed ramp, which
   the baseline AI must chase too — a fast finish, but the last point is as winnable
   as any other. */
var speedMul = 1 + bias * 0.45;
var accMul   = Math.max(0.4, 1 - bias * 0.5);     // reaction time; never below baseline (bias<=0)
var noiseMul = Math.max(0.45, 1 - bias * 0.55);   // aim error; never below baseline, so the AI always mis-hits some
if(opponent==='Jack Curtis'){
/* Jack — patient veteran. Reacts ~75ms, predicts cleanly with light noise. */
var rt = 75 * accMul * EZ_RT;
if(now-aiLast<rt)return;aiLast=now;
var py=ball.y;
if(ball.dx>0){var f=(oPad.x-ball.x)/ball.dx;py=ball.y+ball.dy*f;while(py<0||py>H){if(py<0)py=-py;if(py>H)py=2*H-py;}}
py+=(Math.random()-0.5)*12*noiseMul;aiTarget=py;
var sp=4.4*speedMul*EZ_SPEED,c=oPad.y+oPad.h/2,d=aiTarget-c;
if(Math.abs(d)>4)oPad.y+=Math.sign(d)*Math.min(sp,Math.abs(d));
}else{
/* Percy — wild but quicker now; the accurate-prediction roll fires more often. */
var rt = 35 * accMul * EZ_RT;
if(now-aiLast<rt)return;aiLast=now;
var py=ball.y+ball.dy*8;py+=(Math.random()-0.5)*32*noiseMul;
/* Accurate-prediction roll: 30% baseline, rises when AI is behind. */
var predChance = Math.max(0.05, Math.min(0.85, 0.30 + bias * 0.35));
if(Math.random()<predChance){var f=ball.dx>0?(oPad.x-ball.x)/ball.dx:30;py=ball.y+ball.dy*f;while(py<0||py>H){if(py<0)py=-py;if(py>H)py=2*H-py;}}
aiTarget=py;
var sp=6.2*speedMul*EZ_SPEED,c=oPad.y+oPad.h/2,d=aiTarget-c;
if(Math.abs(d)>3)oPad.y+=Math.sign(d)*Math.min(sp,Math.abs(d));
}
oPad.y=Math.max(0,Math.min(H-oPad.h,oPad.y));
}
function updateBall(){
if(serving){if(Date.now()-serveTime<800)return;serving=false;}
ball.x+=ball.dx;ball.y+=ball.dy;
if(ball.y-ball.r<0){ball.y=ball.r;ball.dy=Math.abs(ball.dy);if(window.dssAudio&&window.dssAudio.pongWall)window.dssAudio.pongWall();}
if(ball.y+ball.r>H){ball.y=H-ball.r;ball.dy=-Math.abs(ball.dy);if(window.dssAudio&&window.dssAudio.pongWall)window.dssAudio.pongWall();}
if(ball.dx<0&&ball.x-ball.r<=pPad.x+pPad.w&&ball.x+ball.r>=pPad.x&&ball.y>=pPad.y&&ball.y<=pPad.y+pPad.h){
var hp=(ball.y-pPad.y)/pPad.h;var a=(hp-0.5)*Math.PI*0.6;
var sp=Math.min(Math.sqrt(ball.dx*ball.dx+ball.dy*ball.dy)*1.05,8.5);
ball.dx=sp*Math.cos(a);ball.dy=sp*Math.sin(a);ball.x=pPad.x+pPad.w+ball.r;
/* Carry-spin: a moving paddle drags the ball with it — hit on the slide
   and the return skews with your motion. Skill, not reflexes. */
ball.dy+=pPadVel*0.35;
if(ball.dy>7)ball.dy=7;if(ball.dy<-7)ball.dy=-7;
// The centre of the bat is the sweet spot. Three clean returns create a
// faster house special, rewarding players who read the rally.
if(Math.abs(hp-0.5)<0.15){
  playerStreak++;
  hitSparks.push({x:ball.x,y:ball.y,life:1});
  if(playerStreak>=3){
    var burstSpeed=Math.min(Math.sqrt(ball.dx*ball.dx+ball.dy*ball.dy)*1.16,8.5);
    ball.dx=burstSpeed; rallyBurst=1; playerStreak=0;
  }
} else { playerStreak=0; }
if(window.dssAudio&&window.dssAudio.pongTock)window.dssAudio.pongTock();
}
if(ball.dx>0&&ball.x+ball.r>=oPad.x&&ball.x-ball.r<=oPad.x+oPad.w&&ball.y>=oPad.y&&ball.y<=oPad.y+oPad.h){
var hp=(ball.y-oPad.y)/oPad.h;var am=opponent==='Percy Ritson'?0.8:0.6;
var a=Math.PI-(hp-0.5)*Math.PI*am;
var sp=Math.min(Math.sqrt(ball.dx*ball.dx+ball.dy*ball.dy)*1.05,8.5);
ball.dx=sp*Math.cos(a);ball.dy=sp*Math.sin(a);ball.x=oPad.x-ball.r;
playerStreak=0;
if(window.dssAudio&&window.dssAudio.pongTock)window.dssAudio.pongTock();
}
if(ball.x<-20){oppScore++;pointEnd(false);}
else if(ball.x>W+20){playerScore++;pointEnd(true);}
}
function pointEnd(pw){
/* 2026-10-14 (overnight report, Sam: fix): the bail waits for the end of a point, never pops in mid-rally */
if(document.querySelector('.pp-bail'))document.body.classList.add('pp-bail-ok');
if(window.dssAudio&&window.dssAudio.pongPoint)window.dssAudio.pongPoint(pw);
/* Brief canvas tint so the point lands visually — cool white when you take
   it, red when it gets past you. Fades over ~500ms in draw(). */
pointFlashCol=pw?'rgba(190,220,255,':'rgba(220,60,40,';
pointFlashAt=Date.now();
updateScore();paused=true;
playerStreak=0; rallyBurst=0;
/* First to 5, flat (no win-by-2): a match always resolves in 5–9 points and is
   always decisive. Difficulty climbs via the serve-speed ramp in serve() (the
   ball quickens each point, capped at the 9th), not via score-catchup — see aiBias. */
if(playerScore>=5||oppScore>=5){endGame(playerScore>=5);return;}
setTimeout(function(){paused=false;serve();},800);
}
function endGame(pw){
gameOver=true;
endAt=Date.now(); endWon=pw;
if (_pongMuteWatcher) { clearInterval(_pongMuteWatcher); _pongMuteWatcher=null; }
if (_pongEl) { _pongEl.pause(); _pongEl.src=''; _pongEl=null; }
var el=document.getElementById('pp-game-end');
var inst=document.getElementById('pp-instructions');if(inst)inst.style.display='none';
var sub=document.getElementById('score-sub');if(sub)sub.textContent='';
if(el){
el.style.cssText='text-align:center;font-family:Courier New,monospace;font-size:1.4em;margin-top:0.5em;min-height:1.5em;';
if(pw)el.innerHTML='<span style="color:#d4a574;text-shadow:0 0 15px rgba(212,165,116,0.7),0 0 30px rgba(180,130,70,0.4);">\u2605 VICTORY \u2605</span>';
else el.innerHTML='<span style="color:#d8a090;text-shadow:0 0 10px rgba(200,110,90,0.4);">DEFEAT</span>';
}
if(window.dssAudio){if(pw&&window.dssAudio.brightChord)window.dssAudio.brightChord();else if(!pw&&window.dssAudio.muffledThud)window.dssAudio.muffledThud();}
/* 2026-10-28 (Sam: "Easier each retry"): a lost match offers TRY AGAIN (a gentler match) or MOVE ON (the defeat) */
if(!pw&&window.dssEase){window.dssEase.lost('pong');setTimeout(function(){if(!canvas.isConnected)return;window.dssEase.offer(canvas.parentElement,{onAgain:function(){var e=document.getElementById('pp-game-end');if(e)e.innerHTML='';__boot();},onMove:function(){var link=document.querySelector('#pp-go-lose tw-link');if(link)link.click();}});},1700);return;}
setTimeout(function(){
var sel=pw?'#pp-go-win tw-link':'#pp-go-lose tw-link';
var link=document.querySelector(sel);if(link)link.click();
},2000);
}
function rRect(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath();}
// The table itself, pre-rendered once: worn pub baize with drink rings, a
// cigarette burn, and scuffed paddle zones. A back-room table, not a void.
var _felt=document.createElement('canvas');_felt.width=W;_felt.height=H;
(function(fx){
fx.fillStyle='#0b2212';fx.fillRect(0,0,W,H);
// Felt mottle
for(var m=0;m<380;m++){fx.fillStyle='rgba('+(m%2?'6,26,12':'16,44,24')+','+(0.05+Math.random()*0.09)+')';fx.beginPath();fx.arc(Math.random()*W,Math.random()*H,1+Math.random()*2.4,0,Math.PI*2);fx.fill();}
// Wear at both paddle ends — pale scuffed patches where hands rest
[[26,'rgba(120,140,110,0.05)'],[W-26,'rgba(140,120,100,0.05)']].forEach(function(z){
var wg=fx.createRadialGradient(z[0],H/2,10,z[0],H/2,120);wg.addColorStop(0,z[1]);wg.addColorStop(1,'rgba(0,0,0,0)');fx.fillStyle=wg;fx.fillRect(0,0,W,H);});
// Two drink rings and a cigarette burn — it lives in a Soho back room
function ring(cx2,cy2,r2){fx.strokeStyle='rgba(200,180,130,0.065)';fx.lineWidth=3;fx.beginPath();fx.arc(cx2,cy2,r2,0.2,Math.PI*1.8);fx.stroke();}
ring(W*0.19,H*0.2,13);ring(W*0.83,H*0.83,15);
fx.fillStyle='rgba(30,20,10,0.5)';fx.beginPath();fx.ellipse(W*0.68,H*0.12,4,2.4,0.6,0,Math.PI*2);fx.fill();
// Boundary line — real table markings, slightly worn
fx.strokeStyle='rgba(240,240,225,0.20)';fx.lineWidth=2;fx.strokeRect(8,8,W-16,H-16);
fx.strokeStyle='rgba(240,240,225,0.10)';fx.lineWidth=1;fx.beginPath();fx.moveTo(8,H/2);fx.lineTo(W-8,H/2);fx.stroke();
})(_felt.getContext('2d'));
var _ballTrail=[];
function draw(){
ctx.setLineDash([]);
ctx.drawImage(_felt,0,0);
// The hanging lamp overhead — a warm pool on the baize
var lp=ctx.createRadialGradient(W/2,H*0.42,20,W/2,H*0.42,W*0.55);
lp.addColorStop(0,'rgba(255,228,160,0.085)');lp.addColorStop(0.5,'rgba(255,210,130,0.035)');lp.addColorStop(1,'rgba(0,0,0,0)');
ctx.fillStyle=lp;ctx.fillRect(0,0,W,H);
// Net — segmented white rectangles, with its shadow thrown slightly right
var nw=4,nh=7,ng=4,nx=Math.floor(W/2)-Math.floor(nw/2);
ctx.fillStyle='rgba(0,0,0,0.22)';ctx.fillRect(nx+5,4,3,H-8);
ctx.fillStyle='rgba(248,248,235,0.72)';
for(var ni=4;ni<H-4;ni+=nh+ng){ctx.fillRect(nx,ni,nw,Math.min(nh,H-ni-4));}
// Net post caps (top & bottom)
ctx.fillStyle='rgba(248,248,235,0.9)';ctx.fillRect(nx-1,0,nw+2,5);ctx.fillRect(nx-1,H-5,nw+2,5);
// Edge vignette — top/bottom
var ev=ctx.createLinearGradient(0,0,0,H);ev.addColorStop(0,'rgba(0,0,0,0.5)');ev.addColorStop(0.14,'rgba(0,0,0,0)');ev.addColorStop(0.86,'rgba(0,0,0,0)');ev.addColorStop(1,'rgba(0,0,0,0.5)');ctx.fillStyle=ev;ctx.fillRect(0,0,W,H);
// Edge vignette — sides
var eh=ctx.createLinearGradient(0,0,W,0);eh.addColorStop(0,'rgba(0,0,0,0.38)');eh.addColorStop(0.12,'rgba(0,0,0,0)');eh.addColorStop(0.88,'rgba(0,0,0,0)');eh.addColorStop(1,'rgba(0,0,0,0.38)');ctx.fillStyle=eh;ctx.fillRect(0,0,W,H);
// Player paddle — white/cool glow
ctx.shadowColor='rgba(190,210,255,0.85)';ctx.shadowBlur=20;ctx.fillStyle='#dce8f4';rRect(pPad.x,pPad.y,pPad.w,pPad.h,3);ctx.fill();
// Opponent paddle — red with amber rim glow
ctx.shadowColor='rgba(220,70,30,0.75)';ctx.shadowBlur=18;ctx.fillStyle='#bf2c14';rRect(oPad.x,oPad.y,oPad.w,oPad.h,3);ctx.fill();
// Ball trail — a fading comet behind the ball's path
if(!serving){_ballTrail.push({x:ball.x,y:ball.y});if(_ballTrail.length>7)_ballTrail.shift();}
else{_ballTrail.length=0;}
for(var bt=0;bt<_ballTrail.length;bt++){
var ta=(bt+1)/_ballTrail.length*0.22;
ctx.fillStyle='rgba(255,250,225,'+ta+')';
ctx.beginPath();ctx.arc(_ballTrail[bt].x,_ballTrail[bt].y,ball.r*(0.4+0.6*(bt+1)/_ballTrail.length),0,Math.PI*2);ctx.fill();}
// Cast shadow on the baize — the ball rides above the table
ctx.fillStyle='rgba(0,0,0,0.30)';ctx.beginPath();ctx.ellipse(ball.x+3,ball.y+5,ball.r*0.9,ball.r*0.55,0,0,Math.PI*2);ctx.fill();
// Ball — white with strong glow
ctx.shadowColor='rgba(255,255,220,1.0)';ctx.shadowBlur=22;ctx.fillStyle='#f2ede0';ctx.beginPath();ctx.arc(ball.x,ball.y,ball.r,0,Math.PI*2);ctx.fill();
ctx.shadowBlur=0;
// Sweet-spot sparks and the brief gold flare from a completed phrase.
hitSparks=hitSparks.filter(function(s){s.life-=0.07;return s.life>0;});
for(var hs=0;hs<hitSparks.length;hs++){
  var spk=hitSparks[hs]; ctx.save(); ctx.globalAlpha=spk.life;
  ctx.strokeStyle='#dce8f4'; ctx.lineWidth=1.5;
  for(var ray=0;ray<6;ray++){var ra=ray*Math.PI/3+Date.now()*0.002;ctx.beginPath();ctx.moveTo(spk.x,spk.y);ctx.lineTo(spk.x+Math.cos(ra)*12,spk.y+Math.sin(ra)*12);ctx.stroke();}
  ctx.restore();
}
if(rallyBurst){ctx.fillStyle='rgba(255,220,130,0.16)';ctx.fillRect(0,0,W,H);rallyBurst=Math.max(0,rallyBurst-0.035);}
// Point flash — fades over 500ms
if(pointFlashCol){var pfa=1-(Date.now()-pointFlashAt)/500;if(pfa>0){ctx.fillStyle=pointFlashCol+(pfa*0.12)+')';ctx.fillRect(0,0,W,H);}else{pointFlashCol=null;}}
// End flourish — victory washes the table in gold; defeat lets the dark in
if(endAt){var et=Math.min((Date.now()-endAt)/1600,1);
if(endWon){ctx.fillStyle='rgba(232,192,96,'+(0.30*(1-et))+')';ctx.fillRect(0,0,W,H);}
else{ctx.fillStyle='rgba(0,0,0,'+(0.55*et)+')';ctx.fillRect(0,0,W,H);}}
// Drunk radial vignette
if(sobriety<30){var dg=ctx.createRadialGradient(W/2,H/2,H*0.3,W/2,H/2,H*0.7);dg.addColorStop(0,'rgba(0,0,0,0)');dg.addColorStop(1,'rgba(0,0,0,0.5)');ctx.fillStyle=dg;ctx.fillRect(0,0,W,H);}
if(serving){ctx.fillStyle='rgba(255,248,200,0.55)';ctx.font='13px Courier New';ctx.textAlign='center';ctx.fillText('\u00b7  \u00b7  \u00b7',W/2,H/2+40);}
ctx.textAlign='left';ctx.font='10px Courier New';ctx.fillStyle='rgba(220,232,244,0.72)';
ctx.fillText(playerStreak ? ('SWEET SPOT  ' + playerStreak + '/3') : 'CENTRE HITS BUILD A SPECIAL', 18, H-14);
}
function drawCountdown(){
var elapsed = Date.now() - countdownStart;
ctx.fillStyle = 'rgba(4,8,4,0.62)';
ctx.fillRect(0,0,W,H);
ctx.textAlign = 'center';
ctx.font = '12px Courier New, monospace';
ctx.fillStyle = 'rgba(255,248,200,0.7)';
ctx.fillText('GET READY', W/2, H/2 - 80);
ctx.shadowColor = 'rgba(255,248,200,0.7)';
ctx.shadowBlur = 22;
ctx.font = 'bold 88px Courier New, monospace';
if (elapsed < 600)        { ctx.fillStyle = '#dce8f4'; ctx.fillText('3', W/2, H/2 + 30); }
else if (elapsed < 1200)  { ctx.fillStyle = '#dce8f4'; ctx.fillText('2', W/2, H/2 + 30); }
else if (elapsed < 1800)  { ctx.fillStyle = '#bf2c14'; ctx.fillText('1', W/2, H/2 + 30); }
ctx.shadowBlur = 0;
}
function loop(){
if (gameOver) { draw(); if (endAt && Date.now()-endAt < 1600) requestAnimationFrame(loop); return; }
if (phase === 'countdown') {
  updatePlayer();             // let the player position their paddle while we count down
  draw();
  drawCountdown();
  if (Date.now() - countdownStart >= COUNTDOWN_DUR) { phase = 'play'; serve(); }
  requestAnimationFrame(loop);
} else {
  if (!paused) { updatePlayer(); updateAI(); updateBall(); }
  draw();
  requestAnimationFrame(loop);
}
}
setupInput();updateScore();loop();
};(window.dssShowMinigameRules||function(o){o.onPlay()})({key:'pong',play:'Serve',title:'TENNIS COURT OATHS',lines:["Move the paddle with your mouse or finger. First to five points wins."],onPlay:__boot});})();
</script>

:: Eat Shelleys Liver {"position":"500,2050","size":"100,100"}
(set: $hasLiver to false)\
(set: $confidence to ($statGain: $confidence, 22))\
(set: $sobriety to ($statGain: $sobriety, 40))\
<span id="go-after-liver" style="display:none">(link-goto: "·", $liverReturnTo)</span>
<script>
if(window.showLiverPopup) window.showLiverPopup();
if(window.dssAudio) { setTimeout(function(){ window.dssAudio.uncork(); }, 250); setTimeout(function(){ window.dssAudio.swallow(); }, 1100); }
(function(){
  var navigated = false;
  function navOnce(){
    if (navigated) return;
    navigated = true;
    var wrap = document.getElementById('go-after-liver');
    var lk = wrap && wrap.querySelector('tw-link');
    if (lk) lk.click();
  }
  window.addEventListener('liverpopup:closed', navOnce, { once: true });
  setTimeout(navOnce, 25000); // safety fallback if popup never closes
})();
</script>

