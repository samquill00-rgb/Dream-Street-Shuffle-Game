// ---------- THE PEOPLE, barely there ----------
function ghostTex(seed) { return window.dssGhostTex(tex, rnd, seed, false, true, [255, 225, 180]); }
var ghosts = [];
// along the counter, on the customers' side: the man at the bar at the second stool, the painter at the fourth, a third trace beyond the end of the bar
[[1.95, 0.8, 0, 1.0, 0], [4.05, 0.8, 0, 0.9, 2], [5.7, 1.4, 0, 0.62, 4]].forEach(function(gs, i) {
var pAt = P1.clone().add(barDir.clone().multiplyScalar(gs[0])).add(barPerp.clone().multiplyScalar(gs[1]));
var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: ghostTex(gs[4]), transparent: true, opacity: gs[3] * 0.8, depthWrite: false, blending: THREE.NormalBlending }));
sp.scale.set(0.9, 1.8, 1); sp.position.set(pAt.x, 0.9, pAt.z); scene.add(sp);
// a slim unseen body to click, so a tap on the counter beside a figure is the counter's
var hit = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 1.5, 8), new THREE.MeshBasicMaterial({ visible: false }));
hit.position.set(pAt.x, 0.95, pAt.z); scene.add(hit);
ghosts.push({ sp: sp, hit: hit, base: gs[3] * 0.8, ph: i * 2.1 });
});

// 2026-10-28 (Sam): the artists have a table of their own, in the same
// ghost language as the bar figures, with restrained hints of colour.
// Decorative for now: the existing figures and click order remain intact.
var artistTable = new THREE.Group(); artistTable.name='french-artists-table';
artistTable.position.set(1.55,0,0.05);scene.add(artistTable);
var artistTop=mesh(new THREE.CylinderGeometry(.62,.62,.045,40),counterTop,0,.77,0,artistTable);
artistTop.castShadow=true;artistTop.receiveShadow=true;
mesh(new THREE.CylinderGeometry(.065,.095,.72,12),stoolLeg,0,.37,0,artistTable);
for(var foot=0;foot<3;foot++){
  var fa=foot*Math.PI*2/3;
  var tableFoot=mesh(new THREE.BoxGeometry(.48,.04,.075),stoolLeg,Math.cos(fa)*.18,.045,Math.sin(fa)*.18,artistTable);
  tableFoot.rotation.y=-fa;
}
var artists=[];
[
  {x:.92,z:-.56,seed:31,col:[200,218,238],phase:.4},
  {x:2.12,z:-.43,seed:38,col:[229,190,182],phase:2.7},
  {x:2.36,z:.59,seed:46,col:[193,218,184],phase:4.5}
].forEach(function(a){
  stool(a.x,a.z);
  var figure=new THREE.Sprite(new THREE.SpriteMaterial({map:window.dssGhostTex(tex,rnd,a.seed,true,true,a.col),transparent:true,opacity:.72,depthWrite:false,blending:THREE.NormalBlending}));
  figure.name='french-table-artist';figure.scale.set(1.05,1.9,1);figure.position.set(a.x,.95,a.z);scene.add(figure);
  // Table and seated figures share the artists' approach, not the bar man's hit target.
  var artistHit=new THREE.Mesh(new THREE.CylinderGeometry(.22,.22,1.4,8),new THREE.MeshBasicMaterial({visible:false}));
  artistHit.position.set(a.x-artistTable.position.x,.95,a.z-artistTable.position.z);artistTable.add(artistHit);
  artists.push({sp:figure,base:.72,ph:a.phase,y:.95});
});
