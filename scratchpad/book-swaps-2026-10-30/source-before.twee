        for (var i = 0; i < 4; i++) for (var j = 0; j < 3; j++) {
          var can = cyl(0.09, 0.09, 0.28, 10, canMats[(i + j + tier) % canMats.length], -0.38 + i * 0.25, y2 + 0.14, -0.32 + j * 0.32, g);
        }
