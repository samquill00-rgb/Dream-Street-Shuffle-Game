      var bp = ac.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 2200; bp.Q.value = 0.6;
      var hg = ac.createGain(); hg.gain.setValueAtTime(0.0001, now);
      hg.gain.exponentialRampToValueAtTime(0.012, now + 3.0); hg.gain.exponentialRampToValueAtTime(0.0001, now + dur);
      hs.connect(bp); bp.connect(hg); hg.connect(ac.destination); hs.start(now); hs.stop(now + dur + 0.05);
    });
