      var col = open ? '226,196,150' : (status === 'grey' ? '150,138,118' : '110,100,88'), pulse = open ? 0.5 + 0.22 * Math.sin(S.t * 0.06) : 0.2;
      var gx = g.side === 'top' ? (g.x0 + g.x1) / 2 : COLS * T, gy = g.side === 'top' ? 0 : (g.y0 + g.y1) / 2;
