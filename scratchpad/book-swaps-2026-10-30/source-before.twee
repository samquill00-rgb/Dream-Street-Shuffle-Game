  for (var sbi = -0.5; sbi <= 1.5; sbi += 0.35) {
    placeMesh(shop, new THREE.CylinderGeometry(0.025, 0.02, 0.15, 5),
      new THREE.MeshStandardMaterial({ color: 0x6a2a2a, roughness: 0.4 }),
      sbi, 1.52, 0.0);
  }
  // Salt and vinegar (bigger bottles)
  placeMesh(shop, new THREE.CylinderGeometry(0.03, 0.025, 0.2, 5),
    new THREE.MeshStandardMaterial({ color: 0xd0d0c0, roughness: 0.5 }), -0.1, 1.55, 0.05);
  placeMesh(shop, new THREE.CylinderGeometry(0.03, 0.025, 0.2, 5),
    new THREE.MeshStandardMaterial({ color: 0x5a3a1a, roughness: 0.5 }), 0.1, 1.55, 0.05);

  // ---- GOLD NUMBER "7" above fascia ----
  var numTex = makeCanvasTexture(48, 48, function(cx, w, h) {
    cx.clearRect(0, 0, w, h);
    cx.shadowColor = '#c8a840'; cx.shadowBlur = 4;
    cx.fillStyle = '#c8a840';
    cx.font = 'bold 30px Georgia'; cx.textAlign = 'center';
    cx.fillText('7', w / 2, 35);
    cx.shadowBlur = 0;
  });
  var numPlane = new THREE.Mesh(new THREE.PlaneGeometry(0.3, 0.3),
    new THREE.MeshBasicMaterial({ map: numTex, transparent: true }));
  numPlane.position.set(0.5, 4.85, 0.22);
  shop.add(numPlane);

  // ---- WINDOW CONDENSATION (subtle — warm inside, cold out) ----
  var condenseTex = makeCanvasTexture(128, 128, function(cx, w, h) {
    var grad = cx.createLinearGradient(0, 0, 0, h);
    grad.addColorStop(0, 'rgba(200, 200, 200, 0)');
    grad.addColorStop(0.7, 'rgba(200, 200, 200, 0.03)');
    grad.addColorStop(1, 'rgba(200, 200, 200, 0.08)');
    cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
  });
  var condensePlane = new THREE.Mesh(new THREE.PlaneGeometry(5.5, 2.5),
    new THREE.MeshBasicMaterial({ map: condenseTex, transparent: true }));
  condensePlane.position.set(0.5, 2.0, 0.36);
  shop.add(condensePlane);

  // ---- DOOR MAT ----
  placeMesh(shop, new THREE.BoxGeometry(0.6, 0.02, 0.3),
    new THREE.MeshStandardMaterial({ color: 0x2a2a1a, roughness: 0.9 }), 0.5, 0.04, 0.55);

  // ---- A-BOARD OUTSIDE (chalkboard) ----
  var aBoardMat = new THREE.MeshStandardMaterial({ color: 0x3a2a1a, roughness: 0.8 });
  // Legs
  var abLeg1 = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.65, 0.3), aBoardMat);
  abLeg1.position.set(2.65, 0.33, 1.3); abLeg1.rotation.z = 0.07; shop.add(abLeg1);
  var abLeg2 = new THREE.Mesh(new THREE.BoxGeometry(0.03, 0.65, 0.3), aBoardMat);
  abLeg2.position.set(2.95, 0.33, 1.3); abLeg2.rotation.z = -0.07; shop.add(abLeg2);
  // Board
  var aBoardTex = makeCanvasTexture(96, 128, function(cx, w, h) {
