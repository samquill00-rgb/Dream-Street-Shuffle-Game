    fine.put(new THREE.CylinderGeometry(0.045,0.045,0.018,10),fine.mat(0x44464c,true),4.05,0.909,2.6,g);
    var broom = cyl(0.015, 0.015, 1.4, 5, new THREE.MeshStandardMaterial({ color: 0x8a7050 }), 4.2, 0.72, 3.2, g); broom.rotation.z = -0.12;
    var br=new THREE.Group();br.position.set(4.2,0.72,3.2);br.rotation.z=-0.12;g.add(br);
    fine.box(0.14,0.07,0.045,0x745d3d,0,-0.6,0,br);
    for(var bs=0;bs<15;bs++){var bx=-0.067+bs*0.009;fine.wire([[bx,-0.62,0],[bx*1.3,-0.69,0.009],[bx*1.5,-0.73,0.012]],0.003,0x9c8b64,br);}
    // a water butt and a hose, a gas bottle by the door
    cyl(0.28, 0.25, 0.8, 12, new THREE.MeshStandardMaterial({ color: 0x2a2a2a, roughness: 0.8 }), -3.9, 0.4, 5.9, g);
    cyl(0.16, 0.16, 0.7, 10, new THREE.MeshStandardMaterial({ color: 0xc8a020, roughness: 0.5, metalness: 0.3 }), -2.6, 0.35, 3.9, g);
    fine.ring(0.28,0.018,0x494843,-3.9,0.79,5.9,g);
    fine.wire([[-3.7,0.12,5.9],[-3.5,0.04,6.05],[-3.3,0.04,5.8],[-3.6,0.04,5.6],[-3.8,0.06,5.8]],0.018,0x393b31,g);
    fine.put(new THREE.SphereGeometry(0.16,16,8),fine.mat(0xb29a52,true),-2.6,0.67,3.9,g).scale.y=0.55;
    fine.box(0.055,0.07,0.04,0x675a3c,-2.6,0.79,3.9,g,true);
    fine.ring(0.075,0.012,0x9f8b4a,-2.6,0.81,3.9,g,true);
    // THE PROPELLER: a Cessna two-blade, leaning against the wall by the window
    var alu = new THREE.MeshStandardMaterial({ color: 0xb8bcc0, roughness: 0.35, metalness: 0.85 });
    var propG = new THREE.Group();
    var hub = cyl(0.12, 0.12, 0.16, 12, alu, 0, 0, 0, propG); hub.rotation.x = Math.PI / 2;
    cyl(0.08, 0.06, 0.24, 10, new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.5 }), 0, 0, 0.16, propG).rotation.x = Math.PI / 2;
    for (var bl2 = 0; bl2 < 2; bl2++) {
      var blade = new THREE.Mesh(new THREE.BoxGeometry(0.16, 1.0, 0.03), alu); blade.position.set(0, bl2 ? 0.55 : -0.55, 0); blade.rotation.y = bl2 ? 0.35 : -0.35; blade.scale.set(1, 1, 1); blade.castShadow = true; propG.add(blade);
      var tip = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.3, 0.03), new THREE.MeshStandardMaterial({ color: 0xe0d020, roughness: 0.5 })); tip.position.set(0, bl2 ? 1.15 : -1.15, 0); tip.rotation.y = bl2 ? 0.35 : -0.35; propG.add(tip);
    }
    for(var hb=0;hb<6;hb++){var ha=hb*Math.PI/3;fine.pin(Math.cos(ha)*0.095,Math.sin(ha)*0.095,0.09,propG);}
    propG.position.set(-3.3, 1.28, 3.72); propG.rotation.z = 0.28; propG.rotation.x = -0.18; g.add(propG);
    makeClickable(propG.children[0], { name: 'The cantina', passage: 'Nazca Approach' });
    [-1,1].forEach(function(side){fine.wire([[-0.07,side*0.15,0.02],[-0.055,side*0.65,0.035],[-0.035,side*1.12,0.025]],0.004,0x777d7c,propG);});
    // rooftop: a water tank on legs, a bent aerial, a bird-shaped nothing
    box(1.2, 0.9, 1.2, new THREE.MeshStandardMaterial({ color: 0x2a2a30, roughness: 0.6, metalness: 0.4 }), 2.5, 4.35, -1.5, g);
    for (var lx = -1; lx <= 1; lx += 2) for (var lz = -1; lz <= 1; lz += 2) cyl(0.03, 0.03, 0.5, 5, poleMat, 2.5 + lx * 0.5, 3.85, -1.5 + lz * 0.5, g);
    var aerial = cyl(0.015, 0.015, 2.0, 4, poleMat, -3, 4.6, -2, g); aerial.rotation.z = 0.1;
    box(0.9, 0.02, 0.02, poleMat, -3, 5.4, -2, g); box(0.6, 0.02, 0.02, poleMat, -3, 5.1, -2, g);
    fine.box(1.24,0.04,1.24,0x47484b,2.5,4.82,-1.5,g,true);
    fine.wire([[3.08,4.2,-1.5],[3.27,4.2,-1.5],[3.3,3.45,-1.5],[3.55,3.4,-1.5]],0.035,0x68675d,g);
    // the whole block faces the road
    g.position.set(CX, 0, CZ); g.rotation.y = Math.PI / 2 - 0.12;
    scene.add(g);
    makeClickable(g.children[0], { name: 'The cantina', passage: 'Nazca Approach' });
  })();
  // the bare-earth forecourt and the tyre marks where the bus stops
  (function() {
    var fc = new THREE.Mesh(new THREE.CircleGeometry(9, 24), new THREE.MeshStandardMaterial({ color: 0xa89a84, roughness: 1 })); fc.rotation.x = -Math.PI / 2; fc.position.set(CX + 6, 0.025, CZ); fc.scale.set(1, 0.7, 1); scene.add(fc);
    for (var i = 0; i < 2; i++) { var tm = new THREE.Mesh(new THREE.PlaneGeometry(0.4, 14), new THREE.MeshBasicMaterial({ color: 0x5a5048, transparent: true, opacity: 0.4, depthWrite: false })); tm.rotation.x = -Math.PI / 2; tm.rotation.z = 0.15; tm.position.set(CX + 5.2 + i * 1.7, 0.035, CZ + 2); scene.add(tm); }
    // bus stop: a leaning post with a small tin plate, an arrow, NAZCA in caps
    var post = cyl(0.04, 0.05, 2.4, 6, new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.6, metalness: 0.4 }), -5.2, 1.2, -12); post.rotation.z = 0.06;
    var plate = canvasTex(256, 128, function(ctx, w, h) { ctx.fillStyle = '#1a3a8a'; ctx.fillRect(0, 0, w, h); ctx.fillStyle = '#f0f0e8'; ctx.font = 'bold 54px Arial'; ctx.textAlign = 'center'; ctx.fillText('NAZCA', w / 2 + 20, 80); ctx.beginPath(); ctx.moveTo(24, 64); ctx.lineTo(60, 40); ctx.lineTo(60, 88); ctx.fill(); for (var i = 0; i < 300; i++) { ctx.fillStyle = 'rgba(160,100,50,' + Math.random() * 0.5 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 3, 2); } });
    var pl = new THREE.Mesh(new THREE.PlaneGeometry(0.9, 0.45), new THREE.MeshStandardMaterial({ map: plate, roughness: 0.6, side: THREE.DoubleSide })); pl.position.set(-5.05, 2.1, -12); pl.rotation.y = Math.PI / 2 + 0.3; scene.add(pl);
  })();

  // ============================================================
  // POWER LINE along the road, poles receding into the dusk
  // ============================================================
  (function() {
    var poleMat = new THREE.MeshStandardMaterial({ color: 0x4a3a2a, roughness: 0.9 });
    var wireMat = new THREE.LineBasicMaterial({ color: 0x141414 });
    var prev = null;
    for (var i = 0; i < 14; i++) {
      var z = 10 - i * 22, x = -6.5 - Math.max(0, -z - 60) * 0.06;
      cyl(0.09, 0.12, 7, 7, poleMat, x, 3.5, z);
      box(1.4, 0.1, 0.1, poleMat, x, 6.6, z);
      var ins = new THREE.MeshStandardMaterial({ color: 0xd8d8d0, roughness: 0.3 });
      cyl(0.05, 0.05, 0.12, 6, ins, x - 0.6, 6.7, z); cyl(0.05, 0.05, 0.12, 6, ins, x + 0.6, 6.7, z);
      var cur = [new THREE.Vector3(x - 0.6, 6.75, z), new THREE.Vector3(x + 0.6, 6.75, z)];
      if (prev) for (var w = 0; w < 2; w++) { var pts = []; for (var k = 0; k <= 12; k++) { var t = k / 12; pts.push(new THREE.Vector3(prev[w].x + (cur[w].x - prev[w].x) * t, 6.75 - Math.sin(t * Math.PI) * 0.7, prev[w].z + (cur[w].z - prev[w].z) * t)); } scene.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts), wireMat)); }
      prev = cur;
    }
  })();
  // distant hills to the left and the road vanishing
  (function() {
    var hillMat = new THREE.MeshStandardMaterial({ color: 0x3a3a48, roughness: 1 });
    for (var i = 0; i < 6; i++) { var h = mesh(new THREE.SphereGeometry(rand(90, 160), 12, 8), hillMat, -260 - i * 60 + rand(-30, 30), -70, -420 - i * 60 + rand(-40, 40)); h.scale.set(1.8, 0.45, 1); h.castShadow = false; }
  })();

  // ============================================================
  // HEAT SHIMMER: pale sprites low over the road and the pampa, wavering
  // ============================================================
  var shimmerTex = radialTex(240, 230, 215, 0.14, 0.5);
  var shimmers = [];
  for (var si = 0; si < 40; si++) {
    var sh = new THREE.Sprite(new THREE.SpriteMaterial({ map: shimmerTex, transparent: true, depthWrite: false, opacity: rand(0.15, 0.4) }));
    var ss = rand(2, 6); sh.scale.set(ss, ss * 0.28, 1);
    sh.position.set(rand(-14, 12), rand(0.15, 0.9), rand(-120, -6)); scene.add(sh);
    shimmers.push({ s: sh, y0: sh.position.y, ph: rand(0, 6.3), sp: rand(1.2, 2.6), base: sh.material.opacity, sx: ss });
  }

  // ============================================================
  // FOG LAYERS: dust haze over the road, a blue band on the pampa, sea mist under the sun, warm haze at the cantina
  // ============================================================
  var fogSprites = [];
  function addFog(tex, n, x0, x1, y0, y1, z0, z1, s0, s1, op0, op1, aspect) {
    for (var i = 0; i < n; i++) {
      var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false, opacity: rand(op0, op1) }));
      var s = rand(s0, s1); sp.scale.set(s, s * aspect, 1);
      sp.position.set(rand(x0, x1), rand(y0, y1), rand(z0, z1)); scene.add(sp);
      fogSprites.push({ sprite: sp, baseX: sp.position.x, drift: rand(0.001, 0.004), sway: rand(0, 6.3), swaySpeed: rand(0.0005, 0.002), swayAmt: rand(0.3, 1.5), lo: x0 - 8, hi: x1 + 8 });
    }
  }
  var dustHaze = radialTex(200, 180, 150, 0.18, 0.4), blueBand = radialTex(90, 110, 160, 0.14, 0.45), seaMist = radialTex(255, 200, 150, 0.12, 0.4), warmHaze = radialTex(255, 190, 120, 0.14, 0.4);
  addFog(dustHaze, 40, -30, 12, 0.2, 1.8, -220, 10, 8, 26, 0.12, 0.26, 0.3);
  addFog(blueBand, 26, -80, 10, 1.5, 6, -260, -30, 20, 60, 0.08, 0.18, 0.3);
  addFog(seaMist, 20, 30, 260, -2, 4, -300, -40, 30, 90, 0.08, 0.16, 0.3);
  addFog(warmHaze, 12, CX - 4, CX + 8, 0.5, 3.5, CZ - 5, CZ + 5, 4, 10, 0.1, 0.2, 0.4);

  // ============================================================
  // ANIMATION
  // ============================================================
  var clock = new THREE.Clock();
  function animate() {
    if (!nzActive) return;
    nzAnimId = requestAnimationFrame(animate);
    var t = nzStill ? 30 : clock.getElapsedTime();
    var p = seaGeo.attributes.position;
    for (var i = 0; i < p.count; i++) { var b = seaBase[i]; p.setZ(i, Math.sin(b.x * 0.05 + t * 0.5) * 0.35 + Math.sin(b.y * 0.04 - t * 0.4 + b.x * 0.02) * 0.3 + Math.sin((b.x + b.y) * 0.2 + t * 1.0) * 0.08); }
    p.needsUpdate = true; seaGeo.computeVertexNormals();
    for (var f = 0; f < foamLines.length; f++) { var fl = foamLines[f]; var w = Math.sin(t * 0.4 + fl.ph); fl.m.position.x = fl.baseX - w * 0.6; fl.m.material.opacity = fl.baseOp * (0.6 + 0.4 * Math.max(0, w)); }
    for (var i2 = 0; i2 < (nzStill ? 0 : fogSprites.length); i2++) { var fs = fogSprites[i2]; fs.sway += fs.swaySpeed; fs.sprite.position.x = fs.baseX + Math.sin(fs.sway) * fs.swayAmt; fs.baseX += fs.drift; if (fs.baseX > fs.hi) fs.baseX = fs.lo; }
    for (var s = 0; s < shimmers.length; s++) { var sh = shimmers[s]; sh.s.position.y = sh.y0 + Math.sin(t * sh.sp + sh.ph) * 0.08; sh.s.material.opacity = sh.base * (0.6 + 0.4 * Math.sin(t * sh.sp * 1.3 + sh.ph)); sh.s.scale.x = sh.sx * (1 + Math.sin(t * sh.sp * 0.7 + sh.ph) * 0.08); }
    // the bulb coming on: warms over the first half minute, then a slow breathing with a tired flicker
    var on = Math.min(1, t / 28), fl2 = 0.94 + Math.sin(t * 9.1) * 0.03 + Math.sin(t * 23.7) * 0.03;
    window.__bulbLight.intensity = (0.15 + on * 1.4) * fl2;
    window.__bulbHalo.material.opacity = (0.08 + on * 0.55) * fl2;
    window.__bulbHalo2.material.opacity = (0.03 + on * 0.22) * fl2;
    if (nzPorch) nzPorch.material.opacity = (0.035 + on * 0.085) * fl2;
    window.__bulb.material.color.setRGB(0.6 + on * 0.4, 0.45 + on * 0.4, 0.3 + on * 0.35);
    sunHalo.material.opacity = 0.48 + Math.sin(t * 0.15) * 0.04;
    sunRoad.material.opacity = 0.5 + Math.sin(t * 0.6) * 0.05;
    raycaster.setFromCamera(mouseNDC, camera);
    var hits = mouseMoved ? raycaster.intersectObjects(clickableObjects) : [];
    var hv = hits.length ? venueData.get(hits[0].object) : null;
    if (hv !== hoveredVenue) {
      hoveredVenue = hv;
      if (hv) { tooltip.textContent = hv.name; tooltip.classList.add('visible'); nzWrap.style.cursor = 'pointer'; }
      else { tooltip.classList.remove('visible'); nzWrap.style.cursor = ''; }
    }
    renderer.render(scene, camera);
  }
  animate();

var nzBtn = document.createElement('div');
nzBtn.textContent = 'STEP DOWN FROM THE BUS';
nzBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(226,170,96,0.85);border:1px solid rgba(226,170,96,0.3);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
setTimeout(function() { nzBtn.style.opacity = '1'; }, 2200);
nzBtn.addEventListener('mouseenter', function() { nzBtn.style.borderColor = 'rgba(226,170,96,0.6)'; });
nzBtn.addEventListener('mouseleave', function() { nzBtn.style.borderColor = 'rgba(226,170,96,0.3)'; });
nzBtn.addEventListener('click', function(e) { e.stopPropagation(); nzEnter(); });
nzWrap.appendChild(nzBtn);
document.body.appendChild(nzWrap);
if (window.dssFilmGrade) window.dssFilmGrade(nzWrap);
}

setInterval(function() {
var container = document.getElementById('nz-container');
if (container && !nzActive) {
initnz();
} else if (!container && nzActive) {
nzActive = false;
if (nzAnimId) { cancelAnimationFrame(nzAnimId); nzAnimId = null; }
window._dssDisposeWrap('nz-wrap');
}
}, 300);
})();

// ====== EASTER ISLAND SHORE SCENE — INLINE ======
// Night on wet basalt. The moon on the water, the boat's wake going,
// one moai at the top of the beach with the white sign on its chest.
// Ported 2026-09-14 from easter-island-shore-3d-static.html, the standalone
// prototype built on 2026-09-12. Standard lifecycle: ei-container / ei-wrap /
// _dssDisposeWrap. The overlay fades in place to reveal the passage prose;
// each world is entered once, from the Third Pillar Portal.
(function() {
var eiActive = false;
var eiAnimId = null;

function initei() {
if (eiActive) return;
eiActive = true;
if (typeof THREE === 'undefined') {
var sc = document.createElement('script');
sc.src = 'vendor/three/three.min.js';
sc.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildeiScene) : buildeiScene()); };
document.head.appendChild(sc);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildeiScene) : buildeiScene());
}
}

function buildeiScene() {
var eiWrap = document.createElement('div');
eiWrap.id = 'ei-wrap';
eiWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#04060c;';

// the prototype's fixed labels, re-homed inside the overlay
var eiStamp = document.createElement('div');
eiStamp.textContent = 'RAPA NUI';
eiStamp.style.cssText = 'position:absolute;top:18px;right:24px;font:14px "Courier New",monospace;color:rgba(156,186,224,0.5);letter-spacing:2px;pointer-events:none;z-index:9002;';
eiWrap.appendChild(eiStamp);
var eiLoc = document.createElement('div');
eiLoc.classList.add('dss-room-caption');
eiLoc.textContent = 'EASTER ISLAND SHORE';
eiLoc.style.cssText = 'position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New",monospace;color:rgba(156,186,224,0.4);letter-spacing:2px;pointer-events:none;z-index:9002;';
eiWrap.appendChild(eiLoc);
var eiTip = document.createElement('div');
eiTip.style.cssText = 'position:fixed;padding:6px 14px;background:rgba(20,17,16,0.94);border:1px solid rgba(156,186,224,0.45);font:italic 13px Georgia,serif;color:#e8d5b7;pointer-events:none;opacity:0;transition:opacity 0.3s;z-index:9003;';
eiTip.classList.add('ei-tip');
eiWrap.appendChild(eiTip);
// the prototype toggles the tooltip with a .visible class
var eiTipObs = new MutationObserver(function() {
eiTip.style.opacity = eiTip.classList.contains('visible') ? '1' : '0';
});
eiTipObs.observe(eiTip, { attributes: true, attributeFilter: ['class'] });

var eiEntered = false;
function eiEnter() {
if (eiEntered) return;
eiEntered = true;
eiWrap.style.transition = 'opacity 1.6s ease';
eiWrap.style.opacity = '0';
setTimeout(function() {
if (eiAnimId) { cancelAnimationFrame(eiAnimId); eiAnimId = null; }
try { eiTipObs.disconnect(); } catch(e) {}
window._dssDisposeWrap('ei-wrap');
}, 1600);
}

  // ============================================================
  // SCENE SETUP
  // ============================================================
  var scene = new THREE.Scene();
  var fine = window.dssDreamDetail(scene);
  scene.background = new THREE.Color(0x030605); /* 2026-10-23 (Sam): Easter Island, drowned bottle-green, a silver moon */
  scene.fog = new THREE.FogExp2(0x0c1614, 0.017);

  // LAYOUT: the waterline runs along the z axis at x = 0. Sea is x < 0 (off to the
  // left), the basalt beach rises from x = 0 to x = 16 where the moai stand, backs
  // to the sea, on a low rise. The camera stands on the wet stones near the water,
  // looking up the beach on the diagonal: sea and moon at the left, the near moai
  // up-right, the others dim behind it.
  var camera = new THREE.PerspectiveCamera(58, window.innerWidth / window.innerHeight, 0.1, 300);
  camera.position.set(2.6, 2.3, 11);
  camera.lookAt(3.0, 3.0, -9);

  var renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
  renderer.toneMappingExposure = 0.74;
  eiWrap.appendChild(renderer.domElement);
  renderer.domElement.style.display = 'block';
  window._dssBindScene('ei-wrap', scene, renderer, camera);

  // resize is handled by _dssBindScene above.

  // ============================================================
  // CLICK TO ENTER
  // ============================================================
  var clickableObjects = [], venueData = new Map(), mouseNDC = new THREE.Vector2(-2, -2), mouseMoved = false;
  var raycaster = new THREE.Raycaster(), hoveredVenue = null, tooltip = eiTip;
  function makeClickable(mesh, info) { clickableObjects.push(mesh); venueData.set(mesh, info); }
  eiWrap.addEventListener('mousemove', function(e) {
    mouseMoved = true;
    mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
    tooltip.style.left = (e.clientX + 15) + 'px'; tooltip.style.top = (e.clientY - 30) + 'px';
  });
  eiWrap.addEventListener('click', function() { if (hoveredVenue) eiEnter(); });

  // ============================================================
  // HELPERS
  // ============================================================
  function canvasTex(w, h, draw, rep) {
    var c = document.createElement('canvas'); c.width = w; c.height = h;
    draw(c.getContext('2d'), w, h);
    var t = new THREE.CanvasTexture(c);
    if (rep) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rep[0], rep[1]); }
    t.anisotropy = 8;
    return t;
  }
  function rand(a, b) { return a + Math.random() * (b - a); }
  function mesh(geo, mat, x, y, z, parent) {
    var m = new THREE.Mesh(geo, mat); m.position.set(x, y, z);
    m.castShadow = true; m.receiveShadow = true; (parent || scene).add(m); return m;
  }
  function radialTex(r, g, b, a, mid) {
    return canvasTex(128, 128, function(ctx) {
      var gr = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
      gr.addColorStop(0, 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')');
      gr.addColorStop(mid || 0.4, 'rgba(' + r + ',' + g + ',' + b + ',' + (a * 0.4) + ')');
      gr.addColorStop(1, 'rgba(' + r + ',' + g + ',' + b + ',0)');
      ctx.fillStyle = gr; ctx.fillRect(0, 0, 128, 128);
    });
  }
  function halo(r, g, b, size, x, y, z, opacity, noFog) {
    var m = new THREE.SpriteMaterial({ map: radialTex(r, g, b, 0.9), blending: THREE.AdditiveBlending, transparent: true, depthWrite: false, opacity: opacity || 0.6 });
    if (noFog) m.fog = false;
    var s = new THREE.Sprite(m); s.scale.set(size, size, 1); s.position.set(x, y, z); scene.add(s); return s;
  }

  // ============================================================
  // SKY: night dome, stars, the moon low over the sea
  // ============================================================
  var skyTex = canvasTex(1024, 1024, function(ctx, w, h) {
    var g = ctx.createLinearGradient(0, 0, 0, h);
    g.addColorStop(0, '#020403'); g.addColorStop(0.35, '#050c0a'); g.addColorStop(0.5, '#0c1814'); g.addColorStop(0.56, '#142420'); g.addColorStop(0.62, '#0c1614'); g.addColorStop(1, '#030605');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    // a long low cloud bank on the horizon
    ctx.globalAlpha = 0.22;
    for (var i = 0; i < 26; i++) { ctx.fillStyle = i % 3 ? '#0c1626' : '#182a44'; ctx.beginPath(); ctx.ellipse(Math.random() * w, h * 0.5 + Math.random() * h * 0.06, 90 + Math.random() * 300, 5 + Math.random() * 14, 0, 0, 6.3); ctx.fill(); }
    ctx.globalAlpha = 1;
    for (var s = 0; s < 700; s++) {
      var sy = Math.random() * h * 0.5, br = Math.random();
      ctx.fillStyle = 'rgba(' + (200 + Math.floor(br * 55)) + ',' + (210 + Math.floor(br * 45)) + ',255,' + (0.15 + br * 0.7) + ')';
      ctx.beginPath(); ctx.arc(Math.random() * w, sy, 0.3 + br * 0.9, 0, 6.3); ctx.fill();
    }
  });
  var sky = new THREE.Mesh(new THREE.SphereGeometry(140, 32, 24), new THREE.MeshBasicMaterial({ map: skyTex, side: THREE.BackSide, fog: false }));
  scene.add(sky);

  // The moon: a disc sprite with a soft halo, low over the water at the left
  var MOON = new THREE.Vector3(-24, 15, -84);
  var moonTex = canvasTex(128, 128, function(ctx) {
    var g = ctx.createRadialGradient(58, 58, 4, 64, 64, 30);
    g.addColorStop(0, '#eef0f3'); g.addColorStop(0.75, '#c8ccd2'); g.addColorStop(1, 'rgba(180,190,184,0)');
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(64, 64, 30, 0, 6.3); ctx.fill();
    ctx.fillStyle = 'rgba(120,130,150,0.22)';
    [[52, 56, 7], [72, 70, 5], [60, 78, 4], [78, 50, 3]].forEach(function(m) { ctx.beginPath(); ctx.arc(m[0], m[1], m[2], 0, 6.3); ctx.fill(); });
  });
  var moon = new THREE.Sprite(new THREE.SpriteMaterial({ map: moonTex, transparent: true, fog: false, depthWrite: false }));
  moon.scale.set(8, 8, 1); moon.position.copy(MOON); scene.add(moon);
  halo(200, 215, 240, 24, MOON.x, MOON.y, MOON.z, 0.45, true);
  halo(180, 200, 235, 60, MOON.x, MOON.y, MOON.z, 0.14, true);

  // ============================================================
  // LIGHTING
  // ============================================================
  scene.add(new THREE.AmbientLight(0x2a3c38, 0.55));
  scene.add(new THREE.HemisphereLight(0x2e4440, 0x0a0c0a, 0.4));
  var moonLight = new THREE.DirectionalLight(0xc8ccd2, 1.35);
  moonLight.position.set(-24, 24, -50); moonLight.castShadow = true;
  moonLight.shadow.mapSize.set(2048, 2048);
  moonLight.shadow.camera.left = -30; moonLight.shadow.camera.right = 30; moonLight.shadow.camera.top = 30; moonLight.shadow.camera.bottom = -30;
  moonLight.shadow.camera.near = 1; moonLight.shadow.camera.far = 120; moonLight.shadow.bias = -0.0006;
  scene.add(moonLight);
  var backFill = new THREE.DirectionalLight(0x2a403a, 0.4); backFill.position.set(10, 8, 30); scene.add(backFill);

  // ============================================================
  // TEXTURES
  // ============================================================
  // Wet black basalt: dark cobbles with pale glints where the moon catches them
  var basaltTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#0c0d10'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 900; i++) {
      var v = 14 + Math.floor(Math.random() * 30);
      ctx.fillStyle = 'rgb(' + v + ',' + (v + 2) + ',' + (v + 6) + ')';
      ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 4 + Math.random() * 16, 3 + Math.random() * 10, Math.random() * 3, 0, 6.3); ctx.fill();
    }
    for (var k = 0; k < 500; k++) {
      ctx.fillStyle = 'rgba(150,170,200,' + (0.05 + Math.random() * 0.25) + ')';
      ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 1 + Math.random() * 4, 0.6 + Math.random() * 1.5, Math.random() * 3, 0, 6.3); ctx.fill();
    }
    for (var s = 0; s < 3000; s++) { ctx.fillStyle = 'rgba(0,0,0,' + Math.random() * 0.4 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 2, 2); }
  }, [14, 14]);
  var basaltRough = canvasTex(256, 256, function(ctx, w, h) {
    ctx.fillStyle = '#707070'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 400; i++) { var v = 40 + Math.floor(Math.random() * 120); ctx.fillStyle = 'rgb(' + v + ',' + v + ',' + v + ')'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 3 + Math.random() * 10, 2 + Math.random() * 6, Math.random() * 3, 0, 6.3); ctx.fill(); }
  }, [14, 14]);

  // Sea: near-black water with faint wave bands
  var seaTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#060b14'; ctx.fillRect(0, 0, w, h);
    for (var y = 0; y < h; y += 2) { ctx.fillStyle = 'rgba(40,60,90,' + (0.03 + Math.sin(y * 0.09) * 0.03 + Math.sin(y * 0.31) * 0.015) + ')'; ctx.fillRect(0, y, w, 2); }
    for (var k = 0; k < 260; k++) { ctx.fillStyle = 'rgba(180,200,230,' + Math.random() * 0.06 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 4 + Math.random() * 24, 1); }
  }, [6, 6]);

  // Moai stone: grey-brown tuff, pitted, lichen and a dark damp foot
  var tuffTex = canvasTex(256, 512, function(ctx, w, h) {
    ctx.fillStyle = '#4a443c'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 1400; i++) { var v = 40 + Math.floor(Math.random() * 60); ctx.fillStyle = 'rgba(' + v + ',' + (v - 5) + ',' + (v - 12) + ',0.6)'; ctx.beginPath(); ctx.arc(Math.random() * w, Math.random() * h, 1 + Math.random() * 4, 0, 6.3); ctx.fill(); }
    for (var l = 0; l < 40; l++) { ctx.fillStyle = 'rgba(120,130,80,' + (0.08 + Math.random() * 0.12) + ')'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 4 + Math.random() * 14, 3 + Math.random() * 9, Math.random() * 3, 0, 6.3); ctx.fill(); }
    ctx.strokeStyle = 'rgba(20,16,12,0.35)'; ctx.lineWidth = 1;
    for (var c = 0; c < 14; c++) { ctx.beginPath(); var x0 = Math.random() * w, y0 = Math.random() * h; ctx.moveTo(x0, y0); ctx.lineTo(x0 + (Math.random() - 0.5) * 30, y0 + 20 + Math.random() * 60); ctx.stroke(); }
    var g = ctx.createLinearGradient(0, h * 0.8, 0, h); g.addColorStop(0, 'rgba(0,0,0,0)'); g.addColorStop(1, 'rgba(0,0,0,0.55)'); ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
  });
  var tuffMat = new THREE.MeshStandardMaterial({ map: tuffTex, roughness: 0.9, color: 0xc0b8b0 });
  var tuffDark = new THREE.MeshStandardMaterial({ map: tuffTex, roughness: 0.95, color: 0x6a645c });

  // ============================================================
  // GROUND: the basalt beach rising from the waterline
  // ============================================================
  // A gently rising, lumpy plane. x from -2 (under the water) to 40; z across.
  var beachGeo = new THREE.PlaneGeometry(44, 80, 88, 80);
  (function() {
    var p = beachGeo.attributes.position;
    for (var i = 0; i < p.count; i++) {
      var x = p.getX(i) + 20, z = -p.getY(i); // after rotation: plane y -> world -z
      var rise = Math.max(0, x) * 0.16 + Math.max(0, x - 12) * 0.22;
      var lump = Math.sin(x * 1.3 + z * 0.7) * 0.06 + Math.sin(x * 0.4 - z * 1.9) * 0.05 + Math.sin(x * 2.7 + z * 2.3) * 0.025;
      p.setZ(i, rise + lump * Math.min(1, Math.max(0, x)));
    }
    beachGeo.computeVertexNormals();
  })();
  // 2026-09-16: was MeshStandardMaterial (roughness 0.52, metalness 0.22, roughnessMap basaltRough). The camera stands on
  // the stones and looks along them, and at that grazing angle the standard material's specular/multi-scatter term under the
  // night ambient blew the whole near foreground out to white with black pebble silhouettes. Tested: dimming the moon, the
  // back-fill, the foam, the haze, the shadow map and darkening the colour all left it white; Lambert (no specular) renders the
  // wet basalt as intended. basaltRough is kept for the rock pools and boulders.
  var beachMat = new THREE.MeshLambertMaterial({ map: basaltTex, color: 0xaab4c4 });
  var beach = new THREE.Mesh(beachGeo, beachMat);
  beach.rotation.x = -Math.PI / 2; beach.position.set(20, -0.05, 0); beach.receiveShadow = true; scene.add(beach);
  function beachY(x, z) { var rise = Math.max(0, x) * 0.16 + Math.max(0, x - 12) * 0.22; var lump = Math.sin(x * 1.3 + z * 0.7) * 0.06 + Math.sin(x * 0.4 - z * 1.9) * 0.05 + Math.sin(x * 2.7 + z * 2.3) * 0.025; return -0.05 + rise + lump * Math.min(1, Math.max(0, x)); }

  // pools left in the hollows of the stones
  for (var pi = 0; pi < 22; pi++) {
    var px = rand(0.5, 9), pz = rand(-24, 18);
    var pool = new THREE.Mesh(new THREE.CircleGeometry(rand(0.25, 0.9), 14), new THREE.MeshStandardMaterial({ color: 0x1c2a3c, roughness: 0.04, metalness: 0.8, transparent: true, opacity: 0.55, depthWrite: false }));
    var rim=fine.ring(pool.geometry.parameters.radius,0.012,0x353c42,px,beachY(px,pz)+0.009,pz);rim.scale.y=1;
    pool.rotation.x = -Math.PI / 2; pool.scale.set(1, rand(0.4, 0.8), 1); pool.position.set(px, beachY(px, pz) + 0.012, pz); rim.scale.y=pool.scale.y; scene.add(pool);
  }

  // Boulders and stones: basalt lumps, more of them up the beach
  var boulderMat = new THREE.MeshStandardMaterial({ map: basaltTex, roughness: 0.45, metalness: 0.3, color: 0xb0bccc });
  var boulderDry = new THREE.MeshStandardMaterial({ map: basaltTex, roughness: 0.85, metalness: 0.08, color: 0x8a909c });
  for (var bi = 0; bi < 140; bi++) {
    var bx = rand(-1, 30), bz = rand(-34, 22);
    if (bx > 6 && bx < 14 && bz > -14 && bz < 0) continue; // keep the path to the moai open
    if (bz > 2 && bx < 8) continue;                           // nothing big underfoot
    if (bx > 6 && bx < 12 && bz > -9 && bz < -2) continue;   // and none in the near moai's ahu
    var r = bx < 6 ? rand(0.08, 0.4) : rand(0.15, 1.0);
    var b = mesh(new THREE.DodecahedronGeometry(r, 1), bx < 5 ? boulderMat : boulderDry, bx, beachY(bx, bz) + r * 0.35, bz);
    b.scale.set(rand(0.8, 1.6), rand(0.45, 0.8), rand(0.8, 1.5)); b.rotation.set(rand(0, 3), rand(0, 3), rand(0, 3));
  }
  // gravel / shingle near the waterline
  for (var gi = 0; gi < 400; gi++) {
    var gx = rand(-0.5, 7), gz = rand(-26, 16), gr = rand(0.03, 0.1);
    var g = new THREE.Mesh(new THREE.DodecahedronGeometry(gr, 1), gi % 3 ? boulderMat : boulderDry); g.position.set(gx, beachY(gx, gz) + gr * 0.4, gz); g.scale.y = 0.5; g.rotation.set(rand(0, 3), rand(0, 3), 0); scene.add(g);
  }
  // a tangle of dark kelp and driftwood at the tideline
  (function() {
    var kelp = new THREE.MeshStandardMaterial({ color: 0x151a12, roughness: 0.7 });
    var wood = new THREE.MeshStandardMaterial({ color: 0x7a6a58, roughness: 0.9 });
    for (var i = 0; i < 30; i++) { var kx = rand(1.5, 4.5), kz = rand(-20, 14); var kl=rand(0.4,1.4),kr=rand(0,3),kg=new THREE.Group();kg.position.set(kx,beachY(kx,kz)+0.03,kz);kg.rotation.y=kr;scene.add(kg);fine.wire([[0,0,0],[kl*0.25,0.01,0.08],[kl*0.65,0.008,-0.06],[kl,0,0.02]],0.022,0x151a12,kg); }
    var d = mesh(new THREE.CylinderGeometry(0.06, 0.09, 2.2, 6), wood, 3.4, beachY(3.4, 4) + 0.08, 4); d.rotation.set(Math.PI / 2, 0, 0.6);
    for(var wg=-1;wg<=1;wg++)fine.wire([[wg*0.025,-1.06,0.058],[wg*0.03,-0.3,0.07],[wg*0.02,0.6,0.057],[wg*0.018,1.03,0.045]],0.003,0x514c43,d);
    var d2 = mesh(new THREE.CylinderGeometry(0.03, 0.05, 1.1, 9), wood, 2.1, beachY(2.1, -9) + 0.05, -9); d2.rotation.set(Math.PI / 2, 0, -1.1);
    fine.wire([[0,0,0],[0.04,0.11,0.01],[0.11,0.18,0.02]],0.018,0x7a6a58,d2);
  })();

  // ============================================================
  // SEA: dark water with a slow swell, the moon's road across it
  // ============================================================
  // 2026-09-16: was MeshStandardMaterial (roughness 0.25, metalness 0.55). Same grazing-angle blow-out as the beach: the water
  // nearest the camera rendered pure white. Lambert keeps the wave-band map and the faint emissive; the moon road sprite and the
  // glints carry the shine.
  var seaMat = new THREE.MeshLambertMaterial({ map: seaTex, color: 0x7e9690, emissive: 0x040a08, emissiveIntensity: 0.4 });
  var seaGeo = new THREE.PlaneGeometry(160, 200, 70, 90);
  var seaBase = [];
  (function() { var p = seaGeo.attributes.position; for (var i = 0; i < p.count; i++) seaBase.push({ x: p.getX(i), y: p.getY(i) }); })();
  var sea = new THREE.Mesh(seaGeo, seaMat); sea.rotation.x = -Math.PI / 2; sea.position.set(-80, -0.12, -30); sea.receiveShadow = true; scene.add(sea);
  // the moon road: a long soft streak from under the moon to the shore
  var roadTex = canvasTex(128, 512, function(ctx, w, h) {
    var g = ctx.createLinearGradient(0, 0, 0, h);
    g.addColorStop(0, 'rgba(210,225,250,0)'); g.addColorStop(0.15, 'rgba(210,225,250,0.55)'); g.addColorStop(0.6, 'rgba(190,210,240,0.35)'); g.addColorStop(1, 'rgba(180,200,235,0)');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    var side = ctx.createLinearGradient(0, 0, w, 0); side.addColorStop(0, 'rgba(0,0,0,1)'); side.addColorStop(0.35, 'rgba(0,0,0,0)'); side.addColorStop(0.65, 'rgba(0,0,0,0)'); side.addColorStop(1, 'rgba(0,0,0,1)');
    ctx.globalCompositeOperation = 'destination-out'; ctx.fillStyle = side; ctx.fillRect(0, 0, w, h); ctx.globalCompositeOperation = 'source-over';
    for (var i = 0; i < 500; i++) { ctx.fillStyle = 'rgba(240,245,255,' + Math.random() * 0.5 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 2 + Math.random() * 10, 1); }
  });
  var moonRoad = new THREE.Mesh(new THREE.PlaneGeometry(9, 90), new THREE.MeshBasicMaterial({ map: roadTex, transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, opacity: 0.32 }));
  moonRoad.rotation.x = -Math.PI / 2; moonRoad.rotation.z = -Math.atan2(MOON.x - 0, -(MOON.z - 8)) ; moonRoad.position.set(-22, -0.05, -32); scene.add(moonRoad);
  // glints: little additive sprites that shimmer on the swell
  var glints = [];
  var glintTex = radialTex(220, 232, 255, 0.9, 0.2);
  for (var gi2 = 0; gi2 < 90; gi2++) {
    var t = Math.random(), gx2 = -2 - t * 42 + rand(-4, 4), gz2 = 4 - t * 70 + rand(-5, 5);
    var gs = new THREE.Sprite(new THREE.SpriteMaterial({ map: glintTex, blending: THREE.AdditiveBlending, transparent: true, depthWrite: false, opacity: 0 }));
    var sz = rand(0.25, 0.9); gs.scale.set(sz * 3, sz * 0.5, 1); gs.position.set(gx2, 0.3, gz2); scene.add(gs);
    glints.push({ s: gs, ph: rand(0, 6.3), sp: rand(0.5, 1.6), base: rand(0.25, 0.7) });
  }

  // Foam at the waterline and up the wet stones
  var foamTex = canvasTex(256, 64, function(ctx, w, h) {
    ctx.clearRect(0, 0, w, h);
    for (var i = 0; i < 260; i++) { ctx.fillStyle = 'rgba(225,235,245,' + (0.2 + Math.random() * 0.5) + ')'; ctx.beginPath(); ctx.arc(Math.random() * w, h * 0.2 + Math.random() * h * 0.6, 1 + Math.random() * 5, 0, 6.3); ctx.fill(); }
    var fade = ctx.createLinearGradient(0, 0, 0, h); fade.addColorStop(0, 'rgba(0,0,0,1)'); fade.addColorStop(0.3, 'rgba(0,0,0,0)'); fade.addColorStop(0.7, 'rgba(0,0,0,0)'); fade.addColorStop(1, 'rgba(0,0,0,1)');
    ctx.globalCompositeOperation = 'destination-out'; ctx.fillStyle = fade; ctx.fillRect(0, 0, w, h);
  });
  var foamLines = [];
  for (var fi = 0; fi < 4; fi++) {
    var fm = new THREE.Mesh(new THREE.PlaneGeometry(80, 1.6 - fi * 0.25), new THREE.MeshBasicMaterial({ map: foamTex, transparent: true, depthWrite: false, opacity: 0.5 - fi * 0.08 }));
    fm.rotation.x = -Math.PI / 2; fm.rotation.z = Math.PI / 2; fm.position.set(0.4 + fi * 0.7, 0.03 + fi * 0.1, -8); scene.add(fm);
    foamLines.push({ m: fm, baseX: fm.position.x, ph: fi * 1.4, baseOp: fm.material.opacity });
  }

  // The boat's wake: a V of foam receding out to sea, and the boat itself, far and dark
  (function() {
    var wakeTex = radialTex(215, 228, 245, 0.7, 0.3);
    var n = 26;
    for (var i = 0; i < n; i++) {
      var t = i / (n - 1), x = -4 - t * 26, z = -8 - t * 34;
      for (var side = -1; side <= 1; side += 2) {
        var s = new THREE.Sprite(new THREE.SpriteMaterial({ map: wakeTex, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, opacity: 0.7 * (1 - t * 0.85) }));
        var sz = 0.6 + t * 2.2; s.scale.set(sz * 1.6, sz * 0.35, 1);
        s.position.set(x + side * (0.3 + t * 3.2), 0.28, z + side * (0.1 + t * 1.0)); scene.add(s);
      }
      if (i % 2 === 0) { var c = new THREE.Sprite(new THREE.SpriteMaterial({ map: wakeTex, transparent: true, depthWrite: false, opacity: 0.35 * (1 - t) })); c.scale.set(1.2 + t * 2, 0.3, 1); c.position.set(x, 0.28, z); scene.add(c); }
    }
    // the boat: a low dark hull, a stub mast, a lamp that is only a spark by now
    var boatTex = canvasTex(128, 64, function(ctx, w, h) {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = 'rgba(6,8,12,0.95)';
      ctx.beginPath(); ctx.moveTo(w * 0.1, h * 0.62); ctx.lineTo(w * 0.9, h * 0.62); ctx.lineTo(w * 0.8, h * 0.8); ctx.lineTo(w * 0.22, h * 0.8); ctx.closePath(); ctx.fill();
      ctx.strokeStyle='rgba(112,120,124,0.3)';ctx.lineWidth=0.7;ctx.beginPath();ctx.moveTo(w*0.16,h*0.65);ctx.lineTo(w*0.85,h*0.65);ctx.moveTo(w*0.23,h*0.73);ctx.lineTo(w*0.8,h*0.73);ctx.stroke();
      ctx.fillRect(w * 0.36, h * 0.2, 3, h * 0.44);
      ctx.fillStyle = 'rgba(255,200,120,0.9)'; ctx.beginPath(); ctx.arc(w * 0.38, h * 0.24, 2.2, 0, 6.3); ctx.fill();
    });
    var boat = new THREE.Sprite(new THREE.SpriteMaterial({ map: boatTex, transparent: true, depthWrite: false }));
    boat.scale.set(2.6, 1.3, 1); boat.position.set(-31, 0.35, -44); scene.add(boat);
    window.__boat = boat;
    halo(255, 200, 130, 1.2, -31.3, 0.75, -44, 0.5);
  })();

  // ============================================================
  // THE MOAI: one near, at the top of the beach, with a white sign on its chest;
  // a row of dimmer ones on the rise behind, their backs to the sea
  // ============================================================
  function moai(x, z, scale, faceSea, mat, withSign) {
    var g = new THREE.Group();
    // ahu: a low platform of fitted stones
    mesh(new THREE.BoxGeometry(3.2, 0.5, 2.2), tuffDark, 0, 0.25, 0, g);
    mesh(new THREE.BoxGeometry(3.4, 0.16, 2.4), tuffDark, 0, 0.08, 0, g);
    for (var i = 0; i < 6; i++) mesh(new THREE.BoxGeometry(0.5, 0.18, 0.05), tuffMat, -1.25 + i * 0.5, 0.42, 1.12, g);
    // torso: a tapered block, narrower at the base, with a slight forward lean
    var torso = mesh(new THREE.CylinderGeometry(0.72, 0.58, 2.6, 7), mat, 0, 1.8, 0, g); torso.scale.z = 0.72;
    // shoulders and the long arms folded over the belly
    mesh(new THREE.BoxGeometry(1.5, 0.5, 0.9), mat, 0, 3.05, 0, g);
    var arm = mesh(new THREE.BoxGeometry(0.22, 1.6, 0.22), mat, -0.66, 2.2, 0.28, g); arm.rotation.z = -0.08;
    var arm2 = mesh(new THREE.BoxGeometry(0.22, 1.6, 0.22), mat, 0.66, 2.2, 0.28, g); arm2.rotation.z = 0.08;
    mesh(new THREE.BoxGeometry(1.3, 0.2, 0.22), mat, 0, 1.45, 0.4, g);
    // head: tall, the heavy brow, the long nose, the pursed mouth, the long ears
    var head = mesh(new THREE.BoxGeometry(1.15, 2.1, 0.95), mat, 0, 4.3, 0.05, g);
    mesh(new THREE.BoxGeometry(1.2, 0.26, 0.4), mat, 0, 4.85, 0.42, g);          // brow
    var nose = mesh(new THREE.BoxGeometry(0.34, 1.05, 0.34), mat, 0, 4.25, 0.55, g); nose.rotation.x = 0.12;
    mesh(new THREE.BoxGeometry(0.62, 0.14, 0.16), mat, 0, 3.62, 0.5, g);          // mouth
    mesh(new THREE.BoxGeometry(0.9, 0.26, 0.7), mat, 0, 3.32, 0.15, g);           // chin
    mesh(new THREE.BoxGeometry(0.12, 1.2, 0.34), mat, -0.62, 4.2, -0.1, g);       // ears
    mesh(new THREE.BoxGeometry(0.12, 1.2, 0.34), mat, 0.62, 4.2, -0.1, g);
    mesh(new THREE.BoxGeometry(1.05, 0.2, 0.85), mat, 0, 5.4, 0.0, g);            // flat top
    // the eye sockets are hollow: dark recesses, no eyes
    mesh(new THREE.BoxGeometry(0.28, 0.16, 0.1), new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 1 }), -0.3, 4.62, 0.53, g);
    mesh(new THREE.BoxGeometry(0.28, 0.16, 0.1), new THREE.MeshStandardMaterial({ color: 0x0a0a0a, roughness: 1 }), 0.3, 4.62, 0.53, g);
    // Incisions follow the existing sculpture; keep the original child indices.
    for(var aj=-1.05;aj<1.4;aj+=0.52)fine.box(0.012,0.28,0.008,0x34363a,aj,0.23,1.107,g);
    [-1,1].forEach(function(side){fine.box(0.025,0.72,0.12,0x33343a,side*0.685,4.22,-0.07,g);});
    for(var finger=-0.5;finger<0.6;finger+=0.18)fine.box(0.011,0.095,0.008,0x38383b,finger,1.45,0.514,g);
    fine.box(0.44,0.018,0.008,0x303137,0,3.62,0.586,g);
    if (withSign) {
      // white paint, still tacky, on the chest: a mark that is not a letter
      var signTex = canvasTex(256, 256, function(ctx, w, h) {
        ctx.clearRect(0, 0, w, h);
        ctx.strokeStyle = 'rgba(240,242,236,0.96)'; ctx.lineCap = 'round'; ctx.lineWidth = 22;
        ctx.beginPath(); for (var a = 0; a < 5.2; a += 0.08) { var rr = 14 + a * 16, xx = 128 + Math.cos(a) * rr, yy = 118 + Math.sin(a) * rr * 0.8; if (a === 0) ctx.moveTo(xx, yy); else ctx.lineTo(xx, yy); } ctx.stroke();
        ctx.lineWidth = 14; ctx.beginPath(); ctx.moveTo(40, 220); ctx.lineTo(216, 214); ctx.stroke();
        ctx.lineWidth = 12; ctx.beginPath(); ctx.moveTo(128, 30); ctx.lineTo(128, 62); ctx.stroke();
        for (var d = 0; d < 9; d++) { ctx.fillStyle = 'rgba(240,242,236,0.85)'; ctx.beginPath(); ctx.arc(60 + Math.random() * 150, 200 + Math.random() * 40, 2 + Math.random() * 5, 0, 6.3); ctx.fill(); }
        ctx.lineWidth = 3; ctx.strokeStyle = 'rgba(240,242,236,0.7)'; ctx.beginPath(); ctx.moveTo(62, 205); ctx.lineTo(60, 250); ctx.stroke(); ctx.beginPath(); ctx.moveTo(118, 152); ctx.lineTo(114, 190); ctx.stroke();
      });
      var sign = new THREE.Mesh(new THREE.PlaneGeometry(0.9, 0.9), new THREE.MeshStandardMaterial({ map: signTex, transparent: true, roughness: 0.35, metalness: 0.05, emissive: 0x404040, emissiveIntensity: 0.6, polygonOffset: true, polygonOffsetFactor: -2 }));
      sign.position.set(0, 2.25, 0.535); g.add(sign);
    }
    g.scale.set(scale, scale, scale);
    g.position.set(x, beachY(x, z) - 0.05, z);
    g.rotation.y = faceSea ? -Math.PI / 2 + 0.25 : Math.PI / 2 + rand(-0.15, 0.15);
    scene.add(g); return g;
  }
  var nearMoai = moai(9.2, -6.5, 1.25, true, tuffMat, false); // 2026-10-03: no painted sign (Dr Quill dropped the white signs)
  makeClickable(nearMoai.children[7], { name: 'Easter Island Shore', passage: 'Easter Island Shore' });
  // the row behind, on the rise: backs to the sea, dim in the haze
  moai(19.5, -2.0, 0.95, false, tuffDark, false);
  moai(21.5, 3.5, 1.05, false, tuffDark, false);
  moai(20.5, -13.0, 0.9, false, tuffDark, false);
  moai(24.0, 9.0, 1.0, false, tuffDark, false);
  moai(23.5, -19.0, 0.85, false, tuffDark, false);
  // a fallen one, face down in the stones, half buried
  (function() { var f = moai(17.5, 14.0, 0.9, false, tuffDark, false); f.rotation.set(Math.PI / 2 - 0.15, 0, 0.9); f.position.y -= 0.9; })();

  // a faint warm glow at the foot of the near moai: something left burning in the stones
  var EX = 8.6, EZ = -4.6;
  var emberLight = new THREE.PointLight(0xc07a3a, 1.5, 10, 2); emberLight.position.set(EX, beachY(EX, EZ) + 0.25, EZ); scene.add(emberLight);
  var emberHalo = halo(255, 140, 70, 1.6, EX, beachY(EX, EZ) + 0.2, EZ, 0.55);
  (function() {
    var y = beachY(EX, EZ);
    for (var i = 0; i < 7; i++) { var a = i / 7 * 6.3; mesh(new THREE.DodecahedronGeometry(0.12, 0), boulderDry, EX + Math.cos(a) * 0.32, y + 0.06, EZ + Math.sin(a) * 0.32); }
    var ember = new THREE.Mesh(new THREE.SphereGeometry(0.06, 6, 6), new THREE.MeshBasicMaterial({ color: 0xff7a30 })); ember.position.set(EX, y + 0.08, EZ); scene.add(ember);
    // the ember's light on the wet basalt round the ring: one additive plane
    // laid to the beach's slope (it rises 0.16 per unit of x), a warm pool
    // cut by the stones' shadows, breathing with emberLight in animate.
    var emberPoolTex = canvasTex(128, 128, function(ctx, w, h) {
      var g2 = ctx.createRadialGradient(w / 2, h / 2, 2, w / 2, h / 2, w / 2);
      g2.addColorStop(0, 'rgba(255,150,80,0.9)'); g2.addColorStop(0.3, 'rgba(255,130,60,0.45)'); g2.addColorStop(0.65, 'rgba(255,110,50,0.12)'); g2.addColorStop(1, 'rgba(255,100,40,0)');
      ctx.fillStyle = g2; ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'destination-out';
      for (var st = 0; st < 7; st++) { var a2 = st / 7 * 6.3; ctx.fillStyle = 'rgba(0,0,0,0.85)'; ctx.beginPath(); ctx.ellipse(w / 2 + Math.cos(a2) * w * 0.115, h / 2 + Math.sin(a2) * h * 0.115, 5, 4, a2, 0, 6.3); ctx.fill(); }
      for (var fl3 = 0; fl3 < 90; fl3++) { ctx.fillStyle = 'rgba(0,0,0,' + (0.2 + Math.random() * 0.5) + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 1 + Math.random() * 3, 1 + Math.random() * 2); }
    });
    var emberPool = new THREE.Mesh(new THREE.PlaneGeometry(2.8, 2.8), new THREE.MeshBasicMaterial({ map: emberPoolTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0.14, depthWrite: false }));
    emberPool.rotation.order = 'ZXY'; emberPool.rotation.x = -Math.PI / 2; emberPool.rotation.z = Math.atan(0.16);
    emberPool.position.set(EX, y + 0.1, EZ); scene.add(emberPool);
    window.__emberPool = emberPool;
  })();
  // Pipe-tobacco smoke: a warm wisp drifting past, close to the camera
  var smokeTex = radialTex(225, 190, 150, 0.35, 0.3);
  var smokes = [];
  for (var si = 0; si < 9; si++) {
    var sm = new THREE.Sprite(new THREE.SpriteMaterial({ map: smokeTex, transparent: true, depthWrite: false, opacity: rand(0.08, 0.2) }));
    var ss = rand(0.8, 2.2); sm.scale.set(ss, ss * 0.6, 1);
    sm.position.set(rand(2, 6), rand(1.0, 2.6), rand(4, 8)); scene.add(sm);
    smokes.push({ s: sm, x0: sm.position.x, y0: sm.position.y, ph: rand(0, 6.3), rise: rand(0.05, 0.12), base: sm.material.opacity });
  }

  // ============================================================
  // FOG LAYERS: sea mist, ground haze on the stones, a cold band on the rise
  // ============================================================
  var fogSprites = [];
  function addFog(tex, n, x0, x1, y0, y1, z0, z1, s0, s1, op0, op1, aspect) {
    for (var i = 0; i < n; i++) {
      var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false, opacity: rand(op0, op1) }));
      var s = rand(s0, s1); sp.scale.set(s, s * aspect, 1);
      sp.position.set(rand(x0, x1), rand(y0, y1), rand(z0, z1)); scene.add(sp);
      fogSprites.push({ sprite: sp, baseZ: sp.position.z, drift: rand(0.002, 0.007), sway: rand(0, 6.3), swaySpeed: rand(0.0008, 0.003), swayAmt: rand(0.3, 1.2), lo: z0 - 8, hi: z1 + 8 });
    }
  }
  var seaMist = radialTex(120, 140, 170, 0.2, 0.4), stoneHaze = radialTex(90, 105, 130, 0.16, 0.45), coldBand = radialTex(70, 90, 125, 0.14, 0.5), moonMist = radialTex(180, 195, 225, 0.12, 0.4);
  addFog(seaMist, 44, -50, -2, 0.2, 2.0, -60, 16, 6, 16, 0.18, 0.34, 0.3);
  addFog(stoneHaze, 34, 0, 18, 0.2, 1.4, -34, 20, 4, 11, 0.12, 0.26, 0.32);
  addFog(coldBand, 22, 14, 30, 1.5, 5, -30, 20, 8, 18, 0.1, 0.22, 0.3);
  addFog(moonMist, 12, -40, -16, 1, 6, -60, -20, 12, 26, 0.08, 0.16, 0.35);

  // ============================================================
  // ANIMATION
  // ============================================================
  // Reduced motion: the clock is pinned at 12s (sea, foam, glints and
  // ember settled) and the boat, fog and pipe smoke hold still.
  var eiStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var clock = new THREE.Clock();
  function animate() {
    if (!eiActive) return;
    eiAnimId = requestAnimationFrame(animate);
    var t = eiStill ? 12 : clock.getElapsedTime();
    // swell
    var p = seaGeo.attributes.position;
    for (var i = 0; i < p.count; i++) { var b = seaBase[i]; p.setZ(i, Math.sin(b.x * 0.18 + t * 0.6) * 0.14 + Math.sin(b.y * 0.11 - t * 0.45 + b.x * 0.05) * 0.1 + Math.sin((b.x + b.y) * 0.5 + t * 1.1) * 0.03); }
    p.needsUpdate = true; seaGeo.computeVertexNormals();
    // foam breathes up the stones and back
    for (var f = 0; f < foamLines.length; f++) { var fl = foamLines[f]; var w = Math.sin(t * 0.45 + fl.ph); fl.m.position.x = fl.baseX + w * 0.5; fl.m.material.opacity = fl.baseOp * (0.6 + 0.4 * Math.max(0, w)); }
    for (var g = 0; g < glints.length; g++) { var gl = glints[g]; gl.s.material.opacity = gl.base * Math.max(0, Math.sin(t * gl.sp + gl.ph)) * Math.max(0, Math.sin(t * 0.37 + gl.ph * 2)); }
    moonRoad.material.opacity = 0.3 + Math.sin(t * 0.5) * 0.04;
    // the boat and its spark creep out
    if (!eiStill && window.__boat) { window.__boat.position.x -= 0.0015; window.__boat.position.z -= 0.0012; window.__boat.position.y = 0.35 + Math.sin(t * 0.8) * 0.03; }
    // fog drift along the shore
    for (var i2 = 0; i2 < (eiStill ? 0 : fogSprites.length); i2++) { var fs = fogSprites[i2]; fs.sway += fs.swaySpeed; fs.sprite.position.z = fs.baseZ + Math.sin(fs.sway) * fs.swayAmt; fs.baseZ += fs.drift; if (fs.baseZ > fs.hi) fs.baseZ = fs.lo; }
    // the pipe smoke rises and thins
    for (var s = 0; s < (eiStill ? 0 : smokes.length); s++) { var sm = smokes[s]; sm.s.position.y += sm.rise * 0.016; sm.s.position.x = sm.x0 + Math.sin(t * 0.3 + sm.ph) * 0.4; sm.s.material.opacity = sm.base * Math.max(0, 1 - (sm.s.position.y - sm.y0) / 2.2); if (sm.s.position.y > sm.y0 + 2.2) sm.s.position.y = sm.y0; }
    emberLight.intensity = 1.4 + Math.sin(t * 2.1) * 0.18 + Math.sin(t * 5.3) * 0.08;
    emberHalo.material.opacity = 0.45 + Math.sin(t * 2.1) * 0.1;
    if (window.__emberPool) window.__emberPool.material.opacity = 0.13 + Math.sin(t * 2.1) * 0.03 + Math.sin(t * 5.3) * 0.015;
    // the moon breathes very slowly in its halo
    moon.material.opacity = 0.94 + Math.sin(t * 0.2) * 0.05;

    raycaster.setFromCamera(mouseNDC, camera);
    var hits = mouseMoved ? raycaster.intersectObjects(clickableObjects) : [];
    var hv = hits.length ? venueData.get(hits[0].object) : null;
    if (hv !== hoveredVenue) {
      hoveredVenue = hv;
      if (hv) { tooltip.textContent = hv.name; tooltip.classList.add('visible'); eiWrap.style.cursor = 'pointer'; }
      else { tooltip.classList.remove('visible'); eiWrap.style.cursor = ''; }
    }
    renderer.render(scene, camera);
  }
  animate();

var eiBtn = document.createElement('div');
eiBtn.textContent = 'WADE ASHORE';
eiBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(156,186,224,0.85);border:1px solid rgba(156,186,224,0.3);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
setTimeout(function() { eiBtn.style.opacity = '1'; }, 2200);
eiBtn.addEventListener('mouseenter', function() { eiBtn.style.borderColor = 'rgba(156,186,224,0.6)'; });
eiBtn.addEventListener('mouseleave', function() { eiBtn.style.borderColor = 'rgba(156,186,224,0.3)'; });
eiBtn.addEventListener('click', function(e) { e.stopPropagation(); eiEnter(); });
eiWrap.appendChild(eiBtn);
document.body.appendChild(eiWrap);
if (window.dssFilmGrade) window.dssFilmGrade(eiWrap);
}

setInterval(function() {
var container = document.getElementById('ei-container');
if (container && !eiActive) {
initei();
} else if (!container && eiActive) {
eiActive = false;
if (eiAnimId) { cancelAnimationFrame(eiAnimId); eiAnimId = null; }
window._dssDisposeWrap('ei-wrap');
}
}, 300);
})();

// ====== PYRAMID MOUTH SCENE — INLINE ======
// The pyramid too big for the frame; the mouth a small lit square
// halfway up. Dust in the air that does not move.
// Ported 2026-09-14 from pyramid-mouth-3d-static.html, the standalone
// prototype built on 2026-09-12. Standard lifecycle: py-container / py-wrap /
// _dssDisposeWrap. The overlay fades in place to reveal the passage prose;
// each world is entered once, from the Third Pillar Portal.
(function() {
var pyActive = false;
var pyAnimId = null;

function initpy() {
if (pyActive) return;
pyActive = true;
if (typeof THREE === 'undefined') {
var sc = document.createElement('script');
sc.src = 'vendor/three/three.min.js';
sc.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildpyScene) : buildpyScene()); };
document.head.appendChild(sc);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildpyScene) : buildpyScene());
}
}

function buildpyScene() {
var pyWrap = document.createElement('div');
pyWrap.id = 'py-wrap';
pyWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#0a0810;';

// the prototype's fixed labels, re-homed inside the overlay
var pyStamp = document.createElement('div');
pyStamp.textContent = 'GIZA';
pyStamp.style.cssText = 'position:absolute;top:18px;right:24px;font:14px "Courier New",monospace;color:rgba(214,158,96,0.5);letter-spacing:2px;pointer-events:none;z-index:9002;';
pyWrap.appendChild(pyStamp);
var pyLoc = document.createElement('div');
pyLoc.classList.add('dss-room-caption');
pyLoc.textContent = 'PYRAMID MOUTH';
pyLoc.style.cssText = 'position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New",monospace;color:rgba(214,158,96,0.4);letter-spacing:2px;pointer-events:none;z-index:9002;';
pyWrap.appendChild(pyLoc);
var pyTip = document.createElement('div');
pyTip.style.cssText = 'position:fixed;padding:6px 14px;background:rgba(20,17,16,0.94);border:1px solid rgba(214,158,96,0.45);font:italic 13px Georgia,serif;color:#e8d5b7;pointer-events:none;opacity:0;transition:opacity 0.3s;z-index:9003;';
pyTip.classList.add('py-tip');
pyWrap.appendChild(pyTip);
// the prototype toggles the tooltip with a .visible class
var pyTipObs = new MutationObserver(function() {
pyTip.style.opacity = pyTip.classList.contains('visible') ? '1' : '0';
});
pyTipObs.observe(pyTip, { attributes: true, attributeFilter: ['class'] });

var pyEntered = false;
function pyEnter() {
if (pyEntered) return;
pyEntered = true;
pyWrap.style.transition = 'opacity 1.6s ease';
pyWrap.style.opacity = '0';
setTimeout(function() {
if (pyAnimId) { cancelAnimationFrame(pyAnimId); pyAnimId = null; }
try { pyTipObs.disconnect(); } catch(e) {}
window._dssDisposeWrap('py-wrap');
}, 1600);
}

  // ============================================================
  // SCENE SETUP
  // ============================================================
  var scene = new THREE.Scene();
  var fine = window.dssDreamDetail(scene);
  scene.background = new THREE.Color(0x08060a); /* 2026-10-23 (Sam): Pyramid, tomb bruise in mauve and umber, gold torchlight */
  scene.fog = new THREE.FogExp2(0x241a24, 0.0062);

  // LAYOUT: the pyramid is centred on the origin, base half-width B, height H.
  // Its south face looks down +z. The camera stands at its foot, off toward the
  // east corner, looking up and across the face: the apex is out of the frame,
  // the mouth is a small dark square halfway up, off-centre to the left.
  var B = 115, H = 73;
  var MY = 36, MX = -26;
  var camera = new THREE.PerspectiveCamera(56, window.innerWidth / window.innerHeight, 0.1, 900);
  camera.position.set(52, 2.2, 142);
  camera.lookAt(-14, 34, 40);

  var renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
  renderer.toneMappingExposure = 0.88; // 2026-09-16: was 0.72; the pyramid face barely read
  pyWrap.appendChild(renderer.domElement);
  renderer.domElement.style.display = 'block';
  window._dssBindScene('py-wrap', scene, renderer, camera);

  // resize is handled by _dssBindScene above.

  // ============================================================
  // CLICK TO ENTER
  // ============================================================
  var clickableObjects = [], venueData = new Map(), mouseNDC = new THREE.Vector2(-2, -2), mouseMoved = false;
  var raycaster = new THREE.Raycaster(), hoveredVenue = null, tooltip = pyTip;
  function makeClickable(mesh, info) { clickableObjects.push(mesh); venueData.set(mesh, info); }
  pyWrap.addEventListener('mousemove', function(e) {
    mouseMoved = true;
    mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
    tooltip.style.left = (e.clientX + 15) + 'px'; tooltip.style.top = (e.clientY - 30) + 'px';
  });
  pyWrap.addEventListener('click', function() { if (hoveredVenue) pyEnter(); });

  // ============================================================
  // HELPERS
  // ============================================================
  function canvasTex(w, h, draw, rep) {
    var c = document.createElement('canvas'); c.width = w; c.height = h;
    draw(c.getContext('2d'), w, h);
    var t = new THREE.CanvasTexture(c);
    if (rep) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rep[0], rep[1]); }
    t.anisotropy = 8;
    return t;
  }
  function rand(a, b) { return a + Math.random() * (b - a); }
  function mesh(geo, mat, x, y, z, parent) {
    var m = new THREE.Mesh(geo, mat); m.position.set(x, y, z);
    m.castShadow = true; m.receiveShadow = true; (parent || scene).add(m); return m;
  }
  function radialTex(r, g, b, a, mid) {
    return canvasTex(128, 128, function(ctx) {
      var gr = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
      gr.addColorStop(0, 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')');
      gr.addColorStop(mid || 0.4, 'rgba(' + r + ',' + g + ',' + b + ',' + (a * 0.4) + ')');
      gr.addColorStop(1, 'rgba(' + r + ',' + g + ',' + b + ',0)');
      ctx.fillStyle = gr; ctx.fillRect(0, 0, 128, 128);
    });
  }
  function halo(r, g, b, size, x, y, z, opacity, noFog) {
    var m = new THREE.SpriteMaterial({ map: radialTex(r, g, b, 0.9), blending: THREE.AdditiveBlending, transparent: true, depthWrite: false, opacity: opacity || 0.6 });
    if (noFog) m.fog = false;
    var s = new THREE.Sprite(m); s.scale.set(size, size, 1); s.position.set(x, y, z); scene.add(s); return s;
  }

  // ============================================================
  // SKY: the last of the light in the west, night coming down from the top
  // ============================================================
  var skyTex = canvasTex(1024, 1024, function(ctx, w, h) {
    var g = ctx.createLinearGradient(0, 0, 0, h);
    g.addColorStop(0, '#08060a'); g.addColorStop(0.3, '#120e14'); g.addColorStop(0.42, '#1e1620'); g.addColorStop(0.49, '#3e2a30'); g.addColorStop(0.53, '#5a3c3a'); g.addColorStop(0.56, '#6a4a44'); g.addColorStop(0.585, '#4a3028'); g.addColorStop(0.62, '#1a1418'); g.addColorStop(1, '#08060a');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    // the glow where the sun went down, to the west (texture x ~ 0.28)
    var sg = ctx.createRadialGradient(w * 0.28, h * 0.58, 0, w * 0.28, h * 0.58, w * 0.3);
    sg.addColorStop(0, 'rgba(240,150,70,0.5)'); sg.addColorStop(0.3, 'rgba(200,110,50,0.22)'); sg.addColorStop(1, 'rgba(120,60,30,0)');
    ctx.fillStyle = sg; ctx.fillRect(0, 0, w, h);
    // thin dark bars of cloud lit on their undersides
    for (var i = 0; i < 14; i++) {
      ctx.fillStyle = 'rgba(30,18,22,0.5)'; ctx.beginPath(); ctx.ellipse(Math.random() * w, h * 0.5 + Math.random() * h * 0.06, 80 + Math.random() * 260, 3 + Math.random() * 7, 0, 0, 6.3); ctx.fill();
      ctx.fillStyle = 'rgba(220,120,60,0.18)'; ctx.beginPath(); ctx.ellipse(Math.random() * w, h * 0.53 + Math.random() * h * 0.04, 60 + Math.random() * 200, 2 + Math.random() * 4, 0, 0, 6.3); ctx.fill();
    }
    // dust in the lower sky: a brown veil
    var dg = ctx.createLinearGradient(0, h * 0.5, 0, h * 0.62); dg.addColorStop(0, 'rgba(120,80,60,0)'); dg.addColorStop(1, 'rgba(90,60,50,0.35)'); ctx.fillStyle = dg; ctx.fillRect(0, h * 0.5, w, h * 0.12);
    for (var s = 0; s < 500; s++) {
      var sy = Math.random() * h * 0.46, br = Math.random() * (1 - sy / (h * 0.5));
      ctx.fillStyle = 'rgba(255,245,230,' + (0.1 + br * 0.7) + ')';
      ctx.beginPath(); ctx.arc(Math.random() * w, sy, 0.3 + br * 0.9, 0, 6.3); ctx.fill();
    }
  });
  var sky = new THREE.Mesh(new THREE.SphereGeometry(700, 32, 24), new THREE.MeshBasicMaterial({ map: skyTex, side: THREE.BackSide, fog: false }));
  sky.rotation.y = 0.9; scene.add(sky);
  // the sun's afterglow, a halo sitting on the horizon behind the pyramid's west shoulder
  var sunGlow = halo(255, 150, 70, 380, -430, 70, -240, 0.42, true);
  halo(255, 120, 60, 180, -430, 40, -240, 0.3, true);

  // ============================================================
  // LIGHTING: a low warm rake from the west, a cold sky from above
  // ============================================================
  scene.add(new THREE.AmbientLight(0x2e2630, 0.78)); // 2026-09-16: was 0.62
  scene.add(new THREE.HemisphereLight(0x4a3a4a, 0x3a2418, 0.78)); // 2026-09-16: was 0.62
  // the sun is down behind the north-west shoulder: the south face is in its own shadow, only the sky lights it
  var sunRake = new THREE.DirectionalLight(0xb0603a, 1.0);
  sunRake.position.set(-300, 42, -150); sunRake.castShadow = true;
  sunRake.shadow.mapSize.set(2048, 2048);
  sunRake.shadow.camera.left = -180; sunRake.shadow.camera.right = 180; sunRake.shadow.camera.top = 140; sunRake.shadow.camera.bottom = -60;
  sunRake.shadow.camera.near = 10; sunRake.shadow.camera.far = 800; sunRake.shadow.bias = -0.0008;
  scene.add(sunRake);
  var skyLight = new THREE.DirectionalLight(0x4a3a50, 0.6); skyLight.position.set(40, 200, 120); scene.add(skyLight);

  // ============================================================
  // TEXTURES
  // ============================================================
  // Core masonry: weathered limestone blocks, joints, sand in the cracks
  var blockTex = canvasTex(1024, 128, function(ctx, w, h) {
    ctx.fillStyle = '#5a4c3a'; ctx.fillRect(0, 0, w, h);
    var x = 0;
    while (x < w) {
      var bw = 40 + Math.random() * 60, v = 130 + Math.random() * 50;
      ctx.fillStyle = 'rgb(' + Math.floor(v) + ',' + Math.floor(v * 0.86) + ',' + Math.floor(v * 0.64) + ')';
      ctx.fillRect(x + 2, 4, bw - 4, h - 8);
      // a chipped top edge, a darker weathered face
      ctx.fillStyle = 'rgba(40,28,18,' + (0.15 + Math.random() * 0.25) + ')'; ctx.fillRect(x + 2, 4, bw - 4, 6 + Math.random() * 10);
      for (var k = 0; k < 20; k++) { ctx.fillStyle = 'rgba(60,40,24,' + Math.random() * 0.3 + ')'; ctx.beginPath(); ctx.arc(x + Math.random() * bw, Math.random() * h, 1 + Math.random() * 6, 0, 6.3); ctx.fill(); }
      if (Math.random() < 0.3) { ctx.strokeStyle = 'rgba(30,20,12,0.5)'; ctx.lineWidth = 1.5; ctx.beginPath(); var cx0 = x + Math.random() * bw; ctx.moveTo(cx0, 4); ctx.lineTo(cx0 + (Math.random() - 0.5) * 20, h - 4); ctx.stroke(); }
      x += bw;
    }
    // sand drifted into the joints
    ctx.fillStyle = 'rgba(200,170,120,0.35)'; ctx.fillRect(0, h - 10, w, 5);
  }, [1, 1]);
  var blockMat = new THREE.MeshStandardMaterial({ map: blockTex, roughness: 0.95, color: 0xd8c8a8 });
  var blockMatB = new THREE.MeshStandardMaterial({ map: blockTex, roughness: 0.95, color: 0xb8a888 });

  // Ground: sand with rubble, the trodden path darker
  var sandTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#b09468'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 300; i++) { var v = 150 + Math.random() * 60; ctx.fillStyle = 'rgba(' + Math.floor(v) + ',' + Math.floor(v * 0.82) + ',' + Math.floor(v * 0.58) + ',0.3)'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 10 + Math.random() * 50, 6 + Math.random() * 30, Math.random() * 3, 0, 6.3); ctx.fill(); }
    for (var p = 0; p < 900; p++) { var pv = 60 + Math.random() * 100; ctx.fillStyle = 'rgb(' + Math.floor(pv) + ',' + Math.floor(pv * 0.85) + ',' + Math.floor(pv * 0.65) + ')'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 1 + Math.random() * 4, 1 + Math.random() * 3, Math.random() * 3, 0, 6.3); ctx.fill(); }
    for (var r = 0; r < 60; r++) { ctx.strokeStyle = 'rgba(80,60,40,' + (0.08 + Math.random() * 0.12) + ')'; ctx.lineWidth = 1 + Math.random() * 2; ctx.beginPath(); var rx = Math.random() * w, ry = Math.random() * h; ctx.moveTo(rx, ry); ctx.quadraticCurveTo(rx + 40, ry + (Math.random() - 0.5) * 30, rx + 90, ry + (Math.random() - 0.5) * 10); ctx.stroke(); }
  }, [40, 40]);
  var sandMat = new THREE.MeshStandardMaterial({ map: sandTex, roughness: 0.98, color: 0x8a7a68 });

  // ============================================================
  // THE PYRAMID: courses of blocks, each a shrinking ring of four long boxes
  // ============================================================
  var pyramid = new THREE.Group();
  var COURSES = 74, ch = H / COURSES;
  for (var c = 0; c < COURSES; c++) {
    var y0 = c * ch, hw = B * (1 - (y0 + ch * 0.5) / H);
    var d = 2.4 + rand(-0.15, 0.15), mat = (c % 7 === 3) ? blockMatB : blockMat;
    // the four sides; the near (+z) face gets its own texture repeat so the blocks read as blocks
    var faceLen = hw * 2;
    if (y0 > MY - 0.05 && y0 < MY + 3.2) {
      var gl = MX - 1.75, gr = MX + 1.75;
      mesh(new THREE.BoxGeometry(gl + hw, ch, d), mat, (gl - hw) / 2, y0 + ch / 2, hw - d / 2, pyramid);
      mesh(new THREE.BoxGeometry(hw - gr, ch, d), mat, (gr + hw) / 2, y0 + ch / 2, hw - d / 2, pyramid);
    } else mesh(new THREE.BoxGeometry(faceLen, ch, d), mat, 0, y0 + ch / 2, hw - d / 2, pyramid);   // south
    mesh(new THREE.BoxGeometry(faceLen, ch, d), mat, 0, y0 + ch / 2, -hw + d / 2, pyramid);          // north
    mesh(new THREE.BoxGeometry(d, ch, faceLen), mat, hw - d / 2, y0 + ch / 2, 0, pyramid);           // east
    mesh(new THREE.BoxGeometry(d, ch, faceLen), mat, -hw + d / 2, y0 + ch / 2, 0, pyramid);          // west
    // a fill block so nothing shows through the corners
    mesh(new THREE.BoxGeometry(faceLen - d, ch, faceLen - 2 * d - 18), blockMatB, 0, y0 + ch / 2, -9, pyramid).castShadow = false;
  }
  // scale the block texture so joints repeat with the course height (UVs of BoxGeometry run 0..1 per face)
  blockTex.repeat.set(24, 1);
  // scattered casing stones surviving near the base, a few loose blocks on the ledges
  for (var i = 0; i < 40; i++) {
    var cy = Math.floor(rand(0, 12)) * ch, chw = B * (1 - (cy + ch * 0.5) / H);
    var cx = rand(-chw + 4, chw - 4);
    var cs = mesh(new THREE.BoxGeometry(rand(1.5, 3.2), ch * 0.9, rand(1.2, 2.2)), blockMatB, cx, cy + ch * 0.45 + 0.05, chw + rand(0.1, 0.9), pyramid);
    cs.rotation.y = rand(-0.2, 0.2);
  }
  scene.add(pyramid);

  // ---- THE MOUTH: a small dark square halfway up, a quarter of the way along ----
  var MZ = B * (1 - MY / H); // depth of the face at that height
  (function() {
    // a recess cut into the courses: a black box set into the face
    var dark = new THREE.MeshStandardMaterial({ color: 0x141008, roughness: 1, side: THREE.BackSide });
    var mouth = mesh(new THREE.BoxGeometry(3.4, 3.2, 8), dark, MX, MY + 1.6, MZ - 3.2); mouth.castShadow = false;
    makeClickable(mouth, { name: 'The mouth of the pyramid', passage: 'Pyramid Mouth' });
    // the gabled relieving stones over the opening: two leaning slabs and a lintel
    var slabMat = new THREE.MeshStandardMaterial({ map: blockTex, roughness: 0.9, color: 0xe0d0b0 });
    var sl = mesh(new THREE.BoxGeometry(6.5, 1.4, 1.6), slabMat, MX - 2.4, MY + 5.2, MZ + 0.4); sl.rotation.z = 0.55;
    var sr = mesh(new THREE.BoxGeometry(6.5, 1.4, 1.6), slabMat, MX + 2.4, MY + 5.2, MZ + 0.4); sr.rotation.z = -0.55;
    mesh(new THREE.BoxGeometry(6.0, 1.1, 1.5), slabMat, MX, MY + 3.55, MZ + 0.4);
    mesh(new THREE.BoxGeometry(1.6, 3.2, 1.4), slabMat, MX - 2.5, MY + 1.6, MZ + 0.3);
    mesh(new THREE.BoxGeometry(1.6, 3.2, 1.4), slabMat, MX + 2.5, MY + 1.6, MZ + 0.3);
    // the sill: a worn threshold stone, dust spilling down the face below it
    mesh(new THREE.BoxGeometry(4.4, 0.4, 2.2), slabMat, MX, MY - 0.1, MZ + 0.6);
    var dustTex = canvasTex(128, 256, function(ctx, w, h) {
      var g = ctx.createLinearGradient(0, 0, 0, h); g.addColorStop(0, 'rgba(200,170,120,0.55)'); g.addColorStop(1, 'rgba(200,170,120,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.moveTo(w * 0.35, 0); ctx.lineTo(w * 0.65, 0); ctx.lineTo(w, h); ctx.lineTo(0, h); ctx.closePath(); ctx.fill();
    });
    var spill = new THREE.Mesh(new THREE.PlaneGeometry(9, 22), new THREE.MeshBasicMaterial({ map: dustTex, transparent: true, depthWrite: false, opacity: 0.7 }));
    spill.position.set(MX, MY - 11, B * (1 - (MY - 11) / H) + 0.25); spill.rotation.x = -Math.atan2(B, H); scene.add(spill);
    for(var ss=-1;ss<=1;ss+=2)fine.wire([[MX+ss*1.8,MY+0.12,MZ+1.71],[MX+ss*0.9,MY+0.1,MZ+1.72],[MX+ss*0.2,MY+0.095,MZ+1.72]],0.018,0x95836a);
    [-1,1].forEach(function(side){fine.wire([[MX+side*2.9,MY+2.8,MZ+1.01],[MX+side*2.65,MY+2.1,MZ+1.015],[MX+side*2.8,MY+1.5,MZ+1.01]],0.012,0x7e6d53);});
    // a faint light deep in the corridor: it is what draws the eye
    var outer = new THREE.PointLight(0xd4ae6a, 1.8, 22, 2); outer.position.set(MX, MY + 1.6, MZ + 2.5); scene.add(outer);
    var inner = new THREE.PointLight(0xf5d070, 2.4, 16, 2); inner.position.set(MX, MY + 1.2, MZ - 2.2); scene.add(inner);
    window.__mouthLight = inner;
    window.__mouthHalo = halo(255, 170, 90, 8, MX, MY + 1.5, MZ + 0.6, 0.7);
    halo(255, 150, 70, 24, MX, MY + 1.5, MZ + 1.4, 0.24);
    var glowPlane = new THREE.Mesh(new THREE.PlaneGeometry(2.8, 2.6), new THREE.MeshBasicMaterial({ color: 0xc07030, transparent: true, opacity: 0.6, depthWrite: false })); glowPlane.position.set(MX, MY + 1.5, MZ - 6.6); scene.add(glowPlane);
    window.__mouthGlow = glowPlane;
    // the mouth's light spilling down the courses below the sill: one
    // additive plane laid to the face's slope (it rises H over B), a warm
    // tongue that fades down the face and is cut by the course joints,
    // breathing with the inner light in animate.
    var spillTex = canvasTex(64, 128, function(ctx, w, h) {
      var g2 = ctx.createLinearGradient(0, 0, w, 0);
      g2.addColorStop(0, 'rgba(255,170,90,0)'); g2.addColorStop(0.3, 'rgba(255,180,100,0.55)'); g2.addColorStop(0.5, 'rgba(255,200,130,0.9)'); g2.addColorStop(0.7, 'rgba(255,180,100,0.55)'); g2.addColorStop(1, 'rgba(255,170,90,0)');
      ctx.fillStyle = g2; ctx.fillRect(0, 0, w, h);
      var v2 = ctx.createLinearGradient(0, 0, 0, h);
      v2.addColorStop(0, 'rgba(0,0,0,0)'); v2.addColorStop(0.3, 'rgba(0,0,0,0.35)'); v2.addColorStop(1, 'rgba(0,0,0,1)');
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = v2; ctx.fillRect(0, 0, w, h);
      for (var j = 4; j < h; j += 9) { ctx.fillStyle = 'rgba(0,0,0,0.55)'; ctx.fillRect(0, j + Math.random() * 2, w, 1.5); }
    });
    var spill = new THREE.Mesh(new THREE.PlaneGeometry(8, 14), new THREE.MeshBasicMaterial({ map: spillTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0.22, depthWrite: false }));
    spill.rotation.x = -(Math.PI / 2 - Math.atan(H / B));
    spill.position.set(MX, MY - 4.1, MZ + 4.1 * B / H + 1.0); scene.add(spill);
    window.__mouthSpill = spill;
    // the climb: a scuffed diagonal up the face from the foot to the mouth, and rubble at the lip
    // the climb: a run of scuffed patches and loose stone up the face from the foot to the mouth
    var scuff = new THREE.MeshBasicMaterial({ color: 0x2a1c10, transparent: true, opacity: 0.4, depthWrite: false });
    for (var k = 0; k < 44; k++) {
      var kt = k / 43, ky = kt * MY, kx = MX + (1 - kt) * 46 + rand(-1.2, 1.2);
      var sc = new THREE.Mesh(new THREE.PlaneGeometry(rand(1.6, 3.2), rand(0.7, 1.3)), scuff);
      sc.position.set(kx, ky + 0.02, B * (1 - ky / H) + 0.35); sc.rotation.x = -Math.atan2(B, H); scene.add(sc);
      if (k % 3 === 0) { var ls = mesh(new THREE.DodecahedronGeometry(rand(0.15, 0.4), 0), blockMatB, kx + rand(-1, 1), ky + 0.3, B * (1 - ky / H) + rand(0.4, 1.2)); ls.rotation.y = rand(0, 3); }
    }
    for (var r = 0; r < 14; r++) { var rx = MX + rand(-4, 4), ry = MY + rand(-1.2, 0.2); var rb = mesh(new THREE.DodecahedronGeometry(rand(0.2, 0.7), 1), blockMatB, rx, ry + 0.2, B * (1 - ry / H) + rand(0.2, 1.4)); rb.rotation.set(rand(0, 3), rand(0, 3), 0); }
  })();

  // ============================================================
  // GROUND: the plateau, the fallen blocks at the foot, the tourist path
  // ============================================================
  var ground = new THREE.Mesh(new THREE.PlaneGeometry(1600, 1600), sandMat);
  ground.rotation.x = -Math.PI / 2; ground.position.set(0, -0.02, 0); ground.receiveShadow = true; scene.add(ground);
  // drifts of sand banked against the base
  var driftMat = new THREE.MeshStandardMaterial({ map: sandTex, roughness: 0.98, color: 0xa08a70 });
  for (var i = 0; i < 40; i++) {
    var dx = rand(-B, B), dz = B + rand(0.5, 5), ds = rand(3, 12);
    var dr = mesh(new THREE.SphereGeometry(ds, 10, 6), driftMat, dx, -ds * 0.72, dz); dr.scale.set(1.6, 0.5, 1); dr.castShadow = false;
  }
  // tumbled blocks and casing fragments along the foot
  for (var i = 0; i < 90; i++) {
    var fx = rand(-B - 10, B + 40), fz = B + rand(2, 26), fs = rand(0.6, 2.6);
    var fb = mesh(new THREE.BoxGeometry(fs * rand(0.8, 1.6), fs * rand(0.5, 1), fs * rand(0.7, 1.4)), Math.random() < 0.5 ? blockMat : blockMatB, fx, fs * 0.28, fz);
    fb.rotation.set(rand(-0.25, 0.25), rand(0, 3), rand(-0.3, 0.3));
  }
  for (var i = 0; i < 400; i++) { var px = rand(-B - 20, B + 80), pz = B + rand(0, 60), pr = rand(0.08, 0.4); var pb = mesh(new THREE.DodecahedronGeometry(pr, 1), blockMatB, px, pr * 0.4, pz); pb.scale.y = 0.6; pb.rotation.y = rand(0, 3); pb.castShadow = false; }
  // the path: a darker trodden band coming in from the right toward the foot below the mouth
  (function() {
    var pathTex = canvasTex(64, 512, function(ctx, w, h) { ctx.fillStyle = 'rgba(70,52,34,0.5)'; ctx.fillRect(w * 0.2, 0, w * 0.6, h); for (var i = 0; i < 200; i++) { ctx.fillStyle = 'rgba(50,36,22,' + Math.random() * 0.5 + ')'; ctx.fillRect(w * 0.1 + Math.random() * w * 0.8, Math.random() * h, 2 + Math.random() * 10, 2); } var side = ctx.createLinearGradient(0, 0, w, 0); side.addColorStop(0, 'rgba(0,0,0,1)'); side.addColorStop(0.3, 'rgba(0,0,0,0)'); side.addColorStop(0.7, 'rgba(0,0,0,0)'); side.addColorStop(1, 'rgba(0,0,0,1)'); ctx.globalCompositeOperation = 'destination-out'; ctx.fillStyle = side; ctx.fillRect(0, 0, w, h); });
    var path = new THREE.Mesh(new THREE.PlaneGeometry(6, 140), new THREE.MeshBasicMaterial({ map: pathTex, transparent: true, depthWrite: false }));
    path.rotation.x = -Math.PI / 2; path.rotation.z = -1.1; path.position.set(30, 0.02, 150); scene.add(path);
    // a rope on iron posts keeping the foot of the climb, a tin sign facing the path, a tyre track
    var iron = new THREE.MeshStandardMaterial({ color: 0x1a1612, roughness: 0.6, metalness: 0.5 });
    var pts = [];
    for (var i = 0; i < 6; i++) { var qx = MX + 6 + i * 6, qz = B + 4 + i * 0.8; mesh(new THREE.CylinderGeometry(0.06, 0.07, 1.1, 6), iron, qx, 0.55, qz); if (i > 0) { var pm = pts[pts.length - 1]; pts.push(new THREE.Vector3((pm.x + qx) / 2, 0.85, (pm.z + qz) / 2)); } pts.push(new THREE.Vector3(qx, 1.05, qz)); }
    for(var rf=0;rf<6;rf++){var fx=MX+6+rf*6,fz=B+4+rf*0.8;fine.ring(0.074,0.018,0x51483a,fx,1.04,fz,null,true);}
    for(var pf=0;pf<6;pf++){var fx=MX+6+pf*6,fz=B+4+pf*0.8;fine.put(new THREE.CylinderGeometry(0.12,0.16,0.045,10),fine.mat(0x66543c),fx,0.025,fz);}
    var rope = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),60,0.026,6,false),fine.mat(0x8a7a5d));scene.add(rope);
    var signTex = canvasTex(256, 160, function(ctx, w, h) { ctx.fillStyle = '#c8b890'; ctx.fillRect(0, 0, w, h); ctx.fillStyle = '#8a1c14'; ctx.fillRect(0, 0, w, 40); ctx.fillStyle = '#e8e0c8'; ctx.font = 'bold 26px Arial'; ctx.textAlign = 'center'; ctx.fillText('NO CLIMBING', w / 2, 30); ctx.fillStyle = '#3a2a1a'; ctx.font = 'bold 30px Arial'; ctx.fillText('ENTRANCE', w / 2, 90); ctx.beginPath(); ctx.moveTo(w * 0.35, 128); ctx.lineTo(w * 0.65, 128); ctx.lineTo(w * 0.5, 100); ctx.fill(); for (var i = 0; i < 300; i++) { ctx.fillStyle = 'rgba(120,80,40,' + Math.random() * 0.3 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 3, 2); } });
    var sign = new THREE.Mesh(new THREE.PlaneGeometry(2.2, 1.4), new THREE.MeshStandardMaterial({ map: signTex, roughness: 0.8, side: THREE.DoubleSide })); sign.position.set(MX + 14, 1.9, B + 9); sign.rotation.y = 0.5; scene.add(sign);
    mesh(new THREE.CylinderGeometry(0.05, 0.06, 2.4, 6), iron, MX + 14, 1.2, B + 9.05);
    var sg=new THREE.Group();sg.position.copy(sign.position);sg.rotation.copy(sign.rotation);scene.add(sg);
    [[-0.98,-0.58],[0.98,-0.58],[-0.98,0.58],[0.98,0.58]].forEach(function(p){fine.pin(p[0],p[1],0.015,sg);});
    fine.box(0.035,1.2,0.035,0x6e5d44,-1.08,0,0.006,sg,true);fine.box(0.035,1.2,0.035,0x6e5d44,1.08,0,0.006,sg,true);
    var treadTex=canvasTex(64,256,function(ctx,w,h){ctx.clearRect(0,0,w,h);ctx.strokeStyle='rgba(62,48,30,0.4)';ctx.lineWidth=5;for(var y=0;y<h;y+=18){ctx.beginPath();ctx.moveTo(5,y);ctx.lineTo(30,y+7);ctx.lineTo(59,y);ctx.stroke();}});
    var tyre = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 90), new THREE.MeshBasicMaterial({ map:treadTex, transparent:true,opacity:0.55,depthWrite:false })); tyre.rotation.x = -Math.PI / 2; tyre.rotation.z = -0.9; tyre.position.set(48, 0.03, 158); scene.add(tyre);
    var tyre2 = tyre.clone(); tyre2.position.set(49.6, 0.03, 159.2); scene.add(tyre2);
  })();

  // Cairo, far off to the left: a low band of warm lights under the dust
  (function() {
    for (var i = 0; i < 40; i++) {
      var lx = -300 - Math.random() * 260, lz = 120 + Math.random() * 120;
      halo(255, 190, 110, rand(3, 8), lx, rand(0.5, 3), lz, rand(0.25, 0.6), true);
    }
    var cityGlow = halo(255, 170, 100, 220, -430, 6, 180, 0.22, true);
  })();

  // ============================================================
  // DUST IN THE AIR THAT DOES NOT MOVE: still motes hanging in the last light
  // ============================================================
  var moteTex = radialTex(240, 210, 170, 0.9, 0.25);
  var motes = [];
  for (var i = 0; i < 260; i++) {
    var ms = new THREE.Sprite(new THREE.SpriteMaterial({ map: moteTex, transparent: true, depthWrite: false, opacity: rand(0.1, 0.4) }));
    var sz = rand(0.03, 0.09); ms.scale.set(sz, sz, 1);
    ms.position.set(camera.position.x + rand(-16, 8), rand(0.3, 9), camera.position.z + rand(-26, 2)); scene.add(ms); motes.push(ms);
  }

  // ============================================================
  // FOG LAYERS: sand haze along the ground, a cool dusk band across the face, the plateau blurring off
  // ============================================================
  var fogSprites = [];
  function addFog(tex, n, x0, x1, y0, y1, z0, z1, s0, s1, op0, op1, aspect) {
    for (var i = 0; i < n; i++) {
      var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false, opacity: rand(op0, op1) }));
      var s = rand(s0, s1); sp.scale.set(s, s * aspect, 1);
      sp.position.set(rand(x0, x1), rand(y0, y1), rand(z0, z1)); scene.add(sp);
      fogSprites.push({ sprite: sp, baseX: sp.position.x, drift: rand(0.001, 0.004), sway: rand(0, 6.3), swaySpeed: rand(0.0004, 0.0015), swayAmt: rand(0.5, 2), lo: x0 - 20, hi: x1 + 20 });
    }
  }
  var sandHaze = radialTex(150, 120, 90, 0.2, 0.4), duskBand = radialTex(70, 60, 110, 0.14, 0.45), warmHaze = radialTex(220, 140, 80, 0.12, 0.4);
  addFog(sandHaze, 40, -160, 160, 0.5, 5, B + 2, B + 90, 20, 60, 0.12, 0.26, 0.28);
  addFog(duskBand, 26, -120, 120, 14, 50, B * 0.4, B + 10, 30, 80, 0.06, 0.14, 0.3);
  addFog(warmHaze, 14, MX - 40, MX + 40, MY - 8, MY + 10, MZ - 2, MZ + 14, 12, 30, 0.08, 0.16, 0.4);
  addFog(sandHaze, 20, -400, -140, 0.5, 8, 40, 300, 40, 120, 0.1, 0.2, 0.25);

  // ============================================================
  // ANIMATION: the light going, the mouth breathing, nothing in the air moving
  // ============================================================
  // Reduced motion: the clock is pinned at 6s and the sand haze stops drifting.
  var pyStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var clock = new THREE.Clock();
  function animate() {
    if (!pyActive) return;
    pyAnimId = requestAnimationFrame(animate);
    var t = pyStill ? 6 : clock.getElapsedTime();
    for (var i = 0; i < (pyStill ? 0 : fogSprites.length); i++) { var f = fogSprites[i]; f.sway += f.swaySpeed; f.sprite.position.x = f.baseX + Math.sin(f.sway) * f.swayAmt; f.baseX += f.drift; if (f.baseX > f.hi) f.baseX = f.lo; }
    window.__mouthLight.intensity = 2.3 + Math.sin(t * 0.9) * 0.2 + Math.sin(t * 3.7) * 0.08;
    window.__mouthHalo.material.opacity = 0.5 + Math.sin(t * 0.9) * 0.08;
    window.__mouthGlow.material.opacity = 0.5 + Math.sin(t * 0.9) * 0.06;
    if (window.__mouthSpill) window.__mouthSpill.material.opacity = 0.2 + Math.sin(t * 0.9) * 0.03 + Math.sin(t * 3.7) * 0.012;
    sunGlow.material.opacity = 0.46 + Math.sin(t * 0.13) * 0.05;
    sunRake.intensity = 1.05 + Math.sin(t * 0.1) * 0.08;
    raycaster.setFromCamera(mouseNDC, camera);
    var hits = mouseMoved ? raycaster.intersectObjects(clickableObjects) : [];
    var hv = hits.length ? venueData.get(hits[0].object) : null;
    if (hv !== hoveredVenue) {
      hoveredVenue = hv;
      if (hv) { tooltip.textContent = hv.name; tooltip.classList.add('visible'); pyWrap.style.cursor = 'pointer'; }
      else { tooltip.classList.remove('visible'); pyWrap.style.cursor = ''; }
    }
    renderer.render(scene, camera);
  }
  animate();

var pyBtn = document.createElement('div');
pyBtn.textContent = 'CLIMB TO THE MOUTH';
pyBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(214,158,96,0.85);border:1px solid rgba(214,158,96,0.3);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
setTimeout(function() { pyBtn.style.opacity = '1'; }, 2200);
pyBtn.addEventListener('mouseenter', function() { pyBtn.style.borderColor = 'rgba(214,158,96,0.6)'; });
pyBtn.addEventListener('mouseleave', function() { pyBtn.style.borderColor = 'rgba(214,158,96,0.3)'; });
pyBtn.addEventListener('click', function(e) { e.stopPropagation(); pyEnter(); });
pyWrap.appendChild(pyBtn);
document.body.appendChild(pyWrap);
if (window.dssFilmGrade) window.dssFilmGrade(pyWrap);
}

setInterval(function() {
var container = document.getElementById('py-container');
if (container && !pyActive) {
initpy();
} else if (!container && pyActive) {
pyActive = false;
if (pyAnimId) { cancelAnimationFrame(pyAnimId); pyAnimId = null; }
window._dssDisposeWrap('py-wrap');
}
}, 300);
})();

// ====== THE PLAIN OF CHEBAR SCENE — INLINE ======
// A bleached river plain, wind from no direction, the stone fifty
// yards off, and a bruise of light in the north that breathes.
// Ported 2026-09-14 from plain-of-chebar-3d-static.html, the standalone
// prototype built on 2026-09-12. Standard lifecycle: pc-container / pc-wrap /
// _dssDisposeWrap. The overlay fades in place to reveal the passage prose;
// each world is entered once, from the Third Pillar Portal.
(function() {
var pcActive = false;
var pcAnimId = null;

function initpc() {
if (pcActive) return;
pcActive = true;
if (typeof THREE === 'undefined') {
var sc = document.createElement('script');
sc.src = 'vendor/three/three.min.js';
sc.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildpcScene) : buildpcScene()); };
document.head.appendChild(sc);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildpcScene) : buildpcScene());
}
}

function buildpcScene() {
var pcWrap = document.createElement('div');
pcWrap.id = 'pc-wrap';
pcWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#b8b4b0;';

// the prototype's fixed labels, re-homed inside the overlay
var pcStamp = document.createElement('div');
pcStamp.textContent = 'BABYLON';
pcStamp.style.cssText = 'position:absolute;top:18px;right:24px;font:14px "Courier New",monospace;color:rgba(46,40,35,0.78);letter-spacing:2px;pointer-events:none;z-index:9002;';
pcWrap.appendChild(pcStamp);
var pcLoc = document.createElement('div');
pcLoc.classList.add('dss-room-caption');
pcLoc.textContent = 'THE PLAIN OF CHEBAR';
pcLoc.style.cssText = 'position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New",monospace;color:rgba(46,40,35,0.72);letter-spacing:2px;pointer-events:none;z-index:9002;';
pcWrap.appendChild(pcLoc);
var pcTip = document.createElement('div');
pcTip.style.cssText = 'position:fixed;padding:6px 14px;background:rgba(240,238,234,0.94);border:1px solid rgba(62,54,48,0.45);font:italic 13px Georgia,serif;color:#2a2420;pointer-events:none;opacity:0;transition:opacity 0.3s;z-index:9003;';
pcTip.classList.add('pc-tip');
pcWrap.appendChild(pcTip);
// the prototype toggles the tooltip with a .visible class
var pcTipObs = new MutationObserver(function() {
pcTip.style.opacity = pcTip.classList.contains('visible') ? '1' : '0';
});
pcTipObs.observe(pcTip, { attributes: true, attributeFilter: ['class'] });

var pcEntered = false;
function pcEnter() {
if (pcEntered) return;
pcEntered = true;
pcWrap.style.transition = 'opacity 1.6s ease';
pcWrap.style.opacity = '0';
setTimeout(function() {
if (pcAnimId) { cancelAnimationFrame(pcAnimId); pcAnimId = null; }
try { pcTipObs.disconnect(); } catch(e) {}
window._dssDisposeWrap('pc-wrap');
}, 1600);
}

  // ============================================================
  // SCENE SETUP
  // ============================================================
  var scene = new THREE.Scene();
  scene.background = new THREE.Color(0x6e6c66); /* 2026-10-23 (Sam): Ezekiel, ash and pewter with a sick yellow, the wheel's gold */
  scene.fog = new THREE.FogExp2(0x6e6c66, 0.0105);

  // LAYOUT: a flat bleached plain. NORTH is -z. The river comes in from the
  // left foreground and runs away to the north-west. The stone stands fifty
  // yards off, right of centre. The camera is on the plain looking north, a
  // little turned so the river cuts the left of the frame on the diagonal.
  var camera = new THREE.PerspectiveCamera(56, window.innerWidth / window.innerHeight, 0.1, 900);
  camera.position.set(6, 1.7, 8);
  camera.lookAt(-4, 2.6, -40);

  var renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
  renderer.toneMappingExposure = 0.7;
  pcWrap.appendChild(renderer.domElement);
  renderer.domElement.style.display = 'block';
  window._dssBindScene('pc-wrap', scene, renderer, camera);

  // resize is handled by _dssBindScene above.

  // ============================================================
  // CLICK TO ENTER
  // ============================================================
  var clickableObjects = [], venueData = new Map(), mouseNDC = new THREE.Vector2(-2, -2), mouseMoved = false;
  var raycaster = new THREE.Raycaster(), hoveredVenue = null, tooltip = pcTip;
  function makeClickable(mesh, info) { clickableObjects.push(mesh); venueData.set(mesh, info); }
  pcWrap.addEventListener('mousemove', function(e) {
    mouseMoved = true;
    mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
    tooltip.style.left = (e.clientX + 15) + 'px'; tooltip.style.top = (e.clientY - 30) + 'px';
  });
  pcWrap.addEventListener('click', function() { if (hoveredVenue) pcEnter(); });

  // ============================================================
  // HELPERS
  // ============================================================
  function canvasTex(w, h, draw, rep) {
    var c = document.createElement('canvas'); c.width = w; c.height = h;
    draw(c.getContext('2d'), w, h);
    var t = new THREE.CanvasTexture(c);
    if (rep) { t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(rep[0], rep[1]); }
    t.anisotropy = 8;
    return t;
  }
  function rand(a, b) { return a + Math.random() * (b - a); }
  function mesh(geo, mat, x, y, z, parent) {
    var m = new THREE.Mesh(geo, mat); m.position.set(x, y, z);
    m.castShadow = true; m.receiveShadow = true; (parent || scene).add(m); return m;
  }
  function radialTex(r, g, b, a, mid) {
    return canvasTex(128, 128, function(ctx) {
      var gr = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
      gr.addColorStop(0, 'rgba(' + r + ',' + g + ',' + b + ',' + a + ')');
      gr.addColorStop(mid || 0.4, 'rgba(' + r + ',' + g + ',' + b + ',' + (a * 0.4) + ')');
      gr.addColorStop(1, 'rgba(' + r + ',' + g + ',' + b + ',0)');
      ctx.fillStyle = gr; ctx.fillRect(0, 0, 128, 128);
    });
  }
  function halo(r, g, b, size, x, y, z, opacity, noFog) {
    var m = new THREE.SpriteMaterial({ map: radialTex(r, g, b, 0.9), blending: THREE.AdditiveBlending, transparent: true, depthWrite: false, opacity: opacity || 0.6 });
    if (noFog) m.fog = false;
    var s = new THREE.Sprite(m); s.scale.set(size, size, 1); s.position.set(x, y, z); scene.add(s); return s;
  }

  // ============================================================
  // SKY: a white overcast, and in the north a bruise of light
  // ============================================================
  var skyTex = canvasTex(2048, 1024, function(ctx, w, h) {
    var g = ctx.createLinearGradient(0, 0, 0, h);
    // 2026-10-06: the sky is drawn un-tone-mapped (see the sky material below), so these are the
    // colours that reach the screen. The horizon stop IS the fog colour, so the far plain, which the
    // fog paints that colour, meets the sky with no seam; the overcast darkens away from it.
    g.addColorStop(0, '#2a2a2c'); g.addColorStop(0.3, '#3a3a3a'); g.addColorStop(0.43, '#4a4a48'); g.addColorStop(0.5, '#6e6c66'); g.addColorStop(0.55, '#6e6c66'); g.addColorStop(0.62, '#5a5850'); g.addColorStop(1, '#2a2a2c');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
    // the cloud: a sheet with a grain to it, thicker toward the north
    for (var i = 0; i < 260; i++) {
      var cy = Math.random() * h * 0.5, cx = Math.random() * w, cw = 60 + Math.random() * 300, ch = 6 + Math.random() * 30;
      var dark = Math.random() < 0.5;
      // Feather every cloud into the overcast; no stamped ellipse boundaries.
      ctx.save(); ctx.translate(cx, cy); ctx.scale(cw, ch);
      var veil = ctx.createRadialGradient(0, 0, 0, 0, 0, 1);
      var ink = dark ? '96,94,104' : '186,184,182';
      veil.addColorStop(0, 'rgba(' + ink + ',0.09)');
      veil.addColorStop(0.45, 'rgba(' + ink + ',0.045)');
      veil.addColorStop(1, 'rgba(' + ink + ',0)');
      ctx.fillStyle = veil; ctx.fillRect(-1, -1, 2, 2); ctx.restore();
    }
    // THE BRUISE: north is texture x = 0.75. A dull violet-brown stain low in the
    // sky with a sick amber glow somewhere behind it. Not a shape. Not yet.
    var bx = w * 0.75, by = h * 0.47;
    var b1 = ctx.createRadialGradient(bx, by, 0, bx, by, w * 0.11);
    b1.addColorStop(0, 'rgba(80,50,90,0.4)'); b1.addColorStop(0.5, 'rgba(100,70,95,0.2)'); b1.addColorStop(1, 'rgba(140,120,120,0)');
    ctx.fillStyle = b1; ctx.fillRect(0, 0, w, h);
    var b2 = ctx.createRadialGradient(bx + 40, by + 14, 0, bx + 40, by + 14, w * 0.035);
    b2.addColorStop(0, 'rgba(184,168,96,0.32)'); b2.addColorStop(0.5, 'rgba(138,132,112,0.12)'); b2.addColorStop(1, 'rgba(110,108,102,0)');
    ctx.fillStyle = b2; ctx.fillRect(0, 0, w, h);
  });
  // toneMapped false: in this three.js build the fog colour is laid on AFTER tone mapping, so the fogged
  // far plain is the raw fog colour while a tone-mapped sky came out darker. That was the hard pale band
  // at the horizon. With the sky un-tone-mapped the two are painted in the same space and can match.
  var sky = new THREE.Mesh(new THREE.SphereGeometry(700, 40, 24), new THREE.MeshBasicMaterial({ map: skyTex, side: THREE.BackSide, fog: false, toneMapped: false }));
  scene.add(sky);
  // the bruise's slow glow, as sprites, low in the north over the river's vanishing point
  var BR = new THREE.Vector3(-90, 48, -600);
  var bruiseCore = halo(210, 150, 90, 70, BR.x + 10, BR.y - 6, BR.z, 0.16, true);
  var bruiseRing = halo(120, 70, 130, 200, BR.x, BR.y, BR.z, 0.14, true);
  var bruiseDark = new THREE.Sprite(new THREE.SpriteMaterial({ map: radialTex(40, 20, 50, 0.5, 0.5), transparent: true, depthWrite: false, fog: false, opacity: 0.22 }));
  bruiseDark.scale.set(180, 70, 1); bruiseDark.position.set(BR.x, BR.y + 4, BR.z); scene.add(bruiseDark);

  // ============================================================
  // LIGHTING: overcast. Nothing casts much. The stone does.
  // ============================================================
  scene.add(new THREE.AmbientLight(0x7a7a74, 0.55));
  scene.add(new THREE.HemisphereLight(0x9a968a, 0x4a4840, 0.6));
  var grey = new THREE.DirectionalLight(0xd8d4d0, 0.6);
  grey.position.set(70, 34, 50); grey.castShadow = true;
  grey.shadow.mapSize.set(2048, 2048);
  grey.shadow.camera.left = -80; grey.shadow.camera.right = 80; grey.shadow.camera.top = 80; grey.shadow.camera.bottom = -80;
  grey.shadow.camera.near = 10; grey.shadow.camera.far = 300; grey.shadow.bias = -0.0006; grey.shadow.radius = 4;
  scene.add(grey);
  var northLight = new THREE.DirectionalLight(0x8a6a90, 0.22); northLight.position.set(-40, 20, -200); scene.add(northLight);

  // ============================================================
  // TEXTURES
  // ============================================================
  // Bleached alluvium: cracked into plates, salt in the cracks, pale
  var plainTex = canvasTex(1024, 1024, function(ctx, w, h) {
    ctx.fillStyle = '#c8c2b6'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 500; i++) { var v = 180 + Math.random() * 50; ctx.fillStyle = 'rgba(' + Math.floor(v) + ',' + Math.floor(v * 0.97) + ',' + Math.floor(v * 0.9) + ',0.35)'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 10 + Math.random() * 60, 8 + Math.random() * 40, Math.random() * 3, 0, 6.3); ctx.fill(); }
    // the crack net: polygonal plates
    ctx.strokeStyle = 'rgba(70,62,56,0.55)'; ctx.lineWidth = 2.2; ctx.lineCap = 'round';
    var pts = [];
    for (var p = 0; p < 160; p++) pts.push([Math.random() * w, Math.random() * h]);
    for (var a = 0; a < pts.length; a++) {
      var near = pts.map(function(q, j) { return [Math.hypot(q[0] - pts[a][0], q[1] - pts[a][1]), j]; }).sort(function(u, v) { return u[0] - v[0]; }).slice(1, 4);
      near.forEach(function(nb) { if (nb[1] > a) { ctx.beginPath(); ctx.moveTo(pts[a][0], pts[a][1]); var mx = (pts[a][0] + pts[nb[1]][0]) / 2 + (Math.random() - 0.5) * 16, my = (pts[a][1] + pts[nb[1]][1]) / 2 + (Math.random() - 0.5) * 16; ctx.quadraticCurveTo(mx, my, pts[nb[1]][0], pts[nb[1]][1]); ctx.stroke(); } });
    }
    // salt crust, brighter, in patches and along the cracks
    for (var s = 0; s < 220; s++) { ctx.fillStyle = 'rgba(240,238,232,' + (0.15 + Math.random() * 0.3) + ')'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 3 + Math.random() * 14, 2 + Math.random() * 8, Math.random() * 3, 0, 6.3); ctx.fill(); }
    for (var d = 0; d < 6000; d++) { ctx.fillStyle = 'rgba(80,70,60,' + Math.random() * 0.25 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 1.5, 1.5); }
    // curled plate edges: a dark crescent on one side of some plates
    for (var c = 0; c < 80; c++) { ctx.strokeStyle = 'rgba(60,52,46,0.35)'; ctx.lineWidth = 4; ctx.beginPath(); var cx0 = Math.random() * w, cy0 = Math.random() * h; ctx.arc(cx0, cy0, 12 + Math.random() * 20, Math.random() * 3, Math.random() * 3 + 3.5); ctx.stroke(); }
  }, [340, 340]);
  var plainMat = new THREE.MeshStandardMaterial({ map: plainTex, bumpMap: plainTex, bumpScale: 0.018, roughness: 0.95, color: 0xbcb6ac });

  // The river: slow, grey-brown, a skin of light on it
  var riverTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#6a6862'; ctx.fillRect(0, 0, w, h);
    for (var y = 0; y < h; y += 2) { ctx.fillStyle = 'rgba(120,118,110,' + (0.04 + Math.sin(y * 0.12) * 0.03) + ')'; ctx.fillRect(0, y, w, 2); }
    for (var k = 0; k < 300; k++) { ctx.fillStyle = 'rgba(200,196,190,' + Math.random() * 0.08 + ')'; ctx.fillRect(Math.random() * w, Math.random() * h, 6 + Math.random() * 40, 1); }
    for (var m = 0; m < 30; m++) { ctx.fillStyle = 'rgba(80,72,60,' + Math.random() * 0.2 + ')'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 20 + Math.random() * 60, 4 + Math.random() * 10, 0, 0, 6.3); ctx.fill(); }
  }, [3, 30]);
  var riverMat = new THREE.MeshStandardMaterial({ map: riverTex, color: 0xc8c6c2, bumpMap: riverTex, bumpScale: 0.035, roughness: 0.34, metalness: 0.18, emissive: 0x8d8c89, emissiveIntensity: 0.24 });

  var mudTex = canvasTex(256, 256, function(ctx, w, h) {
    ctx.fillStyle = '#7a7268'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 600; i++) { var v = 90 + Math.random() * 50; ctx.fillStyle = 'rgba(' + v + ',' + Math.floor(v * 0.94) + ',' + Math.floor(v * 0.86) + ',0.5)'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 3 + Math.random() * 12, 2 + Math.random() * 6, Math.random() * 3, 0, 6.3); ctx.fill(); }
    ctx.strokeStyle = 'rgba(40,34,30,0.4)'; ctx.lineWidth = 1.5;
    for (var c = 0; c < 40; c++) { ctx.beginPath(); var x0 = Math.random() * w, y0 = Math.random() * h; ctx.moveTo(x0, y0); ctx.lineTo(x0 + (Math.random() - 0.5) * 40, y0 + (Math.random() - 0.5) * 40); ctx.stroke(); }
  }, [4, 40]);
  var mudMat = new THREE.MeshStandardMaterial({ map: mudTex, roughness: 0.7, metalness: 0.1, color: 0x9a9088 });

  var stoneTex = canvasTex(512, 512, function(ctx, w, h) {
    ctx.fillStyle = '#4a4442'; ctx.fillRect(0, 0, w, h);
    for (var i = 0; i < 2500; i++) { var v = 40 + Math.random() * 60; ctx.fillStyle = 'rgba(' + v + ',' + Math.floor(v * 0.95) + ',' + Math.floor(v * 0.92) + ',0.5)'; ctx.beginPath(); ctx.arc(Math.random() * w, Math.random() * h, 1 + Math.random() * 5, 0, 6.3); ctx.fill(); }
    for (var l = 0; l < 30; l++) { ctx.fillStyle = 'rgba(200,196,180,' + (0.1 + Math.random() * 0.2) + ')'; ctx.beginPath(); ctx.ellipse(Math.random() * w, Math.random() * h, 6 + Math.random() * 20, 4 + Math.random() * 12, Math.random() * 3, 0, 6.3); ctx.fill(); }
    ctx.strokeStyle = 'rgba(20,16,14,0.5)'; ctx.lineWidth = 2;
    for (var c = 0; c < 10; c++) { ctx.beginPath(); var x0 = Math.random() * w, y0 = Math.random() * h; ctx.moveTo(x0, y0); for (var k = 0; k < 5; k++) { x0 += (Math.random() - 0.5) * 40; y0 += Math.random() * 40; ctx.lineTo(x0, y0); } ctx.stroke(); }
  });
  var stoneMat = new THREE.MeshStandardMaterial({ map: stoneTex, bumpMap: stoneTex, bumpScale: 0.09, roughness: 0.85, color: 0x8a8480 });

  // ============================================================
  // THE PLAIN, with the river's trough dug into it
  // ============================================================
  var RIVER_ANGLE = 0.32; // radians off north, toward the west
  function riverX(x, z) { return (x + 22) * Math.cos(RIVER_ANGLE) - z * Math.sin(RIVER_ANGLE); }
  function plainY(x, z) {
    var d = Math.hypot(x, z);
    var y = Math.sin(x * 0.07) * Math.cos(z * 0.05) * 0.35 + Math.sin(x * 0.31 + z * 0.17) * 0.08 + (d > 60 ? Math.sin(x * 0.02) * Math.sin(z * 0.03) * 1.6 : 0);
    var rx = Math.abs(riverX(x, z));
    if (rx < 19) { var u = Math.min(1, (19 - rx) / 7); y -= 1.9 * u * u * (3 - 2 * u); }
    return y;
  }
  var plainGeo = new THREE.PlaneGeometry(1400, 1400, 140, 140);
  (function() {
    var p = plainGeo.attributes.position;
    for (var i = 0; i < p.count; i++) {
      var x = p.getX(i), z = -p.getY(i);
      p.setZ(i, plainY(x, z));
    }
    plainGeo.computeVertexNormals();
  })();
  var plain = new THREE.Mesh(plainGeo, plainMat);
  plain.rotation.x = -Math.PI / 2; plain.position.set(0, 0, 0); plain.receiveShadow = true; scene.add(plain);


  // ============================================================
  // THE RIVER: cut into the plain, running from the left foreground to the north-west
  // ============================================================
  var reeds = [];
  var riverGroup = new THREE.Group();
  riverGroup.rotation.y = -RIVER_ANGLE; riverGroup.position.set(-22, 0, 0);
  (function() {
    // the channel: a shallow trough with banks, water at the bottom
    var bankMat = mudMat;
    // the water, vertex-rippled
    var wg = new THREE.PlaneGeometry(22, 1400, 22, 220); window.__wg = wg; window.__wbase = [];
    var wp = wg.attributes.position; for (var i = 0; i < wp.count; i++) window.__wbase.push({ x: wp.getX(i), y: wp.getY(i) });
    var water = new THREE.Mesh(wg, riverMat); water.rotation.x = -Math.PI / 2; water.position.set(0, -1.25, -300); riverGroup.add(water);
    // the far bank drops a little lower than the near, so the water shows its skin against it
    // Sparse, scalloped silt margins: wet grey at the water, salt at the lip.
    var bankTex = canvasTex(128, 512, function(ctx,w,h) {
      var g=ctx.createLinearGradient(0,0,w,0);
      g.addColorStop(0,'#706e64');g.addColorStop(0.25,'#858276');g.addColorStop(0.7,'#a69f8e');g.addColorStop(1,'#beb6a4');
      ctx.fillStyle=g;ctx.fillRect(0,0,w,h);
      for(var i=0;i<260;i++) {
        var x=(i*47)%w,y=(i*83)%h;
        ctx.strokeStyle=i%4?'rgba(67,65,56,0.14)':'rgba(231,223,201,0.26)';ctx.lineWidth=0.7;
