var tsReflTex=makeCanvasTexture(64,96,function(cx,w,h){
var g=cx.createRadialGradient(w/2,h*0.38,0,w/2,h*0.38,w*0.5);
g.addColorStop(0,'rgba(255,190,110,0.8)'); g.addColorStop(0.4,'rgba(230,150,60,0.3)'); g.addColorStop(1,'rgba(200,120,30,0)');
cx.fillStyle=g; cx.fillRect(0,0,w,h);
var tl=cx.createLinearGradient(0,h*0.38,0,h);
tl.addColorStop(0,'rgba(230,150,60,0.25)'); tl.addColorStop(1,'rgba(200,120,30,0)');
cx.fillStyle=tl; cx.fillRect(w*0.38,h*0.38,w*0.24,h*0.62);
});
var tsRefl=new THREE.Mesh(new THREE.PlaneGeometry(0.42,0.66), new THREE.MeshBasicMaterial({map:tsReflTex,transparent:true,opacity:0.2,blending:THREE.AdditiveBlending,depthWrite:false,fog:false}));
tsRefl.rotation.x=-Math.PI/2; tsRefl.position.set(-1.0,0.362,1.8); scene.add(tsRefl);

// ── The Trisha's cat ──
// A Soho black cat sitting on the lower step under the lantern. Kept as a
// near-black silhouette against the lit stone doorcase — sold by motion
// (tail, ears, head turns, breathing, blink), never by anatomy. It never walks.
var catMat = new THREE.MeshStandardMaterial({ color: 0x0b0b0d, roughness: 0.85 });
var tsCat = new THREE.Group();
tsCat.position.set(-0.94, 0.35, 0.55); // 2026-09-16: was -0.66, which put the cat under the centred TRISHA'S button; nearer the lantern now
tsCat.rotation.y = -0.2;
tsCat.scale.set(1.3, 1.3, 1.3); // a big Soho tom — true scale vanished at this camera distance
scene.add(tsCat);
function catPart(geo, x, y, z, sx, sy, sz) {
var m = new THREE.Mesh(geo, catMat);
m.position.set(x, y, z); m.scale.set(sx||1, sy||1, sz||1);
tsCat.add(m); return m;
}
catPart(new THREE.SphereGeometry(0.15, 14, 12), 0, 0.13, -0.03, 0.82, 0.92, 1.05);
var catChest = catPart(new THREE.SphereGeometry(0.105, 12, 10), 0, 0.215, 0.07, 0.78, 1, 0.9);
catPart(new THREE.CylinderGeometry(0.017, 0.02, 0.17, 8), -0.045, 0.085, 0.115);
catPart(new THREE.CylinderGeometry(0.017, 0.02, 0.17, 8), 0.045, 0.085, 0.115);
catPart(new THREE.SphereGeometry(0.026, 8, 6), -0.047, 0.014, 0.135, 1, 0.55, 1.3);
catPart(new THREE.SphereGeometry(0.026, 8, 6), 0.047, 0.014, 0.135, 1, 0.55, 1.3);
var catHead = new THREE.Group();
catHead.position.set(0, 0.35, 0.075);
tsCat.add(catHead);
var catSkull = new THREE.Mesh(new THREE.SphereGeometry(0.082, 14, 12), catMat);
catSkull.scale.set(0.92, 0.85, 0.88); catHead.add(catSkull);
var catMuzzle = new THREE.Mesh(new THREE.SphereGeometry(0.045, 10, 8), catMat);
catMuzzle.position.set(0, -0.025, 0.055); catMuzzle.scale.set(1, 0.75, 0.9); catHead.add(catMuzzle);
// Ears: 4-sided pyramids, flat face forward — the outline's signature
var catEarL = new THREE.Mesh(new THREE.ConeGeometry(0.034, 0.085, 4), catMat);
catEarL.position.set(-0.052, 0.07, -0.002); catEarL.rotation.y = Math.PI/4; catEarL.rotation.z = 0.22; catHead.add(catEarL);
var catEarR = new THREE.Mesh(new THREE.ConeGeometry(0.034, 0.085, 4), catMat);
catEarR.position.set(0.052, 0.07, -0.002); catEarR.rotation.y = Math.PI/4; catEarR.rotation.z = -0.22; catHead.add(catEarR);
// Eyes: amber, lit only while the head faces the street — lamplight caught, not headlamps
var catEyeMat = new THREE.MeshStandardMaterial({ color: 0x0d0a04, emissive: 0xe8b040, emissiveIntensity: 0 });
var catEyeL = new THREE.Mesh(new THREE.SphereGeometry(0.013, 8, 6), catEyeMat);
catEyeL.position.set(-0.031, 0.008, 0.068); catEyeL.scale.set(1, 0.85, 0.5); catHead.add(catEyeL);
var catEyeR = new THREE.Mesh(new THREE.SphereGeometry(0.013, 8, 6), catEyeMat);
catEyeR.position.set(0.031, 0.008, 0.068); catEyeR.scale.set(1, 0.85, 0.5); catHead.add(catEyeR);
// Tiny additive halos on the eyes — at street distance the emissive spheres
// alone are a pixel; the sprites give the lamplight-caught bloom
var catEyeGlowTex = makeCanvasTexture(32, 32, function(cx, w, h) {
var g = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
g.addColorStop(0, 'rgba(255,205,90,0.95)'); g.addColorStop(0.4, 'rgba(230,160,50,0.35)'); g.addColorStop(1, 'rgba(210,140,40,0)');
cx.fillStyle = g; cx.fillRect(0, 0, w, h);
});
var catEyeGlowL = new THREE.Sprite(new THREE.SpriteMaterial({ map: catEyeGlowTex, transparent: true, opacity: 0, depthWrite: false }));
catEyeGlowL.position.set(-0.031, 0.008, 0.075); catEyeGlowL.scale.set(0.085, 0.085, 1); catHead.add(catEyeGlowL);
var catEyeGlowR = new THREE.Sprite(new THREE.SpriteMaterial({ map: catEyeGlowTex, transparent: true, opacity: 0, depthWrite: false }));
catEyeGlowR.position.set(0.031, 0.008, 0.075); catEyeGlowR.scale.set(0.085, 0.085, 1); catHead.add(catEyeGlowR);
// Tail: a chain of shrinking spheres laid along a curve computed per frame,
// curled round the right flank on the step, tip idling and flicking
var catTail = [];
for (var cti = 0; cti < 9; cti++) {
var ctSeg = new THREE.Mesh(new THREE.SphereGeometry(0.031 - cti*0.0016, 8, 6), catMat);
tsCat.add(ctSeg); catTail.push(ctSeg);
}
var catState = { yaw: 0, yawTarget: -0.15, nextTurn: 0, blinkUntil: 0, nextBlink: 0, flickStart: -1, nextFlick: 0, earUntil: 0, earSide: 1, nextEar: 0 };
// Lantern bounce off the wet slabs — lifts the cat's brow and chest a whisper
var catFill = new THREE.PointLight(0xc98a30, 0.4, 2.2, 2.0);
catFill.position.set(-1.0, 1.05, 1.35); scene.add(catFill);

// Restrained fittings and worn edges: exterior detail pass.
(function(){var f=window.dssDreamDetail(scene);var ex=window.dssExteriorDetail(scene);
// Knob backplate tiny fixings
f.pin(0.36,1.958,0.234);f.pin(0.36,1.842,0.234);
// Letterbox corner screws
[-0.177,0.177].forEach(function(x){f.pin(x,1.62,0.244);});
// Black door hinge knuckles
[0.9,2.8].forEach(function(y){f.box(0.055,0.095,0.025,0x30312b,-0.515,y,0.232);});
// Lower door rubbed paint
for(var k=0;k<6;k++)f.box(0.03+k*0.008,0.004,0.002,0x37342a,-0.3+k*0.11,0.69+(k%3)*0.02,0.227);
// Number slate recessed fixings
[[-1.68,2.94],[-1.42,2.94],[-1.68,3.26],[-1.42,3.26]].forEach(function(p){f.pin(p[0],p[1],0.169);});
// Lantern bracket wall plate
f.box(0.11,0.2,0.018,0x35342b,-1.08,3.55,0.155,null,true);f.pin(-1.08,3.62,0.173);f.pin(-1.08,3.48,0.173);
// Lantern top ventilation slots
for(var v=0;v<4;v++)f.box(0.025,0.012,0.003,0x090b0b,-1.17+v*0.05,3.37,0.522);
// Awning underside support ribs
[-0.7,0,0.7].forEach(function(x){f.wire([[x,4.43,0.58],[x,4.42,0.86],[x,4.41,1.12]],0.008,0x38362d);});
// Stone steps gently worn noses
ex.step(null,0,0.462,0.38,1.26,0.35);ex.step(null,0,0.352,0.62,1.41,0.39);
// Kerb block joints
for(var j=-3.5;j<4;j+=1)f.box(0.009,0.12,0.008,0x22221f,j,0.35,5.075);
})();

// Lighting
scene.add(new THREE.AmbientLight(0x171530, 0.68));
var moon=new THREE.DirectionalLight(0x2b2850, 0.24); moon.position.set(3,10,6); scene.add(moon);
var tsLanternLight=new THREE.PointLight(0xd4780e,2.2,7.5,1.8); tsLanternLight.position.set(-1.09,3.18,0.88); tsLanternLight.castShadow=true; scene.add(tsLanternLight);
// Halo at the lantern so the light SOURCE blooms (the Ginger Light treatment).
var tsHaloTex=makeCanvasTexture(128,128,function(cx,w,h){var g=cx.createRadialGradient(w/2,h/2,0,w/2,h/2,w/2);g.addColorStop(0,'rgba(255,190,110,0.85)');g.addColorStop(0.35,'rgba(240,150,60,0.30)');g.addColorStop(1,'rgba(220,120,30,0)');cx.fillStyle=g;cx.fillRect(0,0,w,h);});
var tsHalo=new THREE.Sprite(new THREE.SpriteMaterial({map:tsHaloTex,transparent:true,opacity:0.75,depthWrite:false}));
tsHalo.position.set(-1.09,3.22,0.62); tsHalo.scale.set(2.3,2.3,1); tsHalo.material.opacity=0.95; scene.add(tsHalo);
var awningGlow=new THREE.PointLight(0xd49018,0.80,4.0,2.0); awningGlow.position.set(0,4.20,0.90); scene.add(awningGlow);
var doorGlow=new THREE.PointLight(0xc07010,0.4,3.2,2.0); doorGlow.position.set(0,1.8,0.85); scene.add(doorGlow); // was buried at z=0 INSIDE the wall, lighting nothing — now grazes the door furniture

// AFTER the rain — the intro says the sky has cleared, so no live drizzle:
// instead the awning sheds occasional drips, each hanging a moment before
// it lets go and falls under gravity.
var dripCount=9;
var dripPositions=new Float32Array(dripCount*6);
var dripVel=new Float32Array(dripCount);
var dripWait=new Float32Array(dripCount);
function resetDrip(i, first){
var dx=(Math.random()-0.5)*2.0, dy=4.30, dz=1.06+Math.random()*0.06;
dripPositions[i*6]=dx; dripPositions[i*6+1]=dy; dripPositions[i*6+2]=dz;
dripPositions[i*6+3]=dx; dripPositions[i*6+4]=dy-0.05; dripPositions[i*6+5]=dz;
dripVel[i]=0;
dripWait[i]=(first?Math.random()*160:40+Math.random()*220);
}
for (var di0=0;di0<dripCount;di0++) resetDrip(di0,true);
var rainGeo=new THREE.BufferGeometry();
rainGeo.setAttribute('position',new THREE.BufferAttribute(dripPositions,3));
var rain=new THREE.LineSegments(rainGeo,new THREE.LineBasicMaterial({color:0xaabbcc,transparent:true,opacity:0.35})); scene.add(rain);

// Animation
function tsAnimate() {
tsAnimId=requestAnimationFrame(tsAnimate);
var rp=rainGeo.attributes.position.array;
for (var ri=0;ri<(tsStill?0:dripCount);ri++){
if (dripWait[ri]>0){ dripWait[ri]--; continue; }
dripVel[ri]+=0.010;
rp[ri*6+1]-=dripVel[ri]; rp[ri*6+4]-=dripVel[ri];
if (rp[ri*6+4]<0.36){ resetDrip(ri,false); }
}
rainGeo.attributes.position.needsUpdate=true;
var flicker=tsStill?1.0:(1.0+Math.sin(Date.now()*0.0031)*0.04+Math.sin(Date.now()*0.0077)*0.02);
tsLanternLight.intensity=2.2*flicker;
tsRefl.material.opacity=0.2*flicker*flicker;
// The cat: head turns between street, lantern and door; eyes catch the
// light only when facing out; tail curls and flicks; ears twitch.
var catNow = tsStill ? tsStillNow : Date.now();
if (catNow > catState.nextTurn) {
catState.yawTarget = [-0.55, -0.15, 0.3, 0.62][Math.floor(Math.random()*4)];
catState.nextTurn = catNow + 2600 + Math.random()*5200;
}
catState.yaw += (catState.yawTarget - catState.yaw) * 0.035;
catHead.rotation.y = catState.yaw;
catHead.rotation.x = 0.06 + Math.sin(catNow*0.0009)*0.03;
// Only blink if we're near the scheduled moment — after a throttled-tab gap
// (rAF frozen while hidden) just reschedule, so the eyes aren't caught shut
// on the first frame back.
if (catNow > catState.nextBlink) {
if (catState.nextBlink > 0 && catNow - catState.nextBlink < 400) { catState.blinkUntil = catNow + 140; }
catState.nextBlink = catNow + 2200 + Math.random()*4800;
}
var catBlinking = catNow < catState.blinkUntil;
catEyeL.scale.y = catBlinking ? 0.12 : 0.85; catEyeR.scale.y = catBlinking ? 0.12 : 0.85;
var catEyeOn = catBlinking ? 0 : Math.max(0, Math.cos((catState.yaw + 0.1) * 1.5));
catEyeMat.emissiveIntensity = catEyeOn * 1.1;
catEyeGlowL.material.opacity = catEyeOn * 0.9;
catEyeGlowR.material.opacity = catEyeOn * 0.9;
catChest.scale.y = 1 + Math.sin(catNow*0.0016)*0.018;
if (catNow > catState.nextEar) { catState.earUntil = catNow + 260; catState.earSide = Math.random() < 0.5 ? -1 : 1; catState.nextEar = catNow + 3800 + Math.random()*6000; }
var earKick = (catNow < catState.earUntil) ? Math.sin((catState.earUntil - catNow)/260*Math.PI)*0.45 : 0;
catEarL.rotation.y = Math.PI/4 + (catState.earSide < 0 ? earKick : 0);
catEarR.rotation.y = Math.PI/4 + (catState.earSide > 0 ? earKick : 0);
if (catNow > catState.nextFlick && catState.flickStart < 0) { catState.flickStart = catNow; catState.nextFlick = catNow + 2800 + Math.random()*4600; }
var catFlick = 0;
if (catState.flickStart >= 0) {
var cfp = (catNow - catState.flickStart)/850;
if (cfp >= 1) { catState.flickStart = -1; } else { catFlick = Math.sin(cfp*Math.PI); }
}
for (var cts = 0; cts < 9; cts++) {
var ctt = cts/8;
var cta = 4.35 - ctt*(1.95 + Math.sin(catNow*0.0006)*0.06 + catFlick*0.45*ctt);
var ctr = 0.135 + ctt*0.045;
catTail[cts].position.set(-Math.cos(cta)*ctr, 0.025 + Math.max(0, 0.3 - ctt)*0.15 + catFlick*ctt*ctt*0.09, Math.sin(cta)*ctr);
}
if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
}
tsAnimate();

// Overlays
var tsVig=document.createElement('div');
tsVig.style.cssText='position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9001;background:radial-gradient(ellipse at 45% 45%, transparent 25%, rgba(0,0,0,0.65) 100%);';
tsWrap.appendChild(tsVig);
var tsWash=document.createElement('div');
tsWash.style.cssText='position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9002;background:linear-gradient(180deg, rgba(8,8,20,0.35) 0%, rgba(5,5,12,0.1) 30%, rgba(5,5,12,0.1) 60%, rgba(8,5,3,0.35) 100%);';
tsWrap.appendChild(tsWash);
var tsLoc=document.createElement('div');
tsLoc.textContent='GREEK STREET, SOHO';
tsLoc.style.cssText='position:absolute;bottom:18px;left:50%;transform:translateX(-50%);font:12px "Courier New",monospace;color:rgba(200,180,140,0.25);letter-spacing:2px;pointer-events:none;z-index:9003;white-space:nowrap;';
tsWrap.appendChild(tsLoc);
var tsBtn=document.createElement('div');
tsBtn.textContent="TRISHA'S";
tsBtn.style.cssText='position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px 36px;font:16px "Courier New",monospace;color:rgba(212,165,116,0.85);border:1px solid rgba(212,165,116,0.3);letter-spacing:4px;cursor:pointer;z-index:9004;background:transparent;opacity:0;transition:opacity 2s ease;';
setTimeout(function(){tsBtn.style.opacity='1';},2500);
tsBtn.addEventListener('mouseenter',function(){tsBtn.style.color='rgba(230,195,150,0.95)';tsBtn.style.borderColor='rgba(212,165,116,0.6)';});
tsBtn.addEventListener('mouseleave',function(){tsBtn.style.color='rgba(212,165,116,0.85)';tsBtn.style.borderColor='rgba(212,165,116,0.3)';});
tsBtn.addEventListener('click',function(){
tsWrap.style.transition='opacity 1.5s ease'; tsWrap.style.opacity='0';
setTimeout(function(){
if (tsAnimId) cancelAnimationFrame(tsAnimId); tsAnimId=null;
if (tsWrap.parentNode) tsWrap.parentNode.removeChild(tsWrap);
var TARGET="Failure: Trisha's";
if (window.Engine && Engine.go) { Engine.go(TARGET); }
else { var links=document.querySelectorAll('tw-link, .enchantment-link'); for (var i=0;i<links.length;i++){if (links[i].textContent.trim()==='·'){links[i].click();break;}} }
},1500);
});
tsWrap.appendChild(tsBtn);
document.body.appendChild(tsWrap);
}

setInterval(function(){
var container=document.getElementById('ts-container');
if (container && !tsActive) {
initTrishas();
} else if (!container) {
tsActive=false;
if (tsAnimId) { cancelAnimationFrame(tsAnimId); tsAnimId=null; }
window._dssDisposeWrap('ts-wrap');
}
},300);
})();
// ====== O'FLATTERLY'S BOOKSHOP SCENE — INLINE ======
// Marchpane (16 Cecil Court) is the reference: racing-green front on pale
// stucco, gold letterspaced fascia, scalloped awning over the window only,
// glazed door LEFT blazing amber, packed book window, bench of stock, the
// studded coal plates in the pavement. Night; the shop is the court's light.
// Living element: the dealer behind the door glass, turning a page.
(function() {
var ofActive = false;
var ofAnimId = null;

function initOflatterly() {
if (ofActive) return;
ofActive = true;
if (typeof THREE === 'undefined') {
var sc = document.createElement('script');
sc.src = 'vendor/three/three.min.js';
sc.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildOFScene) : buildOFScene()); };
document.head.appendChild(sc);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildOFScene) : buildOFScene());
}
}

function buildOFScene() {
// Reduced-motion: hold one settled frame (lamps steady, sign still, haze and motes parked).
var ofStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var ofWrap = document.createElement('div');
ofWrap.id = 'of-wrap';
ofWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#06070b;';

var scene = new THREE.Scene();
scene.background = new THREE.Color(0x06070b);
scene.fog = new THREE.FogExp2(0x07080c, 0.05);

var camera = new THREE.PerspectiveCamera(50, window.innerWidth / window.innerHeight, 0.1, 100);
camera.position.set(0.1, 1.7, 5.6);
camera.lookAt(0, 1.9, 0);

var renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
renderer.toneMappingExposure = 0.88;
ofWrap.appendChild(renderer.domElement);
window._dssBindScene('of-wrap', scene, renderer, camera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(scene, camera, renderer, { bokeh: true, focus: 5, aperture: 0.0005, maxblur: 0.005, bloomStrength: 0.5, bloomThreshold: 0.35 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(document.getElementById('of-wrap'));

function placeMesh(geo, mat, x, y, z) {
var m = new THREE.Mesh(geo, mat); m.position.set(x, y, z); scene.add(m); return m;
}
function makeCanvasTexture(w, h, drawFunc) {
var c = document.createElement('canvas');
c.width = w; c.height = h;
var cx = c.getContext('2d');
drawFunc(cx, w, h);
var tex = new THREE.CanvasTexture(c);
tex.minFilter = THREE.LinearFilter;
return tex;
}

// Court cobbles — worn setts, dark joints, a century of grot
var flagTex = makeCanvasTexture(512, 512, function(cx, w, h) {
cx.fillStyle = '#3d3831'; cx.fillRect(0, 0, w, h);
var cw = 46, chh = 34;
for (var row = 0; row < h / chh + 1; row++) {
var off = (row % 2) * (cw / 2);
for (var col = -1; col < w / cw + 1; col++) {
var cxp = col * cw + off, cyp = row * chh;
var tone = 58 + Math.floor(Math.random() * 26);
var g = cx.createRadialGradient(cxp + cw/2 - 4, cyp + chh/2 - 4, 2, cxp + cw/2, cyp + chh/2, cw * 0.62);
g.addColorStop(0, 'rgb(' + (tone + 18) + ',' + (tone + 12) + ',' + (tone + 2) + ')');
g.addColorStop(0.75, 'rgb(' + tone + ',' + (tone - 6) + ',' + (tone - 14) + ')');
g.addColorStop(1, 'rgb(' + (tone - 34) + ',' + (tone - 38) + ',' + (tone - 44) + ')');
cx.fillStyle = g;
cx.beginPath();
cx.rect(cxp + 2, cyp + 2, cw - 4, chh - 4);
cx.fill();
cx.strokeStyle = 'rgba(20,18,14,0.6)'; cx.lineWidth = 2; cx.strokeRect(cxp + 2, cyp + 2, cw - 4, chh - 4);
}
}
for (var st = 0; st < 40; st++) {
cx.fillStyle = 'rgba(24,22,18,' + (0.12 + Math.random() * 0.24).toFixed(2) + ')';
cx.beginPath(); cx.ellipse(Math.random() * w, Math.random() * h, 16 + Math.random() * 50, 10 + Math.random() * 30, Math.random() * 3, 0, Math.PI * 2); cx.fill();
}
for (var gm = 0; gm < 120; gm++) {
cx.fillStyle = 'rgba(18,16,12,' + (0.2 + Math.random() * 0.3).toFixed(2) + ')';
cx.fillRect(Math.random() * w, Math.random() * h, 2 + Math.random() * 4, 1 + Math.random() * 3);
}
});
flagTex.wrapS = flagTex.wrapT = THREE.RepeatWrapping; flagTex.repeat.set(10, 6.5);
var ground = new THREE.Mesh(new THREE.PlaneGeometry(30, 18), new THREE.MeshStandardMaterial({ map: flagTex, roughness: 0.85 }));
ground.rotation.x = -Math.PI / 2; ground.position.set(0, 0, 3); scene.add(ground);
// The studded coal plates
var coalTex = makeCanvasTexture(512, 96, function(cx, w, h) {
cx.fillStyle = '#3a3834'; cx.fillRect(0, 0, w, h);
for (var px = 14; px < w; px += 26) { for (var py = 14; py < h; py += 26) {
cx.fillStyle = 'rgba(90,86,78,0.9)'; cx.beginPath(); cx.arc(px, py, 5, 0, Math.PI * 2); cx.fill();
cx.fillStyle = 'rgba(20,18,16,0.8)'; cx.beginPath(); cx.arc(px + 1.5, py + 1.5, 2.4, 0, Math.PI * 2); cx.fill();
} }
});
placeMesh(new THREE.BoxGeometry(4.9, 0.015, 0.55), new THREE.MeshStandardMaterial({ map: coalTex, roughness: 0.6, metalness: 0.4 }), 0, 0.01, 3.6);

// Materials
var hasKit = !!(window.dssScene && window.dssScene.makeWeatheredStucco);
var stuccoMat = hasKit ? new THREE.MeshStandardMaterial({ map: null, roughness: 0.9 }) : new THREE.MeshStandardMaterial({ color: 0xbfb6a4, roughness: 0.9 });
if (hasKit) { stuccoMat = window.dssScene.makeWeatheredStucco({ baseColor: 0xc4bba8, repeat: [1.6, 2.2] }); }
var greenMat = new THREE.MeshStandardMaterial({ color: 0x18291f, roughness: 0.72 });
var greenDark = new THREE.MeshStandardMaterial({ color: 0x122419, roughness: 0.6 });
var brassMat = new THREE.MeshStandardMaterial({ color: 0x8a6c22, roughness: 0.48, metalness: 0.75 });
var woodDark = new THREE.MeshStandardMaterial({ color: 0x2c1d10, roughness: 0.8 });

// Upper facade — pale stucco with two dark sashes
var brickUp = (window.dssScene && window.dssScene.makeGrimyBrick) ? window.dssScene.makeGrimyBrick({ baseColor: 0x6b4a38, repeat: [2.6, 1.7], sootStreaks: 9, dampPatches: 6 }) : new THREE.MeshStandardMaterial({ color: 0x5c4034, roughness: 0.92 });
placeMesh(new THREE.BoxGeometry(5.6, 3.7, 0.3), brickUp, 0, 5.35, -0.06);
for (var uw = 0; uw < 2; uw++) {
var ux = uw === 0 ? -1.15 : 1.25;
placeMesh(new THREE.BoxGeometry(0.8, 1.25, 0.06), greenDark, ux, 5.15, 0.1);
var uwGlass = (window.dssScene && window.dssScene.makeDressedWindow) ? window.dssScene.makeDressedWindow(false, uw, uw + 1) : new THREE.MeshStandardMaterial({ color: 0x141a22, roughness: 0.3 });
placeMesh(new THREE.PlaneGeometry(0.66, 1.1), uwGlass, ux, 5.15, 0.14);
placeMesh(new THREE.BoxGeometry(0.03, 1.1, 0.02), greenDark, ux, 5.15, 0.15);
placeMesh(new THREE.BoxGeometry(0.66, 0.03, 0.02), greenDark, ux, 5.15, 0.15);
placeMesh(new THREE.BoxGeometry(0.9, 0.06, 0.12), stuccoMat, ux, 4.5, 0.12);
}
var stuccoGrimeTex = makeCanvasTexture(512, 256, function(cx, w, h) {
cx.clearRect(0, 0, w, h);
for (var sg = 0; sg < 26; sg++) {
cx.fillStyle = 'rgba(40,36,28,' + (0.06 + Math.random() * 0.14).toFixed(2) + ')';
var sgx = Math.random() * w;
cx.fillRect(sgx, Math.random() * h * 0.4, 3 + Math.random() * 9, 40 + Math.random() * 140);
}
for (var dp = 0; dp < 8; dp++) {
var dg = cx.createRadialGradient(Math.random() * w, h * 0.5 + Math.random() * h * 0.5, 0, Math.random() * w, h * 0.6, 40 + Math.random() * 60);
dg.addColorStop(0, 'rgba(46,42,30,0.28)'); dg.addColorStop(1, 'rgba(46,42,30,0)');
cx.fillStyle = dg; cx.fillRect(0, 0, w, h);
}
var tg = cx.createLinearGradient(0, 0, 0, 60);
tg.addColorStop(0, 'rgba(20,18,12,0.5)'); tg.addColorStop(1, 'rgba(20,18,12,0)');
cx.fillStyle = tg; cx.fillRect(0, 0, w, 60);
});
placeMesh(new THREE.PlaneGeometry(5.5, 3.6), new THREE.MeshBasicMaterial({ map: stuccoGrimeTex, transparent: true, opacity: 0.75, depthWrite: false }), 0, 5.35, 0.1);
placeMesh(new THREE.PlaneGeometry(4.7, 0.4), new THREE.MeshBasicMaterial({ map: stuccoGrimeTex, transparent: true, opacity: 0.5, depthWrite: false }), 0, 0.2, 0.19);
// Side masses closing the court at frame edges
var sideMat = new THREE.MeshStandardMaterial({ color: 0x6e675c, roughness: 0.92 });
placeMesh(new THREE.BoxGeometry(2.4, 8, 7), sideMat, -4.9, 4, 1.2);
placeMesh(new THREE.BoxGeometry(2.4, 8, 7), sideMat, 4.9, 4, 1.2);
placeMesh(new THREE.PlaneGeometry(0.7, 1.0), new THREE.MeshBasicMaterial({ color: 0x2a3444, transparent: true, opacity: 0.5 }), -3.66, 4.6, 2.2).rotation.y = Math.PI / 2;
placeMesh(new THREE.PlaneGeometry(0.7, 1.0), new THREE.MeshBasicMaterial({ color: 0x40342a, transparent: true, opacity: 0.4 }), 3.66, 3.8, 1.6).rotation.y = -Math.PI / 2;

// Fascia — I. O'FLATTERLY, dealer in books; No 23 both ends
var fasciaTex = makeCanvasTexture(1024, 200, function(cx, w, h) {
cx.fillStyle = '#152a1e'; cx.fillRect(0, 0, w, h);
var grad = cx.createLinearGradient(0, 0, 0, h);
grad.addColorStop(0, 'rgba(0,0,0,0.25)'); grad.addColorStop(0.5, 'rgba(255,255,255,0.04)'); grad.addColorStop(1, 'rgba(0,0,0,0.3)');
cx.fillStyle = grad; cx.fillRect(0, 0, w, h);
cx.strokeStyle = 'rgba(196,164,72,0.5)'; cx.lineWidth = 2;
cx.beginPath(); cx.moveTo(18, 14); cx.lineTo(w - 18, 14); cx.stroke();
cx.beginPath(); cx.moveTo(18, h - 14); cx.lineTo(w - 18, h - 14); cx.stroke();
cx.fillStyle = '#d2b258';
cx.font = '600 64px Georgia, serif'; cx.textAlign = 'center'; cx.textBaseline = 'middle';
var name = "I. O'FLATTERLY";
var spread = 44, startX = w / 2 - (name.length - 1) * spread / 2;
for (var ch = 0; ch < name.length; ch++) {
if (name[ch] === "'") {
cx.save();
cx.translate(startX + ch * spread, 30);
cx.rotate(Math.PI);
cx.fillText("'", 0, 0);
cx.restore();
} else { cx.fillText(name[ch], startX + ch * spread, 70); }
}
cx.font = 'small-caps 500 26px Georgia, serif';
cx.fillStyle = 'rgba(210,178,88,0.85)';
var sub = 'DEALER IN BOOKS', sSpread = 17, sStart = w / 2 - (sub.length - 1) * sSpread / 2;
for (var ch2 = 0; ch2 < sub.length; ch2++) { cx.fillText(sub[ch2], sStart + ch2 * sSpread, 130); }
cx.font = '500 32px Georgia, serif';
cx.fillText('92-94', 74, 92); cx.fillText('92-94', w - 74, 92);
cx.fillStyle = 'rgba(10,18,12,0.28)';
for (var wk = 0; wk < 14; wk++) { cx.fillRect(Math.random() * w, 0, 2 + Math.random() * 6, h); }
for (var bl = 0; bl < 10; bl++) {
var blg = cx.createRadialGradient(Math.random() * w, Math.random() * h, 0, Math.random() * w, Math.random() * h, 30 + Math.random() * 50);
blg.addColorStop(0, 'rgba(6,10,7,0.3)'); blg.addColorStop(1, 'rgba(6,10,7,0)');
cx.fillStyle = blg; cx.fillRect(0, 0, w, h);
}
for (var dr = 0; dr < 7; dr++) {
var drx = Math.random() * w;
cx.fillStyle = 'rgba(8,14,9,0.35)';
cx.fillRect(drx, 8 + Math.random() * 30, 2, 30 + Math.random() * 90);
}
var botG = cx.createLinearGradient(0, h - 50, 0, h);
botG.addColorStop(0, 'rgba(5,8,6,0)'); botG.addColorStop(1, 'rgba(5,8,6,0.55)');
cx.fillStyle = botG; cx.fillRect(0, h - 50, w, 50);
});
placeMesh(new THREE.BoxGeometry(4.7, 0.72, 0.1), new THREE.MeshStandardMaterial({ map: fasciaTex, roughness: 0.5 }), 0, 3.12, 0.14);
placeMesh(new THREE.BoxGeometry(4.95, 0.1, 0.26), greenDark, 0, 3.54, 0.12);
placeMesh(new THREE.BoxGeometry(4.8, 0.035, 0.2), brassMat, 0, 3.5, 0.13);
placeMesh(new THREE.BoxGeometry(4.75, 0.05, 0.16), greenDark, 0, 2.73, 0.15);

// Bay infill — the wall strips between door, window, and pilasters
placeMesh(new THREE.BoxGeometry(0.52, 3.06, 0.12), greenMat, -0.93, 1.5, 0.05);
placeMesh(new THREE.BoxGeometry(0.34, 3.06, 0.12), greenMat, -2.21, 1.5, 0.05);
placeMesh(new THREE.BoxGeometry(0.36, 3.06, 0.12), greenMat, 2.2, 1.5, 0.05);
placeMesh(new THREE.BoxGeometry(0.4, 1.9, 0.03), greenDark, -0.93, 1.6, 0.13);

// Pilasters
for (var pl = 0; pl < 2; pl++) {
var plx = pl === 0 ? -2.32 : 2.32;
placeMesh(new THREE.BoxGeometry(0.36, 3.1, 0.2), greenMat, plx, 1.55, 0.12);
placeMesh(new THREE.BoxGeometry(0.26, 2.1, 0.03), greenDark, plx, 1.7, 0.23);
placeMesh(new THREE.BoxGeometry(0.42, 0.12, 0.24), greenDark, plx, 0.06, 0.13);
placeMesh(new THREE.BoxGeometry(0.4, 0.08, 0.22), greenDark, plx, 3.02, 0.14);
}

// Whole-front filth: mottling, run-off, chipped paint
var frontGrimeTex = makeCanvasTexture(512, 384, function(cx, w, h) {
cx.clearRect(0, 0, w, h);
for (var mg = 0; mg < 26; mg++) {
var mgg = cx.createRadialGradient(Math.random() * w, Math.random() * h, 0, Math.random() * w, Math.random() * h, 26 + Math.random() * 70);
mgg.addColorStop(0, 'rgba(10,14,10,' + (0.14 + Math.random() * 0.22).toFixed(2) + ')');
mgg.addColorStop(1, 'rgba(10,14,10,0)');
cx.fillStyle = mgg; cx.fillRect(0, 0, w, h);
}
for (var rs = 0; rs < 22; rs++) {
cx.fillStyle = 'rgba(8,12,9,' + (0.12 + Math.random() * 0.22).toFixed(2) + ')';
cx.fillRect(Math.random() * w, Math.random() * h * 0.5, 1.5 + Math.random() * 4, 30 + Math.random() * 120);
}
for (var chp = 0; chp < 18; chp++) {
cx.fillStyle = 'rgba(122,132,110,' + (0.1 + Math.random() * 0.16).toFixed(2) + ')';
cx.fillRect(Math.random() * w, Math.random() * h, 2 + Math.random() * 6, 2 + Math.random() * 9);
}
var bg2 = cx.createLinearGradient(0, h - 70, 0, h);
bg2.addColorStop(0, 'rgba(14,14,10,0)'); bg2.addColorStop(1, 'rgba(14,14,10,0.6)');
cx.fillStyle = bg2; cx.fillRect(0, h - 70, w, 70);
});
placeMesh(new THREE.PlaneGeometry(4.72, 3.1), new THREE.MeshBasicMaterial({ map: frontGrimeTex, transparent: true, opacity: 0.55, depthWrite: false }), 0, 1.55, 0.21);

// ---- THE WINDOW (right of door): packed with warm stock ----
var ofBookMaskCanvas = document.createElement('canvas');
ofBookMaskCanvas.width=1024;ofBookMaskCanvas.height=768;
var ofBookMask = ofBookMaskCanvas.getContext('2d'), ofBookCount=0;
var ofMagicTime={value:0};
var displayTex = makeCanvasTexture(1024, 768, function(cx, w, h) {
var bg = cx.createRadialGradient(w * 0.5, h * 0.45, 60, w * 0.5, h * 0.5, w * 0.62);
bg.addColorStop(0, '#c25f14'); bg.addColorStop(0.45, '#8a3d0c'); bg.addColorStop(1, '#3d1d06');
cx.fillStyle = bg; cx.fillRect(0, 0, w, h);
var shelfY = [180, 350, 520, 690];
for (var sh = 0; sh < shelfY.length; sh++) {
var sy = shelfY[sh];
cx.fillStyle = 'rgba(40,20,8,0.85)'; cx.fillRect(30, sy, w - 60, 12);
var bx = 40;
while (bx < w - 60) {
var bw = 13 + Math.random() * 24, bh = 88 + Math.random() * 56;
var palette = ['#96491a', '#6e2a0e', '#54431c', '#25422a', '#5e1c1c', '#84592e', '#38335a', '#9a7038', '#4a3a28', '#70614a'];
var col2 = palette[Math.floor(Math.random() * palette.length)];
var lean = (Math.random() < 0.22) ? (Math.random() - 0.5) * 0.12 : 0;
cx.save();
cx.translate(bx + bw / 2, sy);
cx.rotate(lean);
ofBookMask.save();ofBookMask.translate(bx+bw/2,sy);ofBookMask.rotate(lean);
ofBookMask.fillStyle='rgb('+ (25+(ofBookCount++*73)%210) +',0,0)';
ofBookMask.fillRect(-bw/2,-bh,bw,bh);ofBookMask.restore();
cx.fillStyle = col2; cx.fillRect(-bw/2, -bh, bw, bh);
var bg3 = cx.createLinearGradient(-bw/2, 0, bw/2, 0);
bg3.addColorStop(0, 'rgba(0,0,0,0.45)');
bg3.addColorStop(0.18, 'rgba(0,0,0,0)');
bg3.addColorStop(0.85, 'rgba(255,240,200,0.12)');
bg3.addColorStop(1, 'rgba(0,0,0,0.3)');
cx.fillStyle = bg3; cx.fillRect(-bw/2, -bh, bw, bh);
var tg2 = cx.createLinearGradient(0, -bh, 0, 0);
tg2.addColorStop(0, 'rgba(255,235,190,0.14)'); tg2.addColorStop(0.15, 'rgba(0,0,0,0)'); tg2.addColorStop(1, 'rgba(0,0,0,0.32)');
cx.fillStyle = tg2; cx.fillRect(-bw/2, -bh, bw, bh);
cx.fillStyle = 'rgba(225,196,128,' + (0.3 + Math.random() * 0.35).toFixed(2) + ')';
cx.fillRect(-bw * 0.24, -bh + 7 + Math.random() * 6, bw * 0.48, 2.5);
cx.fillRect(-bw * 0.24, -bh + 16 + Math.random() * 4, bw * 0.48, 1.5);
if (Math.random() < 0.5) cx.fillRect(-bw * 0.24, -bh * 0.42, bw * 0.48, 2);
if (Math.random() < 0.35) { cx.fillStyle = 'rgba(20,10,4,0.35)'; cx.fillRect(-bw/2, -bh * (0.2 + Math.random() * 0.5), bw, 2); }
cx.restore();
bx += bw + 1 + Math.floor(Math.random() * 4);
if (Math.random() < 0.12 && bx < w - 130) {
for (var ly = 0; ly < 3; ly++) {
var lw = 58 + Math.random() * 26, lh = 11 + Math.random() * 5;
cx.fillStyle = palette[Math.floor(Math.random() * palette.length)];
cx.fillRect(bx, sy - (ly + 1) * lh - 2, lw, lh);
ofBookMask.fillStyle='rgb('+(25+(ofBookCount++*73)%210)+',0,0)';
ofBookMask.fillRect(bx,sy-(ly+1)*lh-2,lw,lh);
cx.fillStyle = 'rgba(240,220,170,0.4)';
cx.fillRect(bx + lw - 7, sy - (ly + 1) * lh - 1, 5, lh - 2);
}
bx += 92;
}
}
}
var prSpots = [[130, 170], [640, 200], [360, 430]];
for (var pr = 0; pr < 3; pr++) {
var px2 = prSpots[pr][0], py2 = prSpots[pr][1];
var pw2 = 100 + pr * 18, ph2 = 120 + (pr % 2) * 26;
ofBookMask.clearRect(px2-3,py2-3,pw2+6,ph2+6);
cx.fillStyle = 'rgba(204,182,134,0.9)'; cx.fillRect(px2, py2, pw2, ph2);
cx.strokeStyle = 'rgba(60,30,10,0.8)'; cx.lineWidth = 5; cx.strokeRect(px2, py2, pw2, ph2);
cx.fillStyle = 'rgba(120,70,30,0.55)';
cx.fillRect(px2 + 12, py2 + 14, pw2 - 24, 8);
cx.fillRect(px2 + 12, py2 + 30, pw2 - 24, 4);
cx.fillRect(px2 + 12, py2 + ph2 - 26, pw2 * 0.5, 4);
}
var glow = cx.createRadialGradient(w * 0.5, h * 0.42, 30, w * 0.5, h * 0.42, w * 0.5);
glow.addColorStop(0, 'rgba(255,190,90,0.30)'); glow.addColorStop(1, 'rgba(255,190,90,0)');
cx.fillStyle = glow; cx.fillRect(0, 0, w, h);
