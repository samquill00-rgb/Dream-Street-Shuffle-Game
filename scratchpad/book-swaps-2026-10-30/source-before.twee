function layoutVoiceBox(settled) {
if (!vboxOn || !activeSpot) return;
var p = anchorPx(activeSpot), W = wrap.clientWidth, H = wrap.clientHeight, bw = vbox.offsetWidth, bh = vbox.offsetHeight, gap = 34;
var left = p[0] + gap;
if (left + bw > W - 8) left = Math.max(8, p[0] - gap - bw);
var top = Math.max(8, Math.min(H - bh - 8, p[1] - bh / 2));
vbox.style.left = left + 'px'; vbox.style.top = top + 'px';
var edge = left > p[0] ? left : left + bw;
vtail.style.left = Math.min(p[0], edge) + 'px'; vtail.style.width = Math.abs(edge - p[0]) + 'px'; vtail.style.top = p[1] + 'px';
vtail.style.transform = left > p[0] ? 'none' : 'scaleX(-1)';
vdot.style.left = p[0] + 'px'; vdot.style.top = p[1] + 'px';
var show = settled && !vFaded ? '1' : '0';
vbox.style.opacity = show; vtail.style.opacity = show; vdot.style.opacity = show;
}
// 2026-10-05 overnight: the card rises a few pixels as it comes, and settles back as it goes
card.style.transform = 'translate(-50%, 8px)';
// the passage's words come into the room; links the close-ups claim are hidden there (window.dssRoomProse)
var words = window.dssRoomProse ? window.dssRoomProse(host, wrap, canvas) : null;
var wordsNext = 0;
function claimedLinks() { return HOTSPOTS.reduce(function(a, sp) { return a.concat(spotActions(sp)); }, []); }
var BTN = 'display:inline-block;margin:6px 6px 0;font:12px \'Courier New\',monospace;letter-spacing:3px;text-transform:uppercase;color:' + cBtn + ';padding:9px 18px;border:1px solid ' + cBtnBorder + ';background:rgba(0,0,0,0.35);cursor:pointer;white-space:normal;max-width:100%;box-sizing:border-box;line-height:1.5;';
/* 2026-10-17 (Sam, full screen: the paperback's card sat over the room's caption, "overlapping and messy"): while a close-up card is up, the caption (the room's name, who you came for) fades; it comes back on stepping back. Every room built by dssRoomPlay. */
function roomCap() { if (roomCap.el && roomCap.el.isConnected) return roomCap.el; var pick = function(root) { return root.querySelector('.dss-room-caption') || Array.prototype.slice.call(root.querySelectorAll('div')).filter(function(d) { if (!d.textContent || d.textContent.length > 160) return false; var cs = getComputedStyle(d); return cs.position === 'absolute' && cs.bottom === '18px' && cs.letterSpacing === '3px'; }).pop() || null; }; roomCap.el = pick(wrap) || pick(document); if(roomCap.el)roomCap.el.classList.add('dss-room-caption'); return roomCap.el; }
function capAway(away) { var rc = roomCap(); if (!rc) return; if (away) { if (rc.dataset.capOp == null) rc.dataset.capOp = rc.style.opacity || ''; rc.style.transition = 'opacity 0.35s ease'; rc.style.opacity = '0'; } else if (rc.dataset.capOp != null) { rc.style.opacity = rc.dataset.capOp; delete rc.dataset.capOp; } }
function showCard(spot) {
