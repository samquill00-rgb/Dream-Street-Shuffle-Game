<!-- GATHERED LILIES (2026-09-13). Each lily marks the venue it was found in, so the
     map carries the record as the night goes on. At five the pentangle is drawn through
     those same five doors (Chippy, Pillars, Ronnie's, Colony, French; Sam, 2026-09-23)
     and the blooming ring redraws the lilies there, so the single markers stand down. -->
(if: $tookLily1 is true and $lilyCount < 5)[(set: _m to _m + "<g class='map-lily' transform='translate(216,228) scale(0.58) translate(0,-58)'>" + _bell + "</g>")]\
(if: $tookLily2 is true and $lilyCount < 5)[(set: _m to _m + "<g class='map-lily' transform='translate(499,205) scale(0.58) translate(0,-58)'>" + _bell + "</g>")]\
(if: $tookLily3 is true and $lilyCount < 5)[(set: _m to _m + "<g class='map-lily' transform='translate(340,450) scale(0.58) translate(0,-58)'>" + _bell + "</g>")]\
