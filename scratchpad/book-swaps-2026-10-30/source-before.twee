      else if (S.porter.on) { x.fillStyle = 'rgba(255,220,150,0.85)'; x.fillRect(48*T + 1, Math.round(S.porter.y), 2, 2); var pg = x.createRadialGradient(48*T + 2, S.porter.y + 1, 0, 48*T + 2, S.porter.y + 1, 9); pg.addColorStop(0, 'rgba(255,210,130,0.35)'); pg.addColorStop(1, 'rgba(255,210,130,0)'); x.fillStyle = pg; x.fillRect(48*T - 4, S.porter.y - 8, 12, 18); }
    }
