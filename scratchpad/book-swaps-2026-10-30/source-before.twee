  { id:'bourchier',  c:11, r:32, fc:11, fr:32, name:'BOURCHIER STREET',    label:'', col:[120,60,60],   rx:/^Bourchier Street$/i,    spot:true, event:true },
  { id:'square',     c:35, r:7,  fc:35, fr:7,  name:'SOHO SQUARE',         label:'', col:[214,170,110], rx:/^Soho Square$/i,         spot:true, event:true },
  { id:'foyles',     c:48, r:12, fc:48, fr:12,  name:'CHARING CROSS ROAD',  label:'', col:[214,170,110], rx:/^Charing Cross Road$/i,  spot:true, event:true, hidden:true },
];
// Smashable anonymous street windows, separate from venue door hitboxes.
var BREAKABLE_WINDOWS = [
  {id:'dean-north',c:15,r:9,fc:16,fr:9}, {id:'dean-west',c:15,r:18,fc:16,fr:18},
  {id:'dean-east',c:20,r:33,fc:19,fr:33}, {id:'frith',c:27,r:19,fc:28,fr:19},
  {id:'greek',c:44,r:20,fc:43,fr:20}, {id:'romilly',c:34,r:33,fc:34,fr:34}
];
var LAMPS = [ {c:19,r:26,ginger:true}, {c:16,r:14}, {c:19,r:17}, {c:28,r:14}, {c:31,r:17}, {c:40,r:14}, {c:43,r:17}, {c:16,r:29}, {c:28,r:26}, {c:31,r:29}, {c:40,r:26}, {c:43,r:29},
              {c:7,r:26}, {c:48,r:29}, {c:19,r:34}, {c:31,r:37}, {c:43,r:34}, {c:48,r:37}, {c:4,r:3}, {c:16,r:3}, {c:28,r:3}, {c:40,r:3}, {c:48,r:3}, {c:16,r:40}, {c:28,r:40}, {c:40,r:40},
              {c:7,r:14}, {c:33,r:5}, {c:38,r:10}, {c:43,r:10}, {c:48,r:10}, {c:7,r:40}, {c:4,r:29} ];

var PAL = {
  road:'#141419', roadLight:'#1b1b22', roadLine:'#23232b', roadWet:'#20202a',
  pave:'#2a2b33', paveLine:'#1c1d24', paveLight:'#33343d', kerb:'#3a3b45',
  alley:'#1f2027', alleyLine:'#17181e', garden:'#151d16', gardenLight:'#1b261c', rail:'#3a3a44',
  brick:'#2a1f1c', brick2:'#241b19', stucco:'#27242a', stucco2:'#221f25', soot:'#1a1517',
  roof:'#17161b', roofSeam:'#121116', roofLight:'#1d1c22', chimney:'#221f24',
  winDark:'#0f1018', winWarm:'#b8843a', winGlass:'#1b2030', winRed:'#a3302a',
  doorDark:'#0c0b10', doorWood:'#3a2a1c', lintel:'#3b3540', step:'#3f4049',
  lampPost:'#0d0d12', lampHead:'#e6b95a', ginger:'#e8862a'
};
function rgba(col, a) { return 'rgba(' + col[0] + ',' + col[1] + ',' + col[2] + ',' + a + ')'; }
function mix(col, k) { return 'rgb(' + Math.round(col[0]*k) + ',' + Math.round(col[1]*k) + ',' + Math.round(col[2]*k) + ')'; }
function lighten(col, k) { return 'rgb(' + Math.round(col[0] + (255-col[0])*k) + ',' + Math.round(col[1] + (255-col[1])*k) + ',' + Math.round(col[2] + (255-col[2])*k) + ')'; }

var state = null;

function seeded(c, r, k) { var x = Math.sin(c*127.1 + r*311.7 + (k||0)*74.7) * 43758.5453; return x - Math.floor(x); }
function isRoad(c, r) { return tileAt(c, r) === 'R'; }
function isPave(c, r) { var t = tileAt(c, r); return t === 'P' || t === 'A' || t === 'G'; }
function isBuilding(c, r) { return tileAt(c, r) === '#'; }
function inBounds(c, r) { return c >= 0 && r >= 0 && c < COLS && r < ROWS; }
function isFacade(c, r) {
  if (!isBuilding(c, r)) return false;
  return isPave(c-1, r) || isPave(c+1, r) || isPave(c, r-1) || isPave(c, r+1);
}
function doorAt(c, r) { for (var i = 0; i < DOORS.length; i++) if (DOORS[i].c === c && DOORS[i].r === r) return DOORS[i]; return null; }
function doorById(id) { for (var i = 0; i < DOORS.length; i++) if (DOORS[i].id === id) return DOORS[i]; return null; }
function walkable(c, r) {
  if (!inBounds(c, r)) return false;
  var d = doorAt(c, r);
  if (d && !d.spot) return false;
  return isRoad(c, r) || isPave(c, r);
}
function doorSide(d) { return d.fc < d.c ? 'w' : (d.fc > d.c ? 'e' : (d.fr < d.r ? 'n' : 's')); }
// Soho Square's fence (Sam, 2026-10-10): railings round the garden (34..37 x 6..9) with a gate
// on each side. The gates lock once the night reaches the fire (sobriety under 30 after a
// blackout, the hut still standing: hub flag 'square-locked'); walking into a locked gate from
// the street climbs in, i.e. opens Soho Square, whose page offers "Climb into the Square."
var SQ_GATES = [ { side:'n', c:35, r:5, ic:35, ir:6 }, { side:'s', c:36, r:10, ic:36, ir:9 },
                 { side:'w', c:33, r:8, ic:34, ir:8 }, { side:'e', c:38, r:7, ic:37, ir:7 } ];
function inSquareGarden(c, r) { return c >= 34 && c <= 37 && r >= 6 && r <= 9; }
function squareLocked() { var el = document.querySelector('.dss-hub-flag[data-k="square-locked"]'); return !!el && el.textContent.trim() === 'on'; }
function squareGate(c, r, nc, nr) {
  for (var i = 0; i < SQ_GATES.length; i++) { var g = SQ_GATES[i];
    if ((g.c === c && g.r === r && g.ic === nc && g.ir === nr) || (g.c === nc && g.r === nr && g.ic === c && g.ir === r)) return g; }
  return null;
}
// 'open' (no fence in the way), 'gate' (an unlocked gate), 'locked' (a locked gate), 'fence'
function fenceCrossing(c, r, nc, nr) {
  if (inSquareGarden(c, r) === inSquareGarden(nc, nr)) return 'open';
  var g = squareGate(c, r, nc, nr);
  if (!g) return 'fence';
  return squareLocked() ? 'locked' : 'gate';
}

// ---- pixel sprite: 12x16, no face (house rule) ----
var SPR = {
  down: [
    "....hhhh....","...hhhhhh...","..hhhhhhhh..","..bbbbbbbb..","...bbbbbb...","...cccccc...",
    "..cccccccc..",".cclcccclcc.",".cclcccclcc.",".cccccccccc.","..cccccccc..","..cccccccc..",
    "...gg..gg...","...gg..gg...","...ss..ss...","............"],
  up: [
    "....hhhh....","...hhhhhh...","..hhhhhhhh..","..hhhhhhhh..","...hhhhhh...","...cccccc...",
    "..cccccccc..",".cclcccclcc.",".cclcccclcc.",".cccccccccc.","..cccccccc..","..cccccccc..",
    "...gg..gg...","...gg..gg...","...ss..ss...","............"],
  right: [
    "....hhhh....","...hhhhhh...","...hhhhhhh..","...bbbbbbbb.","....bbbb....","....cccc....",
    "...cccccc...","...cccccc...","...cclccc...","...cccccc...","...cccccc...","...cccccc...",
    "....gggg....","....gg.gg...","....ss.ss...","............"]
};
var SPRPAL = { h:'#181a26', b:'#0a0b12', c:'#2c3048', l:'#465072', g:'#1a1c2a', s:'#08090e' };
function makeSprite(rows, frame, flip, coat) {
  var cv = document.createElement('canvas'); cv.width = 12; cv.height = 16;
  var x = cv.getContext('2d');
  for (var r = 0; r < 16; r++) {
    for (var c = 0; c < 12; c++) {
      var ch = rows[r][c];
      if (ch === '.') continue;
      var rr = r, drop = false;
      if (r >= 12 && r <= 14 && (ch === 'g' || ch === 's')) {
        var leftLeg = c < 6;
        if ((frame === 1 && leftLeg) || (frame === 2 && !leftLeg)) { if (r === 14) drop = true; else rr = r + 1; }
      }
      if (drop) continue;
      var col = SPRPAL[ch];
      if (coat && (ch === 'c' || ch === 'l')) col = coat[ch];
      x.fillStyle = col;
      x.fillRect(flip ? 11 - c : c, rr, 1, 1);
    }
  }
  return cv;
}
function buildSprites(coat) {
  var s = {};
  ['down','up','right'].forEach(function(d){ s[d] = [0,1,2].map(function(f){ return makeSprite(SPR[d], f, false, coat); }); });
  s.left = [0,1,2].map(function(f){ return makeSprite(SPR.right, f, true, coat); });
  return s;
}

// ---- tiles ----
function drawRoad(x, c, r) {
  x.fillStyle = PAL.road; x.fillRect(0, 0, T, T);
  for (var i = 0; i < 6; i++) { var sx = Math.floor(seeded(c,r,i)*T), sy = Math.floor(seeded(c,r,i+9)*T); x.fillStyle = seeded(c,r,i+20) > 0.5 ? PAL.roadLight : PAL.roadWet; x.fillRect(sx, sy, 2, 1); }
  // centre-line dashes on the east lane of a north-south road, the south lane of an east-west one
  var vert = isRoad(c, r-1) && isRoad(c, r+1), horiz = isRoad(c-1, r) && isRoad(c+1, r);
  if (vert && isRoad(c-1, r) && !isRoad(c+1, r) && (r % 2 === 0)) { x.fillStyle = PAL.roadLine; x.fillRect(0, 3, 1, 6); }
  else if (horiz && isRoad(c, r-1) && !isRoad(c, r+1) && (c % 2 === 0)) { x.fillStyle = PAL.roadLine; x.fillRect(3, 0, 6, 1); }
}
function drawPave(x, c, r) {
  x.fillStyle = PAL.pave; x.fillRect(0, 0, T, T);
  x.fillStyle = PAL.paveLine; x.fillRect(0, 7, T, 1); x.fillRect(7, 0, 1, T);
  x.fillStyle = PAL.paveLight; x.fillRect(1, 1, 3, 1); x.fillRect(9, 9, 2, 1);
  x.fillStyle = PAL.kerb;
  if (isRoad(c-1,r)) x.fillRect(0, 0, 1, T);
  if (isRoad(c+1,r)) x.fillRect(T-1, 0, 1, T);
  if (isRoad(c,r-1)) x.fillRect(0, 0, T, 1);
  if (isRoad(c,r+1)) x.fillRect(0, T-1, T, 1);
}
// an alley: narrower, darker flags, no kerb — a gap between the buildings
function drawAlleyTile(x, c, r) {
  x.fillStyle = PAL.alley; x.fillRect(0, 0, T, T);
  x.fillStyle = PAL.alleyLine; x.fillRect(0, 5, T, 1); x.fillRect(0, 11, T, 1); x.fillRect(seeded(c,r,3) > 0.5 ? 4 : 10, 0, 1, T);
  x.fillStyle = PAL.soot; x.fillRect(0, 0, T, 1); x.fillRect(0, T-1, T, 1);
  if (seeded(c,r,4) > 0.8) { x.fillStyle = '#2a2622'; x.fillRect(2 + Math.floor(seeded(c,r,5)*10), 6, 3, 2); }
}
// Soho Square's fence (2026-10-10): iron railings with spear-head posts round the garden, a gate
// in the middle of each side; open gates stand ajar, locked ones are shut with a brass padlock.
function drawSquareFence(x) {
  var locked = squareLocked(), x0 = 34*T, x1 = 38*T, y0 = 6*T, y1 = 10*T;
  function gateAt(side, i) { for (var k = 0; k < SQ_GATES.length; k++) { var g = SQ_GATES[k]; if (g.side === side && (side === 'n' || side === 's' ? g.ic : g.ir) === i) return g; } return null; }
  function hRun(y, side) {
    for (var c = 34; c <= 37; c++) {
      var g = gateAt(side, c), gx = c*T;
      if (g && !locked) { x.fillStyle = PAL.rail; x.fillRect(gx, y - 1, 2, 3); x.fillRect(gx + T - 2, y - 1, 2, 3); x.fillStyle = '#4a4a56'; x.fillRect(gx + 1, side === 'n' ? y - 6 : y + 1, 1, 6); x.fillRect(gx + T - 2, side === 'n' ? y - 6 : y + 1, 1, 6); continue; }
      x.fillStyle = PAL.rail; x.fillRect(gx, y, T, 1); x.fillRect(gx, y - 3, T, 1);
      for (var px = 1; px < T; px += 3) { x.fillRect(gx + px, y - 4, 1, 6); x.fillStyle = '#55555f'; x.fillRect(gx + px, y - 5, 1, 1); x.fillStyle = PAL.rail; }
      if (g) { x.fillStyle = '#4a4a56'; x.fillRect(gx, y - 4, 1, 6); x.fillRect(gx + T - 1, y - 4, 1, 6); x.fillStyle = '#c9a24a'; x.fillRect(gx + 7, y - 2, 2, 2); x.fillStyle = '#8a6a2a'; x.fillRect(gx + 7, y - 3, 2, 1); }
    }
  }
  function vRun(xx, side) {
    for (var r = 6; r <= 9; r++) {
      var g = gateAt(side, r), gy = r*T;
      if (g && !locked) { x.fillStyle = PAL.rail; x.fillRect(xx - 1, gy, 3, 2); x.fillRect(xx - 1, gy + T - 2, 3, 2); x.fillStyle = '#4a4a56'; x.fillRect(side === 'w' ? xx - 6 : xx + 1, gy + 1, 6, 1); x.fillRect(side === 'w' ? xx - 6 : xx + 1, gy + T - 2, 6, 1); continue; }
      x.fillStyle = PAL.rail; x.fillRect(xx, gy, 1, T); x.fillRect(xx + (side === 'w' ? -2 : 2), gy, 1, T);
      for (var py = 1; py < T; py += 3) { x.fillRect(xx - 2, gy + py, 5, 1); }
      if (g) { x.fillStyle = '#c9a24a'; x.fillRect(xx - 1, gy + 7, 2, 2); x.fillStyle = '#8a6a2a'; x.fillRect(xx - 1, gy + 6, 2, 1); }
    }
  }
  hRun(y0, 'n'); hRun(y1, 's'); vRun(x0, 'w'); vRun(x1, 'e');
  x.fillStyle = '#4a4a56'; [[x0, y0], [x1, y0], [x0, y1], [x1, y1]].forEach(function(p){ x.fillRect(p[0] - 1, p[1] - 5, 3, 7); });
}
// Soho Square's garden: dark grass, a tree here and there, railings on the ring
function drawGarden(x, c, r) {
  x.fillStyle = PAL.garden; x.fillRect(0, 0, T, T);
  for (var i = 0; i < 5; i++) { x.fillStyle = PAL.gardenLight; x.fillRect(Math.floor(seeded(c,r,i)*T), Math.floor(seeded(c,r,i+7)*T), 2, 1); }
  if (seeded(c,r,9) > 0.62) { x.fillStyle = '#0e1410'; x.fillRect(4, 3, 8, 8); x.fillStyle = '#18221a'; x.fillRect(5, 4, 5, 5); x.fillStyle = '#2a2018'; x.fillRect(7, 11, 2, 3); }
}
function drawRoof(x, c, r) {
  x.fillStyle = seeded(c,r,1) > 0.5 ? PAL.roof : PAL.roofLight; x.fillRect(0, 0, T, T);
  x.fillStyle = PAL.roofSeam; x.fillRect(0, 0, T, 1); x.fillRect(0, 0, 1, T);
  if (seeded(c,r,2) > 0.72) { var cxp = 4 + Math.floor(seeded(c,r,3)*7); x.fillStyle = PAL.chimney; x.fillRect(cxp, 3, 3, 4); x.fillStyle = PAL.roofSeam; x.fillRect(cxp, 3, 3, 1); if (CHIMNEYS.length < 12 && seeded(c,r,4) > 0.8) CHIMNEYS.push({ x: c*T + cxp + 1, y: r*T + 3, k: CHIMNEYS.length }); }
}
function drawFacade(x, c, r, litCol) {
  var v = seeded(c, r, 4);
  // 2026-09-12: each block has its own character (a warm red-brick block, a painted grey one)
  var bk = seeded(Math.floor(c / 7), Math.floor(r / 9), 13);
  var base = v < 0.34 ? PAL.brick : (v < 0.67 ? PAL.stucco : PAL.brick2);
  if (bk > 0.74) base = v < 0.5 ? '#31211a' : '#2b1e19'; else if (bk < 0.2) base = v < 0.5 ? '#25282e' : '#212429';
  x.fillStyle = base; x.fillRect(0, 0, T, T);
  if (v < 0.34 || v >= 0.67) { x.fillStyle = PAL.soot; for (var i = 0; i < 4; i++) x.fillRect((i*4 + (r%2)*2) % T, i*4, 3, 1); }
  else { x.fillStyle = PAL.stucco2; x.fillRect(0, 5, T, 1); x.fillRect(0, 11, T, 1); }
  var w = litCol ? (seeded(c,r,5) > 0.45 ? lighten(litCol, 0.35) : lighten(litCol, 0.1)) : (seeded(c,r,6) > 0.74 ? PAL.winWarm : PAL.winDark);
  // the red rooms: only on the old trade's streets, never a venue front, a few to a block
  var redZone = (c <= 8 && r >= 24 && r <= 40) || ((r === 26 || r === 29) && c >= 7 && c <= 40) || (r >= 29 && r <= 34 && c >= 19 && c <= 28);
  if (!litCol && redZone && !doorAt(c, r) && seeded(c, r, 11) > 0.8) { w = PAL.winRed; RED_WINS.push({ x: c*T + (seeded(c,r,12) > 0.5 ? 3 : 10), y: r*T + 3, k: RED_WINS.length }); }
  x.fillStyle = w; x.fillRect(3, 3, 3, 4); x.fillRect(10, 3, 3, 4);
  if (w === PAL.winWarm && WIN_BLINK.length < 24 && seeded(c,r,7) > 0.5) WIN_BLINK.push({x: c*T + (seeded(c,r,8) > 0.5 ? 3 : 10), y: r*T + 3, k: WIN_BLINK.length});
  if (w === PAL.winWarm) WARM_WINS.push({ x: c*T, y: r*T, u: seeded(c, r, 9) }); // bedtime: this window goes dark once the night is u of the way through
  x.fillStyle = (w === PAL.winDark || w === PAL.winRed) ? PAL.winGlass : w; x.fillRect(3, 10, 3, 4); x.fillRect(10, 10, 3, 4);
  x.fillStyle = PAL.soot; x.fillRect(3, 5, 3, 1); x.fillRect(10, 5, 3, 1);
}
function drawDoorTile(x, c, r, door, status) {
  // A 'quiet' door is a doorway, not a venue: no lit frontage on the block.
  drawFacade(x, c, r, (status === 'open' && !door.quiet) ? door.col : null);
  var side = doorSide(door), open = status === 'open', grey = status === 'grey';
  var inner = open ? lighten(door.col, 0.42) : (grey ? PAL.doorWood : PAL.doorDark);
  var frame = open ? '#fff3d6' : (grey ? '#6a5f52' : '#3b3540');
  var band = open ? lighten(door.col, 0.2) : (grey ? mix(door.col, 0.4) : PAL.lintel);
  x.fillStyle = frame;
  if (side === 'n') x.fillRect(2, 0, 12, 13); else if (side === 's') x.fillRect(2, 3, 12, 13); else if (side === 'w') x.fillRect(0, 2, 13, 12); else x.fillRect(3, 2, 13, 12);
  x.fillStyle = inner;
  if (side === 'n') x.fillRect(3, 0, 10, 12); else if (side === 's') x.fillRect(3, 4, 10, 12); else if (side === 'w') x.fillRect(0, 3, 12, 10); else x.fillRect(4, 3, 12, 10);
  x.fillStyle = band;
  if (side === 'n') x.fillRect(0, 13, T, 3); else if (side === 's') x.fillRect(0, 0, T, 3); else if (side === 'w') x.fillRect(13, 0, 3, T); else x.fillRect(0, 0, 3, T);
  if (open) {
    x.fillStyle = '#fff7de';
    if (side === 'n') x.fillRect(6, 0, 4, 3); else if (side === 's') x.fillRect(6, 13, 4, 3); else if (side === 'w') x.fillRect(0, 6, 3, 4); else x.fillRect(13, 6, 3, 4);
    x.fillStyle = '#ffffff';
    x.fillRect(6, 6, (side === 'n' || side === 's') ? 4 : 5, (side === 'n' || side === 's') ? 5 : 4);
  }
}
function drawStep(x, door) {
  var side = doorSide(door);
  x.fillStyle = PAL.step;
  if (side === 'n') x.fillRect(4, 13, 8, 3); else if (side === 's') x.fillRect(4, 0, 8, 3); else if (side === 'w') x.fillRect(13, 4, 3, 8); else x.fillRect(0, 4, 3, 8);
}
// the Cecil Court mouth: a pavement tile on the east edge with the court opening off it
function drawAlley(x, door, status) {
  drawPave(x, door.c, door.r);
  x.fillStyle = PAL.lintel; x.fillRect(10, 0, 6, T);
  x.fillStyle = status === 'open' ? mix(door.col, 0.6) : (status === 'grey' ? PAL.doorWood : PAL.doorDark); x.fillRect(11, 1, 5, 14);
}
// A K2 box, drawn whether or not you have a coin for it: it is street furniture,
// and Sam walked into it without knowing it was there (2026-09-14). It lights
// from the inside once the hub offers it.
function drawPhoneBox(x, lit) {
  x.fillStyle = 'rgba(0,0,0,0.45)'; x.fillRect(3, 15, 10, 1);
  x.fillStyle = '#5d0c10'; x.fillRect(4, 2, 8, 2);
  x.fillStyle = lit ? '#c02026' : '#7e1216'; x.fillRect(4, 4, 8, 12);
  x.fillStyle = lit ? '#e04a3c' : '#94191c'; x.fillRect(4, 4, 1, 12);
  x.fillStyle = lit ? '#f6e2ae' : '#2a2028'; x.fillRect(6, 6, 4, 7);
  x.fillStyle = lit ? '#c02026' : '#7e1216';
  x.fillRect(7, 6, 1, 7); x.fillRect(6, 8, 4, 1); x.fillRect(6, 10, 4, 1);
  x.fillStyle = lit ? '#e8c86a' : '#6a5a3a'; x.fillRect(6, 2, 4, 1);
}
// A stranger on a corner: hat, coat, and the brass of whatever they are holding.
function drawStranger(x, d) {
  x.fillStyle = 'rgba(0,0,0,0.45)'; x.fillRect(4, 15, 9, 1);
  x.fillStyle = '#1a1418'; x.fillRect(5, 3, 6, 1); x.fillRect(6, 1, 4, 2);
  x.fillStyle = '#d8b48a'; x.fillRect(7, 4, 3, 2);
  x.fillStyle = '#3a2a30'; x.fillRect(6, 6, 5, 7);
  x.fillRect(6, 13, 2, 2); x.fillRect(9, 13, 2, 2);
  if (d.item === 'paper') { x.fillStyle = '#e8dcc0'; x.fillRect(10, 8, 4, 3); x.fillStyle = '#8a7a60'; x.fillRect(11, 9, 2, 1); }
  else if (d.item === 'none') { x.fillStyle = '#d8b48a'; x.fillRect(5, 9, 1, 2); x.fillRect(11, 9, 1, 2); }
  else { x.fillStyle = lighten(d.col, 0.1); x.fillRect(10, 8, 4, 1); x.fillRect(13, 6, 2, 3); }
}
function drawLampPost(x, lamp) {
  x.fillStyle = PAL.lampPost; x.fillRect(7, 4, 2, 12); x.fillRect(5, 3, 6, 2);
  x.fillStyle = lamp.ginger ? PAL.ginger : (lampOut(lamp) ? '#26252a' : PAL.lampHead); x.fillRect(6, 1, 4, 3);
}
// 2026-10-13 (Sam, "Soho goes out"): the street lamps go out as the night deepens, a fifth, two fifths, then over half
// once the Alba is whole; the Ginger Light never does. Which ones is fixed per lamp, so a dark lamp stays dark.
function nightPhaseNow() { var el = document.querySelector('.night-phase[data-night-phase]'); return Math.max(0, Math.min(3, Number(el && el.dataset.nightPhase) || 0)); }
function lampOut(l) { return !l.ginger && seeded(l.c, l.r, 21) < [0, 0.2, 0.4, 0.55][nightPhaseNow()]; }

// ---- fronts and landmarks (2026-09-12) --------------------------------------------------
// Every venue gets a front you can read without its label: neon at Ronnie's, the tricolour
// at the French, the chippy's lit window, pillars at the Pillars, railings at Trisha's, and
// so on. Plus three landmarks off the door list: Foyles' window along the east edge, the
// Tudor hut in Soho Square, St Anne's tower at the bottom of Wardour Street.
function frontageTiles(d) {
  var side = doorSide(d);
  var nbs = (side === 'e' || side === 'w') ? [[d.c, d.r-1],[d.c, d.r+1],[d.c, d.r-2],[d.c, d.r+2]] : [[d.c-1, d.r],[d.c+1, d.r],[d.c-2, d.r],[d.c+2, d.r]];
  return nbs.filter(function(n){ return inBounds(n[0], n[1]) && isFacade(n[0], n[1]) && !doorAt(n[0], n[1]); });
}
// draw inside a tile with the street edge at the BOTTOM (y = T), whichever way it really faces
function faceTile(x, c, r, side, fn) {
  x.save(); x.translate(c*T + 8, r*T + 8);
  if (side === 'n') x.rotate(Math.PI); else if (side === 'e') x.rotate(-Math.PI/2); else if (side === 'w') x.rotate(Math.PI/2);
  x.translate(-8, -8); fn(x); x.restore();
}
function frontBase(x, col, sootRows) {
  x.fillStyle = col; x.fillRect(0, 0, T, T);
  if (sootRows !== false) { x.fillStyle = PAL.soot; for (var i = 0; i < 4; i++) x.fillRect((i*4) % T, i*4, 3, 1); }
}
var FRONTS = {
  ronnies: function(x, k, st, lit) {
    frontBase(x, '#221c24');
    x.fillStyle = lit || PAL.winDark; x.fillRect(3, 2, 3, 4); x.fillRect(10, 2, 3, 4);
    x.fillStyle = '#0b0a0e'; x.fillRect(1, 8, 14, 7);
    var on = st !== 'shut';
    x.fillStyle = on ? '#ff5cc4' : '#5a2a48';
    x.fillRect(2, 9, 12, 1); x.fillRect(2, 13, 12, 1); x.fillRect(2, 9, 1, 5); x.fillRect(13, 9, 1, 5);
    x.fillStyle = on ? '#fff0fa' : '#7a4a68'; x.fillRect(5, 11, 6, 1);
    if (k === 0) { x.fillStyle = on ? '#ffe36e' : '#6a5a2a'; x.fillRect(11, 10, 1, 3); x.fillRect(10, 12, 1, 1); }
  },
  french: function(x, k, st, lit) {
    frontBase(x, '#2a1f1c');
    if (k === 0) {
      x.fillStyle = lit || PAL.winDark; x.fillRect(3, 2, 3, 4); x.fillRect(10, 2, 3, 4);
      x.fillStyle = '#1a1517'; x.fillRect(7, 8, 1, 8);
      x.fillStyle = '#3a5fb0'; x.fillRect(8, 9, 2, 5); x.fillStyle = '#f2ece0'; x.fillRect(10, 9, 2, 5); x.fillStyle = '#c8363a'; x.fillRect(12, 9, 2, 5);
    } else {
      x.fillStyle = '#c4583c'; x.fillRect(3, 2, 10, 5); x.fillStyle = '#7a2a22'; x.fillRect(7, 2, 2, 5);
      x.fillStyle = lit ? lighten([232,180,90], 0.2) : '#3a2a20'; x.fillRect(3, 10, 10, 4); x.fillStyle = '#1a1517'; x.fillRect(7, 10, 2, 4);
    }
  },
  colony: function(x, k, st, lit) {
    frontBase(x, '#25262a');
    var g = st === 'shut' ? '#243024' : '#8fcf72';
    x.fillStyle = g; x.fillRect(3, 2, 4, 5); x.fillRect(9, 2, 4, 5);
    x.fillStyle = st === 'shut' ? '#1a241a' : '#4e8a3c'; x.fillRect(4, 4, 2, 1); x.fillRect(10, 4, 2, 1);
    x.fillStyle = '#3a3a30'; x.fillRect(3, 10, 4, 4); x.fillRect(9, 10, 4, 4);
    if (k === 0) { x.fillStyle = '#d2b25a'; x.fillRect(12, 12, 3, 3); x.fillStyle = '#7a6430'; x.fillRect(13, 13, 1, 1); }
    else { x.fillStyle = '#2c2c34'; x.fillRect(2, 11, 4, 5); x.fillStyle = '#3c3c46'; x.fillRect(2, 11, 4, 1); }
  },
  doorway: function(x, k, st, lit) {
    frontBase(x, '#241b19');
    x.fillStyle = st === 'shut' ? '#3a1a22' : '#8a2432'; x.fillRect(5, 2, 6, 5);
    x.fillStyle = st === 'shut' ? '#5a2a34' : '#ff6a7a'; x.fillRect(7, 4, 2, 2);
    x.fillStyle = '#2c2430'; x.fillRect(3, 10, 3, 4); x.fillRect(10, 10, 3, 4);
    if (k === 0) { x.fillStyle = '#c8a850'; x.fillRect(13, 13, 2, 2); }
  },
  chippy: function(x, k, st, lit) {
    frontBase(x, '#3a2a1c', false);
    x.fillStyle = '#5a1e1e'; x.fillRect(0, 0, T, 4);
    var on = st === 'open';
    x.fillStyle = '#3a2a1c'; x.fillRect(0, 4, T, 12);
    x.fillStyle = on ? '#fff0b0' : '#5a5040'; x.fillRect(1, 5, 14, 10);
    x.fillStyle = on ? '#e0a040' : '#4a4030'; x.fillRect(2, 11, 12, 2);
    x.fillStyle = on ? '#f8d890' : '#4a4436'; x.fillRect(4, 7, 3, 2); x.fillRect(9, 7, 3, 2);
    if (k === 0) { x.fillStyle = on ? '#f08030' : '#7a4a30'; x.fillRect(4, 1, 6, 2); x.fillRect(10, 0, 2, 4); x.fillStyle = '#5a1e1e'; x.fillRect(5, 1, 1, 1); }
    else { x.fillStyle = on ? '#f8e8c0' : '#7a6a50'; x.fillRect(3, 1, 10, 2); }
  },
  coach: function(x, k, st, lit) {
    frontBase(x, '#2a1f1c');
    var on = st !== 'shut';
    x.fillStyle = on ? '#e8d8a8' : '#3a3428'; x.fillRect(2, 3, 12, 7);
    x.fillStyle = '#4a3a2a'; x.fillRect(7, 3, 2, 7); x.fillRect(2, 6, 12, 1);
    x.fillStyle = on ? '#c8a860' : '#4a4030'; x.fillRect(3, 4, 4, 2); x.fillRect(9, 4, 5, 2);
    x.fillStyle = '#1a1517'; x.fillRect(0, 11, T, 1);
    if (k === 0) { x.fillStyle = '#3a2a1c'; x.fillRect(5, 12, 6, 4); x.fillStyle = '#e8a040'; x.fillRect(5, 12, 6, 1); x.fillRect(5, 15, 6, 1); x.fillStyle = on ? '#ffd070' : '#5a4a20'; x.fillRect(7, 13, 2, 2); }
    else { x.fillStyle = '#5a4a3a'; x.fillRect(2, 12, 12, 3); x.fillStyle = '#7a6a5a'; x.fillRect(2, 12, 12, 1); }
  },
  pillars: function(x, k, st, lit) {
    frontBase(x, '#27242a');
    x.fillStyle = '#a89c8a'; x.fillRect(1, 0, 2, 16); x.fillRect(13, 0, 2, 16);
    x.fillStyle = '#c8bcaa'; x.fillRect(0, 0, 4, 2); x.fillRect(12, 0, 4, 2); x.fillRect(0, 14, 4, 2); x.fillRect(12, 14, 4, 2);
    x.fillStyle = st === 'shut' ? '#28323a' : '#c8d8e8'; x.fillRect(5, 3, 6, 6);
    x.fillStyle = '#3a4a5a'; x.fillRect(7, 3, 2, 6); x.fillRect(5, 5, 6, 1);
    x.fillStyle = st === 'shut' ? '#3a3020' : '#ffd070'; x.fillRect(6, 12, 4, 3); x.fillStyle = '#1a1517'; x.fillRect(7, 11, 2, 1);
  },
  trishas: function(x, k, st, lit) {
    frontBase(x, '#1f1c22');
    x.fillStyle = '#2c2c34'; x.fillRect(3, 2, 3, 4); x.fillRect(10, 2, 3, 4);
    x.fillStyle = '#3a3a44'; x.fillRect(0, 11, T, 1);
    x.fillStyle = '#0a0a0e'; for (var i = 1; i < 16; i += 3) x.fillRect(i, 11, 1, 5);
    x.fillStyle = st === 'shut' ? '#4a2a3a' : '#ff8ac8'; x.fillRect(7, 13, 2, 2);
    if (k === 1) { x.fillStyle = '#2a2a30'; x.fillRect(4, 7, 8, 3); }
  },
  lackland: function(x, k, st, lit) {
    frontBase(x, '#25282e');
    x.fillStyle = st === 'shut' ? '#243024' : '#7fbf7f'; x.fillRect(3, 2, 4, 5);
    x.fillStyle = '#1b2030'; x.fillRect(9, 2, 4, 5);
    x.fillStyle = '#3a3a30'; x.fillRect(3, 10, 4, 3); x.fillRect(9, 10, 4, 3);
    x.fillStyle = '#4a4a40'; x.fillRect(3, 10, 4, 1); x.fillRect(9, 10, 4, 1);
    if (k === 0) { x.fillStyle = '#d2b25a'; x.fillRect(6, 13, 5, 3); x.fillStyle = '#7a6430'; x.fillRect(7, 14, 3, 1); }
  }
};
function drawFronts(x, doors) {
  DOORS.forEach(function(d){
    var fn = FRONTS[d.id]; if (!fn) return;
    var st = doors[d.id].status, side = doorSide(d);
    var lit = st === 'open' ? lighten(d.col, 0.3) : null;
    frontageTiles(d).forEach(function(n, k){ faceTile(x, n[0], n[1], side, function(xx){ fn(xx, k, st, lit); }); });
  });
  // Foyles: the whole of literature stacked behind the glass. 2026-10-10 (Sam): moved to where it
  // really stands, the west (Soho) side of the Charing Cross Road at the south corner of Manette Street
  var SPINES = ['#c8402a', '#2a5ab0', '#e0b040', '#3a8a4a', '#e8e0c8', '#8a3a9a', '#d07030'];
  for (var fr = 10; fr <= 16; fr++) {
    x.save(); x.translate(48*T, fr*T);
    x.fillStyle = '#3a2a1c'; x.fillRect(0, 0, 5, T);
    if (fr === 12) { x.fillStyle = '#1a1210'; x.fillRect(0, 2, 4, 12); x.fillStyle = '#d2b25a'; x.fillRect(3, 8, 1, 1); }
    else { x.fillStyle = '#e8d8a8'; x.fillRect(0, 1, 4, 14); for (var sp = 1; sp < 15; sp += 2) { x.fillStyle = SPINES[Math.floor(seeded(48, fr, sp) * SPINES.length)]; x.fillRect(seeded(48, fr, sp + 40) > 0.5 ? 1 : 0, sp, 3, 1); } }
    x.restore();
  }
