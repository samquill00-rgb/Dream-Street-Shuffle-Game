<!-- 2026-10-16 (Sam: suggestions, 2, the plan travels with you): under the slips, who is still to see tonight, the same list Dean Street asks about; the picked one marked -->(display: "Who Will Read")(if: ($bookAt is a string) and ($bookAt is "") and ($bookSold is not true) and ($whoList is an array) and ($whoList's length > 0))[(set: _nb to _nb + '<div class="nb-section nb-tosee"><div class="nb-tosee-h">Still to see</div>')(for: each _w, ...$whoList)[(set: _nb to _nb + '<div class="nb-tosee-row' + (cond: (_w's id is $pitchTarget) and ((_w's name is $pitchName) or (_w's id is "french")), ' nb-tosee-on', '') + '">' + (_w's name) + ' · ' + (_w's place) + '</div>')](set: _nb to _nb + '</div>')]\
