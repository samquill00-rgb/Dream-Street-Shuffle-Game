      // Short noise impulse — the "tick" of impact
      var impLen = Math.floor(ac.sampleRate * 0.005);
      var impBuf = ac.createBuffer(1, impLen, ac.sampleRate);
      var impData = impBuf.getChannelData(0);
      for (var i = 0; i < impLen; i++) {
        impData[i] = (Math.random() * 2 - 1) * Math.exp(-i / impLen * 6);
      }
      var impSrc = ac.createBufferSource(); impSrc.buffer = impBuf;
      var impFilt = ac.createBiquadFilter();
      impFilt.type = 'bandpass'; impFilt.frequency.value = freq * 1.3; impFilt.Q.value = 4;
      var impGain = ac.createGain(); impGain.gain.value = 0.018;
