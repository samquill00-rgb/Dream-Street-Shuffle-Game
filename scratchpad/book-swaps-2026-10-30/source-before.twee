    for (var r = 0; r < 12; r++) s += ray((r * 30 - 90) * Math.PI / 180, 10, r % 4 === 0 ? 15 : 22, 0.35); /* Sol, as at the Dawn and in the NOTEBOOK: twelve rays, the three at 12, 4 and 8 short */
