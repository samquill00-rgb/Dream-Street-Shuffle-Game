  tail.addColorStop(0, 'rgba(210,190,150,0.28)');
  tail.addColorStop(1, 'rgba(180,160,120,0)');
  cx.fillStyle = tail; cx.fillRect(w*0.36, h*0.4, w*0.28, h*0.6);
});
