  // size, so on a retina laptop every edge was doubled into steps. Now a multisampled buffer (WebGL2) and up to 1.5x the
  // pixels; the scenes are light enough since the same day's lighting cuts. A WebGL1 browser keeps the plain buffer.
  var dssPR = Math.min(window.devicePixelRatio || 1, window.innerWidth < 600 ? 1.25 : 1.5), msTarget = null;
  try {
    if (renderer.capabilities && renderer.capabilities.isWebGL2 && THREE.WebGLMultisampleRenderTarget) {
      msTarget = new THREE.WebGLMultisampleRenderTarget(Math.round(window.innerWidth * dssPR), Math.round(window.innerHeight * dssPR), { minFilter: THREE.LinearFilter, magFilter: THREE.LinearFilter, format: THREE.RGBAFormat, stencilBuffer: true }); /* 2026-10-23 overnight (Sam, the French approach twice: "crystaline", "the weird effect in the windows"): r128 gives a multisampled target a 16-bit depth buffer unless it has a stencil too, and 16 bits cannot part the frame, glass and glazing bars 2-3 cm apart at 16 m, so they z-fought into sawtooth frames and dashed bars in every composer scene; with the stencil it is 24-bit (DEPTH24_STENCIL8) */
      msTarget.samples = 4;
    }
  } catch (e) { msTarget = null; }
  var composer = window.dssGuardComposerRender(msTarget ? new THREE.EffectComposer(renderer, msTarget) : new THREE.EffectComposer(renderer), renderer);
  if (composer.setPixelRatio) composer.setPixelRatio(dssPR);
  composer.addPass(new THREE.RenderPass(scene, camera));
  // Bokeh re-renders the whole scene for depth each frame — affordable only
  // in the small interior scenes, so it is opt-in via opts.bokeh
  if (opts.bokeh) {
    composer.addPass(new THREE.BokehPass(scene, camera, {
      focus: opts.focus || 12,
      aperture: opts.aperture || 0.0002,
      maxblur: opts.maxblur || 0.0035,
      width: window.innerWidth, height: window.innerHeight
    }));
  }
  composer.addPass(new THREE.UnrealBloomPass(
    new THREE.Vector2(window.innerWidth, window.innerHeight),
    opts.bloomStrength || 0.3, opts.bloomRadius || 0.5, opts.bloomThreshold || 0.78));
