    var h = cr.height, target = Math.max(h * 0.55, h - over - 6);
    if (target >= h - 2) return;
    var bw = box.getBoundingClientRect().width;
    if (box._dssFit == null) { box._dssFit = { mw: box.style.maxWidth, ml: box.style.marginLeft, mr: box.style.marginRight }; boxes.push(box); }
    box.style.maxWidth = Math.floor(bw * target / h) + 'px'; box.style.marginLeft = 'auto'; box.style.marginRight = 'auto'; settle = Date.now() + 900; /* let the game redraw at the new size before looking again */
    if (c.getBoundingClientRect().height > h - 2) {
