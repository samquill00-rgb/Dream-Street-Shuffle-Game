        mesh(ball,trouser,0,-.36,0,.1,.08,.105,leg);                 // knee
        mesh(taper(.112,.098,.34),gaiter,0,-.54,0,1,1,1,leg);        // gaiter over the shin
        mesh(cyl,strap,0,-.4,0,.114,.018,.114,leg);                  // gaiter top strap
