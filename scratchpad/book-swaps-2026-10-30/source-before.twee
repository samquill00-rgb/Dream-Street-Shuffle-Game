  function watch() {
    poll = setInterval(function() {
      if (!src.isConnected || (gen !== null && window._passageGen !== gen)) { clearInterval(poll); return; }
      /* 2026-10-23 overnight (Sam, playtest at the Ham: "The rumour here overwhelms and distracts from the O'Flatterly quest. Both need
         to be heard, if anything O'Flatterly more"): a quest line on the page (.dss-quest-line) is given 9 s on screen first */
      var ql = document.querySelector('.dss-quest-line');
      if (ql && seen(ql)) { if (!ql._seenAt) ql._seenAt = Date.now(); if (Date.now() - ql._seenAt < 9000) return; } else if (ql && ql.isConnected && ql.getClientRects().length === 0 && !ql.closest('[hidden]')) return;
      if (seen(opener) && !document.querySelector('.dss-slip-fly, .dss-refusal:not(.dss-filed)') && !busy()) { clearInterval(poll); setTimeout(function() { if (!src.isConnected) return; if (busy()) watch(); else show(); }, 1200); } /* after the rejection slip is filed */
    }, 300);
  }
