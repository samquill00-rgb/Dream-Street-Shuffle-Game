  function dust(x,y,n){for(var i=0;i<n;i++)debris.push({x:x,y:y,vx:(Math.random()-.5)*100,vy:-20-Math.random()*90,t:0});}
  var debris=[];

  var hud = document.getElementById('pyr-run-hud');
  var banner = document.getElementById('pyr-run-banner');

  // ── Sam's Mario dials (ported from the bar-game carry phase) ─────
