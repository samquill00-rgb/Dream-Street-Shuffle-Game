};
/* 2026-10-28 (Sam, playtest note 24: the rumour is "a lot", a new arc with too little introduction; ruled: a who's-who sketch, names only,
   beside the card and copied to the NOTEBOOK): gold hairline plates that build with his paragraphs. Stage 1 (his second paragraph):
   SALVU COPPER over QUIET FRANKIE and ASHTON GRANGER; stage 2: the ship, tied to ASHTON; stage 3: the street line over the two of
   them and the cellar round her. Drawn in currentColor so the notebook's ink takes it too. dssRumourSketch(stage) returns the element. */
window.dssRumourSketch = function(stage) {
  var NS = 'http://www.w3.org/2000/svg';
  var w = document.createElement('div'); w.className = 'dss-rumour-sketch'; w.setAttribute('aria-hidden', 'true');
  function plate(x, y, name) { return '<g class="rs-plate"><text x="' + x + '" y="' + y + '" text-anchor="middle">' + name + '</text><line x1="' + (x - 52) + '" y1="' + (y + 7) + '" x2="' + (x + 52) + '" y2="' + (y + 7) + '" class="rs-rule"/></g>'; }
  w.innerHTML = '<svg xmlns="' + NS + '" viewBox="0 0 300 300" role="img">' +
    '<g class="rs-g rs-1">' + plate(150, 34, 'SALVU COPPER') +
      '<path class="rs-line" d="M140 46 L82 134"/><path class="rs-line rs-dash" d="M120 166 Q150 184 180 166"/>' +
      plate(72, 150, 'QUIET FRANKIE') + plate(228, 150, 'ASHTON GRANGER') + '</g>' +
    '<g class="rs-g rs-2"><path class="rs-line rs-dash" d="M228 170 L228 222"/>' +
      '<path class="rs-line" d="M202 246 L254 246 L246 258 L210 258 Z"/><path class="rs-line" d="M228 246 L228 224"/><path class="rs-line" d="M228 226 L243 241 L228 241"/>' +
      '<path class="rs-line rs-faint" d="M182 268 q8 -5 16 0 t16 0 t16 0 t16 0 t16 0 t16 0"/><path class="rs-line rs-faint" d="M190 280 q8 -5 16 0 t16 0 t16 0 t16 0 t16 0"/></g>' +
    '<g class="rs-g rs-3"><path class="rs-line" d="M14 104 L286 104"/><path class="rs-line rs-faint" d="M26 110 l6 -6 M46 110 l6 -6 M66 110 l6 -6 M86 110 l6 -6 M186 110 l6 -6 M206 110 l6 -6 M226 110 l6 -6 M246 110 l6 -6 M266 110 l6 -6"/>' +
      '<rect class="rs-line" x="160" y="126" width="136" height="40" rx="1"/></g>' +
    '</svg>';
  w.setStage = function(n) { for (var k = 1; k <= 3; k++) { var g = w.querySelector('.rs-' + k); if (g) g.classList.toggle('on', n >= k); } };
  w.setStage(stage || 0);
