/* slabs and kerbs at true size on every run (the old repeats stretched them into long strips), then the muck the street collects */
[[greekPaveW, 'z'], [greekPaveE, 'z'], [romPaveN, 'x'], [romPaveS, 'x'], [cornerPave, 'x']].forEach(function(p) { chBoxUV(p[0], p[1], 1 / 2.4, 1 / 2.4); });
[[greekKerbW, 'z'], [greekKerbE, 'z'], [romKerbN, 'x'], [romKerbS, 'x']].forEach(function(p) { chBoxUV(p[0], p[1], 1 / 3.6, 1 / 0.36); });
(function() {
  /* one strip texture, dark and wet at its top edge, for the gutters and for the foot of the walls: leaves, dog-ends, scraps of paper */
  var gc = document.createElement('canvas'); gc.width = 1024; gc.height = 96;
  var g = gc.getContext('2d'), i;
  for (i = 0; i < 420; i++) {
    var gx = chRand(0, 1024), gl = chRand(0.25, 0.85) * 96, gs = g.createLinearGradient(0, 0, 0, gl);
    gs.addColorStop(0, 'rgba(10,8,6,' + chRand(0.35, 0.7).toFixed(2) + ')'); gs.addColorStop(1, 'rgba(10,8,6,0)');
    g.fillStyle = gs; g.fillRect(gx, 0, chRand(3, 14), gl);
  }
  for (i = 0; i < 40; i++) { g.fillStyle = 'rgba(' + Math.floor(chRand(70, 110)) + ',' + Math.floor(chRand(45, 66)) + ',22,' + chRand(0.5, 0.85).toFixed(2) + ')'; g.beginPath(); g.ellipse(chRand(0, 1024), chRand(4, 40), chRand(4, 9), chRand(2, 4), chRand(0, 3), 0, Math.PI * 2); g.fill(); }
  for (i = 0; i < 26; i++) { var fx = chRand(0, 1024), fy = chRand(6, 60), fa = chRand(0, 3); g.save(); g.translate(fx, fy); g.rotate(fa); g.fillStyle = 'rgba(205,190,160,0.8)'; g.fillRect(-5, -1.3, 8, 2.6); g.fillStyle = 'rgba(176,120,60,0.9)'; g.fillRect(3, -1.3, 3, 2.6); g.restore(); }
  for (i = 0; i < 9; i++) {
    var px = chRand(0, 1024), py = chRand(10, 60), pr = chRand(7, 15);
    g.beginPath(); for (var v = 0; v < 8; v++) { var a = v / 8 * Math.PI * 2, rr = pr * chRand(0.55, 1.2); g[v ? 'lineTo' : 'moveTo'](px + Math.cos(a) * rr, py + Math.sin(a) * rr * 0.6); } g.closePath();
    g.fillStyle = 'rgba(178,170,150,0.72)'; g.fill(); g.strokeStyle = 'rgba(70,62,50,0.6)'; g.lineWidth = 1; g.stroke();
  }
  var gt = new THREE.CanvasTexture(gc); gt.wrapS = THREE.RepeatWrapping;
  function strip(len, x, y, z, rz) {
    var t = gt.clone(); t.needsUpdate = true; t.repeat.set(len / 3, 1);
    var m = new THREE.Mesh(new THREE.PlaneGeometry(len, 0.5), new THREE.MeshStandardMaterial({ map: t, transparent: true, depthWrite: false, roughness: 0.35, metalness: 0.15, polygonOffset: true, polygonOffsetFactor: -2 }));
    m.rotation.set(-Math.PI / 2, 0, rz); m.position.set(x, y, z); m.userData.noShadow = true; scene.add(m); return m;
  }
  strip(30, 2.83, 0.014, -5, Math.PI / 2);
  strip(30, 6.17, 0.014, -5, -Math.PI / 2);
  strip(25, -10, 0.014, 2.83, 0);
  strip(25, -10, 0.014, 6.17, Math.PI);
  strip(20, 0.42, 0.153, -10, Math.PI / 2);
  strip(23, -11.5, 0.153, 0.42, 0);
  /* a few things dropped and trodden flat: chip paper, a cigarette packet, a sodden page of newspaper */
  var lc = document.createElement('canvas'); lc.width = 192; lc.height = 64; var l = lc.getContext('2d');
  l.fillStyle = 'rgba(196,188,166,0.92)'; l.beginPath(); l.moveTo(6, 14); l.lineTo(50, 6); l.lineTo(58, 40); l.lineTo(34, 58); l.lineTo(8, 48); l.closePath(); l.fill();
  l.fillStyle = 'rgba(150,120,60,0.35)'; l.beginPath(); l.ellipse(30, 32, 14, 10, 0.4, 0, Math.PI * 2); l.fill();
  l.fillStyle = 'rgba(150,40,34,0.9)'; l.fillRect(80, 18, 34, 26); l.fillStyle = 'rgba(214,206,186,0.85)'; l.fillRect(80, 18, 34, 8);
  l.fillStyle = 'rgba(158,154,140,0.85)'; l.fillRect(136, 6, 50, 52);
  l.fillStyle = 'rgba(60,58,52,0.45)'; for (var r = 10; r < 54; r += 4) { l.fillRect(140, r, 20, 1.5); l.fillRect(164, r, 18, 1.5); }
  l.fillStyle = 'rgba(30,28,24,0.3)'; l.fillRect(136, 30, 50, 28);
  var litter = [[0, 1.7, 0.153, -0.7, 0.4], [1, 3.05, 0.016, 2.2, 1.1], [2, 7.3, 0.153, 3.6, -0.5], [0, 6.0, 0.016, 7.4, 2.0], [1, 1.9, 0.153, -6.2, 0.3], [2, -2.6, 0.153, 1.9, 1.7]];
  litter.forEach(function(it) {
    var t = new THREE.CanvasTexture(lc); t.repeat.set(1 / 3, 1); t.offset.set(it[0] / 3, 0);
    var sz = it[0] === 2 ? 0.42 : it[0] === 1 ? 0.12 : 0.26;
    var m = new THREE.Mesh(new THREE.PlaneGeometry(sz, sz * (it[0] === 1 ? 0.75 : 1)), new THREE.MeshStandardMaterial({ map: t, transparent: true, depthWrite: false, roughness: 0.9, polygonOffset: true, polygonOffsetFactor: -3 }));
    m.rotation.set(-Math.PI / 2, 0, it[4]); m.position.set(it[1], it[2] + 0.002, it[3]); m.userData.noShadow = true; scene.add(m);
  });
})();

// ============================================================
// STREETLAMPS
// ============================================================
// Toolkit Victorian gas lamps — decay 2 + generous range so the pool of
// light dies naturally instead of terminating in a line across the road
// (memory: project_light_range_terminator.md).
var lampLights = [];
function createLamp(x, z, castsShadow) {
  if (chKit && chKit.createVictorianGasLamp) {
    var lamp = chKit.createVictorianGasLamp(scene, x, z, { intensity: 2.2, distance: 30, haloScale: 2.6 });
    // Only the near lamp pays for a shadow map — four shadow-casting
    // lights (3 lamps + moon) is silent frame cost for no visible gain
    if (lamp.userData.light) lamp.userData.light.castShadow = !!castsShadow;
    // The toolkit lantern's side panes are single-sided planes with inward
    // normals — from a three-quarter camera the lantern reads unlit. Render
    // both faces, brighten the halo, and seat a solid emissive glass core
    // inside the cage so the head reads lit from every angle and distance.
    lamp.traverse(function(o) {
      if (o.material && o.material.isMeshBasicMaterial) o.material.side = THREE.DoubleSide;
      if (o.isSprite) {
        // Additive blending: the glow sums over the dark scene instead of
        // alpha-mixing into it — this is what makes the mantle read as LIGHT
        o.material.blending = THREE.AdditiveBlending;
        o.material.opacity = Math.min(1, o.material.opacity + 0.25);
      }
    });
    var lampCore = new THREE.Mesh(
      new THREE.BoxGeometry(0.24, 0.38, 0.24),
      new THREE.MeshBasicMaterial({ color: 0xffe6b0 })
    );
    lampCore.position.set(0, 5.16, 0);
    lampCore.userData.noShadow = true;
    lamp.add(lampCore);
    if (lamp.userData.light) {
      lamp.userData.light.decay = 2;
      lampLights.push(lamp.userData.light);
    }
    return;
  }
  var light = new THREE.PointLight(0xffdda0, 0.6, 15);
  light.position.set(x, 4.8, z);
  scene.add(light);
  lampLights.push(light);
}

createLamp(1, 1);
createLamp(1, -8);
createLamp(7, 4, true);

// ============================================================
// LIGHTING — low ambient + cold moonlight casting real shadows on the street
// ============================================================
scene.add(new THREE.AmbientLight(0x1a1a2a, 0.30)); // was 0.20 — the corner was reading as void

var moonLight = new THREE.DirectionalLight(0x6a78b8, 0.38);
moonLight.position.set(10, 22, -4);
moonLight.target.position.set(0, 3, 0);
scene.add(moonLight.target);
moonLight.castShadow = true;
moonLight.shadow.mapSize.width = 2048;
moonLight.shadow.mapSize.height = 2048;
moonLight.shadow.camera.near = 0.5;
moonLight.shadow.camera.far = 60;
moonLight.shadow.camera.left = -20;
moonLight.shadow.camera.right = 20;
moonLight.shadow.camera.top = 20;
moonLight.shadow.camera.bottom = -5;
moonLight.shadow.bias = -0.0008;
moonLight.shadow.normalBias = 0.04;
scene.add(moonLight);

function enableChSceneShadows(root) {
  root.traverse(function(obj) {
    if (!(obj instanceof THREE.Mesh)) return;
    if (obj.userData.noShadow) return;
    var mat = obj.material;
    if (mat && (mat.transparent === true && (mat.opacity || 1) < 0.7)) return;
    obj.receiveShadow = true;
    if (obj.position.y > 0.2 || (obj.geometry && obj.geometry.type !== 'PlaneGeometry')) {
      obj.castShadow = true;
    }
  });
}
setTimeout(function() { enableChSceneShadows(scene); }, 0);

// Warm interior glow spilling from the pub windows. These sit OUTSIDE the
// facade slabs — a light buried inside the building body faces the back of
// the facade and never reaches the street.
var pubGlow1 = new THREE.PointLight(0xc89030, 2.6, 18);
pubGlow1.decay = 2;
pubGlow1.position.set(1.1, 2.0, -2.5);
scene.add(pubGlow1);
var pubGlow2 = new THREE.PointLight(0xc89030, 2.4, 18);
pubGlow2.decay = 2;
pubGlow2.position.set(-4.0, 2.0, 1.1);
scene.add(pubGlow2);

// ============================================================
// FOG VOLUMES — thick Soho pea-souper atmosphere
// ============================================================

// Shared fog textures (create once, reuse)
var thickFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
grad.addColorStop(0, 'rgba(180, 170, 155, 0.25)');
grad.addColorStop(0.4, 'rgba(150, 140, 130, 0.12)');
grad.addColorStop(1, 'rgba(120, 110, 100, 0)');
cx.fillStyle = grad;
cx.fillRect(0, 0, w, h);
});
var thinFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
grad.addColorStop(0, 'rgba(140, 135, 125, 0.15)');
grad.addColorStop(0.6, 'rgba(120, 115, 105, 0.06)');
grad.addColorStop(1, 'rgba(100, 95, 85, 0)');
cx.fillStyle = grad;
cx.fillRect(0, 0, w, h);
});
var warmFogTex = makeCanvasTexture(128, 128, function(cx, w, h) {
var grad = cx.createRadialGradient(w/2, h/2, 0, w/2, h/2, w/2);
grad.addColorStop(0, 'rgba(200, 160, 100, 0.12)');
grad.addColorStop(0.5, 'rgba(180, 140, 80, 0.05)');
grad.addColorStop(1, 'rgba(150, 120, 60, 0)');
cx.fillStyle = grad;
cx.fillRect(0, 0, w, h);
});

var fogSprites = [];

// LAYER 1: Thick ground-hugging fog banks (the main pea-souper)
for (var i = 0; i < 50; i++) {
var fogMat = new THREE.SpriteMaterial({
map: thickFogTex, transparent: true,
opacity: 0.25 + Math.random() * 0.2
});
var fogSprite = new THREE.Sprite(fogMat);
fogSprite.position.set(
Math.random() * 50 - 20,
0.3 + Math.random() * 2,
Math.random() * 50 - 20
);
var s = 5 + Math.random() * 12;
fogSprite.scale.set(s, s * 0.35, 1);
scene.add(fogSprite);
fogSprites.push({
sprite: fogSprite,
baseX: fogSprite.position.x,
drift: 0.002 + Math.random() * 0.006,
sway: Math.random() * Math.PI * 2,
swaySpeed: 0.001 + Math.random() * 0.004,
swayAmt: 0.4 + Math.random() * 1.0
});
}

// LAYER 2: Mid-height fog (swirling around building level)
for (var i = 0; i < 30; i++) {
var midFogMat = new THREE.SpriteMaterial({
map: thinFogTex, transparent: true,
opacity: 0.07 + Math.random() * 0.08 // was 0.15-0.30 — stacked wisps in the camera corridor were washing the gas lamps out to dead grey
});
var midFog = new THREE.Sprite(midFogMat);
midFog.position.set(
Math.random() * 40 - 15,
2 + Math.random() * 6,
Math.random() * 40 - 15
);
var ms = 6 + Math.random() * 14;
midFog.scale.set(ms, ms * 0.3, 1);
scene.add(midFog);
fogSprites.push({
sprite: midFog,
baseX: midFog.position.x,
drift: 0.004 + Math.random() * 0.008,
sway: Math.random() * Math.PI * 2,
swaySpeed: 0.002 + Math.random() * 0.006,
swayAmt: 0.5 + Math.random() * 1.5
});
}

// LAYER 3: Warm-tinted fog near the pub (light spilling into mist)
for (var i = 0; i < 15; i++) {
var warmFogMat = new THREE.SpriteMaterial({
map: warmFogTex, transparent: true,
opacity: 0.2 + Math.random() * 0.15
});
var warmFog = new THREE.Sprite(warmFogMat);
warmFog.position.set(
Math.random() * 10 - 3,
0.5 + Math.random() * 3,
Math.random() * 10 - 3
);
var ws = 3 + Math.random() * 6;
warmFog.scale.set(ws, ws * 0.4, 1);
scene.add(warmFog);
fogSprites.push({
sprite: warmFog,
baseX: warmFog.position.x,
drift: 0.003 + Math.random() * 0.005,
sway: Math.random() * Math.PI * 2,
swaySpeed: 0.002 + Math.random() * 0.005,
swayAmt: 0.3 + Math.random() * 0.6
});
}

// LAYER 4: High wisps drifting past the rooftops
for (var i = 0; i < 20; i++) {
var wispMat = new THREE.SpriteMaterial({
map: thinFogTex, transparent: true,
opacity: 0.1 + Math.random() * 0.1
});
var wisp = new THREE.Sprite(wispMat);
wisp.position.set(
Math.random() * 40 - 15,
6 + Math.random() * 8,
Math.random() * 40 - 15
);
wisp.scale.set(8 + Math.random() * 15, 3 + Math.random() * 4, 1);
scene.add(wisp);
fogSprites.push({
sprite: wisp,
baseX: wisp.position.x,
drift: 0.006 + Math.random() * 0.012,
sway: Math.random() * Math.PI * 2,
swaySpeed: 0.003 + Math.random() * 0.008,
swayAmt: 0.8 + Math.random() * 2.0
});
}

// ============================================================
// PUDDLES (post-rain, wet ground)
// ============================================================
// Reuse three existing puddles for broken window colour and a premature ember.
var chWaterTex=makeCanvasTexture(64,128,function(cx,w,h){
  for(var ri=0;ri<42;ri++){var v=ri/42,fade=Math.sin(v*Math.PI),width=(12+(ri%5)*5)*fade;
    cx.fillStyle='rgba(239,189,118,'+(.12+(ri%4)*.05)*fade+')';cx.fillRect((w-width)/2+Math.sin(ri*.8)*3,v*h,width,1+(ri%2));}
});
var chWaterMats=[],chEmberWater;
var chPuddleAlpha=makeCanvasTexture(128,128,function(cx,w,h){cx.fillStyle='#000';cx.fillRect(0,0,w,h);for(var b=0;b<9;b++){var x=w/2+chRand(-28,28),y=h/2+chRand(-28,28),r=chRand(16,36),g=cx.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,'rgba(255,255,255,0.9)');g.addColorStop(.7,'rgba(255,255,255,0.5)');g.addColorStop(1,'rgba(255,255,255,0)');cx.fillStyle=g;cx.fillRect(x-r,y-r,2*r,2*r);}});

for (var i = 0; i < 8; i++) {
var puddleMat = new THREE.MeshStandardMaterial({
color: 0x111118, roughness: 0.1, metalness: 0.6, transparent: true, opacity: 0.3
});
var puddle = new THREE.Mesh(new THREE.CircleGeometry(0.4 + Math.random() * 0.8, 16), puddleMat);
puddle.rotation.x = -Math.PI / 2;
puddle.position.set(
Math.random() * 16 - 4,
0.02,
Math.random() * 16 - 4
);
if(i===0){
  puddle.material.dispose();puddle.material=new THREE.MeshBasicMaterial({map:emberTex,color:0xc79063,transparent:true,opacity:.075,depthWrite:false,blending:THREE.AdditiveBlending});
  puddle.position.set(1.15,.023,-3.65);puddle.scale.set(.3,.7,1);chEmberWater=puddle;
}else if(i<3){
  puddle.material.dispose();puddle.material=new THREE.MeshBasicMaterial({map:chWaterTex,color:0xe3ba83,transparent:true,opacity:.23,depthWrite:false,blending:THREE.AdditiveBlending});
  puddle.position.set(i===1?2.1:-3.7,.024,i===1?-1.8:2.0);puddle.scale.set(.85,1.9,1);if(i===2)puddle.rotation.z=Math.PI/2;
  chWaterMats.push(puddle.material);
}else{puddle.material.depthWrite=false;puddle.material.alphaMap=chPuddleAlpha;puddle.material.opacity=.42;puddle.material.roughness=.06;puddle.scale.set(chRand(.8,1.6),chRand(.6,1.1),1);puddle.rotation.z=chRand(0,Math.PI);} /* ragged edges, not discs */
scene.add(puddle);
}

// ============================================================
// ANIMATION
// ============================================================
var clock = new THREE.Clock();
var chLastT = 0;
var firePanes=[];
if(chIsFire){chFireWindows.concat(chFireUpper).forEach(function(m){pub.traverse(function(o){if(o.material===m)firePanes.push(o);});});signMat.color.setHex(0x080b10);}
var chFireFX=chIsFire?makeCoachFire(scene,pub,firePanes):null;
if(chIsFire){drinker.visible=false;ember.visible=false;silhouettes.forEach(function(s){s.mesh.visible=false;});cigWisps.forEach(function(w){w.sprite.visible=false;});}


function chAnimate() {
chAnimId = requestAnimationFrame(chAnimate);
var t = chStill?0:clock.getElapsedTime();
var dt = Math.min(t - chLastT, 0.1);
chLastT = t;

// Very subtle light breathing (barely perceptible)
var breath = 0.97 + Math.sin(t * 0.4) * 0.03;
doorLight.intensity = 0.8 * breath;
pubGlow1.intensity = 2.6 * breath;
pubGlow2.intensity = 2.4 * (.97+Math.sin(t*.4-.7)*.03);
warmGlass.emissiveIntensity=.8+Math.sin(t*.4-.4)*.012;
lantern1.intensity = 0.55 * (0.97 + Math.sin(t * .57) * 0.025);
lantern2.intensity = 0.55 * (0.97 + Math.sin(t * .63 + 1.4) * 0.025);

// Gas mantle flicker — irregular, per-lamp phase
for (var i = 0; i < lampLights.length; i++) {
var lamp = lampLights[i];
if (lamp.userData.chBase === undefined) lamp.userData.chBase = lamp.intensity;
var lf = .96
  + Math.sin(t*.39+i*2.1)*.018
  + Math.sin(t*.83+i)*.01
  + Math.sin(t*1.37+i*3.3)*.004;
lamp.intensity = lamp.userData.chBase * lf;
}

// The drinker's cigarette: ember flares on the drag, smoke rises steadily
emberState.nextFlare -= dt;
if (emberState.nextFlare <= 0 && emberState.flareT < 0) {
emberState.flareT = 0;
emberState.nextFlare = 7 + Math.random() * 7;
}
if (emberState.flareT >= 0) {
emberState.flareT += dt;
var ef = emberState.flareT;
if (ef < 1.6) {
var ek = ef < 0.5 ? ef / 0.5 : Math.max(0, 1 - (ef - 0.5) / 1.1);
ember.material.opacity = 0.35 + ek * 0.6;
var es = 0.06 + ek * 0.05;
ember.scale.set(es, es, 1);
} else {
emberState.flareT = -1;
ember.material.opacity = 0.35;
ember.scale.set(0.06, 0.06, 1);
}
}
for (var i = 0; i < cigWisps.length; i++) {
var cwp = cigWisps[i];
cwp.age += dt;
if (cwp.age > cwp.life) cwp.age = 0;
var wa = cwp.age / cwp.life;
cwp.sprite.position.y = 1.75 + wa * 0.9;
cwp.sprite.position.z = -4.11 + Math.sin(cwp.phase + t * .35) * .14 * wa;
cwp.sprite.position.x = .58+wa*.1+Math.sin(cwp.phase+t*.3)*.08*wa;
var ws = 0.1 + wa * 0.32;
cwp.sprite.scale.set(ws, ws, 1);
cwp.sprite.material.opacity = (wa < 0.15 ? wa / 0.15 : 1 - (wa - 0.15) / 0.85) * 0.3;
}

// Silhouettes sway gently
for (var i = 0; i < silhouettes.length; i++) {
var s = silhouettes[i];
s.swayPhase += s.swaySpeed * dt * .48;
var swayOffset = Math.sin(s.swayPhase) * s.swayAmt * 0.5;
s.mesh.position.y = 1.8 + Math.sin(s.swayPhase * 0.7) * 0.005;
if (s.mesh.rotation.y > 1) {
s.mesh.position.z = s.baseZ + swayOffset;
} else {
s.mesh.position.x = s.baseX + swayOffset;
}
}

// A small reflection takes the drag a second before the smoker does.
var chPremonition=!chStill && emberState.flareT<0 && emberState.nextFlare<1.25?Math.sin(Math.max(0,emberState.nextFlare)/1.25*Math.PI):0;
chEmberWater.material.opacity=.075+chPremonition*.07;
chWaterTex.offset.x=Math.sin(t*.23)*.007;
for(var wi=0;wi<chWaterMats.length;wi++)chWaterMats[wi].opacity=.23+Math.sin(t*.4-wi*.7)*.01;

// Film grain
chGrainFrame++;
if (chGrainFrame===1 || (!chStill && chGrainFrame % 18 === 0)) {
var imgData = chGrainCtx.createImageData(256, 256);
var d = imgData.data;
for (var i = 0; i < d.length; i += 4) {
var v = Math.random() * 255;
d[i] = d[i+1] = d[i+2] = v;
d[i+3] = 255;
}
chGrainCtx.putImageData(imgData, 0, 0);
}

if(chFireFX){var ft=chStill?chFireTune.stillTime:t;chFireFX(ft);doorLight.intensity=.08;pubGlow1.intensity=.35*Math.exp(-ft/(20*chFireTune.pace));pubGlow2.intensity=.28*Math.exp(-ft/(20*chFireTune.pace));warmGlass.emissive.setHex(0x873b27);warmGlass.emissiveIntensity=.18*Math.exp(-ft/(20*chFireTune.pace));chEmberWater.material.opacity=0;
  chWaterMats.forEach(function(m,i){m.color.setHex(0xaab8c7).lerp(new THREE.Color(0xb68b60),Math.exp(-ft/(9*chFireTune.pace)));m.opacity=.025+.19*Math.exp(-ft/((8+i*3)*chFireTune.pace));});}
if (typeof dssComposerLocal !== 'undefined' && dssComposerLocal) { dssComposerLocal.render(); } else { renderer.render(scene, camera); }
}

chAnimate();

// ENTER BUTTON
var chBtn = document.createElement('button');
var chFireExit=document.querySelector('tw-passage [data-coach-fire-end] tw-link');
chBtn.textContent = chIsFire&&chFireExit?chFireExit.textContent:'ENTER THE COACH AND HORSES';
if(chIsFire)chBtn.className='claude-draft';
var chLocked=!chIsFire&&!!document.querySelector('tw-passage [data-coach-locked]');
chBtn.style.cssText = [
'position:absolute','bottom:60px','left:50%','transform:translateX(-50%)',
'font:13px \'Courier New\',monospace','color:rgba(200,170,100,0.85)',
'letter-spacing:4px','cursor:pointer','padding:12px 28px',
'border:1px solid rgba(200,170,100,0.3)','background:rgba(0,0,0,0.4)',
'z-index:9003','white-space:nowrap','opacity:0','transition:opacity 1.5s ease'
].join(';');
if(chLocked)chBtn.style.display='none';
chWrap.appendChild(chBtn);
if(chIsFire){
  chBtn.style.color='#ed87ba';chBtn.style.letterSpacing='1px';
  var copy=document.querySelector('tw-passage [data-coach-fire-copy]'),card=document.createElement('div');card.textContent=copy?copy.textContent:'';
  card.style.cssText='position:absolute;bottom:125px;left:50%;transform:translateX(-50%);width:min(580px,85vw);padding:18px;color:#e8e2d2;background:#10151ae0;border-top:1px solid #9c839166;font:17px/1.5 Georgia,serif;z-index:9003;opacity:0;transition:opacity 2s ease';chWrap.appendChild(card);
  // 2026-10-08 (Sam): 'It is done. The blackout falls': no button. The line comes up with the fire, holds, then the scene goes dark and presses the parked link to the Fetch.
  chBtn.style.display='none';setTimeout(function(){card.style.opacity='1';},2500);
  setTimeout(function(){if(!chFireExit||!document.body.contains(chWrap))return;try{window.dssFireTrace(renderer,function(){if(dssComposerLocal)dssComposerLocal.render();else renderer.render(scene,camera);},chFireTune.exitFade);}catch(e){}chFireExit.click();},(chFireTune.stillTime+4)*1000);
} else {
  var waitSrc=document.querySelector('tw-passage [data-coach-wait]');if(chLocked&&waitSrc){var wcard=document.createElement('div');wcard.innerHTML=waitSrc.innerHTML; /* 2026-10-20: the passage's paragraph breaks come across (was textContent) */wcard.style.cssText='position:absolute;bottom:125px;left:50%;transform:translateX(-50%);width:min(580px,85vw);padding:18px;color:#e8e2d2;background:#10151ae0;border-top:1px solid #9c839166;font:17px/1.5 Georgia,serif;z-index:9003';chWrap.appendChild(wcard);}
  ['start','leave'].forEach(function(kind,i){var native=document.querySelector('tw-passage [data-coach-fire-'+kind+'] tw-link');if(!native)return;var alt=document.createElement('button');alt.type='button';alt.dataset.coachAction=kind;alt.textContent=native.textContent;alt.style.cssText='position:absolute;bottom:'+(112+i*42)+'px;left:50%;transform:translateX(-50%);max-width:92vw;z-index:9004;padding:10px 24px;color:rgba(230,200,120,0.95);background:rgba(0,0,0,0.5);border:1px solid rgba(200,170,100,0.5);font:13px Courier New,monospace;letter-spacing:3px;cursor:pointer';alt.onclick=function(){native.click();};chWrap.appendChild(alt);});
}

setTimeout(function() { chBtn.style.opacity = '1'; }, 1500);

chBtn.addEventListener('mouseenter', function() {
if(chIsFire)return;
this.style.color = 'rgba(230,200,120,0.95)';
this.style.borderColor = 'rgba(200,170,100,0.6)';
});
chBtn.addEventListener('mouseleave', function() {
if(chIsFire)return;
this.style.color = 'rgba(200,170,100,0.85)';
this.style.borderColor = 'rgba(200,170,100,0.3)';
});

chBtn.addEventListener('click', function() {
if(chIsFire){if(chFireExit){window.dssFireTrace(renderer,function(){if(dssComposerLocal)dssComposerLocal.render();else renderer.render(scene,camera);},chFireTune.exitFade);chFireExit.click();}return;}
chWrap.style.transition = 'opacity 1.2s ease';
chWrap.style.opacity = '0';
setTimeout(function() {
cancelAnimationFrame(chAnimId);
chWrap.remove();
var TARGET = 'Coach and Horses lock';
var link = document.querySelector('tw-link[passage-name="' + TARGET + '"]');
if (!link) {
var allLinks = document.querySelectorAll('tw-passage tw-link');
for (var i = 0; i < allLinks.length; i++) {
if (allLinks[i].textContent.trim() === '\u00B7') { link = allLinks[i]; break; }
}
}
if (link) {
link.click();
} else {
var storyEl = document.querySelector('tw-story') || document.body;
var injected = document.createElement('tw-link');
injected.setAttribute('passage-name', TARGET);
injected.style.display = 'none';
storyEl.appendChild(injected);
injected.click();
storyEl.removeChild(injected);
}
}, 1200);
});
}

// Watch for ch-container. Cleanup mirrors Pillars/Lackland: when the
// container disappears (passage change), cancel the animate loop and
// remove the body-appended wrap so the canvas + listeners don't leak.
setInterval(function() {
var container = document.querySelector('tw-passage #ch-container');
if(container!==chHost){
  if(chAnimId){cancelAnimationFrame(chAnimId);chAnimId=null;}
  if(chDisposeExtra){chDisposeExtra();chDisposeExtra=null;}
  window._dssDisposeWrap('ch-wrap');chActive=false;chHost=container;
}
if(container&&!chActive)initCoachHorses();
}, 300);
})();

// ====== PILLARS OF HERCULES SCENE — INLINE ======
(function() {
var phActive = false;
var phAnimId = null;
// Flood escalation state — lives in this closure, so it survives scene
// rebuilds within a session (page reload falls back to visit 1; accepted).
var phVisit = 0;   // which visit this session
var phCarryT = 0;  // flood-seconds carried across visits (never resets)
var phThisT = 0;   // this visit's elapsed scene time
var phLeftAt = 0;  // wall-clock at last leave — the flood rises while away

function initPillars() {
if (phActive) return;
phActive = true;
// ?phvisit=N in the URL overrides for testing (also seeds a grown flood)
var phVisitOverride = window.DSS_DEV ? ((function(){ var m = location.search.match(/phvisit=(\d+)/); return m ? +m[1] : 0; })() || window.DSS_PH_VISIT_OVERRIDE || (+(localStorage.getItem('dssPhVisitOverride') || 0)) || 0) : 0;
phVisit = phVisitOverride || phVisit + 1;
if (phVisitOverride > 1 && phCarryT === 0) phCarryT = 40 + (phVisitOverride - 2) * 180;
if (phLeftAt) phCarryT += Math.min((Date.now() - phLeftAt) / 1000 * 0.4, 80);
if (typeof THREE === 'undefined') {
var s = document.createElement('script');
s.src = 'vendor/three/three.min.js';
s.onload = function() { (window.dssLoadPost ? window.dssLoadPost(buildPHScene) : buildPHScene()); };
document.head.appendChild(s);
} else {
(window.dssLoadPost ? window.dssLoadPost(buildPHScene) : buildPHScene());
}
}

function buildPHScene() {
// Reduced-motion: the scene renders one settled frame (flood at ~14s) and holds it.
var phStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
// Create full-screen overlay wrapper
var phWrap = document.createElement('div');
phWrap.id = 'ph-wrap';
phWrap.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:9000;background:#0a0a12;overflow:hidden;';

// ============================================================
// SCENE SETUP
// ============================================================
var scene = new THREE.Scene();
var exterior=window.dssExteriorDetail(scene);
scene.background = new THREE.Color(0x16161f);
scene.fog = new THREE.Fog(0x16161f, 5, 40);

var camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 200);

// ============================================================
// LAYOUT EXPLANATION
// ============================================================
// The Pillars of Hercules faces the camera straight on.
// Facade runs along X (roughly x=-4 to x=4), facing +Z.
// Camera is at +Z looking back at the building.
// Alleyway is on the LEFT side (negative X).
// Neighbouring buildings: cream/yellow to left of alley, pink/brown to right.
// Building body extends into -Z (behind facade).

// Tilted down and stepped back a touch (2026-09-14, Sam: "now the Pillars is
// zoomed in you don't see the flooding street"). The drain and its pool sit at
// (2.2, 0, 6.4) — from the old framing they were ~42 degrees below the camera
// axis, well outside a 55-degree frame, so the flood was being played out off
// screen. Do not pull BACK to fix this: the fog is near 5 / far 40 and the
// facade goes flat long before it helps. Tilt, don't retreat.
camera.position.set(2.1, 3.9, 12.0);
camera.lookAt(0, 2.6, 2.5);

var renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping || THREE.LinearToneMapping;
renderer.toneMappingExposure = 0.55;
phWrap.appendChild(renderer.domElement);
window._dssBindScene('ph-wrap', scene, renderer, camera);
var dssComposerLocal = window.dssMakeComposer ? window.dssMakeComposer(scene, camera, renderer, { focus: 14 }) : null;
if (window.dssFilmGrade) window.dssFilmGrade(document.getElementById('ph-wrap'));

// ============================================================
// MATERIALS
// ============================================================
var darkTimber = new THREE.MeshStandardMaterial({ color: 0x2a2018, roughness: 0.92 });
// Weathered stucco — cream base with hairline cracks, nicotine
// yellowing, soot streaks from gutters/windows, damp patches,
// minor paint repairs. Drawn before whitePlaster is declared so it
// becomes the new base material for the pub facade.
var plasterTex = makeCanvasTexture(512, 512, function(cx, w, h) {
  cx.fillStyle = '#c8b89a'; cx.fillRect(0, 0, w, h);
  // Subtle uneven base tone (rendering rough surface variation)
  for (var pp = 0; pp < 350; pp++) {
    var b = 180 + Math.floor(Math.random() * 30);
    cx.fillStyle = 'rgba(' + b + ',' + (b - 18) + ',' + (b - 32) + ',0.12)';
    cx.beginPath();
    cx.ellipse(Math.random() * w, Math.random() * h,
      6 + Math.random() * 24, 4 + Math.random() * 14, Math.random() * Math.PI, 0, Math.PI * 2);
    cx.fill();
  }
  // Nicotine wash — yellowish stain pooling lower (smokers' Soho)
  var nicoG = cx.createLinearGradient(0, h * 0.35, 0, h);
  nicoG.addColorStop(0, 'rgba(170, 145, 80, 0)');
  nicoG.addColorStop(0.6, 'rgba(170, 145, 80, 0.2)');
  nicoG.addColorStop(1, 'rgba(150, 120, 55, 0.34)');
  cx.fillStyle = nicoG; cx.fillRect(0, h * 0.35, w, h * 0.65);
  // Soot streaks running down from the cornice/eaves
  for (var ss = 0; ss < 11; ss++) {
    var sx = Math.random() * w;
    var sxw = 10 + Math.random() * 30;
    var sg = cx.createLinearGradient(sx, 0, sx, h);
    sg.addColorStop(0, 'rgba(15, 12, 8, 0.62)');
    sg.addColorStop(0.4, 'rgba(20, 16, 10, 0.3)');
    sg.addColorStop(0.85, 'rgba(25, 20, 12, 0.12)');
    sg.addColorStop(1, 'rgba(25, 20, 12, 0)');
    cx.fillStyle = sg;
    cx.fillRect(sx - sxw / 2, 0, sxw, h);
  }
  // Damp / green patches near the base
  for (var d = 0; d < 7; d++) {
    var dx = Math.random() * w;
    var dy = h * 0.6 + Math.random() * h * 0.4;
    var dr = 32 + Math.random() * 60;
    var dg2 = cx.createRadialGradient(dx, dy, 0, dx, dy, dr);
    dg2.addColorStop(0, 'rgba(70, 80, 55, 0.42)');
    dg2.addColorStop(0.5, 'rgba(55, 65, 45, 0.2)');
    dg2.addColorStop(1, 'rgba(40, 50, 40, 0)');
    cx.fillStyle = dg2; cx.fillRect(dx - dr, dy - dr, dr * 2, dr * 2);
  }
  // General mottled filth
  for (var mg = 0; mg < 14; mg++) {
    cx.fillStyle = 'rgba(35, 28, 18, ' + (0.05 + Math.random() * 0.09).toFixed(3) + ')';
    cx.beginPath();
    cx.ellipse(Math.random() * w, Math.random() * h,
      12 + Math.random() * 35, 8 + Math.random() * 20, Math.random() * Math.PI, 0, Math.PI * 2);
    cx.fill();
  }
  // Hairline cracks (random forks)
  cx.strokeStyle = 'rgba(50, 38, 22, 0.45)';
  cx.lineWidth = 0.7;
  for (var ch = 0; ch < 14; ch++) {
    cx.beginPath();
    var cxh = Math.random() * w;
    var cyh = Math.random() * h;
    cx.moveTo(cxh, cyh);
    for (var sg2 = 0; sg2 < 5; sg2++) {
      cxh += (Math.random() - 0.5) * 28;
      cyh += 12 + Math.random() * 22;
      cx.lineTo(cxh, cyh);
    }
    cx.stroke();
  }
  // Paint-patch repairs (lighter ovals where someone touched up)
  for (var pr = 0; pr < 8; pr++) {
    var prx = Math.random() * w, pry = Math.random() * h;
    var prr = 12 + Math.random() * 22;
    var pg = cx.createRadialGradient(prx, pry, 0, prx, pry, prr);
    pg.addColorStop(0, 'rgba(225, 210, 180, 0.45)');
    pg.addColorStop(0.6, 'rgba(220, 200, 170, 0.14)');
    pg.addColorStop(1, 'rgba(220, 200, 170, 0)');
    cx.fillStyle = pg;
    cx.beginPath();
    cx.ellipse(prx, pry, prr, prr * 0.7, Math.random() * Math.PI, 0, Math.PI * 2);
    cx.fill();
  }
  // Old paste-up ghost (poster torn off, glue residue)
  cx.fillStyle = 'rgba(200, 170, 130, 0.10)';
  cx.fillRect(w * 0.18, h * 0.55, w * 0.12, h * 0.10);
  // Faint bird splat top-right
  cx.fillStyle = 'rgba(245, 240, 215, 0.36)';
  cx.beginPath();
  cx.ellipse(w * 0.88, h * 0.08, 5, 2.5, 0.4, 0, Math.PI * 2);
  cx.fill();
});
plasterTex.wrapS = plasterTex.wrapT = THREE.RepeatWrapping;
plasterTex.repeat.set(2, 3);
var whitePlaster = new THREE.MeshStandardMaterial({ map: plasterTex, roughness: 0.95 });
var mahogany = new THREE.MeshStandardMaterial({ color: 0x3d1e14, roughness: 0.82 });
var mahoganyDark = new THREE.MeshStandardMaterial({ color: 0x2e1510, roughness: 0.88 });
// Pavement — paving slabs with cracks, gum, wet patches
var paveFaceTexPh = makeCanvasTexture(512, 512, function(cx, w, h) {
  cx.fillStyle = '#34322e'; cx.fillRect(0, 0, w, h);
  var sw = 128, sh = 96;
  cx.strokeStyle = 'rgba(14, 14, 12, 0.6)'; cx.lineWidth = 1.4;
  for (var sy = 0; sy < h; sy += sh) {
    var off = ((sy / sh) % 2 === 0) ? 0 : sw / 2;
    for (var sx = -sw; sx < w + sw; sx += sw) {
      var bxp = sx + off;
      var sg = 44 + Math.floor(Math.random() * 26);
      cx.fillStyle = 'rgba(' + sg + ',' + sg + ',' + (sg - 4) + ',' + (0.32 + Math.random() * 0.3).toFixed(3) + ')';
      cx.fillRect(bxp, sy, sw, sh);
      cx.strokeRect(bxp, sy, sw, sh);
    }
  }
  cx.strokeStyle = 'rgba(12, 12, 10, 0.55)'; cx.lineWidth = 0.9;
  for (var c2 = 0; c2 < 7; c2++) {
    cx.beginPath();
    cx.moveTo(Math.random() * w, Math.random() * h);
    cx.lineTo(Math.random() * w, Math.random() * h);
    cx.stroke();
  }
  for (var fe = 0; fe < 60; fe++) {
    cx.fillStyle = 'rgba(170, 165, 155, ' + (0.14 + Math.random() * 0.20).toFixed(3) + ')';
    cx.beginPath(); cx.arc(Math.random() * w, Math.random() * h, 1.0 + Math.random() * 1.6, 0, Math.PI * 2); cx.fill();
  }
  for (var wp = 0; wp < 5; wp++) {
    var wpx = Math.random() * w, wpy = Math.random() * h;
    var wpr = 35 + Math.random() * 60;
    var wpg = cx.createRadialGradient(wpx, wpy, 0, wpx, wpy, wpr);
    wpg.addColorStop(0, 'rgba(60, 68, 72, 0.32)');
    wpg.addColorStop(1, 'rgba(60, 68, 72, 0)');
    cx.fillStyle = wpg; cx.fillRect(wpx - wpr, wpy - wpr, wpr * 2, wpr * 2);
  }
});
paveFaceTexPh.wrapS = paveFaceTexPh.wrapT = THREE.RepeatWrapping;
paveFaceTexPh.repeat.set(4, 4);
// High-contrast slab texture — the shared recipe with joints that survive lamp wash
var phPaveTex = (function() {
  var c = document.createElement('canvas');
  c.width = 512; c.height = 512;
  var cx = c.getContext('2d');
  cx.fillStyle = '#42423e'; cx.fillRect(0, 0, 512, 512);
  var sw = 128, sh = 96;
  for (var sy = 0; sy < 512; sy += sh) {
    var off = ((sy / sh) % 2 === 0) ? 0 : sw / 2;
    for (var sx = -sw; sx < 512 + sw; sx += sw) {
      var bxp = sx + off;
      var sg = 46 + Math.floor(Math.random() * 42);
      cx.fillStyle = 'rgb(' + sg + ',' + sg + ',' + (sg - 4) + ')';
      cx.fillRect(bxp, sy, sw, sh);
      cx.strokeStyle = 'rgba(10, 10, 8, 1)'; cx.lineWidth = 5;
      cx.strokeRect(bxp, sy, sw, sh);
      if (Math.random() < 0.3) {
        cx.fillStyle = 'rgba(18, 18, 16, 0.5)';
        cx.fillRect(bxp + (Math.random() < 0.5 ? 2 : sw - 14), sy + (Math.random() < 0.5 ? 2 : sh - 10), 12, 8);
      }
    }
  }
  cx.strokeStyle = 'rgba(14, 14, 11, 0.7)'; cx.lineWidth = 1.2;
  for (var c2 = 0; c2 < 9; c2++) {
    cx.beginPath();
    cx.moveTo(Math.random() * 512, Math.random() * 512);
    cx.lineTo(Math.random() * 512, Math.random() * 512);
    cx.stroke();
  }
  for (var wp = 0; wp < 13; wp++) {
    var wpx = Math.random() * 512, wpy = Math.random() * 512;
    var wpr = 35 + Math.random() * 80;
    var wpg = cx.createRadialGradient(wpx, wpy, 0, wpx, wpy, wpr);
    wpg.addColorStop(0, 'rgba(38, 42, 40, 0.55)');
    wpg.addColorStop(1, 'rgba(38, 42, 40, 0)');
    cx.fillStyle = wpg; cx.fillRect(wpx - wpr, wpy - wpr, wpr * 2, wpr * 2);
  }
  // Gum spots and scuffed filth
  for (var gm = 0; gm < 26; gm++) {
    cx.fillStyle = 'rgba(20, 20, 16, ' + (0.25 + Math.random() * 0.3).toFixed(3) + ')';
    cx.beginPath();
    cx.arc(Math.random() * 512, Math.random() * 512, 2 + Math.random() * 4, 0, Math.PI * 2);
    cx.fill();
  }
  var tex = new THREE.CanvasTexture(c);
  tex.minFilter = THREE.LinearFilter;
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(24, 24);
  return tex;
})();
var pavementMat = new THREE.MeshStandardMaterial({ map: phPaveTex, roughness: 0.85, metalness: 0.1 });

// Road — tarmac with aggregate, cracks, repair patches, tar-seal
var roadFaceTexPh = makeCanvasTexture(512, 512, function(cx, w, h) {
  cx.fillStyle = '#1a1a18'; cx.fillRect(0, 0, w, h);
  for (var p = 0; p < 4200; p++) {
    var pg = 25 + Math.floor(Math.random() * 70);
    cx.fillStyle = 'rgba(' + pg + ',' + pg + ',' + pg + ',0.42)';
    cx.fillRect(Math.random() * w, Math.random() * h, 1.5, 1.5);
  }
  // (Repair patches removed — their straight edges read as geometry lines
  // on the road and haunted the flood as a phantom "kerb line")
  cx.strokeStyle = 'rgba(8, 8, 8, 0.8)'; cx.lineWidth = 1.2;
  for (var c = 0; c < 10; c++) {
    cx.beginPath();
    var cx0 = Math.random() * w, cy0 = Math.random() * h;
    cx.moveTo(cx0, cy0);
    var ang = Math.random() * Math.PI * 2, len = 30 + Math.random() * 80;
    cx.lineTo(cx0 + Math.cos(ang) * len, cy0 + Math.sin(ang) * len);
    cx.lineTo(cx0 + Math.cos(ang + 0.4) * len * 1.4, cy0 + Math.sin(ang + 0.4) * len * 1.4);
    cx.stroke();
  }
  cx.strokeStyle = 'rgba(0, 0, 0, 0.9)'; cx.lineWidth = 2.6;
  for (var tm = 0; tm < 5; tm++) {
    cx.beginPath();
    var tx = Math.random() * w, ty = Math.random() * h;
    cx.moveTo(tx, ty);
    for (var ts = 0; ts < 5; ts++) {
      tx += (Math.random() - 0.5) * 30;
      ty += 8 + Math.random() * 16;
      cx.lineTo(tx, ty);
    }
    cx.stroke();
  }
  cx.fillStyle = 'rgba(220, 220, 200, 0.5)';
  cx.fillRect(w * 0.5 - 2, h * 0.3, 4, h * 0.4);
  cx.fillStyle = 'rgba(220, 220, 200, 0.18)';
  cx.fillRect(w * 0.5 - 2, h * 0.05, 4, h * 0.2);
  cx.fillRect(w * 0.5 - 2, h * 0.75, 4, h * 0.2);
  for (var os = 0; os < 4; os++) {
    var ox = Math.random() * w, oy = Math.random() * h;
    var orr = 8 + Math.random() * 18;
    var og = cx.createRadialGradient(ox, oy, 0, ox, oy, orr);
    og.addColorStop(0, 'rgba(0, 0, 0, 0.62)');
    og.addColorStop(0.7, 'rgba(15, 12, 5, 0.22)');
    og.addColorStop(1, 'rgba(15, 12, 5, 0)');
    cx.fillStyle = og; cx.fillRect(ox - orr, oy - orr, orr * 2, orr * 2);
  }
});
roadFaceTexPh.wrapS = roadFaceTexPh.wrapT = THREE.RepeatWrapping;
roadFaceTexPh.repeat.set(8, 1.75);
var roadMat = new THREE.MeshStandardMaterial({ map: roadFaceTexPh, roughness: 0.72, metalness: 0.18 });
var windowFrame = new THREE.MeshStandardMaterial({ color: 0x8a7e60, roughness: 0.88 });
var darkGlass = new THREE.MeshStandardMaterial({ color: 0x0a0a12, roughness: 0.3, metalness: 0.2 });
var goldMat = new THREE.MeshStandardMaterial({ color: 0xa88830, roughness: 0.5, metalness: 0.3 });

// ============================================================
// HELPER: canvas texture
// ============================================================
function makeCanvasTexture(w, h, drawFunc) {
  var c = document.createElement('canvas');
  c.width = w; c.height = h;
  var cx = c.getContext('2d');
  drawFunc(cx, w, h);
  var tex = new THREE.CanvasTexture(c);
  tex.minFilter = THREE.LinearFilter;
  return tex;
}

function placeMesh(group, geo, mat, x, y, z) {
  var m = new THREE.Mesh(geo, mat);
  m.position.set(x, y, z);
  group.add(m);
  return m;
}

// ============================================================
// GROUND
// ============================================================
var ground = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), pavementMat);
ground.rotation.x = -Math.PI / 2;
ground.receiveShadow = true;
scene.add(ground);

// Greek Street road — runs ALONG X in front of the pub (the old 8-wide
// plane ran toward the camera and left slabs showing either side)
var road = new THREE.Mesh(new THREE.PlaneGeometry(60, 13), roadMat);
road.rotation.x = -Math.PI / 2;
// y=0.004 — must sit ABOVE the ground plane at y=0, or the slabbed ground
// renders over the tarmac (same buried-plane bug as Ronnie's and the French)
road.position.set(0, 0.004, 10);
road.receiveShadow = true;
scene.add(road);

// ---- THE FLOODING DRAIN ----
// A blocked drain in the road, slowly welling over — the pool spreads
// wider through the scene, ring ripples pulsing out from the grate
var phDrainMat = new THREE.MeshStandardMaterial({ color: 0x1e1e1c, roughness: 0.5, metalness: 0.5 });
var phDrainFrame = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.02, 0.9), phDrainMat);
phDrainFrame.position.set(2.2, 0.012, 6.4);
scene.add(phDrainFrame);
for (var phb = 0; phb < 6; phb++) {
  var phBar = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.018, 0.06), phDrainMat);
  phBar.position.set(2.2, 0.02, 6.05 + phb * 0.14);
  scene.add(phBar);
}
// Irregular blob outline — water spreads with a wandering rounded edge,
// never as a clean ellipse (whose ends sweep like straight lines on screen)
function phBlobGeo(seed) {
  // 96 rim points, not 26 — at full flood size a 26-gon's segments span
  // over a metre and read as straight lines crawling along the road.
  // Harmonics use INTEGER angular frequencies so the outline wraps
  // seamlessly (the old bi-based phases left a radius jump at angle 0).
  var pts = [];
  for (var bi2 = 0; bi2 < 96; bi2++) {
    var ba = bi2 / 96 * Math.PI * 2;
    var br = 1 + 0.2 * Math.sin(ba * 4 + seed) + 0.13 * Math.sin(ba * 9 + seed * 2.1)
           + 0.07 * Math.sin(ba * 17 + seed * 3.3) + 0.04 * Math.sin(ba * 29 + seed * 1.7);
    pts.push(new THREE.Vector2(Math.cos(ba) * br, Math.sin(ba) * br));
  }
  return new THREE.ShapeGeometry(new THREE.Shape(pts));
}
// Half-blob fan — a rounded advancing front with a flat edge at its source
function phFanGeo(seed) {
  var pts = [];
  for (var fi2 = 0; fi2 <= 48; fi2++) {
    var fa = fi2 / 48 * Math.PI;
    var fr = 1 + 0.16 * Math.sin(fa * 5 + seed) + 0.1 * Math.sin(fa * 11 + seed)
           + 0.05 * Math.sin(fa * 19 + seed * 2.3);
    pts.push(new THREE.Vector2(Math.cos(fa) * fr, Math.sin(fa) * fr));
  }
  return new THREE.ShapeGeometry(new THREE.Shape(pts));
}
// Damp halo that runs ahead of the water
var phFloodDamp = new THREE.Mesh(phBlobGeo(1.7),
  new THREE.MeshBasicMaterial({ color: 0x0c1014, transparent: true, opacity: 0.3, depthWrite: false }));
phFloodDamp.rotation.x = -Math.PI / 2;
phFloodDamp.position.set(2.2, 0.016, 6.4);
scene.add(phFloodDamp);
// The water itself — dark, reflective, catching the lamps
var phFlood = new THREE.Mesh(phBlobGeo(0.4),
  new THREE.MeshStandardMaterial({ color: 0x1c2436, roughness: 0.05, metalness: 0.75, transparent: true, opacity: 0.72 }));
phFlood.rotation.x = -Math.PI / 2;
phFlood.position.set(2.2, 0.02, 6.4);
scene.add(phFlood);
// (Ripple ring removed — from this low camera it read as straight bright
// lines sweeping the road instead of ripples)
// Vertex-driven spread instead of uniform scaling. Uniform scale made the
// foreshortened far edge translate as one long straight segment ("a line
// sweeping the road"). Here every rim vertex advances radially on its own
// surge rhythm, and the kerb-ward half soft-clamps (tanh) like water
// meeting the kerbstone — the far edge settles while the rest keeps going.
// Local +y maps to world -z (toward kerb and pub) under the -PI/2 tilt.
phFlood.userData.orig = phFlood.geometry.attributes.position.array.slice(0);
phFloodDamp.userData.orig = phFloodDamp.geometry.attributes.position.array.slice(0);
function phSpreadVerts(mesh, G, t, phase, kerbClamp) {
var sPos = mesh.geometry.attributes.position;
var sOrig = mesh.userData.orig;
// Per-vertex ratchet: water issuing from a drain only ever advances.
// Each rim point remembers its furthest reach; the surge can only push
// lobes FORWARD past it (in pulses), never drag the edge back.
if (!mesh.userData.reach) mesh.userData.reach = new Float32Array(sPos.count*2);
var sReach = mesh.userData.reach;
for (var svi = 0; svi < sPos.count; svi++) {
var sox = sOrig[svi*3], soy = sOrig[svi*3+1];
var sva = Math.atan2(soy, sox);
var sAmp = 1 + 0.5*Math.min(Math.max(phVisit - 1, 0), 4);
var sSurge = 1 + (0.065*Math.sin(t*0.5 + sva*3 + phase) + 0.035*Math.sin(t*0.23 + sva*5 + phase))*sAmp;
// RADIAL clamp against a directional boundary (kerb ahead, road edge
// behind, street ends sideways). Four hard-won rules live here:
// (1) never clamp x/y separately (the pool becomes a rounded rectangle);
// (2) the kerb-side and road-side limits must BLEND smoothly around the
// flanks (an abrupt switch reads as bevelled corners);
// (3) the boundary itself must be ragged at several scales, else water
// piling against it forms a clean arc that foreshortens into a slab edge;
// (4) kerb-ward the water must ARRIVE (hard min) and merge with the kerb
// foot — a soft asymptote leaves a permanent floating waterline mid-road,
// and any wide flat edge parallel to the screen foreshortens into a rule.
var sRl = Math.sqrt(sox*sox + soy*soy);
var sca = sox/sRl, ssa = soy/sRl;
// Kerb-ward the advancing front gets extra per-vertex depth fingers —
// foreshortening compresses depth 4:1, so raggedness must be exaggerated
// in exactly that direction to survive projection
// Gutter-true spread: fastest ALONG the road, moderate to the kerb,
// slowest toward the camera. The sideways term must stay SMALL: at 0.52
// it exactly cancelled the sine falloff and the pool's upper edge became
// a constant-height band — a straight line under foreshortening. The
// kerbward lobes are LOW-frequency and deep (bays, not ripples), because
// high-frequency fingers flatten to nothing when depth is compressed 4:1.
var sMask = (0.58 + 0.35*sca*sca + 0.1*Math.max(0, ssa))
* (1 + Math.max(0, ssa)*(0.24*Math.sin(sva*7 + phase*5) + 0.15*Math.sin(sva*19 + phase*3)));
var kf = Math.max(0, Math.min(1, (ssa + 0.15)/0.75));
kf = kf*kf*(3 - 2*kf);
var sLy = 9.9 + (kerbClamp - 9.9)*kf;
var sLn = 1 + 0.18*Math.sin(sva*23 + phase*7) + 0.12*Math.sin(sva*41 + phase*3) + 0.08*Math.sin(sva*13 + phase);
var sL = sRl * sLn / Math.sqrt((sca*sca)/256 + (ssa*ssa)/(sLy*sLy));
// Scalloped kerb bays: stretches of the front permanently hold back short
// of the kerb, so the junction alternates water-at-kerb / dry-kerb — a
// uniform flush line reads CG-fake even though real water CAN do it
var sHold = Math.max(0, Math.sin(sva*31 + phase*2));
sL *= (1 - 0.38*sHold*kf);
var sCr = sRl * G * sMask;
var sSoft = sL * Math.tanh(sCr / sL);
var sHard = Math.min(sCr, sL);
var sRr = (kf*sHard + (1 - kf)*sSoft) * sSurge;
var snx = sca * sRr, sny = ssa * sRr;
// Leaky ratchet: reach decays ~3%/s, so the settled edge can EBB with the
// surge (visible lapping) while gross backflow stays impossible. A strict
// ratchet froze every edge at its historical peak — a dead waterline.
var sRx = sReach[svi*2]*0.9995, sRy = sReach[svi*2+1]*0.9995;
if (Math.abs(snx) < Math.abs(sRx)) snx = sRx;
if (Math.abs(sny) < Math.abs(sRy)) sny = sRy;
sReach[svi*2] = snx; sReach[svi*2+1] = sny;
sPos.array[svi*3] = snx; sPos.array[svi*3+1] = sny;
}
sPos.needsUpdate = true;
}

// The source made visible: a deep-water core spreading around the grate
// and a welling crown heaving OVER it — the eye must pin the drain as the
// origin within the first seconds.
var phDeepPool = new THREE.Mesh(phBlobGeo(3.7), new THREE.MeshStandardMaterial({ color: 0x0e1522, roughness: 0.04, metalness: 0.8, transparent: true, opacity: 0.85 }));
phDeepPool.rotation.x = -Math.PI/2;
phDeepPool.position.set(2.2, 0.024, 6.4);
phDeepPool.scale.set(0.01, 0.01, 1);
scene.add(phDeepPool);
var phCrown = new THREE.Mesh(phBlobGeo(5.2), new THREE.MeshStandardMaterial({ color: 0x46608a, roughness: 0.02, metalness: 0.7, transparent: true, opacity: 0, emissive: 0x24344e, emissiveIntensity: 0 }));
phCrown.rotation.x = -Math.PI/2;
phCrown.position.set(2.2, 0.028, 6.4);
scene.add(phCrown);

// Water spilling from the alley passage — it wells up INSIDE the dark
// passage first, runs along the alley floor to the mouth, then a tongue
// creeps across the pavement and pools in the gutter below
var phWaterMat = new THREE.MeshStandardMaterial({ color: 0x1c2436, roughness: 0.05, metalness: 0.75, transparent: true, opacity: 0.68 });
// The water inside the passage, advancing from the depths toward the street
var phAlleyInner = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), phWaterMat.clone());
phAlleyInner.rotation.x = -Math.PI / 2;
phAlleyInner.position.set(-2.2, 0.035, -3);
phAlleyInner.scale.set(0.01, 0.01, 1);
scene.add(phAlleyInner);
// The pavement tongue is a rounded fan — flat edge at the alley mouth,
// wavy rounded front advancing toward the kerb as water naturally spreads
var phAlleyStream = new THREE.Mesh(phFanGeo(0.9), phWaterMat);
phAlleyStream.rotation.set(-Math.PI / 2, 0, Math.PI);
phAlleyStream.position.set(-2.2, 0.158, 0.72);
phAlleyStream.scale.set(0.01, 0.01, 1);
scene.add(phAlleyStream);
var phAlleyPool = new THREE.Mesh(phBlobGeo(2.9), phWaterMat.clone());
phAlleyPool.rotation.x = -Math.PI / 2;
phAlleyPool.position.set(-2.2, 0.022, 4.3);
phAlleyPool.scale.set(0.01, 0.01, 1);
scene.add(phAlleyPool);
// The pavement sheet — once the road pool has pressed the kerb a while,
// water starts claiming the raised pavement itself (top y 0.15): a fan
// spreading from the kerb line toward the pub door, never quite stopping.
var phPaveFlood = new THREE.Mesh(phFanGeo(1.3), phWaterMat.clone());
phPaveFlood.material.color.setHex(0x344358);
phPaveFlood.material.metalness = 0.35;
phPaveFlood.material.roughness = 0.14;
phPaveFlood.renderOrder = 3;
phPaveFlood.rotation.x = -Math.PI / 2;
phPaveFlood.position.set(0.7, 0.157, 4.2);
phPaveFlood.scale.set(0.01, 0.01, 1);
scene.add(phPaveFlood);
// Visit 2+: slow blob-ripples spreading off the drain. Blobs, NOT rings —
// rings foreshorten into straight bright lines at this camera (the original
// ripple ring was removed for exactly that).
var phRip = [];
for (var phri = 0; phri < 2; phri++) {
  var phRipM = new THREE.Mesh(phBlobGeo(6.1 + phri * 1.3), new THREE.MeshBasicMaterial({ color: 0x3a4a66, transparent: true, opacity: 0, depthWrite: false }));
  phRipM.rotation.x = -Math.PI / 2;
  phRipM.position.set(2.2, 0.026, 6.4);
  scene.add(phRipM);
  phRip.push(phRipM);
}
// Visit 2+: surface CHOP — drifting glint-patches that churn the pool.
// Count and violence scale with the visit, uncapped into visit 4+.
var phChop = [];
for (var pci = 0; pci < 12; pci++) {
  var pcM = new THREE.Mesh(phBlobGeo(7.7 + pci * 0.9), new THREE.MeshStandardMaterial({ color: 0x4a6488, roughness: 0.05, metalness: 0.6, transparent: true, opacity: 0, emissive: 0x2c3e5c, emissiveIntensity: 0, depthWrite: false }));
  pcM.rotation.x = -Math.PI / 2;
  pcM.position.set(2.2, 0.023, 6.4);
  pcM.userData = { ph: Math.random() * 6.28, sp: 0.9 + Math.random() * 1.4, ox: (Math.random() - 0.5), oz: (Math.random() - 0.5) };
  scene.add(pcM);
  phChop.push(pcM);
}
// Visit 3+: lightning. A cool ambient spike + fog/sky flash + every water
// surface silvered via emissive for the duration of the strike.
var phLightning = new THREE.AmbientLight(0xcfe0ff, 0);
scene.add(phLightning);
var phWaterMats = [phFlood.material, phDeepPool.material, phWaterMat, phAlleyPool.material, phAlleyInner.material, phPaveFlood.material];
// 2026-10-28: small, world-anchored wavelets break the lamplight from
// the first visit. Shading only: no extra planes or screen-wide ripple rings.
var phWaterTime = { value: 0 };
phWaterMats.forEach(function(mat) {
  mat.depthWrite = false;
  mat.onBeforeCompile = function(shader) {
    shader.uniforms.phWaterTime = phWaterTime;
    shader.vertexShader = 'varying vec2 phWaterXZ;\n' + shader.vertexShader;
    shader.vertexShader = shader.vertexShader.replace('#include <begin_vertex>',
      '#include <begin_vertex>\nphWaterXZ = (modelMatrix * vec4(position, 1.0)).xz;');
    shader.fragmentShader = 'uniform float phWaterTime;\nvarying vec2 phWaterXZ;\n' + shader.fragmentShader;
    shader.fragmentShader = shader.fragmentShader.replace('#include <normal_fragment_maps>', [
      '#include <normal_fragment_maps>',
      'vec2 wp = phWaterXZ;',
      'float wa = wp.x * 4.0 - wp.y * 10.0 - phWaterTime * 1.4;',
      'float wb = wp.x * -7.0 - wp.y * 7.0 - phWaterTime * 1.05;',
      'float wc = wp.x * 19.0 + wp.y * 16.0 + sin(wa) * 0.65 - phWaterTime * 2.1;',
      'vec2 slope = vec2(0.034, -0.085) * cos(wa) + vec2(-0.049, -0.049) * cos(wb) + vec2(0.026, 0.022) * cos(wc);',
      'normal = normalize(normal + mat3(viewMatrix) * vec3(-slope.x, 0.0, -slope.y));'
    ].join('\n'));
    shader.fragmentShader = shader.fragmentShader.replace('#include <emissivemap_fragment>', [
      '#include <emissivemap_fragment>',
      // Fragmented vertical trails, fading away from their light source.
      'float brokenLight = pow(max(0.0, sin(wa + sin(wb) * 1.3)), 9.0) * (0.3 + 0.7 * pow(max(0.0, sin(wb)), 2.0));',
      'float lampTrail = exp(-pow((wp.x - 0.6 + sin(wp.y * 2.1 + phWaterTime * 0.4) * 0.18) / 0.85, 2.0)) * exp(-abs(wp.y - 3.5) * 0.19);',
      'totalEmissiveRadiance += brokenLight * (vec3(0.045, 0.065, 0.095) + vec3(0.24, 0.12, 0.035) * lampTrail);'
    ].join('\n'));
  };
  mat.customProgramCacheKey = function() { return 'ph-water-wavelets-2'; };
});
// Deep overtopping water hides the flags below it. Keeping this sheet in
// the opaque pass also prevents the wet-pavement layers showing through it.
phPaveFlood.material.transparent = false;
phPaveFlood.material.opacity = 1;
phPaveFlood.material.depthWrite = true;
for (var phwi = 0; phwi < phWaterMats.length; phwi++) { if (phWaterMats[phwi].emissive) { phWaterMats[phwi].emissive.setHex(0x9fb4dc); phWaterMats[phwi].emissiveIntensity = 0; } }
var phFogBase = scene.fog ? scene.fog.color.clone() : null;
var phBgBase = (scene.background && scene.background.isColor) ? scene.background.clone() : null;
var phFlashCol = new THREE.Color(0xb8cce4);
var phBoltNext = 3 + Math.random() * 3;
var phBoltT = -10;

// Wet road surface — just stopped raining, everything glistening
var wetMat = new THREE.MeshStandardMaterial({
  color: 0x1a1a1a, roughness: 0.1, metalness: 0.6, transparent: true, opacity: 0.3
});
var wetRoad = new THREE.Mesh(new THREE.PlaneGeometry(60, 13), wetMat);
wetRoad.rotation.x = -Math.PI / 2;
wetRoad.position.set(0, 0.01, 10);
scene.add(wetRoad);

// Wet pavement sheen (closer to buildings — rain-slicked flagstones)
var wetPaveMat = new THREE.MeshStandardMaterial({
  color: 0x222228, roughness: 0.12, metalness: 0.55, transparent: true, opacity: 0.25
});
// Depth 3, NOT 4 — at 4 this sheen overhung the kerb by half a unit,
// hovering over the road at y 0.08: its straight far edge was the
// infamous "line above the drain", and the flood (y 0.02) slid beneath
// the overhang and appeared to stop dead at it. Buried-plane family.
var wetPave = new THREE.Mesh(new THREE.PlaneGeometry(30, 3), wetPaveMat);
wetPave.rotation.x = -Math.PI / 2;
wetPave.position.set(0, 0.08, 2);
scene.add(wetPave);

// ============================================================
// THE PILLARS OF HERCULES
// ============================================================
var pub = new THREE.Group();

// ---- WHITE PLASTER BASE WALL (behind the timber) ----
// Main building body: x from -1.5 to 4, facade at z=0 facing +Z
// Building depth goes into -Z
var plasterWall = new THREE.Mesh(new THREE.BoxGeometry(5.5, 9, 7), whitePlaster);
plasterWall.position.set(1.25, 8, -3.5);
pub.add(plasterWall);

// ---- TWIN GABLES AT THE TOP ----
// These are the distinctive peaked roofs at the very top

// Left gable
var gableFrameL = new THREE.Mesh(new THREE.BoxGeometry(2.4, 1.6, 0.25), darkTimber);
gableFrameL.position.set(-0.2, 13.3, 0.15);
pub.add(gableFrameL);
var gableTopL = new THREE.Mesh(new THREE.ConeGeometry(1.6, 1.4, 4), darkTimber);
gableTopL.position.set(-0.2, 14.6, 0.15);
gableTopL.rotation.y = Math.PI / 4;
pub.add(gableTopL);
// White infill
var gableFillL = new THREE.Mesh(new THREE.PlaneGeometry(1.8, 1.2), whitePlaster);
gableFillL.position.set(-0.2, 13.3, 0.32);
pub.add(gableFillL);

// Right gable
var gableFrameR = new THREE.Mesh(new THREE.BoxGeometry(2.4, 1.6, 0.25), darkTimber);
gableFrameR.position.set(2.7, 13.3, 0.15);
pub.add(gableFrameR);
var gableTopR = new THREE.Mesh(new THREE.ConeGeometry(1.6, 1.4, 4), darkTimber);
gableTopR.position.set(2.7, 14.6, 0.15);
gableTopR.rotation.y = Math.PI / 4;
pub.add(gableTopR);
var gableFillR = new THREE.Mesh(new THREE.PlaneGeometry(1.8, 1.2), whitePlaster);
gableFillR.position.set(2.7, 13.3, 0.32);
pub.add(gableFillR);

// Small gable windows
var gableWinMatL = new THREE.MeshBasicMaterial({ color: 0xffd699, transparent: true, opacity: 0.3 });
placeMesh(pub, new THREE.PlaneGeometry(0.5, 0.8), gableWinMatL, -0.2, 13.3, 0.35);
placeMesh(pub, new THREE.BoxGeometry(0.6, 0.9, 0.04), darkTimber, -0.2, 13.3, 0.3);
var gableWinMatR = new THREE.MeshBasicMaterial({ color: 0xffd699, transparent: true, opacity: 0.25 });
placeMesh(pub, new THREE.PlaneGeometry(0.5, 0.8), gableWinMatR, 2.7, 13.3, 0.35);
placeMesh(pub, new THREE.BoxGeometry(0.6, 0.9, 0.04), darkTimber, 2.7, 13.3, 0.3);

// ---- HORIZONTAL TIMBER BEAMS (floor divisions) ----
// Clean main beams at each floor level — matching guide proportions
var beamHeights = [3.7, 7.0, 9.5, 12.5];
for (var bi = 0; bi < beamHeights.length; bi++) {
  var beam = new THREE.Mesh(new THREE.BoxGeometry(5.8, 0.18, 0.15), darkTimber);
  beam.position.set(1.25, beamHeights[bi], 0.22);
  pub.add(beam);
}

// ---- VERTICAL TIMBER POSTS ----
// 5 evenly-spaced structural posts (matching guide: edges + centre + quarters)
var postXs = [-1.3, 0.0, 1.25, 2.5, 3.8];
for (var pi = 0; pi < postXs.length; pi++) {
  // Lower section (1st + 2nd floor)
  var post1 = new THREE.Mesh(new THREE.BoxGeometry(0.15, 5.6, 0.15), darkTimber);
  post1.position.set(postXs[pi], 6.5, 0.22);
  pub.add(post1);
  // Upper section (3rd floor)
  var post2 = new THREE.Mesh(new THREE.BoxGeometry(0.15, 2.8, 0.15), darkTimber);
  post2.position.set(postXs[pi], 11, 0.22);
  pub.add(post2);
}

// ---- DECORATIVE X-BRACES (Tudor cross pattern) ----
// Placed only at the outer bays and one central — clean, orderly layout
function addXBrace(cx, cy, w, h) {
  var diagLen = Math.sqrt(w * w + h * h);
  var d1 = new THREE.Mesh(new THREE.BoxGeometry(0.08, diagLen, 0.1), darkTimber);
  d1.position.set(cx, cy, 0.22);
  d1.rotation.z = Math.atan2(w, h);
  pub.add(d1);
  var d2 = new THREE.Mesh(new THREE.BoxGeometry(0.08, diagLen, 0.1), darkTimber);
  d2.position.set(cx, cy, 0.22);
  d2.rotation.z = -Math.atan2(w, h);
  pub.add(d2);
}
// 2nd floor: X-braces in outer bays only
addXBrace(-0.65, 8.2, 0.8, 2.0);
addXBrace(3.15, 8.2, 0.8, 2.0);
// 3rd floor: X-braces in outer bays + one central
addXBrace(-0.65, 11, 0.8, 2.5);
addXBrace(3.15, 11, 0.8, 2.5);
addXBrace(1.25, 11, 1.0, 2.5);

// ---- DIAMOND PATTERN TIMBER (decorative panels between windows) ----
function addDiamond(cx, cy, size) {
  var d = new THREE.Mesh(new THREE.BoxGeometry(0.06, size * 1.4, 0.08), darkTimber);
  d.position.set(cx, cy, 0.24);
  d.rotation.z = Math.PI / 4;
  pub.add(d);
  var d2 = new THREE.Mesh(new THREE.BoxGeometry(0.06, size * 1.4, 0.08), darkTimber);
  d2.position.set(cx, cy, 0.24);
  d2.rotation.z = -Math.PI / 4;
  pub.add(d2);
}
// Diamonds only in the inner bays (between the X-braces) — 4 total
addDiamond(0.6, 8.2, 0.6);
addDiamond(1.9, 8.2, 0.6);
addDiamond(0.6, 11, 0.6);
addDiamond(1.9, 11, 0.6);

// ---- UPPER FLOOR WINDOWS (leaded glass style) ----
var sillMat = new THREE.MeshStandardMaterial({ color: 0xc8c0b0, roughness: 0.8 });

// 2nd floor windows — with sills, lintels, and glazing bars
for (var w2x = -0.2; w2x <= 2.8; w2x += 1.0) {
  var isLit = Math.random() < 0.6;
  // Glass glow
  var w2 = new THREE.Mesh(new THREE.PlaneGeometry(0.65, 1.2),
    new THREE.MeshBasicMaterial({ color: 0xffd699, transparent: true, opacity: isLit ? 0.45 : 0.2 }));
  w2.position.set(w2x, 10.8, 0.32);
  pub.add(w2);
  // Timber frame
  var w2f = new THREE.Mesh(new THREE.BoxGeometry(0.75, 1.3, 0.04), darkTimber);
  w2f.position.set(w2x, 10.8, 0.28);
  pub.add(w2f);
  // Glazing bars (leaded glass pattern — 2 vertical, 2 horizontal)
  placeMesh(pub, new THREE.BoxGeometry(0.02, 1.2, 0.02), darkTimber, w2x - 0.15, 10.8, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.02, 1.2, 0.02), darkTimber, w2x + 0.15, 10.8, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.65, 0.02, 0.02), darkTimber, w2x, 10.5, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.65, 0.02, 0.02), darkTimber, w2x, 11.1, 0.34);
  // Stone sill below
  placeMesh(pub, new THREE.BoxGeometry(0.85, 0.06, 0.12), sillMat, w2x, 10.15, 0.3);
  // Timber lintel above
  placeMesh(pub, new THREE.BoxGeometry(0.85, 0.08, 0.1), darkTimber, w2x, 11.45, 0.28);
}

// 1st floor windows (bigger, more warm light — the main pub floors)
for (var w1x = -0.2; w1x <= 2.8; w1x += 1.0) {
  var isLit1 = Math.random() < 0.7;
  // Glass glow
  var w1 = new THREE.Mesh(new THREE.PlaneGeometry(0.7, 1.4),
    new THREE.MeshBasicMaterial({ color: 0xffd699, transparent: true, opacity: isLit1 ? 0.5 : 0.2 }));
  w1.position.set(w1x, 5.5, 0.32);
  pub.add(w1);
  // Timber frame
  var w1f = new THREE.Mesh(new THREE.BoxGeometry(0.8, 1.5, 0.04), darkTimber);
  w1f.position.set(w1x, 5.5, 0.28);
  pub.add(w1f);
  // Glazing bars (cross pattern — more detailed leaded glass)
  placeMesh(pub, new THREE.BoxGeometry(0.02, 1.4, 0.02), darkTimber, w1x, 5.5, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.02, 1.4, 0.02), darkTimber, w1x - 0.18, 5.5, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.02, 1.4, 0.02), darkTimber, w1x + 0.18, 5.5, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.7, 0.02, 0.02), darkTimber, w1x, 5.5, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.7, 0.02, 0.02), darkTimber, w1x, 5.15, 0.34);
  placeMesh(pub, new THREE.BoxGeometry(0.7, 0.02, 0.02), darkTimber, w1x, 5.85, 0.34);
  // Stone sill below
  placeMesh(pub, new THREE.BoxGeometry(0.9, 0.07, 0.14), sillMat, w1x, 4.75, 0.3);
  // Timber lintel above
  placeMesh(pub, new THREE.BoxGeometry(0.9, 0.1, 0.1), darkTimber, w1x, 6.28, 0.28);
}

// ---- HERCULES FIGURE (mounted between upper floors) ----
var hercBody = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.06, 0.5, 6), goldMat);
hercBody.position.set(1.25, 7.5, 0.35);
pub.add(hercBody);
var hercHead = new THREE.Mesh(new THREE.SphereGeometry(0.09, 6, 6), goldMat);
hercHead.position.set(1.25, 7.85, 0.35);
pub.add(hercHead);
// Arms outstretched
var hercArm = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.05, 0.05), goldMat);
hercArm.position.set(1.25, 7.6, 0.35);
pub.add(hercArm);

// ---- PLANTER BOX (overflowing greenery above fascia) ----
var planterBoxMat = new THREE.MeshStandardMaterial({ color: 0x2a2018, roughness: 0.8 });
var planterBox = new THREE.Mesh(new THREE.BoxGeometry(5.6, 0.35, 0.5), planterBoxMat);
planterBox.position.set(1.25, 4.0, 0.5);
pub.add(planterBox);

// Lush greenery — painted leafy clumps, layered and irregular, not solid blobs
var leafClumpTex = makeCanvasTexture(96, 96, function(cx, w, h) {
  var greens = ['#1e4410', '#2a5a1a', '#39702a', '#4a8230', '#254e14'];
  for (var lf = 0; lf < 70; lf++) {
    var la = Math.random() * Math.PI * 2;
    var lr = Math.random() * Math.random() * w * 0.42;
    var lx = w / 2 + Math.cos(la) * lr;
    var ly = h / 2 + Math.sin(la) * lr * 0.8;
    // Darker leaves toward the bottom of the clump for baked shading
    var gi = Math.floor(Math.random() * greens.length);
    if (ly > h * 0.6 && gi > 1) gi -= 2;
    cx.fillStyle = greens[gi];
    cx.save();
    cx.translate(lx, ly);
    cx.rotate(Math.random() * Math.PI);
    cx.beginPath();
    cx.ellipse(0, 0, 3 + Math.random() * 5, 2 + Math.random() * 3, 0, 0, Math.PI * 2);
    cx.fill();
    cx.restore();
  }
});
for (var li = -1.25; li <= 3.85; li += 0.26) {
  var clumpMat = new THREE.SpriteMaterial({ map: leafClumpTex, transparent: true, depthWrite: false });
  clumpMat.color.setScalar(0.75 + Math.random() * 0.35);
  var clump = new THREE.Sprite(clumpMat);
  var cs = 0.55 + Math.random() * 0.35;
  clump.scale.set(cs, cs * (0.7 + Math.random() * 0.3), 1);
  clump.position.set(li + (Math.random() - 0.5) * 0.1, 4.32 + Math.random() * 0.2, 0.62 + Math.random() * 0.18);
  pub.add(clump);
}
// Trailing strands spilling down over the fascia edge
var strandTex = makeCanvasTexture(32, 96, function(cx, w, h) {
  var sGreens = ['#1e4410', '#2a5a1a', '#39702a'];
  var sx0 = w / 2;
  for (var sl = 0; sl < 9; sl++) {
    var sy = 4 + sl * (h - 10) / 9;
    var sx = sx0 + Math.sin(sl * 0.9) * 5;
    cx.fillStyle = sGreens[sl % sGreens.length];
    cx.save();
    cx.translate(sx, sy);
    cx.rotate(0.5 + Math.sin(sl * 1.7) * 0.6);
    cx.beginPath();
    cx.ellipse(0, 0, 4.2, 2.4, 0, 0, Math.PI * 2);
    cx.fill();
    cx.restore();
    // Stem hint
    cx.strokeStyle = 'rgba(26, 58, 14, 0.7)'; cx.lineWidth = 1.2;
    cx.beginPath(); cx.moveTo(sx0 + Math.sin(sl * 0.9) * 5, sy);
    cx.lineTo(sx0 + Math.sin((sl + 1) * 0.9) * 5, sy + (h - 10) / 9); cx.stroke();
  }
});
for (var iv = -1.0; iv <= 3.6; iv += 0.55) {
  var strandMat = new THREE.SpriteMaterial({ map: strandTex, transparent: true, depthWrite: false });
  strandMat.color.setScalar(0.7 + Math.random() * 0.3);
  var strand = new THREE.Sprite(strandMat);
  strand.scale.set(0.16 + Math.random() * 0.06, 0.42 + Math.random() * 0.28, 1);
  strand.position.set(iv + (Math.random() - 0.5) * 0.2, 3.62 - Math.random() * 0.12, 0.58);
  pub.add(strand);
}

// ---- CREAM FASCIA "No7 PILLARS OF HERCULES No7" ----
var fasciaC = document.createElement('canvas');
fasciaC.width = 640; fasciaC.height = 64;
var fctx = fasciaC.getContext('2d');
// Cream background
fctx.fillStyle = '#e8dcc8';
fctx.fillRect(0, 0, 640, 64);
// Dark border top and bottom
fctx.fillStyle = '#3a1a10';
fctx.fillRect(0, 0, 640, 4);
fctx.fillRect(0, 60, 640, 4);
// Dark red/maroon text
fctx.fillStyle = '#6a1a10';
fctx.font = 'bold 30px Georgia, serif';
fctx.textAlign = 'center';
fctx.fillText('No7    PILLARS  OF  HERCULES    No7', 320, 42);
// Pointing hand decorations
fctx.font = '22px Georgia, serif';
fctx.fillText('\u261E', 120, 42);
fctx.fillText('\u261C', 520, 42);

var fasciaTex = new THREE.CanvasTexture(fasciaC);
var fascia = new THREE.Mesh(new THREE.BoxGeometry(5.4, 0.5, 0.18),
  new THREE.MeshBasicMaterial({ map: fasciaTex }));
fascia.position.set(1.25, 3.55, 0.5);
pub.add(fascia);

// ---- SMALL VICTORIAN LAMPS on fascia ----
var lampLightsOnPub = [];
for (var lx = -1.0; lx <= 3.5; lx += 4.5) {
  var lampBracket = new THREE.Mesh(new THREE.BoxGeometry(0.06, 0.3, 0.2),
    new THREE.MeshStandardMaterial({ color: 0x1a1a18, roughness: 0.8 }));
  lampBracket.position.set(lx, 3.75, 0.6);
  pub.add(lampBracket);
  var lampGlobe = new THREE.Mesh(new THREE.SphereGeometry(0.08, 6, 6),
    new THREE.MeshBasicMaterial({ color: 0xffe8aa, transparent: true, opacity: 0.8 }));
  lampGlobe.position.set(lx, 3.95, 0.7);
  pub.add(lampGlobe);
  // decay 2 + long range on every road-facing light: their old hard range
  // cutoffs (several at ~5-7 units) landed as flattened arcs across the
  // road just above the drain and stitched into a full-width "line" that
  // the darkening flood made stark — chased for a whole session as a
  // water-edge bug before being caught as a LIGHTING terminator
  var lampL = new THREE.PointLight(0xffd080, 0.5, 10, 2);
  lampL.position.set(lx, 3.95, 0.8);
  lampL.userData.baseIntensity = 0.7; // offsets decay-2 mid-field dimming
  pub.add(lampL);
  lampLightsOnPub.push(lampL);
}

// ---- DARK MAROON AWNING below fascia ----
var awning = new THREE.Mesh(new THREE.BoxGeometry(4.5, 0.25, 0.5),
  new THREE.MeshStandardMaterial({ color: 0x4a1015, roughness: 0.7 }));
awning.position.set(1.5, 3.15, 0.7);
pub.add(awning);

// ---- RICH MAHOGANY PUB ENTRANCE (right side of ground floor) ----
// The pub front extends from the alley right edge to the right of the building
var pubFront = new THREE.Mesh(new THREE.BoxGeometry(5.2, 3.2, 0.3), mahoganyDark);
pubFront.position.set(1.5, 1.6, 0.45);
pub.add(pubFront);

// Ornate mahogany frame around entrance
placeMesh(pub, new THREE.BoxGeometry(0.18, 3.2, 0.35), mahogany, -1.05, 1.6, 0.6);
placeMesh(pub, new THREE.BoxGeometry(0.18, 3.2, 0.35), mahogany, 4.0, 1.6, 0.6);
placeMesh(pub, new THREE.BoxGeometry(5.3, 0.18, 0.35), mahogany, 1.5, 3.15, 0.6);

// ---- Kickboard / plinth at very bottom of mahogany section ----
placeMesh(pub, new THREE.BoxGeometry(5.3, 0.3, 0.12), mahoganyDark, 1.5, 0.15, 0.65);

// ---- VICTORIAN PUB GROUND FLOOR — proper window bays and door ----
// Layout: [left bay] [door] [right bay 1] [right bay 2]
// Pub front runs from x=-1.05 to x=4.0

// Painted Victorian pub interior — back bar, bottles, tankards, drinkers
function makePillarsInteriorTex(seed) {
  return makeCanvasTexture(256, 288, function(cx2, w, h) {
    cx2.fillStyle = '#281605'; cx2.fillRect(0, 0, w, h);
    var rg = cx2.createRadialGradient(w * (0.3 + seed * 0.4), h * 0.35, 10, w / 2, h * 0.45, w * 0.85);
    rg.addColorStop(0, 'rgba(255, 200, 100, 0.6)');
    rg.addColorStop(0.5, 'rgba(210, 140, 50, 0.32)');
    rg.addColorStop(1, 'rgba(100, 60, 20, 0.08)');
    cx2.fillStyle = rg; cx2.fillRect(0, 0, w, h);
    // Nicotine ceiling band
    cx2.fillStyle = 'rgba(130, 90, 40, 0.4)';
    cx2.fillRect(0, 0, w, h * 0.1);
    // Hanging tankards and glasses along a rail
    for (var tk = 0; tk < 6; tk++) {
      var tkx = w * 0.1 + tk * w * 0.15;
      cx2.strokeStyle = 'rgba(200, 170, 110, 0.55)'; cx2.lineWidth = 2;
      cx2.beginPath(); cx2.moveTo(tkx, h * 0.1); cx2.lineTo(tkx, h * 0.16); cx2.stroke();
      cx2.fillStyle = tk % 2 ? 'rgba(190, 160, 90, 0.6)' : 'rgba(225, 215, 185, 0.45)';
      cx2.fillRect(tkx - 4, h * 0.16, 8, h * 0.05);
    }
    // Back-bar mirror with glint
    cx2.fillStyle = 'rgba(145, 125, 90, 0.45)';
    cx2.fillRect(w * 0.1, h * 0.24, w * 0.8, h * 0.2);
    cx2.fillStyle = 'rgba(235, 215, 170, 0.22)';
    cx2.beginPath();
    cx2.moveTo(w * (0.2 + seed * 0.2), h * 0.24); cx2.lineTo(w * (0.32 + seed * 0.2), h * 0.24);
    cx2.lineTo(w * (0.2 + seed * 0.2), h * 0.44); cx2.lineTo(w * (0.08 + seed * 0.2), h * 0.44);
    cx2.closePath(); cx2.fill();
    // Bottle row on the shelf
    var pbCols = ['#2a4a2a', '#5a3a18', '#1a2a4a', '#6a5a20', '#3a1a1a'];
    for (var pb2 = 0; pb2 < 8; pb2++) {
      cx2.fillStyle = pbCols[(pb2 + Math.floor(seed * 4)) % pbCols.length];
      var pbx = w * 0.13 + pb2 * w * 0.095;
      cx2.fillRect(pbx, h * 0.34, w * 0.038, h * 0.1);
      cx2.fillRect(pbx + w * 0.012, h * 0.31, w * 0.015, h * 0.035);
    }
    cx2.fillStyle = 'rgba(55, 35, 14, 0.9)';
    cx2.fillRect(w * 0.08, h * 0.44, w * 0.84, h * 0.018);
    // Bar counter with brass rail
    cx2.fillStyle = 'rgba(75, 48, 20, 0.95)';
    cx2.fillRect(0, h * 0.56, w, h * 0.05);
    cx2.fillStyle = 'rgba(200, 165, 80, 0.5)';
    cx2.fillRect(0, h * 0.555, w, h * 0.008);
    // Pump handles on the counter
    for (var ph2 = 0; ph2 < 3; ph2++) {
      cx2.fillStyle = 'rgba(40, 22, 10, 0.9)';
      cx2.fillRect(w * (0.25 + ph2 * 0.2 + seed * 0.05), h * 0.48, 4, h * 0.08);
      cx2.fillStyle = 'rgba(220, 205, 175, 0.8)';
      cx2.beginPath(); cx2.arc(w * (0.25 + ph2 * 0.2 + seed * 0.05) + 2, h * 0.475, 4, 0, Math.PI * 2); cx2.fill();
    }
    // Drinkers at the bar — dark head-and-shoulder silhouettes
    var figN = 1 + Math.floor(seed * 2.2);
    for (var fg2 = 0; fg2 < figN; fg2++) {
      var fgx = w * (0.22 + fg2 * 0.42 + seed * 0.1);
      cx2.fillStyle = 'rgba(12, 6, 2, 0.88)';
      cx2.beginPath(); cx2.arc(fgx, h * 0.6, w * 0.055, 0, Math.PI * 2); cx2.fill();
      cx2.beginPath();
      cx2.ellipse(fgx, h * 0.76, w * 0.11, h * 0.13, 0, Math.PI, 0, true);
      cx2.fill();
      cx2.fillRect(fgx - w * 0.11, h * 0.76, w * 0.22, h * 0.24);
      // A raised glass for the first
      if (fg2 === 0 && seed > 0.3) {
        cx2.fillRect(fgx + w * 0.12, h * 0.62, w * 0.035, h * 0.06);
        cx2.fillStyle = 'rgba(210, 150, 60, 0.6)';
        cx2.fillRect(fgx + w * 0.125, h * 0.63, w * 0.025, h * 0.035);
      }
    }
    // Etched frosted band across the lower glass — Victorian pub privacy glass
    cx2.fillStyle = 'rgba(235, 230, 215, 0.32)';
    cx2.fillRect(0, h * 0.82, w, h * 0.18);
    cx2.strokeStyle = 'rgba(255, 252, 240, 0.4)'; cx2.lineWidth = 2;
    cx2.beginPath(); cx2.moveTo(0, h * 0.82); cx2.lineTo(w, h * 0.82); cx2.stroke();
    for (var et = 0; et < 4; et++) {
      cx2.beginPath();
      cx2.arc(w * (0.125 + et * 0.25), h * 0.91, w * 0.06, 0, Math.PI * 2);
      cx2.stroke();
    }
  });
}

// Helper: create a proper pub window bay
function createWindowBay(cx, bayW, bayH, yBase) {
  var glassH = bayH - 0.5; // glass area (above kickboard)
  var glassY = yBase + 0.25 + glassH / 2;
  var kickY = yBase + 0.17;

  // The lit interior, painted — with a faint warm glaze over it
  var bayGlass = new THREE.Mesh(new THREE.PlaneGeometry(bayW - 0.12, glassH),
    new THREE.MeshBasicMaterial({ map: makePillarsInteriorTex(((cx * 7.7 + 11) % 10) / 10) }));
  bayGlass.position.set(cx, glassY, 0.63);
  pub.add(bayGlass);
  var bayGlaze = new THREE.Mesh(new THREE.PlaneGeometry(bayW - 0.12, glassH),
    new THREE.MeshBasicMaterial({ color: 0xffd699, transparent: true, opacity: 0.16 }));
  bayGlaze.position.set(cx, glassY, 0.645);
  pub.add(bayGlaze);

  // Outer frame (mahogany surround)
  placeMesh(pub, new THREE.BoxGeometry(0.06, bayH, 0.08), mahogany, cx - bayW/2, yBase + bayH/2, 0.62);
  placeMesh(pub, new THREE.BoxGeometry(0.06, bayH, 0.08), mahogany, cx + bayW/2, yBase + bayH/2, 0.62);
  placeMesh(pub, new THREE.BoxGeometry(bayW + 0.06, 0.06, 0.08), mahogany, cx, yBase + bayH, 0.62);
  placeMesh(pub, new THREE.BoxGeometry(bayW + 0.06, 0.06, 0.08), mahogany, cx, yBase + 0.5, 0.62);

  // Vertical glazing bars (dividing bay into 3 panes)
  var paneW = bayW / 3;
  placeMesh(pub, new THREE.BoxGeometry(0.03, glassH, 0.04), mahogany, cx - paneW / 2 - paneW / 6, glassY, 0.66);
  placeMesh(pub, new THREE.BoxGeometry(0.03, glassH, 0.04), mahogany, cx + paneW / 2 + paneW / 6, glassY, 0.66);

  // Horizontal glazing bars (2 rows for traditional 3×3 grid effect)
  var thirdH = glassH / 3;
  placeMesh(pub, new THREE.BoxGeometry(bayW - 0.12, 0.03, 0.04), mahogany, cx, glassY - thirdH / 2, 0.66);
  placeMesh(pub, new THREE.BoxGeometry(bayW - 0.12, 0.03, 0.04), mahogany, cx, glassY + thirdH / 2, 0.66);

  // Solid kickboard panel below glass
  placeMesh(pub, new THREE.BoxGeometry(bayW - 0.08, 0.4, 0.06), mahoganyDark, cx, kickY, 0.62);
  // Kickboard moulding
  placeMesh(pub, new THREE.BoxGeometry(bayW - 0.04, 0.04, 0.04), mahogany, cx, yBase + 0.38, 0.64);
}

