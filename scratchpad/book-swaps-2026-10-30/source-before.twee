    cx.strokeStyle = 'rgba(90,50,40,0.5)'; cx.lineWidth = 2; for (var px = 64; px < w; px += 128) { cx.strokeRect(px - 40, 40, 80, h - 80); }
    cx.fillStyle = 'rgba(160,40,30,0.55)'; for (var chp = 0; chp < 26; chp++) { cx.beginPath(); cx.ellipse(Math.random() * w, Math.random() * h, 2 + Math.random() * 6, 1 + Math.random() * 3, Math.random() * Math.PI, 0, Math.PI * 2); cx.fill(); }
    var dust = cx.createLinearGradient(0, h * 0.7, 0, h); dust.addColorStop(0, 'rgba(120,110,90,0)'); dust.addColorStop(1, 'rgba(120,110,90,0.3)'); cx.fillStyle = dust; cx.fillRect(0, 0, w, h);
  });
  lacquerTex.wrapS = lacquerTex.wrapT = THREE.RepeatWrapping; lacquerTex.repeat.set(2, 1.5);
