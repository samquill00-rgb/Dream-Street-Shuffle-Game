  var root = document.querySelector('.wk-vision'); if (!root || root._wk) return; root._wk = true; // (a plain page's panel may lift it out of tw-passage)
  var links = document.querySelector('.wk-links');
  var glassCanvas=document.createElement('canvas');glassCanvas.width=360;glassCanvas.height=540;glassCanvas.className='wk-looking-glass';glassCanvas.setAttribute('aria-label','A silhouette on the window fades to reveal Madame Blavatsky and the Beast waltzing in Watkins');root.insertBefore(glassCanvas,root.firstChild);
  var glassBorn=performance.now(), glassRAF=0;
  function glassFrame(){if(!root.isConnected)return;var age=performance.now()-glassBorn;var clarity=still?1:Math.max(0,Math.min(1,(age-1000)/6500));clarity=clarity*clarity*(3-2*clarity);window.dssWaltzGlass(glassCanvas,age,0,.35,still,clarity);glassRAF=requestAnimationFrame(glassFrame);}
  requestAnimationFrame(glassFrame);
  if(links)links.addEventListener('click',function(ev){var a=ev.target.closest('tw-link');if(!a||a.textContent.trim()!=='Waltz on to the light')return;
    if(music&&music.open)music.open(); /* 2026-10-19 overnight: the stub (no audio yet) has no open() */
    window._dssWaltzCarry={music:music,born:glassBorn,at:performance.now()};
    var cover=document.createElement('canvas');cover.width=360;cover.height=540;cover.getContext('2d').drawImage(glassCanvas,0,0);cover.id='wk-glass-crossing';var r=glassCanvas.getBoundingClientRect();cover.style.cssText='position:fixed;pointer-events:none;z-index:9999;left:'+r.left+'px;top:'+r.top+'px;width:'+r.width+'px;height:'+r.height+'px;transition:all 1800ms ease-in-out,opacity 1400ms ease 500ms';document.body.appendChild(cover);setTimeout(function(){cover.remove();},3400);
  },true);
  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var music = null, startMusic = function() { if (!music && window.dssWatkinsMuffled) music = window.dssWatkinsMuffled(); };
  var gen0 = null; setTimeout(function() { gen0 = window._passageGen; }, 150); // the counter moves just after a page's scripts run
  var stopper = setInterval(function() { if (gen0 === null) return; if (window._passageGen !== gen0 || !root.isConnected) { clearInterval(stopper); if (music && !music.claimed && !(window._dssWaltzCarry && window._dssWaltzCarry.music===music && performance.now()-window._dssWaltzCarry.at<4000)) music.stop(); cancelAnimationFrame(glassRAF); } }, 300);
  if (still) { root.classList.add('wk-done'); if (links) links.classList.add('wk-on'); setTimeout(startMusic, 1200); return; }
  root.classList.add('wk-run'); if (links) links.classList.add('wk-wait');
  var timers = [];
  function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
  function wrapText(p, unit) {
    var out = [];
    Array.prototype.slice.call(p.childNodes).forEach(function(n) {
      if (n.nodeType !== 3) return;
      var frag = document.createDocumentFragment(), parts = unit === 'char' ? n.nodeValue.split('') : n.nodeValue.split(/(\s+)/);
      parts.forEach(function(t) { if (!t) return; if (/^\s+$/.test(t)) { frag.appendChild(document.createTextNode(t)); return; } var sp = document.createElement('span'); sp.className = unit === 'char' ? 'wk-c' : 'wk-w'; sp.textContent = t; frag.appendChild(sp); out.push(sp); });
