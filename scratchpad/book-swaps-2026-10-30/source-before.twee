setInterval(function(){
  var container = document.getElementById('soho-map-container');
  if (container && !state) { try { init(container); } catch(e) { if (window.console) console.error('[sohoMap]', e); state = { alive:false, dispose:function(){} }; } }
  else if (!container && state) { try { state.dispose(); } catch(e) {} state = null; }
  else if (container && state && !container.querySelector('canvas')) { try { state.dispose(); } catch(e) {} state = null; }
}, 300);
window.dssSohoMap = { doors: DOORS, windows: BREAKABLE_WINDOWS, tiles: TILE, cols: COLS, rows: ROWS, get state() { return state; } };
})();

// ====== DEBUG / PLAYTESTING MENU (backtick ` key) ======
// Strategy: store target passage in URL hash, reload page.
// Before Harlowe boots, a separate inline script replaces the start passage
// content with a (go-to:) redirect to the target passage.
(function() {
var debugPanel = null;

function jumpTo(passageName) {
  // Store target in URL hash and reload — the early-boot script handles the rest
  window.location.hash = '#dss-debug-jump=' + encodeURIComponent(passageName);
  window.location.reload();
}

// -- Grouping rules ------------------------------------------------------
// A passage is assigned to exactly one group. Rules run in order; first match wins.
// Hub / core passages are listed by explicit name so they stay at the top.
var HUB_NAMES = {
  'Start':1,'Title':1,'Dawn':1,'The Interval':1,'The Night Ahead':1,
  'The Fetch':1,'Standing':1,'Dean Street':1,
  'A Doorway on Dean Street':1,'At the Corner of Dean Street and Greek Street':1
};
var OPENING_NAMES = {
  'The coast of Carthage':1,'Carthage shore':1,'Stay in Carthage':1,
  'Maritime interlude':1
};
var ENDING_NAMES = {
  'Alba Complete':1,'Alba Incomplete':1,
  'Name Your Book':1,'Dedicate Your Book':1
};
var PHONECALL_NAMES = {
  'The phone call':1,'Lily phone call 1':1,'The dual ring':1,'Dido':1,
  'No more':1,'None of us likes it!':1,
  'His round':1,'The Empty Glass':1,'The novelist':1
};
var DISPLAY_NAMES = {
  'Lily SVG':1,
  'LINE 1':1,'LINE 2':1,'LINE 2 Oxford':1,'LINE 3':1,
  'White page':1,'Black page':1
};
// Venue tag -> human label
var VENUE_LABELS = {
  'venue-french':'The French','venue-colony':'The Colony Room',
  'venue-coach':'The Coach & Horses','venue-ronnies':"Ronnie Scott's",
  'venue-trishas':"Trisha's",'venue-cecilcourt':'Cecil Court',
  'venue-cellar':'Cellar / Fight','venue-pillars':'Pillars of Hercules'
};
// Order groups appear in
var GROUP_ORDER = [
  'Hub','Opening','Approaches',
  'The French','The Colony Room','The Coach & Horses',
  'Pillars of Hercules',"Ronnie Scott's","Trisha's",
  'Cecil Court','Cellar / Fight',
  'Chinese Fish & Chips','Ping Pong',
  'Phone call / Dido','Endings','Displays & UI',
  'Other','Archive'
];
// Accent colour per group header (just for visual variety)
var GROUP_COLOURS = {
  'Hub':'#d4b050','Opening':'#9ab4c8','Approaches':'#b59866',
  'The French':'#c89a7a','The Colony Room':'#a85c5c',
  'The Coach & Horses':'#a67a4a','Pillars of Hercules':'#9a8a70',
  "Ronnie Scott's":'#a478b8',"Trisha's":'#b89a68',
  'Cecil Court':'#7aa67a','Cellar / Fight':'#8a5a5a',
  'Chinese Fish & Chips':'#c88a4a','Ping Pong':'#6aa4c8',
  'Phone call / Dido':'#88aaaa','Endings':'#d4a060',
  'Displays & UI':'#666','Other':'#888','Archive':'#555'
};

function classify(name, tags) {
  if (/^ARCHIVE-/.test(name)) return 'Archive';
  if (HUB_NAMES[name]) return 'Hub';
  if (OPENING_NAMES[name]) return 'Opening';
  if (ENDING_NAMES[name]) return 'Endings';
  if (PHONECALL_NAMES[name]) return 'Phone call / Dido';
  if (DISPLAY_NAMES[name]) return 'Displays & UI';
  if (/^Approach /i.test(name) || /Approach$/.test(name) || name === 'The Colony Room Door') return 'Approaches';
  if (/^PP /.test(name) || name === 'PP Pong' || name === 'Watch the decider') return 'Ping Pong';
  if (name === 'Chinese Fish and Chips') return 'Chinese Fish & Chips';
  // Tag-based
  for (var i = 0; i < tags.length; i++) {
    if (VENUE_LABELS[tags[i]]) return VENUE_LABELS[tags[i]];
  }
  // Fallback by name fragments
  if (/Pillars|Lackland|Maltese/i.test(name)) return 'Pillars of Hercules';
  if (/Jeffrey Bernard|Cow ride/i.test(name)) return 'The Coach & Horses';
  if (/Colony/i.test(name)) return 'The Colony Room';
  if (/Shana|Trisha/i.test(name)) return "Trisha's";
  if (/Ronnie|The Set|Bar Canvas/i.test(name)) return "Ronnie Scott's";
  if (/Cecil Court|Watkins|O['’]Flatterly|Rescue the page|Return the page/i.test(name)) return 'Cecil Court';
  if (/Fight|Beaten|Copper|Stand your ground|St\. John/i.test(name)) return 'Cellar / Fight';
  if (/French|Spanish Artist|Painter|Sketch|critic|novelist|agent|Artists/i.test(name)) return 'The French';
  return 'Other';
}

function createPanel() {
  if (debugPanel) { debugPanel.remove(); debugPanel = null; return; }
  var panel = document.createElement('div');
  panel.id = 'dss-debug';
  panel.style.cssText = 'position:fixed;top:0;right:0;width:360px;height:100vh;background:rgba(10,8,6,0.96);color:#c8b89a;font:13px/1.5 Georgia,serif;z-index:99999;overflow-y:auto;padding:16px;border-left:1px solid #3a2a1a;';

  var html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;"><strong style="color:#ea7a7a;letter-spacing:0.1em;">DEBUG MENU</strong><span id="dss-debug-close" style="cursor:pointer;color:#666;font-size:18px;">&times;</span></div>';

  // Current passage
  var cur = document.querySelector('tw-passage[data-name]');
  var curName = cur ? cur.getAttribute('data-name') : '(unknown)';
  html += '<div style="margin-bottom:12px;padding:8px;background:rgba(255,255,255,0.05);border-radius:4px;"><small style="color:#888;">Current passage:</small><br><strong>' + curName + '</strong></div>';

  // Collect + classify
  var passages = document.querySelectorAll('tw-passagedata');
  var groups = {};
  for (var j = 0; j < passages.length; j++) {
    var n = passages[j].getAttribute('name');
    if (!n || n === 'UserScript' || n === 'UserStylesheet' || n === 'StoryTitle' || n === 'StoryData') continue;
    var tagAttr = passages[j].getAttribute('tags') || '';
    var tags = tagAttr.split(/\s+/).filter(Boolean);
    var group = classify(n, tags);
    if (!groups[group]) groups[group] = [];
    groups[group].push(n);
  }
  var totalShown = 0, totalArchive = (groups['Archive'] || []).length;
  for (var g in groups) { if (g !== 'Archive') totalShown += groups[g].length; }

  // Tools (esoteric layer + tests)
  html += '<div style="margin:8px 0 6px;"><strong style="color:#d4b050;">Tools</strong></div>';
  html += '<div id="dss-dbg-tool-complete" style="padding:6px 10px;margin:2px 0;background:rgba(245,208,112,0.14);border:1px solid rgba(245,208,112,0.40);border-radius:3px;cursor:pointer;font-size:12px;color:#f5d070;">✦ Complete all (haunts + lilies + alba + objects) — jump to ending</div>';
  html += '<div id="dss-dbg-tool-reveal-pent" style="padding:6px 10px;margin:2px 0;background:rgba(212,176,80,0.10);border:1px solid rgba(212,176,80,0.25);border-radius:3px;cursor:pointer;font-size:12px;">⛤ Set 5 lilies + reveal pentangle on map</div>';
  html += '<div id="dss-dbg-tool-matchbook" style="padding:6px 10px;margin:2px 0;background:rgba(212,176,80,0.10);border:1px solid rgba(212,176,80,0.25);border-radius:3px;cursor:pointer;font-size:12px;">🚬 Give matchbook (test Cigarettes menu)</div>';
  html += '<div id="dss-dbg-tool-wipe" style="padding:6px 10px;margin:2px 0;background:rgba(234,122,122,0.10);border:1px solid rgba(234,122,122,0.3);border-radius:3px;cursor:pointer;font-size:12px;color:#ea9a9a;">⌫ Wipe autosave (reload to fresh title)</div>';
  // CROSSINGS (2026-09-14). The lifetime worlds list lives in localStorage under
  // dssWorldsSeenCycle and is what closes a key's world for good. Neither "Play
  // again" nor the autosave wipe touched it, so after a few nights of testing
  // every key you are likely to pick up is already spent and the third pillar
  // turns you back every time with "You have been down this one". Show it, and
  // give it a wipe of its own.
  html += '<div style="margin:8px 0 4px;font-size:11px;color:#9a8a70;">Dreams completed: <span id="dss-dbg-worlds" style="color:#d4b050;"></span></div>';
  html += '<div style="margin:2px 0 4px;font-size:11px;color:#9a8a70;">Voice trails walked: <span id="dss-dbg-trails" style="color:#d4b050;"></span></div>';
  // 2026-10-07 inner voices: every room's voice slots and flags, to check a line in place
  html += '<div id="dss-dbg-voices" style="margin:2px 0 8px;font-size:11px;color:#9a8a70;"></div>';
  // 2026-09-16, Sam: "add a way to wipe completed dream worlds for testing".
  // Completion lives in localStorage (dssLifetimeGifts, plus the legacy
  // dssLifetimeWorlds list) and survives Play again by design, so a tester in
  // the same browser could never see a first night twice. This clears both.
  // Dream Progress re-reads the store on the next passage; worlds completed
  // THIS night are re-added from $worldsVisited, so start a new game for a
  // truly clean run.
  html += '<div id="dss-dbg-tool-voices" style="padding:6px 10px;margin:2px 0;background:rgba(234,122,122,0.10);border:1px solid rgba(234,122,122,0.3);border-radius:3px;cursor:pointer;font-size:12px;color:#ea9a9a;">\u232b Forget the voices (trails and callbacks start again)</div>';
  html += '<div id="dss-dbg-tool-dreams" style="padding:6px 10px;margin:2px 0;background:rgba(234,122,122,0.10);border:1px solid rgba(234,122,122,0.3);border-radius:3px;cursor:pointer;font-size:12px;color:#ea9a9a;">\u232b Forget completed dreams (every key opens its world again)</div>';
  html += '<div id="dss-dbg-tool-notes" style="padding:6px 10px;margin:2px 0;background:rgba(122,200,160,0.14);border:1px solid rgba(122,200,160,0.40);border-radius:3px;cursor:pointer;font-size:12px;color:#bfe8d0;">&#9998; Playtest note (Shift+N anywhere) &middot; export &middot; clear</div>';
  html += '<div id="dss-dbg-tool-pentangle" style="padding:6px 10px;margin:2px 0;background:rgba(212,176,80,0.05);border:1px solid rgba(212,176,80,0.15);border-radius:3px;cursor:pointer;font-size:11px;color:#aa9070;">(legacy small overlay — for visual debug only)</div>';

  // Controls
  html += '<div style="margin:14px 0 8px;"><strong style="color:#d4b050;">Jump to Passage</strong></div>';
  html += '<input id="dss-dbg-search" type="text" placeholder="Type to filter..." style="width:100%;box-sizing:border-box;padding:6px 8px;background:#1a1410;color:#c8b89a;border:1px solid #3a2a1a;border-radius:3px;font:12px Georgia,serif;margin-bottom:6px;">';
  html += '<label style="display:flex;align-items:center;gap:6px;font-size:11px;color:#888;margin-bottom:10px;cursor:pointer;user-select:none;">' +
          '<input type="checkbox" id="dss-dbg-archive" style="margin:0;"> show ' + totalArchive + ' archived passages</label>';
  html += '<div style="font-size:11px;color:#666;margin-bottom:8px;">' + totalShown + ' passages, grouped by venue</div>';

  html += '<div id="dss-dbg-passages">';
  for (var o = 0; o < GROUP_ORDER.length; o++) {
    var gname = GROUP_ORDER[o];
    var list = groups[gname];
    if (!list || !list.length) continue;
    list.sort();
    var colour = GROUP_COLOURS[gname] || '#888';
    var extraClass = (gname === 'Archive') ? ' dss-dbg-archive-grp' : '';
    html += '<div class="dss-dbg-grp' + extraClass + '" data-group="' + gname + '" style="margin-top:12px;">';
    html += '<div style="font:600 11px/1.4 Georgia,serif;letter-spacing:0.1em;text-transform:uppercase;color:' + colour + ';border-bottom:1px solid rgba(200,170,100,0.18);padding-bottom:3px;margin-bottom:4px;">' + gname + ' <span style="color:#555;font-weight:400;">(' + list.length + ')</span></div>';
    for (var k = 0; k < list.length; k++) {
      var displayName = list[k].replace(/^ARCHIVE-/, '');
      html += '<div class="dss-dbg-jump" data-passage="' + list[k].replace(/"/g, '&quot;') + '" style="padding:4px 8px;margin:1px 0;background:rgba(255,255,255,0.03);border-radius:2px;cursor:pointer;font-size:12px;">' + displayName + '</div>';
    }
    html += '</div>';
  }
  html += '</div>';

  panel.innerHTML = html;
  document.body.appendChild(panel);
  debugPanel = panel;

  document.getElementById('dss-debug-close').addEventListener('click', function() { panel.remove(); debugPanel = null; });

  // Tool buttons
  var toolReveal = document.getElementById('dss-dbg-tool-reveal-pent');
  if (toolReveal) toolReveal.addEventListener('click', function() {
    // Force-replay the pentangle reveal. JS can't set Harlowe lily flags
    // (window.Harlowe isn't exposed), but dssRevealPentangleOnMap() forces the
    // map reveal regardless; clearing the session "seen" flag lets it fire again.
    window._dssSawPentangle = false;
    try { sessionStorage.removeItem('dssMapHintDone'); } catch(e) {}
    panel.remove(); debugPanel = null;
    setTimeout(function() {
      if (window.dssRevealPentangleOnMap) window.dssRevealPentangleOnMap();
    }, 150);
  });
  var toolComplete = document.getElementById('dss-dbg-tool-complete');
  if (toolComplete) toolComplete.addEventListener('click', function() {
    jumpTo('DBG Complete');
  });
  var toolMatchbook = document.getElementById('dss-dbg-tool-matchbook');
  if (toolMatchbook) toolMatchbook.addEventListener('click', function() {
    jumpTo('DBG Matchbook');
  });
  var toolWipe = document.getElementById('dss-dbg-tool-wipe');
  if (toolWipe) toolWipe.addEventListener('click', function() {
    if (!confirm('Wipe the autosave and reload to a fresh title? You will lose your in-progress night.')) return;
    try {
      var keys = [];
      for (var i = 0; i < localStorage.length; i++) keys.push(localStorage.key(i));
      keys.forEach(function(k){ if (/Saved Game/.test(k)) localStorage.removeItem(k); });
    } catch(e) {}
    // Strip any debug-jump hash so reload truly goes to title.
    window.location.hash = '';
    window.location.reload();
  });
  var worldsOut = document.getElementById('dss-dbg-worlds');
  if (worldsOut) {
    var lw = (window.dssLoadLifetimeGifts && window.dssLoadLifetimeGifts()) || [];
    worldsOut.textContent = lw.length ? lw.join(', ') : 'none';
  }
  var trailsOut = document.getElementById('dss-dbg-trails');
  function showTrails() {
    if (!trailsOut || !window.DSS_VOICES || !window.dssVoices) return;
    var T = window.DSS_VOICES.trails, out = [];
    for (var k in T) out.push(k + ' ' + T[k].steps.filter(function(s) { return window.dssVoices.has(s.at); }).length + '/' + T[k].steps.length);
    trailsOut.textContent = out.join(', ');
  }
  showTrails();
  // VOICES, ROOM BY ROOM: pick a room, see each object's slots (the one showing now is bright), what each waits on,
  // and whether the object counts as seen (click to flip it, to try a trail or a callback); "Open" jumps to the room
  var voicesOut = document.getElementById('dss-dbg-voices'), voicesRoom = null;
  function escD(t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }
  function showVoices() {
    if (!voicesOut || !window.DSS_VOICES || !window.dssVoices) return;
    var DV = window.dssVoices, N = DV.roomNames, h = '<div style="margin-bottom:4px;">Voices, room by room:</div>';
    Object.keys(window.DSS_VOICES.objects).forEach(function(r) {
      h += '<button type="button" class="dss-dbg-vroom" data-room="' + r + '" style="margin:1px 2px;padding:2px 6px;font-size:11px;background:' + (r === voicesRoom ? 'rgba(212,176,80,0.25)' : 'rgba(255,255,255,0.04)') + ';color:#c8b89a;border:1px solid #3a2a1a;border-radius:2px;cursor:pointer;">' + escD(N[r] || r) + '</button>';
    });
    if (voicesRoom) {
      h += '<div style="margin:6px 0 2px;"><span class="dss-dbg-jump" data-passage="' + escD(DV.roomPassages[voicesRoom]) + '" role="button" tabindex="0" style="color:#d4b050;cursor:pointer;text-decoration:underline;">Open ' + escD(N[voicesRoom]) + '</span>' + (DV.idAwake() ? ' · the id is awake' : ' · the id is asleep') + '</div>';
      Object.keys(window.DSS_VOICES.objects[voicesRoom]).forEach(function(name) {
        var path = voicesRoom + '/' + name, seen = DV.has(path);
        h += '<div style="margin-top:5px;color:#c8b89a;">' + escD(name) + ' <button type="button" class="dss-dbg-vseen" data-path="' + escD(path) + '" title="Click to flip" style="font-size:10px;padding:0 5px;background:none;color:' + (seen ? '#9fd8ab' : '#7a6a58') + ';border:1px solid #3a2a1a;border-radius:2px;cursor:pointer;">' + (seen ? 'seen' : 'not seen') + '</button></div>';
        DV.slots(voicesRoom, name).forEach(function(sl) {
          h += '<div style="margin-left:10px;opacity:' + (sl.showing ? 1 : 0.5) + ';">' + (sl.showing ? '● ' : '○ ') + sl.voice + ' (' + sl.kind + ', ' + escD(sl.when) + '): <span style="color:' + (sl.text.indexOf('[Sam:') >= 0 ? '#ff3aa8' : '#e8e2d2') + ';">' + escD(sl.text || '(quiet)') + '</span></div>';
        });
      });
    }
    voicesOut.innerHTML = h;
  }
  if (voicesOut) voicesOut.addEventListener('click', function(e) {
    var b = e.target.closest('.dss-dbg-vroom, .dss-dbg-vseen');
    if (!b) return;
    if (b.classList.contains('dss-dbg-vroom')) voicesRoom = voicesRoom === b.getAttribute('data-room') ? null : b.getAttribute('data-room');
    else { var pth = b.getAttribute('data-path'); if (window.dssVoices.has(pth)) window.dssVoices.unsee(pth); else window.dssVoices.see(pth); showTrails(); }
    showVoices();
  });
  showVoices();
  var toolVoices = document.getElementById('dss-dbg-tool-voices');
  if (toolVoices) toolVoices.addEventListener('click', function() {
    if (!confirm('Forget every object the voices have seen (trails and callbacks start again)?')) return;
    if (window.dssVoices) window.dssVoices.forget();
    showTrails(); showVoices();
  });
  var toolDreams = document.getElementById('dss-dbg-tool-dreams');
  if (toolDreams) toolDreams.addEventListener('click', function() {
    var lw = (window.dssLoadLifetimeGifts && window.dssLoadLifetimeGifts()) || [];
    if (!confirm('Forget the completed dreams (' + (lw.length ? lw.join(', ') : 'none recorded') + ')?\n\nTheir keys return to the venues and the Synthesis count drops to zero. Takes effect on the next passage; for a clean first night, start a new game afterwards.')) return;
    if (window.dssClearLifetimeGifts) window.dssClearLifetimeGifts();
    try { localStorage.removeItem(window.DSS_WORLDS_KEY); } catch(e) {}
    if (worldsOut) worldsOut.textContent = 'none';
  });
  var toolPent = document.getElementById('dss-dbg-tool-pentangle');
  if (toolPent) toolPent.addEventListener('click', function() {
    if (window.dssShowPentangleOverlay) window.dssShowPentangleOverlay();
  });
  var toolNotes = document.getElementById('dss-dbg-tool-notes');
  if (toolNotes) toolNotes.addEventListener('click', function() { if (window.dssPlaytestNote) window.dssPlaytestNote(); });

  // Archive toggle
  var archiveGrps = panel.querySelectorAll('.dss-dbg-archive-grp');
  for (var a = 0; a < archiveGrps.length; a++) archiveGrps[a].style.display = 'none';
  document.getElementById('dss-dbg-archive').addEventListener('change', function() {
    var show = this.checked;
    var els = panel.querySelectorAll('.dss-dbg-archive-grp');
    for (var i = 0; i < els.length; i++) els[i].style.display = show ? '' : 'none';
  });

  // Search filter — hides items and empty groups
  document.getElementById('dss-dbg-search').addEventListener('input', function() {
    var q = this.value.toLowerCase();
    var grps = panel.querySelectorAll('.dss-dbg-grp');
    var showArchive = document.getElementById('dss-dbg-archive').checked;
    for (var i = 0; i < grps.length; i++) {
      var isArchive = grps[i].classList.contains('dss-dbg-archive-grp');
      if (isArchive && !showArchive) { grps[i].style.display = 'none'; continue; }
      var items = grps[i].querySelectorAll('.dss-dbg-jump');
      var any = false;
      for (var j = 0; j < items.length; j++) {
        var match = items[j].getAttribute('data-passage').toLowerCase().indexOf(q) >= 0;
        items[j].style.display = match ? '' : 'none';
        if (match) any = true;
      }
      grps[i].style.display = any ? '' : 'none';
    }
  });

  panel.addEventListener('click', function(e) {
    if (e.target.classList.contains('dss-dbg-jump')) {
      jumpTo(e.target.getAttribute('data-passage'));
    }
  });

  panel.addEventListener('mouseover', function(e) { if (e.target.classList.contains('dss-dbg-jump')) e.target.style.background = 'rgba(212,176,80,0.15)'; });
  panel.addEventListener('mouseout', function(e) { if (e.target.classList.contains('dss-dbg-jump')) e.target.style.background = 'rgba(255,255,255,0.03)'; });
}

/* ── DEV FLAG ── the debug panel (backtick), the three dream-game skip links
   and the climb's summit key all hang off this. It is OPT-IN now (2026-09-01,
   release hygiene): on for localhost, or with ?dev=1 in the URL (remembered
   in localStorage until ?dev=0), never on for a plain visit to the live site.
   The hash-jump boot hook (in the html's injected script) stays ungated — it
   needs a hand-typed URL and doubles as the session test harness. */
window.DSS_DEV = (function(){
  try {
    var m = location.search.match(/[?&]dev=([01])/);
    if (m) localStorage.setItem('dssDev', m[1]);
    if (localStorage.getItem('dssDev') === '1') return true;
    if (localStorage.getItem('dssDev') === '0') return false;
  } catch(e) {}
  return /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
})();
document.addEventListener('keydown', function(e) {
  if (window.DSS_DEV && e.key === '`') { e.preventDefault(); createPanel(); }
});
})();

/* ====== PLAYTEST NOTES (2026-10-18, Sam: "a key that saves a note stamped with the passage you're in") ======
   Dev only (localhost, or ?dev=1 on the live site). Shift+N anywhere opens a small box: type, Enter saves
   (Shift+Enter for a new line), Escape cancels. Each note is stamped with the time, the passage name (read
   from the header's hidden #dss-pn print) and its tags, and kept in this browser's localStorage under
   'dssPlaytestNotes'. The box also lists the count and offers Export (a dated .md download, also copied to
   the clipboard) and Clear. While the box is open, keys stop here, so the game never sees them. */
(function() {
  var KEY = 'dssPlaytestNotes', open = null;
  function load() { try { return JSON.parse(localStorage.getItem(KEY) || '[]') || []; } catch(e) { return []; } }
  function save(list) { try { localStorage.setItem(KEY, JSON.stringify(list)); return true; } catch(e) { return false; } }
  function where() {
    var pn = document.getElementById('dss-pn'), p = document.querySelector('tw-story > tw-passage');
    return { passage: pn ? pn.textContent.trim() : '(unknown passage)', tags: p ? (p.getAttribute('tags') || '') : '' };
  }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function stamp(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()); }
  function asMarkdown(list) {
    var out = '# Dream Street Shuffle playtest notes\n\nExported ' + stamp(new Date()) + ', ' + list.length + ' note' + (list.length === 1 ? '' : 's') + '.\n\n';
    list.forEach(function(n, i) {
      out += (i + 1) + '. **' + n.passage + '**' + (n.tags ? ' (' + n.tags + ')' : '') + ', ' + n.time + '\n   ' + String(n.note).replace(/\n/g, '\n   ') + '\n';
    });
    return out;
  }
  function exportNotes(msg) {
    var list = load(); if (!list.length) { msg('No notes yet.'); return; }
    var md = asMarkdown(list), d = new Date(), name = 'dss-playtest-notes-' + d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + '.md';
    try { if (navigator.clipboard) navigator.clipboard.writeText(md).catch(function(){}); } catch(e) {}
    try {
      var url = URL.createObjectURL(new Blob([md], { type: 'text/markdown' })), a = document.createElement('a');
      a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(function() { URL.revokeObjectURL(url); }, 2000);
      msg('Exported ' + list.length + ' note' + (list.length === 1 ? '' : 's') + ' to ' + name + ' (also on the clipboard).');
    } catch(e) { msg('Download failed; the notes are on the clipboard.'); }
  }
  function toast(text) {
    var t = document.createElement('div'); t.textContent = text;
    t.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%);z-index:2147483001;background:#173126;color:#d8f2e2;border:1px solid #4f9a76;border-radius:6px;padding:8px 14px;font:13px/1.3 system-ui,sans-serif;pointer-events:none;opacity:1;transition:opacity .4s';
    document.body.appendChild(t); setTimeout(function() { t.style.opacity = '0'; }, 1400); setTimeout(function() { t.remove(); }, 1900);
  }
  function close() { if (!open) return; window.removeEventListener('keydown', open.trap, true); open.el.remove(); open = null; }
  function show() {
    if (open) { open.ta.focus(); return; }
    var w = where(), el = document.createElement('div');
    el.id = 'dss-playtest-note';
    el.style.cssText = 'position:fixed;inset:0;z-index:2147483000;background:rgba(0,0,0,.45);display:flex;align-items:flex-start;justify-content:center;padding:12vh 16px 16px';
    el.innerHTML = '<div style="width:min(520px,100%);background:#141a17;color:#e6efe9;border:1px solid #4f9a76;border-radius:8px;padding:14px 16px;font:14px/1.45 system-ui,sans-serif;box-shadow:0 10px 40px rgba(0,0,0,.5)">' +
      '<div style="font-size:11px;letter-spacing:.12em;color:#8fd0ad;margin-bottom:6px">PLAYTEST NOTE</div>' +
      '<div class="pn-where" style="font-size:12px;color:#a9bdb1;margin-bottom:8px"></div>' +
      '<textarea rows="4" style="width:100%;box-sizing:border-box;background:#0d1210;color:#f2f7f4;border:1px solid #3c6a55;border-radius:5px;padding:8px;font:14px/1.4 system-ui,sans-serif;resize:vertical"></textarea>' +
      '<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px">' +
        '<button type="button" class="pn-save" style="background:#2f7a57;color:#fff;border:0;border-radius:5px;padding:7px 12px;cursor:pointer;font:13px system-ui,sans-serif">Save (Enter)</button>' +
        '<button type="button" class="pn-cancel" style="background:transparent;color:#cfe3d7;border:1px solid #3c6a55;border-radius:5px;padding:7px 12px;cursor:pointer;font:13px system-ui,sans-serif">Cancel (Esc)</button>' +
        '<span style="flex:1"></span>' +
        '<span class="pn-count" style="font-size:12px;color:#a9bdb1"></span>' +
        '<button type="button" class="pn-export" style="background:transparent;color:#8fd0ad;border:1px solid #3c6a55;border-radius:5px;padding:7px 10px;cursor:pointer;font:12px system-ui,sans-serif">Export</button>' +
        '<button type="button" class="pn-clear" style="background:transparent;color:#e3a3a3;border:1px solid #6a3c3c;border-radius:5px;padding:7px 10px;cursor:pointer;font:12px system-ui,sans-serif">Clear</button>' +
      '</div><div class="pn-msg" style="font-size:12px;color:#8fd0ad;margin-top:8px;min-height:1em"></div></div>';
    el.querySelector('.pn-where').textContent = w.passage + (w.tags ? '  ·  ' + w.tags : '');
    document.body.appendChild(el);
    var ta = el.querySelector('textarea'), msg = function(t) { el.querySelector('.pn-msg').textContent = t; };
    var count = function() { var n = load().length; el.querySelector('.pn-count').textContent = n + ' saved'; };
    count();
    function commit() {
      var text = ta.value.trim(); if (!text) { close(); return; }
      var list = load(); list.push({ time: stamp(new Date()), passage: w.passage, tags: w.tags, note: text });
      if (save(list)) { close(); toast('Noted (' + list.length + ')'); } else msg('Could not save: this browser blocks local storage.');
    }
    var trap = function(e) {
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); return; }
      if (e.key === 'Enter' && !e.shiftKey && document.activeElement === ta) { e.preventDefault(); e.stopPropagation(); commit(); return; }
      e.stopPropagation(); /* everything else stays in the box; the game never sees it */
    };
    window.addEventListener('keydown', trap, true);
    el.addEventListener('mousedown', function(e) { if (e.target === el) close(); });
    el.querySelector('.pn-save').onclick = commit;
    el.querySelector('.pn-cancel').onclick = close;
    el.querySelector('.pn-export').onclick = function() { exportNotes(msg); };
    el.querySelector('.pn-clear').onclick = function() { if (!load().length) { msg('Nothing to clear.'); return; } if (confirm('Delete all ' + load().length + ' playtest notes from this browser? Export first if you want them.')) { save([]); count(); msg('Cleared.'); } };
    open = { el: el, ta: ta, trap: trap };
    setTimeout(function() { ta.focus(); }, 0);
  }
  window.dssPlaytestNote = show;
  window.dssPlaytestNotes = { list: load, exportMarkdown: function() { return asMarkdown(load()); } };
  document.addEventListener('keydown', function(e) {
    if (!window.DSS_DEV || open) return;
    if (!(e.key === 'N' && e.shiftKey) || e.ctrlKey || e.metaKey || e.altKey) return;
    var a = document.activeElement, tag = a && a.tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (a && a.isContentEditable)) return;
    e.preventDefault(); e.stopPropagation(); show();
  }, true);
})();

// ====== COIN FLIP POPUP (notebook) ======
window.showCoinModal = function(opts) {
  var mode = opts.mode || "free", max = opts.maxToss || (mode === "free" ? 3 : 1), tc = 0, cb = opts.onResult || function() {};
  var o = document.createElement("div");
  o.id = "coin-overlay";
  var h = '<div class="coin-overlay-box"><div class="coin-overlay-stage"><div class="coin-overlay-disc" id="cm-d"><div class="cp-face cp-heads"></div><div class="cp-face cp-tails"></div></div></div>';
  if (mode === "decide" && opts.label1) h += '<div class="coin-gate-labels"><div class="coin-gate-label cg-h">Heads: ' + opts.label1 + '</div><div class="coin-gate-label cg-t">Tails: ' + opts.label2 + '</div></div>';
  h += '<button class="coin-overlay-btn" id="cm-b">Toss it</button><span class="coin-overlay-result" id="cm-r"></span></div>';
  o.innerHTML = h;
  document.body.appendChild(o);
  var d = document.getElementById("cm-d"), r = document.getElementById("cm-r"), b = document.getElementById("cm-b"), st = o.querySelector(".coin-overlay-stage");
  b.addEventListener("click", function() {
    if (d.classList.contains("cp-flipping")) return;
    if (window.dssAudio) window.dssAudio.coinFlip();
    tc++;
    var heads = (opts.forceResult !== null && opts.forceResult !== undefined) ? opts.forceResult : (Math.floor(Math.random() * 2) === 0), ed = heads ? "1440deg" : "1620deg", rd = heads ? "0deg" : "180deg";
    d.style.setProperty("--cp-end", ed);
    d.classList.remove("cp-flipping");
    void d.offsetWidth;
    d.classList.add("cp-flipping");
    for (var i = 0; 12 > i; i++) {
      var s = document.createElement("div");
      s.className = "cp-spark";
      var a = Math.random() * 360, dist = 60 + Math.random() * 40;
      s.style.setProperty("--sx", (Math.cos(a * Math.PI / 180) * dist) + "px");
      s.style.setProperty("--sy", (Math.sin(a * Math.PI / 180) * dist) + "px");
      s.style.animationDelay = (Math.random() * 0.3) + "s";
      s.style.animationDuration = (0.5 + Math.random() * 0.5) + "s";
      st.appendChild(s);
      setTimeout(function(el) { el.remove(); }, 1200, s);
    }
    r.textContent = "";
    b.classList.add("coin-btn-hidden");
    setTimeout(function() {
      r.textContent = heads ? "Heads." : "Tails.";
      d.style.transform = "rotateX(" + rd + ")";
      d.classList.remove("cp-flipping");
      if (mode === "decide") {
        var hl = o.querySelector(".cg-h"), tl = o.querySelector(".cg-t");
        if (hl && tl) {
          if (heads) { hl.style.color = "#c8a86a"; tl.style.opacity = "0.3"; }
          else { tl.style.color = "#c8a86a"; hl.style.opacity = "0.3"; }
        }
        setTimeout(function() { o.classList.add("coin-overlay-fade"); setTimeout(function() { o.remove(); cb(heads); }, 800); }, 1800);
      } else if (tc >= max) {
        setTimeout(function() {
          var ni = document.querySelector('.nb-coin-img');
          if (ni) ni.src = heads ? '__DSS_COIN_HEADS_DATA_URI__' : '__DSS_COIN_TAILS_DATA_URI__';
          o.classList.add("coin-overlay-fade");
          setTimeout(function() { o.remove(); }, 800);
        }, 1800);
      } else {
        setTimeout(function() { r.textContent = ""; b.classList.remove("coin-btn-hidden"); b.textContent = "Toss again"; }, 2200);
      }
    }, 2000);
  });
  if (opts.autoToss) { b.classList.add("coin-btn-hidden"); b.click(); }
};

// Reset coinGateUsed each time a new passage renders,
// so the coin flip works on every passage that has one.
(new MutationObserver(function() { window.coinGateUsed = false; }))
  .observe(document.querySelector('tw-story') || document.body, { childList: true });

// Track which coin gate option was chosen, keyed by the two option texts.
// On a return visit, the coin will land on the option you DIDN'T pick last time.
if (!window._coinGateHistory) window._coinGateHistory = {};

window.coinGate = function(t1, t2, firstAlwaysHeads) {
  if (window.coinGateUsed) return;
  // You cannot flip a coin you have not got (Sam, 2026-09-13). Harlowe state is
  // not exposed to plain JS in this build, so the passage prints $hasCoin into a
  // hidden span and we read that. No coin -> no gate at all, and the player picks
  // a door for themselves. That is also what happens if they have spent the
  // Donkey at the phone box, which is the trade they chose.
  try {
    var cf = document.querySelector('.dss-coin-flag');
    if (cf && cf.textContent.trim() !== '1') return;
  } catch (e) {}
  var links = document.querySelectorAll("tw-link"), l1 = null, l2 = null;
  for (var i = 0; links.length > i; i++) {
    var t = links[i].textContent.trim();
    if (t === t1 && !l1) l1 = links[i];
    if (t === t2 && !l2) l2 = links[i];
  }
  if (!l1 || !l2) return;
  l1.style.pointerEvents = "none"; l1.classList.add("coin-gated");
  l2.style.pointerEvents = "none"; l2.classList.add("coin-gated");
  var w = document.createElement("div");
  w.className = "coin-gate-wrap";
  w.innerHTML = '<div class="coin-gate-hint">The Donkey will decide.</div><button class="coin-gate-btn">Toss the Donkey</button>';
  var p = l2.closest("tw-expression") || l2.parentElement;
  if (p && p.parentElement) p.parentElement.insertBefore(w, p.nextSibling);
  var historyKey = t1 + '|||' + t2;
  w.querySelector(".coin-gate-btn").addEventListener("click", function() {
    // Check if we've been here before — if so, force the other option.
    // If firstAlwaysHeads is true and we have no history yet, force heads
    // (i.e. always pick t1 the first time at this gate).
    var lastPick = window._coinGateHistory[historyKey];
    var forceHeads = null;
    if (lastPick === 'heads') forceHeads = false;  // last time was heads (t1), now force tails (t2)
    else if (lastPick === 'tails') forceHeads = true; // last time was tails (t2), now force heads (t1)
    else if (firstAlwaysHeads) forceHeads = true;     // first toss at this gate — rig to t1
    window.showCoinModal({ mode: "decide", label1: t1, label2: t2, autoToss: true, forceResult: forceHeads, onResult: function(isH) {
      window.coinGateUsed = true;
      window._coinGateHistory[historyKey] = isH ? 'heads' : 'tails';
      var c = isH ? l1 : l2;
      c.style.pointerEvents = ""; c.classList.remove("coin-gated"); c.click();
    }});
  });
};

window.flipCoinPopup = function() {
  window.showCoinModal({ mode: "free", maxToss: 1, autoToss: true });
};

// ====== VENUE HINT POPUP ======
window.venueHintPopup = function() {
  // DEMOTED 2026-09-13 (Sam: "All the popups are too much"). Was a full-screen
  // "A WORD TO THE WISE" overlay carrying a five-row legend of the door marks.
  // The legend is dropped here rather than moved, because the notebook already
  // carries exactly the same ten glyphs in its .nb-key block, permanently and
  // on demand. What is left is the one thing the notebook does not say.
  // 2026-10-12 (Sam, the slip review 2 of 14): cut. It said "If a venue is still open it means there is more to explore there.
  // Have another look. The key to the door marks is in your notebook." The callers stay; the hint is now silent.
};


// ====== POCKET-KEY POPUP (2026-09-12) ======
// The five pocket-keys used to be offered as a line of pink prose plus a link
// sitting UNDERNEATH the venue's own links, where players simply missed them
// (Sam, after a play session: "they were often hidden below the link"). The
// offer is now parked off-screen in the passage (.dss-key-offer) and presented
// here as a tactile decision in the coin/match pickup style: take it, swap it
// for whatever is already in your pocket, or leave it.
// Clicking a button clicks the parked Harlowe (link:) hook, which is the only
// way this build can write Harlowe state from JS. That hook replaces itself in
// place off-screen, so its confirmation prose is read back out of the parked
// container and shown in the popup rather than being lost behind the curtain.
window.DSS_KEY_ART = {cocaine:'<svg class="nb-inv-keyobj" viewBox="0 0 100 80" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkWrapP" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f4ecd8"/><stop offset="1" stop-color="#cdc1a2"/></linearGradient></defs><ellipse cx="50" cy="69" rx="27" ry="3" fill="rgba(0,0,0,0.3)"/><g transform="rotate(-7 50 42)"><path d="M26,22 L74,22 L78,58 L22,58 Z" fill="url(#pkWrapP)" stroke="rgba(120,100,70,0.6)" stroke-width="1" stroke-linejoin="round"/><path d="M26,22 L50,41 L74,22" fill="none" stroke="rgba(120,100,70,0.5)" stroke-width="0.9"/><path d="M22,58 L50,41 L78,58" fill="none" stroke="rgba(120,100,70,0.34)" stroke-width="0.7"/><g opacity="0.4"><line x1="30" y1="27" x2="44" y2="27" stroke="#6a5a3a" stroke-width="0.8"/><line x1="57" y1="27" x2="70" y2="27" stroke="#6a5a3a" stroke-width="0.8"/><line x1="28" y1="49" x2="40" y2="49" stroke="#6a5a3a" stroke-width="0.8"/><line x1="60" y1="49" x2="72" y2="49" stroke="#6a5a3a" stroke-width="0.8"/><line x1="26" y1="53" x2="37" y2="53" stroke="#6a5a3a" stroke-width="0.7"/><line x1="62" y1="53" x2="74" y2="53" stroke="#6a5a3a" stroke-width="0.7"/></g><path d="M74,22 L78,58 L69,51 Z" fill="rgba(158,138,102,0.34)"/><path d="M27,24 L31,26" stroke="rgba(255,255,255,0.4)" stroke-width="0.7"/></g></svg>',ticket:'<svg class="nb-inv-keyobj" viewBox="0 0 90 100" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkTkt" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fdf6e2"/><stop offset="1" stop-color="#e0d3ae"/></linearGradient></defs><ellipse cx="45" cy="91" rx="23" ry="2.6" fill="rgba(0,0,0,0.26)"/><g transform="rotate(4 45 52)"><path d="M24,14 L28,18 L24,22 L28,26 L24,30 L66,30 L66,86 L24,86 Z" fill="url(#pkTkt)" stroke="rgba(130,105,60,0.55)" stroke-width="0.8" stroke-linejoin="round"/><line x1="29" y1="36" x2="61" y2="36" stroke="rgba(60,45,20,0.28)" stroke-width="0.5"/><text x="45" y="60" text-anchor="middle" font-family="Georgia,serif" font-weight="bold" font-size="21" fill="rgba(150,32,24,0.82)">31</text><g opacity="0.5" stroke="rgba(50,40,25,0.85)" stroke-width="1" stroke-linecap="round" fill="none"><path d="M33,70 L47,70 M40,66 L40,78 M35,76 L45,76"/><path d="M53,68 L61,68 M57,65 L57,78 M52,74 L62,74"/></g><circle cx="56" cy="82" r="7" fill="rgba(150,120,60,0.17)"/><circle cx="56" cy="82" r="3.6" fill="rgba(150,120,60,0.14)"/><circle cx="31" cy="79" r="3" fill="rgba(150,120,60,0.1)"/></g></svg>',slip:'<svg class="nb-inv-keyobj" viewBox="0 0 116 78" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkSlip" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f6eccd"/><stop offset="1" stop-color="#ddcda4"/></linearGradient></defs><ellipse cx="58" cy="70" rx="33" ry="2.8" fill="rgba(0,0,0,0.25)"/><g transform="rotate(-3 58 40)"><rect x="16" y="14" width="84" height="48" rx="1.5" fill="url(#pkSlip)" stroke="rgba(128,102,58,0.6)" stroke-width="0.9"/><rect x="19" y="17" width="78" height="42" fill="none" stroke="rgba(150,40,32,0.42)" stroke-width="0.6"/><text x="58" y="28" text-anchor="middle" font-family="Georgia,serif" font-size="5.2" letter-spacing="1.2" fill="rgba(150,40,32,0.7)">TO WIN</text><line x1="24" y1="33" x2="92" y2="33" stroke="rgba(60,45,20,0.26)" stroke-width="0.5"/><text x="26" y="42" font-family="Georgia,serif" font-style="italic" font-size="8.5" fill="rgba(48,34,16,0.82)">Gallowglass</text><line x1="24" y1="47" x2="92" y2="47" stroke="rgba(60,45,20,0.22)" stroke-width="0.5"/><text x="26" y="55" font-family="Georgia,serif" font-size="5.6" fill="rgba(48,34,16,0.6)">4.30  KEMPTON</text><text x="84" y="55" text-anchor="end" font-family="Georgia,serif" font-size="5.6" fill="rgba(48,34,16,0.6)">10/1</text><circle cx="80" cy="40" r="15" fill="none" stroke="rgba(126,92,40,0.28)" stroke-width="2.4"/><circle cx="80" cy="40" r="15" fill="rgba(150,116,58,0.07)"/></g></svg>',lighter:'<svg class="nb-inv-keyobj" viewBox="0 0 70 104" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="pkBrass" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#7d5f1c"/><stop offset="0.22" stop-color="#d9b45c"/><stop offset="0.46" stop-color="#f4e0a4"/><stop offset="0.72" stop-color="#c49a3c"/><stop offset="1" stop-color="#684d14"/></linearGradient><linearGradient id="pkBrassLid" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#8d6c22"/><stop offset="0.24" stop-color="#e6c674"/><stop offset="0.5" stop-color="#f7e6b0"/><stop offset="0.74" stop-color="#cfa646"/><stop offset="1" stop-color="#725417"/></linearGradient></defs><ellipse cx="35" cy="81" rx="16" ry="2.4" fill="rgba(0,0,0,0.34)"/><rect x="19" y="29" width="32" height="15.4" rx="2.6" fill="url(#pkBrassLid)" stroke="rgba(70,50,12,0.75)" stroke-width="0.8"/><rect x="19" y="43.6" width="32" height="35.4" rx="2.6" fill="url(#pkBrass)" stroke="rgba(70,50,12,0.75)" stroke-width="0.8"/><line x1="19.4" y1="44.4" x2="50.6" y2="44.4" stroke="rgba(52,38,8,0.75)" stroke-width="1.1"/><line x1="19.4" y1="43" x2="50.6" y2="43" stroke="rgba(255,244,206,0.28)" stroke-width="0.6"/><rect x="15.9" y="40.4" width="4.6" height="7.4" rx="2.3" fill="url(#pkBrassLid)" stroke="rgba(60,44,10,0.8)" stroke-width="0.6"/><line x1="18.2" y1="41.6" x2="18.2" y2="46.6" stroke="rgba(60,44,10,0.45)" stroke-width="0.5"/><rect x="21.6" y="46.6" width="26.8" height="29.6" rx="1.6" fill="none" stroke="rgba(255,238,190,0.2)" stroke-width="0.7"/><text x="35" y="58.5" text-anchor="middle" font-family="Georgia,serif" font-size="4.4" letter-spacing="0.15" fill="rgba(70,50,12,0.5)">Property of</text><text x="35" y="67.5" text-anchor="middle" font-family="Georgia,serif" font-size="5.2" letter-spacing="0.3" fill="rgba(70,50,12,0.5)">J. St John</text><path d="M22.6,31.6 L22.6,41.6" stroke="rgba(255,246,214,0.32)" stroke-width="1.5" stroke-linecap="round"/><path d="M22.6,47.6 L22.6,74.6" stroke="rgba(255,246,214,0.3)" stroke-width="1.5" stroke-linecap="round"/><line x1="24" y1="76.6" x2="46" y2="76.6" stroke="rgba(60,44,10,0.35)" stroke-width="0.5"/></svg>',eye:'<svg class="nb-inv-keyobj" viewBox="0 0 96 96" xmlns="http://www.w3.org/2000/svg"><defs><radialGradient id="pkSclera" cx="38%" cy="32%" r="72%"><stop offset="0" stop-color="#ffffff"/><stop offset="0.55" stop-color="#f0ece0"/><stop offset="1" stop-color="#c6bda8"/></radialGradient><radialGradient id="pkIris" cx="42%" cy="36%" r="62%"><stop offset="0" stop-color="#a8d69a"/><stop offset="0.5" stop-color="#3f8048"/><stop offset="1" stop-color="#15391d"/></radialGradient></defs><ellipse cx="48" cy="86" rx="24" ry="3" fill="rgba(0,0,0,0.32)"/><circle cx="48" cy="46" r="33" fill="url(#pkSclera)" stroke="rgba(120,108,86,0.45)" stroke-width="0.8"/><g opacity="0.4" stroke="#b4564a" stroke-width="0.7" fill="none" stroke-linecap="round"><path d="M20,54 q9,5 16,3"/><path d="M18,42 q10,-4 17,-2"/><path d="M76,52 q-9,5 -15,2"/><path d="M78,40 q-10,-3 -16,-1"/></g><circle cx="44" cy="42" r="15" fill="url(#pkIris)"/><g opacity="0.5" stroke="#c4ecb4" stroke-width="0.6"><line x1="44" y1="42" x2="44" y2="28"/><line x1="44" y1="42" x2="56" y2="35"/><line x1="44" y1="42" x2="57" y2="47"/><line x1="44" y1="42" x2="47" y2="56"/><line x1="44" y1="42" x2="33" y2="53"/><line x1="44" y1="42" x2="31" y2="37"/><line x1="44" y1="42" x2="36" y2="29"/></g><circle cx="44" cy="42" r="15" fill="none" stroke="rgba(12,36,16,0.55)" stroke-width="1.1"/><circle cx="44" cy="42" r="6" fill="#0a0f14"/><ellipse cx="37" cy="33" rx="7" ry="5" fill="rgba(255,255,255,0.72)" transform="rotate(-28 37 33)"/><ellipse cx="60" cy="60" rx="4.6" ry="3" fill="rgba(255,255,255,0.22)" transform="rotate(-28 60 60)"/></svg>'};
window.DSS_KEY_LABEL = {cocaine:'The bag of cocaine',ticket:'The chippy order ticket',slip:'The betting slip',lighter:'The brass lighter',eye:'The glass eye'};

// ====== QUEST POPUP (2026-09-14) ======
// Sam: "The quests should be modal pop ups not just part of the page." Built as
// a pattern rather than a one-off, because he expects to add more: park the
// quest in the passage inside .dss-quest-offer (title, body, and optionally
// some art) and it is raised here as a modal. The passage keeps its own visible
// link, so dismissing the popup can never strand the player.
window.dssQuestPopup = function() {
  if (document.getElementById('dss-quest-overlay')) return;
  if (window._dssQuestPopupSeenGen === window._passageGen) return;
  /* 2026-10-19 (found on Sam's playtest, O'Flatterly's quest): a threshold page or a room lifts the words out of tw-passage into its panel
     before this runs, so the offer and its link are looked for there as well */
  var offer = document.querySelector('tw-passage .dss-quest-offer, tw-story > .dss-threshold .dss-quest-offer, tw-story > .dss-room-fixed .dss-quest-offer');
  if (!offer) return;
  /* 2026-10-19 overnight (seen live, O'Flatterly's quest): the errand waits for a rejection slip to be filed, and 2.5 s more so the haunt it
     brings is seen, instead of landing on top of INIS's slip */
  var slipDue = !!document.querySelector('.dss-slip-fly') || Array.prototype.some.call(document.querySelectorAll('.dss-refusal:not(.dss-filed)'), function(m) { var pe = m.parentElement; return pe && !pe.closest('[hidden]') && pe.getClientRects().length > 0; });
  if (window._dssQuestWaitGen !== window._passageGen) { window._dssQuestWaitGen = window._passageGen; window._dssQuestWaitFrom = Date.now(); }
  if ((slipDue || Date.now() - (window._dssSlipFiledAt || 0) < 2500) && Date.now() - window._dssQuestWaitFrom < 20000) { setTimeout(window.dssQuestPopup, 500); return; }
  if (window.dssDeferIfBusy(window.dssQuestPopup)) return;

  var gen = window._passageGen;
  var titleEl = offer.querySelector('.dss-quest-title');
  var bodyEl  = offer.querySelector('.dss-quest-body');
  var artEl   = offer.querySelector('.dss-quest-art');
  var go = offer.getAttribute('data-go') || '';
  var goLink = go ? (function() {
    var ls = document.querySelectorAll('tw-passage tw-link, tw-story > .dss-threshold tw-link, tw-story > .dss-room-fixed tw-link');
    for (var i = 0; i < ls.length; i++) if ((ls[i].textContent || '').trim() === go) return ls[i];
    return null;
  })() : null;

  var overlay = document.createElement('div');
  overlay.id = 'dss-quest-overlay';
  var box = document.createElement('div');
  box.className = 'coin-overlay-box dss-quest-box';
  box.setAttribute('role', 'dialog');
  box.setAttribute('aria-modal', 'true');
  box.setAttribute('aria-label', 'An errand');
  box.setAttribute('tabindex', '-1');
  box.innerHTML =
    '<div class="dss-key-label">⟡ ERRAND ⟡</div>' +
    (artEl ? '<div class="coin-overlay-stage dss-quest-stage">' + artEl.innerHTML + '</div>' : '') +
    (titleEl ? '<div class="dss-quest-name">' + titleEl.innerHTML + '</div>' : '') +
    '<p class="coin-overlay-text">' + (bodyEl ? bodyEl.innerHTML : offer.innerHTML) + '</p>' +
    '<div class="dss-key-foot"><button type="button" class="coin-overlay-btn dss-quest-go">' +
      (goLink ? goLink.textContent.trim() : 'On.') + '</button></div>';
  overlay.appendChild(box);
  document.body.appendChild(overlay);
  var shown = false;
  function reveal() { if (shown) return; shown = true; overlay.classList.add('dss-quest-in'); }
  requestAnimationFrame(function() { requestAnimationFrame(reveal); });
  setTimeout(reveal, 140);
  try { box.focus({ preventScroll: true }); } catch(e) {}
  if (window.dssAudio && window.dssAudio.questCall) { try { window.dssAudio.questCall(); } catch(e) {} }

  function close(andGo) {
    window._dssQuestPopupSeenGen = gen;
    document.removeEventListener('keydown', onKey);
    overlay.classList.add('coin-overlay-fade');
    setTimeout(function() {
      if (overlay.parentNode) overlay.remove();
      if (andGo && goLink && document.contains(goLink)) goLink.click();
    }, 420);
  }
  function onKey(e) { if (e.key === 'Escape') close(false); }
  box.querySelector('.dss-quest-go').addEventListener('click', function() { close(true); });
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(false); });
  document.addEventListener('keydown', onKey);
  // If the player leaves while this is queued behind something else, go quietly.
  var obs = new MutationObserver(function() {
    if (window._passageGen !== gen) { try { obs.disconnect(); } catch(e) {} close(false); }
  });
  var story = document.querySelector('tw-story');
  if (story) obs.observe(story, { childList: true, subtree: true });
};

window.dssKeyPopup = function() {
  if (document.getElementById('dss-key-overlay')) return;
  if (window._dssKeyPopupSeenGen === window._passageGen) return;
  // 2026-10-07: a venue room holds the passage's words in its own panel (dssRoomScope), so the offers
  // are looked for there too; before this the five venue keys were never raised once rooms held words
  var offers = [].slice.call(document.querySelectorAll('tw-passage .dss-key-offer, tw-story > .dss-room-fixed .dss-room-prose .dss-key-offer'))
    .filter(function(o) { return o.querySelector('tw-link'); });
  // INNER VOICES (2026-10-07): a key whose room shows its object leaves the popup to that object's card;
  // while the room is still loading, wait for it (up to ten seconds), and if the room fails, show it here
  if (offers.length && window.dssVoices) {
    var vo = window.dssVoices.popupOffers(offers);
    if (vo === 'wait') { var wGen = window._passageGen; setTimeout(function() { if (window._passageGen === wGen && window.dssKeyPopup) window.dssKeyPopup(); }, 400); return; }
    offers = vo;
  }
  if (!offers.length) return;
  if (window.dssDeferIfBusy(window.dssKeyPopup)) return;

  var gen = window._passageGen;
  var overlay = document.createElement('div');
  overlay.id = 'dss-key-overlay';
  var box = document.createElement('div');
  box.className = 'coin-overlay-box dss-key-box';
  box.setAttribute('role', 'dialog');
  box.setAttribute('aria-modal', 'true');
  box.setAttribute('aria-label', 'Something within reach');
  box.setAttribute('tabindex', '-1');

  var html = '<div class="dss-key-label">\u27e1 WITHIN REACH \u27e1</div>';
  offers.forEach(function(offer, i) {
    var kid = offer.getAttribute('data-key') || '';
    var blurbEl = offer.querySelector('.dss-key-blurb');
    var blurb = blurbEl ? blurbEl.textContent.trim() : '';
    html += '<div class="dss-key-panel" data-panel="' + i + '">' +
              '<div class="coin-overlay-stage dss-key-stage">' + (window.DSS_KEY_ART[kid] || '') + '</div>' +
              '<p class="coin-overlay-text dss-key-blurb-text">' + blurb + '</p>' +
              '<div class="dss-key-btns" data-btns="' + i + '"></div>' +
            '</div>';
  });
  html += '<div class="dss-key-foot"><button type="button" class="coin-overlay-btn dss-key-leave">' +
          (offers.length > 1 ? 'Leave them' : 'Leave it') + '</button></div>';
  box.innerHTML = html;
  overlay.appendChild(box);
  document.body.appendChild(overlay);

  // One button per parked Harlowe link, wearing that link's own wording
  // ("Pocket the brass lighter" / "Leave the betting slip here and take ...").
  offers.forEach(function(offer, i) {
    var row = box.querySelector('[data-btns="' + i + '"]');
    [].slice.call(offer.querySelectorAll('tw-link')).forEach(function(link) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'coin-overlay-btn dss-key-take';
      b.textContent = (link.textContent || '').trim();
      b.addEventListener('click', function() { take(offer, link); });
      row.appendChild(b);
    });
  });

  var prevFocus = document.activeElement;
  try { box.focus({ preventScroll: true }); } catch(e) {}

  function take(offer, link) {
    if (overlay.dataset.done === '1') return;
    overlay.dataset.done = '1';
    try { link.click(); } catch(e) {}
    setTimeout(function() {
      var notes = offer.querySelectorAll('.claude-draft:not(.dss-key-blurb)');
      var msg = notes.length ? notes[notes.length - 1].textContent.trim() : '';
      var kid = offer.getAttribute('data-key') || '';
      box.innerHTML = '<div class="dss-key-label">\u27e1 WITHIN REACH \u27e1</div>' +
        '<div class="coin-overlay-stage dss-key-stage">' + (window.DSS_KEY_ART[kid] || '') + '</div>' +
        '<p class="coin-overlay-text">' + msg + '</p>' +
        '<span class="inventory-note">' + ((window.DSS_KEY_LABEL[kid] || 'THE KEY').toUpperCase()) + ' \u00b7 POCKETED</span>' +
        '<div class="dss-key-foot"><button type="button" class="coin-overlay-btn dss-key-leave">On.</button></div>';
      for (var k = 1; k <= 12; k++) {
        var m = document.createElement('span');
        m.className = 'item-mote item-mote-' + k;
        box.appendChild(m);
      }
      box.querySelector('.dss-key-leave').addEventListener('click', close);
      if (window.dssAudio && window.dssAudio.keyPickup) { try { window.dssAudio.keyPickup(kid); } catch(e) {} } // 2026-10-18 night: the lighter clicks, the eye knocks, paper rustles
      else if (window.dssAudio && window.dssAudio.paperRustle) { try { window.dssAudio.paperRustle(); } catch(e) {} }
    }, 160);
  }

  function close() {
    window._dssKeyPopupSeenGen = window._passageGen;
    document.removeEventListener('keydown', onKey);
    overlay.classList.add('coin-overlay-fade');
    if (prevFocus && prevFocus.focus && document.body.contains(prevFocus)) {
      try { prevFocus.focus({ preventScroll: true }); } catch(e) {}
    }
    setTimeout(function() { if (overlay.parentNode) overlay.remove(); }, 800);
  }
  function onKey(e) { if (e.key === 'Escape') close(); }

  box.querySelector('.dss-key-leave').addEventListener('click', close);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
  document.addEventListener('keydown', onKey);
  // If the player navigates away while this is queued behind something, go quietly.
  setTimeout(function check() {
    if (!document.body.contains(overlay)) return;
    if (window._passageGen !== gen) { close(); return; }
    setTimeout(check, 400);
  }, 400);
};

// ====== THE FLOWER MODAL (2026-10-07) ======
// Sam: a flower taken from its object's card "should just show the fact that it's collected", and
// "it should be a distinct modal". The same dark gold-on-black dialog the keys use: the flower itself,
// the passage's own glimpse line (pink when it is his placeholder for the flower lost to drink), the
// first-time hint, the pentacle's note at the fifth, and the count. One button closes it; the room
// behind is as it was.
window.dssLilyPopup = function(hook) {
  if (document.getElementById('dss-lily-overlay')) return;
  function el(sel) { return hook.querySelector(sel); }
  function txt(sel) { var e = el(sel); return e ? e.textContent.replace(/\s+/g, ' ').trim() : ''; }
  var glimpseEl = el('.lily-glimpse'), glimpse = glimpseEl ? glimpseEl.textContent.replace(/\s+/g, ' ').trim() : '';
  var hint = txt('.lily-glimpse-hint'), pentTitle = txt('.pent-reveal-title'), pentBody = txt('.pent-reveal-body'), pentNote = txt('.pent-reveal-note .inventory-note'), count = txt('.dss-lily-count');
  if (!glimpse && !pentBody) return;
  var svg = hook.querySelector('svg');
  var pink = !!(glimpseEl && glimpseEl.classList.contains('claude-draft'));
  var gen = window._passageGen;
  var overlay = document.createElement('div');
  overlay.id = 'dss-lily-overlay';
  var box = document.createElement('div');
  box.className = 'coin-overlay-box dss-key-box dss-lily-box';
  box.setAttribute('tabindex', '-1');
  function esc(t) { return t.replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
  var html = '<div class="dss-key-label dss-lily-label">\u27e1 A FLOWER \u27e1</div>' +
    '<div class="coin-overlay-stage dss-key-stage dss-lily-stage">' + (svg ? svg.outerHTML : '') + '</div>' +
    /* 2026-10-29 (Sam: the prose that comes with the lily "doesn't need its own card, just its own box and border to make it obvious") */
    (glimpse ? '<div class="dss-lily-story-box"><p class="coin-overlay-text dss-lily-story' + (pink ? ' claude-draft' : '') + '">' + esc(glimpse) + '</p></div>' : '') +
    /* 2026-10-23 (Sam: quieter flowers): no "Gather flowers. There are five to find." and no "FLOWER n OF 5"; the NOTEBOOK and the Fetch keep the count */
    (pentBody ? '<div class="dss-lily-pent">' + (pentTitle ? '<div class="pent-reveal-title">' + esc(pentTitle) + '</div>' : '') + '<p class="coin-overlay-text">' + esc(pentBody) + '</p>' + (pentNote ? '<span class="inventory-note">' + esc(pentNote) + '</span>' : '') + '</div>' : '') +
    // 2026-10-12 (the wanderer playthrough): under 30 sobriety the flower is only a glimpse and is not gathered; it says so,
    // and that it waits for a soberer hand, instead of offering to press a lily that was never taken
    (count ? '' : (glimpse ? '<span class="inventory-note dss-lily-lost">NOT GATHERED \u00b7 TOO DRUNK TO HOLD IT \u00b7 COME BACK SOBER</span>' : '')) +
    '<div class="dss-key-foot"><button type="button" class="coin-overlay-btn dss-lily-close">' + (count || !glimpse ? 'Press the lily in your notebook' : 'Let it go') + '</button></div>';
  box.innerHTML = html;
  overlay.appendChild(box);
  document.body.appendChild(overlay);
  if (count) for (var k = 1; k <= 12; k++) { var m = document.createElement('span'); m.className = 'item-mote item-mote-' + k; box.appendChild(m); }
  var a11y = window.dssModalA11y ? window.dssModalA11y(overlay, box, box.querySelector('.dss-lily-label'), close, { focusEl: box.querySelector('.dss-lily-close') }) : null;
  var done = false;
  function close() {
    if (done) return; done = true;
    if (typeof a11y === 'function') { try { a11y(); } catch (e) {} }
    overlay.classList.add('coin-overlay-fade');
    setTimeout(function() { if (overlay.parentNode) overlay.remove(); }, 800);
  }
  /* 2026-10-29 (Sam: "when you press the lily in your notebook there should be a little animation showing that happening"): the flower lifts off
     the stage, flies to the header's NOTEBOOK and is pressed flat into it; the NOTEBOOK takes it with the same glow the rejection slips get */
  function pressIn() {
    var sv = box.querySelector('.dss-lily-stage svg'), nb = Array.prototype.find.call(document.querySelectorAll('#stat-bars-lifted tw-link, .stat-bars tw-link'), function(l) { return /NOTEBOOK/i.test(l.textContent) && l.getClientRects().length; });
    if (!sv || !nb || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
    var r = sv.getBoundingClientRect(), t = nb.getBoundingClientRect(), dx = t.left + t.width / 2 - (r.left + r.width / 2), dy = t.top + t.height / 2 - (r.top + r.height / 2);
    var f = document.createElement('div'); f.className = 'dss-lily-press'; f.setAttribute('aria-hidden', 'true'); f.appendChild(sv.cloneNode(true));
    f.style.left = r.left + 'px'; f.style.top = r.top + 'px'; f.style.width = r.width + 'px'; f.style.height = r.height + 'px';
    document.body.appendChild(f); sv.style.visibility = 'hidden';
    var a = f.animate([
      { transform: 'translate(0,0) scale(1) rotate(0deg)', opacity: 1 },
      { transform: 'translate(0,-18px) scale(1.08) rotate(-6deg)', opacity: 1, offset: 0.18 },
      { transform: 'translate(' + (dx * 0.55) + 'px,' + (dy * 0.55 - 50) + 'px) scale(0.7) rotate(-14deg)', opacity: 1, offset: 0.55 },
      { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(0.32) rotate(0deg)', opacity: 1, offset: 0.84 },
      { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(0.42,0.05) rotate(0deg)', opacity: 0.9, offset: 0.93 },
      { transform: 'translate(' + dx + 'px,' + dy + 'px) scale(0.42,0.05) rotate(0deg)', opacity: 0 }
    ], { duration: 1500, easing: 'ease-in-out', fill: 'forwards' });
    a.onfinish = function() { if (f.parentNode) f.parentNode.removeChild(f); nb.classList.add('dss-nb-took'); setTimeout(function() { nb.classList.remove('dss-nb-took'); }, 1600); };
  }
  box.querySelector('.dss-lily-close').addEventListener('click', function() { if (count) pressIn(); close(); });
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
  if (window.dssAudio && window.dssAudio.paperRustle) { try { window.dssAudio.paperRustle(); } catch (e) {} }
  // if the player leaves the room while it is up, it goes with the passage
  setTimeout(function check() {
    if (!document.body.contains(overlay)) return;
    if (window._passageGen !== gen) { close(); return; }
    setTimeout(check, 400);
  }, 400);
};

// ====== CIGARETTE POPUP — hold-to-light ======
// Atmospheric tactile beat in the family of hold-to-drink and the donkey
// coin: an overlay with a match head and an unlit cigarette. Press and
// hold — the match strikes, the flame catches, the cig lights. Release
// before the catch and the match goes out. Calls the optional onLit
// callback when the cigarette is lit, then auto-dismisses after a beat.
window.showCigarettePopup = function(onLit) {
  if (document.getElementById('cig-overlay')) return;
  // Defer politely behind any open popup (parity with the soft overlays) —
  // previously the cigarette would spawn on top of an open hint or teaching.
  if (window.dssDeferIfBusy(function() { window.showCigarettePopup(onLit); })) return;
  var overlay = document.createElement('div');
  overlay.id = 'cig-overlay';
  overlay.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(4,3,8,0.78);display:flex;align-items:center;justify-content:center;z-index:19999;cursor:pointer;user-select:none;-webkit-user-select:none;';

  // Box: cigarette + match drawn together as inline SVG. Match flame
  // grows as the player holds; cigarette tip lights once held long enough.
  overlay.innerHTML =
    '<div class="cig-box">' +
      '<div class="cig-instructions">Light a cigarette.</div>' +
      '<div class="cig-stage">' +
        '<svg class="cig-svg" viewBox="0 0 280 110" xmlns="http://www.w3.org/2000/svg">' +
          '<defs>' +
            '<radialGradient id="cigEmber" cx="50%" cy="50%" r="50%">' +
              '<stop offset="0%" stop-color="#fff5b8" stop-opacity="1"/>' +
              '<stop offset="40%" stop-color="#ff9020" stop-opacity="0.85"/>' +
              '<stop offset="100%" stop-color="#a03408" stop-opacity="0"/>' +
            '</radialGradient>' +
            '<radialGradient id="cigFlame" cx="50%" cy="65%" r="55%">' +
              '<stop offset="0%" stop-color="#fff8c0" stop-opacity="1"/>' +
              '<stop offset="35%" stop-color="#ffba48" stop-opacity="0.85"/>' +
              '<stop offset="80%" stop-color="#c84810" stop-opacity="0.4"/>' +
              '<stop offset="100%" stop-color="#c84810" stop-opacity="0"/>' +
            '</radialGradient>' +
          '</defs>' +
          // Cigarette body — paper white, with brown filter on right end.
          '<rect class="cig-paper" x="22" y="62" width="158" height="13" rx="2" fill="#f4ede0" stroke="rgba(60,40,20,0.4)" stroke-width="0.6"/>' +
          '<rect class="cig-filter" x="180" y="62" width="36" height="13" rx="2" fill="#b8945c" stroke="rgba(60,40,20,0.4)" stroke-width="0.6"/>' +
          '<line x1="180" y1="62" x2="180" y2="75" stroke="rgba(60,40,20,0.6)" stroke-width="0.6"/>' +
          // Cigarette ember (initially hidden, shown when lit)
          '<circle class="cig-ember" cx="22" cy="68.5" r="0" fill="url(#cigEmber)"/>' +
          // Match — simple wooden stick + red head, positioned to touch the cig tip
          '<rect class="cig-matchstick" x="59" y="46.8" width="34" height="2.4" rx="0.6" fill="#7a4a22" transform="rotate(-28 58 48)"/>' +
          '<ellipse class="cig-matchhead" cx="58" cy="48" rx="3.2" ry="3.6" fill="#a83020"/>' +
          // Match flame (animates on hold)
          '<g class="cig-flame" opacity="0">' +
            '<ellipse cx="58" cy="40" rx="6" ry="11" fill="url(#cigFlame)"/>' +
            '<ellipse cx="58" cy="42" rx="3" ry="6" fill="#fff8c0" opacity="0.85"/>' +
          '</g>' +
        '</svg>' +
      '</div>' +
      '<div class="cig-hint">Press and hold.</div>' +
    '</div>';
  document.body.appendChild(overlay);

  var box = overlay.querySelector('.cig-box');
  var flame = overlay.querySelector('.cig-flame');
  var ember = overlay.querySelector('.cig-ember');
  var hint = overlay.querySelector('.cig-hint');
  var holdStart = 0;
  var lit = false;
  var dismissed = false;
  var rafId = null;
  var matchAudioFired = false;
  var LIGHT_MS = 1500; // hold duration to light

  function dismiss() {
    if (dismissed) return;
    dismissed = true;
    if (rafId) cancelAnimationFrame(rafId);
    if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
    document.removeEventListener('keydown', onKey);
    if (typeof onLit === 'function') {
      try { onLit(lit); } catch(e) {}
    }
  }

  function onKey(e){ if (e.key === 'Escape') dismiss(); }
  document.addEventListener('keydown', onKey);

  function tick() {
    if (dismissed) return;
    if (!holdStart) { rafId = requestAnimationFrame(tick); return; }
    var elapsed = Date.now() - holdStart;
    var t = Math.min(1, elapsed / LIGHT_MS);
    flame.setAttribute('opacity', String(t.toFixed(2)));
    if (t >= 1 && !lit) {
      lit = true;
      ember.setAttribute('r', '5.5');
      ember.setAttribute('fill', 'url(#cigEmber)');
      hint.textContent = 'Lit. Take a draw.';
      // Brief afterglow then dismiss
      setTimeout(function(){
        // Fade out the flame (match goes out, cig stays lit)
        flame.style.transition = 'opacity 0.6s ease-out';
        flame.setAttribute('opacity', '0');
        setTimeout(dismiss, 1400);
      }, 700);
    }
    rafId = requestAnimationFrame(tick);
  }

  function startHold(e) {
    if (lit || dismissed) return;
    if (e) e.preventDefault();
    holdStart = Date.now();
    if (!matchAudioFired && window.dssAudio && window.dssAudio.matchStrike) {
      window.dssAudio.matchStrike();
      matchAudioFired = true;
    }
    if (!rafId) tick();
  }
  function stopHold() {
    if (lit || dismissed) return;
    holdStart = 0;
    flame.setAttribute('opacity', '0');
    matchAudioFired = false; // allow another strike on next hold
  }
  // Don't trigger on overlay clicks — only on the box / svg
  box.addEventListener('mousedown', startHold);
  box.addEventListener('touchstart', startHold, { passive: false });
  document.addEventListener('mouseup', stopHold);
  document.addEventListener('touchend', stopHold);
  // M3: a cancelled touch (browser interrupt, gesture nav) must release the
  // hold too, or the player can be stranded mid-light. Mirror touchend.
  document.addEventListener('touchcancel', stopHold);
  // Click outside the box dismisses (giving up)
  overlay.addEventListener('click', function(e){
    if (e.target === overlay) dismiss();
  });
};

// ====== SIDE-OF-SCREEN BURNING CIGARETTE ======
// Spawns a small vertical cigarette in the lower-right of the viewport.
// Ember pulses, smoke wisps drift up, the paper slowly shortens to the
// filter as it burns. Lives on document.body so it persists across passage
// transitions — game continues to play while you smoke. Lighting another
// while one is burning replaces the previous one.
window.startBurningCigarette = function(opts) {
  opts = opts || {};
  var BURN_MS = opts.durationMs || 90000;
  var existing = document.getElementById('side-cig');
  if (existing && existing.parentNode) existing.parentNode.removeChild(existing);
  var sc = document.createElement('div');
  sc.id = 'side-cig';
  sc.innerHTML =
    '<div class="side-cig-stick" id="side-cig-stick">' +
      '<div class="side-cig-paper">' +
        '<div class="side-cig-ash"></div>' +
        '<svg class="side-cig-ember" viewBox="0 0 28 14" preserveAspectRatio="none" aria-hidden="true">' +
          '<defs>' +
            '<radialGradient id="scEmberCore" cx="50%" cy="55%" r="55%">' +
              '<stop offset="0%" stop-color="#fff5b8"/>' +
              '<stop offset="32%" stop-color="#ffba48"/>' +
              '<stop offset="72%" stop-color="#ff5818"/>' +
              '<stop offset="100%" stop-color="#a02808"/>' +
            '</radialGradient>' +
          '</defs>' +
          '<ellipse cx="14" cy="8" rx="13" ry="5.6" fill="#1a0a04"/>' +
          '<ellipse cx="14" cy="7.2" rx="11.8" ry="4.6" fill="url(#scEmberCore)"/>' +
          '<ellipse cx="11.5" cy="6.6" rx="2.6" ry="1.3" fill="#fff5b8" opacity="0.7"/>' +
          '<ellipse cx="16.5" cy="7.3" rx="1.8" ry="1" fill="#fff5b8" opacity="0.5"/>' +
        '</svg>' +
        '<div class="side-cig-tipsmoke" id="side-cig-tipsmoke" aria-hidden="true"></div>' +
      '</div>' +
      '<div class="side-cig-filter"></div>' +
      '<div class="side-cig-puffs" id="side-cig-puffs"></div>' +
    '</div>';
  document.body.appendChild(sc);
  var START_H = 130, END_H = 38;
  var startTime = Date.now();
  var stick = document.getElementById('side-cig-stick');
  stick.style.height = START_H + 'px';
  var ember = sc.querySelector('.side-cig-ember');
  /* 2026-10-19 (Sam, playtest: "a little smoke coming from the lit tip too, not much, just a bit"): a thin thread rises off the ember the whole
     time it burns, a small wisp every second or so, drifting and fading; none with reduced motion */
  (function tipSmoke() {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!document.body.contains(sc)) return;
    var host = document.getElementById('side-cig-tipsmoke');
    if (host && !sc.classList.contains('side-cig-dropping')) {
      var w = document.createElement('div'); w.className = 'cig-tip-wisp';
      w.style.setProperty('--tx', (Math.random() * 22 - 9).toFixed(1) + 'px');
      w.style.animationDuration = (3.2 + Math.random() * 1.2).toFixed(2) + 's';
      host.appendChild(w); setTimeout(function() { if (w.parentNode) w.parentNode.removeChild(w); }, 4600);
    }
    setTimeout(tipSmoke, 750 + Math.random() * 600);
  })();
  // Schedule irregular inhale/exhale puffs. Each "drag" brightens the ember
  // (oxygen flooding the cherry) for a beat, then a cluster of smoke wisps
  // rises from the filter end as the player exhales.
  var puffTimer = null;
  function spawnPuff() {
    var puffsHost = document.getElementById('side-cig-puffs');
    if (!puffsHost) return;
    var count = 3 + Math.floor(Math.random() * 2); // 3 or 4 wisps per puff
    for (var i = 0; i < count; i++) {
      (function(idx){
        setTimeout(function(){
          var w = document.createElement('div');
          w.className = 'cig-puff-wisp';
          var dx = (Math.random() * 56 - 32);          // sideways drift
          var sz = 34 + Math.random() * 22;            // start size
          var endScale = 4 + Math.random() * 2;        // dispersion
          w.style.width = sz + 'px';
          w.style.height = sz + 'px';
          w.style.left = (idx * 6 - 8 + Math.random() * 12) + 'px';
          w.style.setProperty('--drift-x', dx + 'px');
          w.style.setProperty('--scale-end', endScale);
          puffsHost.appendChild(w);
          setTimeout(function(){ if (w.parentNode) w.parentNode.removeChild(w); }, 8200);
        }, idx * 160 + Math.random() * 90);
      })(i);
    }
  }
  function scheduleNextPuff() {
    var delay = 8000 + Math.random() * 8000; // 8–16s between drags
    puffTimer = setTimeout(function(){
      if (!document.body.contains(sc)) return;
      // The inhale — ember brightens (the "draw") for a beat before the
      // exhaled smoke appears, so the cherry visibly glows brighter as the
      // cigarette burns down a little.
      if (ember) ember.classList.add('side-cig-ember-drag');
      setTimeout(function(){
        if (ember) ember.classList.remove('side-cig-ember-drag');
      }, 1800);
      setTimeout(spawnPuff, 1500);
      scheduleNextPuff();
    }, delay);
  }
  // First drag comes fairly soon after lighting.
  setTimeout(function(){
    if (!document.body.contains(sc)) return;
    if (ember) ember.classList.add('side-cig-ember-drag');
    setTimeout(function(){ if (ember) ember.classList.remove('side-cig-ember-drag'); }, 1200);
    setTimeout(spawnPuff, 1050);
    scheduleNextPuff();
  }, 2000 + Math.random() * 1500);
  function tick() {
    if (!document.body.contains(sc)) {
      if (puffTimer) clearTimeout(puffTimer);
      return;
    }
    var elapsed = Date.now() - startTime;
    var t = Math.min(1, elapsed / BURN_MS);
    stick.style.height = (START_H + (END_H - START_H) * t) + 'px';
    if (t >= 1) {
      if (puffTimer) clearTimeout(puffTimer);
      // Dropped. The stub tips forward and falls off the bottom of the
      // viewport — the player has flicked away the spent cigarette.
      sc.classList.add('side-cig-dropping');
      setTimeout(function(){ if (sc.parentNode) sc.parentNode.removeChild(sc); }, 1800);
      return;
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
};

// ====== NAPKIN PORTRAIT — KEEP WORKING ON IT ======
// Player drew Benito on a napkin at The French. After leaving, the
// notebook entry offers a "Work on it" button that reopens the drawing
// canvas as a popup — load the saved PNG as the starting state, add
// more strokes, save back. Lets the player return to the only thing
// they've made tonight, over and over.
window.showNapkinPopup = function() {
  if (document.getElementById('napkin-popup-overlay')) return;

  var overlay = document.createElement('div');
  overlay.id = 'napkin-popup-overlay';
  // z-index 999999 keeps the popup ABOVE the notebook dialog (and its
  // close button at 100000), so the canvas is what the player sees as
  // soon as they click "Work on it" — no need to close the notebook first.
  overlay.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(4,3,8,0.85);display:flex;align-items:center;justify-content:center;z-index:999999;flex-direction:column;';
  // Stop click bubbling so the notebook's outside-click-to-close handler
  // can't fire when the player is drawing/clicking inside the popup.
  overlay.addEventListener('click', function(e) { e.stopPropagation(); });
  overlay.addEventListener('mousedown', function(e) { e.stopPropagation(); });
  overlay.addEventListener('touchstart', function(e) { e.stopPropagation(); }, { passive: true });

  overlay.innerHTML =
    '<div class="napkin-popup-box">' +
      '<canvas class="napkin-canvas" id="napkin-popup-canvas" aria-label="Napkin sketch — drawing area" width="400" height="480"></canvas>' +
      '<div class="napkin-tools">' +
        '<div class="napkin-tools-row">' +
          '<div class="napkin-color active" data-color="#111111" style="background:#111111" title="Black"></div>' +
          '<div class="napkin-color" data-color="#1e4fd6" style="background:#1e4fd6" title="Blue"></div>' +
          '<div class="napkin-color" data-color="#d81f1f" style="background:#d81f1f" title="Red"></div>' +
          '<div class="napkin-color" data-color="#f5c518" style="background:#f5c518" title="Yellow"></div>' +
          '<div class="napkin-color" data-color="#2aa14a" style="background:#2aa14a" title="Green"></div>' +
          '<div class="napkin-color napkin-erase" data-color="#f2e7c9" title="Eraser">×</div>' +
        '</div>' +
        '<div class="napkin-tools-row">' +
          '<div class="napkin-size napkin-size-thin active" data-size="thin" title="Thin line"></div>' +
          '<div class="napkin-size napkin-size-thick" data-size="thick" title="Thick line"></div>' +
          '<button class="napkin-btn" id="napkin-popup-undo" disabled>Undo</button>' +
          '<button class="napkin-btn" id="napkin-popup-done">Sign it</button>' +
          '<button class="napkin-btn napkin-popup-close" id="napkin-popup-cancel">×</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  document.body.appendChild(overlay);

  var canvas = document.getElementById('napkin-popup-canvas');
  var ctx = canvas.getContext('2d');
  var wc = window.dssWatercolourKit(canvas, ctx, '#f2e7c9');
  var W = canvas.width, H = canvas.height;
  var color = '#111111';
  var brushSize = 3.2;
  var drawing = false;
  var lastX = 0, lastY = 0;
  /* Stroke stack for THIS session only — undo can roll back the
     strokes added since the popup opened, but not the saved PNG
     underneath (those strokes are now part of the loaded image). */
  var strokes = [];
  var currentStroke = null;
  var baseImage = null;       // the loaded saved napkin as Image
  var baseImageReady = false;

  function paintBase() {
    if (baseImage && baseImageReady) {
      ctx.drawImage(baseImage, 0, 0, W, H);
    } else {
      // Fresh napkin if no saved data (shouldn't happen, but safe).
      ctx.fillStyle = '#f2e7c9';
      ctx.fillRect(0, 0, W, H);
    }
  }
  function replayStrokes() {
    strokes.forEach(function(s){
      if (!s.points || s.points.length === 0) return;
      var w = s.width || 3.2;
      wc.begin(s.color);
      if (s.points.length === 1) {
        wc.dot(s.points[0].x, s.points[0].y, Math.max(w / 2, 1));
      } else {
        for (var i = 1; i < s.points.length; i++) {
          var p0 = s.points[i - 1], p1 = s.points[i];
          wc.seg(p0.x, p0.y, p1.x, p1.y, p1.w || w);
        }
      }
      wc.end();
    });
  }
  function updateButtons() {
    var undo = document.getElementById('napkin-popup-undo');
    if (strokes.length > 0) undo.removeAttribute('disabled');
    else undo.setAttribute('disabled', '');
  }
  function getPos(e) {
    var rect = canvas.getBoundingClientRect();
    var sx = canvas.width / rect.width, sy = canvas.height / rect.height;
    var cx, cy;
    if (e.touches && e.touches[0]) { cx = e.touches[0].clientX; cy = e.touches[0].clientY; }
    else { cx = e.clientX; cy = e.clientY; }
    return { x: (cx - rect.left) * sx, y: (cy - rect.top) * sy };
  }
  function startDraw(e) {
    e.preventDefault();
    drawing = true;
    var p = getPos(e);
    lastX = p.x; lastY = p.y;
    currentStroke = { color: color, width: brushSize, points: [{x: p.x, y: p.y}] };
    strokes.push(currentStroke);
    wc.begin(color);
    wc.dot(lastX, lastY, Math.max(brushSize / 2, 1));
    wc.refresh();
    updateButtons();
  }
  function draw(e) {
    if (!drawing) return;
    e.preventDefault();
    var p = getPos(e);
    var dist = Math.sqrt((p.x - lastX) * (p.x - lastX) + (p.y - lastY) * (p.y - lastY));
    var w = brushSize * Math.max(0.75, Math.min(1.3, 1.25 - dist * 0.022));
    wc.seg(lastX, lastY, p.x, p.y, w);
    wc.refresh();
    lastX = p.x; lastY = p.y;
    if (currentStroke) currentStroke.points.push({x: p.x, y: p.y, w: w});
  }
  function stopDraw() { if (drawing) wc.end(); drawing = false; currentStroke = null; }

  canvas.addEventListener('mousedown', startDraw);
  canvas.addEventListener('mousemove', draw);
  canvas.addEventListener('mouseup', stopDraw);
  canvas.addEventListener('mouseleave', stopDraw);
  canvas.addEventListener('touchstart', startDraw, { passive: false });
  canvas.addEventListener('touchmove', draw, { passive: false });
  canvas.addEventListener('touchend', stopDraw);
  canvas.addEventListener('touchcancel', stopDraw);

  overlay.querySelectorAll('.napkin-color').forEach(function(btn) {
    btn.addEventListener('click', function() {
      overlay.querySelectorAll('.napkin-color').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      color = btn.getAttribute('data-color');
    });
  });
  overlay.querySelectorAll('.napkin-size').forEach(function(btn) {
    btn.addEventListener('click', function() {
      overlay.querySelectorAll('.napkin-size').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      brushSize = (btn.getAttribute('data-size') === 'thick') ? 7 : 3.2;
    });
  });
  document.getElementById('napkin-popup-undo').addEventListener('click', function() {
    if (strokes.length === 0) return;
    strokes.pop();
    wc.cancel();
    paintBase();
    replayStrokes();
    updateButtons();
  });
  function close() {
    if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
  }
  document.getElementById('napkin-popup-cancel').addEventListener('click', close);
  // Escape cancels too (parity with the other modals). The handler removes
  // itself if the overlay is already gone, so it can't act on a stale close.
  var napkinEsc = function(e) {
    if (!document.getElementById('napkin-popup-overlay')) { document.removeEventListener('keydown', napkinEsc); return; }
    if (e.key === 'Escape') { document.removeEventListener('keydown', napkinEsc); close(); }
  };
  document.addEventListener('keydown', napkinEsc);
  document.getElementById('napkin-popup-done').addEventListener('click', function() {
    // Flatten current canvas state into the saved napkin so subsequent
    // sessions build on it.
    try { localStorage.setItem('dss_napkin', canvas.toDataURL('image/png')); } catch(e) {}
    // Update any visible nb-napkin-img elements so the notebook
    // immediately reflects the change.
    var imgs = document.querySelectorAll('.nb-napkin-img');
    imgs.forEach(function(img){ img.setAttribute('src', canvas.toDataURL('image/png')); });
    if (window.dssAudio && window.dssAudio.cameraShutter) {
      try { window.dssAudio.cameraShutter(); } catch(e) {}
    }
    close();
  });

  // Load the existing saved napkin (if any) as the canvas starting state.
  var saved = null;
  try { saved = localStorage.getItem('dss_napkin'); } catch(e) {}
  if (saved) {
    baseImage = new Image();
    baseImage.onload = function() {
      baseImageReady = true;
      paintBase();
    };
    baseImage.src = saved;
  } else {
    // Fresh napkin background as fallback
    ctx.fillStyle = '#f2e7c9';
    ctx.fillRect(0, 0, W, H);
    for (var i = 0; i < 2200; i++) {
      var x = Math.random() * W, y = Math.random() * H;
      ctx.fillStyle = 'rgba(170,140,80,' + (Math.random() * 0.05) + ')';
      ctx.fillRect(x, y, 1, 1);
    }
  }
};

// ====== GENERIC WORD-TO-THE-WISE POPUP ======
// Used by Dean Street's various morale / chippy hints. Twee-side gating
// flags ($shownLowConf etc.) ensure each unique message only triggers once
// per playthrough — the modal grabs attention, then dismisses on click or
// Escape, leaving the underlying action links available on the page.
// A quiet line under the ALBA strip, replacing what used to be a full-screen
// overlay that stopped the game (2026-09-13). Nothing here blocks, so nothing
// needs queueing or deferring. Callers' once-only flags still make each lesson
// appear exactly once a night.
// A NOTE TYPED ON PAPER (2026-09-14). These lessons used to print as a line
// inside the header, over the lily art, where Sam couldn't read them: "they
// aren't readable". They now arrive as a small slip of white paper in the
// corner, typed out a character at a time. Paper, because it is the one surface
// in this game that isn't Soho at night, so the eye goes straight to it.
// Since 2026-10-07 a slip never leaves on its own: it stays until its × is
// pressed. Two lessons can fall due on the same screen (the open-night tip and
// the door marks both fire on an early hub visit); they type one at a time, in
// order, and stack above each other (see __dssHintShow).
window.__dssHintQueue = window.__dssHintQueue || [];
window.__dssHintBusy = window.__dssHintBusy || false;
window.__dssHintWait = 0;   // polls spent waiting for a hard overlay to clear
// The header's height is not a constant — the ALBA strip wraps on a narrow
// window — so anything pinned below it has to be told where "below" is.
window.dssMeasureHeader = function() {
  try {
    var b = document.getElementById('stat-bars-lifted') || document.querySelector('.stat-bars');
    var h = b ? Math.round(b.getBoundingClientRect().height) : 0;
    if (h > 0) document.documentElement.style.setProperty('--dss-header-h', h + 'px');
  } catch (e) {}
};
if (typeof window !== 'undefined') {
  window.addEventListener('resize', function() { window.dssMeasureHeader(); });
  setInterval(function() { window.dssMeasureHeader(); }, 700);
}

// The passage a slip belongs to: the one on screen when it was asked for. Since 2026-10-09 (Sam: "when the
// passage changes they disappear") a slip goes when its passage goes, so each one remembers which that was.
window.__dssHintPassage = function() {
  /* 2026-10-24 sweep: on a page wrapped in a whole-page enchantment (the hub once "Head towards dawn" is out, the Maritime interlude) the passage is not a direct child of tw-story, so this found nothing, the slip remembered no passage and stayed up for the rest of the night (played live: "Your book is still at the French" rode through the Pillars, the cellar and the fight). Any tw-passage under tw-story counts now; one inside a div is the old page fading out, so a bare one is preferred. */
  var all = Array.prototype.slice.call(document.querySelectorAll('tw-story tw-passage'));
  if (!all.length) return null;
  var live = all.filter(function(e) { var n = e.parentNode; while (n && n.tagName !== 'TW-STORY') { if (n.tagName === 'DIV') return false; n = n.parentNode; } return true; });
  return (live.length ? live : all).slice(-1)[0];
};
// 2026-10-13 (the new-player playthrough): a slip raised with { sticky: true } belongs to no passage, so it is not dropped
// when the passage changes before it can show (the primer, queued behind the Pillars' opening box, was lost for the night
// when the player answered AOIFE's call from inside the box; $primerShown was already set).
window.dssInlineHint = function(html, opt) {
  window.__dssHintQueue.push({ html: html, passage: (opt && opt.sticky) ? null : window.__dssHintPassage(), go: (opt && opt.go) || null, then: (opt && opt.then) || null }); /* then: 2026-10-21 (Sam), a function run the moment this slip is closed (the HAUNTS slip follows the STATS slip) */
  if (!window.__dssHintBusy) window.__dssHintNext();
};
// A new passage sends the old passage's slips on their way, read or not (Sam, 2026-10-09: they stayed until
// clicked off, "change it so that when the passage changes they disappear"). A slip the NEW passage raises
// remembers the new passage and stays; so does a slip raised before the story has a passage at all.
(function arm() {
  var story = document.querySelector('tw-story');
  if (!window.MutationObserver) return;
  if (!story) { setTimeout(arm, 300); return; }   // the story element arrives after this script on some boots
  new MutationObserver(function() {
    var cur = window.__dssHintPassage();
    var stack = document.getElementById('dss-hint-stack');
    if (stack) {
      Array.prototype.forEach.call(stack.querySelectorAll('.dss-hint-slip'), function(c) {
        if (c.__dssPassage && c.__dssPassage !== cur && !c.__dssPassage.isConnected && c.__dssFinish) c.__dssFinish();
      });
    }
    window.__dssHintQueue = window.__dssHintQueue.filter(function(q) { return !q.passage || q.passage.isConnected; });
  }).observe(story, { childList: true });
})();
window.__dssHintNext = function() {
  if (window.__dssHintBusy) return;
  if (!window.__dssHintQueue.length) { window.__dssHintWait = 0; return; }
  // The slip is soft furniture and must queue behind the HARD, tactile overlays
  // the way every other soft popup does (dssDeferIfBusy). It did not, so on the
  // second hub the night's big instruction started typing itself out at the
  // side of the screen while the Donkey was still spinning in the middle of it
  // (Sam, 2026-09-15: "the first instructions pop up comes too early — it
  // should be after the coin is pocketed"). Now it waits for the coin, matches,
  // cigarette, eat and key overlays to leave. Capped at ~40s so an overlay that
  // never closes can swallow a beat but never a whole lesson.
  try {
    if (window.dssOverlayBusy && window.dssOverlayBusy()) {
      window.__dssHintWait = (window.__dssHintWait || 0) + 1;
      if (window.__dssHintWait < 160) { setTimeout(window.__dssHintNext, 250); return; }
    }
  } catch (e) {}
  // 2026-10-11 (structure pass 3): a slip waits while a room's opening panel is up, so the night's first
  // lesson (the primer, raised on the first French entry) no longer types itself out beside the room's
  // words, two overlays at once. It lands the moment the panel is closed. A panel that holds a game (full)
  // cannot be closed, and the plain pages' panel is the page itself, so neither one holds a slip back.
  try {
    if (document.querySelector('tw-story > .dss-room-veil.dss-room-veil-on:not(.dss-room-veil-full):not(.dss-threshold)')) { setTimeout(window.__dssHintNext, 250); return; }
  } catch (e) {}
  // 2026-10-13 (the new-player playthrough): nor while a phone is ringing or a call is on; on a phone the slip sat over
  // AOIFE's "Accept the call" and "I'm not here".
  try {
    if (document.querySelector('.phone-ringing:not(.ring-wait), .phone-scene')) { setTimeout(window.__dssHintNext, 250); return; }
  } catch (e) {}
  // (The 2026-09-16 "breathing space" after a long slip is gone: since 2026-10-07 a slip stays until it is
  // closed, and a later slip lands above it in the stack rather than waiting for it to leave.)
  window.__dssHintWait = 0;
  var item = window.__dssHintQueue.shift();
  if (item === undefined) return;
  window.__dssHintBusy = true;
  window.__dssHintShow(item.html, item.passage, item.go, item.then);
};
window.__dssHintShow = function(html, passage, go, then) {
  try {
    // THE STACK (Sam, 2026-10-07: "don't ever fade them, just make the cross more obvious to encourage
    // closing them"). No slip leaves on its own any more. Each one stays until its × or its paper is
    // clicked, and a slip that falls due while another is still up lands ABOVE it, newest nearest the
    // bottom corner, so nothing is cut short and nothing waits behind an unread slip. Three on screen at
    // most: a fourth sends the oldest on its way.
    var stack = document.getElementById('dss-hint-stack');
    if (!stack) {
      stack = document.createElement('div');
      stack.id = 'dss-hint-stack';
      stack.className = 'dss-hint-stack';
      document.body.appendChild(stack);
    }
    var standing = Array.prototype.filter.call(stack.querySelectorAll('.dss-hint-slip'), function(c) { return !c.__dssGoing; });
    while (standing.length >= 3) { var oldest = standing.shift(); if (oldest.__dssFinish) oldest.__dssFinish(); }
    var card = document.createElement('div');
    card.className = 'dss-hint-slip';
    card.__dssPassage = passage || window.__dssHintPassage();
    var mark = document.createElement('span');
    mark.className = 'dss-hint-mark';
    mark.textContent = '⟡';
    var body = document.createElement('span');
    body.className = 'dss-hint-type';
    // The × in the top-right corner. It used to be faint ink, a hint; now it is the one way the slip
    // goes, so it is a plain round button, dark on the paper, that fills under the pointer.
    var closer = document.createElement('button');
    closer.type = 'button';
    closer.className = 'dss-hint-x';
    closer.setAttribute('aria-label', 'Close this note');
    closer.setAttribute('title', 'Close');
    closer.textContent = '×';
    // The words sit in their own scrolling box so the × stays put in the
    // corner of a long slip while the primer scrolls under it.
    var inner = document.createElement('span');
    inner.className = 'dss-hint-inner';
    inner.appendChild(mark);
    inner.appendChild(body);
    card.appendChild(closer);
    card.appendChild(inner);
    // 2026-10-13 (Sam: "When you get a suggestion in the slips, there should be a 'Get Directions' option, which lights up a
    // path to where you are being directed"): a slip that names a place carries go (door ids, nearest first on the map);
    // the button lights the way on the Dean Street map until you reach it (window.dssDirections).
    if (go && window.dssDirections) {
      var gd = document.createElement('button'); gd.type = 'button'; gd.className = 'dss-hint-go'; gd.textContent = 'Get Directions';
      gd.addEventListener('click', function(ev) { ev.stopPropagation(); window.dssDirections.set(go); gd.textContent = 'Directions lit'; gd.disabled = true; });
      card.appendChild(gd);
    }
    stack.appendChild(card);
    requestAnimationFrame(function() { card.classList.add('in'); });
    setTimeout(function() { card.classList.add('in'); }, 120);   // backgrounded tabs stall rAF

    // Type it. The text is taken from the markup so any <em> survives as plain
    // words; these lessons are one sentence or two, never formatted.
    var tmp = document.createElement('div');
    tmp.innerHTML = html;
    var text = (tmp.textContent || '').trim();

    // Two lengths of slip. The nudges are a sentence; the night's primer is a
    // nine-hundred-character read (2026-09-14), so the typing is bounded, or a
    // long card would crawl for twenty-odd seconds at the nudge pace.
    var pace = Math.min(25, 2600 / Math.max(text.length, 1));
    var isLong = text.length > 400;
    if (isLong) card.classList.add('long');

    var finish = function() {
      if (card.__dssGoing) return;
      card.__dssGoing = true;
      if (then) { var nextUp = then; then = null; setTimeout(function() { try { nextUp(); } catch (e) {} }, 60); } /* 2026-10-21 (Sam): what follows this slip, the moment it goes */
      card.classList.add('out');
      setTimeout(function() {
        if (card.parentNode) card.parentNode.removeChild(card);
        window.__dssHintLastEnd = Date.now();
      }, 900);
    };
    card.__dssFinish = finish;
    // The slip goes on a click, on the paper or on the ×. The × is a plain
    // button so it also answers the keyboard.
    card.addEventListener('click', finish);
    closer.addEventListener('click', function(ev) { ev.stopPropagation(); finish(); });

    // The queue frees once this slip has finished typing (a second slip that
    // fell due at the same moment then types above it, not over it).
    var release = function() {
      if (release.done) return; release.done = true;
      window.__dssHintBusy = false;
      setTimeout(window.__dssHintNext, 300);
    };

    // The letters keep to the clock: if the page is busy (a room drawing
    // behind the slip) a late tick types the letters it owes at once, so the
    // typing takes the same few seconds everywhere.
    // 2026-10-12 (Sam: "I need to tell the difference between the two"): a paragraph that is only a short heading in
    // capitals (the primer's STATS and HAUNTS) is set as a heading on the slip, so its sections read apart.
    function setBody(t) {
      var esc = t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      body.innerHTML = esc.split('\n\n').map(function(par) { return /^[A-Z][A-Z &]{0,24}$/.test(par) ? '<span class="dss-hint-head">' + par + '</span>' : par; }).join('\n\n');
    }
    var i = 0, lastTick = 0, typeFrom = 0;
    var step = function() {
      if (!card.parentNode || card.__dssGoing) { setBody(text); release(); return; }
      if (!typeFrom) typeFrom = Date.now();
      i = Math.max(i + 1, Math.min(text.length, Math.floor((Date.now() - typeFrom) / pace)));
      setBody(text.slice(0, i));
      // Throttled by time, not by letter count: at the primer's pace every
      // other letter would be a hundred and seventy ticks a second.
      var now = Date.now();
      if (window.dssAudio && window.dssAudio.typewriterTick && now - lastTick >= 45) {
        lastTick = now;
        try { window.dssAudio.typewriterTick(0.35); } catch (e) {}
      }
      // A long slip can outrun its own box; keep the caret in view as it types.
      if (inner.scrollHeight > inner.clientHeight) inner.scrollTop = inner.scrollHeight;
      if (i < text.length) { setTimeout(step, pace * 0.68 + Math.random() * pace * 0.64); return; }
      card.classList.add('typed');
      // the top of a long slip is what a reader starts from
      if (isLong) inner.scrollTop = 0;
      release();
    };
    setTimeout(step, 420);
  } catch (e) { window.__dssHintBusy = false; }
};
window.wordToTheWisePopup = function(message, go) {
  /* 2026-10-24 (Sam, Q7): with all twelve haunts the header reads OPUS / STATE at 100% whatever the real numbers, so the street's flagging and hungry slips (its only callers) go quiet once the Great Work is held */
  if (document.querySelector('.stat-label-opus')) return;
  window.dssInlineHint(message, go ? { go: go } : null);
};
// 2026-10-14 overnight: Escape put away the notebook, the napkin, the lore notes, the cigarette and a room's card, but not a slip,
// whose only way out was its ×. Escape now presses the newest slip's ×, when nothing else on screen is listening for it.
// Checked in the capture phase, before any other Escape handler has closed its own thing, so one press closes one thing.
document.addEventListener('keydown', function(e) {
  if (e.key !== 'Escape') return;
  if (window.dssOverlayBusy && window.dssOverlayBusy()) return;
  if (Array.prototype.some.call(document.querySelectorAll('tw-dialog, .dss-lore-card, .dss-rules-overlay, .phone-ringing:not(.ring-wait), tw-story > .dss-room-veil.dss-room-veil-on, .nb-tab, .dss-room-card[aria-hidden="false"]'), function(n) { return n.getClientRects().length; })) return;
  /* 2026-10-29 nightwork, played live: Escape meant to step back from a room card pressed the × of a slip hidden behind that card (slips hide while a card is open), so the first VOICES slip was thrown away unseen. An open card now keeps its Escape, and only a slip the player can see is closed. */
  var xs = Array.prototype.filter.call(document.querySelectorAll('.dss-hint-slip .dss-hint-x'), function(x) { return x.getClientRects().length && getComputedStyle(x).visibility === 'visible'; });
  if (xs.length) xs[xs.length - 1].click();
}, true);
// the place a slip has directed you to: a list of map door ids ('chippy,doorway'); the map lights the way to the nearest open one
window.dssDirections = { get: function() { try { return sessionStorage.getItem('dssDirections') || ''; } catch (e) { return window.__dssDir || ''; } }, set: function(v) { window.__dssDir = v || ''; try { if (v) sessionStorage.setItem('dssDirections', v); else sessionStorage.removeItem('dssDirections'); } catch (e) {} } };



// ====== STAT HEAL ANIMATION ======
// Call with gains object: { confidence: n, sobriety: n }
// Shows a brief overlay with floating stat-gain labels, then auto-dismisses.
window.showHealAnimation = function(gains) {
  var lines = [];
  if (gains.confidence > 0) lines.push({ text: '\u2736 CONFIDENCE +' + gains.confidence, col: 'rgba(210,175,80,0.95)', shadow: 'rgba(210,170,60,0.5)' });
  if (gains.sobriety   > 0) lines.push({ text: '\u2736 SOBRIETY +' + gains.sobriety,     col: 'rgba(130,205,145,0.95)', shadow: 'rgba(110,190,120,0.45)' });
  if (!lines.length) return;

  var overlay = document.createElement('div');
  overlay.style.cssText = [
    'position:fixed;top:0;left:0;width:100%;height:100%;',
    'z-index:99998;pointer-events:none;',
    'display:flex;flex-direction:column;align-items:center;justify-content:center;',
    'background:rgba(26,16,4,0);',
    'transition:background 0.35s ease;',
  ].join('');
  document.body.appendChild(overlay);

  var statEls = lines.map(function(line, i) {
    var el = document.createElement('div');
    el.style.cssText = [
      'font:small-caps 700 15px Cinzel,Georgia,serif;',
      'letter-spacing:0.14em;',
      'color:' + line.col + ';',
      'text-shadow:0 0 16px ' + line.shadow + ',0 0 32px ' + line.shadow + ';',
      'opacity:0;',
      'transform:translateY(10px);',
      'transition:opacity 0.45s ' + (0.12 + i * 0.22) + 's ease,transform 0.5s ' + (0.12 + i * 0.22) + 's ease;',
      'margin:5px 0;',
    ].join('');
    el.textContent = line.text;
    overlay.appendChild(el);
    return el;
  });

  // Double-rAF to ensure first paint before transition
  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      overlay.style.background = 'rgba(26,16,4,0.50)';
      statEls.forEach(function(el) {
        el.style.opacity = '1';
        el.style.transform = 'translateY(0)';
      });
    });
  });

  // Hold, then fade out upward
  setTimeout(function() {
    overlay.style.transition = 'background 0.55s ease';
    overlay.style.background = 'rgba(26,16,4,0)';
    statEls.forEach(function(el, i) {
      el.style.transition = 'opacity 0.5s ' + (i * 0.1) + 's ease,transform 0.5s ' + (i * 0.1) + 's ease';
      el.style.opacity = '0';
      el.style.transform = 'translateY(-12px)';
    });
    setTimeout(function() { if (overlay.parentNode) overlay.parentNode.removeChild(overlay); }, 600);
  }, 1750);
};

// ====== NOTEBOOK TAB SWITCHER ======
window.nbSwitchTab = function(tabEl) {
var page = tabEl.closest('.nb-page');
if (!page) return;
var tabs = page.querySelectorAll('.nb-tab');
var panels = page.querySelectorAll('.nb-panel');
var target = tabEl.getAttribute('data-tab');
tabs.forEach(function(t) { t.classList.remove('nb-tab-active'); });
panels.forEach(function(p) { p.classList.remove('nb-panel-active'); });
tabEl.classList.add('nb-tab-active');
if (window.dssAudio && window.dssAudio.tabTick) { try { window.dssAudio.tabTick(); } catch(e) {} }
var targetPanel = page.querySelector('.nb-panel-' + target);
if (targetPanel) targetPanel.classList.add('nb-panel-active');

// Pentangle reveal: when player navigates to LILLIES or MAP for the first time
// after collecting all 5 lilies, fire the corresponding animation.
var queue = page.dataset.pentangleQueue || '';
// Suppress re-fire once the pentangle has been seen this session. JS can't write
// $sawPentangle (window.Harlowe isn't exposed), so track "seen" in a window flag;
// Start/StoryInit reset it for a new game.
if (window._dssSawPentangle) queue = '';
function consumeAndFire(tabKey, selector, triggerClass) {
  if (queue.indexOf(tabKey) < 0) return;
  var svg = page.querySelector(selector);
  if (!svg) return;
  svg.classList.remove(triggerClass);
  void svg.offsetWidth;
  svg.classList.add(triggerClass);
  queue = queue.split(',').filter(function(t){ return t && t !== tabKey; }).join(',');
  page.dataset.pentangleQueue = queue;
}
if (target === 'lily') consumeAndFire('lily', '.nb-lily-row', 'nb-lily-pentangle');
if (target === 'map')  {
  var fired = false;
  // Inline-snoop the queue first so we know if the map animation will fire
  if (queue.indexOf('map') >= 0 && page.querySelector('.soho-map svg')) fired = true;
  consumeAndFire('map',  '.soho-map svg', 'nb-map-pentangle');
  // After the map reveal fires, mark the pentangle seen so later notebook opens
  // don't re-queue it. JS can't set $sawPentangle (window.Harlowe isn't exposed),
  // so this session flag stands in; Start/StoryInit reset it for a new game.
  if (fired) window._dssSawPentangle = true;
}
};

// ====== NOTEBOOK LAYOUT FORCE ======
// Harlowe wraps dialog content in elements that break CSS layout.
// This polls for the dialog and forces layout with inline styles.
setInterval(function() {
var nbPage = document.querySelector('tw-dialog .nb-page');
if (!nbPage) return;

// Always find tw-dialog and force it full-screen
var el = nbPage.parentElement;
while (el && el.tagName !== 'TW-DIALOG') {
el.style.cssText = 'display:block !important;width:100% !important;max-width:none !important;overflow:visible !important;';
el = el.parentElement;
}
if (el && el.tagName === 'TW-DIALOG') {
el.style.cssText = 'position:fixed !important;top:0 !important;left:0 !important;width:100vw !important;max-width:none !important;height:100vh !important;display:flex !important;align-items:flex-start !important;justify-content:center !important;padding-top:4vh !important;background:transparent !important;border:none !important;z-index:9999 !important;overflow:hidden !important;';
}

// Force the tabbed layout container
nbPage.style.cssText = 'display:flex;flex-direction:column;position:relative;width:60vw;max-width:700px;height:84vh;overflow:hidden;background:#f4edd8;border:none;padding:0;z-index:10001;';

// Force tab bar
var tabBar = nbPage.querySelector('.nb-tabs');
if (tabBar) {
tabBar.style.cssText = 'display:flex;align-items:flex-end;padding:7px 0.6em 0;gap:3px;background:transparent;border-bottom:2px solid rgba(155,120,65,0.55);flex-shrink:0;';
}

// Force each panel
var panels = nbPage.querySelectorAll('.nb-panel');
panels.forEach(function(p) {
if (p.classList.contains('nb-panel-active')) {
if (p.classList.contains('nb-panel-map')) {
p.style.cssText = 'display:flex;flex:1;overflow:hidden;padding:0;background:rgba(20,18,15,0.95);align-items:center;justify-content:center;';
} else {
p.style.cssText = 'display:block;flex:1;overflow-y:auto;padding:0.8em 2em 2em 2em;box-sizing:border-box;background:#f4edd8;background-image:linear-gradient(rgba(120,100,80,0.15) 1px, transparent 1px);background-size:100% 2em;background-position:0 0.8em;font-family:"Courier New",Courier,monospace;font-size:1em;line-height:1.6;color:rgba(42,32,20,0.68);';
// the show-through (polish loop 2026-09-23): the map's ink, mirrored, seen faintly through the paper of the other pages
if (!nbPage.__dssBleed) { try { var bms = nbPage.querySelector('.soho-map svg'); if (bms) { var bc = bms.cloneNode(true); bc.setAttribute('xmlns', 'http://www.w3.org/2000/svg'); bc.querySelectorAll('rect').forEach(function(r) { if (r.getAttribute('width') === '560' || r.hasAttribute('rx')) r.remove(); }); bc.querySelectorAll('text').forEach(function(t) { t.remove(); }); var bk = [].slice.call(bc.children), bseen = false; bk.forEach(function(k) { if (k.tagName === 'rect' && /hatch/.test(k.getAttribute('fill') || '')) bseen = true; if (!bseen && k.tagName === 'g') k.remove(); }); bc.querySelectorAll('circle').forEach(function(c) { if (parseFloat(c.getAttribute('r')) < 5) c.remove(); }); var bg = document.createElementNS('http://www.w3.org/2000/svg', 'g'); bg.setAttribute('opacity', '0.085'); bg.setAttribute('transform', 'translate(560,0) scale(-1,1)'); while (bc.firstChild) bg.appendChild(bc.firstChild); bc.appendChild(bg); nbPage.__dssBleed = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(new XMLSerializer().serializeToString(bc)); } } catch (e) { nbPage.__dssBleed = ''; } }
if (nbPage.__dssBleed) { p.style.backgroundImage = 'url("' + nbPage.__dssBleed + '"), ' + p.style.backgroundImage; p.style.backgroundRepeat = 'no-repeat, repeat'; p.style.backgroundSize = '78% auto, auto'; p.style.backgroundPosition = 'center 2.5em, 0 0'; }
}
} else {
p.style.cssText = 'display:none;';
}
});

// Populate the napkin portrait image from localStorage (drawn at The French).
var napkinImgs = nbPage.querySelectorAll('.nb-napkin-img');
if (napkinImgs.length) {
try {
var napkinData = localStorage.getItem('dss_napkin');
if (napkinData) {
napkinImgs.forEach(function(img) {
if (img.getAttribute('src') !== napkinData) img.setAttribute('src', napkinData);
});
}
} catch(e) {}
}

// Force map sizing inside map panel
var mapPanel = nbPage.querySelector('.nb-panel-map');
if (mapPanel && mapPanel.classList.contains('nb-panel-active')) {
var map = mapPanel.querySelector('.soho-map');
if (map) {
map.style.cssText = 'width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:8px;box-sizing:border-box;margin:0;line-height:0;';
}
var mapSvg = mapPanel.querySelector('.soho-map svg');
if (mapSvg) {
mapSvg.style.cssText = 'width:100%;height:100%;display:block;';
}
}

// One-time setup: close button and backdrop click
if (el && el.tagName === 'TW-DIALOG' && !el.dataset.nbGuarded) {
el.dataset.nbGuarded = 'true';
var closeBtn = document.createElement('div');
closeBtn.textContent = '\u2715';
closeBtn.style.cssText = 'position:fixed;top:1.2em;right:1.5em;width:36px;height:36px;display:flex;align-items:center;justify-content:center;font-size:18px;color:#a09080;cursor:pointer;border:1px solid rgba(160,128,96,0.3);border-radius:50%;background:rgba(14,12,10,0.8);z-index:100000;transition:all 0.3s ease;';
closeBtn.addEventListener('mouseenter', function() {
this.style.color = '#d4a574';
this.style.borderColor = 'rgba(212,165,116,0.5)';
this.style.background = 'rgba(14,12,10,0.95)';
});
closeBtn.addEventListener('mouseleave', function() {
this.style.color = '#a09080';
this.style.borderColor = 'rgba(160,128,96,0.3)';
this.style.background = 'rgba(14,12,10,0.8)';
});
closeBtn.addEventListener('click', function() {
var link = document.querySelector('tw-dialog-links tw-link');
if (link) link.click();
});
el.appendChild(closeBtn);
// 2026-10-11 structure pass 3: Escape closes the NOTEBOOK as its close button does (it could only be clicked shut);
// fields inside it (the book naming) keep Escape for themselves
function nbEsc(ev) {
if (!el.isConnected) { document.removeEventListener('keydown', nbEsc); return; }
if (ev.key !== 'Escape' || ev.defaultPrevented) return;
var f = document.activeElement;
if (f && /^(INPUT|TEXTAREA|SELECT)$/.test(f.tagName)) return;
var link = document.querySelector('tw-dialog-links tw-link');
if (link) { ev.preventDefault(); link.click(); }
}
document.addEventListener('keydown', nbEsc);
el.addEventListener('click', function(e) {
var clickedNb = e.target.closest('.nb-page');
var clickedClose = e.target.closest('div[style*="z-index:100000"]');
if (!clickedNb && !clickedClose) {
var link = document.querySelector('tw-dialog-links tw-link');
if (link) link.click();
}
});
}
}, 200);

// ====== BAR GAME CLASS (two-phase: orders + carry) ======
window.BarGame = class BarGame {
constructor(canvasId, sobriety) {
this.canvas = document.getElementById(canvasId);
this.ctx = this.canvas.getContext('2d');
this.W = this.canvas.width; this.H = this.canvas.height;
this.sobriety = sobriety;
this.stopped = false;
this.mx = this.W/2; this.my = this.H/2;
this.t = 0;
this.lt = performance.now();

// ========== MIXING PHASE STATE ==========
this.phase = 'mixing';
var rail=document.getElementById('bar-pour-rail');if(!rail){rail=document.createElement('div');rail.id='bar-pour-rail';this.canvas.parentNode.insertBefore(rail,this.canvas);}
var cue=document.getElementById('bar-pour-cue');if(!cue){cue=document.createElement('div');cue.id='bar-pour-cue';cue.setAttribute('role','status');cue.setAttribute('aria-live','polite');this.canvas.insertAdjacentElement('afterend',cue);}
rail.hidden=false;cue.hidden=false;this._pourReadout='';

this.mRound = 0; this.mScore = 0;
this.pouring = false; this.pourLevel = 0; this.pourDone = false;
this.pourSpeed = 0; this.wobT = 0;
this.finishPhase = false; this.finHover = -1; this.finPicked = null;
this.mFeed = null; this.mTransition = false;
this.pourDrops = []; this.bubbles = [];
this.bottleAngle = 0; this.pourStream = 0;
this.pourTime = 0; this.pourCommitted = false;
this.handShake = 0;
this.targetOff = 0; this.targetPhase = Math.random() * Math.PI * 2;
this.liquidWobble = 0;
this.spill = 0; this.perfectRing = 0;
this.pourAccuracy = 0;

// Drink definitions (unchanged from original)
this.drinks = [
  {name:"Bourbon",who:"Guitarist",glass:"tulip",liqCol:"#c98030",liqHi:"#e8b860",target:0.55,
   bottle:{col:"#8b4513",acc:"#c9a961",lab:"WT"},
   finish:{prompt:"Which glass?",correct:0,opts:["Tulip glass","Rocks glass"],
   okMsg:"Tulip glass. Right.",badMsg:"Wrong glass \u2014 he said tulip."}},
  {name:"Moscow Mule",who:"MOE",glass:"copper",liqCol:"#e0d090",liqHi:"#f0e8b0",target:0.60,
   bottle:{col:"#c0c0c0",acc:"#e8e8e8",lab:"Vodka"},
   finish:{prompt:"Lime?",correct:0,opts:["Squeeze fresh lime","Pour bottled juice"],
   okMsg:"Fresh lime. Perfect.",badMsg:"He said fresh lime, not bottled."}},
  {name:"Scotch",who:"Pianist",glass:"rocks",liqCol:"#d4a050",liqHi:"#e8c070",target:0.40,
   bottle:{col:"#5a2d0c",acc:"#d4a574",lab:"Mac"},
   finish:{prompt:"How?",correct:1,opts:["Add ice","Serve neat"],
   okMsg:"Neat. As requested.",badMsg:"He said neat \u2014 no ice."}}
];

this.glassH = {tulip: 70, copper: 55, rocks: 42};
this.completedDrinks = [];
this.sparkles = [];
this.smokePs = [];
for (var i = 0; i < 8; i++) this.smokePs.push({x:Math.random()*this.W,y:Math.random()*120+20,s:20+Math.random()*40,sp:0.1+Math.random()*0.2,off:Math.random()*10});
this.patrons = this._initPatrons();

// ========== CARRY PHASE STATE ==========
this.carryPhase = {
  scrollPos: 0,
  scrollSpeed: 200,
  maxScroll: 4000, /* 2026-10-16 (Sam, from Astra's playtest: the carry run is a second whole game after the pour): 7000 to 4000, about 20 s at walking pace; obstacles, difficulty steps, notes and the finish all scale with it; 4000 ends on the flat after the second raised step */
  playerY: 320,
  playerVelY: 0,
  playerJumping: false,
  playerDuckingInput: false,
  gravity: 600,
  jumpPower: -400,
  jumpHeld: false,
  coyoteTimer: 0,
  jumpBufferTimer: 0,
  speedHold: 0,
  runLean: 0,
  groundY: 320,
  baseGroundY: 320,
  glassesLeft: 3,
  invulnTimer: 0,
  obstacles: [],
  nextObstacleTime: 0,
  screenShake: 0,
  hitFlash: 0,
  landPuff: 0,
  difficultyPhase: 0,
  wobbling: false,
  wobbleTimer: 0,
  staggerTimer: 0,
  pitFalling: false,
  pitFallPhase: null,
  pitFallY: 0,
  pitFallVel: 0,
  pitFallBottomT: 0,
  pitFallObs: null,
  terrain: [
    {x: 0, y: 320},
    {x: 900, y: 320},
    {x: 1050, y: 285},
    {x: 1550, y: 285},
    {x: 1700, y: 320},
    {x: 2500, y: 320},
    {x: 2650, y: 295},
    {x: 3250, y: 295},
    {x: 3400, y: 320},
    {x: 4200, y: 320}, /* 2026-10-17 (played live): the run ends at scrollPos 4000 with the carrier's feet at world x 4100, which was 100 px up the ramp to the third step (4000 to 4150); the flat now runs to 4200 so the stage and the finish sit on level ground */
    {x: 4350, y: 275},
    {x: 4650, y: 275},
    {x: 4850, y: 320},
    {x: 5400, y: 320},
    {x: 5550, y: 290},
    {x: 6050, y: 290},
    {x: 6200, y: 320},
    {x: 7000, y: 320}
  ]
};

  this._generateObstacles();
  this._generateGrooveNotes();

// ========== EVENT LISTENERS ==========
this.canvas.addEventListener('mousemove', (e) => {
  var r = this.canvas.getBoundingClientRect();
  this.mx = (e.clientX - r.left) * (this.W / r.width);
  this.my = (e.clientY - r.top) * (this.H / r.height);
});

this.canvas.addEventListener('mousedown', (e) => {
  if (this.phase === 'mixing' && !this.pourDone && !this.finishPhase && !this.mTransition) {
    this.pouring = true;
    this.pourCommitted = true;
  }
  if (this.phase === 'carry') {
    this.carryPhase.jumpHeld = true;
    this._playerJump();
  }
});

this.canvas.addEventListener('mouseup', (e) => {
  if (this.phase === 'mixing' && this.pouring) {
    this.pouring = false;
    this.pourDone = true;
    this._scorePour();
  }
  if (this.phase === 'carry') this._playerJumpRelease();
});

this.canvas.addEventListener('mouseleave', (e) => {
  if (this.phase === 'mixing' && this.pouring) {
    this.pouring = false;
    this.pourDone = true;
    this._scorePour();
  }
  if (this.phase === 'carry') this._playerJumpRelease();
});

// Native touch: kills synthetic-mouse latency AND gives the hold-jump its
// full range on phones. Mirrors the mouse handlers for both phases; the
// cow-ride touchstart pattern.
this.canvas.addEventListener('touchstart', (e) => {
  if (this.phase === 'mixing' && !this.pourDone && !this.finishPhase && !this.mTransition) {
    e.preventDefault();
    this.pouring = true;
    this.pourCommitted = true;
  }
  if (this.phase === 'carry') {
    e.preventDefault();
    /* 2026-10-14 overnight: duck was keyboard-only, so the high obstacles (which only a duck clears) cost a touch player
       every glass. A touch on the lower part of the canvas now ducks while held; anywhere above it jumps, as before. */
    var tch = e.changedTouches && e.changedTouches[0], rc = this.canvas.getBoundingClientRect();
    if (tch && rc.height && (tch.clientY - rc.top) / rc.height > 0.62) { this.carryPhase.playerDuckingInput = true; return; }
    this.carryPhase.jumpHeld = true;
    this._playerJump();
  }
}, { passive: false });

this.canvas.addEventListener('touchend', (e) => {
  if (this.phase === 'mixing' && this.pouring) {
    this.pouring = false;
    this.pourDone = true;
    this._scorePour();
  }
  if (this.phase === 'carry') { this._playerJumpRelease(); if (!e.touches || !e.touches.length) this.carryPhase.playerDuckingInput = false; }
});

this.canvas.addEventListener('touchcancel', (e) => {
  if (this.phase === 'mixing' && this.pouring) {
    this.pouring = false;
    this.pourDone = true;
    this._scorePour();
  }
  if (this.phase === 'carry') { this._playerJumpRelease(); this.carryPhase.playerDuckingInput = false; }
});

this.canvas.addEventListener('click', () => {
  // No longer needed for finish choices
});

document.addEventListener('keydown', (e) => {
  if (this.phase === 'carry') {
    if (e.code === 'Space' || e.code === 'ArrowUp') {
      e.preventDefault();
      if (!e.repeat) {
        this.carryPhase.jumpHeld = true;
        this._playerJump();
      }
    }
    if (e.code === 'ArrowDown') {
      e.preventDefault();
      this.carryPhase.playerDuckingInput = true;
    }
    if (e.code === 'ArrowRight' || e.code === 'KeyD') {
      e.preventDefault();
      this.carryPhase.speedHold = 1;
    }
    if (e.code === 'ArrowLeft' || e.code === 'KeyA') {
      e.preventDefault();
      this.carryPhase.speedHold = -1;
    }
  }
});

// Losing window focus mid-hold would leave jump/run/duck stuck on
window.addEventListener('blur', () => {
  if (this.phase === 'carry') {
    this._playerJumpRelease();
    this.carryPhase.speedHold = 0;
    this.carryPhase.playerDuckingInput = false;
  }
});

document.addEventListener('keyup', (e) => {
  if (this.phase === 'carry') {
    if (e.code === 'Space' || e.code === 'ArrowUp') {
      this._playerJumpRelease();
    }
    if (e.code === 'ArrowDown') {
      this.carryPhase.playerDuckingInput = false;
    }
    if ((e.code === 'ArrowRight' || e.code === 'KeyD') && this.carryPhase.speedHold === 1) {
      this.carryPhase.speedHold = 0;
    }
    if ((e.code === 'ArrowLeft' || e.code === 'KeyA') && this.carryPhase.speedHold === -1) {
      this.carryPhase.speedHold = 0;
    }
  }
});

document.getElementById('bar-round-display').textContent = '\u2727 ' + this.drinks[0].who + '\u2019s ' + this.drinks[0].name + ' \u2727';
/* Pour instruction removed — the pre-bar plate already teaches it
   ("Hold to pour · Release to stop"); the game surface stays clean. */
var self = this;

this._loop();
}

// ========== MIXING PHASE: HELPERS ==========
_initPatrons() {
var patrons = [];
for (var i = 0; i < 5; i++) {
  patrons.push({
    x: 30 + Math.random() * (this.W - 60),
    y: 80 + Math.random() * 100,
    w: 15 + Math.random() * 20,
    h: 25 + Math.random() * 35
  });
}
return patrons;
}

_liquidY(glassType, gy, fill) {
var h = this.glassH[glassType] || 55;
var offset = glassType === 'tulip' ? -5 : 0;
return gy + h * (1 - fill * 0.85) + offset;
}

_scorePour() {
var d = this.drinks[this.mRound];
var effectiveTarget = Math.max(0.1, Math.min(0.9, d.target + this.targetOff));
var diff = Math.abs(this.pourLevel - effectiveTarget);
/* 2026-10-28 (dssEase): the bands widen with each lost round */
if (diff < (window.dssEase ? window.dssEase.by('bar', 0.07, 0.12) : 0.07)) { this.pourAccuracy = 2; }
else if (diff < (window.dssEase ? window.dssEase.by('bar', 0.16, 0.26) : 0.16)) { this.pourAccuracy = 1; }
else { this.pourAccuracy = 0; }
var gx = this.W/2, gy = 270;
this.mScore += this.pourAccuracy;
var narr = document.getElementById('bar-narrative');
if (this.pourAccuracy === 2) {
  this.perfectRing = 1;
  this._spawnSparkles(gx, gy, 15);
  narr.innerHTML = '<em style="color:#e8c060;">Perfect pour.</em>';
} else if (this.pourAccuracy === 1) {
  this._spawnSparkles(gx, gy + 15, 8);
  narr.innerHTML = '<em style="color:#d4a574;">Close enough.</em>';
} else {
  narr.innerHTML = '<em style="color:#d8846a;">' + (this.pourLevel > effectiveTarget ? 'Too much.' : 'Not enough.') + '</em>';
}
this.liquidWobble = 1.0;
this.mTransition = true;
this.completedDrinks.push({
  name: d.name,
  who: d.who,
  glass: d.glass,
  liqCol: d.liqCol,
  accuracy: this.pourAccuracy
});
var self = this;
setTimeout(function() {
  self.mRound++;
  if (self.mRound >= 3) {
    self._startCarryTransition();
  } else {
    self._resetPour();
    var nd = self.drinks[self.mRound];
    document.getElementById('bar-round-display').textContent = '\u2727 ' + nd.who + '\u2019s ' + nd.name + ' \u2727';
    narr.innerHTML = '';
  }
}, 1200);
}

_startCarryTransition() {
var rail=document.getElementById('bar-pour-rail'),cue=document.getElementById('bar-pour-cue');if(rail)rail.hidden=true;if(cue)cue.hidden=true;
var narr = document.getElementById('bar-narrative');
document.getElementById('bar-round-display').textContent = '\u2727 Drinks ready! \u2727';
// 2026-10-14 (overnight report, Sam: fix): the pours used to count for nothing; good pours (5 of a possible 6) steady the
// hands, and the first knock on the way to the stage spills nothing
this.carryPhase.steady = this.mScore >= 5 ? 1 : 0;
narr.innerHTML = '<em style="color:#d4a574;">Now carry the tray back to the stage.' + (this.carryPhase.steady ? ' Your pours were good: steady hands, one knock forgiven.' : '') + '</em>';
/* 2026-10-28 (dssEase): from the second lost round, one more knock is forgiven (unannounced) */
if (window.dssEase && window.dssEase.level('bar') >= 2) this.carryPhase.steady++;
this.phase = 'carryWait';
var self = this;
setTimeout(function() {
  narr.innerHTML = '';
  document.getElementById('bar-round-display').textContent = '\u2727 CARRY THE TRAY \u2727';
  self.phase = 'carry';
  // Hand the carry/platform phase to the jazzmini loop: stop the venue's
  // Firebird-jazz bed so the two don't stack, then start jazzmini.
  if (window.dssAudio && window.dssAudio.stopBed) { try { window.dssAudio.stopBed('ronnies-firebird'); } catch(e) {} }
  if (window._jazzMiniDataUri && !window._jazzMiniEl) {
    var _jmEl = new Audio(window._jazzMiniDataUri);
    _jmEl.volume = 0.28; _jmEl.loop = true;
    _jmEl.muted = !!(window.dssAudio && window.dssAudio.isMuted && window.dssAudio.isMuted());
    _jmEl.play().catch(function(){});
    window._jazzMiniEl = _jmEl;
    if (window._jazzMiniMuteWatcher) { try { clearInterval(window._jazzMiniMuteWatcher); } catch(e) {} }
    window._jazzMiniMuteWatcher = setInterval(function(){
      var el = window._jazzMiniEl;
      if (!el) { clearInterval(window._jazzMiniMuteWatcher); window._jazzMiniMuteWatcher = null; return; }
      var m = !!(window.dssAudio && window.dssAudio.isMuted && window.dssAudio.isMuted());
      if (el.muted !== m) el.muted = m;
    }, 250);
  }
}, 3000);
}

_resetPour() {
this.pouring = false; this.pourLevel = 0; this.pourDone = false;
this.finishPhase = false; this.finHover = -1; this.finPicked = null;
this.mFeed = null; this.mTransition = false;
this.pourDrops = []; this.bubbles = [];
this.bottleAngle = 0; this.pourStream = 0;
this.pourAccuracy = 0;
this.pourTime = 0; this.pourCommitted = false;
this.handShake = 0;
this.targetOff = 0; this.targetPhase = Math.random() * Math.PI * 2;
this.liquidWobble = 0;
this.spill = 0; this.perfectRing = 0;
}

_spawnSparkles(x, y, count) {
for (var i = 0; i < count; i++) {
  var angle = Math.random() * Math.PI * 2;
  var speed = 2 + Math.random() * 3;
  this.sparkles.push({
    x: x,
    y: y,
    vx: Math.cos(angle) * speed,
    vy: Math.sin(angle) * speed,
    life: 1,
    size: 1 + Math.random() * 2
  });
}
}

// ========== CARRY PHASE: OBSTACLES ==========
_generateGrooveNotes() {
  var cp = this.carryPhase;
  cp.grooveNotes = [];
  // Little blue notes sit in the gaps between hazards. They reward a
  // well-timed hop and give the long carry run a musical through-line.
  for (var x = 760, i = 0; x < cp.maxScroll - 260; x += 690 + (i % 2) * 120, i++) {
    var gy = this._getTerrainY(x);
    cp.grooveNotes.push({ x: x, y: gy - (i % 3 === 1 ? 108 : 64), hit: false, phase: i * 0.9 });
  }
  cp.groove = 0;
  cp.grooveFlash = 0;
}

_generateObstacles() {
this.carryPhase.obstacles = [];
var baseGY = this.carryPhase.baseGroundY;
var maxScroll = this.carryPhase.maxScroll;

var dist = 450; // start after a short run-up
var lastAction = ''; // 'jump' or 'duck'
var sameCount = 0;
var sinceGap = 0;
var obsCount = 0;       // total obstacles placed so far
var pitsPlaced = 0;     // bottomless-pit count — used to force at least one early

while (dist < maxScroll - 200) {
  var progress = dist / maxScroll; // 0.0 to 1.0

  // Decide what chunk to place
  var chunk;
  var r = Math.random();

  // Guarantee at least one bottomless pit (with the rising music) shows up
  // by the third obstacle. The pit is the visual centrepiece of the carry
  // run — without this, an unlucky RNG roll could give a player who dies
  // early a whole game with no pit at all.
  if (pitsPlaced === 0 && obsCount >= 2) {
    chunk = 'floor_gap';
  }
  // Force a breather every 5-8 obstacles
  else if (sinceGap >= 5 + Math.floor(Math.random() * 3)) {
    chunk = 'gap';
  }
  // Early section: mostly singles, introduce floor gaps
  else if (progress < 0.3) {
    if (r < 0.35) chunk = 'single_low';
    else if (r < 0.7) chunk = 'single_high';
    else if (r < 0.88) chunk = 'floor_gap';
    else chunk = 'gap';
  }
  // Middle section: introduce doubles and combos
  else if (progress < 0.7) {
    if (r < 0.2) chunk = 'single_low';
    else if (r < 0.4) chunk = 'single_high';
    else if (r < 0.5) chunk = 'floor_gap';
    else if (r < 0.6) chunk = 'double_low';
    else if (r < 0.7) chunk = 'double_high';
    else if (r < 0.8) chunk = 'combo_low_high';
    else if (r < 0.9) chunk = 'combo_high_low';
    else chunk = 'gap';
  }
  // Late section: denser, tougher
  else {
    if (r < 0.18) chunk = 'single_low';
    else if (r < 0.36) chunk = 'single_high';
    else if (r < 0.48) chunk = 'floor_gap';
    else if (r < 0.6) chunk = 'double_low';
    else if (r < 0.72) chunk = 'double_high';
    else if (r < 0.82) chunk = 'combo_low_high';
    else if (r < 0.92) chunk = 'combo_high_low';
    else chunk = 'gap';
  }

  // Prevent 3+ of same action in a row
  var chunkAction = '';
  if (chunk === 'single_low' || chunk === 'double_low' || chunk === 'floor_gap') chunkAction = 'jump';
  else if (chunk === 'single_high' || chunk === 'double_high') chunkAction = 'duck';

  if (chunkAction === lastAction) {
    sameCount++;
    if (sameCount >= 2) {
      // Force the opposite
      if (chunkAction === 'jump') {
        chunk = (Math.random() < 0.7) ? 'single_high' : 'double_high';
        chunkAction = 'duck';
      } else {
        chunk = (Math.random() < 0.7) ? 'single_low' : 'double_low';
        chunkAction = 'jump';
      }
      sameCount = 0;
    }
  } else {
    sameCount = (chunkAction !== '') ? 1 : sameCount;
  }
  if (chunkAction !== '') lastAction = chunkAction;

  var style = Math.floor(Math.random() * 3) + 1; // 1, 2, or 3 — which art set
  var type = Math.floor(Math.random() * 3); // 0, 1, or 2 — variant within set

  if (chunk === 'gap') {
    dist += 300 + Math.random() * 200; // breather gap
    sinceGap = 0;
    obsCount++;
  }
  else if (chunk === 'floor_gap') {
    var gapWidth = 80 + Math.random() * 60;
    var localGY = this._getTerrainY(dist);
    this.carryPhase.obstacles.push({
      x: dist, type: type, isHigh: false, isGap: true, style: style,
      width: gapWidth,
      y: localGY, height: 80, hit: false, groundY: localGY
    });
    dist += 320 + Math.random() * 180;
    sinceGap++;
    obsCount++;
    pitsPlaced++;
  }
  else if (chunk === 'single_low') {
    var h = 30 + Math.random() * 20;
    var localGY = this._getTerrainY(dist);
    this.carryPhase.obstacles.push({
      x: dist, type: type, isHigh: false, style: style,
      width: 50 + Math.random() * 40,
      y: localGY - h, height: h, hit: false, groundY: localGY
    });
    dist += 300 + Math.random() * 180;
    sinceGap++;
    obsCount++;
  }
  else if (chunk === 'single_high') {
    var localGY = this._getTerrainY(dist);
    this.carryPhase.obstacles.push({
      x: dist, type: type, isHigh: true, style: style,
      width: 70 + Math.random() * 30,
      y: 0, height: localGY + 5, hit: false, groundY: localGY
    });
    dist += 300 + Math.random() * 180;
    sinceGap++;
    obsCount++;
  }
  else if (chunk === 'double_low') {
    var h1 = 30 + Math.random() * 15;
    var h2 = 30 + Math.random() * 15;
    var style2 = Math.floor(Math.random() * 3) + 1;
    var type2 = Math.floor(Math.random() * 3);
    var gap1 = 240 + Math.random() * 60;
    var localGY1 = this._getTerrainY(dist);
    var localGY2 = this._getTerrainY(dist + gap1);
    this.carryPhase.obstacles.push({
      x: dist, type: type, isHigh: false, style: style,
      width: 45 + Math.random() * 25,
      y: localGY1 - h1, height: h1, hit: false, groundY: localGY1
    });
    this.carryPhase.obstacles.push({
      x: dist + gap1, type: type2, isHigh: false, style: style2,
      width: 45 + Math.random() * 25,
      y: localGY2 - h2, height: h2, hit: false, groundY: localGY2
    });
    dist += 500 + Math.random() * 200;
    sinceGap += 2;
    obsCount++;
  }
  else if (chunk === 'double_high') {
    var style2 = Math.floor(Math.random() * 3) + 1;
    var type2 = Math.floor(Math.random() * 3);
    var gap1 = 260 + Math.random() * 60;
    var localGY1 = this._getTerrainY(dist);
    var localGY2 = this._getTerrainY(dist + gap1);
    this.carryPhase.obstacles.push({
      x: dist, type: type, isHigh: true, style: style,
      width: 65 + Math.random() * 25,
      y: 0, height: localGY1 + 5, hit: false, groundY: localGY1
    });
    this.carryPhase.obstacles.push({
      x: dist + gap1, type: type2, isHigh: true, style: style2,
      width: 65 + Math.random() * 25,
      y: 0, height: localGY2 + 5, hit: false, groundY: localGY2
    });
    dist += 520 + Math.random() * 200;
    sinceGap += 2;
    obsCount++;
  }
  else if (chunk === 'combo_low_high') {
    var h1 = 30 + Math.random() * 15;
    var style2 = Math.floor(Math.random() * 3) + 1;
    var type2 = Math.floor(Math.random() * 3);
    /* Jump airtime is ~1.3s ≈ 330px at full scroll speed, so the high
       obstacle must be at least ~400px away to give time to land + duck. */
    var gap1 = 410 + Math.random() * 90;
    var localGY1 = this._getTerrainY(dist);
    var localGY2 = this._getTerrainY(dist + gap1);
    this.carryPhase.obstacles.push({
      x: dist, type: type, isHigh: false, style: style,
      width: 45 + Math.random() * 25,
      y: localGY1 - h1, height: h1, hit: false, groundY: localGY1
    });
    this.carryPhase.obstacles.push({
      x: dist + gap1, type: type2, isHigh: true, style: style2,
      width: 65 + Math.random() * 25,
      y: 0, height: localGY2 + 5, hit: false, groundY: localGY2
    });
    dist += 540 + Math.random() * 200;
    sinceGap += 2;
    obsCount++;
  }
  else if (chunk === 'combo_high_low') {
    var h2 = 30 + Math.random() * 15;
    var style2 = Math.floor(Math.random() * 3) + 1;
    var type2 = Math.floor(Math.random() * 3);
    var gap1 = 300 + Math.random() * 60;
    var localGY1 = this._getTerrainY(dist);
    var localGY2 = this._getTerrainY(dist + gap1);
    this.carryPhase.obstacles.push({
      x: dist, type: type, isHigh: true, style: style,
      width: 65 + Math.random() * 25,
      y: 0, height: localGY1 + 5, hit: false, groundY: localGY1
    });
    this.carryPhase.obstacles.push({
      x: dist + gap1, type: type2, isHigh: false, style: style2,
      width: 45 + Math.random() * 25,
      y: localGY2 - h2, height: h2, hit: false, groundY: localGY2
    });
    dist += 560 + Math.random() * 200;
    sinceGap += 2;
    obsCount++;
  }
}
}

_getTerrainY(worldX) {
var t = this.carryPhase.terrain;
if (worldX <= t[0].x) return t[0].y;
if (worldX >= t[t.length-1].x) return t[t.length-1].y;
for (var i = 0; i < t.length - 1; i++) {
  if (worldX >= t[i].x && worldX < t[i+1].x) {
    var frac = (worldX - t[i].x) / (t[i+1].x - t[i].x);
    return t[i].y + frac * (t[i+1].y - t[i].y);
  }
}
return this.carryPhase.baseGroundY;
}

_playerJump() {
if (this.phase !== 'carry' || this.carryPhase.staggerTimer > 0 || this.carryPhase.pitFalling) return;
var cp = this.carryPhase;
var onGround = !cp.playerJumping && cp.playerY >= cp.groundY - 5;
if (onGround || cp.coyoteTimer > 0) {
  cp.playerJumping = true;
  cp.playerVelY = cp.jumpPower;
  cp.coyoteTimer = 0;
  cp.jumpBufferTimer = 0;
} else {
  // Pressed in the air: buffer it, fires the instant you land
  cp.jumpBufferTimer = 0.12;
}
}

_playerJumpRelease() {
if (this.phase !== 'carry') return;
var cp = this.carryPhase;
cp.jumpHeld = false;
// Jump cut: releasing while still rising caps the arc — tap for a hop,
// hold for the full jump
if (cp.playerJumping && !cp.pitFalling && cp.playerVelY < -40) {
  cp.playerVelY *= 0.55;
}
}

_checkObstacleCollisions() {
var cp = this.carryPhase;
if (cp.invulnTimer > 0) return;
var isDucking = cp.playerDuckingInput && !cp.playerJumping;
var playerLeft = 85, playerRight = 115;

for (var i = 0; i < cp.obstacles.length; i++) {
  var obs = cp.obstacles[i];
  if (obs.hit) continue;
  var obsLeft = obs.x - cp.scrollPos;
  var obsRight = obsLeft + obs.width;
  if (obsLeft > this.W || obsRight < 0) continue;

  // Horizontal overlap check
  if (playerLeft >= obsRight || playerRight <= obsLeft) continue;

  var collides = false;
  if (obs.isHigh) {
    // HIGH obstacles: you MUST duck. Jumping does NOT help.
    if (!isDucking) collides = true;
    // Trigger duck scatter when successfully ducking through
    if (isDucking && !obs.scattered) {
      obs.scattered = true;
      obs.scatterTime = this.t;
    }
  } else if (obs.isGap) {
    // FLOOR GAP: you must be airborne to clear it. Failing to jump
    // doesn't just hit — the player falls into the pit and bounces
    // out (handled in _updateCarry via pitFalling).
    var isAirborne = cp.playerY < cp.groundY - 15;
    if (!isAirborne) {
      cp.pitFalling = true;
      cp.pitFallPhase = 'fall';
      cp.pitFallY = 0;
      cp.pitFallVel = 0;
      cp.pitFallBottomT = 0;
      cp.pitFallObs = obs;
      if (window.dssAudio && window.dssAudio.dodgeWhoosh) window.dssAudio.dodgeWhoosh();
      return; // skip the rest of collision handling this frame
    }
  } else {
    // LOW obstacles: you must jump over them.
    var isAirborne = cp.playerY < cp.groundY - 15;
    if (!isAirborne) collides = true;
  }

  if (collides) {
    // ANY high-obstacle hit is a head-bonk: knocked back, staggered, and the
    // big rubber duck fires (it used to require being airborne, so plain
    // forgetting to duck never showed the duck — Sam caught it). Still no
    // automatic glass loss: the hit routes through the wobble system below,
    // so the first bonk is a "nearly lost it", and you retry the obstacle.
    var bouncedBack = obs.isHigh;
    if (bouncedBack) {
      cp.scrollPos = Math.max(0, cp.scrollPos - 100);
      cp.playerJumping = false;
      cp.playerVelY = 0;
      cp.playerY = cp.groundY;
      cp.staggerTimer = 0.9;
    }
    // Wobble mechanic: first hit wobbles (drink stays on tray), a second hit
    // within the wobble window is what actually drops a glass.
    if (!cp.wobbling) {
      cp.wobbling = true;
      cp.wobbleTimer = 3.0;
      cp.invulnTimer = bouncedBack ? 1.2 : 1.0;
      cp.screenShake = bouncedBack ? 1.2 : 0.6;
      if (window.dssAudio && window.dssAudio.muffledThud) window.dssAudio.muffledThud();
      if (window.dssAudio && window.dssAudio.glassClink) window.dssAudio.glassClink();
    } else {
      obs.hit = true;
      if (cp.steady > 0) cp.steady--; else
      cp.glassesLeft = Math.max(0, cp.glassesLeft - 1);
      cp.wobbling = false;
      cp.wobbleTimer = 0;
      cp.invulnTimer = 1.5;
      cp.screenShake = 1.6;
      cp.hitFlash = 1;
      if (window.dssAudio && window.dssAudio.punchImpact) window.dssAudio.punchImpact();
      if (window.dssAudio && window.dssAudio.glassClink) window.dssAudio.glassClink();
    }
  }
}
}

// ========== MAIN LOOP ==========
stop() {
  this.stopped = true;
  document.removeEventListener('keydown', this._keydownHandler);
  document.removeEventListener('keyup', this._keyupHandler);
}

_loop() {
if (this.stopped) return;
var now = performance.now(), dt = Math.min(now - this.lt, 50); this.lt = now;
this.t += dt * 0.001;
this._update(dt);
this._draw();
requestAnimationFrame(() => this._loop());
}

_update(dt) {
if (this.phase === 'mixing') this._updateMixing(dt);
if (this.phase === 'carry') this._updateCarry(dt);

// Update sparkles
this.sparkles = this.sparkles.filter((s) => {
  s.x += s.vx;
  s.y += s.vy;
  s.vy += 0.12;
  s.life -= 0.035;
  s.vx *= 0.98;
  return s.life > 0;
});

this.liquidWobble *= 0.94;
}

_updateMixing(dt) {
this.wobT += dt * 0.004;

// A slow target drift with small layered variations: readable movement while pouring.
if (this.pourCommitted && !this.pourDone) {
  this.targetPhase += dt * 0.0026;
  this.targetOff = Math.sin(this.targetPhase * .72) * .075 + Math.sin(this.targetPhase * 1.38 + 1.7) * .035 + Math.sin(this.targetPhase * 2.1 + .9) * .012;
}

// Sobriety hand shake
var drunk = (100 - this.sobriety) / 100;
this.handShake = Math.sin(this.wobT * 4.2) * drunk * 3 + Math.sin(this.wobT * 2.7) * drunk * 2;

if (this.pouring && !this.pourDone) {
  this.pourTime += dt;
  var ramp = Math.min(1, this.pourTime / 400);
  var steadySpeed = 0.00048 * (window.dssEase ? window.dssEase.by('bar', 1, 0.75) : 1); /* 2026-10-28 (dssEase): a slower pour after lost rounds */
  var wobbleMult = 1.0 + drunk * 0.4 * Math.sin(this.wobT * 3.1 + Math.sin(this.wobT * 1.7) * 0.5);
  var speed = steadySpeed * ramp * wobbleMult;
  this.pourLevel = Math.min(1.0, this.pourLevel + Math.max(0.00005, speed) * dt);
  if (this.pourLevel >= 0.995) this.spill = Math.min(1, this.spill + 0.0009 * dt);
  this.bottleAngle = Math.min(0.45, this.bottleAngle + 0.006 * ramp);
  this.pourStream = Math.min(1, this.pourStream + 0.06);

  if (Math.random() < 0.25 && ramp > 0.3) {
    this.pourDrops.push({
      x: this.W/2 - 11 + Math.random()*22,
      y: (this._surfY || 300) - 2,
      vy: -(0.6 + Math.random()*1.6),
      vx: (Math.random()-0.5) * 1.6,
      life: 1
    });
  }

  if (this.mRound === 1 && this.pourLevel > 0.08 && Math.random() < 0.12) {
    this.bubbles.push({
      x: this.W/2 - 16 + Math.random()*32,
      y: (this._surfY || 300) + 8 + Math.random() * 46,
      vy: -0.2 - Math.random()*0.4,
      life: 1,
      r: 0.8 + Math.random()*2
    });
  }
} else {
  this.bottleAngle = Math.max(0, this.bottleAngle - 0.015);
  this.pourStream = Math.max(0, this.pourStream - 0.04);
}

this.pourDrops = this.pourDrops.filter(function(d) {
  d.y += d.vy; d.x += (d.vx || 0); d.vy += 0.08; d.life -= 0.025;
  return d.life > 0 && d.y < 340;
});

this.bubbles = this.bubbles.filter(function(b) {
  b.y += b.vy; b.x += Math.sin(b.y * 0.1) * 0.15; b.life -= 0.006;
  return b.life > 0;
});
if (this.perfectRing > 0) this.perfectRing = Math.max(0, this.perfectRing - 0.0011 * dt);
}

_updateCarry(dt) {
var cp = this.carryPhase;
var s = dt * 0.001;

// Stagger timer: character is stunned, world pauses
if (cp.staggerTimer > 0) {
  cp.staggerTimer -= s;
  if (cp.invulnTimer > 0) cp.invulnTimer -= s;
  cp.screenShake *= 0.92;
  // Don't scroll or check collisions during stagger
  return;
}

// Pit-fall animation — physics-based: player drops in under gravity,
// hits bottom, then a sharp upward kick launches them clear of the pit
// (overshoots groundY slightly, like a proper jump out).
if (cp.pitFalling) {
  var pitG     = 1600; // gravity for the pit-bounce (stronger than normal)
  var pitDepth = 88;   // deep enough that the pit visibly swallows him
  var pitKick  = -640; // initial upward velocity when bouncing out
  if (cp.pitFallPhase === 'fall') {
    cp.pitFallVel += pitG * s;
    cp.pitFallY += cp.pitFallVel * s;
    if (cp.pitFallY >= pitDepth) {
      cp.pitFallY = pitDepth;
      cp.pitFallVel = 0;
      cp.pitFallPhase = 'bottom';
      cp.pitFallBottomT = 0;
      cp.screenShake = 1.0;
      if (window.dssAudio && window.dssAudio.muffledThud) window.dssAudio.muffledThud();
      if (window.dssAudio && window.dssAudio.glassClink) window.dssAudio.glassClink();
    }
  } else if (cp.pitFallPhase === 'bottom') {
    cp.pitFallBottomT += s;
    if (cp.pitFallBottomT >= 0.12) {
      cp.pitFallVel = pitKick;
      cp.pitFallPhase = 'rising';
      if (window.dssAudio && window.dssAudio.dodgeWhoosh) window.dssAudio.dodgeWhoosh();
    }
  } else if (cp.pitFallPhase === 'rising') {
    cp.pitFallVel += pitG * s;
    cp.pitFallY += cp.pitFallVel * s;
    // After overshoot, when falling back through ground level, end the animation.
    if (cp.pitFallY <= 0 && cp.pitFallVel > 0) {
      cp.pitFalling = false;
      cp.pitFallPhase = null;
      cp.playerY = cp.groundY;
      cp.playerVelY = 0;
      cp.playerJumping = false;
      if (cp.pitFallObs) {
        cp.pitFallObs.hit = true;
        // Land on the FAR lip of the gap — he claws out the other side
        // instead of walking the rest of the hole on invisible floor.
        cp.scrollPos = Math.max(cp.scrollPos, cp.pitFallObs.x + cp.pitFallObs.width - 94);
        cp.groundY = this._getTerrainY(cp.scrollPos + 100);
      }
      cp.landPuff = 1;
      if (!cp.wobbling) {
        cp.wobbling = true;
        cp.wobbleTimer = 3.0;
      } else {
        if (cp.steady > 0) cp.steady--; else
        cp.glassesLeft = Math.max(0, cp.glassesLeft - 1);
        cp.wobbling = false;
        cp.wobbleTimer = 0;
      }
      cp.invulnTimer = 1.4;
      cp.screenShake = 1.3;
      cp.hitFlash = 1;
      cp.pitFallObs = null;
      if (cp.invulnTimer > 0) cp.invulnTimer -= s;
      cp.screenShake *= 0.92;
      return;
    }
  }
  cp.playerY = cp.groundY + cp.pitFallY;
  cp.playerVelY = 0;
  cp.playerJumping = false;
  if (cp.invulnTimer > 0) cp.invulnTimer -= s;
  cp.screenShake *= 0.92;
  return;
}

// Speed ramp: starts at 170, gently climbs to 260, plateaus
var progressRatio = cp.scrollPos / cp.maxScroll;
cp.scrollSpeed = (170 + Math.min(progressRatio * 1.5, 1.0) * 90) * (window.dssEase ? window.dssEase.by('bar', 1, 0.75) : 1); /* 2026-10-28 (dssEase) */
cp.difficultyPhase = Math.floor(progressRatio * 4);

// Dynamic terrain: player is at screen x=100, so world x = scrollPos + 100
cp.groundY = this._getTerrainY(cp.scrollPos + 100);

// Player physics — Mario rules: normal gravity on the way up, heavier
// on the way down, so the arc floats at its peak and lands with weight
var grav = cp.playerVelY >= 0 ? cp.gravity * 1.8 : cp.gravity;
cp.playerVelY += grav * s;
cp.playerY += cp.playerVelY * s;

// Ground collision / terrain following
if (cp.playerJumping) {
  if (cp.coyoteTimer > 0) cp.coyoteTimer -= s;
  if (cp.jumpBufferTimer > 0) cp.jumpBufferTimer -= s;
  // Airborne: land when reaching the ground
  if (cp.playerY >= cp.groundY && cp.playerVelY >= 0) {
    cp.playerY = cp.groundY;
    cp.playerVelY = 0;
    cp.playerJumping = false;
    // A jump pressed just before touchdown fires the moment you land
    if (cp.jumpBufferTimer > 0 && cp.staggerTimer <= 0) {
      cp.playerJumping = true;
      cp.playerVelY = cp.jumpPower;
      cp.jumpBufferTimer = 0;
    }
  }
} else {
  if (cp.groundY > cp.playerY + 2) {
    // The floor stepped DOWN: walk off the ledge into the air instead of
    // teleporting to it — coyote time lets a late jump still take off
    cp.playerJumping = true;
    cp.coyoteTimer = 0.09;
  } else {
    // On ground: follow terrain smoothly
    cp.playerY = cp.groundY;
    cp.playerVelY = 0;
    cp.coyoteTimer = 0.09;
  }
}

// Hold RIGHT (or D) to hurry, LEFT (or A) to hang back — your pace, your
// risk; the lean smooths toward the pace for the sprite
var speedMul = cp.speedHold > 0 ? 1.45 : (cp.speedHold < 0 ? 0.62 : 1);
cp.runLean += ((speedMul - 1) - cp.runLean) * Math.min(1, s * 6);
cp.scrollPos += cp.scrollSpeed * speedMul * s;

// Collect the floating blue notes. Three in a phrase restore one spilled
// drink (up to the original three) and briefly steady the tray.
for (var ni = 0; ni < cp.grooveNotes.length; ni++) {
  var note = cp.grooveNotes[ni];
  if (note.hit) continue;
  var nx = note.x - cp.scrollPos;
  if (nx < 76 || nx > 124) continue;
  if (Math.abs(cp.playerY - note.y) < 34) {
    note.hit = true;
    cp.groove = (cp.groove || 0) + 1;
    cp.grooveFlash = 1;
    if (cp.groove >= 3) {
      cp.groove = 0;
      cp.glassesLeft = Math.min(3, cp.glassesLeft + 1);
      cp.invulnTimer = Math.max(cp.invulnTimer, 1.6);
      cp.wobbling = false;
      cp.wobbleTimer = 0;
      if (window.dssAudio && window.dssAudio.glassClink) window.dssAudio.glassClink();
    } else if (window.dssAudio && window.dssAudio.tabTick) window.dssAudio.tabTick();
  }
}
cp.grooveFlash = Math.max(0, (cp.grooveFlash || 0) - s * 2.5);

this._checkObstacleCollisions();

if (cp.invulnTimer > 0) cp.invulnTimer -= s;
if (cp.hitFlash > 0) cp.hitFlash = Math.max(0, cp.hitFlash - s * 1.8);
if (cp.landPuff > 0) cp.landPuff = Math.max(0, cp.landPuff - s * 2.6);
var airborneNow = cp.playerY < cp.groundY - 2;
if (this._wasAirborne && !airborneNow && !cp.pitFalling) cp.landPuff = 1;
this._wasAirborne = airborneNow;
cp.screenShake *= 0.92;

// Wobble timer: if you survive long enough after a wobble, it resets
if (cp.wobbling) {
  cp.wobbleTimer -= s;
  if (cp.wobbleTimer <= 0) {
    cp.wobbling = false;
    cp.wobbleTimer = 0;
  }
}

if (cp.scrollPos >= cp.maxScroll) {
  this.phase = 'result';
  this._resultCarry();
}
}


_draw() {
if (this.phase === 'mixing') this._drawMixing();
else if (this.phase === 'carryWait') this._drawCarryWait();
else if (this.phase === 'carry') this._drawCarry();
else if (this.phase === 'result') this._drawResult();
}


_drawCarryWait() {
var c = this.ctx, W = this.W, H = this.H;
c.fillStyle = '#0a0804';
c.fillRect(0, 0, W, H);
this._drawAtmosphere(c);
c.save();
c.font = 'bold 20px Georgia';
c.textAlign = 'center';
c.fillStyle = '#d4a574';
c.fillText('Get ready...', W/2, H/2 - 20);
c.font = '14px Georgia';
c.fillStyle = '#8a7a6a';
if (window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches) {
  c.fillText('Tap high to jump. Hold it for a higher jump.', W/2, H/2 + 20);
  c.fillText('Hold low on the floor to duck.', W/2, H/2 + 45);
} else {
c.fillText('SPACE / UP to jump. Hold it for a higher jump.', W/2, H/2 + 20);
c.fillText('DOWN to duck', W/2, H/2 + 45);
c.fillText('Hold RIGHT to hurry. Hold LEFT to hang back.', W/2, H/2 + 70);
}
c.fillStyle = '#79b9cf';
c.fillText('\u266b Catch three floating notes to steady the tray.', W/2, H/2 + 95);
c.restore();
}

// ========== DRAW: MIXING ==========
_drawMixing() {
var c = this.ctx, W = this.W, H = this.H;
c.fillStyle = '#0e0c12';
c.fillRect(0, 0, W, H);

// ---- Back-bar: mirror glow, shelf, ranked bottle silhouettes ----
var shelfY = 128;
var mg0 = c.createLinearGradient(0, 40, 0, shelfY);
mg0.addColorStop(0, 'rgba(52,40,26,0)');
mg0.addColorStop(0.7, 'rgba(70,54,34,0.30)');
mg0.addColorStop(1, 'rgba(40,30,18,0.42)');
c.fillStyle = mg0;
c.fillRect(90, 40, W - 180, shelfY - 40);
var bcols = ['#3a2a14','#1e2a1e','#2a1c26','#33261a','#20242e','#3a2010','#26301c','#301c1c','#2c2214','#1c2620'];
for (var bi = 0; bi < 10; bi++) {
  var bxp = 108 + bi * ((W - 216) / 9);
  var bhh = 34 + ((bi * 37) % 24);
  var bww = 11 + ((bi * 13) % 5);
  c.globalAlpha = 0.85;
  c.fillStyle = bcols[bi % bcols.length];
  c.fillRect(bxp - bww / 2, shelfY - bhh, bww, bhh);
  c.fillRect(bxp - 2, shelfY - bhh - 9, 4, 9);
  c.globalAlpha = 0.25;
  c.fillStyle = '#e8cc88';
  c.fillRect(bxp - bww / 2 + 1.5, shelfY - bhh + 3, 1.6, bhh - 8);
  c.globalAlpha = 1;
}
c.fillStyle = 'rgba(46,30,16,0.9)';
c.fillRect(86, shelfY, W - 172, 6);
c.fillStyle = 'rgba(201,160,80,0.28)';
c.fillRect(86, shelfY, W - 172, 1.4);

this._drawAtmosphere(c);

// spotlight cone on the working glass
var gx = W / 2;
c.save();
c.globalAlpha = 0.055 + Math.sin(this.t * 2.3) * 0.012;
c.fillStyle = '#ffe0a0';
c.beginPath();
c.moveTo(gx - 14, 0); c.lineTo(gx + 14, 0);
c.lineTo(gx + 88, 372); c.lineTo(gx - 88, 372);
c.closePath(); c.fill();
c.restore();

// ---- Counter ----
var counterY = 372;
var wg = c.createLinearGradient(0, counterY, 0, H);
wg.addColorStop(0, '#31200f');
wg.addColorStop(0.14, '#241708');
wg.addColorStop(1, '#120a04');
c.fillStyle = wg;
c.fillRect(0, counterY, W, H - counterY);
c.fillStyle = 'rgba(220,180,110,0.16)';
c.fillRect(0, counterY, W, 2);
c.strokeStyle = 'rgba(0,0,0,0.35)'; c.lineWidth = 1;
for (var wgl = 0; wgl < 5; wgl++) {
  c.beginPath();
  c.moveTo(0, counterY + 7 + wgl * 5.5);
  c.bezierCurveTo(W * 0.3, counterY + 5 + wgl * 5.5 + (wgl % 2), W * 0.7, counterY + 9 + wgl * 5.5 - (wgl % 2), W, counterY + 6 + wgl * 5.5);
  c.stroke();
}
var d = this.drinks[this.mRound];
c.save();
c.globalAlpha = 0.10;
var refl = c.createRadialGradient(gx, counterY + 8, 2, gx, counterY + 8, 60);
refl.addColorStop(0, d.liqCol);
refl.addColorStop(1, 'rgba(0,0,0,0)');
c.fillStyle = refl;
c.beginPath(); c.ellipse(gx, counterY + 9, 58, 8, 0, 0, Math.PI * 2); c.fill();
c.restore();

// Lamp reflection, worn grain and the dark oval of a bar coaster under the glass.
c.save();var pool=c.createRadialGradient(gx,290,8,gx,290,190);pool.addColorStop(0,'rgba(191,156,100,.10)');pool.addColorStop(.6,'rgba(122,100,91,.035)');pool.addColorStop(1,'rgba(0,0,0,0)');c.fillStyle=pool;c.fillRect(90,100,W-180,280);
c.fillStyle='#161215';c.beginPath();c.ellipse(gx,376,58,9,0,0,Math.PI*2);c.fill();c.strokeStyle='#9f855b55';c.lineWidth=.8;c.beginPath();c.ellipse(gx,376,56,8,0,0,Math.PI*2);c.stroke();c.restore();
// ---- Working glass (each type offset so its base meets the counter) ----
var glassGy = 230 + (372-230)/2.05 - {tulip:98,copper:55,rocks:42}[d.glass];
var gy = glassGy;
var glassScale = 2.05;
c.save();
c.translate(gx, 230);
c.scale(glassScale, glassScale);
c.translate(-gx, -230);
this._drawGlass(c, d.glass, gx, gy, this.pourLevel, d.target, d.liqCol, d.liqHi);

// target band: gold-etched centre line with chevrons, brighter zones
var guideHalf = d.glass==='rocks'?25:d.glass==='copper'?21:18;
var effTarget = Math.max(.1,Math.min(.9,d.target + this.targetOff));
var targetY    = this._liquidY(d.glass, gy, effTarget);
var bandTop    = this._liquidY(d.glass, gy, effTarget + 0.16);
var bandBottom = this._liquidY(d.glass, gy, effTarget - 0.16);
var perfTop    = this._liquidY(d.glass, gy, effTarget + 0.07);
var perfBottom = this._liquidY(d.glass, gy, effTarget - 0.07);
c.fillStyle = 'rgba(255, 200, 120, 0.10)';
c.fillRect(gx - guideHalf, bandTop, guideHalf*2, bandBottom - bandTop);
c.fillStyle = 'rgba(220, 202, 147, 0.19)';
c.fillRect(gx - guideHalf, perfTop, guideHalf*2, perfBottom - perfTop);
c.strokeStyle = 'rgba(232, 204, 136, 0.85)';
c.lineWidth = 1.6;
c.beginPath();
c.moveTo(gx - guideHalf, targetY);
c.lineTo(gx + guideHalf, targetY);
c.stroke();
c.fillStyle = 'rgba(232, 204, 136, 0.9)';
c.beginPath();
c.moveTo(gx - guideHalf - 9, targetY - 5); c.lineTo(gx - guideHalf - 3, targetY); c.lineTo(gx - guideHalf - 9, targetY + 5);
c.closePath(); c.fill();
c.beginPath();
c.moveTo(gx + guideHalf + 9, targetY - 5); c.lineTo(gx + guideHalf + 3, targetY); c.lineTo(gx + guideHalf + 9, targetY + 5);
c.closePath(); c.fill();
c.strokeStyle = 'rgba(255, 200, 120, 0.30)';
c.lineWidth = 0.8;
c.setLineDash([3, 3]);
c.beginPath();
c.moveTo(gx - guideHalf, bandTop);    c.lineTo(gx + guideHalf, bandTop);
c.moveTo(gx - guideHalf, bandBottom); c.lineTo(gx + guideHalf, bandBottom);
c.stroke();
c.setLineDash([]);

// overfill: rivulets running down the glass
if (this.spill > 0.02) {
  c.strokeStyle = 'rgba(' + parseInt(d.liqCol.slice(1,3),16) + ',' + parseInt(d.liqCol.slice(3,5),16) + ',' + parseInt(d.liqCol.slice(5,7),16) + ',0.55)';
  c.lineWidth = 2;
  c.lineCap = 'round';
  var glassBot = {tulip: gy + 65, copper: gy + 55, rocks: gy + 42}[d.glass];
  var rimY = {tulip: gy - 8, copper: gy, rocks: gy}[d.glass];
  c.beginPath();
  c.moveTo(gx - 13, rimY + 2);
  c.quadraticCurveTo(gx - 17, (rimY + glassBot) / 2, gx - 15, glassBot + this.spill * 8);
  c.stroke();
  c.beginPath();
  c.moveTo(gx + 11, rimY + 3);
  c.quadraticCurveTo(gx + 15, (rimY + glassBot) / 2 + 6, gx + 13, glassBot + this.spill * 6);
  c.stroke();
}
c.restore();

// liquid surface in screen coordinates, for the stream and spray
var surfP = this._liquidY(d.glass, gy, Math.max(0.02, this.pourLevel));
this._surfY = 230 + glassScale * (surfP - 230);

// overfill puddle on the counter
if (this.spill > 0.02) {
  c.save();
  c.globalAlpha = 0.4;
  c.fillStyle = d.liqCol;
  c.beginPath();
  c.ellipse(gx + 4, counterY + 5, 10 + this.spill * 42, 3 + this.spill * 4, 0, 0, Math.PI * 2);
  c.fill();
  c.restore();
}

// ---- Bottle: rests on the counter, lifts and tips over the glass ----
var lift = Math.min(1, this.pourStream * 1.4);
var ease = lift * lift * (3 - 2 * lift);
var pvX = gx + 112 - ease * 58 + this.handShake;
var pvY = 258 - ease * 132;
var ang = -ease * 2.35;
c.save();
c.translate(pvX, pvY);
c.rotate(ang);
this._drawBottle(c, -20, 0, 40, 90, d.bottle.col, d.bottle.acc, d.bottle.lab);
c.restore();

// the stream
if (this.pourStream > 0.2) {
  var sAlpha = Math.min(1, (this.pourStream - 0.2) * 1.6);
  var sy0 = pvY + 2, sx0 = pvX + Math.sin(ang) * 4;
  var sy1 = this._surfY, sx1 = gx + 2 + this.handShake * 0.4;
  c.lineCap = 'round';
  c.strokeStyle = 'rgba(' + parseInt(d.liqCol.slice(1,3),16) + ',' + parseInt(d.liqCol.slice(3,5),16) + ',' + parseInt(d.liqCol.slice(5,7),16) + ',' + (sAlpha * 0.85).toFixed(2) + ')';
  c.lineWidth = 3.1 + Math.sin(this.t * 9) * 0.5;
  c.beginPath();
  c.moveTo(sx0, sy0);
  c.quadraticCurveTo(sx0 + (sx1 - sx0) * 0.25 + Math.sin(this.t * 6) * 2.5, (sy0 + sy1) * 0.55, sx1, sy1);
  c.stroke();
  c.strokeStyle = 'rgba(255, 240, 200, ' + (sAlpha * 0.4).toFixed(2) + ')';
  c.lineWidth = 1.1;
  c.beginPath();
  c.moveTo(sx0 - 1, sy0);
  c.quadraticCurveTo(sx0 + (sx1 - sx0) * 0.25 + Math.sin(this.t * 6) * 2, (sy0 + sy1) * 0.55, sx1 - 1.5, sy1);
  c.stroke();
  // splash crown where it lands
  c.strokeStyle = 'rgba(255, 235, 190, ' + (sAlpha * 0.5).toFixed(2) + ')';
  c.lineWidth = 1;
  for (var sp2 = 0; sp2 < 3; sp2++) {
    var spx = sx1 - 6 + sp2 * 6;
    c.beginPath();
    c.arc(spx, sy1 - 1, 2.2 + Math.sin(this.t * 11 + sp2 * 2.1) * 0.8, Math.PI, Math.PI * 2);
    c.stroke();
  }
}

// spray drops
c.fillStyle = d.liqCol;
this.pourDrops.forEach((drop) => {
  c.globalAlpha = drop.life * 0.7;
  c.beginPath();
  c.arc(drop.x, drop.y, 1.8, 0, Math.PI * 2);
  c.fill();
});
c.globalAlpha = 1;

// bubbles (Moscow Mule)
this.bubbles.forEach((b) => {
  c.save();
  c.globalAlpha = b.life * 0.6;
  c.strokeStyle = 'rgba(200, 200, 255, 0.8)';
  c.lineWidth = 1;
  c.beginPath();
  c.arc(b.x, b.y, b.r, 0, Math.PI * 2);
  c.stroke();
  c.restore();
});

// perfect-pour flourish ring
if (this.perfectRing > 0.01) {
  var pr = (1 - this.perfectRing) * 95 + 24;
  c.save();
  c.globalAlpha = this.perfectRing * 0.55;
  c.strokeStyle = '#ffd97a';
  c.lineWidth = 2.4;
  c.beginPath();
  c.ellipse(gx, 300, pr, pr * 0.6, 0, 0, Math.PI * 2);
  c.stroke();
  c.restore();
}

// Full-size DOM lettering stays readable on a phone; update only when its message changes.
var readout=this.mRound+':'+this.completedDrinks.length;
if(this._pourReadout!==readout){
 this._pourReadout=readout;var rail=document.getElementById('bar-pour-rail');
 if(rail){rail.innerHTML='';this.drinks.forEach((drink,i)=>{var item=document.createElement('div');item.className='bar-pour-order'+(i<this.completedDrinks.length?' done':i===this.mRound?' current':'');var n=document.createElement('span');n.className='bar-pour-order-name';n.textContent=drink.name;var who=document.createElement('small');who.textContent=i<this.completedDrinks.length?'On the tray':drink.who;item.append(n,who);rail.appendChild(item);});}
}
var cue=document.getElementById('bar-pour-cue');
var delta=this.pourLevel-effTarget;
var message=this.pourDone?(this.pourAccuracy===2?'Perfect pour.':this.pourAccuracy===1?'Close enough.':delta>0?'Too much.':'Not enough.'):!this.pourCommitted?'Hold to pour · release at the brass line':Math.abs(delta)<.07?'Release now':delta>.07?'Over the line · release to stop':'Keep pouring towards the brass line';
if(cue&&cue.textContent!==message){cue.textContent=message;cue.classList.toggle('on-target',!this.pourDone&&this.pourCommitted&&Math.abs(delta)<.07);}
this._drawSparkles(c);
}

_drawCompletedDrink(c, cd, dx, dy) {
c.save();
c.font = 'bold 10px Georgia';
c.textAlign = 'center';
c.fillStyle = '#d4a574';
c.fillText(cd.who, dx + 35, dy + 5);

// Mini glass
var gy = dy + 20;
this._drawGlass(c, cd.glass, dx + 35, gy, 0.6, 0, cd.liqCol, '#fff');

// Accuracy stars
c.font = 'bold 14px Georgia';
var starColor = cd.accuracy === 2 ? '#e8c060' : cd.accuracy === 1 ? '#d4a574' : '#666';
c.fillStyle = starColor;
if (cd.accuracy === 2) {
  c.fillText('★', dx + 35, dy + 75);
} else if (cd.accuracy === 1) {
  c.fillText('◐', dx + 35, dy + 75);
} else {
  c.fillText('○', dx + 35, dy + 75);
}

c.restore();
}

_drawGlass(c, type, gx, gy, fill, target, liqCol, liqHi) {
c.save();
if (type === 'tulip') {
  var bw = 30, bh = 70, stemH = 28, baseW = 22;
  c.fillStyle = 'rgba(180,170,160,0.25)';
  c.fillRect(gx - 2, gy + bh - 5, 4, stemH);
  c.beginPath();
  c.ellipse(gx, gy + bh + stemH - 2, baseW/2, 4, 0, 0, Math.PI * 2);
  c.fillStyle = 'rgba(180,170,160,0.3)';
  c.fill();
  c.beginPath();
  c.moveTo(gx - 6, gy + bh - 5);
  c.quadraticCurveTo(gx - bw/2 - 8, gy + bh * 0.5, gx - bw/2, gy + bh * 0.2);
  c.quadraticCurveTo(gx - bw/2 + 4, gy - 5, gx, gy - 8);
  c.quadraticCurveTo(gx + bw/2 - 4, gy - 5, gx + bw/2, gy + bh * 0.2);
  c.quadraticCurveTo(gx + bw/2 + 8, gy + bh * 0.5, gx + 6, gy + bh - 5);
  c.closePath();
  c.strokeStyle = 'rgba(200,190,180,0.4)';
  c.lineWidth = 1.5;
  c.stroke();
  if (fill > 0) {
    var liqTop = gy + bh * (1 - fill * 0.85) - 5;
    c.save();
    c.beginPath();
    c.moveTo(gx - 6, gy + bh - 5);
    c.quadraticCurveTo(gx - bw/2 - 8, gy + bh * 0.5, gx - bw/2, gy + bh * 0.2);
    c.quadraticCurveTo(gx - bw/2 + 4, gy - 5, gx, gy - 8);
    c.quadraticCurveTo(gx + bw/2 - 4, gy - 5, gx + bw/2, gy + bh * 0.2);
    c.quadraticCurveTo(gx + bw/2 + 8, gy + bh * 0.5, gx + 6, gy + bh - 5);
    c.closePath();
    c.clip();
    var lg = c.createLinearGradient(gx - bw/2, liqTop, gx + bw/2, gy + bh);
    lg.addColorStop(0, liqHi);
    lg.addColorStop(1, liqCol);
    c.fillStyle = lg;
    c.globalAlpha = 0.62;
    c.fillRect(gx - bw, liqTop, bw * 2, gy + bh - liqTop + 10);
    if (this.liquidWobble > 0) {
      c.globalAlpha = this.liquidWobble * 0.3;
      for (var i = 0; i < 3; i++) {
        var rippleY = liqTop + Math.sin(this.t * 5 + i) * 2;
        c.strokeStyle = 'rgba(255,255,255,0.4)';
        c.lineWidth = 0.5;
        c.beginPath();
        c.moveTo(gx - 10, rippleY);
        c.quadraticCurveTo(gx, rippleY - 1, gx + 10, rippleY);
        c.stroke();
      }
    }
    c.globalAlpha = 0.08;
    c.fillStyle = 'rgba(255,255,255,1)';
    c.fillRect(gx - bw/2 + 2, liqTop, bw * 0.3, gy + bh - liqTop);
    c.restore();
  }
  c.strokeStyle = 'rgba(235,250,249,0.42)';
  c.lineWidth = 1;
  c.beginPath();
  c.moveTo(gx - bw/2 + 5, gy + bh * 0.3);
  c.lineTo(gx - bw/2 + 3, gy + bh * 0.6);
  c.stroke();
} else if (type === 'copper') {
  var mw = 36, mh = 55;
  c.strokeStyle = '#8a6030';
  c.lineWidth = 3;
  c.beginPath();
  c.arc(gx + mw/2 + 8, gy + mh/2, 12, -1.2, 1.2);
  c.stroke();
  var mg = c.createLinearGradient(gx - mw/2, 0, gx + mw/2, 0);
  mg.addColorStop(0, '#8a5a20');
  mg.addColorStop(0.3, '#c9883a');
  mg.addColorStop(0.5, '#daa050');
  mg.addColorStop(0.7, '#c98838');
  mg.addColorStop(1, '#8a5a20');
  c.fillStyle = mg;
  c.beginPath();
  c.roundRect(gx - mw/2, gy, mw, mh, 3);
  c.fill();
  c.strokeStyle = '#e8b860';
  c.lineWidth = 1.5;
  c.beginPath();
  c.moveTo(gx - mw/2, gy + 2);
  c.lineTo(gx + mw/2, gy + 2);
  c.stroke();
  if (fill > 0) {
    var liqTop2 = gy + mh * (1 - fill * 0.85);
    c.save();
    c.beginPath();
    c.roundRect(gx - mw/2, gy, mw, mh, 3);
    c.clip();
    var lg2 = c.createLinearGradient(0, liqTop2, 0, gy + mh);
    lg2.addColorStop(0, liqHi);
    lg2.addColorStop(1, liqCol);
    c.fillStyle = lg2;
    c.fillRect(gx - mw/2, liqTop2, mw, mh);
    if (this.liquidWobble > 0) {
      c.globalAlpha = this.liquidWobble * 0.2;
      for (var i = 0; i < 2; i++) {
        var rippleY = liqTop2 + Math.sin(this.t * 4.5 + i) * 1.5;
        c.strokeStyle = 'rgba(255,255,255,0.3)';
        c.lineWidth = 0.5;
        c.beginPath();
        c.moveTo(gx - 12, rippleY);
        c.quadraticCurveTo(gx, rippleY - 1, gx + 12, rippleY);
        c.stroke();
      }
    }
    c.restore();
  }
  c.save();
  c.globalAlpha = 0.2;
  for (var i = 0; i < 4; i++) {
    var dx2 = gx - mw/2 + 5 + i * 9, dy2 = gy + 15 + (i % 2) * 12;
    c.beginPath();
    c.ellipse(dx2, dy2, 1.5, 2.5, 0, 0, Math.PI * 2);
    c.fillStyle = '#e8d8c0';
    c.fill();
  }
  c.restore();
} else if (type === 'rocks') {
  var rw = 36, rh = 42;
  c.beginPath();
  c.moveTo(gx - rw/2 + 3, gy);
  c.lineTo(gx - rw/2, gy + rh);
  c.lineTo(gx + rw/2, gy + rh);
  c.lineTo(gx + rw/2 - 3, gy);
  c.closePath();
  c.strokeStyle = 'rgba(200,190,180,0.35)';
  c.lineWidth = 1.5;
  c.stroke();
  c.save();
  c.globalAlpha = 0.08;
  c.strokeStyle = '#fff';
  c.lineWidth = 0.5;
  for (var i = 0; i < 5; i++) {
    var cy = gy + 8 + i * 7;
    c.beginPath();
    c.moveTo(gx - rw/2 + 4, cy);
    c.lineTo(gx + rw/2 - 4, cy);
    c.stroke();
  }
  c.restore();
  if (fill > 0) {
    var liqTop3 = gy + rh * (1 - fill * 0.85);
    c.save();
    c.beginPath();
    c.moveTo(gx - rw/2 + 3, gy);
    c.lineTo(gx - rw/2, gy + rh);
    c.lineTo(gx + rw/2, gy + rh);
    c.lineTo(gx + rw/2 - 3, gy);
    c.closePath();
    c.clip();
    var lg3 = c.createLinearGradient(0, liqTop3, 0, gy + rh);
    lg3.addColorStop(0, liqHi);
    lg3.addColorStop(1, liqCol);
    c.fillStyle = lg3;
    c.globalAlpha = 0.62;
    c.fillRect(gx - rw, liqTop3, rw * 2, rh);
    if (this.liquidWobble > 0) {
      c.globalAlpha = this.liquidWobble * 0.25;
      for (var i = 0; i < 2; i++) {
        var rippleY = liqTop3 + Math.sin(this.t * 5.2 + i * 0.5) * 1.8;
        c.strokeStyle = 'rgba(255,255,255,0.4)';
        c.lineWidth = 0.5;
        c.beginPath();
        c.moveTo(gx - 12, rippleY);
        c.quadraticCurveTo(gx, rippleY - 1, gx + 12, rippleY);
        c.stroke();
      }
    }
    c.globalAlpha = 0.06;
    c.fillStyle = 'rgba(255,255,255,1)';
    c.fillRect(gx - rw/2 + 3, liqTop3, rw * 0.25, rh);
    c.restore();
  }
  c.strokeStyle = 'rgba(235,250,249,0.42)';
  c.lineWidth = 1;
  c.beginPath();
  c.moveTo(gx - rw/2 + 5, gy + 5);
  c.lineTo(gx - rw/2 + 3, gy + rh - 5);
  c.stroke();
  c.fillStyle = 'rgba(200,190,180,0.12)';
  c.fillRect(gx - rw/2 + 1, gy + rh - 6, rw - 2, 6);
}
c.restore();
}

_drawBottle(c, x, y, w, h, col, acc, lab) {
c.fillStyle = col;
var nW = 10, nH = 20, cx = x + w / 2;
c.beginPath();
c.moveTo(cx - nW/2, y);
c.lineTo(cx - nW/2, y + nH);
c.quadraticCurveTo(x + 2, y + nH + 5, x + 4, y + nH + 12);
c.lineTo(x + 4, y + h - 5);
c.quadraticCurveTo(x + 4, y + h, x + 8, y + h);
c.lineTo(x + w - 8, y + h);
c.quadraticCurveTo(x + w - 4, y + h, x + w - 4, y + h - 5);
c.lineTo(x + w - 4, y + nH + 12);
c.quadraticCurveTo(x + w - 2, y + nH + 5, cx + nW/2, y + nH);
c.lineTo(cx + nW/2, y);
c.closePath();
c.fill();
c.fillStyle = acc;
c.fillRect(x + 6, y + h * 0.35, w - 12, h * 0.3);
if (lab === 'WT') {
  // Wild Turkey — a small turkey silhouette in profile on the cream label.
  c.save();
  c.translate(cx, y + h * 0.5);
  c.fillStyle = col;
  c.strokeStyle = col;
  c.lineCap = 'round';
  c.lineJoin = 'round';
  // Tail feathers — five lines fanning up and back to the left
  c.lineWidth = 1.6;
  c.beginPath();
  for (var ti = 0; ti < 5; ti++) {
    var ang = -Math.PI + 0.30 + ti * 0.30;
    var len = 8.5;
    c.moveTo(-1, 0);
    c.lineTo(-1 + Math.cos(ang) * len, Math.sin(ang) * len);
  }
  c.stroke();
  // Body
  c.beginPath();
  c.ellipse(0, 1, 6.5, 4.2, 0.05, 0, Math.PI * 2);
  c.fill();
  // Neck — curving up and to the right
  c.lineWidth = 2;
  c.beginPath();
  c.moveTo(3, -1);
  c.quadraticCurveTo(5.5, -3.5, 6.5, -7);
  c.stroke();
  // Head
  c.beginPath();
  c.arc(6.6, -7.5, 1.9, 0, Math.PI * 2);
  c.fill();
  // Beak — small triangle pointing right
  c.beginPath();
  c.moveTo(8.2, -7.5);
  c.lineTo(10.5, -7.0);
  c.lineTo(8.2, -6.4);
  c.closePath();
  c.fill();
  // Wattle — a small red dab below the beak
  c.fillStyle = '#a01818';
  c.beginPath();
  c.arc(7.6, -5.5, 0.9, 0, Math.PI * 2);
  c.fill();
  // Tiny eye highlight on the head
  c.fillStyle = acc;
  c.beginPath();
  c.arc(7.0, -8.0, 0.4, 0, Math.PI * 2);
  c.fill();
  // Two leg lines down from body
  c.strokeStyle = col;
  c.lineWidth = 0.9;
  c.beginPath();
  c.moveTo(-1, 4.5); c.lineTo(-1.5, 7);
  c.moveTo(2, 4.5);  c.lineTo(2.5, 7);
  c.stroke();
  c.restore();
} else {
  c.fillStyle = col;
  c.font = 'bold 11px Georgia';
  c.textAlign = 'center';
  c.fillText(lab, cx, y + h * 0.35 + h * 0.15 + 4);
}
c.fillStyle = '#555';
c.fillRect(cx - nW/2 - 1, y - 3, nW + 2, 5);
c.save();
c.globalAlpha = 0.08;
c.fillStyle = '#fff';
c.fillRect(x + 6, y + nH + 14, 4, h * 0.5);
c.restore();
}

_drawAtmosphere(c) {
var W = this.W, H = this.H;
var lg1 = c.createRadialGradient(W*0.2, -30, 20, W*0.2, 80, 250);
lg1.addColorStop(0, 'rgba(255,220,150,0.08)');
lg1.addColorStop(1, 'rgba(0,0,0,0)');
c.fillStyle = lg1;
c.fillRect(0, 0, W, 180);
var lg2 = c.createRadialGradient(W*0.8, -20, 20, W*0.8, 70, 240);
lg2.addColorStop(0, 'rgba(255,180,100,0.06)');
lg2.addColorStop(1, 'rgba(0,0,0,0)');
c.fillStyle = lg2;
c.fillRect(0, 0, W, 170);
var lg3 = c.createRadialGradient(W/2, 0, 10, W/2, 120, 300);
lg3.addColorStop(0, 'rgba(255,200,100,0.12)');
lg3.addColorStop(1, 'rgba(0,0,0,0)');
c.fillStyle = lg3;
c.fillRect(0, 0, W, 250);
c.save();
c.globalAlpha = 0.25;
c.fillStyle = '#1a1a1a';
for (var i = 0; i < this.patrons.length; i++) {
  var p = this.patrons[i];
  c.beginPath();
  c.ellipse(p.x + p.w/2, p.y + 8, p.w * 0.35, p.w * 0.4, 0, 0, Math.PI * 2);
  c.fill();
  c.fillRect(p.x + p.w * 0.25, p.y + p.h * 0.4, p.w * 0.5, p.h * 0.6);
}
c.restore();
c.save();
c.globalAlpha = 0.15;
c.fillStyle = '#0a0a0a';
var sx = 80, sy = 60;
c.beginPath();
c.ellipse(sx, sy, 4, 8, 0.3, 0, Math.PI * 2);
c.fill();
c.fillRect(sx + 3, sy - 12, 2, 24);
c.beginPath();
c.ellipse(sx + 8, sy - 8, 3, 5, 0, 0, Math.PI * 2);
c.fill();
var tx = W - 90, ty = 50;
c.beginPath();
c.ellipse(tx, ty, 3, 6, 0.4, 0, Math.PI * 2);
c.fill();
c.quadraticCurveTo(tx + 8, ty - 5, tx + 12, ty);
c.stroke();
c.restore();
c.save();
c.globalAlpha = 0.08;
var neonGrad = c.createRadialGradient(W - 50, 50, 0, W - 50, 50, 60);
neonGrad.addColorStop(0, 'rgba(255, 100, 100, 0.5)');
neonGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
c.fillStyle = neonGrad;
c.fillRect(W - 100, 20, 100, 60);
c.restore();
var smokeOffsets = [
  {baseX: 0.15, baseY: 180, cols: 0.15},
  {baseX: 0.5, baseY: 200, cols: 0.2},
  {baseX: 0.85, baseY: 190, cols: 0.15}
];
for (var so = 0; so < smokeOffsets.length; so++) {
  var so_data = smokeOffsets[so];
  for (var si = 0; si < 3; si++) {
    var p = this.smokePs[si * 2];
    var sx = W * so_data.baseX + Math.sin(this.t * p.sp + p.off) * 25;
    var sy = so_data.baseY - si * 35 + Math.sin(this.t * p.sp * 0.7 + p.off) * 15;
    var sm = c.createRadialGradient(sx, sy, 0, sx, sy, 35 + si * 10);
    sm.addColorStop(0, 'rgba(120,110,140,' + (0.035 - si * 0.008) + ')');
    sm.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = sm;
    c.fillRect(sx - 40 - si * 10, sy - 40 - si * 10, 80 + si * 20, 80 + si * 20);
  }
}
c.save();
c.globalAlpha = 0.04;
var flicker = Math.sin(this.t * 3.5) * 0.5 + 0.5;
var candleGrad1 = c.createRadialGradient(100, 280, 0, 100, 280, 40);
candleGrad1.addColorStop(0, 'rgba(255,200,100,' + (flicker * 0.5) + ')');
candleGrad1.addColorStop(1, 'rgba(0,0,0,0)');
c.fillStyle = candleGrad1;
c.fillRect(70, 250, 60, 60);
var candleGrad2 = c.createRadialGradient(W - 100, 300, 0, W - 100, 300, 45);
candleGrad2.addColorStop(0, 'rgba(255,200,100,' + (flicker * 0.5) + ')');
candleGrad2.addColorStop(1, 'rgba(0,0,0,0)');
c.fillStyle = candleGrad2;
c.fillRect(W - 130, 270, 60, 60);
c.restore();
}

_drawSparkles(c) {
this.sparkles.forEach((s) => {
  c.save();
  c.globalAlpha = s.life * 0.8;
  c.fillStyle = '#ffd700';
  c.beginPath();
  c.arc(s.x, s.y, s.size, 0, Math.PI * 2);
  c.fill();
  c.globalAlpha = s.life * 0.3;
  var halo = c.createRadialGradient(s.x, s.y, s.size, s.x, s.y, s.size * 4);
  halo.addColorStop(0, 'rgba(255,215,0,0.6)');
  halo.addColorStop(1, 'rgba(0,0,0,0)');
  c.fillStyle = halo;
  c.fillRect(s.x - s.size * 4, s.y - s.size * 4, s.size * 8, s.size * 8);
  c.restore();
});
}

// ========== DRAW: CARRY PHASE ==========
_drawCarry() {
var c = this.ctx, W = this.W, H = this.H;
var cp = this.carryPhase;
var gY = cp.baseGroundY;
var progressRatio = cp.scrollPos / cp.maxScroll;

// Screen shake
var shake = cp.screenShake * 3;
c.save();
c.translate(Math.random() * shake - shake/2, Math.random() * shake - shake/2);

// Draw background
this._drawCarryBgLevel1(c, W, H, gY);


// === FINISH LINE ===
var finishWorldX = cp.maxScroll - 60;
var finishScreenX = finishWorldX - cp.scrollPos;
if (finishScreenX < W + 100 && finishScreenX > -100) {
  var finishGY = this._getTerrainY(finishWorldX);
  c.save();
  // Spotlight glow from above
  var spotGrad = c.createRadialGradient(finishScreenX, finishGY - 80, 10, finishScreenX, finishGY - 40, 120);
  spotGrad.addColorStop(0, 'rgba(255,220,120,0.25)');
  spotGrad.addColorStop(0.6, 'rgba(255,200,80,0.08)');
  spotGrad.addColorStop(1, 'rgba(255,200,80,0)');
  c.fillStyle = spotGrad;
  c.fillRect(finishScreenX - 120, 0, 240, finishGY);
  // Spotlight cone (triangle from top)
  c.globalAlpha = 0.1 + Math.sin(this.t * 2) * 0.04;
  c.fillStyle = '#ffe880';
  c.beginPath();
  c.moveTo(finishScreenX - 5, 0);
  c.lineTo(finishScreenX + 5, 0);
  c.lineTo(finishScreenX + 70, finishGY);
  c.lineTo(finishScreenX - 70, finishGY);
  c.closePath();
  c.fill();
  // Stage edge - red velvet curtain drapes on either side
  var curtainW = 25;
  // Left curtain
  c.globalAlpha = 0.7;
  var cGrad = c.createLinearGradient(finishScreenX - 65, 0, finishScreenX - 40, 0);
  cGrad.addColorStop(0, '#3a0a0a');
  cGrad.addColorStop(0.5, '#8a2020');
  cGrad.addColorStop(1, '#5a1010');
  c.fillStyle = cGrad;
  c.beginPath();
  c.moveTo(finishScreenX - 65, 0);
  c.lineTo(finishScreenX - 40, 0);
  c.quadraticCurveTo(finishScreenX - 38, finishGY * 0.3, finishScreenX - 45, finishGY * 0.5);
  c.quadraticCurveTo(finishScreenX - 38, finishGY * 0.7, finishScreenX - 40, finishGY);
  c.lineTo(finishScreenX - 65, finishGY);
  c.closePath();
  c.fill();
  // Right curtain
  var cGrad2 = c.createLinearGradient(finishScreenX + 40, 0, finishScreenX + 65, 0);
  cGrad2.addColorStop(0, '#5a1010');
  cGrad2.addColorStop(0.5, '#8a2020');
  cGrad2.addColorStop(1, '#3a0a0a');
  c.fillStyle = cGrad2;
  c.beginPath();
  c.moveTo(finishScreenX + 40, 0);
  c.lineTo(finishScreenX + 65, 0);
  c.lineTo(finishScreenX + 65, finishGY);
  c.quadraticCurveTo(finishScreenX + 38, finishGY * 0.7, finishScreenX + 45, finishGY * 0.5);
  c.quadraticCurveTo(finishScreenX + 38, finishGY * 0.3, finishScreenX + 40, 0);
  c.closePath();
  c.fill();
  // Curtain valance (top drape)
  c.globalAlpha = 0.75;
  c.fillStyle = '#6a1515';
  c.beginPath();
  c.moveTo(finishScreenX - 68, 0);
  c.lineTo(finishScreenX + 68, 0);
  c.quadraticCurveTo(finishScreenX + 50, 35, finishScreenX, 28);
  c.quadraticCurveTo(finishScreenX - 50, 35, finishScreenX - 68, 0);
  c.closePath();
  c.fill();
  // Gold fringe on valance
  c.strokeStyle = '#c9a050';
  c.lineWidth = 2;
  c.globalAlpha = 0.6;
  c.beginPath();
  c.moveTo(finishScreenX - 60, 5);
  c.quadraticCurveTo(finishScreenX, 35, finishScreenX + 60, 5);
  c.stroke();
  // Gold tassels
  c.fillStyle = '#c9a050';
  c.globalAlpha = 0.5;
  for (var tassel = 0; tassel < 5; tassel++) {
    var tX = finishScreenX - 40 + tassel * 20;
    var tY = 10 + Math.sin(tassel * 1.2) * 8 + 15;
    c.beginPath();
    c.moveTo(tX, tY);
    c.lineTo(tX - 3, tY + 10);
    c.lineTo(tX + 3, tY + 10);
    c.closePath();
    c.fill();
  }
  // "STAGE" text
  c.globalAlpha = 0.5 + Math.sin(this.t * 3) * 0.2;
  c.fillStyle = '#c9a050';
  c.font = 'bold 14px Georgia';
  c.textAlign = 'center';
  c.fillText('★ STAGE ★', finishScreenX, finishGY - 8);
  c.restore();
}

// === OBSTACLES ===
this._drawObstacles(c);

// === FLOATING JAZZ NOTES ===
for (var ni = 0; ni < cp.grooveNotes.length; ni++) {
  var note = cp.grooveNotes[ni];
  if (note.hit) continue;
  var nx = note.x - cp.scrollPos;
  if (nx < -30 || nx > W + 30) continue;
  var noteY = note.y + Math.sin(this.t * 3 + note.phase) * 5;
  c.save();
  c.globalAlpha = 0.35 + Math.sin(this.t * 4 + note.phase) * 0.12;
  c.shadowColor = '#79c8e8'; c.shadowBlur = 12;
  c.fillStyle = '#cbb78e';
  c.font = 'bold 25px Georgia';
  c.textAlign = 'center';
  c.fillText(ni % 2 ? '\u266b' : '\u266a', nx, noteY);
  c.font = '8px Georgia'; c.globalAlpha *= 0.7;
  c.fillText('GROOVE', nx, noteY + 13);
  c.restore();
}

// === PLAYER ===
this._drawPlayer(c);
this._drawTray(c);

// === WOBBLE WARNING ===
if (cp.wobbling) {
  c.save();
  var wFlash = Math.sin(this.t * 10) * 0.3 + 0.7;
  c.globalAlpha = wFlash * Math.min(1, cp.wobbleTimer / 1.0);
  c.fillStyle = '#ff9040';
  c.font = 'bold 12px Georgia';
  c.textAlign = 'center';
  c.fillText('STEADY!', 100, cp.playerY - 22);
  c.restore();
}

// === STAGGER / RUBBER DUCK BONK ===
if (cp.staggerTimer > 0) {
  c.save();
  var bonkAlpha = Math.min(1, cp.staggerTimer / 0.3);
  var bonkFloat = (0.9 - cp.staggerTimer) * 25;
  var bonkScale = 1.0 + (0.9 - Math.min(0.9, cp.staggerTimer)) * 0.3;
  var bonkX = 100;
  var bonkY = cp.playerY - 50 - bonkFloat;
  var bonkRot = Math.sin(this.t * 12) * 0.15;

  c.globalAlpha = bonkAlpha;
  c.translate(bonkX, bonkY);
  c.rotate(bonkRot);
  c.scale(bonkScale, bonkScale);

  // === BIG RUBBER DUCK ===
  // Body — bright yellow
  c.fillStyle = '#ffdd00';
  c.beginPath();
  c.ellipse(0, 8, 22, 16, 0, 0, Math.PI * 2);
  c.fill();
  c.strokeStyle = '#d4a800';
  c.lineWidth = 1.5;
  c.stroke();
  // Belly highlight
  c.fillStyle = '#ffee55';
  c.beginPath();
  c.ellipse(-3, 10, 14, 10, -0.2, 0, Math.PI * 2);
  c.fill();
  // Head
  c.fillStyle = '#ffdd00';
  c.beginPath();
  c.arc(16, -6, 13, 0, Math.PI * 2);
  c.fill();
  c.strokeStyle = '#d4a800';
  c.lineWidth = 1.2;
  c.stroke();
  // Head highlight
  c.fillStyle = '#ffee55';
  c.beginPath();
  c.arc(14, -9, 7, 0, Math.PI * 2);
  c.fill();
  // Eye — big cartoon eye
  c.fillStyle = '#ffffff';
  c.beginPath();
  c.arc(20, -9, 4.5, 0, Math.PI * 2);
  c.fill();
  c.fillStyle = '#111111';
  c.beginPath();
  c.arc(21, -9, 2.5, 0, Math.PI * 2);
  c.fill();
  c.fillStyle = '#ffffff';
  c.beginPath();
  c.arc(22, -10.5, 1, 0, Math.PI * 2);
  c.fill();
  // Beak — bright orange
  c.fillStyle = '#ff8800';
  c.beginPath();
  c.moveTo(27, -6);
  c.quadraticCurveTo(36, -4, 27, -1);
  c.quadraticCurveTo(30, -3.5, 27, -6);
  c.closePath();
  c.fill();
  // Little wing
  c.fillStyle = '#eec800';
  c.beginPath();
  c.ellipse(-10, 4, 8, 5, -0.4, 0, Math.PI * 2);
  c.fill();
  // Tail tuft
  c.fillStyle = '#ffdd00';
  c.beginPath();
  c.moveTo(-20, 2);
  c.lineTo(-26, -2);
  c.lineTo(-23, 4);
  c.lineTo(-27, 3);
  c.lineTo(-22, 7);
  c.closePath();
  c.fill();

  // "BONK!" text coming from the duck
  c.fillStyle = '#ff2020';
  c.font = 'bold 16px Georgia';
  c.textAlign = 'center';
  c.fillText('BONK!', 0, -24);

  c.restore();
}

// === SMOKE WISPS ===
c.save();
c.globalAlpha = 0.06;
for (var i = 0; i < 5; i++) {
  var smokeX = ((i * 190) - cp.scrollPos * 0.4) % (W + 200);
  if (smokeX < -100) smokeX += W + 300;
  var smokeY = 80 + Math.sin(this.t * 0.3 + i * 1.7) * 30;
  var sm = c.createRadialGradient(smokeX, smokeY, 0, smokeX, smokeY, 60 + Math.sin(this.t * 0.5 + i) * 20);
  sm.addColorStop(0, 'rgba(200, 180, 160, 0.5)');
  sm.addColorStop(1, 'rgba(0,0,0,0)');
  c.fillStyle = sm;
  c.fillRect(smokeX - 80, smokeY - 60, 160, 120);
}
c.restore();

c.restore(); // end screen shake

// === UI: Glass counter ===
c.save();
c.fillStyle = 'rgba(14, 10, 5, 0.82)';
c.beginPath(); c.roundRect(10, 10, 126, 48, 5); c.fill();
c.strokeStyle = 'rgba(184, 154, 96, 0.45)';
c.lineWidth = 1;
c.beginPath(); c.roundRect(10.5, 10.5, 125, 47, 5); c.stroke();
c.fillStyle = '#d4b878';
c.font = 'italic 11px Georgia';
c.fillText('Glasses left', 20, 26);
for (var i = 0; i < 3; i++) {
  var gAlive = i < cp.glassesLeft;
  var gxI = 24 + i * 26;
  c.strokeStyle = gAlive ? '#e8cc88' : 'rgba(90, 70, 45, 0.5)';
  c.lineWidth = 1;
  c.strokeRect(gxI, 32, 9, 18);
  if (gAlive) {
    c.fillStyle = 'rgba(232, 196, 96, 0.75)';
    c.fillRect(gxI + 1, 41, 7, 8.5);
    c.fillStyle = 'rgba(255, 245, 220, 0.5)';
    c.fillRect(gxI + 1.5, 33.5, 1.5, 15);
  } else {
    c.strokeStyle = 'rgba(200, 90, 70, 0.55)';
    c.beginPath();
    c.moveTo(gxI, 32); c.lineTo(gxI + 9, 50);
    c.moveTo(gxI + 9, 32); c.lineTo(gxI, 50);
    c.stroke();
  }
}
c.restore();

// Groove phrase meter: a small musical counter beside the glass counter.
c.save();
c.fillStyle = 'rgba(10, 18, 24, 0.78)';
c.beginPath(); c.roundRect(W - 150, 10, 140, 48, 5); c.fill();
c.strokeStyle = 'rgba(180, 160, 126, 0.42)'; c.lineWidth = 1;
c.beginPath(); c.roundRect(W - 149.5, 10.5, 139, 47, 5); c.stroke();
c.fillStyle = '#cbb78e'; c.font = 'italic 11px Georgia'; c.textAlign = 'left';
c.fillText('\u266b Groove phrase', W - 140, 26);
for (var gi = 0; gi < 3; gi++) {
  c.fillStyle = gi < (cp.groove || 0) ? '#cbb78e' : 'rgba(80,110,125,0.35)';
  c.beginPath(); c.arc(W - 132 + gi * 20, 43, 5, 0, Math.PI * 2); c.fill();
}
if (cp.grooveFlash > 0.01) {
  c.globalAlpha = cp.grooveFlash;
  c.fillStyle = '#f1e6cc'; c.font = 'bold 10px Georgia';
  c.fillText((cp.groove || 0) === 0 ? 'ROUND SAVED' : 'NICE NOTE', W - 92, 46);
}
c.restore();

// === UI: Progress bar ===
var pW = (cp.scrollPos / cp.maxScroll) * (W - 40);
c.save();
c.fillStyle = 'rgba(30, 20, 10, 0.7)';
c.fillRect(20, H - 22, W - 40, 12);
var pGrad = c.createLinearGradient(20, 0, 20 + pW, 0);
pGrad.addColorStop(0, '#8a6030');
pGrad.addColorStop(1, '#d4a574');
c.fillStyle = pGrad;
c.fillRect(20, H - 22, pW, 12);
c.strokeStyle = 'rgba(200, 180, 160, 0.3)';
c.lineWidth = 0.8;
c.strokeRect(20, H - 22, W - 40, 12);
c.fillStyle = '#8a7a6a';
c.font = '8px Georgia';
c.textAlign = 'left';
c.fillText('BAR', 22, H - 12);
c.textAlign = 'right';
c.fillText('STAGE', W - 22, H - 12);
c.textAlign = 'left';
c.restore();

// Glass-loss red flash (fight-style impact read)
if (cp.hitFlash > 0) {
  c.save();
  c.globalAlpha = Math.min(0.4, cp.hitFlash * 0.4);
  var hf = c.createRadialGradient(W / 2, H / 2, H * 0.3, W / 2, H / 2, H * 0.78);
  hf.addColorStop(0, 'rgba(0,0,0,0)');
  hf.addColorStop(1, 'rgba(190,40,30,0.85)');
  c.fillStyle = hf;
  c.fillRect(0, 0, W, H);
  c.restore();
}
// Landing dust puff
if (cp.landPuff > 0) {
  c.save();
  c.globalAlpha = cp.landPuff * 0.32;
  c.strokeStyle = '#cbb894';
  c.lineWidth = 1.6;
  var lpR = (1 - cp.landPuff) * 24 + 5;
  c.beginPath(); c.ellipse(100, cp.groundY + 20, lpR, lpR * 0.28, 0, 0, Math.PI * 2); c.stroke();
  c.globalAlpha = cp.landPuff * 0.18;
  c.beginPath(); c.ellipse(100, cp.groundY + 20, lpR * 0.6, lpR * 0.2, 0, 0, Math.PI * 2); c.stroke();
  c.restore();
}
}

// ========== BACKGROUND: LEVEL 1 - THE FLOOR ==========
_drawCarryBgLevel1(c, W, H, gY) {
var cp = this.carryPhase;

// === CEILING ===
var ceilGrad = c.createLinearGradient(0, 0, 0, 40);
ceilGrad.addColorStop(0, '#0a0604');
ceilGrad.addColorStop(1, '#1a0f0a');
c.fillStyle = ceilGrad;
c.fillRect(0, 0, W, 40);
// Ceiling beams
c.fillStyle = '#2a1a10';
for (var i = 0; i < 10; i++) {
  var beamX = ((-cp.scrollPos * 0.8) % 180) + i * 180;
  c.fillRect(beamX, 0, 12, 40);
  c.fillStyle = '#1a1008';
  c.fillRect(beamX + 1, 0, 2, 40);
  c.fillStyle = '#2a1a10';
}

// === BACK WALL ===
var wallGrad = c.createLinearGradient(0, 40, 0, gY);
wallGrad.addColorStop(0, '#14131d');
wallGrad.addColorStop(0.4, '#30212b');
wallGrad.addColorStop(1, '#1b151c');
c.fillStyle = wallGrad;
c.fillRect(0, 40, W, gY - 40);

// Brick texture (subtle)
c.save();
c.globalAlpha = 0.06;
c.fillStyle = '#5a3a28';
for (var row = 0; row < 12; row++) {
  var brickOff = (row % 2) * 35;
  for (var col = 0; col < 10; col++) {
    var bx = ((-cp.scrollPos * 0.15) % 70) + brickOff + col * 70;
    c.fillRect(bx, 45 + row * 22, 65, 18);
  }
}
c.restore();

// Wainscoting follows terrain
c.save();
c.beginPath();
for (var screenX = 0; screenX <= W; screenX += 4) {
  var worldX = cp.scrollPos + screenX;
  var terrainY = this._getTerrainY(worldX);
  if (screenX === 0) c.moveTo(screenX, terrainY - 70);
  else c.lineTo(screenX, terrainY - 70);
}
for (var screenX = W; screenX >= 0; screenX -= 4) {
  var worldX = cp.scrollPos + screenX;
  var terrainY = this._getTerrainY(worldX);
  c.lineTo(screenX, terrainY);
}
c.closePath();
c.fillStyle = '#201008';
c.fill();
// Top edge line
c.beginPath();
for (var screenX = 0; screenX <= W; screenX += 4) {
  var worldX = cp.scrollPos + screenX;
  var terrainY = this._getTerrainY(worldX);
  if (screenX === 0) c.moveTo(screenX, terrainY - 70);
  else c.lineTo(screenX, terrainY - 70);
}
c.strokeStyle = '#3a2818';
c.lineWidth = 1;
c.stroke();
// Panel details (simplified - using base terrain for consistency)
for (var i = 0; i < 12; i++) {
  var panX = ((-cp.scrollPos * 0.8) % 160) + i * 160;
  var panWorldX = cp.scrollPos + panX;
  var panTerrainY = this._getTerrainY(panWorldX);
  c.strokeStyle = '#2a1a10';
  c.lineWidth = 0.8;
  c.strokeRect(panX + 8, panTerrainY - 65, 140, 58);
}
c.restore();

// Hanging club spots: visible fixtures, soft amber/cool beams and haze at several depths.
var still=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches,smokeTime=still?0:this.t;
for(var lamp=0;lamp<4;lamp++){
 var lampWorld=Math.floor(cp.scrollPos*.55/360)*360+(lamp-1)*360+165,lx=lampWorld-cp.scrollPos*.55;
 var warm=(Math.floor(lampWorld/360)%2===0),rgb=warm?'222,174,113':'139,157,189';
 c.save();var beam=c.createLinearGradient(0,30,0,gY+12);beam.addColorStop(0,'rgba('+rgb+',.015)');beam.addColorStop(.4,'rgba('+rgb+',.085)');beam.addColorStop(1,'rgba('+rgb+',0)');c.fillStyle=beam;
 c.beginPath();c.moveTo(lx-6,31);c.lineTo(lx+6,31);c.lineTo(lx+103,gY);c.lineTo(lx-87,gY);c.closePath();c.fill();
 c.fillStyle='#100e13';c.strokeStyle='#796b59';c.lineWidth=.8;c.fillRect(lx-6,18,12,15);c.strokeRect(lx-6,18,12,15);
 c.fillStyle=warm?'#c5a16b':'#9fabc1';c.beginPath();c.ellipse(lx,33,5,1.5,0,0,Math.PI*2);c.fill();
 var shine=c.createRadialGradient(lx,42,0,lx,42,37);shine.addColorStop(0,'rgba('+rgb+',.12)');shine.addColorStop(1,'rgba('+rgb+',0)');c.fillStyle=shine;c.fillRect(lx-40,5,80,80);c.restore();
}
// Framed photos / posters on wall (parallax slow)
var posters = [
  {off: 50, w: 45, h: 55, col: '#4a3828', label: 'MONK'},
  {off: 320, w: 40, h: 50, col: '#3a3040', label: 'MILES'},
  {off: 600, w: 50, h: 40, col: '#2a3a28', label: 'BIRD'},
  {off: 880, w: 42, h: 52, col: '#4a2828', label: 'TRANE'},
  {off: 1150, w: 48, h: 45, col: '#3a3828', label: 'MINGUS'},
  {off: 1450, w: 44, h: 50, col: '#2a2840', label: 'EVANS'}
];
for (var i = 0; i < posters.length; i++) {
  var p = posters[i];
  var pX = p.off - cp.scrollPos * 0.25;
  if (pX > -60 && pX < W + 10) {
    c.fillStyle = '#4a3a28';
    c.fillRect(pX - 3, 70 - 3, p.w + 6, p.h + 6);
    c.fillStyle = p.col;
    c.fillRect(pX, 70, p.w, p.h);
    c.fillStyle = '#d4c8a0';
    c.font = 'bold 7px Georgia';
    c.textAlign = 'center';
    c.fillText(p.label, pX + p.w/2, 70 + p.h - 6);
    c.textAlign = 'left';
    c.fillStyle = '#0a0a0a';
    c.beginPath();
    c.arc(pX + p.w/2, 70 + p.h/2 - 8, 6, 0, Math.PI * 2);
    c.fill();
    c.fillRect(pX + p.w/2 - 4, 70 + p.h/2 - 2, 8, 14);
  }
}

// Seated patrons at tables (mid-ground parallax)
for (var i = 0; i < 6; i++) {
  var tX = 80 + i * 450 - cp.scrollPos * 0.5;
  if (tX > -120 && tX < W + 50) {
    var patronTerrainY = this._getTerrainY(cp.scrollPos + tX);
    c.save();
    c.globalAlpha = 0.5;
    c.fillStyle = '#1a1210';
    c.beginPath();
    c.ellipse(tX, patronTerrainY - 30, 30, 8, 0, 0, Math.PI * 2);
    c.fill();
    c.fillRect(tX - 3, patronTerrainY - 24, 6, 24);
    c.fillStyle = 'rgba(200,180,140,0.4)';
    c.fillRect(tX - 8, patronTerrainY - 38, 4, 8);
    c.fillRect(tX + 4, patronTerrainY - 36, 4, 6);
    // Small shaded table lamps carry the club's red/amber rhythm through the room.
    c.fillStyle='#54302e';c.beginPath();c.moveTo(tX+11,patronTerrainY-59);c.lineTo(tX+24,patronTerrainY-59);c.lineTo(tX+29,patronTerrainY-47);c.lineTo(tX+6,patronTerrainY-47);c.closePath();c.fill();c.fillStyle='#b6915c';c.fillRect(tX+17,patronTerrainY-47,1,15);
    var tableGlow=c.createRadialGradient(tX+18,patronTerrainY-43,0,tX+18,patronTerrainY-43,48);tableGlow.addColorStop(0,'rgba(213,143,82,.3)');tableGlow.addColorStop(1,'rgba(153,83,71,0)');c.fillStyle=tableGlow;c.fillRect(tX-32,patronTerrainY-90,100,90);

    c.fillStyle = '#0e0a08';
    c.beginPath();
    c.arc(tX - 30, patronTerrainY - 50, 8, 0, Math.PI * 2);
    c.fill();
    c.fillRect(tX - 36, patronTerrainY - 42, 12, 20);
    c.fillRect(tX - 38, patronTerrainY - 22, 16, 22);
    if (i % 2 === 0) {
      c.beginPath();
      c.arc(tX + 28, patronTerrainY - 48, 7, 0, Math.PI * 2);
      c.fill();
      c.fillRect(tX + 22, patronTerrainY - 41, 12, 18);
      c.fillRect(tX + 20, patronTerrainY - 23, 16, 23);
    }
    c.restore();
  }
}

// === FLOOR (terrain-following) ===
c.save();
c.beginPath();
// Walk along the terrain contour across the visible screen
var startWorldX = cp.scrollPos;
var endWorldX = cp.scrollPos + W;
c.moveTo(0, this._getTerrainY(startWorldX));
// Sample terrain across screen width
for (var screenX = 0; screenX <= W; screenX += 4) {
  var worldX = cp.scrollPos + screenX;
  var terrainY = this._getTerrainY(worldX);
  c.lineTo(screenX, terrainY);
}
// Close the polygon at the bottom
c.lineTo(W, H);
c.lineTo(0, H);
c.closePath();
var floorGrad = c.createLinearGradient(0, 280, 0, H);
floorGrad.addColorStop(0, '#2a1a10');
floorGrad.addColorStop(0.3, '#221610');
floorGrad.addColorStop(1, '#1a100a');
c.fillStyle = floorGrad;
c.fill();c.clip();
if(!this._carryWood){var wood=document.createElement('canvas');wood.width=512;wood.height=160;var wc=wood.getContext('2d');
for(var grain=0;grain<120;grain++){var gy=(grain*43)%160;wc.strokeStyle=grain%3?'rgba(172,130,81,.15)':'rgba(0,0,0,.3)';wc.lineWidth=.5;wc.beginPath();wc.moveTo(0,gy);for(var xx=8;xx<=512;xx+=8)wc.lineTo(xx,gy+Math.sin(xx*.02+grain)*1.2);wc.stroke();}
for(var scuff=0;scuff<45;scuff++){var xx=(scuff*137)%512,yy=(scuff*59)%160;wc.strokeStyle='rgba(201,175,129,.10)';wc.beginPath();wc.moveTo(xx,yy);wc.lineTo(xx+9+scuff%16,yy+1);wc.stroke();}this._carryWood=wood;}
c.globalAlpha=.6;var woodShift=cp.scrollPos%512;for(var tile=-1;tile<3;tile++)c.drawImage(this._carryWood,tile*512-woodShift,270);
c.restore();

// Floorboard lines (vertical, terrain-following)
c.strokeStyle = 'rgba(60, 40, 25, 0.5)';
c.lineWidth = 0.8;
for (var i = 0; i < 15; i++) {
  var bX = ((-cp.scrollPos * 1.0) % 120) + i * 120;
  var terrainAtBoard = this._getTerrainY(cp.scrollPos + bX);
  c.beginPath();
  c.moveTo(bX, terrainAtBoard);
  c.lineTo(bX, H);
  c.stroke();
}
// Horizontal plank seam also follows terrain
c.beginPath();
for (var screenX = 0; screenX <= W; screenX += 8) {
  var worldX = cp.scrollPos + screenX;
  var terrainY = this._getTerrainY(worldX);
  if (screenX === 0) c.moveTo(screenX, terrainY + 30);
  else c.lineTo(screenX, terrainY + 30);
}
c.stroke();

// Floor highlight strip follows terrain
c.save();
c.globalAlpha = 0.06;
c.fillStyle = '#c9a060';
c.beginPath();
for (var screenX = 0; screenX <= W; screenX += 4) {
  var worldX = cp.scrollPos + screenX;
  var terrainY = this._getTerrainY(worldX);
  if (screenX === 0) c.moveTo(screenX, terrainY);
  else c.lineTo(screenX, terrainY);
}
for (var screenX = W; screenX >= 0; screenX -= 4) {
  var worldX = cp.scrollPos + screenX;
  var terrainY = this._getTerrainY(worldX);
  c.lineTo(screenX, terrainY + 4);
}
c.closePath();
c.fill();
c.restore();

// Spotlight pools on floor
c.save();
for (var i = 0; i < 3; i++) {
  var spotX = 140 + i * 500 - cp.scrollPos * 0.6;
  if (spotX > -100 && spotX < W + 100) {
    var spotTerrainY = this._getTerrainY(cp.scrollPos + spotX);
    var spot = c.createRadialGradient(spotX, spotTerrainY + 5, 0, spotX, spotTerrainY + 5, 70);
    spot.addColorStop(0, 'rgba(255,220,140,0.08)');
    spot.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = spot;
    c.fillRect(spotX - 70, spotTerrainY - 20, 140, 80);
  }
}
c.restore();

// Layered cigarette smoke: broad irregular banks stay behind hazards and the carrier.
c.save();
for(var layer=0;layer<9;layer++){
 var depth=layer%3,period=W+260,smokeX=((layer*151-cp.scrollPos*(.18+depth*.12))%period+period)%period-130;
 var smokeY=78+(layer*47)%155+(still?0:Math.sin(smokeTime*.14+layer)*12),drift=still?0:Math.sin(smokeTime*.11+layer*1.8)*22;
 c.save();c.translate(smokeX+drift,smokeY);c.scale(1.7+depth*.32,.45+depth*.12);
 var sm=c.createRadialGradient(-12,0,0,0,0,90);sm.addColorStop(0,'rgba(189,184,192,.15)');sm.addColorStop(.4,'rgba(152,151,169,.085)');sm.addColorStop(1,'rgba(112,108,139,0)');c.fillStyle=sm;c.fillRect(-92,-92,184,184);c.restore();
}
// A faint cool haze above the floor never covers the lip of a gap.
var air=c.createLinearGradient(0,80,0,gY-12);air.addColorStop(0,'rgba(100,111,140,0)');air.addColorStop(.55,'rgba(115,120,142,.045)');air.addColorStop(1,'rgba(100,111,140,0)');c.fillStyle=air;c.fillRect(0,80,W,gY-92);
c.restore();
}

_drawObstacles(c) {
var cp = this.carryPhase;
var W = this.W;
var pulse = 0.55 + Math.sin(this.t * 4) * 0.35;

for (var i = 0; i < cp.obstacles.length; i++) {
  var obs = cp.obstacles[i];
  var ox = obs.x - cp.scrollPos;
  if (ox > -150 && ox < W + 50) {
    if (obs.hit) { c.globalAlpha = 0.35; }
    if (obs.isHigh) {
      // === RED DANGER ZONE behind high obstacles ===
      var hCx = ox + obs.width / 2;
      var hBottom = obs.height;
      // Wide red-tinted danger stripe area
      c.save();
      var dangerW = obs.width + 40;
      var dangerX = ox - 20;
      // Red translucent column from ceiling to obstacle bottom
      var dangerGrad = c.createLinearGradient(0, 0, 0, hBottom + 30);
      dangerGrad.addColorStop(0, 'rgba(180,40,40,0.12)');
      dangerGrad.addColorStop(0.7, 'rgba(200,50,30,0.18)');
      dangerGrad.addColorStop(1, 'rgba(200,60,30,0.05)');
      c.fillStyle = dangerGrad;
      c.fillRect(dangerX, 0, dangerW, hBottom + 30);
      // Diagonal warning stripes
      c.globalAlpha = 0.08 + pulse * 0.06;
      c.strokeStyle = '#ff4040';
      c.lineWidth = 3;
      for (var stripe = -8; stripe < 12; stripe++) {
        var sx = dangerX + stripe * 12;
        c.beginPath();
        c.moveTo(sx, 0);
        c.lineTo(sx + hBottom * 0.4, hBottom + 20);
        c.stroke();
      }
      c.restore();

      // Draw the obstacle itself
      if (obs.style === 1) this._drawHighObs1(c, obs.type, ox, obs.width, obs.height);
      else if (obs.style === 2) this._drawHighObs2(c, obs.type, ox, obs.width, obs.height);
      else this._drawHighObs3(c, obs.type, ox, obs.width, obs.height);

      // === MALLARD DUCKS — waddle normally or scatter in panic ===
      if (!obs.hit) {
        c.save();
        var dSeed = obs.x * 7.3;
        var numDucks = 2 + Math.floor((dSeed % 3));
        var isScattered = obs.scattered;
        var scatterElapsed = isScattered ? (this.t - obs.scatterTime) : 0;

        // Feather particles when scattering
        if (isScattered && scatterElapsed < 2.0) {
          c.save();
          var featherAlpha = Math.max(0, 1.0 - scatterElapsed / 2.0);
          c.globalAlpha = featherAlpha * 0.6;
          for (var fi = 0; fi < 8; fi++) {
            var fSeed = dSeed + fi * 17.3;
            var fAngle = (fSeed % 6.28) + scatterElapsed * (2 + (fi % 3));
            var fDist = scatterElapsed * (40 + (fSeed % 30));
            var fX = hCx + Math.cos(fAngle) * fDist;
            var fY = hBottom + 22 - scatterElapsed * (20 + fi * 8) + Math.sin(this.t * 6 + fi) * 5;
            var fRot = this.t * 8 + fi * 2;
            c.save();
            c.translate(fX, fY);
            c.rotate(fRot);
            c.fillStyle = (fi % 3 === 0) ? '#5a4a30' : (fi % 3 === 1) ? '#1a6a30' : '#e8e8d0';
            c.beginPath();
            c.ellipse(0, 0, 3, 1.2, 0, 0, Math.PI * 2);
            c.fill();
            c.restore();
          }
          c.restore();
        }

        for (var di = 0; di < numDucks; di++) {
          // Base position
          var duckRestX = ox - 18 + di * (obs.width / numDucks + 10) + Math.sin(dSeed + di * 2.1) * 8;
          var duckRestY = hBottom + 22 + Math.sin(dSeed + di * 3.7) * 4;
          var duckX, duckY, duckRot, duckAlpha, flapping;

          if (isScattered && scatterElapsed < 2.5) {
            // SCATTER! Each duck flies off in a different direction
            var scatterAngle = -0.8 - di * 0.5 + (di % 2 === 0 ? -0.6 : 0.6);
            var scatterSpeed = 80 + di * 25;
            var flyT = Math.min(scatterElapsed, 2.0);
            duckX = duckRestX + Math.cos(scatterAngle) * scatterSpeed * flyT;
            duckY = duckRestY + Math.sin(scatterAngle) * scatterSpeed * flyT - flyT * 50;
            duckRot = scatterAngle * 0.4 + Math.sin(this.t * 15 + di) * 0.3;
            duckAlpha = Math.max(0, 1.0 - scatterElapsed / 2.2);
            flapping = true;
          } else if (isScattered) {
            continue; // ducks have flown away
          } else {
            // Normal waddling
            var waddle = Math.sin(this.t * 4 + di * 2.3) * 2;
            var bobY = Math.sin(this.t * 3.5 + di * 1.8) * 1.5;
            duckX = duckRestX + waddle;
            duckY = duckRestY + bobY;
            duckRot = 0;
            duckAlpha = 1;
            flapping = false;
          }

          c.save();
          c.globalAlpha = duckAlpha;
          c.translate(duckX, duckY);
          c.rotate(duckRot);

          // Body
          c.fillStyle = '#5a4a30';
          c.beginPath();
          c.ellipse(0, 0, 8, 5, 0, 0, Math.PI * 2);
          c.fill();
          // Breast
          c.fillStyle = '#6a3a20';
          c.beginPath();
          c.ellipse(5, 1, 4, 4, 0, 0, Math.PI * 2);
          c.fill();
          // Head — iridescent green
          c.fillStyle = '#1a6a30';
          c.beginPath();
          c.arc(9, -4, 4, 0, Math.PI * 2);
          c.fill();
          // Eye — wide open if panicking
          c.fillStyle = '#111';
          c.beginPath();
          c.arc(10.5, -5, flapping ? 1.2 : 0.8, 0, Math.PI * 2);
          c.fill();
          // Beak — open if panicking
          c.fillStyle = '#d4a030';
          if (flapping) {
            // Open beak — top
            c.beginPath();
            c.moveTo(13, -5.5);
            c.lineTo(18, -5);
            c.lineTo(13, -3.5);
            c.closePath();
            c.fill();
            // Open beak — bottom
            c.fillStyle = '#c08020';
            c.beginPath();
            c.moveTo(13, -3);
            c.lineTo(17, -1.5);
            c.lineTo(13, -1.5);
            c.closePath();
            c.fill();
          } else {
            c.beginPath();
            c.moveTo(13, -4);
            c.lineTo(17, -3.5);
            c.lineTo(13, -2.5);
            c.closePath();
            c.fill();
          }
          // White neck ring
          c.strokeStyle = '#e8e8e8';
          c.lineWidth = 1;
          c.beginPath();
          c.arc(9, -4, 4.5, 1.2, 2.0);
          c.stroke();
          // Wings — flapping if scattered
          if (flapping) {
            var wingAngle = Math.sin(this.t * 18 + di * 3) * 0.8;
            // Left wing
            c.save();
            c.fillStyle = '#4a3a25';
            c.translate(-4, -2);
            c.rotate(-0.5 + wingAngle);
            c.beginPath();
            c.ellipse(0, -6, 4, 8, 0, 0, Math.PI * 2);
            c.fill();
            c.restore();
            // Right wing
            c.save();
            c.fillStyle = '#4a3a25';
            c.translate(-4, -2);
            c.rotate(-0.5 - wingAngle);
            c.beginPath();
            c.ellipse(0, 6, 4, 8, 0, 0, Math.PI * 2);
            c.fill();
            c.restore();
          }
          // Tail
          c.fillStyle = '#3a3a2a';
          c.beginPath();
          c.moveTo(-7, -2);
          c.lineTo(-12, -4);
          c.lineTo(-10, 0);
          c.closePath();
          c.fill();
          // Feet (tucked up if flying)
          if (!flapping) {
            c.fillStyle = '#d48030';
            c.fillRect(-2, 4, 3, 2);
            c.fillRect(3, 4, 3, 2);
          } else {
            c.fillStyle = '#d48030';
            c.fillRect(0, 3, 2, 3);
            c.fillRect(4, 4, 2, 2);
          }
          c.restore();
        }
        c.restore();
      }

      // DUCK cue - bigger, bolder, with pulsing border
      if (!obs.hit) {
        c.save();
        // Thick pulsing red line at obstacle bottom
        c.globalAlpha = 0.5 + pulse * 0.4;
        c.strokeStyle = '#ff4040';
        c.lineWidth = 3;
        c.setLineDash([8, 5]);
        c.beginPath();
        c.moveTo(ox - 10, hBottom);
        c.lineTo(ox + obs.width + 10, hBottom);
        c.stroke();
        c.setLineDash([]);
        c.restore();
        // Large DUCK text with dark backing
        c.save();
        c.globalAlpha = pulse * 0.9;
        c.fillStyle = 'rgba(80,0,0,0.5)';
        c.fillRect(hCx - 30, hBottom + 2, 60, 20);
        c.fillStyle = '#ff5050';
        c.font = 'bold 16px Georgia';
        c.textAlign = 'center';
        c.fillText('\u2193 DUCK!', hCx, hBottom + 17);
        c.restore();
        // Down arrows flanking the obstacle
        c.save();
        c.globalAlpha = pulse * 0.6;
        c.fillStyle = '#ff5050';
        c.font = 'bold 18px Georgia';
        c.textAlign = 'center';
        c.fillText('\u25BC', ox - 8, hBottom - 10);
        c.fillText('\u25BC', ox + obs.width + 8, hBottom - 10);
        c.restore();
      }
    } else if (obs.isGap) {
      // FLOOR GAP — dramatic pit/hole in the pub floor
      var gapCx = ox + obs.width / 2;
      var gapTop = obs.y;
      var gapH = this.H - gapTop; // extends to bottom of canvas
      c.save();

      // Deep black pit
      var pitGrad = c.createLinearGradient(0, gapTop, 0, gapTop + 60);
      pitGrad.addColorStop(0, '#080404');
      pitGrad.addColorStop(0.4, '#030202');
      pitGrad.addColorStop(1, '#000000');
      c.fillStyle = pitGrad;
      c.fillRect(ox - 2, gapTop, obs.width + 4, gapH);

      // Amber glow from below (like there's a cellar down there)
      var cellarGlow = c.createRadialGradient(gapCx, gapTop + 40, 5, gapCx, gapTop + 30, obs.width * 0.7);
      cellarGlow.addColorStop(0, 'rgba(200,120,40,0.15)');
      cellarGlow.addColorStop(1, 'rgba(200,120,40,0)');
      c.fillStyle = cellarGlow;
      c.fillRect(ox - 20, gapTop + 5, obs.width + 40, 70);

      // Broken floorboard edges on left side
      c.fillStyle = '#5a3a20';
      c.beginPath();
      c.moveTo(ox - 2, gapTop);
      c.lineTo(ox + 8, gapTop);
      c.lineTo(ox + 5, gapTop + 20);
      c.lineTo(ox + 10, gapTop + 35);
      c.lineTo(ox + 3, gapTop + 50);
      c.lineTo(ox - 2, gapTop + 40);
      c.closePath();
      c.fill();
      c.strokeStyle = '#3a2210';
      c.lineWidth = 1;
      c.stroke();

      // Broken floorboard edges on right side
      c.beginPath();
      c.moveTo(ox + obs.width + 2, gapTop);
      c.lineTo(ox + obs.width - 6, gapTop);
      c.lineTo(ox + obs.width - 3, gapTop + 18);
      c.lineTo(ox + obs.width - 8, gapTop + 30);
      c.lineTo(ox + obs.width - 2, gapTop + 45);
      c.lineTo(ox + obs.width + 2, gapTop + 38);
      c.closePath();
      c.fill();
      c.stroke();

      // Splintered wood pieces hanging
      c.fillStyle = '#4a2a15';
      c.save();
      c.translate(ox + 12, gapTop);
      c.rotate(0.3);
      c.fillRect(0, 0, 4, 18);
      c.restore();
      c.save();
      c.translate(ox + obs.width - 10, gapTop);
      c.rotate(-0.2);
      c.fillRect(0, 0, 3, 14);
      c.restore();

      // Top edge shadow — dark gradient spreading outward
      c.globalAlpha = 0.6;
      var topShadow = c.createLinearGradient(0, gapTop - 8, 0, gapTop + 12);
      topShadow.addColorStop(0, 'rgba(0,0,0,0)');
      topShadow.addColorStop(0.5, 'rgba(0,0,0,0.6)');
      topShadow.addColorStop(1, 'rgba(0,0,0,0.3)');
      c.fillStyle = topShadow;
      c.fillRect(ox - 10, gapTop - 8, obs.width + 20, 20);
      c.globalAlpha = 1;

      // Pulsing amber warning markers on edges
      c.globalAlpha = 0.4 + pulse * 0.3;
      c.fillStyle = '#ffaa40';
      // Left warning dot
      c.beginPath();
      c.arc(ox - 4, gapTop + 3, 3, 0, Math.PI * 2);
      c.fill();
      // Right warning dot
      c.beginPath();
      c.arc(ox + obs.width + 4, gapTop + 3, 3, 0, Math.PI * 2);
      c.fill();
      c.globalAlpha = 1;

      // === MUSIC NOTES drifting up from the jazz abyss ===
      var noteChars = ['\u266A', '\u266B', '\u266C', '\u2669'];
      var noteSeed = obs.x * 3.7;
      for (var ni = 0; ni < 10; ni++) {
        // Each note has its own cycle based on time + seed
        var notePhase = (this.t * 0.55 + ni * 0.9 + noteSeed * 0.01) % 3.0;
        var noteRise = notePhase / 3.0; // 0 to 1 as it rises
        var noteX = ox + 6 + (ni * (obs.width - 12) / 9) + Math.sin(this.t * 1.5 + ni * 2.1) * 10;
        var noteY = gapTop + 60 - noteRise * 130; // rises from deep in pit to well above
        var noteAlpha = 0;
        if (noteRise < 0.12) noteAlpha = noteRise / 0.12; // fade in
        else if (noteRise > 0.78) noteAlpha = (1.0 - noteRise) / 0.22; // fade out at top
        else noteAlpha = 1.0;
        noteAlpha *= 0.9; // much more visible than before
        // Let them drift higher above the pit before clipping
        if (noteY < gapTop - 45 || noteY > gapTop + 70) continue;
        c.save();
        c.globalAlpha = noteAlpha;
        // Brighter gold tones
        c.fillStyle = (ni % 2 === 0) ? '#f0c060' : '#ffd070';
        c.font = 'bold ' + (13 + (ni % 3) * 2) + 'px Georgia';
        c.textAlign = 'center';
        c.shadowColor = 'rgba(255,180,60,0.55)';
        c.shadowBlur = 6;
        var noteRot = Math.sin(this.t * 2 + ni * 1.7) * 0.35;
        c.translate(noteX, noteY);
        c.rotate(noteRot);
        c.fillText(noteChars[ni % noteChars.length], 0, 0);
        c.restore();
      }

      c.restore();

      // JUMP cue — amber/orange for gaps, distinct from green JUMP
      if (!obs.hit) {
        c.save();
        c.globalAlpha = pulse * 0.9;
        c.fillStyle = 'rgba(60,30,0,0.6)';
        c.fillRect(gapCx - 30, gapTop - 28, 60, 22);
        c.strokeStyle = 'rgba(255,170,64,0.4)';
        c.lineWidth = 1;
        c.strokeRect(gapCx - 30, gapTop - 28, 60, 22);
        c.fillStyle = '#ffaa40';
        c.font = 'bold 15px Georgia';
        c.textAlign = 'center';
        c.fillText('\u2191 JUMP!', gapCx, gapTop - 11);
        c.restore();
      }
    } else {
      if (obs.style === 1) this._drawLowObs1(c, obs.type, ox, obs.y, obs.width, obs.height);
      else if (obs.style === 2) this._drawLowObs2(c, obs.type, ox, obs.y, obs.width, obs.height);
      else this._drawLowObs3(c, obs.type, ox, obs.y, obs.width, obs.height);
      // JUMP cue - green with backing
      if (!obs.hit) {
        var cx = ox + obs.width / 2;
        c.save();
        c.globalAlpha = pulse * 0.85;
        c.fillStyle = 'rgba(0,40,0,0.4)';
        c.fillRect(cx - 28, obs.y - 22, 56, 18);
        c.fillStyle = '#60ff90';
        c.font = 'bold 14px Georgia';
        c.textAlign = 'center';
        c.fillText('\u2191 JUMP', cx, obs.y - 8);
        c.restore();
      }
    }
    if (obs.hit) { c.globalAlpha = 1; }
  }
}
}

// === HIGH OBSTACLES (hang from ceiling, duck under) ===
_drawHighObs1(c, type, x, w, h) {
var cx = x + w/2;
var bottom = h; // bottom edge of the obstacle zone
// Danger glow behind high obstacles so they stand out
var dg = c.createRadialGradient(cx, bottom - 20, 5, cx, bottom, 50);
dg.addColorStop(0, 'rgba(255,80,80,0.15)');
dg.addColorStop(1, 'rgba(255,80,80,0)');
c.fillStyle = dg;
c.fillRect(cx - 50, bottom - 60, 100, 70);
if (type === 0) {
  // Hanging lamp with wide shade
  c.fillStyle = '#3a3530';
  c.fillRect(cx - 1, 0, 2, bottom - 40); // cord
  // Shade - wide cone
  c.fillStyle = '#c9a050';
  c.beginPath();
  c.moveTo(cx - 28, bottom);
  c.lineTo(cx - 8, bottom - 35);
  c.lineTo(cx + 8, bottom - 35);
  c.lineTo(cx + 28, bottom);
  c.closePath();
  c.fill();
  c.strokeStyle = '#a08030';
  c.lineWidth = 1.5;
  c.stroke();
  // Warm light glow
  var lg = c.createRadialGradient(cx, bottom, 5, cx, bottom + 20, 60);
  lg.addColorStop(0, 'rgba(255,220,120,0.25)');
  lg.addColorStop(1, 'rgba(255,200,80,0)');
  c.fillStyle = lg;
  c.fillRect(cx - 60, bottom - 10, 120, 80);
  // Bulb
  c.fillStyle = '#ffe880';
  c.beginPath();
  c.arc(cx, bottom - 8, 4, 0, Math.PI * 2);
  c.fill();
} else if (type === 1) {
  // Low-hanging speaker/monitor wedge on a bracket
  c.fillStyle = '#2a2a2a';
  c.fillRect(cx - 3, 0, 6, bottom - 50); // mounting pole
  // Bracket
  c.fillStyle = '#444';
  c.fillRect(cx - 22, bottom - 52, 44, 6);
  // Speaker box
  c.fillStyle = '#1a1a1a';
  c.fillRect(cx - 20, bottom - 46, 40, 46);
  c.strokeStyle = '#333';
  c.lineWidth = 1.5;
  c.strokeRect(cx - 20, bottom - 46, 40, 46);
  // Speaker cone
  c.fillStyle = '#2a2a2a';
  c.beginPath();
  c.arc(cx, bottom - 24, 12, 0, Math.PI * 2);
  c.fill();
  c.strokeStyle = '#444';
  c.lineWidth = 1;
  c.stroke();
  c.beginPath();
  c.arc(cx, bottom - 24, 5, 0, Math.PI * 2);
  c.fill();
  // Mesh grille lines
  c.strokeStyle = '#333';
  c.lineWidth = 0.5;
  for (var g = -16; g <= 16; g += 4) {
    c.beginPath();
    c.moveTo(cx - 18, bottom - 24 + g);
    c.lineTo(cx + 18, bottom - 24 + g);
    c.stroke();
  }
} else {
  // Bunting / banner hanging across the path
  c.fillStyle = '#3a3530';
  c.fillRect(x, 0, 2, bottom - 20); // left cord
  c.fillRect(x + w - 2, 0, 2, bottom - 20); // right cord
  // Sagging rope
  c.strokeStyle = '#8a7a60';
  c.lineWidth = 2;
  c.beginPath();
  c.moveTo(x, bottom - 20);
  c.quadraticCurveTo(cx, bottom + 5, x + w, bottom - 20);
  c.stroke();
  // Triangular pennants
  var cols = ['#8b3030','#c9a050','#3a5a8a','#6a8a3a','#8a5a8a'];
  var segs = 6;
  for (var p = 0; p < segs; p++) {
    var t1 = p / segs, t2 = (p + 0.5) / segs;
    var px1 = x + t1 * w;
    var py1 = (bottom - 20) + Math.sin(t1 * Math.PI) * 25;
    var px2 = x + t2 * w;
    var py2 = (bottom - 20) + Math.sin(t2 * Math.PI) * 25;
    var px3 = (px1 + px2) / 2;
    var py3 = py2 + 18;
    c.fillStyle = cols[p % cols.length];
    c.beginPath();
    c.moveTo(px1, py1);
    c.lineTo(px2, py2);
    c.lineTo(px3, py3);
    c.closePath();
    c.fill();
  }
}
}

// === LOW OBSTACLES (on the ground, jump over) ===
_drawLowObs1(c, type, x, y, w, h) {
var cx = x + w/2;
var gY = y + h;
if (type === 0) {
  // Toppled bar stool
  var seatY = y + 4;
  // Seat (circle, tilted)
  c.fillStyle = '#6a4030';
  c.beginPath();
  c.ellipse(cx, seatY, w/2 - 4, 8, 0.15, 0, Math.PI * 2);
  c.fill();
  c.strokeStyle = '#4a2a18';
  c.lineWidth = 1.5;
  c.stroke();
  // Padded top
  c.fillStyle = '#8a5a40';
  c.beginPath();
  c.ellipse(cx, seatY - 3, w/2 - 8, 5, 0.15, 0, Math.PI * 2);
  c.fill();
  // Central pole (angled because toppled)
  c.strokeStyle = '#888';
  c.lineWidth = 3;
  c.beginPath();
  c.moveTo(cx, seatY + 6);
  c.lineTo(cx + 12, gY);
  c.stroke();
  // Foot ring
  c.strokeStyle = '#777';
  c.lineWidth = 2;
  c.beginPath();
  c.ellipse(cx + 8, gY - 8, 10, 3, 0, 0, Math.PI * 2);
  c.stroke();
  // Base
  c.fillStyle = '#666';
  c.beginPath();
  c.ellipse(cx + 10, gY - 2, 14, 4, 0, 0, Math.PI * 2);
  c.fill();
} else if (type === 1) {
  // Instrument case (saxophone or guitar)
  var caseH = h - 2;
  var caseW = w - 4;
  // Main case body
  c.fillStyle = '#1a1a1a';
  c.beginPath();
  c.moveTo(x + 4, gY);
  c.lineTo(x + 4, y + 6);
  c.quadraticCurveTo(cx, y, x + w - 4, y + 6);
  c.lineTo(x + w - 4, gY);
  c.closePath();
  c.fill();
  // Case edge
  c.strokeStyle = '#444';
  c.lineWidth = 1.5;
  c.stroke();
  // Latches
  c.fillStyle = '#c9a050';
  c.fillRect(cx - 12, y + caseH * 0.3, 5, 4);
  c.fillRect(cx + 7, y + caseH * 0.3, 5, 4);
  // Handle
  c.strokeStyle = '#888';
  c.lineWidth = 2.5;
  c.beginPath();
  c.moveTo(cx - 8, y + 4);
  c.quadraticCurveTo(cx, y - 2, cx + 8, y + 4);
  c.stroke();
  // Brand label
  c.fillStyle = '#c9a050';
  c.font = 'italic 8px Georgia';
  c.textAlign = 'center';
  c.fillText('SELMER', cx, y + caseH * 0.6);
} else {
  // Crate of beer bottles
  var crateW = w - 6, crateH = h - 2;
  // Wooden crate
  c.fillStyle = '#5a3a20';
  c.fillRect(x + 3, y + 4, crateW, crateH - 4);
  c.strokeStyle = '#3a2210';
  c.lineWidth = 1.5;
  c.strokeRect(x + 3, y + 4, crateW, crateH - 4);
  // Horizontal slat
  c.fillStyle = '#4a2a15';
  c.fillRect(x + 3, y + crateH/2, crateW, 4);
  // Bottles sticking up
  var bottleCount = Math.floor(crateW / 10);
  for (var b = 0; b < bottleCount; b++) {
    var bx = x + 8 + b * (crateW - 10) / Math.max(1, bottleCount - 1);
    // Bottle body
    c.fillStyle = '#2a4a20';
    c.fillRect(bx - 2.5, y - 8, 5, 16);
    // Neck
    c.fillRect(bx - 1.5, y - 14, 3, 8);
    // Cap
    c.fillStyle = '#c9a050';
    c.fillRect(bx - 2, y - 16, 4, 3);
    // Label
    c.fillStyle = '#d4c8a0';
    c.fillRect(bx - 2, y - 4, 4, 6);
    // Glass highlight
    c.fillStyle = 'rgba(255,255,255,0.1)';
    c.fillRect(bx - 1, y - 12, 1.5, 10);
  }
}
}

// === HIGH OBSTACLES LEVEL 2 (bar top) ===
_drawHighObs2(c, type, x, w, h) {
var cx = x + w/2;
var bottom = h;
var dg = c.createRadialGradient(cx, bottom - 20, 5, cx, bottom, 50);
dg.addColorStop(0, 'rgba(255,80,80,0.15)');
dg.addColorStop(1, 'rgba(255,80,80,0)');
c.fillStyle = dg;
c.fillRect(cx - 50, bottom - 60, 100, 70);

if (type === 0) {
  // Hanging bottle rack (wooden rack with bottles hanging upside down)
  c.fillStyle = '#4a3a2a';
  c.fillRect(cx - 1, 0, 2, bottom - 30); // mounting pole
  // Rack frame
  c.strokeStyle = '#3a2a1a';
  c.lineWidth = 2;
  c.strokeRect(cx - 25, bottom - 45, 50, 35);
  // Hanging bottles (upside down)
  for (var b = 0; b < 4; b++) {
    var bx = cx - 18 + b * 12;
    // Bottle hanging down
    c.fillStyle = '#2a4a20';
    c.fillRect(bx - 2, bottom - 35, 4, 20);
    c.fillStyle = '#4a6a30';
    c.fillRect(bx - 3, bottom - 38, 6, 4); // bottom (now at top due to inversion)
  }
} else if (type === 1) {
  // Shelf bracket with bottles
  c.fillStyle = '#4a3a2a';
  c.fillRect(cx - 1, 0, 2, bottom - 35);
  // Bracket
  c.fillStyle = '#5a4a3a';
  c.beginPath();
  c.moveTo(cx, bottom - 40);
  c.lineTo(cx - 35, bottom - 40);
  c.lineTo(cx - 35, bottom - 32);
  c.closePath();
  c.fill();
  // Shelf
  c.fillStyle = '#6a5a4a';
  c.fillRect(cx - 35, bottom - 33, 35, 4);
  // Bottles on shelf
  for (var b = 0; b < 5; b++) {
    var bx = cx - 32 + b * 7;
    c.fillStyle = '#2a4a20';
    c.fillRect(bx, bottom - 30, 4, 15);
    c.fillStyle = '#d4a050';
    c.fillRect(bx, bottom - 32, 4, 2);
  }
} else {
  // Bartender's arm reaching across
  c.fillStyle = '#c9a07a';
  c.beginPath();
  c.ellipse(cx + 20, bottom - 35, 6, 8, 0.3, 0, Math.PI * 2);
  c.fill();
  // Arm extending
  c.strokeStyle = '#c9a07a';
  c.lineWidth = 4;
  c.beginPath();
  c.moveTo(cx, bottom - 40);
  c.quadraticCurveTo(cx + 25, bottom - 50, cx + 40, bottom - 35);
  c.stroke();
  // Hand holding cloth/glass
  c.fillStyle = '#c9a07a';
  c.beginPath();
  c.arc(cx + 40, bottom - 35, 5, 0, Math.PI * 2);
  c.fill();
  // Cloth fluttering
  c.fillStyle = '#d4c8a0';
  c.beginPath();
  c.moveTo(cx + 35, bottom - 30);
  c.quadraticCurveTo(cx + 50, bottom - 20, cx + 45, bottom - 10);
  c.quadraticCurveTo(cx + 40, bottom - 15, cx + 35, bottom - 20);
  c.closePath();
  c.fill();
}
}

// === LOW OBSTACLES LEVEL 2 (bar top) ===
_drawLowObs2(c, type, x, y, w, h) {
var cx = x + w/2;
var gY = y + h;

if (type === 0) {
  // Beer taps (brass/chrome tap handles sticking up from bar)
  c.fillStyle = '#d4a574';
  c.beginPath();
  c.ellipse(cx - 8, y + h - 5, 3, 8, 0, 0, Math.PI * 2);
  c.fill();
  c.fillStyle = '#a08050';
  c.beginPath();
  c.ellipse(cx - 8, y + h - 5, 2, 6, 0, 0, Math.PI * 2);
  c.fill();
  // Second tap
  c.fillStyle = '#d4a574';
  c.beginPath();
  c.ellipse(cx + 8, y + h - 5, 3, 8, 0, 0, Math.PI * 2);
  c.fill();
  c.fillStyle = '#a08050';
  c.beginPath();
  c.ellipse(cx + 8, y + h - 5, 2, 6, 0, 0, Math.PI * 2);
  c.fill();
} else if (type === 1) {
  // Tip jar with coins (glass jar, coins visible)
  c.fillStyle = '#2a4a40';
  c.beginPath();
  c.arc(cx, y + h/2, w/2 - 2, 0, Math.PI * 2);
  c.fill();
  c.strokeStyle = '#4a6a60';
  c.lineWidth = 1.5;
  c.stroke();
  // Coins in jar
  c.fillStyle = '#c9a050';
  for (var coin = 0; coin < 6; coin++) {
    var coinX = cx - w/4 + Math.random() * (w/2);
    var coinY = y + h/2 + Math.random() * (h/3);
    c.beginPath();
    c.ellipse(coinX, coinY, 2.5, 1.5, 0, 0, Math.PI * 2);
    c.fill();
  }
  // Jar lid
  c.fillStyle = '#d4a574';
  c.fillRect(cx - w/2 - 2, y + 2, w + 4, 4);
} else {
  // Spilled drink with fallen glass (puddle, broken glass shards)
  c.fillStyle = 'rgba(200, 160, 80, 0.4)';
  c.beginPath();
  c.ellipse(cx, y + h - 5, w/2 - 4, 4, 0, 0, Math.PI * 2);
  c.fill();
  // Broken glass shards
  c.fillStyle = 'rgba(100, 150, 200, 0.5)';
  c.beginPath();
  c.moveTo(cx - 10, y + h - 5);
  c.lineTo(cx - 12, y + h - 2);
  c.lineTo(cx - 8, y + h - 1);
  c.closePath();
  c.fill();
  c.beginPath();
  c.moveTo(cx, y + h - 8);
  c.lineTo(cx - 2, y + h - 2);
  c.lineTo(cx + 3, y + h - 3);
  c.closePath();
  c.fill();
  c.beginPath();
  c.moveTo(cx + 10, y + h - 6);
  c.lineTo(cx + 8, y + h - 2);
  c.lineTo(cx + 14, y + h - 1);
  c.closePath();
  c.fill();
}
}

// === HIGH OBSTACLES LEVEL 3 (stage) ===
_drawHighObs3(c, type, x, w, h) {
var cx = x + w/2;
var bottom = h;
var dg = c.createRadialGradient(cx, bottom - 20, 5, cx, bottom, 50);
dg.addColorStop(0, 'rgba(255,80,80,0.15)');
dg.addColorStop(1, 'rgba(255,80,80,0)');
c.fillStyle = dg;
c.fillRect(cx - 50, bottom - 60, 100, 70);

if (type === 0) {
  // Guitar neck swinging overhead
  c.fillStyle = '#3a2018';
  c.fillRect(cx - 2, bottom - 50, 4, 50); // strap
  // Guitar neck
  c.fillStyle = '#5a4a3a';
  c.fillRect(cx - 8, bottom - 45, 16, 35);
  // Frets
  c.strokeStyle = '#d4a574';
  c.lineWidth = 0.5;
  for (var f = 0; f < 12; f++) {
    c.beginPath();
    c.moveTo(cx - 7, bottom - 43 + f * 3);
    c.lineTo(cx + 7, bottom - 43 + f * 3);
    c.stroke();
  }
  // Tuning pegs
  c.fillStyle = '#8a7a6a';
  for (var p = 0; p < 3; p++) {
    c.beginPath();
    c.arc(cx - 10, bottom - 40 + p * 8, 2, 0, Math.PI * 2);
    c.fill();
    c.beginPath();
    c.arc(cx + 10, bottom - 40 + p * 8, 2, 0, Math.PI * 2);
    c.fill();
  }
} else if (type === 1) {
  // Cymbal on tall stand
  c.fillStyle = '#1a1a1a';
  c.fillRect(cx - 1, bottom - 40, 2, 40); // stand pole
  // Cymbal disc
  c.fillStyle = '#8a7a50';
  c.beginPath();
  c.ellipse(cx, bottom - 45, 25, 8, 0.1, 0, Math.PI * 2);
  c.fill();
  c.strokeStyle = '#5a4a30';
  c.lineWidth = 2;
  c.stroke();
  // Cymbal shine
  c.fillStyle = 'rgba(255, 255, 200, 0.15)';
  c.beginPath();
  c.ellipse(cx - 5, bottom - 47, 8, 3, 0.1, 0, Math.PI * 2);
  c.fill();
} else {
  // Low-hanging spotlight rig (PAR can lights on a bar)
  c.fillStyle = '#1a1a1a';
  c.fillRect(cx - 1, 0, 2, bottom - 25); // mounting pole
  // Truss/pipe
  c.fillStyle = '#2a2a2a';
  c.fillRect(cx - 30, bottom - 30, 60, 4);
  // PAR cans
  for (var par = 0; par < 3; par++) {
    var parX = cx - 20 + par * 20;
    c.fillStyle = '#333';
    c.fillRect(parX - 10, bottom - 28, 20, 16);
    // Lens
    c.fillStyle = 'rgba(255, 200, 100, 0.3)';
    c.beginPath();
    c.arc(parX, bottom - 20, 8, 0, Math.PI * 2);
    c.fill();
  }
}
}

// === LOW OBSTACLES LEVEL 3 (stage) ===
_drawLowObs3(c, type, x, y, w, h) {
var cx = x + w/2;
var gY = y + h;

if (type === 0) {
  // Stage monitor wedge (angled black wedge speaker)
  c.fillStyle = '#1a1a1a';
  c.beginPath();
  c.moveTo(x, y + h);
  c.lineTo(x + w, y + h);
  c.lineTo(x + w - 5, y);
  c.lineTo(x + 5, y);
  c.closePath();
  c.fill();
  c.strokeStyle = '#333';
  c.lineWidth = 1.5;
  c.stroke();
  // Speaker cone
  c.fillStyle = '#2a2a2a';
  c.beginPath();
  c.arc(cx, y + h - 8, 6, 0, Math.PI * 2);
  c.fill();
} else if (type === 1) {
  // Cable bundle with gaffer tape (tangled cables on floor)
  c.fillStyle = '#1a1a1a';
  c.beginPath();
  c.ellipse(cx, y + h - 3, w/2, h/2, 0, 0, Math.PI * 2);
  c.fill();
  // Cables
  c.strokeStyle = '#3a3a3a';
  c.lineWidth = 1;
  for (var c_i = 0; c_i < 5; c_i++) {
    c.beginPath();
    c.moveTo(cx - w/3, y + h - Math.random() * 6);
    c.quadraticCurveTo(cx, y + h - 4 - Math.random() * 8, cx + w/3, y + h - Math.random() * 6);
    c.stroke();
  }
  // Gaffer tape strips
  c.fillStyle = '#333333';
  c.fillRect(cx - w/3, y + h - 4, w/3, 2);
  c.fillRect(cx, y + h - 3, w/4, 1);
} else {
  // Fallen mic stand (stand on its side with mic)
  c.fillStyle = '#1a1a1a';
  c.beginPath();
  c.moveTo(x + 5, y + h);
  c.lineTo(x + w - 5, y + 5);
  c.lineTo(x + w - 2, y + h);
  c.closePath();
  c.fill();
  // Mic head
  c.fillStyle = '#3a3a3a';
  c.beginPath();
  c.arc(x + w - 5, y + 2, 4, 0, Math.PI * 2);
  c.fill();
  // Mic clip
  c.fillStyle = '#888';
  c.fillRect(x + w - 8, y + 6, 6, 3);
}
}

_drawPlayer(c) {
var cp = this.carryPhase;
var px = 100, py = cp.playerY;
var isDucking = cp.playerDuckingInput && !cp.playerJumping;
var isAirborne = cp.playerY < cp.groundY - 5;
var legCycle = Math.sin(this.t * 8);
var blink = (Math.sin(this.t * 2.1) > 0.95);

// Ground shadow anchors the figure to the boards
c.save();
c.globalAlpha = isAirborne ? 0.10 : 0.20;
c.fillStyle = '#000';
c.beginPath();
c.ellipse(px, cp.groundY + 20, isAirborne ? 10 : 14, 3.4, 0, 0, Math.PI * 2);
c.fill();
c.restore();

// Invulnerability flash
if (cp.invulnTimer > 0 && Math.sin(this.t * 30) > 0) { c.globalAlpha = 0.4; }
// The pit swallows: fade toward black as he drops below the boards
if (cp.pitFalling && cp.pitFallY > 0) {
  c.globalAlpha *= Math.max(0.16, 1 - (cp.pitFallY / 88) * 0.85);
}

c.save();

// Run lean: tips forward when hurrying, sits back when hanging back
if (Math.abs(cp.runLean) > 0.02) {
  c.translate(px, py);
  c.rotate(cp.runLean * 0.16);
  c.translate(-px, -py);
}

// Stagger shake — character wobbles side to side rapidly
if (cp.staggerTimer > 0) {
  var staggerIntensity = Math.min(1, cp.staggerTimer / 0.5);
  var shakeX = Math.sin(this.t * 28) * 6 * staggerIntensity;
  var shakeR = Math.sin(this.t * 22) * 0.15 * staggerIntensity;
  c.translate(px + shakeX, py);
  c.rotate(shakeR);
  c.translate(-(px + shakeX), -py);
  // Draw dizzy stars above head
  c.save();
  c.globalAlpha = 0.7 * staggerIntensity;
  c.fillStyle = '#ffe880';
  c.font = '10px Georgia';
  c.textAlign = 'center';
  var starAngle = this.t * 6;
  for (var si = 0; si < 3; si++) {
    var sa = starAngle + si * (Math.PI * 2 / 3);
    var starX = px + Math.cos(sa) * 14;
    var starY = py - 18 + Math.sin(sa) * 5;
    c.fillText('\u2726', starX, starY);
  }
  c.restore();
}

if (isDucking) {
  // DUCKING POSE — crouched low
  var duckY = cp.groundY + 5;
  // Shadow
  c.fillStyle = 'rgba(0,0,0,0.3)';
  c.beginPath();
  c.ellipse(px, cp.groundY + 38, 16, 4, 0, 0, Math.PI * 2);
  c.fill();
  // Legs (folded)
  c.fillStyle = '#1a1a28';
  c.fillRect(px - 8, duckY + 10, 7, 12);
  c.fillRect(px + 1, duckY + 10, 7, 12);
  // Shoes
  c.fillStyle = '#2a1a10';
  c.fillRect(px - 10, duckY + 20, 10, 5);
  c.fillRect(px, duckY + 20, 10, 5);
  // Torso (hunched)
  c.fillStyle = '#4a3a2a';
  c.fillRect(px - 8, duckY, 16, 14);
  // Collar
  c.fillStyle = '#d4c8b0';
  c.fillRect(px - 5, duckY, 10, 3);
  // Head (tucked)
  c.fillStyle = '#c9a07a';
  c.beginPath();
  c.arc(px, duckY - 4, 7, 0, Math.PI * 2);
  c.fill();
  // Hair
  c.fillStyle = '#3a2a1a';
  c.beginPath();
  c.arc(px, duckY - 6, 7, Math.PI, Math.PI * 2);
  c.fill();
  // Arms holding tray up
  c.strokeStyle = '#c9a07a';
  c.lineWidth = 2.5;
  c.beginPath();
  c.moveTo(px + 7, duckY + 5);
  c.lineTo(px + 14, duckY - 10);
  c.stroke();
  c.beginPath();
  c.moveTo(px - 7, duckY + 5);
  c.lineTo(px - 14, duckY - 10);
  c.stroke();
} else {
  // STANDING / RUNNING / JUMPING POSE
  var bodyTop = py;
  // Shadow (only on ground)
  if (!isAirborne) {
    c.fillStyle = 'rgba(0,0,0,0.3)';
    c.beginPath();
    c.ellipse(px, cp.groundY + 38, 12, 3, 0, 0, Math.PI * 2);
    c.fill();
  }
  // Shoes
  c.fillStyle = '#2a1a10';
  var shoeL = isAirborne ? -2 : legCycle * 5;
  var shoeR = isAirborne ? 2 : -legCycle * 5;
  c.fillRect(px - 7 + shoeL, bodyTop + 33, 8, 5);
  c.fillRect(px - 1 + shoeR, bodyTop + 33, 8, 5);
  // Legs (dark trousers)
  c.fillStyle = '#1a1a28';
  c.save();
  c.beginPath();
  c.moveTo(px - 3, bodyTop + 20);
  c.lineTo(px - 6 + shoeL, bodyTop + 34);
  c.lineTo(px + 1 + shoeL, bodyTop + 34);
  c.lineTo(px, bodyTop + 20);
  c.closePath();
  c.fill();
  c.beginPath();
  c.moveTo(px, bodyTop + 20);
  c.lineTo(px - 1 + shoeR, bodyTop + 34);
  c.lineTo(px + 6 + shoeR, bodyTop + 34);
  c.lineTo(px + 3, bodyTop + 20);
  c.closePath();
  c.fill();
  c.restore();
  // Torso (brown waistcoat over white shirt)
  c.fillStyle = '#d4c8b0'; // shirt
  c.fillRect(px - 7, bodyTop + 6, 14, 16);
  c.fillStyle = '#4a3a2a'; // waistcoat
  c.fillRect(px - 7, bodyTop + 6, 5, 15);
  c.fillRect(px + 2, bodyTop + 6, 5, 15);
  // Waistcoat buttons
  c.fillStyle = '#c9a050';
  c.beginPath(); c.arc(px, bodyTop + 10, 1, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.arc(px, bodyTop + 15, 1, 0, Math.PI * 2); c.fill();
  // Collar / bow tie
  c.fillStyle = '#d4c8b0';
  c.fillRect(px - 5, bodyTop + 4, 10, 3);
  c.fillStyle = '#8a2020';
  c.beginPath();
  c.moveTo(px - 3, bodyTop + 5);
  c.lineTo(px, bodyTop + 3);
  c.lineTo(px + 3, bodyTop + 5);
  c.lineTo(px, bodyTop + 7);
  c.closePath();
  c.fill();
  // Head
  c.fillStyle = '#c9a07a';
  c.beginPath();
  c.arc(px, bodyTop - 2, 8, 0, Math.PI * 2);
  c.fill();
  // Hair
  c.fillStyle = '#3a2a1a';
  c.beginPath();
  c.arc(px, bodyTop - 4, 8, Math.PI + 0.3, Math.PI * 2 - 0.3);
  c.fill();
  // Eyes
  c.fillStyle = blink ? '#c9a07a' : '#1a1a1a';
  c.beginPath(); c.arc(px - 3, bodyTop - 2, 1.2, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.arc(px + 3, bodyTop - 2, 1.2, 0, Math.PI * 2); c.fill();
  // Nose
  c.fillStyle = '#b8906a';
  c.beginPath(); c.arc(px, bodyTop + 1, 1, 0, Math.PI * 2); c.fill();
  // Arms holding tray up
  c.strokeStyle = '#c9a07a';
  c.lineWidth = 2.5;
  var armBob = isAirborne ? 2 : Math.sin(this.t * 8) * 1.5;
  c.beginPath();
  c.moveTo(px + 7, bodyTop + 10);
  c.quadraticCurveTo(px + 14, bodyTop + 2, px + 16, bodyTop - 10 + armBob);
  c.stroke();
  c.beginPath();
  c.moveTo(px - 7, bodyTop + 10);
  c.quadraticCurveTo(px - 14, bodyTop + 2, px - 16, bodyTop - 10 + armBob);
  c.stroke();
  // Hands
  c.fillStyle = '#c9a07a';
  c.beginPath(); c.arc(px + 16, bodyTop - 10 + armBob, 2, 0, Math.PI * 2); c.fill();
  c.beginPath(); c.arc(px - 16, bodyTop - 10 + armBob, 2, 0, Math.PI * 2); c.fill();
}

c.restore();
c.globalAlpha = 1;
}

_drawTray(c) {
var cp = this.carryPhase;
var px = 100;
var isDucking = cp.playerDuckingInput && !cp.playerJumping;
var trayY = isDucking ? (cp.groundY - 8) : (cp.playerY - 12);
var armBob = (cp.playerY < cp.groundY - 5) ? 2 : Math.sin(this.t * 8) * 1.5;
if (!isDucking) trayY += armBob;

var wobble = cp.screenShake * 2;

// Wobble effect: tray rocks back and forth when in danger
var wobbleRot = 0;
if (cp.wobbling) {
  var wobbleIntensity = Math.min(1, cp.wobbleTimer / 1.5); // fades out over time
  wobbleRot = Math.sin(this.t * 14) * 0.12 * wobbleIntensity;
}

c.save();
c.translate(px, trayY);
c.rotate(wobble * 0.04 + wobbleRot);

// Silver tray with rim
c.fillStyle = '#888';
c.beginPath();
c.ellipse(0, 0, 22, 5, 0, 0, Math.PI * 2);
c.fill();
c.fillStyle = '#aaa';
c.beginPath();
c.ellipse(0, -1, 20, 4, 0, 0, Math.PI * 2);
c.fill();
// Tray highlight
c.fillStyle = 'rgba(255,255,255,0.15)';
c.beginPath();
c.ellipse(-4, -2, 10, 2, -0.2, 0, Math.PI * 2);
c.fill();

// Glasses on tray
var cols = ['#c98030','#e0d090','#d4a050'];
var names = ['B','M','S'];
for (var i = 0; i < cp.glassesLeft; i++) {
  var gx = -14 + i * 14;
  // Glass body
  c.fillStyle = 'rgba(200,200,200,0.25)';
  c.fillRect(gx - 4, -16, 8, 14);
  c.strokeStyle = 'rgba(255,255,255,0.3)';
  c.lineWidth = 0.8;
  c.strokeRect(gx - 4, -16, 8, 14);
  // Liquid
  c.fillStyle = cols[i] || '#d4a050';
  c.fillRect(gx - 3, -10, 6, 8);
  // Glass highlight
  c.fillStyle = 'rgba(255,255,255,0.15)';
  c.fillRect(gx - 3, -14, 2, 10);
}

c.restore();
}

// ========== RESULT PHASE ==========
_resultCarry() {
var cp = this.carryPhase;
var perfect = cp.glassesLeft === 3;
var win = cp.glassesLeft >= 1;

document.getElementById('bar-round-display').textContent = win ? '★ YOU MADE IT! ★' : '✗ SPILLED! ✗';
var narr = document.getElementById('bar-narrative');

if (perfect) {
  narr.innerHTML = '<em style="color:#e8c060;">All three drinks reach the stage. MOE nods. The band plays on.</em>';
} else if (cp.glassesLeft === 2) {
  narr.innerHTML = '<em style="color:#d4a574;">Two land safely. MOE shrugs. "Better than nothing."</em>';
} else if (win) {
  narr.innerHTML = '<em style="color:#c8a674;">One drink left standing. MOE takes it. "It\'ll do."</em>';
} else {
  narr.innerHTML = '<em style="color:#d8846a;">Empty tray. The pianist sighs. The band waits.</em>';
}

this.phase = 'result';

var self = this;
/* 2026-10-28 (Sam: "Easier each retry"): a lost round no longer leaves at once; TRY AGAIN pours a gentler round, MOVE ON takes the loss */
if (!win && window.dssEase) {
  window.dssEase.lost('bar');
  setTimeout(function() {
    var cv = document.getElementById('bar-canvas'); if (!cv || !cv.isConnected) return;
    window.dssEase.offer(cv.parentElement, { onAgain: function() { window._barStartAt = 0; window.startBarGame(); }, onMove: function() { var lk = document.querySelector('#bar-lose-link tw-link'); if (lk) lk.click(); } });
  }, 1800);
  return;
}
setTimeout(function() {
  var lk = win ? document.querySelector('#bar-win-link tw-link') : document.querySelector('#bar-lose-link tw-link');
  if (lk) lk.click();
}, 2500);
}

_drawResult() {
// The club with the lights down: a single spot on the stage lip, the tray
// set down in it with whatever survived, smoke drifting through the beam.
var c = this.ctx, W = this.W, H = this.H, t = this.t, i;
var glasses = this.carryPhase.glassesLeft;
var isWin = glasses >= 1;
var wall = c.createLinearGradient(0, 0, 0, H);
wall.addColorStop(0, '#140d07'); wall.addColorStop(1, '#050302');
c.fillStyle = wall; c.fillRect(0, 0, W, H);
var floorY = Math.round(H * 0.72);
c.fillStyle = '#0d0905'; c.fillRect(0, floorY, W, H - floorY);
c.strokeStyle = 'rgba(120,90,50,0.16)'; c.lineWidth = 1;
for (i = 14; i < W; i += 28) { c.beginPath(); c.moveTo(i, floorY); c.lineTo(i, H); c.stroke(); }
c.strokeStyle = 'rgba(212,176,110,0.22)'; c.beginPath(); c.moveTo(0, floorY + 0.5); c.lineTo(W, floorY + 0.5); c.stroke();
// the spot
c.save();
var cone = c.createLinearGradient(0, 0, 0, floorY + 24);
cone.addColorStop(0, 'rgba(255,214,150,0.20)'); cone.addColorStop(1, 'rgba(255,190,110,0)');
c.fillStyle = cone; c.beginPath();
c.moveTo(W/2 - 26, 0); c.lineTo(W/2 + 26, 0); c.lineTo(W/2 + 150, floorY + 24); c.lineTo(W/2 - 150, floorY + 24); c.closePath(); c.fill();
c.restore();
c.save(); c.translate(W/2, floorY + 4); c.scale(1, 0.32);
var pool = c.createRadialGradient(0, 0, 4, 0, 0, 160);
pool.addColorStop(0, 'rgba(255,214,150,0.30)'); pool.addColorStop(1, 'rgba(255,214,150,0)');
c.fillStyle = pool; c.beginPath(); c.arc(0, 0, 160, 0, Math.PI * 2); c.fill();
c.restore();
// smoke through the beam
c.save(); c.globalAlpha = 0.07;
for (i = 0; i < 4; i++) {
  var sx = W/2 + Math.sin(t * 0.25 + i * 1.9) * 70, sy = 80 + i * 62 + Math.sin(t * 0.4 + i) * 14;
  var sm = c.createRadialGradient(sx, sy, 0, sx, sy, 70);
  sm.addColorStop(0, 'rgba(230,210,180,0.6)'); sm.addColorStop(1, 'rgba(0,0,0,0)');
  c.fillStyle = sm; c.fillRect(sx - 90, sy - 70, 180, 140);
}
c.restore();
// the tray on the stage lip, the drinks that made it, rings where the rest stood
var trayW = 156, trayY = floorY - 8;
c.save();
c.fillStyle = '#2a1c10'; c.strokeStyle = 'rgba(212,176,110,0.55)'; c.lineWidth = 1.2;
c.beginPath(); c.ellipse(W/2, trayY, trayW/2, 9, 0, 0, Math.PI * 2); c.fill(); c.stroke();
c.fillStyle = 'rgba(255,230,180,0.10)'; c.beginPath(); c.ellipse(W/2, trayY - 2, trayW/2 - 14, 5, 0, 0, Math.PI * 2); c.fill();
for (i = 0; i < 3; i++) {
  var cd = this.completedDrinks[i], gx = W/2 - 48 + i * 48;
  if (i < glasses && cd) {
    var gh = this.glassH[cd.glass] || 55;
    this._drawGlass(c, cd.glass, gx, trayY - gh - 2, 0.65, 0, cd.liqCol, cd.liqHi || '#fff');
  } else {
    c.strokeStyle = 'rgba(200,120,90,0.32)'; c.lineWidth = 1;
    c.beginPath(); c.ellipse(gx, trayY - 3, 10, 3.5, 0, 0, Math.PI * 2); c.stroke();
  }
}
c.restore();
// the words, gold under the spot
var caption;
if (glasses === 3) caption = 'A clean run.';
else if (glasses === 2) caption = 'Most of it home.';
else if (glasses === 1) caption = 'One survivor.';
else caption = 'The tray came up short.';
c.save();
c.textAlign = 'center';
c.shadowColor = 'rgba(232,196,110,0.5)'; c.shadowBlur = 14;
c.font = '600 11px Georgia'; c.fillStyle = 'rgba(212,176,110,0.7)';
c.fillText(isWin ? 'T H E   T R A Y   R E A C H E S   T H E   S T A G E' : 'T H E   T R A Y   C O M E S   U P   E M P T Y', W/2, 58);
c.font = 'bold 30px Georgia'; c.fillStyle = isWin ? '#f0dca0' : '#d8a090';
c.fillText(glasses + ' OF 3 DELIVERED', W/2, 98);
c.shadowBlur = 8; c.font = '26px Georgia';
for (i = 0; i < 3; i++) { c.fillStyle = i < glasses ? '#e8c060' : 'rgba(232,192,96,0.16)'; c.fillText('★', W/2 - 44 + i * 44, 134); }
c.shadowBlur = 0; c.font = 'italic 14px Georgia'; c.fillStyle = '#b8a078';
c.fillText(caption, W/2, 162);
c.restore();
this._drawSparkles(c);
}
};

// ====== DRINK POPUP (sip animation for buying drinks) ======
window.DrinkPopup = class DrinkPopup {
constructor(drinkType) {
  // drinkType: 'pint', 'whisky', 'gin', 'wine', 'champagne'
  this.type = drinkType || 'whisky';
  this.sipped = false;
  this.tiltAngle = 0;
  this.tiltTarget = 0;
  this.liquidLevel = 0;      // starts empty — pours in on entry
  this.fillLevel = 0;        // animation fill progress (0→1)
  this.filling = true;       // true during pour-in animation
  this.idleBob = 0;          // gentle vertical bob offset (px)
  this.wobble = 0;
  this.wobbleDecay = 0;
  this.fadeAlpha = 0;
  this.fadeTarget = 1;
  this.done = false;
  this.t = 0;

  // Drink configs: label, liquid colour, highlight, glass shape, ambient glow colour.
  // Specific drink names are now period-correct Soho-1973 brands/vintages: a
  // chosen "Claret" pours a Château Margaux '66; the Colony's house champagne
  // is Bollinger '66; etc. Old generic keys (wine/champagne/whisky/etc.) are
  // kept around as fallbacks but their labels have been upgraded to the
  // specific drink each chosen link resolves to.
  this.configs = {
    pint:        { label: 'Pint',                     liq: '#180a02', hi: '#2a1608', foam: '#e0d4b8', bg: '#9a8050', glow: 'rgba(140,90,28,0.12)' },
    whisky:      { label: "Laphroaig 10",             liq: '#b88438', hi: '#e0b870', foam: null,       bg: '#9a8050', glow: 'rgba(180,130,50,0.18)' },
    gin:         { label: 'Gin & Bitter Lemon',       liq: '#d4d488', hi: '#e0e0b0', foam: null,       bg: '#6ea0b0', glow: 'rgba(140,170,150,0.12)' },
    wine:        { label: 'Wine',                     liq: '#4a0818', hi: '#681628', foam: null,       bg: '#9a8050', glow: 'rgba(110,20,40,0.16)' },
    champagne:   { label: "Bollinger '66",            liq: '#cab85c', hi: '#dcc880', foam: '#e0d8c0', bg: '#9a8050', glow: 'rgba(180,168,72,0.13)' },
    scotch:      { label: 'Scotch',                   liq: '#b07a32', hi: '#c89048', foam: null,       bg: '#9a8050', glow: 'rgba(140,90,32,0.14)' },
    cider:       { label: 'Cidre Brut de Bretagne',   liq: '#b08420', hi: '#c49838', foam: '#dcd0a0', bg: '#9a8050', glow: 'rgba(140,110,28,0.12)' },
    vodka:       { label: 'Stolichnaya & Tonic',      liq: '#c0d0d0', hi: '#d0dcdc', foam: null,       bg: '#6ea0b0', glow: 'rgba(130,160,170,0.11)' },
    beer:        { label: "Watney's Red Barrel",      liq: '#a06014', hi: '#bc8030', foam: '#e0d4b8', bg: '#9a8050', glow: 'rgba(140,100,20,0.13)' },
    // The Pillars' pumps — dark beer family, cream heads
    stout:       { label: 'Stout',                    liq: '#1a0f08', hi: '#2e1a10', foam: '#e8dcc0', bg: '#9a8050', glow: 'rgba(90,60,25,0.14)' },
    porter:      { label: 'Porter',                   liq: '#2e1408', hi: '#48220e', foam: '#dcd0b0', bg: '#9a8050', glow: 'rgba(100,70,30,0.13)' },
    mild:        { label: 'Mild',                     liq: '#4a2410', hi: '#66341a', foam: '#d8ccae', bg: '#9a8050', glow: 'rgba(110,80,35,0.12)' },
    // Specific reds — different vintages/regions get distinct colours
    claret:      { label: "Château Margaux '66",      liq: '#3a0612', hi: '#581020', foam: null,       bg: '#9a8050', glow: 'rgba(120,15,35,0.18)' },
    beaujolais:  { label: "Fleurie '71",              liq: '#5a1822', hi: '#7a2434', foam: null,       bg: '#9a8050', glow: 'rgba(130,30,50,0.16)' },
    // Trisha's "sponsored drink" — slightly more amber than the Colony's Bollinger
    krug:        { label: "Krug Grande Cuvée",        liq: '#d8c068', hi: '#e8d088', foam: '#e8e0c8', bg: '#9a8050', glow: 'rgba(200,180,90,0.14)' }
  };
  this.cfg = this.configs[this.type] || this.configs.whisky;

  this._build();
  this._startLoop();
  window._drinkPopupOpen = true;
  if (window.dssAudio) {
    window.dssAudio.glassClink();        // glass meets bar
    setTimeout(function(){ if (window.dssAudio) window.dssAudio.pour(); }, 90);
  }
}

_build() {
  // Overlay
  this.overlay = document.createElement('div');
  this.overlay.id = 'drink-popup-overlay'; // detectable by the nav sweep + busy list
  this.overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;z-index:99999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0);transition:background 0.5s;';
  document.body.appendChild(this.overlay);

  // Card
  this.card = document.createElement('div');
  this.card.style.cssText = [
    'display:flex;flex-direction:column;align-items:center;',
    'padding:0 0 20px;',
    'background:rgba(14,9,4,0.97);',
    'border:1px solid rgba(200,168,106,0.35);',
    'border-top:2px solid rgba(200,168,106,0.65);',
    'border-radius:10px;',
    'position:relative;overflow:hidden;',
    'opacity:0;',
    'transform:translateY(18px);',
    'transition:opacity 0.45s,transform 0.45s;',
    'min-width:180px;',
  ].join('');
  this.overlay.appendChild(this.card);

  // Drink name label
  this.nameLabel = document.createElement('div');
  this.nameLabel.style.cssText = [
    'width:100%;box-sizing:border-box;',
    'padding:12px 28px 10px;',
    'text-align:center;',
    'font:small-caps 600 13px Cinzel,Georgia,serif;',
    'letter-spacing:0.12em;',
    'color:rgba(200,168,106,0.85);',
    'border-bottom:1px solid rgba(200,168,106,0.15);',
  ].join('');
  this.nameLabel.textContent = this.cfg.label;
  this.card.appendChild(this.nameLabel);

  // Canvas wrapper
  var canvasWrap = document.createElement('div');
  canvasWrap.style.cssText = 'padding:18px 28px 0;';
  this.card.appendChild(canvasWrap);

  // Canvas (taller to accommodate the lips above the glass)
  this.canvas = document.createElement('canvas');
  this.pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
  this.canvas.width = 160 * this.pixelRatio;
  this.canvas.height = 260 * this.pixelRatio;
  this.canvas.style.cssText = 'cursor:pointer;display:block;width:160px;height:260px;touch-action:none;';
  this.ctx = this.canvas.getContext('2d');
  canvasWrap.appendChild(this.canvas);
  // Lip animation state
  this.lipOpen = 0;         // 0 = closed, 1 = parted for drinking
  this.lipOpenTarget = 0.18; // resting parted-kiss position
  this.streamT = 0;         // time accumulator for stream dashes
  this.streamStrength = 0;  // 0 = no pour, 1 = full pour (ramps up/down for taper)
  this.entryStrength = 0;   // 0 = no entry pour, 1 = stream pouring in during fill

  // Prompt text
  this.prompt = document.createElement('div');
  this.prompt.style.cssText = 'margin-top:10px;font:italic 13px Georgia,serif;color:rgba(212,165,116,0.75);letter-spacing:0.04em;';
  this.prompt.textContent = 'Hold to drink';
  this.card.appendChild(this.prompt);

  // Gold bottle-glow (B3): a single warm highlight sweeps across the card as
  // the drink pours in. Decorative only (pointer-events:none), one-shot — the
  // CSS animation runs once on build and never blocks the hold-to-drink canvas.
  this.pourGlow = document.createElement('div');
  this.pourGlow.className = 'drink-pour-glow';
  this.card.appendChild(this.pourGlow);

  // Fade in
  var self = this;
  this.drinking = false;    // true while mouse/touch held down
  this.hasDrunk = false;    // true once they've drunk at least a little
  this.minLevel = 0.30;     // can't go below this — no downing it
  this.closing = false;     // true once fade-out has started

  setTimeout(function() {
    self.overlay.style.background = 'rgba(0,0,0,0.6)';
    self.card.style.opacity = '1';
    self.card.style.transform = 'translateY(0)';
    self.fadeAlpha = 1;
  }, 30);

  // Hold-to-drink handlers (mouse + touch)
  var startDrink = function(e) {
    e.preventDefault();
    if (self.closing || self.done || self.filling) return;
    if (self.liquidLevel <= self.minLevel + 0.01) return; // already hit bottom
    self.drinking = true;
    self.entryStrength = 0; // entry pour has ended before the glass tilts
    self.hasDrunk = true;
    self.tiltTarget = -0.55;
    self.wobbleDecay = 0.6;
    self.prompt.textContent = '';
    if (window.dssAudio) window.dssAudio.sip();
  };
  var stopDrink = function(e) {
    e.preventDefault();
    if (!self.drinking) return;
    self.drinking = false;
    self.tiltTarget = 0;
    self.wobbleDecay = 0.8;
    // Once they let go after drinking, fade out after a short pause
    if (self.hasDrunk && !self.closing) {
      self.closing = true;
      if (window.dssAudio) window.dssAudio.swallow();
      setTimeout(function() {
        self._fadeOut();
      }, 700);
    }
  };

  this.canvas.addEventListener('mousedown', startDrink);
  this.canvas.addEventListener('mouseup', stopDrink);
  this.canvas.addEventListener('mouseleave', stopDrink);
  this.canvas.addEventListener('touchstart', startDrink);
  this.canvas.addEventListener('touchend', stopDrink);
  this.canvas.addEventListener('touchcancel', stopDrink);
}

_fadeOut() {
  this.overlay.style.background = 'rgba(0,0,0,0)';
  this.card.style.opacity = '0';
  this.card.style.transform = 'translateY(-12px)';
  var self = this;
  setTimeout(function() {
    self.done = true;
    if (self.overlay.parentNode) self.overlay.parentNode.removeChild(self.overlay);
    window._drinkPopupOpen = false;
    window.dispatchEvent(new CustomEvent('drinkpopup:closed'));
  }, 480);
}

_startLoop() {
  var self = this;
  var lt = performance.now();
  function loop() {
    if (self.done) return;
    var now = performance.now();
    var dt = Math.min(now - lt, 50) * 0.001;
    lt = now;
    self.t += dt;
    // Pour-in fill animation (liquid rises from 0 to 1 over ~0.7s on entry)
    if (self.filling) {
      self.fillLevel = Math.min(1, self.fillLevel + 1.5 * dt);
      self.liquidLevel = self.fillLevel;
      if (self.fillLevel >= 1) {
        self.filling = false;
        self.liquidLevel = 1.0;
        self.wobbleDecay = 0.4; // little slosh as it settles
      }
    }
    // Smooth tilt
    self.tiltAngle += (self.tiltTarget - self.tiltAngle) * 4 * dt;
    // Idle bob disabled — clean pour, no floaty glass
    self.idleBob = 0;
    // Lip-open target: parted for drinking, resting kiss otherwise
    self.lipOpenTarget = self.drinking && !self.filling ? 1.0 : 0.18;
    // Drain liquid while holding (only after fill is complete)
    if (self.drinking && !self.filling) {
      // Drain rate slows as you approach the minimum (can't down it)
      var headroom = self.liquidLevel - self.minLevel;
      var rate = 0.35 * Math.min(1.0, headroom * 4); // slows near bottom
      self.liquidLevel = Math.max(self.minLevel, self.liquidLevel - rate * dt);
      // If hit the floor, auto-release
      if (self.liquidLevel <= self.minLevel + 0.005) {
        self.liquidLevel = self.minLevel;
        self.drinking = false;
        self.tiltTarget = 0;
        if (!self.closing) {
          self.closing = true;
          setTimeout(function() { self._fadeOut(); }, 700);
        }
      }
    }
    // Wobble removed — the pour stays steady and clean
    self.wobble = 0;
    // Smooth stream strength: grows in when drinking, fades out when released
    var streamWant = (self.drinking && !self.filling && self.liquidLevel > self.minLevel + 0.01) ? 1 : 0;
    self.streamStrength += (streamWant - self.streamStrength) * 6 * dt;
    // Entry-pour strength: ramps up fast while filling, tails off after the glass is full
    var entryWant = self.filling ? 1 : 0;
    var entryRate = self.filling ? 10 : 4;
    self.entryStrength += (entryWant - self.entryStrength) * entryRate * dt;
    self._draw();
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);
}

_draw() {
  var c = this.ctx, W = 160, H = 260;
  c.setTransform(this.pixelRatio, 0, 0, this.pixelRatio, 0, 0);
  c.clearRect(0, 0, W, H);

  var cfg = this.cfg;
  var lev = this.liquidLevel;
  var wob = this.wobble;
  var bob = this.idleBob || 0;

  // Fixed layout: glass up top, lips waiting below
  var glassPivotY = 115;   // bottom of the glass
  var lipCy = 210;         // vertical centre of the mouth

  // Smooth lip opening: target is set in the loop based on drinking state
  this.lipOpen += (this.lipOpenTarget - this.lipOpen) * 0.2;

  // Ambient radial glow behind the glass (per-drink colour, fades with level)
  if (cfg.glow && lev > 0.05) {
    var gCx = W / 2, gCy = glassPivotY - 40 + bob;
    var grd = c.createRadialGradient(gCx, gCy, 0, gCx, gCy, 72);
    grd.addColorStop(0, cfg.glow);
    grd.addColorStop(1, 'rgba(0,0,0,0)');
    c.fillStyle = grd;
    c.fillRect(0, 0, W, H);
  }

  // Lips below the glass, waiting to receive the pour
  this._drawLips(c, W, cfg, lipCy);

  // Stream of liquid from glass rim down into the lips (ramps in/out via streamStrength)
  if (this.streamStrength > 0.02) {
    this._drawStream(c, W, H, cfg, bob, glassPivotY, lipCy);
  }

  // Entry pour: stream from above the canvas into the glass rim during the fill phase
  if (this.entryStrength > 0.02) {
    this._drawEntryPour(c, W, H, cfg, bob, glassPivotY);
  }

  // Glass up top, tilting on pivot (base of the glass)
  c.save();
  c.translate(W / 2, glassPivotY + bob);
  c.rotate(this.tiltAngle);

  if (this.type === 'pint' || this.type === 'cider' || this.type === 'beer' || this.type === 'stout' || this.type === 'porter' || this.type === 'mild') {
    this._drawPint(c, cfg, lev, wob);
  } else if (this.type === 'wine' || this.type === 'claret' || this.type === 'beaujolais') {
    this._drawWine(c, cfg, lev, wob);
  } else if (this.type === 'champagne' || this.type === 'krug') {
    this._drawChampagne(c, cfg, lev, wob);
  } else if (this.type === 'gin' || this.type === 'vodka') {
    this._drawTallGlass(c, cfg, lev, wob);
  } else {
    this._drawTumbler(c, cfg, lev, wob);
  }

  c.restore();
}

// === LIPS (big Soho pout, position passed in) ===
_drawLips(c, W, cfg, cyArg) {
  var cx = W / 2;
  var cy = (typeof cyArg === 'number') ? cyArg : 210;  // vertical centre of the mouth
  var lipW = 120;          // overall width
  var upperH = 18;         // upper lip thickness
  var lowerH = 17;         // lower lip thickness
  var open = this.lipOpen * 14; // parted gap in px (0 closed → ~14 wide open)

  c.save();

  // --- Upper lip ---
  // Classic M-curve (Cupid's bow) top, concave bottom where it meets the opening
  c.fillStyle = '#6e3a32';
  c.beginPath();
  c.moveTo(cx - lipW / 2, cy);
  // Top edge: dip to left peak, rise to centre dip of cupid's bow, rise to right peak, down to right corner
  c.bezierCurveTo(cx - lipW / 2 + 10, cy - upperH * 1.1, cx - 28, cy - upperH * 1.25, cx - 14, cy - upperH * 0.75);
  c.quadraticCurveTo(cx - 4, cy - upperH * 0.15, cx, cy - upperH * 0.55); // centre dip
  c.quadraticCurveTo(cx + 4, cy - upperH * 0.15, cx + 14, cy - upperH * 0.75);
  c.bezierCurveTo(cx + 28, cy - upperH * 1.25, cx + lipW / 2 - 10, cy - upperH * 1.1, cx + lipW / 2, cy);
  // Bottom edge of upper lip: gentle arch with the parted gap in the middle
  c.lineTo(cx + lipW / 2 - 6, cy - 1);
  c.quadraticCurveTo(cx + 20, cy + open * 0.3, cx, cy + open * 0.5);
  c.quadraticCurveTo(cx - 20, cy + open * 0.3, cx - lipW / 2 + 6, cy - 1);
  c.closePath();
  c.fill();

  // Upper-lip sheen (light glam highlight)
  c.fillStyle = 'rgba(180,140,120,0.16)';
  c.beginPath();
  c.ellipse(cx - 18, cy - upperH * 0.6, 14, 3, -0.18, 0, Math.PI * 2);
  c.fill();
  c.beginPath();
  c.ellipse(cx + 22, cy - upperH * 0.55, 10, 2.4, 0.16, 0, Math.PI * 2);
  c.fill();

  // --- Dark parted opening (visible when open > 0) ---
  if (open > 0.2) {
    c.fillStyle = '#180408';
    c.beginPath();
    c.moveTo(cx - 34, cy + 1);
    c.quadraticCurveTo(cx, cy + open * 0.5, cx + 34, cy + 1);
    c.quadraticCurveTo(cx, cy + open + 2, cx - 34, cy + 1);
    c.closePath();
    c.fill();
    // A tiny puddle of the drink colour if we're mid-sip (catches the stream)
    if (this.drinking && this.liquidLevel > this.minLevel + 0.01) {
      c.fillStyle = cfg.liq;
      c.globalAlpha = 0.75;
      c.beginPath();
      c.ellipse(cx, cy + open * 0.6, Math.min(28, open * 2.2), Math.max(1.5, open * 0.35), 0, 0, Math.PI * 2);
      c.fill();
      c.globalAlpha = 1;
    }
  }

  // --- Lower lip ---
  c.fillStyle = '#5a2e28';
  c.beginPath();
  c.moveTo(cx - lipW / 2, cy);
  c.quadraticCurveTo(cx - 20, cy + open * 0.35 + 1, cx, cy + open * 0.65 + 1);
  c.quadraticCurveTo(cx + 20, cy + open * 0.35 + 1, cx + lipW / 2, cy);
  // Bottom curve of lower lip — fuller, rounder than upper
  c.bezierCurveTo(cx + lipW / 2 - 6, cy + lowerH * 1.05, cx + 20, cy + lowerH * 1.35, cx, cy + lowerH * 1.28);
  c.bezierCurveTo(cx - 20, cy + lowerH * 1.35, cx - lipW / 2 + 6, cy + lowerH * 1.05, cx - lipW / 2, cy);
  c.closePath();
  c.fill();

  // Lower-lip sheen (central glossy highlight — the classic pin-up pop)
  c.fillStyle = 'rgba(180,140,120,0.22)';
  c.beginPath();
  c.ellipse(cx, cy + lowerH * 0.7, 18, 3, 0, 0, Math.PI * 2);
  c.fill();
  c.fillStyle = 'rgba(220,200,180,0.16)';
  c.beginPath();
  c.ellipse(cx - 2, cy + lowerH * 0.65, 6, 1.6, 0, 0, Math.PI * 2);
  c.fill();

  // Subtle outer shadow under lips to ground them
  c.fillStyle = 'rgba(0,0,0,0.25)';
  c.beginPath();
  c.ellipse(cx, cy + lowerH * 1.55, lipW * 0.42, 3, 0, 0, Math.PI * 2);
  c.fill();

  c.restore();
}

// === STREAM of liquid from glass rim DOWN into the lips ===
// Per-glass rim offset (low side of the rim when tilted left): x = left rim, y = top of glass
_getRimOffset() {
  // Returns the LOW rim corner in the glass's own local coords (pivot at base, y up is negative)
  if (this.type === 'pint' || this.type === 'cider' || this.type === 'beer' || this.type === 'stout' || this.type === 'porter' || this.type === 'mild') {
    return { x: -20, y: -100 };   // topW=40, gH=100
  } else if (this.type === 'wine' || this.type === 'claret' || this.type === 'beaujolais') {
    return { x: -19, y: -74 };    // wine rim
  } else if (this.type === 'champagne' || this.type === 'krug') {
    return { x: -29, y: -60 };    // coupe rim
  } else if (this.type === 'gin' || this.type === 'vodka') {
    return { x: -19, y: -84 };    // highball rim
  }
  // whisky / scotch / tumbler default
  return { x: -31, y: -74 };      // rocks glass rim
}

_drawStream(c, W, H, cfg, bob, pivotYArg, lipCyArg) {
  this.streamT = this.t * 4.8;
  var strength = this.streamStrength;
  if (strength < 0.02) return;

  // Glass is pivoted at its BASE (pivotYArg). Tilt is negative (counter-clockwise),
  // so liquid pours from the LEFT side of the rim (the low side).
  var pivotY = (typeof pivotYArg === 'number') ? pivotYArg : 115;
  pivotY += bob;

  // Precise per-glass rim origin, rotated by current tilt
  var rim = this._getRimOffset();
  var a = this.tiltAngle;
  var rx = Math.cos(a) * rim.x - Math.sin(a) * rim.y;
  var ry = Math.sin(a) * rim.x + Math.cos(a) * rim.y;
  var sx = W / 2 + rx;
  var sy = pivotY + ry;

  // Mouth target (just inside the parted lips, centred)
  var lipCy = (typeof lipCyArg === 'number') ? lipCyArg : 210;
  var ex = W / 2;
  var ey = lipCy + this.lipOpen * 4;

  // Arcing control point — stream bows outward-then-down into the mouth
  var cxp = (sx + ex) / 2 - 4;
  var cyp = (sy + ey) / 2 + 10;

  c.save();
  c.lineCap = 'round';
  c.lineJoin = 'round';

  // --- Main ribbon: drawn as tapered segments along the curve ---
  // Narrow at rim, swells in the middle, tapers as it enters the mouth.
  var steps = 16;
  var lastX = sx, lastY = sy;
  c.strokeStyle = cfg.liq;
  c.globalAlpha = 0.62 * strength;
  for (var i = 1; i <= steps; i++) {
    var t = i / steps;
    var bx = (1 - t) * (1 - t) * sx + 2 * (1 - t) * t * cxp + t * t * ex;
    var by = (1 - t) * (1 - t) * sy + 2 * (1 - t) * t * cyp + t * t * ey;
    // Width profile: thin (1.8) at rim, peak (5.2) around t=0.45, thinner (2.2) at mouth
    var bulge = 1 - Math.abs(t - 0.45) * 1.6;
    if (bulge < 0) bulge = 0;
    var w = (1.8 + bulge * 3.6) * strength;
    if (w < 1) w = 1;
    c.lineWidth = w;
    c.beginPath();
    c.moveTo(lastX, lastY);
    c.lineTo(bx, by);
    c.stroke();
    lastX = bx; lastY = by;
  }

  // --- Highlight down the middle of the ribbon ---
  c.strokeStyle = cfg.hi || 'rgba(255,255,255,0.5)';
  c.lineWidth = 1.3 * strength;
  c.globalAlpha = 0.55 * strength;
  c.beginPath();
  c.moveTo(sx, sy);
  c.quadraticCurveTo(cxp, cyp, ex, ey);
  c.stroke();

  // --- Droplets tumbling along the arc (more of them, varied sizes) ---
  c.fillStyle = cfg.liq;
  c.globalAlpha = 0.65 * strength;
  var dropCount = 10;
  for (var d = 0; d < dropCount; d++) {
    var dt = ((this.streamT * 0.5 + d / dropCount) % 1);
    var dx = (1 - dt) * (1 - dt) * sx + 2 * (1 - dt) * dt * cxp + dt * dt * ex;
    var dy = (1 - dt) * (1 - dt) * sy + 2 * (1 - dt) * dt * cyp + dt * dt * ey;
    var ds = (1.3 + Math.sin(d * 2.1 + this.streamT * 2) * 0.6) * strength;
    if (ds < 0.5) ds = 0.5;
    c.beginPath();
    c.arc(dx, dy, ds, 0, Math.PI * 2);
    c.fill();
  }

  // --- Splash at the lips: small droplets spraying sideways on impact ---
  if (strength > 0.4) {
    c.fillStyle = cfg.liq;
    var splashN = 6;
    for (var s = 0; s < splashN; s++) {
      // Cycle each droplet through a short arc life so they look ejected
      var life = ((this.streamT * 1.8 + s * 0.19) % 1);
      var sideSign = (s % 2 === 0) ? 1 : -1;
      var ang = sideSign * (0.4 + (s % 3) * 0.15);
      var rOut = life * 14;                          // flies outward
      var spx = ex + Math.cos(Math.PI / 2 + ang) * rOut * sideSign * 0.9;
      var spy = ey - 2 + Math.sin(life * Math.PI) * -3 + life * 4; // tiny arc: up then down
      var alpha = (1 - life) * 0.75 * strength;
      var size = (1.3 - life * 0.7) * strength;
      if (size < 0.4) continue;
      c.globalAlpha = alpha;
      c.beginPath();
      c.arc(spx, spy, size, 0, Math.PI * 2);
      c.fill();
    }
  }

  c.globalAlpha = 1;
  c.restore();
}

// === ENTRY POUR: stream from above the canvas INTO the glass rim during fill ===
_drawEntryPour(c, W, H, cfg, bob, glassPivotY) {
  var strength = this.entryStrength;
  if (strength < 0.02) return;

  // Target: just below the centre of the glass rim (so the stream visibly ends inside the glass)
  var rim = this._getRimOffset();
  var glassTopY = glassPivotY + bob + rim.y;
  var tx = W / 2;
  var ty = glassTopY + 4;

  // Source: offscreen above the glass, slightly offset so it's not a dead-straight column
  var sx = W / 2 + 4;
  var sy = 8;

  // Gentle arc control point
  var cxp = (sx + tx) / 2 - 3;
  var cyp = (sy + ty) / 2 + 5;

  c.save();
  c.lineCap = 'round';
  c.lineJoin = 'round';

  // Tapered ribbon, drawn as short segments with a thickness profile
  var steps = 18;
  var lastX = sx, lastY = sy;
  c.strokeStyle = cfg.liq;
  c.globalAlpha = 0.88 * strength;
  for (var i = 1; i <= steps; i++) {
    var t = i / steps;
    var bx = (1 - t) * (1 - t) * sx + 2 * (1 - t) * t * cxp + t * t * tx;
    var by = (1 - t) * (1 - t) * sy + 2 * (1 - t) * t * cyp + t * t * ty;
    // Width: narrow at source, swells mid-flow, narrows at rim
    var bulge = 1 - Math.abs(t - 0.5) * 1.3;
    if (bulge < 0) bulge = 0;
    var w = (1.8 + bulge * 2.8) * strength;
    if (w < 0.9) w = 0.9;
    c.lineWidth = w;
    c.beginPath();
    c.moveTo(lastX, lastY);
    c.lineTo(bx, by);
    c.stroke();
    lastX = bx; lastY = by;
  }

  // Highlight down the spine
  c.strokeStyle = cfg.hi || 'rgba(255,255,255,0.5)';
  c.lineWidth = 1.1 * strength;
  c.globalAlpha = 0.5 * strength;
  c.beginPath();
  c.moveTo(sx, sy);
  c.quadraticCurveTo(cxp, cyp, tx, ty);
  c.stroke();

  // Droplets tumbling down the pour
  c.fillStyle = cfg.liq;
  c.globalAlpha = 0.62 * strength;
  for (var d = 0; d < 9; d++) {
    var dt = ((this.t * 1.6 + d / 9) % 1);
    var dx = (1 - dt) * (1 - dt) * sx + 2 * (1 - dt) * dt * cxp + dt * dt * tx;
    var dy = (1 - dt) * (1 - dt) * sy + 2 * (1 - dt) * dt * cyp + dt * dt * ty;
    var ds = (1.2 + Math.sin(d * 1.9 + this.t * 3) * 0.45) * strength;
    if (ds < 0.5) ds = 0.5;
    c.beginPath();
    c.arc(dx, dy, ds, 0, Math.PI * 2);
    c.fill();
  }

  // Small ripple ring at the pour's impact point on the rim
  if (strength > 0.35 && this.fillLevel > 0.04) {
    c.strokeStyle = cfg.hi || cfg.liq;
    c.globalAlpha = 0.45 * strength;
    c.lineWidth = 1;
    var ringR = 4 + Math.sin(this.t * 12) * 1.2;
    c.beginPath();
    c.ellipse(tx, ty + 1, ringR, 1.6, 0, 0, Math.PI * 2);
    c.stroke();
  }

  c.globalAlpha = 1;
  c.restore();
}

// Helper: given a liquid baseline y (in local glass coords) and a local x offset,
// returns the y of a *world-horizontal* surface line at that x. Used so the liquid
// stays level under gravity even while the glass is tilted.
_tiltedY(baseY, x) {
  return baseY - x * Math.tan(this.tiltAngle);
}

// Shared optical treatment for every buying-drink animation. Coordinates remain
// in the original 160x260 space; the backing canvas supplies Retina resolution.
_drawPint(c, cfg, lev) { this._drawVessel(c, cfg, lev, 'pint'); }
_drawTumbler(c, cfg, lev) { this._drawVessel(c, cfg, lev, 'rocks'); }
_drawWine(c, cfg, lev) { this._drawVessel(c, cfg, lev, 'wine'); }
_drawChampagne(c, cfg, lev) { this._drawVessel(c, cfg, lev, 'coupe'); }
_drawTallGlass(c, cfg, lev) { this._drawVessel(c, cfg, lev, 'tall'); }

_drawVessel(c, cfg, lev, kind) {
  var specs = {
    pint: {w:20, top:-100, bot:-4, depth:82, foot:18},
    rocks:{w:31, top:-74, bot:-11, depth:39, foot:28},
    wine: {w:19, top:-74, bot:-30, depth:22, foot:15},
    coupe:{w:29, top:-60, bot:-30, depth:24, foot:17},
    tall: {w:19, top:-84, bot:-6, depth:64, foot:18}
  };
  var s = specs[kind], w = s.w, top = s.top, bot = s.bot;
  var stemmed = kind === 'wine' || kind === 'coupe';
  var p = new Path2D();
  if (kind === 'pint') {
    p.moveTo(-20,-100); p.lineTo(-20,-78);
    p.bezierCurveTo(-27,-70,-23,-64,-21,-58); p.lineTo(-18,0);
    p.quadraticCurveTo(0,3,18,0); p.lineTo(21,-58);
    p.bezierCurveTo(23,-64,27,-70,20,-78); p.lineTo(20,-100);
  } else if (stemmed) {
    p.moveTo(-w,top);
    p.bezierCurveTo(kind === 'wine' ? -30 : -w, top+20, -17, bot, -3,bot);
    p.lineTo(3,bot);
    p.bezierCurveTo(17,bot,kind === 'wine' ? 30 : w,top+20,w,top);
  } else {
    p.moveTo(-w,top); p.lineTo(-s.foot,-3);
    p.quadraticCurveTo(-s.foot,1,-s.foot+4,1); p.lineTo(s.foot-4,1);
    p.quadraticCurveTo(s.foot,1,s.foot,-3); p.lineTo(w,top);
  }
  p.closePath();
  function rgba(hex,a) {
    return 'rgba('+parseInt(hex.slice(1,3),16)+','+parseInt(hex.slice(3,5),16)+','+parseInt(hex.slice(5,7),16)+','+a+')';
  }
  function ellipse(x,y,rx,ry) { c.beginPath(); c.ellipse(x,y,rx,ry,0,0,Math.PI*2); }
  c.save();
  // The far wall is visible through the liquid; a soft warm reflection gives
  // transparent material something to transmit against the dark card.
  c.save(); c.clip(p);
  var back = c.createLinearGradient(-w,0,w,0);
  back.addColorStop(0,'rgba(135,177,181,.13)');
  back.addColorStop(.23,'rgba(232,215,169,.09)');
  back.addColorStop(.56,'rgba(221,236,229,.015)');
  back.addColorStop(1,'rgba(125,174,187,.16)');
  c.fillStyle=back; c.fillRect(-40,top,80,-top+4);
  c.fillStyle='rgba(241,222,179,.10)'; c.fillRect(w*.43,top+5,2,-top-8);
  // Clip the liquid separately: bubbles, ice and depth shading cannot escape
  // above its counter-rotated, world-horizontal meniscus.
  var surface=bot-s.depth*Math.max(0,lev);
  var slope=Math.tan(this.tiltAngle);
  var liquid = new Path2D();
  liquid.moveTo(-50,surface+50*slope); liquid.lineTo(50,surface-50*slope);
  liquid.lineTo(50,bot); liquid.lineTo(-50,bot); liquid.closePath();
  c.save(); c.clip(liquid);
  var dark = /^(pint|stout|porter|mild)$/.test(this.type);
  var red = kind === 'wine';
  var density = dark ? .94 : red ? .79 : kind === 'tall' ? .26 : .56;
  var lg=c.createLinearGradient(-w,0,w,0);
  lg.addColorStop(0,rgba(cfg.hi,density*.54));
  lg.addColorStop(.23,rgba(cfg.liq,density*.85));
  lg.addColorStop(.56,rgba(cfg.liq,density));
  lg.addColorStop(.86,rgba(cfg.hi,density*.72));
  lg.addColorStop(1,rgba(cfg.hi,density*.4));
  c.fillStyle=lg; c.fillRect(-40,top,80,-top);
  var depth=c.createLinearGradient(0,surface,0,bot);
  depth.addColorStop(0,rgba(cfg.hi,.12)); depth.addColorStop(1,'rgba(8,4,1,.22)');
  c.fillStyle=depth; c.fillRect(-40,top,80,-top);
  if (kind === 'rocks' || kind === 'tall') {
    // Clear, irregular ice: thin illuminated edges and submerged facets.
    for(var i=0;i<3;i++) {
      var ix=(i%2 ? 8 : -8), iy=Math.min(bot-7,surface+9+i*12);
      c.save(); c.translate(ix,iy); c.rotate(i*.31-.23);
      var ice=new Path2D('M-7 -6 L4 -7 L8 -2 L6 7 L-6 6 Z');
      var ig=c.createLinearGradient(-7,-7,7,7);
      ig.addColorStop(0,'rgba(231,251,249,.30)'); ig.addColorStop(.45,'rgba(198,237,240,.05)'); ig.addColorStop(1,'rgba(200,230,232,.16)');
      c.fillStyle=ig; c.fill(ice); c.strokeStyle='rgba(235,255,255,.38)'; c.lineWidth=.65; c.stroke(ice);
      c.beginPath(); c.moveTo(-7,-6); c.lineTo(-3,-2); c.lineTo(8,-2); c.moveTo(-3,-2); c.lineTo(-6,6);
      c.strokeStyle='rgba(255,255,255,.18)'; c.stroke(); c.restore();
    }
  }
  if (kind === 'pint' || kind === 'coupe' || kind === 'tall') {
    for(var b=0;b<16;b++) {
      var travel=(this.t*(7+b%5*2)+b*6.7)%Math.max(1,s.depth*lev);
      var bx=Math.sin(b*8.3)*w*.72, by=bot-travel;
      c.strokeStyle='rgba(251,242,214,'+(dark ? .13 : .32)+')'; c.lineWidth=.45;
      ellipse(bx,by,.45+travel/100,.65+travel/110); c.stroke();
    }
  }
  c.restore();
  if (lev > .015) {
    c.save(); c.translate(0,surface); c.rotate(-this.tiltAngle);
    var foam = cfg.foam && kind === 'pint';
    ellipse(0,0,w+5,foam ? 3.2 : 1.6);
    c.fillStyle=foam ? cfg.foam : rgba(cfg.hi,.22); c.fill();
    c.strokeStyle=foam ? 'rgba(255,244,218,.4)' : 'rgba(255,236,202,.3)'; c.lineWidth=.65; c.stroke();
    if(foam) {
      for(var f=0;f<24;f++) {
        var fx=Math.sin(f*7.8)*(w+2), fy=Math.cos(f*3.2)*2;
        ellipse(fx,fy,.45+(f%3)*.2,.35+(f%3)*.15);
        c.strokeStyle='rgba(103,79,43,.19)'; c.lineWidth=.4; c.stroke();
      }
    }
    c.restore();
  }
  c.restore();
  // Front wall: edge refraction, broad softbox reflection and a thin highlight.
  c.save(); c.clip(p);
  var face=c.createLinearGradient(-w,0,w,0);
  face.addColorStop(0,'rgba(214,240,240,.34)'); face.addColorStop(.07,'rgba(199,234,238,.06)');
  face.addColorStop(.15,'rgba(255,246,223,.21)'); face.addColorStop(.23,'rgba(255,246,223,.02)');
  face.addColorStop(.78,'rgba(199,233,240,0)'); face.addColorStop(.94,'rgba(209,234,244,.13)'); face.addColorStop(1,'rgba(225,245,247,.32)');
  c.fillStyle=face; c.fillRect(-40,top,80,-top+4);
  if (!stemmed) {
    var base=c.createLinearGradient(0,bot,0,2);
    base.addColorStop(0,'rgba(229,246,240,.25)'); base.addColorStop(.35,'rgba(144,187,198,.05)'); base.addColorStop(.82,'rgba(239,240,217,.24)'); base.addColorStop(1,'rgba(132,181,193,.10)');
    c.fillStyle=base; c.fillRect(-w,bot,2*w,-bot+3);
  }
  c.restore();
  c.strokeStyle='rgba(189,219,223,.32)'; c.lineWidth=.65; c.stroke(p);
  // Paired elliptical rim edges supply visible glass thickness.
  ellipse(0,top,w,2.6); c.fillStyle='rgba(202,228,229,.035)'; c.fill();
  c.strokeStyle='rgba(221,238,235,.58)'; c.lineWidth=.8; c.stroke();
  ellipse(0,top+.65,w-1.3,1.6); c.strokeStyle='rgba(163,201,204,.25)'; c.lineWidth=.55; c.stroke();
  c.beginPath(); c.ellipse(0,top,w,2.6,0,.12,Math.PI*.8);
  c.strokeStyle='rgba(255,248,226,.77)'; c.lineWidth=.75; c.stroke();
  if (stemmed) {
    var sg=c.createLinearGradient(-2,0,2,0);
    sg.addColorStop(0,'rgba(180,217,224,.12)'); sg.addColorStop(.45,'rgba(244,251,240,.62)'); sg.addColorStop(1,'rgba(143,181,194,.13)');
    c.fillStyle=sg; c.fillRect(-1.7,bot,3.4,-bot);
    ellipse(0,1,s.foot,3.1); c.fillStyle='rgba(199,223,223,.075)'; c.fill();
    c.strokeStyle='rgba(215,236,232,.4)'; c.lineWidth=.65; c.stroke();
    c.beginPath(); c.ellipse(0,1,s.foot-2,2,0,.2,2.5); c.strokeStyle='rgba(255,243,214,.43)'; c.stroke();
  }
  if (kind === 'tall' || (kind === 'pint' && !dark)) {
    for(var d=0;d<9;d++) {
      var dx=Math.sin(d*5.7)*w*.8, dy=top+16+(d*13)%(-top-25);
      ellipse(dx,dy,.65,.95); c.fillStyle='rgba(10,16,17,.16)'; c.fill();
      c.strokeStyle='rgba(224,247,245,.27)'; c.lineWidth=.4; c.stroke();
    }
  }
  if (kind === 'tall') {
    // Translucent citrus flesh with a darker peel, seated across the rim.
    c.save(); c.translate(w-2,top); c.rotate(-.35);
    c.beginPath(); c.moveTo(0,0); c.arc(0,0,10,Math.PI,Math.PI*1.9); c.closePath();
    c.fillStyle='rgba(165,188,76,.68)'; c.fill();
    c.strokeStyle='rgba(93,125,41,.9)'; c.lineWidth=1.5; c.stroke();
    c.beginPath(); c.arc(0,0,8,Math.PI,Math.PI*1.9);
    c.strokeStyle='rgba(232,236,166,.72)'; c.lineWidth=.7; c.stroke();
    for(var seg=0;seg<4;seg++) {
      var angle=Math.PI+.25+seg*.65;
      c.beginPath(); c.moveTo(0,0); c.lineTo(Math.cos(angle)*7,Math.sin(angle)*7);
      c.strokeStyle='rgba(244,241,186,.42)'; c.lineWidth=.5; c.stroke();
    }
    c.restore();
  }
  c.restore();
}

};

// Global helper to show drink popup from passage scripts
window.showDrinkPopup = function(drinkType) {
  new window.DrinkPopup(drinkType);
};


// Musicians -> bar instructions in their own card -> Start -> the live game.
window.dssOpenBarInstructions = function(){
 if(document.querySelector('.dss-bar-rules-modal'))return;
 var arena=document.getElementById('bar-arena');if(!arena)return;
 var marker=document.createElement('span');marker.hidden=true;arena.parentNode.insertBefore(marker,arena);
 var overlay=document.createElement('div');overlay.className='dss-bar-rules-modal';overlay.setAttribute('role','dialog');overlay.setAttribute('aria-modal','true');overlay.setAttribute('aria-label','The bar: how to play');
 var back=document.createElement('button');back.className='bar-rules-back';back.textContent='Back';back.type='button';
 arena.style.display='block';arena.insertBefore(back,arena.firstChild);overlay.appendChild(arena);document.body.appendChild(overlay);
 var from=document.getElementById('bar-instructions-btn'),watch;
 function close(starting){
  clearInterval(watch);document.removeEventListener('keydown',onKey,true);
  if(marker.isConnected){marker.parentNode.insertBefore(arena,marker);marker.remove();arena.style.display=starting?'block':'none';}back.remove();overlay.remove();
  if(!starting&&from&&from.isConnected)from.focus();
 }
 function onKey(ev){if(ev.key==='Escape'){ev.preventDefault();ev.stopPropagation();close(false);return;}if(ev.key==='Tab'){var first=back,last=document.getElementById('bar-start-btn');if(ev.shiftKey&&document.activeElement===first){ev.preventDefault();last.focus();}else if(!ev.shiftKey&&document.activeElement===last){ev.preventDefault();first.focus();}}}
 overlay._start=function(){close(true);if(from)from.style.display='none';};back.onclick=function(){close(false);};overlay.addEventListener('click',function(ev){if(ev.target===overlay)close(false);});document.addEventListener('keydown',onKey,true);
 watch=setInterval(function(){if(!marker.isConnected){clearInterval(watch);document.removeEventListener('keydown',onKey,true);overlay.remove();}},300);
 var start=document.getElementById('bar-start-btn');if(start)start.focus({preventScroll:true});arena.scrollTop=0;
};
window.startBarGame = function() {
var introModal=document.querySelector('.dss-bar-rules-modal');if(introModal&&introModal._start)introModal._start();
/* 2026-10-14 overnight: the inline onclick and the delegated listener below both fire on one click; the second call is dropped */
var _bsNow = Date.now(); if (window._barStartAt && _bsNow - window._barStartAt < 400) return; window._barStartAt = _bsNow;
if (window.currentBarGame) window.currentBarGame.stop();
document.getElementById('pre-bar').classList.add('hidden');
var sobriety = parseInt(document.getElementById('sob-data-bar').textContent) || 55;
var canvas = document.getElementById('bar-canvas');
canvas.style.display = 'block';
requestAnimationFrame(function(){if(canvas.isConnected){canvas.scrollIntoView({block:'center',behavior:'auto'});canvas.tabIndex=0;canvas.focus({preventScroll:true});}});
canvas.classList.remove('success-flash', 'error-flash');
window.currentBarGame = new window.BarGame('bar-canvas', sobriety);
// The Ronnie Scott's passage doubles as the venue (Firebird-jazz bed) AND the
// bar-canvas minigame container. The POUR phase keeps the venue's Firebird-jazz
// bed playing — it is deliberately NOT stopped here. Only the drinks-CARRY
// platform phase swaps to the jazzmini loop; that handoff lives in
// _startCarryTransition, which stops the Firebird bed and starts jazzmini. The
// MutationObserver below stops jazzmini on navigation, and the venue-ronnies
// tag-match restores the Firebird bed at Bar Canvas Win/Lose.
if (window.dssAudio) {
  if (window.dssAudio.stopBed) { try { window.dssAudio.stopBed('minigame-retro'); } catch(e) {} }
}
if (window._jazzMiniEl) { try { window._jazzMiniEl.pause(); window._jazzMiniEl.src=''; window._jazzMiniEl=null; } catch(e) {} }
if (window._jazzMiniMuteWatcher) { try { clearInterval(window._jazzMiniMuteWatcher); } catch(e) {} window._jazzMiniMuteWatcher = null; }
var _jmObs = new MutationObserver(function(mutations) {
  for (var m = 0; m < mutations.length; m++) {
    for (var n = 0; n < mutations[m].addedNodes.length; n++) {
      var nd = mutations[m].addedNodes[n];
      if (nd.nodeType === 1 && nd.tagName === 'TW-PASSAGE') {
        if (window._jazzMiniEl) { window._jazzMiniEl.pause(); window._jazzMiniEl.src=''; window._jazzMiniEl=null; }
        if (window._jazzMiniMuteWatcher) { try { clearInterval(window._jazzMiniMuteWatcher); } catch(e) {} window._jazzMiniMuteWatcher = null; }
        _jmObs.disconnect(); return;
      }
    }
  }
});
_jmObs.observe(document.body, { childList: true, subtree: true });
};
// Delegated click listener as backup for inline onclick
document.addEventListener('click', function(e) {
if (e.target && e.target.id === 'bar-start-btn') window.startBarGame();
if (e.target && e.target.id === 'fight-start-btn') window.startFightGame();
});

// ====== PASSAGE GENERATION GUARD ======
// Tracks passage navigation so scheduled popups can be cancelled if the player moves on.
// 2026-10-12 (Sam, the overnight list items 1-2): a phone that rings the moment you walk in covered the room's
// opening words (AOIFE's ring over the Pillars verse, LILY's second ring over the Coach's opening box). When a
// ringing card arrives beside words of the room's own, it is held back (.ring-wait) for a reading beat, about
// 2 s plus 30 ms a character, at most 7 s (a room's name alone, about 2.5 s), or until the room's opening box is
// closed; then it rings as before. A card with nothing beside it rings at once.
// THE LORE AS FOOTNOTES (2026-10-13, Sam: the 'Lore' passages "seem like something from an older version of the game now";
// his choice, footnotes). The passages are unchanged: each (link: "⟡ LORE: Title ⟡") is hidden and a small dagger is set at
// the end of the sentence before it; the dagger, or a room object's button that holds the same link, presses the link,
// and what it reveals (his words, Harlowe's own hook) is lifted into a note card headed with the title. Closing the card
// keeps the note; the dagger opens it again.
window.dssLore = (function() {
  var RX = /^\s*(?:⟡\s*)?LORE:\s*/; // the links' ornament script takes the ⟡ off their text
  function isLore(t) { return RX.test(t || ''); }
  function titleOf(t) { return String(t || '').replace(RX, '').replace(/\s*⟡\s*$/, '').trim(); }
  var notes = {};
  /* 2026-10-28 (Sam, playtest notes 34/35; his ruling: "the lore front and centre", the rumour treatment): the words of every note
     opened are kept (localStorage dssLoreText) so the NOTEBOOK's LORE section can print them in full; and a note opens on its own the
     first time its sentence is on screen (dssLoreAuto, once per browser), after a reading beat, with the darker scrim and a button at
     its foot. Its ⟡ LORE mark still reopens it. A note that only a room card carries keeps to the card. */
  var KEYT = 'dssLoreText', KEYA = 'dssLoreAuto', autoFirst = null;
  function kept() { try { return JSON.parse(localStorage.getItem(KEYT) || '{}') || {}; } catch (e) { return {}; } }
  function remember(t, html) { try { var k = kept(); if (k[t]) return; k[t] = html; localStorage.setItem(KEYT, JSON.stringify(k)); } catch (e) {} }
  /* 2026-10-29 nightwork: $loreRead starts empty each night (a night restarts the story), so on night 2 the NOTEBOOK's LORE was bare. Each
     opening is also logged with its night (dssLoreReadLog), and the notebook shows every note read since the run's first night, as the
     rejection slips do (dssRunFirst). */
  var KEYL = 'dssLoreReadLog';
  function nightNow() { try { return +localStorage.getItem('dssNightNo') || 0; } catch (e) { return 0; } }
  function runFirst() { try { return +localStorage.getItem('dssRunFirst') || 0; } catch (e) { return 0; } }
  function readLog() { try { return (JSON.parse(localStorage.getItem(KEYL) || '[]') || []).filter(function(r) { return r && r.t; }); } catch (e) { return []; } }
  function logRead(t) { try { var a = readLog(), f = runFirst(); if (a.some(function(r) { return r.t === t && r.n >= f; })) return; a.push({ t: t, n: nightNow() }); localStorage.setItem(KEYL, JSON.stringify(a)); } catch (e) {} }
  function autoDone(t) { try { return (JSON.parse(localStorage.getItem(KEYA) || '[]') || []).indexOf(t) >= 0; } catch (e) { return true; } }
  function autoMark(t) { try { var a = JSON.parse(localStorage.getItem(KEYA) || '[]') || []; if (a.indexOf(t) < 0) a.push(t); localStorage.setItem(KEYA, JSON.stringify(a)); } catch (e) {} }
  function seen(el) { if (!el || !el.isConnected || !el.getClientRects().length) return false; var r = el.getBoundingClientRect(); if (r.bottom < 0 || r.top > innerHeight) return false; for (var e = el; e && e.nodeType === 1; e = e.parentElement) { var cs = getComputedStyle(e); if (cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.6) return false; } return true; }
  function held_busy() { return !!((window.dssOverlayBusy && window.dssOverlayBusy()) || document.querySelector('#dss-lore-overlay, tw-dialog, .phone-ringing:not(.ring-wait), .phone-scene, .dss-slip-fly, .dss-refusal:not(.dss-filed), .dss-rules-overlay')); }
  /* a note a room card carries (the paperback at the French, the entry at Ronnie's, the Ham's card): the card is its sentence; it opens
     after the beat once that card is looked at, by pressing the card's own lore button */
  function norm(x) { return String(x || '').replace(/⟡/g, ' ').replace(/^\s*LORE\s*[:·]?\s*/i, ' ').replace(/\s+/g, ' ').trim().toLowerCase(); }
  function cardBtn(t) { return Array.prototype.filter.call(document.querySelectorAll('.dss-room-card .fi-action, .dss-room-card button'), function(b) { return norm(b.textContent) === norm(t) && !b.closest('.dss-ghost') && seen(b); })[0] || null; }
  function autoOpenCard(l, t) {
    if (autoDone(t)) return;
    var gen = null, at = 0; setTimeout(function() { gen = window._passageGen; }, 150);
    var poll = setInterval(function() {
      if (!l.isConnected || (gen !== null && window._passageGen !== gen) || autoDone(t)) { clearInterval(poll); return; }
      var b = cardBtn(t);
      if (!b || held_busy()) { at = 0; return; }
      if (!at) { at = Date.now(); return; }
      clearInterval(poll); owe(l, t); /* 2026-10-29: owed, not opened (see owe) */
    }, 300);
  }
  function autoOpen(l, t, fn) {
    if (autoDone(t)) return;
    var gen = null, at = 0; setTimeout(function() { gen = window._passageGen; }, 150);
    var poll = setInterval(function() {
      if (!fn.isConnected || (gen !== null && window._passageGen !== gen) || autoDone(t)) { clearInterval(poll); return; }
      if (!seen(fn) || held_busy()) { at = 0; return; }
      if (!at) { at = Date.now(); return; }
      clearInterval(poll); owe(l, t);
    }, 300);
  }
  /* 2026-10-29 (Sam, playtest notes 1 and 5: "This lore popup is what I want but it shouldn't just happen automatically, it should be part of the
     regular chain of pressing steps. This should occur in all similar instances"): a note seen for the first time is owed, not opened on a timer.
     The player's next onward press on that page (a link in the words, or a room card's button) opens it first, as the card with On.; On. (or ×,
     or Escape) then carries the press on. Once a browser, as before; its ⟡ LORE mark still opens it any time. */
  var owed = [], passing = false;
  function owe(l, t) { if (autoDone(t) || owed.some(function(o) { return o.t === t; })) return; owed.push({ l: l, t: t, gen: window._passageGen }); }
  document.addEventListener('click', function(ev) {
    if (passing || !ev.isTrusted || !owed.length) return;
    var el = ev.target && ev.target.closest && ev.target.closest('tw-link, .fi-action'); if (!el) return;
    if (el._dssLoreNext || el.classList.contains('fi-lore-btn') || isLore(el.textContent) || el.closest('#dss-lore-overlay, .stat-bars, #stat-bars-lifted, tw-header, .dss-ghost, .lore-hidden-link')) return;
    owed = owed.filter(function(o) { return o.gen === window._passageGen && !autoDone(o.t) && (notes[o.t] || o.l.isConnected); });
    var o = owed.shift(); if (!o) return;
    ev.preventDefault(); ev.stopImmediatePropagation();
    autoMark(o.t); autoFirst = o.t;
    thenDo = function() { setTimeout(function() { if (!el.isConnected) return; passing = true; try { el.click(); } finally { passing = false; } }, 260); };
    open(o.l);
  }, true);
  setInterval(function() {
    Array.prototype.forEach.call(document.querySelectorAll('.nb-lore-notes:not([data-filled])'), function(b) {
      b.setAttribute('data-filled', '1'); var k = kept(), gw = document.getElementById('dss-lore-greatwork'), f = runFirst(), names = [];
      readLog().filter(function(r) { return r.n >= f; }).forEach(function(r) { if (names.indexOf(r.t) < 0) names.push(r.t); });
      (b.getAttribute('data-read') || '').split('|').filter(Boolean).forEach(function(t) { if (names.indexOf(t) < 0) names.push(t); });
      var sec = b.closest('.nb-lore-section'); if (sec) sec.hidden = !names.some(function(t) { return k[t] || (t === 'The Great Work' && gw); });
      names.forEach(function(t) {
        var html = k[t] || (t === 'The Great Work' && gw ? gw.innerHTML : null); if (!html) return;
        var n = document.createElement('div'); n.className = 'nb-lore-note';
        n.innerHTML = '<div class="nb-lore-title">\u27e1 ' + t.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</div><div class="nb-lore-text dss-lore-body"></div>';
        var body = n.lastChild; body.innerHTML = html;
        Array.prototype.forEach.call(body.querySelectorAll('script, style'), function(e) { e.parentNode.removeChild(e); });
        (function trim(el) { while (el.firstChild && ((el.firstChild.nodeType === 3 && !el.firstChild.nodeValue.trim()) || /^(BR|TW-CONSECUTIVE-BR)$/.test(el.firstChild.tagName || ''))) el.removeChild(el.firstChild); if (el.firstChild && el.firstChild.nodeType === 1 && /^(DIV|P|TW-HOOK)$/.test(el.firstChild.tagName)) trim(el.firstChild); })(body);
        Array.prototype.forEach.call(body.querySelectorAll('[style]'), function(e) { e.style.removeProperty('opacity'); e.style.removeProperty('transition'); e.style.removeProperty('display'); });
        if (body.querySelector('.lore-box > strong')) n.firstChild.style.display = 'none';
        b.appendChild(n);
      });
    });
  }, 300);
  function close() { var o = document.getElementById('dss-lore-overlay'); if (o) { o.classList.add('out'); setTimeout(function() { if (o.parentNode) o.parentNode.removeChild(o); }, 250); } }
  function show(title) {
    var held = notes[title]; if (!held) return;
    close(); logRead(title);
    var auto = (autoFirst === title); autoFirst = null;
    var o = document.createElement('div'); o.id = 'dss-lore-overlay'; if (auto) o.className = 'dss-lore-auto';
    var c = document.createElement('div'); c.className = 'dss-lore-card'; c.setAttribute('role', 'dialog'); c.setAttribute('aria-label', title);
    var x = document.createElement('button'); x.type = 'button'; x.className = 'dss-lore-x'; x.setAttribute('aria-label', 'Close'); x.textContent = '×';
    var h = document.createElement('div'); h.className = 'dss-lore-title'; h.textContent = '⟡ ' + title;
    var b = document.createElement('div'); b.className = 'dss-lore-body'; b.appendChild(held);
    if (held.querySelector('.lore-box > strong')) h.style.display = 'none'; // the note carries its own heading (his): no second one
    c.appendChild(x); c.appendChild(h); c.appendChild(b);
    var after = thenDo; thenDo = null;
    function done() { if (held.parentNode === b) b.removeChild(held); close(); document.removeEventListener('keydown', onKey, true); if (after) after(); }
    if (auto) { var on = document.createElement('button'); on.type = 'button'; on.className = 'dss-lore-on'; on.textContent = 'On.'; on.addEventListener('click', function(ev) { ev.stopPropagation(); done(); }); c.appendChild(on); setTimeout(function() { try { on.scrollIntoView({ block: 'nearest' }); } catch (e) {} }, 60); }
    o.appendChild(c); document.body.appendChild(o);
    function onKey(ev) { if (ev.key === 'Escape') { ev.stopPropagation(); done(); } }
    x.addEventListener('click', done);
    o.addEventListener('click', function(ev) { if (ev.target === o && !auto) done(); });
    document.addEventListener('keydown', onKey, true);
    requestAnimationFrame(function() { o.classList.add('in'); try { x.focus({ preventScroll: true }); } catch (e) {} });
  }
  // a LORE link pressed (its dagger, or a room card's button): gather what it reveals into the note, then show the card
  document.addEventListener('click', function(ev) {
    var l = ev.target && ev.target.closest && ev.target.closest('tw-link');
    if (!l || !isLore(l.textContent)) return;
    var t = titleOf(l.textContent), hook = l.parentElement;
    if (notes[t]) { ev.preventDefault(); ev.stopImmediatePropagation(); show(t); return; }
    setTimeout(function() {
      if (!hook || !hook.isConnected) return;
      var frag = document.createElement('div'); frag.className = 'dss-lore-held';
      Array.prototype.slice.call(hook.childNodes).forEach(function(n) { if (!(n.nodeType === 1 && n.tagName === 'TW-LINK')) frag.appendChild(n); });
      hook.style.display = 'none';
      notes[t] = frag; remember(t, frag.innerHTML); show(t);
    }, 80);
  }, true);
  function placeDagger(l) {
    if (l._dssLore) return; l._dssLore = true;
    var t = titleOf(l.textContent), wrap = l.closest('tw-expression') || l.parentElement || l;
    if (l.closest('.lore-card-only')) { wrap.classList.add('lore-hidden-link'); if (!l.closest('.dss-ghost')) autoOpenCard(l, t); return; } /* 2026-10-21 (Sam): the Great Ham's lore comes only from his card; no footnote in the room's words */
    if (l.classList.contains('dss-claimed') || l.closest('.dss-claimed, .dss-claimed-wrap')) { if (!l.closest('.dss-ghost')) autoOpenCard(l, t); return; } // a room object's card carries it
    var fn = document.createElement('span'); fn.className = 'lore-fn'; fn.innerHTML = '⟡<span class="lore-fn-word">LORE</span>'; /* Sam: the dagger alone didn't say what it was. 2026-10-19 (Sam): the dagger read as an up arrow; the lore's own ⟡. (A // comment here had switched off the title, role and tab stop after it.) */ fn.title = t; fn.setAttribute('role', 'button'); fn.tabIndex = 0; fn.setAttribute('aria-label', 'Note: ' + t);
    fn.addEventListener('click', function(ev) { ev.stopPropagation(); if (notes[t]) show(t); else if (l.isConnected) l.click(); });
    fn.addEventListener('keydown', function(ev) { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); fn.click(); } });
    // the end of the sentence before the link: skip line breaks and blank text back to the last words
    // (skip line breaks, scripts and anything without words, then sit after the last words inside what is found)
    function lastWords(el) { var w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), last = null; while (w.nextNode()) { var tn = w.currentNode; if (tn.nodeValue.trim() && !tn.parentNode.closest('script, style, tw-link, svg, [hidden]')) last = tn; } return last; }
    var prev = wrap.previousSibling, spot = null;
    while (prev && !spot) {
      if (prev.nodeType === 3 && prev.nodeValue.trim()) spot = prev;
      else if (prev.nodeType === 1 && !/^(SCRIPT|STYLE|SVG|TW-LINK|BUTTON)$/i.test(prev.tagName) && !prev.classList.contains('lore-hidden-link')) spot = lastWords(prev);
      if (!spot) prev = prev.previousSibling;
    }
    if (spot) spot.parentNode.insertBefore(fn, spot.nextSibling);
    else wrap.parentNode.insertBefore(fn, wrap);
    wrap.classList.add('lore-hidden-link');
    if (!fn.closest('.dss-ghost')) autoOpen(l, t, fn);
  }
  function scan() { Array.prototype.forEach.call(document.querySelectorAll('tw-link'), function(l) { if (isLore(l.textContent)) placeDagger(l); }); }
  var q = false;
  function watch() { new MutationObserver(function() { if (q) return; q = true; setTimeout(function() { q = false; scan(); }, 60); }).observe(document.body, { childList: true, subtree: true }); }
  if (document.body) watch(); else document.addEventListener('DOMContentLoaded', watch);
  // 2026-10-19 (Sam, playtest): a room card's lore button opens the note and leaves the card up, so closing the note goes back to the card
  function open(l) { var t = titleOf(l.textContent); if (notes[t]) show(t); else if (l.isConnected) l.click(); }
  /* 2026-10-29 (Sam: Chariots of the Gods at the French "should appear, the first time, not as an optional lore link but as a second card before you go back to the bar"):
     a room card's note opened as the card after it, once per browser like the other first openings; its On. (or ×, or Escape) runs the step after */
  var thenDo = null;
  function openNext(l, then) { var t = titleOf(l.textContent); autoMark(t); autoFirst = t; thenDo = then || null; open(l); }
  /* 2026-10-19: a note held in the page rather than behind a link (THE GREAT WORK, printed hidden by the header) */
  function showFrom(title, src) { if (!notes[title] && src) { var frag = document.createElement('div'); frag.className = 'dss-lore-held'; frag.innerHTML = src.innerHTML; Array.prototype.forEach.call(frag.querySelectorAll('[style]'), function(e) { e.style.removeProperty('opacity'); e.style.removeProperty('transition'); }); remember(title, frag.innerHTML); notes[title] = frag; } show(title); } /* (overnight: no inline opacity carried into the card) */
  return { scan: scan, show: show, isLore: isLore, open: open, showFrom: showFrom, openNext: openNext, firstDone: function(t) { return autoDone(titleOf(t)); } };
})();
/* 2026-10-19 (Sam: explain the alchemy, "4 plus 3"). THE WHEEL IN THE NOTEBOOK and THE GREAT WORK NOTE.
   The notebook's HAUNTS opens on the wheel the Dawn draws (dssOpusReveal), small and in ink: Ripley's twelve gates clockwise
   from the top, a gate gilded with its numeral once its haunt is caught; the list under it is put in the wheel's order and numbered.
   A ⟡ LORE mark on the HAUNTS heading, and on "The work" line of the night's first haunt, opens the note card THE GREAT WORK
   (Sam's words, the passage Lore The Great Work, printed hidden in the header as #dss-lore-greatwork). */
(function() {
  var GATES = [['Calcinatio', 'The Sketch'], ['Solutio', 'The Refusal'], ['Separatio', 'The Sorting'], ['Coniunctio', 'The Debt'], ['Putrefactio', 'The Beast'], ['Congelatio', 'The Head'], ['Cibatio', 'The Feeding'], ['Sublimatio', 'The Delivery'], ['Fermentatio', 'The Game'], ['Exaltatio', 'The Crown'], ['Multiplicatio', 'The Spread'], ['Projectio', 'The Wound']]; /* dssOpusReveal's order */
  var ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
  var NOTE = 'The Great Work';
  function openNote() { var src = document.getElementById('dss-lore-greatwork'); if (src && window.dssLore && window.dssLore.showFrom) window.dssLore.showFrom(NOTE, src); try { var gw = Array.prototype.filter.call(document.querySelectorAll('.dss-gw-read tw-link'), function(l) { return !l.closest('.dss-ghost'); }).pop(); if (gw) gw.click(); } catch (e) {} /* 2026-10-28 (notes 34/35): the read is stamped through the header's hidden link */ }
  function mark() {
    var fn = document.createElement('span'); fn.className = 'lore-fn dss-gw-fn'; fn.innerHTML = '⟡<span class="lore-fn-word">LORE</span>';
    fn.title = NOTE; fn.setAttribute('role', 'button'); fn.tabIndex = 0; fn.setAttribute('aria-label', 'Note: ' + NOTE);
    fn.addEventListener('click', function(ev) { ev.preventDefault(); ev.stopPropagation(); openNote(); });
    fn.addEventListener('keydown', function(ev) { if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); ev.stopPropagation(); openNote(); } });
    return fn;
  }
  function itemName(el) { var t = el.cloneNode(true); Array.prototype.forEach.call(t.querySelectorAll('.hp, .haunt-stage, .nb-gate-num'), function(x) { x.parentNode.removeChild(x); }); return t.textContent.replace(/\s+/g, ' ').trim(); }
  function pt(r, a) { return (120 + r * Math.cos(a)).toFixed(1) + ' ' + (120 + r * Math.sin(a)).toFixed(1); }
  function wheelSVG(lit) {
    var rO = 104, rI = 70, n = lit.filter(Boolean).length;
    var s = '<svg class="nb-wheel-svg" viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The wheel: ' + n + ' of twelve gates lit">';
    for (var i = 0; i < 12; i++) {
      var a0 = (-105 + i * 30) * Math.PI / 180, a1 = (-75 + i * 30) * Math.PI / 180, am = (-90 + i * 30) * Math.PI / 180;
      s += '<path class="nb-gate' + (lit[i] ? ' nb-gate-lit' : '') + '" d="M' + pt(rI, a0) + ' L' + pt(rO, a0) + ' A' + rO + ' ' + rO + ' 0 0 1 ' + pt(rO, a1) + ' L' + pt(rI, a1) + ' A' + rI + ' ' + rI + ' 0 0 0 ' + pt(rI, a0) + ' Z"/>';
      s += '<text class="nb-gate-n' + (lit[i] ? ' nb-gate-n-lit' : '') + '" x="' + (120 + 87 * Math.cos(am)).toFixed(1) + '" y="' + (120 + 87 * Math.sin(am) + 3.4).toFixed(1) + '" text-anchor="middle">' + ROMAN[i] + '</text>';
    }
    s += '<circle class="nb-wheel-rim" cx="120" cy="120" r="' + (rO + 4) + '"/><circle class="nb-wheel-ring" cx="120" cy="120" r="' + rI + '"/><circle class="nb-wheel-ring" cx="120" cy="120" r="30"/>';
    /* Sol, as at the Dawn: twelve rays, the three at 12, 4 and 8 o'clock short */
    s += '<g class="nb-sol"><circle cx="120" cy="120" r="7"/><circle class="nb-sol-dot" cx="120" cy="120" r="1.8"/>';
    for (var r = 0; r < 12; r++) { var ra = (r * 30 - 90) * Math.PI / 180; s += '<line x1="' + (120 + 10 * Math.cos(ra)).toFixed(1) + '" y1="' + (120 + 10 * Math.sin(ra)).toFixed(1) + '" x2="' + (120 + (r % 4 === 0 ? 15 : 22) * Math.cos(ra)).toFixed(1) + '" y2="' + (120 + (r % 4 === 0 ? 15 : 22) * Math.sin(ra)).toFixed(1) + '"/>'; }
    return s + '</g></svg>';
  }
  function build(sec) {
    sec.setAttribute('data-wheel', '1');
    var items = Array.prototype.slice.call(sec.querySelectorAll(':scope > .nb-item, :scope > .nb-grey'));
    if (!items.length) return;
    var byName = {}; items.forEach(function(el) { byName[itemName(el)] = el; });
