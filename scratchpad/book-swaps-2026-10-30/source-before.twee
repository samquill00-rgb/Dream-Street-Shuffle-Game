    var brass = new THREE.MeshStandardMaterial({ color: 0xb08a40, roughness: 0.3, metalness: 0.9 });
    var rail = cyl(0.03, 0.03, 10, 8, brass, 0, 0.22, -11.45); rail.rotation.z = Math.PI / 2;
    for (var rx = -4.5; rx <= 4.5; rx += 1.5) box(0.04, 0.22, 0.06, brass, rx, 0.11, -11.5, { cast: false });
    // pumps with clips
