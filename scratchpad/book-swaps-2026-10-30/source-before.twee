  function seen(el) { if (!el || !el.getClientRects().length) return false; for (var e = el; e && e.nodeType === 1; e = e.parentElement) { var cs = getComputedStyle(e); if (cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.6) return false; } return true; }
  // 2026-10-23 (the first-night map): it opened over whatever else was up; now it also waits its turn behind any other
