  var watch = setInterval(function() { if (gen === null) return; if (window._passageGen !== gen || !root.isConnected) { clearInterval(watch); timers.forEach(clearTimeout); document.removeEventListener('pointerdown', skip, true); document.removeEventListener('keydown', skip, true); } }, 500);
