var cbPanelB = new THREE.Mesh(new THREE.BoxGeometry(0.45, 0.63, 0.025), cbPanelMat);
cbPanelB.position.set(0, 0.305, -0.078);
cbPanelB.rotation.x = 0.25;
cbGroup.add(cbPanelB);
