if (keysRow) keysRefresh();
card.style.transform = 'translate(' + cardX() + ', 0)';
if (VOICE) { VOICE.meet(ROOM, spot.name); VOICE.look(ROOM, spot.name); }
}
// the flower taken from its card (2026-10-07, Sam: "it should just show the fact that it's collected ... it
// should take you back to the bar", then "it should be a distinct modal"): the passage's own glimpse line,
