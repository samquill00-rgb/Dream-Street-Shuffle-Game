  return cv;
}

// ---- reading the hub ----
function labelFromGrey(txt) {
  var m = txt.match(/\[([^\]]+)\]/);
  if (!m) return 'Not tonight.';
  var l = m[1].trim().toLowerCase();
  return l.charAt(0).toUpperCase() + l.slice(1) + '.';
}
// THE LEDGER PIPS THAT FOLLOW A DOOR'S LINK (◆◇ haunts, ❀❁ flowers, ▲△ words,
// ★☆ page, ✦✧ alba). This walked link.nextSibling and ALWAYS RETURNED EMPTY:
// Harlowe wraps every link in its own <tw-expression>, so the tw-link has no
// siblings at all, and the pips are not siblings of the wrapper either — they
// sit further along INSIDE the same branch hook that holds the link. So the map
// never had any marks to show, on the door plates or in the caption bar (Sam,
// 2026-09-15: "the 'small marks beside each door' are unclear; I can't really
// see what that refers to" — they were only ever visible in the docked list,
// which is parked off-screen). Found with the real DOM in front of me.
//
// Position, not sibling order: take the branch hook the anchor sits in, then
// every pip inside it that comes AFTER this anchor and BEFORE the next one.
// The anchor is a tw-link for an open door and a .greyed-out span for a shut
// one, hence the combined selector. Hooks whose condition was false render no
// content, so a hidden branch contributes nothing.
function glyphsAfter(link) {
  var LEDGER_ON = false; /* 2026-10-24 (Sam: "cut the map's ledger marks and the ledger slip"): no marks on the door plates or the caption bar; true brings them back */
  if (!LEDGER_ON) return '';
  if (!link || !link.compareDocumentPosition) return '';
  var scope = link.parentElement;
  while (scope && scope.tagName !== 'TW-HOOK' && scope.tagName !== 'TW-PASSAGE') scope = scope.parentElement;
  if (!scope) return '';
  var FOLLOWING = 4;   // Node.DOCUMENT_POSITION_FOLLOWING
  var anchors = scope.querySelectorAll('tw-link, .greyed-out'), next = null;
  for (var i = 0; i < anchors.length; i++) {
    if (anchors[i] === link) { next = anchors[i + 1] || null; break; }
  }
  var out = '', pips = scope.querySelectorAll('span.hp, span.op, span.pp, span.lp, span.al, span.qp');
  for (var j = 0; j < pips.length; j++) {
    var s = pips[j];
    if (!(link.compareDocumentPosition(s) & FOLLOWING)) continue;          // sits before this door
    if (next && (next.compareDocumentPosition(s) & FOLLOWING)) continue;   // belongs to the next door
    out += s.outerHTML;
  }
  return out;
}
function leadOf(link) {
  var h = link.parentElement; while (h && h !== document.body && h.tagName !== 'TW-HOOK') h = h.parentElement;
  if (!h || h.tagName !== 'TW-HOOK' || h.querySelectorAll('tw-link').length !== 1) return '';
  var clone = h.cloneNode(true);
  Array.prototype.forEach.call(clone.querySelectorAll('tw-link, script, style, span.hp, span.pp, span.lp, span.al, span.qp, .greyed-out'), function(n){ if (n.parentNode) n.parentNode.removeChild(n); });
  var t = (clone.textContent || '').replace(/\s+/g, ' ').trim();
  if (!/[A-Za-z]{2}/.test(t) || t.length > 140) return '';
  return t;
}
function scanHub(passage) {
  var doors = {}, hooks = [], guided = '', lead = '';
  DOORS.forEach(function(d){ doors[d.id] = { status:'shut', link:null, label:'', glyphs:'', lead:'' }; });
  function noteHook(el) { var h = null, cur = el; while (cur && cur !== passage) { if (cur.tagName === 'TW-HOOK') h = cur; cur = cur.parentElement; } if (h && hooks.indexOf(h) < 0) hooks.push(h); }
  var links = passage.querySelectorAll('tw-link');
  for (var i = 0; i < links.length; i++) {
    var txt = (links[i].textContent || '').trim();
    // 2026-10-15: the "Who will you show it to?" links name places too ("THE NOVELIST · the French"); they are not doors
    if (/^((?:←\s*)?BACK|NOTEBOOK)$/.test(txt) || links[i].closest('.stat-bars, .header-links, .book-pitch')) continue;
    for (var j = 0; j < DOORS.length; j++) {
      if (DOORS[j].rx.test(txt)) {
        if (doors[DOORS[j].id].status !== 'open') { doors[DOORS[j].id] = { status:'open', link:links[i], label:'', glyphs:glyphsAfter(links[i]), lead:leadOf(links[i]) }; if (!lead) lead = doors[DOORS[j].id].lead; }
        noteHook(links[i]);
        if (links[i].closest('.choice-box') && !guided) guided = txt.replace(/\.?$/, '.');
        break;
      }
    }
  }
  var greys = passage.querySelectorAll('.greyed-out');
  for (var g = 0; g < greys.length; g++) {
    var gt = (greys[g].textContent || '').trim();
    for (var k = 0; k < DOORS.length; k++) {
      if (DOORS[k].rx.test(gt)) { if (doors[DOORS[k].id].status === 'shut') doors[DOORS[k].id] = { status:'grey', link:null, label:labelFromGrey(gt), glyphs:glyphsAfter(greys[g]) }; noteHook(greys[g]); break; }
    }
  }
  return { doors: doors, hooks: hooks, guided: guided, lead: lead };
}

function busy() {
  try { if (window.dssOverlayBusy && window.dssOverlayBusy()) return true; } catch(e) {}
  var co = document.getElementById('coin-overlay'); if (co && co.offsetParent) return true;
  var mo = document.getElementById('match-overlay'); if (mo && mo.style.display !== 'none' && mo.offsetParent) return true;
  var ae = document.activeElement; if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA')) return true;
  return false;
}

function init(container) {
  var passage = container.closest('tw-passage') || document.querySelector('tw-passage');
  if (!passage) return;
  var scan = scanHub(passage), doors = scan.doors;
  scan.hooks.forEach(function(h){ h.classList.add('soho-hub-dock'); });
  // 2026-10-08 (Sam): the locked path. Once the hut has burnt, only the Coach and the six windows are left on the map.
  if (hubFlag('hut') === 'burnt') { Object.keys(doors).forEach(function(id){ if (id !== 'coach') doors[id] = { status:'shut', link:null, label:'', glyphs:'', lead:'' }; }); }
  // 2026-10-10 (Sam): after the second blackout only the fire path is open: every door shut but Soho Square.
  // 2026-10-11 (Sam): and Centre Point stays open too, so the choice is the quiet ending or the fire.
  else if (hubFlag('fire-only') === 'on') { Object.keys(doors).forEach(function(id){ if (id !== 'square' && id !== 'north') doors[id] = { status:'shut', link:null, label:'', glyphs:'', lead:'' }; }); }

  var wrap = document.createElement('div'); wrap.className = 'soho-map-wrap';
  var stage = document.createElement('div'); stage.className = 'soho-map-stage';
  var cv = document.createElement('canvas'); cv.width = W; cv.height = H; cv.setAttribute('tabindex', '0'); cv.setAttribute('aria-label', 'A map of Soho. Use the arrow keys to walk, and walk into a door to go in.');
  stage.appendChild(cv);
  var bar = document.createElement('div'); bar.className = 'soho-map-bar';
  var place = document.createElement('span'); place.className = 'smb-place';
  var right = document.createElement('span'); right.className = 'smb-glyphs';
  bar.appendChild(place); bar.appendChild(right);
  var dpad = document.createElement('div'); dpad.className = 'soho-dpad';
  [['up',2,1,'▲'],['left',1,2,'◀'],['right',3,2,'▶'],['down',2,3,'▼']].forEach(function(b){
    var btn = document.createElement('button'); btn.type = 'button'; btn.textContent = b[3]; btn.setAttribute('aria-label', 'Walk ' + b[0]);
    btn.style.gridColumn = b[1]; btn.style.gridRow = b[2]; btn.setAttribute('data-dir', b[0]);
    dpad.appendChild(btn);
  });
  wrap.appendChild(stage); wrap.appendChild(bar); wrap.appendChild(dpad);
  container.appendChild(wrap);
  passage.classList.add('soho-map-on');
  /* 2026-10-23 overnight (Sam, playtest: "HERE is where there is massive space, a big gap after 'the novelist' and before the walkable
     map"): the hub's links move onto the map, and the line breaks that stood between them stayed behind as empty lines above it.
     Any line break, or any empty block with no named hook in it, lying wholly between the last words and the map is folded away;
     checked again as the page settles. */
  (function tidyGap() {
    function run() {
      if (!container.isConnected) return;
      var top = container.getBoundingClientRect().top, last = -1e9;
      var tw = document.createTreeWalker(passage, NodeFilter.SHOW_TEXT, null);
      for (var n = tw.nextNode(); n; n = tw.nextNode()) {
        if (!n.nodeValue.trim() || container.contains(n)) continue;
        var pe = n.parentElement; if (!pe || !pe.getClientRects().length || pe.closest('.soho-hub-dock, [hidden], script, style')) continue;
        var cs = getComputedStyle(pe); if (cs.visibility === 'hidden' || cs.display === 'none' || +cs.opacity === 0) continue;
        var rg = document.createRange(); rg.selectNodeContents(n); var rr = rg.getBoundingClientRect();
        if (rr.height && rr.bottom <= top + 1 && rr.bottom > last) last = rr.bottom;
      }
      if (top - last < 40) return;
      Array.prototype.forEach.call(passage.querySelectorAll('br, tw-consecutive-br, tw-hook, tw-expression, div, span'), function(el) {
        if (container.contains(el) || el.contains(container) || el.closest('.soho-hub-dock')) return;
        if (el.tagName !== 'BR' && el.tagName !== 'TW-CONSECUTIVE-BR') {
          if ((el.textContent || '').trim() || el.hasAttribute('name') || el.querySelector('tw-hook[name], svg, canvas, img, input, tw-link')) return;
        }
        var r = el.getBoundingClientRect(); if (!r.height) return;
        if (r.top >= last - 1 && r.bottom <= top + 1) el.style.display = 'none';
      });
    }
    setTimeout(run, 60); setTimeout(run, 900); setTimeout(run, 2500);
  })();
  var x = cv.getContext('2d'); x.imageSmoothingEnabled = false;
  // how many rows of street fit under the top of the map (see VR_MIN above).
  // Measured against the document, not the scroll, so it is the same answer
  // whether the hub arrives at the top of the page or part-way down it.
  function fitRows() {
    if (!(window.innerWidth > 640)) return VR_FULL;
    var sw = stage.clientWidth; if (!sw) return VR_FULL;
    var tile = sw / VC;
    var top = stage.getBoundingClientRect().top + (window.pageYOffset || 0);
    var barH = bar.offsetHeight || 0;
    /* 2026-10-25 (Sam: "make Dean Street fit at 1440x900"): the 20 px allowed under the bar was short of what really sits below it:
       the passage's and the story's foot padding, and, while the map is beside the lamp, the lamp's own bottom margin (it is sized to
       end with the bar). At 1440x900 that is ~54 px, and the hub ran 30-60 px past the window. Read them rather than guess. */
    var tail = 0;
    try {
      var pg = stage.closest('tw-passage'), sty = document.querySelector('tw-story'), lmp = document.getElementById('dean-lamp-svg'), mc = document.getElementById('soho-map-container');
      if (pg) tail += parseFloat(getComputedStyle(pg).paddingBottom) || 0;
      if (sty) tail += parseFloat(getComputedStyle(sty).paddingBottom) || 0;
      if (lmp && mc && getComputedStyle(mc).clear === 'none') tail += parseFloat(getComputedStyle(lmp).marginBottom) || 0;
    } catch (e) {}
    var spare = window.innerHeight - top - barH - Math.max(20, tail + 6);
    var rows = Math.floor(spare / tile) - SKY;
    return Math.max(VR_MIN, Math.min(VR_FULL, rows));
  }
  function applyRows() {
    var rows = fitRows();
    if (rows === VR && cv.height === H) return false;
    VR = rows; H = (VR + SKY) * T;
    cv.height = H; x.imageSmoothingEnabled = false; // a resized canvas forgets its smoothing flag
    return true;
  }
  applyRows();

  // ---- overlays (labels, doorway marks, light spill, chevrons) keep WORLD px in data-wx/wy
  // and are placed against the camera every frame the camera moves ----
  var overlays = [];
  function addOverlay(el, wx, wy) { el.dataset.wx = wx; el.dataset.wy = wy; el.dataset.dy = 0; stage.appendChild(el); overlays.push(el); return el; }
  var labels = {};
  // 2026-10-12 (Sam, the overnight list item 6): every open venue's lit door (its arch, its spill of light, its chevron)
  // shone at full strength, so the French's red one was the loudest thing on the map even when NEXT named somewhere
  // else. While NEXT names an open door, the other venues' lit doors are dimmed (.soho-door-dim), and their light on
  // the street at half strength (the canvas, above); their name plates are unchanged and every door is still a way in.
  var nextDoor = hubFlag('next'), nextDoor2 = hubFlag('next2'), dimOthers = !!(nextDoor && doors[nextDoor] && doors[nextDoor].status === 'open'); /* 2026-10-17: next2 is the second reader's door while the pitch question is unanswered */
  DOORS.forEach(function(d){
    var st = doors[d.id];
    if (st.status === 'shut' || (d.event && !d.sign)) return;
    var el = document.createElement('button'); el.type = 'button';
    el.className = 'soho-door-label soho-door-' + st.status;
    el.textContent = d.label;
    // THE NIGHT'S LEDGER, ON THE DOOR. The tip promises "small marks beside
    // each door", but the marks only ever existed on the docked list (which is
    // parked off-screen) and in the caption bar on the one door you happened to
    // be facing — so the sentence pointed at nothing the player could see
    // (Sam, 2026-09-15: "the 'small marks beside each door' are unclear; I
    // can't really see what that refers to"). They now sit on the door plate
    // itself, which is what the sentence says they do. Same spans, same
    // filled/hollow rule, same colours as the list and the notebook.
    if (st.glyphs) {
      var glyphEl = document.createElement('span');
      glyphEl.className = 'soho-door-glyphs';
      glyphEl.innerHTML = st.glyphs;
      glyphEl.setAttribute('aria-hidden', 'true');
      el.appendChild(glyphEl);
    }
    if (d.quiet || d.sign) el.classList.add('soho-door-quiet');
    // INNER VOICES (switch mapMark, off by default): a warm dot by a door whose venue holds a trail's next step
    try { if (window.dssVoices && window.dssVoices.mapMark(d.id)) el.classList.add('soho-door-trail'); } catch (e) {}
    // 2026-10-12 (Sam: the next task must be much clearer): the door Next Target names glows and carries a small NEXT
    if ((hubFlag('next') === d.id || hubFlag('next2') === d.id) && st.status === 'open') el.classList.add('soho-door-next');
    // 2026-10-15 (Sam: choose the door by who you might pitch the book to): the people inside who still have something
    // to say about the book tonight, named on the plate (the 'who' hub flag, "pillars:THE GREAT HAM|colony:DAVY MERKIN, THE AGENT")
    /* 2026-10-17 (Sam: the pick is signalled enough elsewhere; the plate names the venue only): the names of who is inside are no longer added to the plate. To restore: var whoNames = whoInside(d.id); if (whoNames && st.status === 'open') append a span.soho-door-who holding whoNames to el. */
    var side = doorSide(d), ltx = (d.lc != null ? d.lc : d.c + 0.5), lty = (d.lr != null ? d.lr : d.r - 1.35); // 2026-10-16: a gate's plate sits on its gap (lc/lr)
    // The lit door icon, its spill and the chevron are the venue signature.
    // A doorway gets none of them — just a dim name (Sam, 2026-09-13).
    /* 2026-10-17 (Sam: "do what needs to be done" so the map looks uniform): the plain doorways get the same door seen from above, dim and unlit,
       no spill. A wall doorway has its step (the pause takes you in, as at the venues); an alley doorway you walk onto has none. */
    if ((d.quiet || d.sign) && d.id !== 'north' && d.id !== 'ginger') {
      var qSide = doorSide(d), qRot = qSide === 'e' ? 0 : qSide === 'w' ? 180 : qSide === 's' ? 90 : -90;
      var qm = document.createElement('div'); qm.className = 'soho-door-mark soho-door-mark-side soho-door-mark-quiet'; qm.style.setProperty('--rot', qRot + 'deg');
      qm.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="4" width="17" height="16" fill="#0b0a10"/><rect x="9" y="6" width="15" height="12" fill="#1c1914"/><rect x="19" y="1.5" width="5" height="4.5" fill="#7d7262"/><rect x="19" y="18" width="5" height="4.5" fill="#7d7262"/><line x1="20" y1="6" x2="11.5" y2="1" stroke="#7d7262" stroke-width="1.6" stroke-linecap="round"/></svg>';
      if (d.spot) addOverlay(qm, (d.c + 0.5 + (d.c - d.fc))*T, (d.r + 0.5 + (d.r - d.fr))*T); else addOverlay(qm, (d.c + 0.5)*T, (d.r + 0.5)*T);
      if (!d.spot) { var qs = document.createElement('div'); qs.className = 'soho-door-step soho-door-step-quiet'; qs.style.setProperty('--rot', qRot + 'deg'); var qx = d.c > d.fc ? 1 : d.c < d.fc ? -1 : 0, qy = d.r > d.fr ? 1 : d.r < d.fr ? -1 : 0; addOverlay(qs, (d.fc + 0.5 + qx * 0.4)*T, (d.fr + 0.5 + qy * 0.4)*T); }
    }
    if ((!d.spot || d.id === 'cecil') && !d.quiet && !d.sign) {
      /* 2026-10-17 (Sam: the doors faced the viewer, so you walked sideways into a picture of a front door): a door in a side wall is now drawn from above,
         the way you walk into it: a gap cut in the wall, lit from inside in the venue's colour, its door swung open, with a stone step on the pavement in front.
         Cecil Court's gate (a spot you walk onto) keeps the old arch. */
      var wallDoor = !d.spot;
      var mk = document.createElement('div'); mk.className = 'soho-door-mark soho-door-mark-' + st.status + (wallDoor ? ' soho-door-mark-side' : '');
      mk.style.setProperty('--door-col', rgba(d.col, 1)); mk.style.setProperty('--door-glow', rgba(d.col, st.status === 'open' ? 0.85 : 0.15));
      var gid = 'sdg-' + d.id, inner = st.status === 'open' ? 'url(#' + gid + ')' : '#2a2019', frame = st.status === 'open' ? '#f3e6c8' : '#6a5f52';
      mk.innerHTML = '<svg viewBox="0 0 24 36" aria-hidden="true"><defs><linearGradient id="' + gid + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff8e2"/><stop offset="0.55" stop-color="' + lighten(d.col, 0.25) + '"/><stop offset="1" stop-color="' + rgba(d.col, 1) + '"/></linearGradient></defs>' +
        '<rect x="0" y="33" width="24" height="3" rx="0.6" fill="#cdbb95"/>' +
        '<path d="M2.2 33 V12 A9.8 9.8 0 0 1 21.8 12 V33 Z" fill="#0b0a10" stroke="' + frame + '" stroke-width="1.5"/>' +
        '<path d="M5 33 V12.6 A7 7 0 0 1 19 12.6 V33 Z" fill="' + inner + '"/>' +
        '<path d="M5 15.5 A7 7 0 0 1 19 15.5" fill="none" stroke="#0b0a10" stroke-width="1.1"/>' +
        '<line x1="12" y1="6" x2="12" y2="15.5" stroke="#0b0a10" stroke-width="0.9"/>' +
        '<circle cx="15.6" cy="24.5" r="1.05" fill="#0b0a10"/>' +
        (st.status === 'open' ? '<circle cx="12" cy="9.5" r="1.6" fill="#fff8e2"/>' : '') +
        '</svg>';
      if (wallDoor) {
        var gidS = 'sdgs-' + d.id, openS = st.status === 'open';
        mk.innerHTML = '<svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="' + gidS + '" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff8e2"/><stop offset="0.5" stop-color="' + lighten(d.col, 0.25) + '"/><stop offset="1" stop-color="' + rgba(d.col, 1) + '"/></linearGradient></defs>' +
          '<rect x="7" y="4" width="17" height="16" fill="#0b0a10"/>' +
          (openS ? '<rect x="9" y="6" width="15" height="12" fill="url(#' + gidS + ')"/>' : '<rect x="9" y="6" width="15" height="12" fill="#2a2019"/>') +
          '<rect x="19" y="1.5" width="5" height="4.5" fill="' + frame + '"/><rect x="19" y="18" width="5" height="4.5" fill="' + frame + '"/>' +
          (openS ? '<line x1="20" y1="6" x2="11.5" y2="1" stroke="' + frame + '" stroke-width="1.8" stroke-linecap="round"/>' : '<line x1="23" y1="6" x2="23" y2="18" stroke="' + frame + '" stroke-width="1.8"/>') +
          '</svg>';
        mk.style.setProperty('--rot', (side === 'e' ? 0 : side === 'w' ? 180 : side === 's' ? 90 : -90) + 'deg');
      }
      var dimMe = dimOthers && d.id !== nextDoor && d.id !== nextDoor2 && st.status === 'open';
      if (dimMe) mk.classList.add('soho-door-dim');
      addOverlay(mk, (d.c + 0.5)*T, (d.r + 0.5)*T);
      var rot = side === 'e' ? 0 : side === 'w' ? 180 : side === 's' ? 90 : -90;
      var sp = document.createElement('div'); sp.className = 'soho-door-spill soho-door-spill-' + st.status;
      sp.style.setProperty('--door-glow', rgba(d.col, st.status === 'open' ? 0.8 : 0.22)); sp.style.setProperty('--rot', rot + 'deg');
      var mx = (d.c + d.fc) / 2 + 0.5 + (side === 'e' ? 0.45 : side === 'w' ? -0.45 : 0), my = (d.r + d.fr) / 2 + 0.5 + (side === 's' ? 0.45 : side === 'n' ? -0.45 : 0);
      if (dimMe) sp.classList.add('soho-door-dim');
      addOverlay(sp, mx*T, my*T);
      if (wallDoor) {
        /* the step: on the pavement tile in front, against the wall; stepping onto it toward the door goes in (tryStep's arrival check) */
        var stp = document.createElement('div'); stp.className = 'soho-door-step soho-door-step-' + st.status + (dimMe ? ' soho-door-dim' : '');
        stp.style.setProperty('--door-glow', rgba(d.col, st.status === 'open' ? 0.9 : 0.2)); stp.style.setProperty('--rot', rot + 'deg');
        var sgx = d.c > d.fc ? 1 : d.c < d.fc ? -1 : 0, sgy = d.r > d.fr ? 1 : d.r < d.fr ? -1 : 0;
        addOverlay(stp, (d.fc + 0.5 + sgx * 0.4)*T, (d.fr + 0.5 + sgy * 0.4)*T); /* against the wall, so a walker standing on the tile is beside the step, not under it */
      } else if (st.status === 'open') {
        var ch = document.createElement('div'); ch.className = 'soho-door-chev' + (dimMe ? ' soho-door-dim' : ''); ch.textContent = '❮';
        ch.style.setProperty('--door-glow', rgba(d.col, 0.9)); ch.style.setProperty('--rot', rot + 'deg');
        addOverlay(ch, (d.fc + 0.5)*T, (d.fr + 0.5)*T);
      }
    }
    if (d.id === 'north') { ltx = 18; lty = -1.3; }
    if (d.id === 'cecil') { ltx = 49.4; lty = 36.6; }
    // 2026-10-13 (Sam: the Ginger Light "as it is first shown is too big and obscures the actual bit you need to walk to"): its plate
    // stands up and to the right of the corner, over the building, so the lamp and the corner you walk to stay in view
    if (d.id === 'ginger') { ltx = 24.4; lty = 24.9; }
    el.style.setProperty('--door-col', rgba(d.col, 1));
    el.style.setProperty('--door-glow', rgba(d.col, st.status === 'open' ? 0.75 : 0.0));
    el.setAttribute('aria-label', d.name + (st.status === 'open' ? '' : (st.status === 'grey' ? '. ' + st.label : '. Not tonight.')));
    el.addEventListener('click', function(e){ e.preventDefault(); if (busy() || S.entering) return; if (st.status === 'open') enter(d); else { S.noteFlash = { name:d.name, text: st.status === 'grey' ? st.label : 'Not tonight.', t: 200 }; refreshBar(); } try { cv.focus({ preventScroll: true }); } catch(e2) {} });
    addOverlay(el, ltx*T, lty*T); labels[d.id] = el;
  });
  var openIds = Object.keys(doors).filter(function(id){ return doors[id].status === 'open' && labels[id]; });
  if (openIds.length === 1) labels[openIds[0]].classList.add('soho-door-beckon');

  var base = buildBase(doors), glow = buildGlow(doors);
  // A stranger's after-image (2026-09-25): like the titles, the figure is printed three times,
  // a cold copy up-left and a copy in the world's own colour down-right, both faint, the true
  // figure on top. A print looked at too long; someone not quite there.
  var STRANGER_COLD = [150,170,210];
  function strangerCard(d, tint) {
    var c = document.createElement('canvas'); c.width = T; c.height = T; var g = c.getContext('2d');
    drawStranger(g, d);
    if (tint) { g.globalCompositeOperation = 'source-atop'; g.fillStyle = rgba(tint, 1); g.fillRect(0, 0, T, T); }
    return c;
  }
  var strangerCards = {};
  DOORS.forEach(function(d){ if (d.stranger) strangerCards[d.id] = { cold: strangerCard(d, STRANGER_COLD), warm: strangerCard(d, d.col), self: strangerCard(d, null) }; });
  var sprites = buildSprites(null);
  // the Fetch's glimpse (fetchGlimpse): your own figure washed the pale blue of his window
  var fetchSprites = {}; Object.keys(sprites).forEach(function(d){ fetchSprites[d] = sprites[d].map(function(cv){ var c2 = document.createElement('canvas'); c2.width = cv.width; c2.height = cv.height; var g = c2.getContext('2d'); g.drawImage(cv, 0, 0); g.globalCompositeOperation = 'source-atop'; g.fillStyle = 'rgba(150,205,225,0.55)'; g.fillRect(0, 0, c2.width, c2.height); return c2; }); });
  var walkerSprites = buildSprites({ c:'#221c1e', l:'#332a2c' });
  // street life (2026-09-12): a constable on the beat and a drunk who wants a light
  var copSprites = buildSprites({ c:'#1a2238', l:'#2a3658' });
  var drunkSprites = buildSprites({ c:'#3a2a1c', l:'#5a4230' });
  var fenceSprites = buildSprites({ c:'#2a2a24', l:'#3c3a30' });
  var LIFE_ROWS = [0, 3, 14, 17, 26, 29, 34, 37, 40, 43];
  function hubFlag(k) { var el = document.querySelector('.dss-hub-flag[data-k="' + k + '"]'); return el ? el.textContent.trim() : ''; }
  // 2026-10-15: who inside a door still has something to say about the book (the 'who' hub flag, set by Who Will Read)
  function whoInside(id) { var f = hubFlag('who'); if (!f) return ''; var out = ''; f.split('|').forEach(function(p) { var i = p.indexOf(':'); if (i > 0 && p.slice(0, i).trim() === id) out = p.slice(i + 1).trim(); }); return out; }
  // Lines the street says. Sam's to rewrite; they are UI notes, not passage prose.
  var STREET_LINES = {
    copMove: 'Move along now, sir. Nothing to see.',
    copKey: 'He looks at you a moment longer than he needs to, then moves you along.',
    drunkLight: "'Got a light, pal?' You have. He takes his time over it and calls you a gentleman.",
    drunkNone: "‘Got a light, pal?’ You haven’t. He tells you, at length, what he thinks of that."
  };

  // spawn: outside the door you last went through, else near the bottom (Shaftesbury Avenue end)
  // of Dean Street, facing north up the street towards the ginger light (Sam, 2026-10-11).
  var spawnC = 17, spawnR = 38, facing = 'up', spawnDoor = null; /* spawnDoor: 2026-10-21, the door you came out of, for the fading pub noise */
  try { var last = sessionStorage.getItem('dssMapLast'); if (last) { var ld = doorById(last); if (ld && walkable(ld.fc, ld.fr)) { spawnC = ld.fc; spawnR = ld.fr; spawnDoor = { c: ld.fc, r: ld.fr }; facing = ld.spot ? 'down' : (ld.c < ld.fc ? 'right' : (ld.c > ld.fc ? 'left' : (ld.r < ld.fr ? 'down' : 'up'))); } } } catch(e) {}

  var S = { trail:[], stepK:0, c:spawnC, r:spawnR, px:spawnC*T, py:spawnR*T, moving:false, dx:0, dy:0, prog:0, facing:facing, frame:0, stepT:0,
            held:{}, entering:null, enterT:0, t:0, walker:null, walkerNext:14 + Math.random()*12, hintShown:false, noteFlash:null, alive:true, raf:null,
            cam:{ x:0, y:0 }, camMoving:true, edge:null,
            still:0, cop:null, copNext:24 + Math.random()*20, copCool:0, drunk:null, drunkNext:38 + Math.random()*24, drunkCool:0,
            sqcat:{ x:35*T + 4, y:10*T, mode:'sit', t:0 }, porter:{ y:10*T + 4, dir:1, on:false }, corner:{ flare:0, t:0 } };
  // 2026-10-13 (Sam, "last night's footsteps"): each night's walk is kept (localStorage 'dssRouteNow', the night from 'dssNightNo');
  // on a later night the night before shows as faint prints in the Fetch's pale blue, and each fades as you walk over it
  var ROUTE = (function() {
    var n = 0, now = null, prev = null;
    try { n = +localStorage.getItem('dssNightNo') || 0; now = JSON.parse(localStorage.getItem('dssRouteNow') || 'null'); prev = JSON.parse(localStorage.getItem('dssRoutePrev') || 'null'); } catch (e) {}
    if (!now || now.n !== n) { if (now && now.p && now.p.length > 8 && now.n < n) { prev = now; try { localStorage.setItem('dssRoutePrev', JSON.stringify(prev)); } catch (e) {} } now = { n: n, p: [] }; }
    var seen = {}, ghost = [], gk = {};
