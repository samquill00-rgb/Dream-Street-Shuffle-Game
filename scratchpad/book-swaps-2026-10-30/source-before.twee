function roomBlocked(){return wrap.dataset.interactionLocked==='1' || /^(modal|full)$/.test(wrap.dataset.words||'') || !!document.querySelector('tw-dialog') || !!(window.dssOverlayBusy && window.dssOverlayBusy());}
var roomPress=null;
canvas.addEventListener('pointermove', function(ev) {
if(roomPress && ev.pointerId===roomPress.id && Math.hypot(ev.clientX-roomPress.x,ev.clientY-roomPress.y)>12)roomPress.moved=true;
if (camMode !== 'idle' || roomBlocked() || ev.pointerType === 'touch') { hoverSpot = null; halo.visible = false; hoverName(null); return; }
var spot = pick(ev); hoverSpot = spot;
if (spot) { haloAt(spot); halo.visible = true; canvas.style.cursor = 'pointer'; var hg = glowFor(spot); hoverName(roomObjectLabel(spot), ev, hg && hg.on ? glowAt(hg) : null); }
else { halo.visible = false; canvas.style.cursor = 'default'; hoverName(null); }
});
canvas.addEventListener('pointerleave', function() { roomPress=null;hoverSpot=null;halo.visible=false;canvas.style.cursor='default';hoverName(null); });
