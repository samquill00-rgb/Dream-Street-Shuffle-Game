// ============================================================
// PAVEMENTS — raised kerbs along both streets
// ============================================================
/* granite kerb stones, four to a tile: joints, chipped arrises worn pale on top, gutter muck up the foot */
var kerbTex = makeCanvasTexture(512, 128, function(cx, w, h) {
  cx.fillStyle = '#46443f'; cx.fillRect(0, 0, w, h);
  for (var s = 0; s < 4; s++) { var t = chRand(-10, 10); cx.fillStyle = 'rgba(' + (70 + t) + ',' + (68 + t) + ',' + (62 + t) + ',0.5)'; cx.fillRect(s * 128, 0, 128, h); }
  for (var g = 0; g < 2600; g++) { var v = Math.floor(chRand(40, 140)); cx.fillStyle = 'rgba(' + v + ',' + v + ',' + (v - 6) + ',0.35)'; cx.fillRect(chRand(0, w), chRand(0, h), 1.4, 1.4); }
  cx.fillStyle = 'rgba(150,146,134,0.28)'; cx.fillRect(0, h * 0.47, w, h * 0.05);
  cx.fillStyle = 'rgba(14,12,10,0.85)'; for (var j = 0; j < 4; j++) cx.fillRect(j * 128 + chRand(-2, 2), 0, 3, h);
  for (var c = 0; c < 26; c++) { cx.fillStyle = 'rgba(20,18,15,' + chRand(0.4, 0.8).toFixed(2) + ')'; cx.beginPath(); cx.ellipse(chRand(0, w), h * 0.5 + chRand(-3, 3), chRand(2, 9), chRand(1, 4), 0, 0, Math.PI * 2); cx.fill(); }
  var gg = cx.createLinearGradient(0, h, 0, h * 0.6); gg.addColorStop(0, 'rgba(12,10,7,0.8)'); gg.addColorStop(1, 'rgba(12,10,7,0)');
  cx.fillStyle = gg; cx.fillRect(0, h * 0.6, w, h * 0.4);
});
kerbTex.wrapS = kerbTex.wrapT = THREE.RepeatWrapping;
var kerbMat = new THREE.MeshStandardMaterial({ map: kerbTex, roughness: 0.82 });
var paveMat = (chKit && chKit.makePavingSlabs)
  ? chKit.makePavingSlabs({ repeat: [1, 1] })
  : new THREE.MeshStandardMaterial({ color: 0x4a4a4a, roughness: 0.85 });
chWetGround(paveMat, { tint: 'rgb(140,136,128)', patches: 6, gum: 90, dry: 225, metal: 0.08 });

// Greek St pavement — pub side (west, at x≈0-1)
// Runs along -Z from z=5 down to z=-20
var greekPaveW = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.15, 30), paveMat);
greekPaveW.position.set(1.25, 0.075, -5);
