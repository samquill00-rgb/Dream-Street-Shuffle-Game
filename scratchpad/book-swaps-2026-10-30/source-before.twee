})();
/* 2026-10-25 (Sam, item 5: "tighten the layout on the scrolling pages without touching any words"): a page of words with no game
   or 3D room on it that still runs past the window gives up its foot padding and half of each blank line, then its contents shrink
   evenly, to no less than 80% (Sam asked for 82% so three pages fit at 1280x800; two still ran ~20 px over there), until it fits. The hub and the Dawn are left alone; a resize starts again from full size. */
(function() {
  var MIN = 0.80, gen = -1, settle = 0, until = 0, step = 0, z = 1, cur = null, base = null;
  var css = document.createElement('style');
  css.textContent = 'tw-story.dss-pf { padding-bottom: 4px !important; } tw-story.dss-pf tw-passage { padding-bottom: 8px !important; } tw-story.dss-pf tw-passage tw-consecutive-br { height: .38em !important; }';
  document.head.appendChild(css);
  function page() { var ps = Array.prototype.filter.call(document.querySelectorAll('tw-story tw-passage'), function(p) { return !p.closest('.dss-ghost'); }); return ps.filter(function(p) { return !p.parentElement.closest('div'); })[0] || ps[0] || null; }
  var brs = [];
  function undo() { var st = document.querySelector('tw-story'); if (st) st.classList.remove('dss-pf'); if (cur && base) { cur.style.zoom = base.zoom; cur.style.paddingTop = base.pt; cur.style.marginLeft = base.ml; cur.style.marginRight = base.mr; cur.style.width = base.w; cur.style.maxWidth = base.mxw; } cur = null; base = null; step = 0; z = 1; brs.forEach(function(b) { b.style.display = ''; }); fixeds.forEach(function(e) { e.style.zoom = e._dssPfZ; e._dssPfZ = null; }); fixeds = []; brs = []; }
  /* the passage itself is zoomed (Harlowe unwraps its transition container a few seconds in, so that cannot carry it); its top padding
     (the header's room) and its side margins and width are divided back out, so the words neither slide under the header nor change their column */
  /* 2026-10-29 (Sam: "weird space at the bottom and right margins, it doesn't fill the screen", the title page): a fixed layer inside the
