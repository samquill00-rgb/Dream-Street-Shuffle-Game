var ray = new THREE.Raycaster(), mouseN = new THREE.Vector2();
function pick(ev) {
var r = canvas.getBoundingClientRect();
mouseN.set(((ev.clientX - r.left) / r.width) * 2 - 1, -((ev.clientY - r.top) / r.height) * 2 + 1);
ray.setFromCamera(mouseN, camera);
// 2026-10-14 (Sam): the coloured glow is the thing you point at, so a pointer on or near a glow picks its object, and
// first: a glow over another object (the paperback's, over the bar) must not lose the click to what lies behind it
