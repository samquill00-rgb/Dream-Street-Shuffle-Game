    'venue-ronnies':     { min: 9,  max: 22, fn: function(){ _tick(Math.random() < 0.25 ? chairScrape : glassSetDown); } },
    'himalayan':         { min: 8,  max: 20, fn: function(){ _tick(Math.random() < 0.2 ? distantBell : function(){ gust(false); }); } },
    'nazca':             { min: 8,  max: 20, fn: function(){ _tick(Math.random() < 0.35 ? gravelSteps : function(){ gust(true); }); } },
    'easter':            { min: 7,  max: 16, fn: function(){ _tick(Math.random() < 0.25 ? gullFar : function(){ surfWash(false); }); } },
    'pyramid':           { min: 10, max: 25, fn: function(){ _tick(sandSlip); } },
    'ezekiel':           { min: 12, max: 30, fn: function(){ _tick(wheelCreak); } },
