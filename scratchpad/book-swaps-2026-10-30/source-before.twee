placeMesh(new THREE.SphereGeometry(0.1, 6, 4), bollardMat, -1.5, 0.85, -5);

// Dustbin (galvanised bin, period-appropriate)
var binMat = new THREE.MeshStandardMaterial({ color: 0x555555, roughness: 0.6, metalness: 0.3 });
var dustbin = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.3, 0.8, 8), binMat);
dustbin.position.set(-5.8, 0.4, 0.5);
scene.add(dustbin);
var binLid = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.28, 0.04, 8), binMat);
binLid.position.set(-5.8, 0.82, 0.5);
binLid.rotation.z = 0.1; // slightly askew
scene.add(binLid);

// Drain cover in the road (raised to avoid z-fighting)
var drain = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.04, 0.4), drainMat);
drain.position.set(1, 0.03, -1);
scene.add(drain);

// Street name plate on building wall (Dean Street)
var deanSignTex = makeCanvasTexture(256, 64, function(cx, w, h) {
  cx.fillStyle = '#1a1a2a';
  cx.fillRect(0, 0, w, h);
  cx.strokeStyle = '#aaa';
  cx.lineWidth = 2;
  cx.strokeRect(2, 2, w-4, h-4);
  cx.fillStyle = '#e0d8c0';
  cx.font = 'bold 22px serif';
  cx.textAlign = 'center';
  cx.textBaseline = 'middle';
  cx.fillText('DEAN STREET W1', w/2, h/2);
});
var deanSignMat = new THREE.MeshStandardMaterial({ map: deanSignTex, roughness: 0.5 });
var deanSign = new THREE.Mesh(new THREE.PlaneGeometry(1.5, 0.4), deanSignMat);
deanSign.position.set(-4.0, 3.5, 1.06);
scene.add(deanSign);

// ============================================================
// RED PHONE BOX — iconic K6, proper scale (~2.5m tall, 0.9m square)
// ============================================================
var phoneBox = new THREE.Group();
var phoneRedMat = new THREE.MeshStandardMaterial({ color: 0x9b1c1c, roughness: 0.55, metalness: 0.12 });
var phoneRedDark = new THREE.MeshStandardMaterial({ color: 0x6b1212, roughness: 0.6, metalness: 0.1 });
var phoneDarkMat = new THREE.MeshStandardMaterial({ color: 0x1a0808, roughness: 0.7 });
var phoneIronMat = new THREE.MeshStandardMaterial({ color: 0x1a1a1a, roughness: 0.5, metalness: 0.4 });

// --- CONCRETE BASE ---
var concreteBase = new THREE.Mesh(
  new THREE.BoxGeometry(1.1, 0.1, 1.1),
  new THREE.MeshStandardMaterial({ color: 0x555550, roughness: 0.9 })
);
concreteBase.position.set(0, 0.05, 0);
phoneBox.add(concreteBase);

// --- LOWER PLINTH (stepped base) ---
var plinth1 = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.12, 1.0), phoneRedDark);
plinth1.position.set(0, 0.16, 0);
phoneBox.add(plinth1);
var plinth2 = new THREE.Mesh(new THREE.BoxGeometry(0.95, 0.08, 0.95), phoneRedDark);
plinth2.position.set(0, 0.26, 0);
phoneBox.add(plinth2);

// --- FOUR CORNER PILLARS ---
var pillarGeo = new THREE.BoxGeometry(0.08, 1.7, 0.08);
var pillarPositions = [
  [-0.42, 1.15, -0.42], [0.42, 1.15, -0.42],
  [-0.42, 1.15, 0.42], [0.42, 1.15, 0.42]
];
for (var pi = 0; pi < pillarPositions.length; pi++) {
  var pillar = new THREE.Mesh(pillarGeo, phoneRedMat);
  pillar.position.set(pillarPositions[pi][0], pillarPositions[pi][1], pillarPositions[pi][2]);
  pillar.castShadow = true;
  phoneBox.add(pillar);
}

// --- SOLID LOWER PANELS (below windows) ---
var lowerPanelH = 0.5;
// Front and back
var lowerFB = new THREE.BoxGeometry(0.76, lowerPanelH, 0.04);
placeMeshG(phoneBox, lowerFB, phoneRedMat, 0, 0.55, 0.44);
placeMeshG(phoneBox, lowerFB, phoneRedMat, 0, 0.55, -0.44);
// Sides
var lowerLR = new THREE.BoxGeometry(0.04, lowerPanelH, 0.76);
placeMeshG(phoneBox, lowerLR, phoneRedMat, -0.44, 0.55, 0);
placeMeshG(phoneBox, lowerLR, phoneRedMat, 0.44, 0.55, 0);

// --- WINDOW GLASS (18-pane pattern per side) ---
var phoneGlass = new THREE.MeshStandardMaterial({
  color: 0x0a0a15, roughness: 0.12, metalness: 0.25,
  emissive: 0xe87818, emissiveIntensity: 0.04
});
var phoneGlassBright = new THREE.MeshStandardMaterial({
  color: 0x0a0a15, roughness: 0.12, metalness: 0.25,
  emissive: 0xe87818, emissiveIntensity: 0.08
});

// Window area: 3 columns x 6 rows of small panes with mullions
// Each side gets a large glass panel + red mullion grid overlay
var glassH = 1.2;
var glassW = 0.72;
var mullionMat = phoneRedMat;

function addPhoneWindowSide(faceAxis, offset, rotY) {
  // Main glass panel
  var glass = new THREE.Mesh(new THREE.PlaneGeometry(glassW, glassH), phoneGlassBright);
  glass.position.set(
    faceAxis === 'x' ? offset : 0,
    1.4,
    faceAxis === 'z' ? offset : 0
  );
  glass.rotation.y = rotY;
  phoneBox.add(glass);

  // Horizontal mullions (5 bars creating 6 rows)
  for (var mh = 0; mh < 5; mh++) {
    var hBar = new THREE.Mesh(new THREE.BoxGeometry(
      faceAxis === 'z' ? 0.76 : 0.025,
      0.02,
      faceAxis === 'x' ? 0.76 : 0.025
    ), mullionMat);
    hBar.position.set(
      faceAxis === 'x' ? offset * 1.02 : 0,
      0.9 + mh * 0.24,
      faceAxis === 'z' ? offset * 1.02 : 0
    );
    phoneBox.add(hBar);
  }
  // Vertical mullions (2 bars creating 3 columns)
  for (var mv = 0; mv < 2; mv++) {
    var vOff = -0.12 + mv * 0.24;
    var vBar = new THREE.Mesh(new THREE.BoxGeometry(
      faceAxis === 'z' ? 0.02 : 0.025,
      glassH,
      faceAxis === 'x' ? 0.02 : 0.025
    ), mullionMat);
    vBar.position.set(
      faceAxis === 'x' ? offset * 1.02 : vOff,
      1.4,
      faceAxis === 'z' ? offset * 1.02 : vOff
    );
    phoneBox.add(vBar);
  }
}

addPhoneWindowSide('z', 0.455, 0);           // front
// Back is a solid panel (no glass on the rear of a real K6) — dark, unlit
var backPanelMat = new THREE.MeshStandardMaterial({ color: 0x3a0808, roughness: 0.8, metalness: 0.0 });
var backPanel = new THREE.Mesh(new THREE.BoxGeometry(0.76, 1.7, 0.06), backPanelMat);
backPanel.position.set(0, 1.15, -0.45);
phoneBox.add(backPanel);
addPhoneWindowSide('x', -0.455, Math.PI/2);   // left
addPhoneWindowSide('x', 0.455, -Math.PI/2);   // right

// --- ENTABLATURE (band above windows) ---
var entab = new THREE.Mesh(new THREE.BoxGeometry(0.98, 0.1, 0.98), phoneRedMat);
entab.position.set(0, 2.05, 0);
phoneBox.add(entab);

// --- TELEPHONE signs on entablature (all four sides) ---
var telSignTex = makeCanvasTexture(256, 48, function(cx, w, h) {
  cx.fillStyle = '#9b1c1c';
  cx.fillRect(0, 0, w, h);
  cx.fillStyle = '#d0c8a0';
  cx.font = 'bold 24px Georgia, serif';
  cx.textAlign = 'center';
  cx.textBaseline = 'middle';
  cx.letterSpacing = '4px';
  cx.fillText('TELEPHONE', w/2, h/2);
});
exterior.age(telSignTex,false);
var telSignMat = new THREE.MeshStandardMaterial({ map: telSignTex, roughness: 0.5 });
// Front sign
var tsFront = new THREE.Mesh(new THREE.PlaneGeometry(0.7, 0.08), telSignMat);
tsFront.position.set(0, 2.05, 0.5);
phoneBox.add(tsFront);
// Back sign
var tsBack = new THREE.Mesh(new THREE.PlaneGeometry(0.7, 0.08), telSignMat);
tsBack.position.set(0, 2.05, -0.5);
tsBack.rotation.y = Math.PI;
phoneBox.add(tsBack);

// --- CROWN / DOME ---
// Crown cornice
var crownCornice = new THREE.Mesh(new THREE.BoxGeometry(1.02, 0.06, 1.02), phoneRedMat);
crownCornice.position.set(0, 2.13, 0);
phoneBox.add(crownCornice);

// Dome — the distinctive rounded top
var dome = new THREE.Mesh(
  new THREE.CylinderGeometry(0.15, 0.48, 0.35, 8),
  phoneRedMat
);
dome.position.set(0, 2.34, 0);
phoneBox.add(dome);

// Crown finial (small sphere on top)
var crownFinial = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 6), phoneRedMat);
crownFinial.position.set(0, 2.56, 0);
phoneBox.add(crownFinial);

// --- DOOR (the side facing the camera — +Z) ---
// Door outer frame
var doorFrameL = new THREE.Mesh(new THREE.BoxGeometry(0.04, 1.7, 0.05), phoneRedDark);
doorFrameL.position.set(-0.32, 1.15, 0.46);
phoneBox.add(doorFrameL);
var doorFrameR = new THREE.Mesh(new THREE.BoxGeometry(0.04, 1.7, 0.05), phoneRedDark);
doorFrameR.position.set(0.32, 1.15, 0.46);
phoneBox.add(doorFrameR);
var doorFrameTop = new THREE.Mesh(new THREE.BoxGeometry(0.68, 0.04, 0.05), phoneRedDark);
doorFrameTop.position.set(0, 2.02, 0.46);
phoneBox.add(doorFrameTop);
var doorFrameBot = new THREE.Mesh(new THREE.BoxGeometry(0.68, 0.04, 0.05), phoneRedDark);
doorFrameBot.position.set(0, 0.32, 0.46);
phoneBox.add(doorFrameBot);

// Door glass panes (3 columns x 6 rows, matching the other sides)
var doorGlass = new THREE.Mesh(new THREE.PlaneGeometry(0.58, 1.6), phoneGlassBright);
doorGlass.position.set(0, 1.15, 0.47);
phoneBox.add(doorGlass);

// Door horizontal mullions (5 bars)
for (var dh = 0; dh < 5; dh++) {
  var dHBar = new THREE.Mesh(new THREE.BoxGeometry(0.62, 0.02, 0.03), mullionMat);
  dHBar.position.set(0, 0.5 + dh * 0.28, 0.47);
  phoneBox.add(dHBar);
}
// Door vertical mullions (2 bars)
for (var dv = 0; dv < 2; dv++) {
  var dvOff = -0.1 + dv * 0.2;
  var dVBar = new THREE.Mesh(new THREE.BoxGeometry(0.02, 1.6, 0.03), mullionMat);
  dVBar.position.set(dvOff, 1.15, 0.47);
  phoneBox.add(dVBar);
}

// Door handle (small cylinder, on the right side)
var doorHandle = new THREE.Mesh(
  new THREE.CylinderGeometry(0.015, 0.015, 0.12, 6),
  phoneIronMat
);
doorHandle.rotation.x = Math.PI / 2;
doorHandle.position.set(0.24, 0.9, 0.5);
phoneBox.add(doorHandle);
exterior.plate(phoneBox,0.24,0.9,0.488,0.045,0.17,0,0x817453);

// Scale up and position phone box on the west pavement, in the ginger light
phoneBox.scale.set(1.4, 1.4, 1.4);
phoneBox.position.set(-2.2, 0.15, -5.2);
phoneBox.castShadow = true;
scene.add(phoneBox);

// Interior light — warm glow spilling from the glass
var phoneGlowLight = new THREE.PointLight(0xe87818, 0.25, 5);
phoneGlowLight.position.set(-2.2, 2.0, -5.2);
scene.add(phoneGlowLight);

// ============================================================
// LIVING ELEMENT: the ginger cat — of course the Ginger Light has one.
// Seated by the phone box in the lamp pool, Trisha's-cat manners: breath,
// tail sweeps, slow head turns, amber eyes that blink out.
// ============================================================
var gingerCat = new THREE.Group();gingerCat.name="dss-ginger-cat";
// Fur stays a textured surface rather than hundreds of separate hair meshes.
var catFurTex=makeCanvasTexture(512,256,function(cx,w,h){
 cx.fillStyle='#a86c38';cx.fillRect(0,0,w,h);
 var shade=cx.createLinearGradient(0,0,0,h);shade.addColorStop(0,'#c18a4d');shade.addColorStop(.5,'#ad7038');shade.addColorStop(1,'#85502c');cx.fillStyle=shade;cx.fillRect(0,0,w,h);
 for(var stripe=0;stripe<12;stripe++){cx.strokeStyle='rgba(70,39,23,.24)';cx.lineWidth=3+stripe%3;for(var fy=0;fy<h;fy+=26){if((fy/26+stripe)%3===0)continue;cx.beginPath();for(var sy=fy;sy<=fy+18;sy+=3){var fx=stripe*w/12+Math.sin(sy*.035+stripe*2)*7;if(sy===fy)cx.moveTo(fx,sy);else cx.lineTo(fx,sy);}cx.stroke();}} /* 2026-10-24 (Sam: the cat "looked a bit weird"): unbroken dark stripes ran pole to pole on the sphere UVs and ribbed the body like a pumpkin; now soft broken tabby flecks */
 var seed=1973;for(var hair=0;hair<2600;hair++){seed=(seed*1664525+1013904223)>>>0;var x=seed/4294967296*w;seed=(seed*1664525+1013904223)>>>0;var y=seed/4294967296*h;cx.strokeStyle=hair%2?'#edcb8a25':'#33251a20';cx.lineWidth=.5;cx.beginPath();cx.moveTo(x,y);cx.lineTo(x+1,y+3);cx.stroke();}
});
var catFurMat = new THREE.MeshStandardMaterial({ map:catFurTex, roughness:.92, emissive:0xffffff, emissiveMap:catFurTex, emissiveIntensity:.22 }); /* 2026-10-23 overnight (Sam: "It should look more like a cat"): under the overhead lamp the muzzle and chest fell into black, a mask across the face; a little of its own warmth fills them */
var catDarkMat = new THREE.MeshStandardMaterial({ color:0x694026,roughness:.9 });
var catCreamMat=new THREE.MeshStandardMaterial({color:0xc5ab7c,roughness:.95,emissive:0x6a5236,emissiveIntensity:.55});
function catPart(geo, mat, x, y, z) {var m=new THREE.Mesh(geo,mat);m.position.set(x,y,z);gingerCat.add(m);return m;}
function catScaled(m,x,y,z){m.scale.set(x,y,z);return m;}
/* 2026-10-24 (Sam: "more majestic and less silly. Maybe longer hair"): shell fur. Each furred volume gets CAT_SHELLS slightly larger copies whose strand mask thins out layer by layer, so the coat reads as long soft hair with a fuzzy edge. Materials are shared per base material and layer. */
var CAT_SHELLS=10;var catStrandTex=makeCanvasTexture(256,256,function(cx,w,h){cx.fillStyle='#000';cx.fillRect(0,0,w,h);var sd=5;function rn(){sd=(sd*16807)%2147483647;return sd/2147483647;}for(var k=0;k<5000;k++){var x=rn()*w,y=rn()*h,g=(60+rn()*195)|0,L=6+rn()*10;var gr=cx.createLinearGradient(0,y,0,y+L);gr.addColorStop(0,'rgb(0,0,0)');gr.addColorStop(1,'rgb('+g+','+g+','+g+')');cx.fillStyle=gr;cx.fillRect(x,y,1.6,L);}}); /* strands run down the sphere meridians and brighten toward their tips, so the outer layers keep only the lower ends: hair that lies down and falls, not bristles */catStrandTex.wrapS=catStrandTex.wrapT=THREE.RepeatWrapping;catStrandTex.repeat.set(3,3);
var catShellMats={};function catShellMat(base,i){var key=base.uuid+'_'+i;if(!catShellMats[key]){var m=base.clone();m.alphaMap=catStrandTex;m.alphaTest=.12+.8*i/CAT_SHELLS;m.color.multiplyScalar(.75+.35*i/CAT_SHELLS);catShellMats[key]=m;}return catShellMats[key];}
function catFurShells(mesh,len,droop,xzOnly){var gp=mesh.geometry.parameters,r=gp.radius||gp.radiusBottom;for(var i=1;i<=CAT_SHELLS;i++){var sh=new THREE.Mesh(mesh.geometry,catShellMat(mesh.material,i));var f=1+len*i/CAT_SHELLS/r;sh.position.copy(mesh.position);sh.position.y-=droop*i/CAT_SHELLS;sh.scale.copy(mesh.scale);if(xzOnly){sh.scale.x*=f;sh.scale.z*=f;}else sh.scale.multiplyScalar(f);mesh.parent.add(sh);}return mesh;}
// Rounded haunches, a narrow chest and the shoulder line of a resting cat.
catFurShells(catScaled(catPart(new THREE.SphereGeometry(.15,20,14),catFurMat,0,.155,-.025),1,1.06,1.26),.03,.01);
catFurShells(catScaled(catPart(new THREE.SphereGeometry(.10,18,12),catFurMat,0,.285,.09),.87,1.4,.85),.06,.02);
catPart(new THREE.SphereGeometry(.085,16,12),catCreamMat,0,.28,.153).scale.set(.56,1.02,.20);
[-1,1].forEach(function(side){
 catFurShells(catScaled(catPart(new THREE.SphereGeometry(.09,16,12),catFurMat,side*.087,.105,-.07),.75,1.03,1.1),.03,.01);
 catFurShells(catPart(new THREE.CylinderGeometry(.023,.029,.205,12),catFurMat,side*.05,.12,.125),.022,0,true);
 catPart(new THREE.SphereGeometry(.035,14,10),catFurMat,side*.05,.028,.15).scale.set(.83,.65,1.45);
 for(var toe=0;toe<2;toe++){var line=new THREE.Mesh(new THREE.BoxGeometry(.001,.006,.014),catDarkMat);line.position.set(side*.05+(toe-.5)*.012,.033,.184);gingerCat.add(line);}
});
var catHead=new THREE.Group();
var catFaceMat=catFurMat.clone();catFaceMat.map=null;catFaceMat.emissiveMap=null;catFaceMat.emissive.setHex(0x3a2412);catFaceMat.emissiveIntensity=.6;catFaceMat.color.setHex(0xa97341);var catEarMat=catFaceMat.clone();catEarMat.side=THREE.DoubleSide;
var catRuff=catPart(new THREE.SphereGeometry(.09,18,12),catFaceMat,0,.36,.14);catRuff.scale.set(1.05,.9,1);catFurShells(catRuff,.075,.025); /* 2026-10-24: a ruff under the enlarged head, so it sits on the shoulders instead of on a stalk; face material so it reads as throat, not a striped collar */
var chSk=new THREE.Mesh(new THREE.SphereGeometry(.083,24,18),catFaceMat);chSk.scale.set(1.03,.93,.93);catHead.add(chSk);
function headPart(geo,mat,x,y,z,sx,sy,sz){var m=new THREE.Mesh(geo,mat);m.position.set(x,y,z);m.scale.set(sx||1,sy||1,sz||1);catHead.add(m);return m;}
// Ears have triangular faces, soft inner planes and a slight outward cant.
[-1,1].forEach(function(side){
 var geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute([-.034,0,.01,.034,0,.01,0,.078,-.004, -.034,0,-.022,0,.078,-.004,.034,0,-.022, -.034,0,.01,0,.078,-.004,-.034,0,-.022, .034,0,.01,.034,0,-.022,0,.078,-.004],3));geo.computeVertexNormals();
 var ear=headPart(geo,catEarMat,side*.055,.048,-.008);ear.rotation.z=-side*.2; /* 2026-10-24: scaled with the head the old .105 ears stood up as dark horns; shorter, broader, lit like the face */
 var inner=new THREE.BufferGeometry();inner.setAttribute('position',new THREE.Float32BufferAttribute([-.02,.008,.0125,.02,.008,.0125,0,.06,.002],3));inner.computeVertexNormals();var lining=new THREE.Mesh(inner,new THREE.MeshStandardMaterial({color:0x987565,roughness:1,side:THREE.DoubleSide}));ear.add(lining);
});
/* 2026-10-24 (Sam: the facial features "look insane"): eyes and pads had sunk inside the skull and the head fur cut them ragged, and the nose floated ahead of a flat face. The face is now kept smooth, with a small muzzle the pads, nose and chin sit on, and furred cheeks frame it instead */
headPart(new THREE.SphereGeometry(.04,20,14),catFaceMat,0,-.024,.05,.95,.62,.62);
[-1,1].forEach(function(side){catFurShells(headPart(new THREE.SphereGeometry(.045,16,12),catFaceMat,side*.05,-.025,.018,1,.9,.85),.025,.008);});
var catMuzzleMat=catFaceMat.clone();catMuzzleMat.color.setHex(0xb98454);catMuzzleMat.emissiveIntensity=.45;headPart(new THREE.SphereGeometry(.027,16,10),catMuzzleMat,-.012,-.029,.072,.5,.42,.4);headPart(new THREE.SphereGeometry(.027,16,10),catMuzzleMat,.012,-.029,.072,.5,.42,.4); /* 2026-10-24: smaller whisker pads in a warm face tone; the big pale glowing ones made a cartoon moustache */
headPart(new THREE.SphereGeometry(.022,14,10),catCreamMat,0,-.044,.062,.6,.36,.45);
var noseGeo=new THREE.BufferGeometry();noseGeo.setAttribute('position',new THREE.Float32BufferAttribute([-.009,-.013,.093,.009,-.013,.093,0,-.023,.098],3));noseGeo.computeVertexNormals();var catNose=new THREE.Mesh(noseGeo,new THREE.MeshStandardMaterial({color:0x6a4943,roughness:.7,side:THREE.DoubleSide}));catNose.position.set(0,.002,-.014);catHead.add(catNose);
var catEyeMat=new THREE.MeshStandardMaterial({color:0xc39236,roughness:.3,metalness:.12,emissive:0xa87818,emissiveIntensity:.95}); /* 2026-10-23 overnight (Sam: "It should look more like a cat"): the flat dim eyes read at street distance as a dark mask across the face; rounder, and lit amber as a cat's eyes catch a lamp */
var eyeL=headPart(new THREE.SphereGeometry(.014,16,10),catEyeMat,-.028,.007,.072,1.1,.74,.45);eyeL.rotation.set(0,-.3,-.16);
var eyeR=headPart(new THREE.SphereGeometry(.014,16,10),catEyeMat,.028,.007,.072,1.1,.74,.45);eyeR.rotation.set(0,.3,.16); /* eyes sit on the skull surface, turned with its curve */ /* 2026-10-24: almond, outer corners lifted, for a calmer, prouder look than round eyes */
[eyeL,eyeR].forEach(function(eye){var pupil=new THREE.Mesh(new THREE.SphereGeometry(.006,10,8),new THREE.MeshBasicMaterial({color:0x10120d}));pupil.position.z=.0135;pupil.scale.set(.5,1,.4);eye.add(pupil);var glint=new THREE.Mesh(new THREE.SphereGeometry(.002,6,6),new THREE.MeshBasicMaterial({color:0xf3dfac}));glint.position.set(-.004,.004,.014);eye.add(glint);}); /* 2026-10-24: the pupils sat inside the flattened eyeballs, leaving blank pale discs; brought to the surface and widened for night */
var whiskerMat=new THREE.LineBasicMaterial({color:0xc9bc94,transparent:true,opacity:.2}); /* 2026-10-23: taller ears, fainter whiskers (at street distance they read as a pale band across the face) */
[-1,1].forEach(function(side){for(var wi=0;wi<3;wi++){var pts=[new THREE.Vector3(side*.025,-.028,.087),new THREE.Vector3(side*.064,-.024+(wi-1)*.008,.096),new THREE.Vector3(side*.102,-.02+(wi-1)*.014,.082)];catHead.add(new THREE.Line(new THREE.BufferGeometry().setFromPoints(pts),whiskerMat));}});
// Small dark forehead strokes read as tabby markings at street-view scale.
[-1,0,1].forEach(function(side){var path=new THREE.CatmullRomCurve3([new THREE.Vector3(side*.014,.074,.024),new THREE.Vector3(side*.015,.06,.049),new THREE.Vector3(side*.013,.045,.064)]);catHead.add(new THREE.Mesh(new THREE.TubeGeometry(path,10,.002,5,false),catDarkMat));}); /* 2026-10-24: the old strokes curved just over the eyes and read as shut, frowning lids; now the upright bars of a tabby M on the brow */
catHead.position.set(0,.445,.16);catHead.scale.setScalar(1.35);catHead.rotation.x=-.1;gingerCat.add(catHead); /* 2026-10-23 (Sam, playtest: "It should look more like a cat. The head is too small."): a third bigger, a touch higher on the shoulders */
/* 2026-10-24: a plumed tail wrapped round the front paws, the sitting pose of a proud cat */
var catTail=new THREE.Group();var tailPath=new THREE.CatmullRomCurve3([new THREE.Vector3(0,.03,0),new THREE.Vector3(.1,.03,.05),new THREE.Vector3(.13,.03,.17),new THREE.Vector3(.08,.03,.29),new THREE.Vector3(-.02,.03,.33),new THREE.Vector3(-.1,.035,.31)]);
catTail.add(new THREE.Mesh(new THREE.TubeGeometry(tailPath,40,.03,10,false),catFurMat));for(var tsh=1;tsh<=CAT_SHELLS;tsh++)catTail.add(new THREE.Mesh(new THREE.TubeGeometry(tailPath,40,.03+.035*tsh/CAT_SHELLS,10,false),catShellMat(catFurMat,tsh)));
var tailTip=new THREE.Mesh(new THREE.SphereGeometry(.03,12,8),catFurMat);tailTip.position.copy(tailPath.getPoint(1));catTail.add(tailTip);catTail.position.set(.1,.035,-.13);gingerCat.add(catTail);
var catShadowTex=makeCanvasTexture(64,64,function(cx,w,h){var sh=cx.createRadialGradient(32,32,2,32,32,32);sh.addColorStop(0,'rgba(0,0,0,.55)');sh.addColorStop(1,'rgba(0,0,0,0)');cx.fillStyle=sh;cx.fillRect(0,0,w,h);});
var catShadow=catPart(new THREE.PlaneGeometry(.55,.6),new THREE.MeshBasicMaterial({map:catShadowTex,transparent:true,depthWrite:false}),0,.004,-.02);catShadow.rotation.x=-Math.PI/2;
var catBounce=new THREE.PointLight(0xffd0a1,.5,1.4,2);catBounce.position.set(0,.48,.55);gingerCat.add(catBounce);
// Seat her on the pavement beside the phone box, facing the street
gingerCat.position.set(-1.35, 0, -4.3);
gingerCat.rotation.y = 0.6;
scene.add(gingerCat);
var catState = { blinkT: 3 + Math.random() * 4, blinkHold: 0, headTurnT: 6 + Math.random() * 8, headTarget: 0 };

// ============================================================
// SILHOUETTES IN WINDOWS — gentle sway
// ============================================================
var silhouettes = [];

function makeSilhouetteTex(seed) {
  return makeCanvasTexture(256, 256, function(cx, w, h) {
    // Warm amber interior glow background
    var bg = cx.createRadialGradient(w/2, h*0.4, 10, w/2, h*0.5, w);
    bg.addColorStop(0, 'rgba(200, 140, 50, 0.5)');
    bg.addColorStop(0.5, 'rgba(160, 100, 30, 0.3)');
    bg.addColorStop(1, 'rgba(80, 50, 15, 0.15)');
    cx.fillStyle = bg;
    cx.fillRect(0, 0, w, h);

    // Dark silhouette figure
    var figureCount = 1 + Math.floor(seed * 1.5);
    for (var f = 0; f < figureCount; f++) {
      var fx = (w / (figureCount + 1)) * (f + 1);
      var baseY = h * 0.98;
      var headR = 14 + seed * 6;
      var shoulderW = 35 + seed * 15;

      cx.fillStyle = 'rgba(10, 5, 0, 0.85)';

      // Body
      cx.beginPath();
      cx.moveTo(fx - shoulderW/2, baseY - h*0.35);
      cx.lineTo(fx + shoulderW/2, baseY - h*0.35);
      cx.lineTo(fx + shoulderW/2 + 8, baseY);
      cx.lineTo(fx - shoulderW/2 - 8, baseY);
      cx.closePath();
      cx.fill();

      // Shoulders
      cx.beginPath();
      cx.ellipse(fx, baseY - h*0.38, shoulderW/2 + 5, 14, 0, 0, Math.PI, true);
      cx.fill();

      // Neck
      cx.fillRect(fx - 6, baseY - h*0.48, 12, h*0.1);

      // Head
      cx.beginPath();
      cx.arc(fx + (f - 1) * 4, baseY - h*0.52, headR, 0, Math.PI * 2);
      cx.fill();
    }
  });
}

// Silhouette in west side building (the lit windows)
function addSilhouette(x, y, z, faceX, seed) {
  var sTex = makeSilhouetteTex(seed);
  var sMat = new THREE.MeshBasicMaterial({
    map: sTex, transparent: true, side: THREE.DoubleSide, depthWrite: false
  });
  var sPlane = new THREE.Mesh(new THREE.PlaneGeometry(0.5, 1.0), sMat);
  if (faceX) {
    sPlane.rotation.y = Math.PI / 2;
  }
  sPlane.position.set(x, y, z);
  scene.add(sPlane);
  silhouettes.push({
    mesh: sPlane,
    baseX: x,
    baseY: y,
    baseZ: z,
    faceX: faceX,
    swayPhase: Math.random() * Math.PI * 2,
    swaySpeed: 0.2 + Math.random() * 0.4,
    swayAmt: 0.015 + Math.random() * 0.02
  });
}

// West building — lit windows
addSilhouette(-7.2, 8.5, 1.01, false, 0.5);
addSilhouette(-5.2, 5.5, 1.01, false, 0.8);
// East building — lit window
addSilhouette(4.0, 5, -4, true, 0.3);
// Building further north
addSilhouette(-4.0, 10.5, -9, true, 0.6);

