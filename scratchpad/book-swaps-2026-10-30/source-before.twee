    var tx = 44, tz = -70, ty = plainY(tx, tz);
    var tree=new THREE.Group();tree.position.set(tx,ty,tz);scene.add(tree);
    function limb(points,radii) {
      var sides=7,positions=[],uvs=[],indices=[];
      points.forEach(function(p,i) {
        var prev=points[Math.max(0,i-1)],next=points[Math.min(points.length-1,i+1)];
        var tangent=new THREE.Vector3(next[0]-prev[0],next[1]-prev[1],next[2]-prev[2]).normalize();
        var axis=new THREE.Vector3().crossVectors(tangent,new THREE.Vector3(0,0,1)).normalize();
        var other=new THREE.Vector3().crossVectors(tangent,axis).normalize();
        for(var k=0;k<=sides;k++) {
