<span id="dss-end-incomplete" hidden></span><script>setTimeout(function(){if(window.dssEndgameStage)window.dssEndgameStage("incomplete",document.getElementById("dss-end-incomplete"));},0);</script>\
<script>(function(){/* HTTP-prefetch the iframe HTML and the vendored THREE.js script. Avoiding a hidden iframe here because Chrome throttles script execution in off-screen iframes — Three.js inits but the scene-build script never runs, and we land on Dawn Approach with an empty canvas. Plain fetch puts the HTML in the cache; the THREE library link-preload primes the network so the fresh iframe on Dawn Approach mounts fast. */try{fetch('oxford-street-from-centre-point-3d-static.html',{cache:'force-cache'});}catch(e){}if(!document.getElementById('dss-three-prefetch')){var l=document.createElement('link');l.id='dss-three-prefetch';l.rel='preload';l.as='script';l.href='vendor/three/three.min.js';document.head.appendChild(l);}})();</script>\
