  // pavements and a span over the road, with a lamp hung in the middle
  x.save(); x.translate(43*T, 7*T);
  x.fillStyle = '#5a5248'; x.fillRect(2, 0, 4, 3*T + 8); x.fillRect(4*T - 6, 0, 4, 3*T + 8);
  x.fillStyle = '#7a7266'; x.fillRect(2, 0, 4, 2); x.fillRect(4*T - 6, 0, 4, 2);
  x.fillStyle = '#3e3832'; x.fillRect(2, 2, 4*T - 4, 3); x.fillStyle = '#2c2824'; x.fillRect(2, 5, 4*T - 4, 1);
  x.fillStyle = '#5a5248'; x.fillRect(2*T - 2, 5, 4, 3); x.fillStyle = '#ffd070'; x.fillRect(2*T - 1, 8, 2, 2);
  x.restore();
  // Soho Square: the Tudor hut in the middle of the garden
