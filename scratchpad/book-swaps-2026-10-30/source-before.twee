    fine.wire([[-0.33,0.55,-0.1],[-0.33,0.51,0],[-0.33,0.55,0.1]],0.008,0x6d6757,g);
    g.position.set(1.4, 0, 1.7); g.rotation.y = 0.5; scene.add(g);
  })();

  // ------------------------------------------------------------
  // PENDANTS
  // ------------------------------------------------------------
  var pendants = [], pendantGroups = [];
  function pendant(x, z, lit) {
    var y = 2.35, g = new THREE.Group();
    cyl(0.012, 0.012, 4.1 - y, 6, new THREE.MeshStandardMaterial({ color: 0x111 }), 0, (4.1 - y) / 2, 0, g);
    var shade = new THREE.Mesh(new THREE.ConeGeometry(0.34, 0.32, 20, 1, true), new THREE.MeshStandardMaterial({ color: 0x2a4a3a, roughness: 0.35, metalness: 0.5, side: THREE.DoubleSide })); shade.position.set(0, 0.05, 0); g.add(shade);
    var inner = new THREE.Mesh(new THREE.ConeGeometry(0.32, 0.3, 20, 1, true), new THREE.MeshBasicMaterial({ color: 0xfff0d0, side: THREE.BackSide })); inner.position.set(0, 0.04, 0); g.add(inner);
    var bulb = new THREE.Mesh(new THREE.SphereGeometry(0.06, 10, 10), new THREE.MeshBasicMaterial({ color: 0xffe8b0 })); bulb.position.set(0, -0.06, 0); g.add(bulb);
    // 2026-10-14 (speed): a real light in five of the eight shades, a little brighter; the other three keep bulb and glow
    var light = null; if (lit) { light = new THREE.PointLight(0xffb464, 1.9, 10, 2); light.position.set(0, -0.15, 0); light.userData.base = 1.9; g.add(light); }
    glowSprite('rgba(255,200,120,', 1.0, 0, -0.1, 0, g);
    g.position.set(x, y, z); scene.add(g); if (light) pendants.push(light); pendantGroups.push({ g: g, ph: Math.random() * 6 });
  }
  [[-4.3, -3], [0, -3], [4.3, -3], [-4.3, -7], [0, -7], [4.3, -7], [-3, -11], [3, -11]].forEach(function(p, i) { pendant(p[0], p[1], i === 1 || i === 3 || i === 5 || i === 6 || i === 7); });

  // ------------------------------------------------------------
  // FURNITURE, with what sits on it
  // ------------------------------------------------------------
  var tableTop = new THREE.MeshStandardMaterial({ color: 0x3a2618, roughness: 0.4 });
  var tableLeg = new THREE.MeshStandardMaterial({ color: 0x1a1512, roughness: 0.5, metalness: 0.5 });
  var chairWood = new THREE.MeshStandardMaterial({ color: 0x5a3a22, roughness: 0.7 });
  var chairSeatMats = [0xb8a48a, 0x8a5a2c, 0x2e7b7a, 0x6b2f3a].map(function(c) { return new THREE.MeshStandardMaterial({ color: c, roughness: 0.85 }); });
  var glassMat = new THREE.MeshStandardMaterial({ color: 0xe8f0f8, roughness: 0.05, metalness: 0.1, transparent: true, opacity: 0.35 });
  var beerMat = new THREE.MeshStandardMaterial({ color: 0xd08a20, roughness: 0.1, transparent: true, opacity: 0.85 });
  var foamMat = new THREE.MeshStandardMaterial({ color: 0xf4ead0, roughness: 0.9 });
  var menuMat = new THREE.MeshStandardMaterial({ color: 0xe8e0c8, roughness: 0.9 });

  function pint(x, y, z, fill) {
    cyl(0.045, 0.04, 0.16, 10, glassMat, x, y + 0.08, z);
    if (fill) { cyl(0.04, 0.036, 0.16 * fill, 10, beerMat, x, y + 0.08 * fill, z); cyl(0.04, 0.04, 0.02, 10, foamMat, x, y + 0.16 * fill + 0.01, z); }
  }
  function tealight(x, y, z) {
    cyl(0.03, 0.03, 0.025, 8, new THREE.MeshStandardMaterial({ color: 0x9a9a9a, roughness: 0.3, metalness: 0.8 }), x, y + 0.012, z);
    glowSprite('rgba(255,170,70,', 0.22, x, y + 0.05, z);
  }
  function dressTable(x, y, z, round) {
    var n = 1 + Math.floor(Math.random() * 3);
    for (var i = 0; i < n; i++) pint(x + rand(-0.3, 0.3), y, z + rand(-0.22, 0.22), Math.random() < 0.7 ? rand(0.2, 0.95) : 0);
    if (Math.random() < 0.6) tealight(x + rand(-0.1, 0.1), y, z + rand(-0.1, 0.1));
    if (Math.random() < 0.5) { var m = box(0.1, 0.16, 0.01, menuMat, x + rand(-0.25, 0.25), y + 0.08, z + rand(-0.2, 0.2), { cast: false }); m.rotation.y = rand(0, 6); }
  }
  function table(x, z, round) {
    var top = round ? new THREE.Mesh(new THREE.CylinderGeometry(0.45, 0.45, 0.05, 20), tableTop) : new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.05, 0.7), tableTop);
    top.position.set(x, 0.76, z); top.castShadow = true; top.receiveShadow = true; scene.add(top);
    if (round) { cyl(0.04, 0.04, 0.74, 8, tableLeg, x, 0.37, z); cyl(0.25, 0.25, 0.03, 16, tableLeg, x, 0.015, z); }
    else [[-0.45, -0.3], [0.45, -0.3], [-0.45, 0.3], [0.45, 0.3]].forEach(function(p) { box(0.05, 0.74, 0.05, tableLeg, x + p[0], 0.37, z + p[1]); });
    dressTable(x, 0.785, z, round);
  }
  function chair(x, z, rot, seatMat) {
    var g = new THREE.Group();
    box(0.42, 0.06, 0.42, seatMat, 0, 0.46, 0, { parent: g });
    box(0.42, 0.5, 0.05, chairWood, 0, 0.74, -0.19, { parent: g });
    [[-0.18, -0.18], [0.18, -0.18], [-0.18, 0.18], [0.18, 0.18]].forEach(function(p) { box(0.04, 0.46, 0.04, chairWood, p[0], 0.23, p[1], { parent: g, cast: false }); });
    g.position.set(x, 0, z); g.rotation.y = rot; scene.add(g);
    return g;
  }
  var figures = [];
  function seatedFigure(x, z, seed) {
    var s = new THREE.Sprite(new THREE.SpriteMaterial({ map: figureTex(true, seed), transparent: true, depthWrite: false }));
    s.scale.set(0.7, 1.4, 1); s.position.set(x, 0.72, z); scene.add(s);
    figures.push({ sprite: s, baseX: x, phase: Math.random() * 6, speed: 0.6 + Math.random() * 0.6, amt: 0.015 + Math.random() * 0.02 });
  }
  function tableSet(x, z, round, n, occupied) {
    table(x, z, round);
    var seat = chairSeatMats[Math.floor(Math.random() * chairSeatMats.length)];
    var r = round ? 0.72 : 0.78;
    for (var i = 0; i < n; i++) {
      var a = (i / n) * Math.PI * 2 + (round ? 0.4 : 0);
      var cx = x + Math.sin(a) * r, cz = z + Math.cos(a) * r;
      chair(cx, cz, a + Math.PI, seat);
      if (occupied && occupied.indexOf(i) >= 0) seatedFigure(cx, cz - 0.02, Math.random());
    }
  }
  tableSet(-4.4, -3.1, true, 3, [1]);
  tableSet(0.2, -3.4, false, 4, [0, 2]);
  tableSet(4.4, -2.9, true, 2, []);
  tableSet(-4.2, -7.2, false, 4, [1]);
  tableSet(0.4, -7.4, true, 3, []);
  tableSet(4.5, -7.0, false, 4, [0, 1]);
  tableSet(-2.4, -10.6, true, 2, []);
  tableSet(3.0, -10.8, true, 3, [2]);

