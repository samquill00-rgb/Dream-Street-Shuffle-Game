case 'BLACK CAB':
/* ══ Classic London Black Cab – SIDE VIEW ══ */
var hw=t.w/2, hh=t.h/2;

/* drop shadow */
ctx.fillStyle='rgba(0,0,0,0.35)';
ctx.beginPath(); ctx.ellipse(2,hh+2,hw-4,6,0,0,Math.PI*2); ctx.fill();

/* main body – boxy classic side profile */
ctx.fillStyle='#141420';
ctx.beginPath();
ctx.moveTo(-hw+4, hh-10);
ctx.lineTo(-hw+4, -hh+16);
ctx.quadraticCurveTo(-hw+8, -hh+4, -hw+20, -hh+2);
ctx.lineTo(hw-20, -hh+2);
ctx.quadraticCurveTo(hw-8, -hh+4, hw-4, -hh+16);
ctx.lineTo(hw-4, hh-10);
ctx.closePath(); ctx.fill();

/* bonnet – front lower */
ctx.fillStyle='#181828';
ctx.beginPath();
ctx.moveTo(-hw+4, hh-10); ctx.lineTo(-hw, hh-10);
ctx.lineTo(-hw, -hh+18); ctx.lineTo(-hw+4, -hh+16);
ctx.closePath(); ctx.fill();

/* boot – rear lower */
ctx.fillStyle='#181828';
ctx.beginPath();
ctx.moveTo(hw-4, hh-10); ctx.lineTo(hw, hh-10);
ctx.lineTo(hw, -hh+18); ctx.lineTo(hw-4, -hh+16);
ctx.closePath(); ctx.fill();

/* windows */
ctx.fillStyle='rgba(25,40,65,0.7)';
ctx.beginPath();
ctx.moveTo(-hw+8, -hh+6); ctx.lineTo(-10, -hh+6);
ctx.lineTo(-10, -hh+20); ctx.lineTo(-hw+8, -hh+18);
ctx.closePath(); ctx.fill();
ctx.beginPath();
ctx.moveTo(-4, -hh+6); ctx.lineTo(hw-12, -hh+6);
ctx.lineTo(hw-8, -hh+18); ctx.lineTo(-4, -hh+20);
ctx.closePath(); ctx.fill();

/* B-pillar */
ctx.fillStyle='#141420';
ctx.fillRect(-10, -hh+4, 6, 18);

/* chrome window trim */
ctx.strokeStyle='#606878'; ctx.lineWidth=1;
ctx.beginPath(); ctx.moveTo(-hw+6,-hh+18); ctx.lineTo(hw-6,-hh+18); ctx.stroke();

/* door line + handle */
ctx.strokeStyle='rgba(40,40,50,0.5)'; ctx.lineWidth=0.5;
ctx.beginPath(); ctx.moveTo(-6,-hh+18); ctx.lineTo(-6,hh-12); ctx.stroke();
ctx.fillStyle='#707880';
ctx.fillRect(2,-hh+22,6,2);

/* headlight */
ctx.fillStyle='#e8d870';
ctx.beginPath(); ctx.arc(-hw+2, -hh+24, 4, 0, Math.PI*2); ctx.fill();
ctx.fillStyle='rgba(232,216,110,0.10)';
ctx.beginPath(); ctx.ellipse(-hw-4,-hh+24,8,6,0,0,Math.PI*2); ctx.fill();

/* tail light + indicator */
ctx.fillStyle='#cc2020';
ctx.beginPath(); ctx.arc(hw-2, -hh+24, 3, 0, Math.PI*2); ctx.fill();
ctx.fillStyle='#e8a030';
ctx.beginPath(); ctx.arc(hw-2, -hh+30, 2, 0, Math.PI*2); ctx.fill();

/* bumpers */
ctx.fillStyle='#505060';
ctx.fillRect(-hw-1, hh-12, 4, 3);
ctx.fillRect(hw-3, hh-12, 4, 3);

/* wheels */
ctx.fillStyle='#0a0a14';
ctx.beginPath(); ctx.arc(-hw+18, hh-8, 9, 0, Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.arc(hw-18, hh-8, 9, 0, Math.PI*2); ctx.fill();
ctx.strokeStyle='#222230'; ctx.lineWidth=2;
ctx.beginPath(); ctx.arc(-hw+18, hh-8, 9, 0, Math.PI*2); ctx.stroke();
ctx.beginPath(); ctx.arc(hw-18, hh-8, 9, 0, Math.PI*2); ctx.stroke();
ctx.fillStyle='#404050';
ctx.beginPath(); ctx.arc(-hw+18, hh-8, 4, 0, Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.arc(hw-18, hh-8, 4, 0, Math.PI*2); ctx.fill();
ctx.strokeStyle='#505060'; ctx.lineWidth=1;
[-hw+18,hw-18].forEach(function(wx){
ctx.beginPath(); ctx.moveTo(wx-3,hh-8); ctx.lineTo(wx+3,hh-8); ctx.stroke();
ctx.beginPath(); ctx.moveTo(wx,hh-11); ctx.lineTo(wx,hh-5); ctx.stroke();
});

/* TAXI sign on roof */
ctx.fillStyle='#d4a830';
ctx.fillRect(-8, -hh-1, 16, 6);
ctx.fillStyle='#1a1418'; ctx.font='bold 5px monospace'; ctx.textAlign='center';
ctx.fillText('TAXI',0,-hh+4);
ctx.fillStyle='rgba(212,168,48,0.12)';
ctx.beginPath(); ctx.ellipse(0,-hh+2,14,8,0,0,Math.PI*2); ctx.fill();

/* number plate */
ctx.fillStyle='#e8d860';
ctx.fillRect(hw-8, hh-16, 8, 4);
ctx.fillStyle='#1a1a20'; ctx.font='bold 3px monospace';
ctx.fillText('73',hw-4,hh-13);
break;

case 'UBER':
/* ══ Modern Uber – SIDE VIEW (same structure as cab but sleeker) ══ */
var uw=t.w/2, uh=t.h/2;

/* drop shadow */
ctx.fillStyle='rgba(0,0,0,0.3)';
ctx.beginPath(); ctx.ellipse(2,uh+2,uw-4,5,0,0,Math.PI*2); ctx.fill();

/* main body – silver, lower roofline than cab */
ctx.fillStyle='#b8b8c8';
ctx.beginPath();
ctx.moveTo(-uw+4, uh-10);
ctx.lineTo(-uw+4, -uh+20);
ctx.quadraticCurveTo(-uw+10, -uh+6, -uw+24, -uh+4);
ctx.lineTo(uw-28, -uh+4);
ctx.quadraticCurveTo(uw-10, -uh+4, uw-4, -uh+14);
ctx.lineTo(uw-4, uh-10);
ctx.closePath(); ctx.fill();

/* bonnet – front lower, sloped */
ctx.fillStyle='#c0c0d0';
ctx.beginPath();
ctx.moveTo(-uw+4, uh-10); ctx.lineTo(-uw, uh-10);
ctx.lineTo(-uw+2, -uh+22); ctx.lineTo(-uw+4, -uh+20);
ctx.closePath(); ctx.fill();

/* boot – rear, sloped hatchback */
ctx.fillStyle='#acacbc';
ctx.beginPath();
ctx.moveTo(uw-4, uh-10); ctx.lineTo(uw, uh-10);
ctx.lineTo(uw, -uh+16); ctx.lineTo(uw-4, -uh+14);
ctx.closePath(); ctx.fill();

/* windows – tinted dark, larger */
ctx.fillStyle='rgba(15,25,50,0.75)';
ctx.beginPath();
ctx.moveTo(-uw+12, -uh+8);
ctx.lineTo(-8, -uh+8);
ctx.lineTo(-8, -uh+22);
ctx.lineTo(-uw+10, -uh+22);
ctx.closePath(); ctx.fill();
ctx.beginPath();
ctx.moveTo(-2, -uh+8);
ctx.lineTo(uw-16, -uh+8);
ctx.quadraticCurveTo(uw-8, -uh+10, uw-6, -uh+18);
ctx.lineTo(-2, -uh+22);
ctx.closePath(); ctx.fill();

/* B-pillar */
ctx.fillStyle='#b8b8c8';
ctx.fillRect(-8, -uh+6, 6, 18);

/* chrome trim along window line */
ctx.strokeStyle='rgba(200,200,210,0.4)'; ctx.lineWidth=0.5;
ctx.beginPath(); ctx.moveTo(-uw+8,-uh+22); ctx.lineTo(uw-6,-uh+22); ctx.stroke();

/* door line + handle */
ctx.strokeStyle='rgba(150,150,160,0.35)'; ctx.lineWidth=0.5;
ctx.beginPath(); ctx.moveTo(-4,-uh+22); ctx.lineTo(-4,uh-12); ctx.stroke();
ctx.fillStyle='#d0d0d8';
ctx.fillRect(4,-uh+26,5,2);

/* headlights – thin LED strip */
ctx.fillStyle='#e8e8ff';
ctx.fillRect(-uw, -uh+24, 8, 2);
/* DRL accent */
ctx.fillStyle='rgba(200,220,255,0.3)';
ctx.fillRect(-uw, -uh+27, 6, 1);

/* tail lights – red LED bar */
ctx.fillStyle='#dd2020';
ctx.fillRect(uw-6, -uh+18, 6, 8);
/* tail glow */
ctx.fillStyle='rgba(220,30,20,0.10)';
ctx.beginPath(); ctx.ellipse(uw+2,-uh+22,6,6,0,0,Math.PI*2); ctx.fill();

/* bumpers – body colour */
ctx.fillStyle='#a0a0b0';
ctx.fillRect(-uw-1, uh-12, 4, 3);
ctx.fillRect(uw-3, uh-12, 4, 3);

/* wheels */
ctx.fillStyle='#0a0a14';
ctx.beginPath(); ctx.arc(-uw+16, uh-8, 8, 0, Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.arc(uw-16, uh-8, 8, 0, Math.PI*2); ctx.fill();
ctx.strokeStyle='#2a2a34'; ctx.lineWidth=2;
ctx.beginPath(); ctx.arc(-uw+16, uh-8, 8, 0, Math.PI*2); ctx.stroke();
ctx.beginPath(); ctx.arc(uw-16, uh-8, 8, 0, Math.PI*2); ctx.stroke();
/* alloy centres */
ctx.fillStyle='#707080';
ctx.beginPath(); ctx.arc(-uw+16, uh-8, 3, 0, Math.PI*2); ctx.fill();
ctx.beginPath(); ctx.arc(uw-16, uh-8, 3, 0, Math.PI*2); ctx.fill();

/* phone glow on dash */
ctx.fillStyle='rgba(80,180,255,0.30)';
ctx.fillRect(-uw+14, -uh+12, 4, 3);

/* blue U light on windscreen */
ctx.fillStyle='rgba(80,180,255,0.20)';
ctx.beginPath(); ctx.ellipse(-uw+16,-uh+6,5,3,0,0,Math.PI*2); ctx.fill();
ctx.fillStyle='rgba(80,180,255,0.5)'; ctx.font='bold 5px sans-serif'; ctx.textAlign='center';
ctx.fillText('U',-uw+16,-uh+8);
break;
}
ctx.restore();
}

/* ── HUD ── */
/* Cabinet effects are decorative; all lanes, timings and collision boxes stay unchanged. */
function drawArcadeRoad(){
  var clock=arcadeReduced?0:Date.now(),tier=phase==='real'?Math.min(7,Math.floor((Date.now()-phaseStart)/5000)):0;
  ctx.save();
  for(var lane=1;lane<LANE_COUNT;lane++){
    ctx.strokeStyle=lane===1?'rgba(57,220,232,.19)':'rgba(240,87,181,.19)';ctx.lineWidth=1;
    ctx.setLineDash([11,27]);ctx.lineDashOffset=arcadeReduced?0:-roadScroll*.8;ctx.beginPath();ctx.moveTo(lane*LANE_W,40);ctx.lineTo(lane*LANE_W,H-36);ctx.stroke();
  }
  ctx.setLineDash([]);
  if(phase==='real' && !gameOver){
    for(var streak=0;streak<12;streak++){
      var y=((clock*(.13+tier*.018)+streak*47)%(H+60))-30,x=streak%2?W-14:14;
      ctx.strokeStyle=streak%3?'rgba(73,221,235,.24)':'rgba(255,110,189,.24)';ctx.lineWidth=1+(streak%3)*.3;
      ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,y+7+tier*2);ctx.stroke();
    }
  }
  ctx.restore();
}
function arcadePop(text,x,y,color,big){
  if(arcadeReduced)return;
  arcadePops.push({text:text,x:x,y:y,color:color,big:big,born:Date.now()});if(arcadePops.length>6)arcadePops.shift();
}
function drawArcadeCabinet(){
  var now=Date.now(),clock=arcadeReduced?0:now;
  if(phase==='real' && !gameOver){
    if(dodged!==arcadeDodged){if(dodged>arcadeDodged)arcadePop('+1',W-48,51,'#72f4f1',false);arcadeDodged=dodged;}
    if(lives<arcadeLives)arcadePop('HIT!',playerX,PLAYER_Y-58,'#ff9370',true);arcadeLives=lives;
    if(nearMissAt!==arcadeNear){arcadeNear=nearMissAt;if(nearMissAt)arcadePop('NEAR MISS!',W/2,PLAYER_Y-85,'#ffe27a',false);}
    var tier=Math.min(7,Math.floor((now-phaseStart)/5000));
    if(tier!==arcadeTier){if(tier>0)arcadePop(['TROT','CANTER','GALLOP','CHARGE','RAMPAGE','CHAOS','BEDLAM','ARMAGEDDON'][tier]+'!',W/2,92,tier%2?'#ff8bd6':'#79efff',true);arcadeTier=tier;}
  }else if(phase==='countdown'){arcadeDodged=0;arcadeLives=3;arcadeTier=-1;arcadeNear=nearMissAt;arcadePops=[];}
  ctx.save();
  arcadePops=arcadePops.filter(function(pop){var age=(now-pop.born)/1000;if(age>.9)return false;
    ctx.save();ctx.translate(pop.x,pop.y-age*27);ctx.globalAlpha=Math.min(1,(.9-age)*3);ctx.textAlign='center';ctx.font='bold '+(pop.big?20:12)+'px monospace';
    if(pop.big){ctx.strokeStyle='#0a0713';ctx.lineWidth=4;ctx.strokeText(pop.text,0,2);}
    ctx.fillStyle=pop.color;ctx.shadowColor=pop.color;ctx.shadowBlur=pop.big?6:3;ctx.fillText(pop.text,0,0);ctx.restore();return true;
  });
  // Dark scanlines and individual chasing bulbs, never a whole-screen strobe.
  ctx.fillStyle='rgba(0,0,0,.045)';for(var y=2;y<H;y+=4)ctx.fillRect(0,y,W,1);
  ctx.strokeStyle='#633875';ctx.lineWidth=2;ctx.strokeRect(1,1,W-2,H-2);
  var palette=['#ff81c6','#68e9ed','#ffd56a'];
  var lamps=Math.floor((W+H)*2/16);
  for(var bulb=0;bulb<lamps;bulb++){
    var distance=bulb/lamps*(2*W+2*H),x,y;
    if(distance<W){x=distance;y=4;}else if(distance<W+H){x=W-4;y=distance-W;}else if(distance<W*2+H){x=W-(distance-W-H);y=H-4;}else{x=4;y=H-(distance-W*2-H);}
    var pulse=arcadeReduced?.6:.35+.45*(.5+.5*Math.sin(clock/470-bulb*.58));ctx.globalAlpha=pulse;ctx.fillStyle=palette[bulb%3];ctx.fillRect(Math.round(x)-1,Math.round(y)-1,2.5,2.5);
  }
  ctx.restore();
}

function drawHUD(){
if(phase==='title'){
/* dark overlay */
ctx.fillStyle='rgba(4,4,12,0.80)'; ctx.fillRect(0,0,W,H);
ctx.textAlign='center';
/* title */
ctx.fillStyle='#ffe083'; ctx.font='bold 22px monospace';ctx.shadowColor='#f455ac';ctx.shadowBlur=12;
ctx.fillText('RIDE THE COW',W/2,H/2-60);ctx.shadowBlur=0;
/* flavour text */
ctx.fillStyle='#a08030'; ctx.font='italic 12px serif';
ctx.fillText('Down Dean Street, through the night.',W/2,H/2-34);
/* instructions removed \u2014 the rules popup teaches; title screen stays clean */
/* start prompt */
var pulse=0.5+0.5*Math.sin(Date.now()/400);
ctx.fillStyle='rgba(232,192,96,'+pulse+')'; ctx.font='bold 14px monospace';
ctx.fillText('CLICK TO START',W/2,H/2+86);
return;
}
if(phase==='practice'){
/* practice label */
ctx.fillStyle='rgba(0,0,0,0.5)';
ctx.fillRect(W/2-70, 18, 140, 22);
ctx.fillStyle='#c89030'; ctx.font='bold 12px monospace'; ctx.textAlign='center';
ctx.fillText('PRACTICE ROUND', W/2, 33);
/* ghost timer */
var rem=Math.max(0, PRACTICE_TIME-(Date.now()-phaseStart));
ctx.fillStyle='rgba(140,100,20,0.5)'; ctx.font='10px monospace';
ctx.fillText(Math.ceil(rem/1000)+'s', W/2, 48);
/* no-collision note */
ctx.fillStyle='rgba(100,80,20,0.4)'; ctx.font='9px monospace';
ctx.fillText('no collisions \u2013 learn the feel', W/2, H-12);
}
if(phase==='countdown'){
var elapsed=Date.now()-countdownAt;
ctx.fillStyle='rgba(4,4,12,0.65)'; ctx.fillRect(0,0,W,H);
ctx.textAlign='center';
if(elapsed<800){
ctx.fillStyle='#e8c060'; ctx.font='bold 44px serif';
ctx.fillText('READY',W/2,H/2-10);
} else if(elapsed<1600){
ctx.fillStyle='#c89030'; ctx.font='bold 44px serif';
ctx.fillText('SET',W/2,H/2-10);
} else {
ctx.fillStyle='#e8c060'; ctx.font='bold 52px serif';
ctx.fillText('RIDE!',W/2,H/2-10);
}
}
if(phase==='real'){
/* timer bar at top */
var rem2=Math.max(0, REAL_TIME-(Date.now()-phaseStart));
var pct=rem2/REAL_TIME;
var bx=20, by=8, bw=W-40, bh=10;
ctx.fillStyle='rgba(0,0,0,0.55)'; ctx.fillRect(bx,by,bw,bh);
ctx.fillStyle=pct>0.3?'rgba(180,120,20,0.8)':'rgba(220,70,20,0.9)';
ctx.fillRect(bx,by,bw*pct,bh);
ctx.strokeStyle='rgba(140,90,10,0.5)'; ctx.lineWidth=1;
ctx.strokeRect(bx,by,bw,bh);
ctx.fillStyle='#c89030'; ctx.font='9px monospace'; ctx.textAlign='center';
/* speed tier indicator */
var el3=Date.now()-phaseStart;
var tier2=Math.min(7,Math.floor(el3/5000));
var tierNames=['TROT','CANTER','GALLOP','CHARGE','RAMPAGE','CHAOS','BEDLAM','ARMAGEDDON'];
ctx.fillStyle='rgba(0,0,0,0.5)'; ctx.fillRect(W/2-36,20,72,14);
var tierCol=tier2<2?'#a08030':(tier2<4?'#c87020':(tier2<6?'#e86020':'#ff3020'));
ctx.fillStyle=tierCol; ctx.font='bold 9px monospace'; ctx.textAlign='center';
ctx.fillText(tierNames[tier2],W/2,31);
ctx.fillText(Math.ceil(rem2/1000)+'s',W/2,by+bh-1);
/* lives display – top left */
ctx.textAlign='left';
for(var li=0;li<3;li++){
var lx=8+li*18, ly=24;
if(li<lives){
/* filled heart / cow head */
ctx.fillStyle='#e8c060';
ctx.beginPath(); ctx.arc(lx,ly,6,0,Math.PI*2); ctx.fill();
ctx.fillStyle='#c89830';
ctx.beginPath(); ctx.arc(lx,ly,4,0,Math.PI*2); ctx.fill();
} else {
/* empty (lost life) */
ctx.strokeStyle='rgba(200,120,20,0.3)'; ctx.lineWidth=1.5;
ctx.beginPath(); ctx.arc(lx,ly,6,0,Math.PI*2); ctx.stroke();
/* X through it */
ctx.strokeStyle='rgba(220,60,30,0.5)'; ctx.lineWidth=1.5;
ctx.beginPath(); ctx.moveTo(lx-4,ly-4); ctx.lineTo(lx+4,ly+4); ctx.stroke();
ctx.beginPath(); ctx.moveTo(lx+4,ly-4); ctx.lineTo(lx-4,ly+4); ctx.stroke();
}
}
/* dodged counter — top right */
ctx.textAlign='right';
ctx.fillStyle='rgba(0,0,0,0.5)'; ctx.fillRect(W-78, 18, 70, 14);
ctx.fillStyle='#e8c060'; ctx.font='bold 9px monospace';
ctx.fillText('DODGED ' + dodged, W-12, 28);
}
/* controls hint */
/* 2026-10-14 (overnight report, Sam: fix): it sat on the RIGHT lane label; now top left, and on a touch screen the rules card says it */
if((phase==='practice'||phase==='real') && !(window.matchMedia&&window.matchMedia('(hover: none) and (pointer: coarse)').matches)){
ctx.fillStyle='rgba(100,80,20,0.45)'; ctx.font='8px monospace'; ctx.textAlign='left';
ctx.fillText('\u2190\u2192 or click a lane',8,12);
}
}

/* End-screen button hit zones (read by the click handler). */
var END_BTN = { y: 0, h: 24, w: 110, leftX: 0, rightX: 0 };

function drawEnd(){
// Victory sparks — stream off the cow through the gallop-out and briefly
// over the overlay reveal. Updated here so they animate whenever the end
// state is drawn.
if(wonGame && winSparks.length){
for(var wsi=winSparks.length-1; wsi>=0; wsi--){
var s=winSparks[wsi];
s.x+=s.vx; s.y+=s.vy; s.vy+=0.05; s.life-=0.012;
if(s.life<=0){ winSparks.splice(wsi,1); continue; }
ctx.fillStyle='rgba(232,192,96,'+(s.life*0.9)+')';
ctx.beginPath(); ctx.arc(s.x, s.y, 1.2+s.life*1.8, 0, 6.283); ctx.fill();
}
/* keep a light trail coming while the cow gallops out */
if((Date.now()-wonAt)<1200 && Math.random()<0.5){
winSparks.push({ x:playerX+(Math.random()-0.5)*40, y:PLAYER_Y+(Math.random()-0.5)*30,
vx:(Math.random()-0.5)*2.2, vy:-1.2-Math.random()*2.6, life:1 });
}
}
// Brief grace period after winning — the cow keeps galloping, no overlay yet
if(wonGame && (Date.now() - wonAt) < 1200) return;
ctx.fillStyle='rgba(4,4,12,0.85)'; ctx.fillRect(0,0,W,H);
ctx.textAlign='center';
if(wonGame){
/* Overlay reveal flash — warm gold, fading over ~450ms */
var ovAge = Date.now() - wonAt - 1200;
if(ovAge < 450){ ctx.fillStyle='rgba(232,192,96,'+(0.32*(1-ovAge/450))+')'; ctx.fillRect(0,0,W,H); }
ctx.shadowColor='rgba(232,192,96,0.85)';
ctx.shadowBlur=14+8*Math.sin(Date.now()/280);
ctx.fillStyle='#e8c060'; ctx.font='bold 26px serif';
ctx.fillText('YOU RODE IT.',W/2,H/2-50);
ctx.shadowBlur=0;
ctx.fillStyle='#d4a560'; ctx.font='italic 14px serif';
ctx.fillText('You reach the end of Soho',W/2,H/2-22);
ctx.fillText('at Charing Cross Road.',W/2,H/2-4);
ctx.fillStyle='#786020'; ctx.font='10px monospace';
ctx.fillText('obstacles dodged: ' + dodged, W/2, H/2+22);
} else {
ctx.fillStyle='#8a6030'; ctx.font='bold 28px serif';
ctx.fillText('THROWN.',W/2,H/2-50);
ctx.fillStyle='#6a4020'; ctx.font='italic 14px serif';
ctx.fillText('The street wins tonight.',W/2,H/2-22);
ctx.fillStyle='#504018'; ctx.font='10px monospace';
ctx.fillText('obstacles dodged: ' + dodged, W/2, H/2+2);
}
/* Two buttons: RIDE AGAIN | CONTINUE */
if(document.querySelector('.canvas-bail')) return; /* 2026-10-24 (Sam, Q9): the stall bail already fired and is the way out; no second pair of buttons */
END_BTN.y = H/2 + 50;
END_BTN.leftX = W/2 - END_BTN.w - 8;
END_BTN.rightX = W/2 + 8;
ctx.textAlign='center';
[ {x:END_BTN.leftX, label:'RIDE AGAIN'}, {x:END_BTN.rightX, label:'CONTINUE'} ].forEach(function(b){
ctx.fillStyle='rgba(80,60,20,0.45)';
ctx.fillRect(b.x, END_BTN.y, END_BTN.w, END_BTN.h);
ctx.strokeStyle='rgba(200,160,60,0.55)'; ctx.lineWidth=1;
ctx.strokeRect(b.x, END_BTN.y, END_BTN.w, END_BTN.h);
ctx.fillStyle='#e8c060'; ctx.font='bold 11px monospace';
ctx.fillText(b.label, b.x + END_BTN.w/2, END_BTN.y + 16);
});
}

/* Test whether (cx, cy) hits one of the end-screen buttons. */
function endBtnHit(cx, cy){
if(cy < END_BTN.y || cy > END_BTN.y + END_BTN.h) return null;
if(cx >= END_BTN.leftX && cx < END_BTN.leftX + END_BTN.w) return 'again';
if(cx >= END_BTN.rightX && cx < END_BTN.rightX + END_BTN.w) return 'continue';
return null;
}

/* ── Input: LEFT/RIGHT ── */
function onKey(e){
if(phase==='title'){ startCowMusic(); phase='countdown'; countdownAt=Date.now(); phaseStart=Date.now(); return; }
if(gameOver){ if(e.key==='Enter'){ e.preventDefault(); navigate(); } return; } /* 2026-10-14 overnight: the end buttons live on the canvas, so Enter continues for a keyboard player */
if(phase==='countdown') return;
var now=Date.now(); if(now-lastKeyAt<90) return; /* was 120 — keyboard swerves keep up with the top tiers */
/* Lane flash + whoosh on keyboard swerves too, so all three input routes
   (keys, click, touch) feel identical. */
if(e.key==='ArrowLeft'||e.key==='a'||e.key==='A'){
if(playerLane>0){ playerLane--; targetX=LANE_X[playerLane]; lastKeyAt=now; clickFlash=playerLane; clickFlashAt=now; if(window.dssAudio)window.dssAudio.cowMooShort(); }
e.preventDefault();
} else if(e.key==='ArrowRight'||e.key==='d'||e.key==='D'){
if(playerLane<LANE_COUNT-1){ playerLane++; targetX=LANE_X[playerLane]; lastKeyAt=now; clickFlash=playerLane; clickFlashAt=now; if(window.dssAudio)window.dssAudio.cowMooShort(); }
e.preventDefault();
}
}
document.addEventListener('keydown',onKey);

/* track mouse hover for lane highlight */
canvas.addEventListener('mousemove',function(e){
var r=canvas.getBoundingClientRect();
var cx=(e.clientX-r.left)*(W/r.width);
hoverLane=Math.max(0,Math.min(LANE_COUNT-1,Math.floor(cx/LANE_W)));
});
canvas.addEventListener('mouseleave',function(){ hoverLane=-1; });

canvas.addEventListener('click',function(e){
if(phase==='title'){ startCowMusic(); phase='countdown'; countdownAt=Date.now(); phaseStart=Date.now(); return; }
var r=canvas.getBoundingClientRect();
var cx=(e.clientX-r.left)*(W/r.width);
var cy=(e.clientY-r.top)*(H/r.height);
if(gameOver){
if(document.querySelector('.canvas-bail')) return; /* 2026-10-24 (Sam, Q9): the bail is the way out */
var hit = endBtnHit(cx, cy);
if(hit === 'again') restart();
else if(hit === 'continue') navigate();
return;
}
if(phase==='countdown') return;
var nl=Math.max(0,Math.min(LANE_COUNT-1,Math.floor(cx/LANE_W)));
playerLane=nl; targetX=LANE_X[nl];
clickFlash=nl; clickFlashAt=Date.now(); if(window.dssAudio)window.dssAudio.cowMooShort();
});

canvas.addEventListener('touchstart',function(e){
e.preventDefault();
if(phase==='title'){ startCowMusic(); phase='countdown'; countdownAt=Date.now(); phaseStart=Date.now(); return; }
var r=canvas.getBoundingClientRect();
var cx=(e.touches[0].clientX-r.left)*(W/r.width);
var cy=(e.touches[0].clientY-r.top)*(H/r.height);
if(gameOver){
if(document.querySelector('.canvas-bail')) return; /* 2026-10-24 (Sam, Q9): the bail is the way out */
var hit = endBtnHit(cx, cy);
if(hit === 'again') restart();
else if(hit === 'continue') navigate();
return;
}
if(phase==='countdown') return;
var nl=Math.max(0,Math.min(LANE_COUNT-1,Math.floor(cx/LANE_W)));
playerLane=nl; targetX=LANE_X[nl];
clickFlash=nl; clickFlashAt=Date.now(); if(window.dssAudio)window.dssAudio.cowMooShort();
},{passive:false});

/* ── Navigate to Harlowe passage ── */
function navigate() {
document.removeEventListener('keydown', onKey);
if (audioTicker) { clearInterval(audioTicker); audioTicker = null; }
stopCowMusic();
var id = wonGame ? 'cow-go-win' : 'cow-go-lose';
var sp = document.getElementById(id);
if (sp){ var lk=sp.querySelector('tw-link'); if(lk) lk.click(); }
}

/* ── Audio: rhythmic hoof beats + occasional moo while riding ── */
var lastHoofAt = 0, lastMooAt = 0, nextMooDelay = 5000 + Math.random() * 7000;
var audioTicker = setInterval(function(){
  /* Don't self-clear on gameOver — the player may restart. navigate() clears us. */
  var playing = (phase === 'practice' || phase === 'real') && !gameOver;
  if (!playing) return;
  var nowT = Date.now();
  if (nowT - lastHoofAt > 280) {
    lastHoofAt = nowT;
    if (window.dssAudio && window.dssAudio.hoofBeat) window.dssAudio.hoofBeat();
  }
  if (nowT - lastMooAt > nextMooDelay) {
    lastMooAt = nowT;
    nextMooDelay = 5000 + Math.random() * 7000;
    if (window.dssAudio && window.dssAudio.cowMoo) window.dssAudio.cowMoo();
  }
}, 60);

/* ── Teardown on ANY passage exit ── navigate() only covers the game's own
   exit buttons; Harlowe links, forced redirects, and the stall-bail leave the
   passage without it, which used to strand the music + hoofbeat ticker
   galloping forever. Watch the canvas leave the DOM instead (the codebase's
   standard overlay-teardown pattern) — double-clearing with navigate() is
   harmless, both paths guard. */
var cowExitObs = new MutationObserver(function(){
  if (!canvas.isConnected) {
    stopCowMusic();
    clearInterval(audioTicker);
    cowExitObs.disconnect();
  }
});
cowExitObs.observe(document.body, { childList: true, subtree: true });

/* ── Game loop ── */
function loop(){
if(!canvas.isConnected) return; /* passage left — stop rescheduling the rAF */
update();

/* screen shake on hit */
var shaking=(Date.now()-hitFlashAt < 300) && phase==='real' && !gameOver;
if(shaking){
var sx=(Math.random()-0.5)*8, sy=(Math.random()-0.5)*8;
ctx.save(); ctx.translate(sx,sy);
}

drawStreet();
drawArcadeRoad();
obstacles.forEach(drawObstacle);
drawPlayer();

/* near-miss spark streak — brief gold scrape beside the cow */
if(Date.now()-nearMissAt < 320){
var nAge=(Date.now()-nearMissAt)/320;
ctx.save(); ctx.globalAlpha=1-nAge;
ctx.strokeStyle='#ffe9a0'; ctx.lineWidth=1.6; ctx.lineCap='round';
for(var nsp=0;nsp<4;nsp++){
var nyo=PLAYER_Y-10+nsp*8, nxo=nearMissX+(nsp%2?4:-3);
ctx.beginPath(); ctx.moveTo(nxo,nyo); ctx.lineTo(nxo+(nearMissX>playerX?10:-10), nyo-16-nAge*10); ctx.stroke();
}
ctx.restore();
}

/* red flash overlay on hit */
if(Date.now()-hitFlashAt < 200 && phase==='real'){
ctx.fillStyle='rgba(200,40,20,0.18)';
ctx.fillRect(0,0,W,H);
}

if(shaking) ctx.restore();

if(!gameOver) drawHUD(); else drawEnd();
drawArcadeCabinet();
requestAnimationFrame(loop);
}
loop();

/* Auto-trigger: skip the CLICK TO START title screen and drop the
   player straight into the ride (the practice round was cut on 2026-10-13;
   the ride's slow start is the learning beat). */
(window.dssShowMinigameRules||function(o){o.onPlay()})({key:'cow',play:'Saddle up',title:"JEFFREY BERNARD’S COW",lines:["Use &larr; &rarr; or click LEFT, MID and RIGHT to change lane. You have three lives."],touchLines:["Tap LEFT, MID and RIGHT to change lane. You have three lives."],onPlay:function(){
  // 2026-10-13 (Sam: "Practice run for the cow ride is redundant ... it starts low anyway and that is the practice"):
  // the six-second practice round is cut; the ride opens on its short count-in and goes straight to the real run.
  if (phase === 'title') {
    startCowMusic();
    phase = 'countdown';
    countdownAt = Date.now();
    phaseStart = Date.now();
  }
}});
})();
</script>

