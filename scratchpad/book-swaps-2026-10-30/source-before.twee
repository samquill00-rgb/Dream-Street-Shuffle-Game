<script>(function(){ /* 2026-10-24 (Sam: "hold THE FEEDING haunt box and its gate flash about 9 s so the Page 93 line has the page first"): the box stays out of the flow until the quest line has been on a visible page 9 s, then plays its own reveal; the gate flash waits for the box */ var gen = null, box = document.querySelector('tw-passage .haunt-box'); if (!box) return; box.style.display = 'none'; var left = 9000; setTimeout(function(){ gen = window._passageGen; tick(); }, 0); /* snapshot after the MutationObserver has counted this passage (the dark pass fix) */ function tick(){ setTimeout(function(){ if (window._passageGen !== gen) return; if (!document.hidden) left -= 300; if (left > 0) return tick(); box.style.display = ''; box.style.animation = 'none'; void box.offsetWidth; box.style.animation = ''; }, 300); } })();</script>
<!-- QUEST (modal 2026-09-14): parked off-screen and raised as a popup by
     window.dssQuestPopup. The [[I’ll look for it]] link below stays visible, so
     dismissing the popup can never strand the player. data-go names the link
     the popup's button should click. Any future quest: same wrapper. -->
<div class="dss-quest-offer" data-go="I’ll look for it">
<div class="dss-quest-title">PAGE 93</div>
<div class="dss-quest-body">INIS O’FLATTERLY is searching for a missing page; page 93 in his manuscript. You’ll need to leave Soho to find it. Return it to him.</div>
</div>
<script>(function(){
  /* 2026-10-23 overnight (Sam, playtest: "this errand popup shouldn't be triggered till you click 'I'll look for it'"): the
     errand card now comes on that click and its button takes you out; dismissed, the link just leaves. On window, so it
     hears the click before the departure fade's document listener. */
  var gen = window._passageGen;
  function onGo(e) {
    if (window._passageGen !== gen) { window.removeEventListener('click', onGo, true); return; }
    var l = e.target && e.target.closest && e.target.closest('tw-link');
    if (!l || (l.textContent || '').trim() !== 'I’ll look for it') return;
    if (window._dssQuestPopupSeenGen === window._passageGen || !window.dssQuestPopup) { window.removeEventListener('click', onGo, true); return; }
    e.preventDefault(); e.stopImmediatePropagation();
    window._dssSlipFiledAt = 0; window.dssQuestPopup();
  }
  setTimeout(function() { gen = window._passageGen; window.addEventListener('click', onGo, true); }, 0);
})();</script>

