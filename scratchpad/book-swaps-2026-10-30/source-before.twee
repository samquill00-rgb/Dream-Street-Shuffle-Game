[-1,1].forEach(function(side){mesh(new THREE.BoxGeometry(0.006,0.53,0.004),detail.material('#77684c','metal'),side*0.215,0,0.033,g);mesh(new THREE.BoxGeometry(0.43,0.006,0.004),detail.material('#77684c','metal'),0,side*0.265,0.033,g);});
