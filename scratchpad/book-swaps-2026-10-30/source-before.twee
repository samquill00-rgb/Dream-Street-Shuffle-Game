/* 2026-10-21 (Sam: "every time you gather a haunt the wheel shows up, but after the first time, it just shows as a sort of golden line drawing, briefly, with the part of the wheel you found shaded in").
   THE GATE FLASH. The first haunt in a browser still opens the NOTEBOOK on its wheel (the tutorial, dssHauntNotebookTut). Every haunt after
   that draws the wheel in gold hairline over the page for about three seconds: the gate just caught is shaded in, the gates caught before it
   lie faintly gilt, no words. The caught gate is read from the box ("The work: Putrefactio."), the earlier ones from the header's hidden
   #dss-haunts-held (printed before the passage adds the new haunt). It waits for an overlay, the NOTEBOOK or a long slip to clear, drops itself
   if the page changes first, and is registered as #dss-gate-flash in dssOverlayBusy and the rising numbers' up() check. */
(function() {
  var STAGES = ['Calcinatio', 'Solutio', 'Separatio', 'Coniunctio', 'Putrefactio', 'Congelatio', 'Cibatio', 'Sublimatio', 'Fermentatio', 'Exaltatio', 'Multiplicatio', 'Projectio']; /* dssOpusReveal's order, clockwise from the top */
  var NAMES = ['The Sketch', 'The Refusal', 'The Sorting', 'The Debt', 'The Beast', 'The Head', 'The Feeding', 'The Delivery', 'The Game', 'The Crown', 'The Spread', 'The Wound'];
  var queue = [];
  var ON = true; /* 2026-10-24 (Sam, playtest at The Empty Glass: "The preview of the wheel didn't show up when you get the haunt"): back on. 2026-10-23 (Sam: "no header, work line, count or gold flash"): the gate flash was off. window.__dssGateFlashTest still draws one by hand */
  function tutDone() { try { return localStorage.getItem('dssHauntNotebookTut') === '1'; } catch (e) { return true; } }
  function pt(r, a) { return (120 + r * Math.cos(a)).toFixed(1) + ' ' + (120 + r * Math.sin(a)).toFixed(1); }
  function sector(i, r0, r1) { var a0 = (-105 + i * 30) * Math.PI / 180, a1 = (-75 + i * 30) * Math.PI / 180; return 'M' + pt(r0, a0) + ' L' + pt(r1, a0) + ' A' + r1 + ' ' + r1 + ' 0 0 1 ' + pt(r1, a1) + ' L' + pt(r0, a1) + ' A' + r0 + ' ' + r0 + ' 0 0 0 ' + pt(r0, a0) + ' Z'; }
  function ring(r, d) { return '<circle class="dgf-line" transform="rotate(-90 120 120)" style="--l:' + (2 * Math.PI * r).toFixed(1) + ';--d:' + d + 's" cx="120" cy="120" r="' + r + '"/>'; }
  function ray(a, r0, r1, d) { return '<line class="dgf-line" style="--l:' + (r1 - r0).toFixed(1) + ';--d:' + d + 's" x1="' + (120 + r0 * Math.cos(a)).toFixed(1) + '" y1="' + (120 + r0 * Math.sin(a)).toFixed(1) + '" x2="' + (120 + r1 * Math.cos(a)).toFixed(1) + '" y2="' + (120 + r1 * Math.sin(a)).toFixed(1) + '"/>'; }
  function svg(gi, held) {
    var rO = 104, rI = 70, g = sector(gi, rI, rO);
    var s = '<svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg"><defs><pattern id="dgf-hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="4" stroke="#f0cf6a" stroke-width="1.1"/></pattern></defs>';
    for (var i = 0; i < 12; i++) if (held[i] && i !== gi) s += '<path class="dgf-held" d="' + sector(i, rI, rO) + '"/>';
    s += '<g class="dgf-new"><path d="' + g + '" fill="rgba(232,190,80,0.24)"/><path d="' + g + '" fill="url(#dgf-hatch)"/><path d="' + g + '" fill="none" stroke="#f0cf6a" stroke-width="1.2"/></g>';
