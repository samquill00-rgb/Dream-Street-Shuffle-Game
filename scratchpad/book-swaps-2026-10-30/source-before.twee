exterior.finish(cbPanelMat,false);exterior.plate(cbGroup,0,0.622,0.032,0.14,0.025,0,0x80714b);
var hingePin=exterior.mesh(cbGroup,new THREE.CylinderGeometry(0.008,0.008,0.16,12),exterior.material(0x5e5d4d,true),0,0.63,0.018);hingePin.rotation.z=Math.PI/2;
