    var list = Array.prototype.slice.call(tags || []);
    list.forEach(function(tag){
      var spec = TAG_TICKS[tag]; if (!spec) return;
      var arm = function(){
        var wait = (spec.min + Math.random() * (spec.max - spec.min)) * 1000;
        var id = setTimeout(function(){ try { spec.fn(); } catch(e) {} arm(); }, wait);
        _tickTimers.push(id);
      };
      arm();
    });
  }
  // ----- Transition one-shots (2026-10-18) ---------------------------------
  // Sam's French recordings of walking in, walking out, and taking the stairs,
  // played once as the player crosses between the street and a venue. Keyed
  // on the venue tag left and entered ('out' = a passage tagged hub, outdoor
  // or street-night). Trisha's is a basement and the Colony is up a flight, so
  // each gets the stairs; the Coach's gents hand off to its bar inside one
  // passage, so the SpewPopup fires that one itself ('gents>venue-coach').
  // Passages with neither a venue tag nor a street tag (phone calls, system
  // routing) leave the state alone, so a call taken inside the French is not
  // a walk out and back. Nothing plays on the first passage of a page load.
  var TRANSITIONS = {
    'out>venue-french':   { url: '__DSS_TR_ENTER_DATA_URI__', gain: 0.28 },
    'venue-french>out':   { url: '__DSS_TR_LEAVE_DATA_URI__', gain: 0.26 },
    'out>venue-trishas':  { url: '__DSS_TR_DOWN_DATA_URI__',  gain: 0.26 },
    'venue-trishas>out':  { url: '__DSS_TR_UP_DATA_URI__',    gain: 0.26 },
    'out>venue-colony':   { url: '__DSS_TR_UP_DATA_URI__',    gain: 0.26 },
    'venue-colony>out':   { url: '__DSS_TR_DOWN_DATA_URI__',  gain: 0.26 },
    'gents>venue-coach':  { url: '__DSS_TR_UP_DATA_URI__',    gain: 0.24 }
  };
  var TR_STREET = { 'hub': 1, 'outdoor': 1, 'street-night': 1 };
  var _trBufs = {}, _trVenue = null, _trPrewarmed = false, _trCurrent = null; // _trCurrent: the clip still sounding, so a quick crossing back cuts it off (Sam, 2026-10-18)
  function _trDecode(url, cb) {
    if (_trBufs[url]) { if (cb) cb(_trBufs[url]); return; }
    var ac = getCtx(); if (!ac) return;
    try {
      fetch(url).then(function(r) { return r.arrayBuffer(); })
        .then(function(ab) { return ac.decodeAudioData(ab); })
        .then(function(buf) { _trBufs[url] = buf; if (cb) cb(buf); })
        .catch(function(err) { if (window.console) console.error('[dssAudio] transition decode failed:', url, err); });
    } catch(e) {}
  }
  function playTransition(key) {
    var spec = TRANSITIONS[key]; if (!spec) return;
    window.dssLastTransition = key; // debug/test marker: the last transition asked for, muted or not
    if (_muted) return;
    var ac = getCtx(); if (!ac) return;
    if (ac.state === 'suspended') { try { ac.resume(); } catch(e) {} }
    _trDecode(spec.url, function(buf) {
      var ac2 = getCtx(); if (!ac2) return;
      var g = ac2.createGain(); g.gain.value = 0; g.connect(ac2.destination);
      var src = ac2.createBufferSource(); src.buffer = buf; src.connect(g);
      var t = ac2.currentTime;
      if (_trCurrent) {  // cut in: the previous crossing's clip gives way
        var old = _trCurrent; _trCurrent = null;
        try { old.g.gain.cancelScheduledValues(t); old.g.gain.setValueAtTime(old.g.gain.value, t); old.g.gain.linearRampToValueAtTime(0.0001, t + 0.12); old.src.stop(t + 0.14); } catch(e) {}
      }
      g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(spec.gain, t + 0.08);
      var me = { src: src, g: g, base: spec.gain }; _trCurrent = me;
      src.onended = function() { if (_trCurrent === me) _trCurrent = null; try { g.disconnect(); } catch(e) {} };
      src.start(t);
    });
  }
  // 2026-10-21 (Sam: "the 'outside the venue' noise fades as you walk further from a venue"): the leave clip (the pub heard
  // from its door) follows the walker on the Dean Street map; tiles is the walk from the door, silent by seven
  function transitionDistance(tiles) {
    var me = _trCurrent; if (!me || me.base == null) return;
    var ac = getCtx(); if (!ac) return;
    var f = Math.max(0, Math.min(1, 1 - tiles / 7));
    try { var t = ac.currentTime; me.g.gain.cancelScheduledValues(t); me.g.gain.setValueAtTime(me.g.gain.value, t); me.g.gain.linearRampToValueAtTime(Math.max(0.0001, me.base * f), t + 0.25); } catch(e) {}
  }
  function _transitionForPassage(passageNode) {
    if (!passageNode) return;
    var tags = (passageNode.getAttribute('tags') || '').split(/\s+/).filter(Boolean);
    var venue = null, street = false;
    for (var i = 0; i < tags.length; i++) {
      if (!venue && tags[i].indexOf('venue-') === 0) venue = tags[i];
      if (TR_STREET[tags[i]]) street = true;
    }
    if (venue) { if (_trVenue === 'out') playTransition('out>' + venue); _trVenue = venue; }
    else if (street) { if (_trVenue && _trVenue !== 'out') playTransition(_trVenue + '>out'); _trVenue = 'out'; }
    if (!_trPrewarmed && _trVenue) { _trPrewarmed = true; for (var k in TRANSITIONS) _trDecode(TRANSITIONS[k].url); }
  }
  function updateAmbientBedsForPassage(passageNode) {
    try { _transitionForPassage(passageNode); } catch(e) {}
    for (var i = 0; i < _ambientBeds.length; i++) {
      var bed = _ambientBeds[i];
      if (_bedShouldPlay(bed, passageNode)) _startBed(bed);
      else _stopBed(bed);
    }
  }
  function registerAmbientBed(bed) {
    bed.buffer = null;
    bed.source = null;
    bed.gain = null;
    bed.started = false;
    bed.decoding = false;
    bed.decodeQueue = [];
    bed.duckTimer = null;
    if (typeof bed.volume !== 'number') bed.volume = 0.18;
    if (typeof bed.duckVolume !== 'number') bed.duckVolume = bed.volume * 0.35;
    _ambientBeds.push(bed);
  }
  // ----- Registered beds ---------------------------------------------------
  // The French — pub field recording, plays on every venue-french passage.
  // 2026-10-17: the file is now Sam's own recordings made inside the French, layered into a seamless loop (the-french-pub-layered.m4a; raw and tools in french-live-originals/), levelled to the old bed's loudness.
  registerAmbientBed({
    label: 'pub-french',
    dataUri: '__DSS_PUB_DATA_URI__',
    tags: { 'venue-french': 1 },
    volume: 0.16,
    duckVolume: 0.05
  });
  // The Pillars of Hercules — London-pub field recording, plays on every
  // venue-pillars passage (the in-pub interior scenes).
  registerAmbientBed({
    label: 'pub-pillars', /* 2026-10-18: the file is Sam's French recordings layered as a warm panelled pub (indoor-warm-pub.m4a) */
    dataUri: '__DSS_PILLARS_DATA_URI__',
    tags: { 'venue-pillars': 1 },
    volume: 0.20,
    duckVolume: 0.07
  });
  // Piano (Eoin Roe, Pianoteq) — the endgame theme. Plays on every
  // passage from Approach Centre Point onwards through to the Dawn
  // ending. Higher volume than ambient field-recordings: this is
  // foreground music, not room tone.
  registerAmbientBed({
    label: 'piano-eoin',
    dataUri: '__DSS_PIANO_DATA_URI__',
    tags: { 'piano-bed': 1 },
    volume: 0.30,
    duckVolume: 0.10,
    // 5s silent pause between loop iterations — the piano "returns" rather
    // than seamlessly continuing, so it feels intentional even if the
    // player lingers long enough to hear it round again.
    gapMs: 5000
  });
  // The Interval — a separate piece, heard over a radio in the
  // dream-staircase scene. Used to share the piano-bed; replaced so
  // the Interval has its own colour and the piano stays reserved for
  // the centre-point/dawn arc.
  registerAmbientBed({
    label: 'interval-radio',
    dataUri: '__DSS_INTERVAL_RADIO_DATA_URI__',
    tags: { 'interval-radio': 1 },
    volume: 0.28,
    duckVolume: 0.10
  });
  // Coach and Horses Gents toilet — auto-starts on the Coach passage (which
  // 2026-10-17: the file is now Sam's own recording made in the French's gents, layered into a seamless loop (the-gents-french-layered.m4a), levelled to the old bed's loudness.
  // opens with "you've come-to in a cubicle"), then is manually stopped by
  // the SpewPopup's _fadeOut so the toilet rumble doesn't bleed into the bar
  // prose that appears in-place after the popup closes.
  registerAmbientBed({
    label: 'toilet-gents',
    dataUri: '__DSS_GENTS_DATA_URI__',
    tags: { 'venue-gents': 1 },
    volume: 0.22,
    duckVolume: 0.08
  });
  // The street (2026-10-18 night) — Sam's recording outside the French under
  // the generated late-night street, on every outdoor / street-night passage
  // that isn't Dean Street itself (the hub keeps its theme alone).
  registerAmbientBed({
    label: 'street',
    dataUri: '__DSS_STREET_DATA_URI__',
    tags: { 'outdoor': 1, 'street-night': 1 },
    notTags: { 'hub': 1 },
    volume: 0.07,     // 2026-10-18 (Sam: "most should probably be much quieter"): was 0.18, about 8 dB down; he'll play and judge
    duckVolume: 0.025
  });
  // Retro game music — plays during canvas-based minigames (the cellar fight,
  // PP Pong, Bernard's cow ride, the Sketch the Painter napkin-draw, and the
  // Ronnie Scott's bar canvas). Replaces whatever venue ambience would
  // otherwise play. Tag-driven for the four passage-based games; the Ronnie's
  // bar canvas starts/stops it manually from the bar-start-btn click + the
  // bar-end navigation, because the "Ronnie Scott's" passage doubles as the
  // jazz-club venue (with venue-ronnies ambience) when the player isn't
  // mid-game.
  registerAmbientBed({
    label: 'minigame-retro',
    dataUri: '__DSS_MINIGAME_DATA_URI__',
    tags: { 'minigame': 1 },
    volume: 0.22,
    duckVolume: 0.08
  });
  window._cowGameDataUri = '__DSS_COWGAME_DATA_URI__';
  window._jazzMiniDataUri = '__DSS_JAZZMINI_DATA_URI__';
  window._pongMiniDataUri = '__DSS_PONGMINI_DATA_URI__';
  window._waltzMiniDataUri = '__DSS_WALTZ_DATA_URI__';
  /* LINKED-AUDIO PREFETCH (2026-09-01): sync_html.py now writes relative file
     URLs into the placeholders above instead of base64 (AUDIO_MODE = "link"),
     which took ~55 MB out of the html. Beds still decode lazily on first play,
     so warm the browser cache for every real URL a few seconds after boot;
     data: URIs (embed mode) and unreplaced __DSS_ placeholders are skipped. */
  setTimeout(function(){
    try {
      var urls = [MUSIC_FILE, window._cowGameDataUri, window._jazzMiniDataUri, window._pongMiniDataUri, window._waltzMiniDataUri];
      for (var i = 0; i < _ambientBeds.length; i++) urls.push(_ambientBeds[i].dataUri);
      var seen = {};
      urls.forEach(function(u){
        if (!u || seen[u] || u.indexOf('data:') === 0 || u.indexOf('__DSS_') === 0) return;
        seen[u] = true;
        var l = document.createElement('link');
        l.rel = 'prefetch'; l.as = 'fetch'; l.href = u; l.crossOrigin = 'anonymous';
        document.head.appendChild(l);
      });
    } catch(e) {}
  }, 4000);
  // Ronnie Scott's — Dr Quill's original "Firebird jazz" loop: a C# minor
  // folk-hymn (after Stravinsky's Firebird) reharmonised with Coltrane changes.
  // This IS the Ronnie's venue music — it replaced the old jazz-bar field
  // recording. Plays on every venue-ronnies passage (the club, the bar-canvas
  // results, The Set) and carries through the bar game's POUR phase. The
  // drinks-CARRY platform phase hands off to the jazzmini loop instead:
  // _startCarryTransition stops this bed and starts jazzmini, and the bed
  // restarts via the venue-ronnies tag-match when the player reaches Bar
  // Canvas Win/Lose. Foreground music level (cf. lackland-office / piano-eoin).
  // Gapless AAC (.m4a), re-bounced from the original 192k MP3 via afconvert — the
  // MP3 encoder padding is trimmed to container metadata browsers honour; the wrap
  // is seamless (the scene rarely runs a whole cycle anyway).
  registerAmbientBed({
    label: 'ronnies-firebird',
    dataUri: '__DSS_RONNIES_MUSIC_DATA_URI__',
    tags: { 'venue-ronnies': 1 },
    volume: 0.30,
    duckVolume: 0.10
  });
  // Quiet cafe — soft chatter / cutlery, for the Colony Room AND Trisha's.
  // Both venues are members'-club bars with subdued lounge feel; one bed
  // covers them via two tags. (If you want them to sound distinct later,
  // duplicate this block with a different recording for each tag.)
  // 2026-09-12: split into two generated beds (tools_make_beds.py). The Colony
  // is a small bright members' room (murmur, ice, a cackle, lighter clicks);
  // Trisha's is a basement (electrics hum, few voices, footsteps overhead).
  registerAmbientBed({
    label: 'colony', /* 2026-10-18: the file is Sam's French recordings layered as a small packed room (indoor-colony-room.m4a) */
    dataUri: '__DSS_COLONY_DATA_URI__',
    tags: { 'venue-colony': 1 },
    volume: 0.20,
    duckVolume: 0.07
  });
  registerAmbientBed({
    label: 'trishas', /* 2026-10-18: the file is Sam's French recordings layered as a quiet lounge (indoor-quiet-lounge.m4a) */
    dataUri: '__DSS_TRISHAS_DATA_URI__',
    tags: { 'venue-trishas': 1 },
    volume: 0.20,
    duckVolume: 0.07
  });
  // Dream-world beds (2026-09-12, generated): one per world, matched on the
  // world tag so every passage of that world carries it. The passage hook
  // skips the generic procedural wind (windFarnell) when one of these is on.
  // Sam may write music for the worlds later; these are the room tone under it.
  registerAmbientBed({ label: 'world-himalaya', dataUri: '__DSS_HIMALAYA_DATA_URI__', tags: { 'himalayan': 1 }, volume: 0.18, duckVolume: 0.06 });
  registerAmbientBed({ label: 'world-nazca',    dataUri: '__DSS_NAZCA_DATA_URI__',    tags: { 'nazca': 1 },     volume: 0.18, duckVolume: 0.06 });
  registerAmbientBed({ label: 'world-easter',   dataUri: '__DSS_EASTER_DATA_URI__',   tags: { 'easter': 1 },    volume: 0.18, duckVolume: 0.06 });
  registerAmbientBed({ label: 'world-pyramid',  dataUri: '__DSS_PYRAMID_DATA_URI__',  tags: { 'pyramid': 1 },   volume: 0.20, duckVolume: 0.07 });
  registerAmbientBed({ label: 'world-ezekiel',  dataUri: '__DSS_EZEKIEL_DATA_URI__',  tags: { 'ezekiel': 1 },   volume: 0.18, duckVolume: 0.06 });
  // Cellar pump-station hum — Copper's cellar (the fight) AND Lackland's
  // back room (the table-tennis basement). Same physical aesthetic — a
  // damp basement under Soho — so they share the bed. Two tags route to
  // the same recording.
  registerAmbientBed({
    label: 'cellar-pump',
    dataUri: '__DSS_CELLAR_DATA_URI__',
    tags: { 'venue-cellar': 1 },
    volume: 0.18,
    duckVolume: 0.06
  });
  // Lackland's office music — Dr Quill's original looping piece for the whole
  // Lackland den: the office + back door (tagged 'venue-lackland') AND the
  // table-tennis basement (the back room + PP results, tagged 'venue-lackland-back',
  // which used to share the cellar-pump hum — now removed from that bed so this
  // plays there instead). During an actual PP match the minigame audio takes over.
  // Foreground music level, not room tone. Gapless AAC (.m4a), re-bounced from the
  // original 192k MP3 via afconvert — the MP3 encoder padding (528+2296 samples) is
  // trimmed and stored as container metadata browsers honour, so the wrap is seamless.
  registerAmbientBed({
    label: 'lackland-office',
    dataUri: '__DSS_LACKLAND_DATA_URI__',
    tags: { 'venue-lackland': 1, 'venue-lackland-back': 1 },
    volume: 0.30,
    duckVolume: 0.10,
    // Resume from where it left off when re-entered (e.g. after the pong
    // game) rather than restarting — keeps the den's music continuous.
    resumePosition: true
  });
  // Carthage cicadas — distant Tunisian-night cicadas, for the dream-Carthage
  // shore/coast passages (Stay in Carthage now plays the Dido's Lament bed alone).
  // These passages used to carry the [dream] tag
  // (which auto-fires the procedural windFarnell bed); the tag is removed so
  // this field-recording bed gets the passages to itself. Green Sea Approach
  // and Maritime interlude keep [dream] — they want the wind.
  registerAmbientBed({
    label: 'carthage-cicadas',
    dataUri: '__DSS_CARTHAGE_DATA_URI__',
    tags: { 'carthage-cicadas': 1 },
    volume: 0.20,
    duckVolume: 0.07
  });
  // Carthage melody — a layered melodic line that plays over the cicadas
  // on the two passages that bracket the 3D shore experience: The coast
  // of Carthage (where the 3D embed loads) and Carthage shore (the game
  // passage you land in immediately after). Tagged separately from the
  // cicadas so Stay in Carthage (the inline pyre scene) doesn't fire it.
  registerAmbientBed({
    label: 'carthage-melody',
    dataUri: '__DSS_CARTHAGE_MELODY_DATA_URI__',
    tags: { 'carthage-shore': 1 },
    volume: 0.50,
    duckVolume: 0.16
  });
  // Dido's Lament — Purcell's "When I am laid in earth", the music for the pyre.
  // Tagged 'pyre' (Dido, Rescue the page, Stay in Carthage) AND 'green-sea'
  // (LINE 2 — the Green Sea bar — and LINE 2 Oxford — the memory cut-away that
  // follows), so the lament carries the dream's emotional close across both the
  // pyre and the Green Sea. Plays CONTINUOUSLY across same-tag passages without
  // restarting. On Stay in Carthage it layers over the carthage-cicadas bed; on
  // Dido / Rescue the page over the [dream] wind; on the Green Sea over the quiet
  // green-sea seaside field recording. volume is the knob to tune by ear.
  registerAmbientBed({
    label: 'didos-lament',
    dataUri: '__DSS_DIDOS_LAMENT_DATA_URI__',
    tags: { 'pyre': 1, 'green-sea': 1 },
    volume: 0.40,
    duckVolume: 0.12
  });
  // The Green Sea — seaside cafe field recording (Nabeul). Plays
  // continuously across the dream-Carthage bar arc: Green Sea Approach
  // (the 3D shore-and-bar embed), LINE 2 (the bar interior), and
  // LINE 2 Oxford (the memory cut-away that follows). Same pattern as
  // carthage-shore bridging the Carthage embed + game scene — the bed
  // doesn't stop and restart between passages.
  registerAmbientBed({
    label: 'green-sea',
    dataUri: '__DSS_GREEN_SEA_DATA_URI__',
    tags: { 'green-sea': 1 },
    volume: 0.22,
    duckVolume: 0.07
  });
  // Soho dawn — Berwick-Street-at-dawn field recording. Plays across the
