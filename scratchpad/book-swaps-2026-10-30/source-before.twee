      dirs.split(',').forEach(function(id) { id = id.trim(); var dd = doorById(id); if (!dd || !doors[id] || doors[id].status !== 'open') return; var pth = routeToCecil(dd); if (pth && pth.length < bestLen) { best = id; bestLen = pth.length; } });
