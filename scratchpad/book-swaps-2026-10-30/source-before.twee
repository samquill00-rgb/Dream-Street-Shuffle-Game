(set: _nb to _nb + '<g filter="url(#dss-ink-fine)" class="nb-lily nb-lily-2 ' + _lo2 + '" transform="translate(95,34) rotate(0) scale(0.893)">' + _bell + '</g>')\
(set: _nb to _nb + '<g filter="url(#dss-ink-fine)" class="nb-lily nb-lily-3 ' + _lo3 + '" transform="translate(150,34) rotate(0)">' + _bell + '</g>')\
