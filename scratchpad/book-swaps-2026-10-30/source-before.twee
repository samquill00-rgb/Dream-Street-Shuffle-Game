    x.strokeStyle = '#45413c'; x.lineWidth = 1;
    x.beginPath(); x.moveTo(3,14); x.lineTo(4,4); x.lineTo(14,-4); x.lineTo(17,0); x.moveTo(15,-3); x.lineTo(15,13); x.moveTo(25,14); x.lineTo(24,5); x.moveTo(2,14); x.lineTo(28,14); x.stroke();
    x.fillStyle = '#292826'; x.fillRect(5,12,18,2);
  } else {
  x.fillStyle = '#3a2420'; x.fillRect(0, 1, 30, 4); x.fillRect(2, 0, 26, 1);
  x.fillStyle = '#d8d0c0'; x.fillRect(2, 5, 26, 9);
  x.fillStyle = '#1a1814'; for (var hx = 2; hx <= 26; hx += 4) x.fillRect(hx, 5, 1, 9); x.fillRect(2, 9, 26, 1);
  x.fillStyle = '#2a1e18'; x.fillRect(13, 9, 4, 5); x.fillStyle = '#4a3a2a'; x.fillRect(12, 8, 6, 1);
  // Cream gable, dark bargeboards, diagonal half-timbering and leaded windows.
  x.fillStyle = '#d8d0c0'; x.beginPath(); x.moveTo(7,5); x.lineTo(15,-4); x.lineTo(23,5); x.fill();
  x.strokeStyle = '#201c18'; x.lineWidth = 2; x.beginPath(); x.moveTo(5,5); x.lineTo(15,-6); x.lineTo(25,5); x.moveTo(15,-4); x.lineTo(15,5); x.moveTo(3,6); x.lineTo(10,13); x.moveTo(20,13); x.lineTo(27,6); x.stroke();
  x.fillStyle = '#7d948b'; x.fillRect(6,6,4,3); x.fillRect(21,6,4,3);
  x.fillStyle = '#201c18'; x.fillRect(8,6,1,3); x.fillRect(23,6,1,3);
