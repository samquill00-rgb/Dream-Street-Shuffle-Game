    pointer=null;
  }
  function boot() {
    if(disposed||running||ended||!root.isConnected)return;
    running=true;choose();update();canvas.focus({preventScroll:true});last=performance.now();frame=requestAnimationFrame(tick);
  }
  root.querySelectorAll('.cards-payment tw-link').forEach(function(l){l.setAttribute('tabindex','-1');});
  listen(canvas,'pointerdown',down);listen(canvas,'pointermove',move);listen(canvas,'pointerup',up);
  listen(canvas,'pointercancel',cancelPointer);listen(canvas,'lostpointercapture',cancelPointer);
  listen(document,'visibilitychange',cancelPointer);listen(window,'blur',cancelPointer);listen(document,'keydown',key);
  listen(root.querySelector('.cards-place'),'click',place);
  listen(cancel,'click',cancelEdit);
  root.querySelectorAll('[data-tilt]').forEach(function(b){listen(b,'click',function(){tilt(Number(b.dataset.tilt));});});
  root.querySelectorAll('[data-base]').forEach(function(b){listen(b,'click',function(){slide(Number(b.dataset.base));});});
  listen(window,'resize',resize);
  if(window.ResizeObserver){resizeObs=new ResizeObserver(resize);resizeObs.observe(canvas);}
  observer=new MutationObserver(function(){if(!root.isConnected)cleanup();});
  observer.observe(root.closest('tw-story')||root.parentNode,{childList:true,subtree:true});
  if(window.DSS_DEV){
    root.querySelector('.cards-skip').hidden=false;
    dev={snapshot:function(){return {used:used,falls:falls,active:active,editing:editing,houseReady:houseReady,angle:angle,base:baseX,elapsed:elapsed,finalAt:finalAt,nextRoar:nextRoar,ended:ended,reduced:reduced,standing:liveCount(),cards:placed.map(function(c){return c?{angle:c.angle,base:c.base,stability:c.stability}:null;}),slots:slots,geometry:placed.map(function(c,i){return c?geometry(i,cardAngle(i)):null;})};},
      angle:function(a){tilt(a-angle);},base:function(x){slide(x-baseX);},preview:function(){var i=editing>=0?editing:active;return i>=0?geometry(i,angle):null;},select:selectCard,cancel:cancelEdit,place:place,roar:function(){if(running)roar(!!finalAt);}};
    window._houseCardsDev=dev;
  }
  resize();update();
  (window.dssShowMinigameRules||function(o){o.onPlay()})({key:'cards',play:'Build',title:'HOUSE OF CARDS',lines:[
    '<div>Drag a card’s foot to move it. Drag its body to tilt it. Space places it.</div>',
    '<div>Lean cards in pairs, then lay a card across each pair.</div>',
    '<div>The table roars now and then, and cards may fall. Eighteen cards; fifteen must stand.</div>'
    // 2026-10-13 (Sam, the words review): the reward line cut ("Win: morale +8, or +12 if no card falls. First time only.")
  ],touchLines:[
    '<div>Drag a card’s foot to move it. Drag its body to tilt it. <strong>Place card</strong> sets it down.</div>',
    '<div>Lean cards in pairs, then lay a card across each pair.</div>',
    '<div>The table roars now and then, and cards may fall. Eighteen cards; fifteen must stand.</div>'
  ],onPlay:boot});
})();
</script>


:: LINE 2 Oxford [green-sea] {"position":"1000,200","size":"100,100"}
(if: $sawMemory2 is false)[(set: $sawMemory2 to true)<div class="memory-photo memory-photo-2"><div class="mp-image"><svg class="mp-bg" viewBox="0 0 300 200" preserveAspectRatio="xMidYMid slice"><defs><radialGradient id="fl2" cx="78%" cy="22%" r="78%"><stop offset="0%" stop-color="#f8d088" stop-opacity="0.95"/><stop offset="26%" stop-color="#d89048" stop-opacity="0.5"/><stop offset="58%" stop-color="#2a2860" stop-opacity="0.3"/><stop offset="100%" stop-color="#0a0820" stop-opacity="0"/></radialGradient></defs><rect width="300" height="200" fill="url(#fl2)"/></svg><div class="mp-prose">Late May night and the sexy airs of summer, the trees’ munificence. Her staircase and then her, footsteps away. And in the night-blown roses of your ears, repeating what you’ve learned for your exams:</div></div></div>]
<div class="verse">Annihilating all that’s made<br>To a <span style="color:#f4b8c4;">green</span> thought in a <span style="color:#a8cde0;">green</span> shade.</div>

