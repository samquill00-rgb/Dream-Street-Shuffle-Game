  }
  function tick(now) {
    if (!root.isConnected) { cleanup(); return; }
    var dt=Math.min(.1,(now-last)/1000);last=now;
    if (!document.hidden) {
      elapsed+=dt;flash=Math.max(0,flash-dt);
      if(running){
        // Give the player a steady table while holding or repairing a card.
        if(editing>=0 || pointer || houseReady&&!finalAt)nextRoar+=dt;
        var warn=editing<0 && !pointer && (!houseReady || finalAt) && elapsed>=(finalAt?finalAt:nextRoar)-1;
        if(warn)say(finalAt?'His sister winds a trick…':'The table is getting louder…');
        warning=warn;
        if(finalAt && elapsed>=finalAt){warning=false;roar(true);}
        else if(!finalAt && editing<0 && !pointer && !houseReady && elapsed>=nextRoar){warning=false;roar(false);}
      }
      draw();
    }
