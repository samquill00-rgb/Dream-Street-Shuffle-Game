    limb([[-0.2,1.5,0.08],[0.15,1.8,0.12],[0.63,2.02,0.08],[1.05,2.05,0.13]],[0.105,0.08,0.045,0.018]);
    limb([[-0.18,2.18,0.02],[-0.65,2.48,-0.04],[-0.93,2.92,-0.08]],[0.08,0.045,0.013]);
    limb([[-0.3,2.8,0.07],[0.04,3.06,0.18],[0.21,3.42,0.15]],[0.048,0.028,0.009]);
    limb([[0.61,2.01,0.08],[0.66,2.33,0.11],[0.58,2.56,0.08]],[0.035,0.018,0.007]);
    limb([[-0.08,0.65,0.03],[-0.42,0.91,0.12],[-0.53,1.1,0.15]],[0.07,0.038,0.026]);
    // Two exposed roots anchor it without a decorative ground patch.
    limb([[0,0.12,0],[-0.3,0.05,0.12],[-0.59,0.015,0.18]],[0.12,0.065,0.012]);
    limb([[0,0.1,0],[0.27,0.04,-0.14],[0.48,0.01,-0.23]],[0.11,0.055,0.01]);
    var bankMat2 = new THREE.MeshStandardMaterial({ color: 0xa8a29a, roughness: 1 });
    var oldBank = mesh(new THREE.BoxGeometry(400, 2.2, 8), bankMat2, 80, 0.9, -230); oldBank.rotation.y = 0.12; oldBank.castShadow = false;
  })();

  // ============================================================
  // WIND FROM NO DIRECTION: dust and haze, each drift its own way
  // ============================================================
  var fogSprites = [];
  function addFog(tex, n, x0, x1, y0, y1, z0, z1, s0, s1, op0, op1, aspect) {
    for (var i = 0; i < n; i++) {
      var sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthWrite: false, opacity: rand(op0, op1) }));
      var s = rand(s0, s1); sp.scale.set(s, s * aspect, 1);
      sp.position.set(rand(x0, x1), rand(y0, y1), rand(z0, z1)); scene.add(sp);
      var a = rand(0, 6.3), sp2 = rand(0.012, 0.03);
      fogSprites.push({ sprite: sp, x0: sp.position.x, z0: sp.position.z, dx: Math.cos(a) * sp2, dz: Math.sin(a) * sp2, sway: rand(0, 6.3), swaySpeed: rand(0.0006, 0.002), swayAmt: rand(0.4, 1.6), reach: rand(6, 16), t: rand(0, 1000) });
    }
  }
  var whiteHaze = radialTex(220, 216, 210, 0.2, 0.4), dust = radialTex(200, 190, 172, 0.16, 0.4), violetHaze = radialTex(140, 120, 150, 0.12, 0.45), riverMist = radialTex(190, 190, 195, 0.16, 0.4);
  addFog(dust, 46, -60, 60, 0.2, 2.0, -120, 12, 6, 22, 0.14, 0.3, 0.3);
  addFog(whiteHaze, 30, -90, 90, 1.5, 7, -200, -20, 20, 70, 0.1, 0.22, 0.28);
  addFog(violetHaze, 16, -180, 20, 6, 30, -420, -180, 60, 160, 0.08, 0.18, 0.3);
  addFog(riverMist, 22, -60, -10, 0.1, 1.2, -140, 4, 5, 14, 0.12, 0.24, 0.3);
  // low dust streamers crossing the ground, thin and quick to fade
  var streamers = [];
  var streamTex = canvasTex(256, 32, function(ctx, w, h) { var g = ctx.createLinearGradient(0, 0, w, 0); g.addColorStop(0, 'rgba(235,228,214,0)'); g.addColorStop(0.3, 'rgba(235,228,214,0.7)'); g.addColorStop(0.7, 'rgba(235,228,214,0.7)'); g.addColorStop(1, 'rgba(235,228,214,0)'); ctx.fillStyle = g; ctx.fillRect(0, 0, w, h); var v = ctx.createLinearGradient(0, 0, 0, h); v.addColorStop(0, 'rgba(0,0,0,1)'); v.addColorStop(0.5, 'rgba(0,0,0,0)'); v.addColorStop(1, 'rgba(0,0,0,1)'); ctx.globalCompositeOperation = 'destination-out'; ctx.fillStyle = v; ctx.fillRect(0, 0, w, h); });
  for (var si = 0; si < 30; si++) {
    var st = new THREE.Sprite(new THREE.SpriteMaterial({ map: streamTex, transparent: true, depthWrite: false, opacity: 0 }));
    st.scale.set(rand(8, 20), rand(0.5, 1.2), 1); scene.add(st);
    streamers.push({ s: st, life: rand(0, 8), dir: rand(0, 6.3), speed: rand(1.5, 4) });
  }
  function resetStreamer(sr) { sr.life = 0; sr.dir = rand(0, 6.3); sr.speed = rand(3, 7); sr.dur = rand(3, 7); var x = rand(-30, 40), z = rand(-70, 4); sr.s.position.set(x, plainY(x, z) + rand(0.2, 0.9), z); }
  streamers.forEach(resetStreamer);

  // ============================================================
  // ANIMATION
  // ============================================================
  // The bruise caught in the wet mud of the plain: one additive streak laid
  // along the line from the camera towards the glow in the north, amber at
  // its heart and violet at its edges, broken into bands by the mud, and
  // breathing with the bruise (br) in animate.
  var pcSheenTex = canvasTex(64, 512, function(ctx, w, h) {
    var g2 = ctx.createLinearGradient(0, 0, w, 0);
    g2.addColorStop(0, 'rgba(120,70,130,0)'); g2.addColorStop(0.25, 'rgba(150,100,130,0.35)'); g2.addColorStop(0.5, 'rgba(210,150,90,0.8)'); g2.addColorStop(0.75, 'rgba(150,100,130,0.35)'); g2.addColorStop(1, 'rgba(120,70,130,0)');
    ctx.fillStyle = g2; ctx.fillRect(0, 0, w, h);
    var v2 = ctx.createLinearGradient(0, 0, 0, h);
    v2.addColorStop(0, 'rgba(0,0,0,1)'); v2.addColorStop(0.3, 'rgba(0,0,0,0.3)'); v2.addColorStop(0.7, 'rgba(0,0,0,0.3)'); v2.addColorStop(1, 'rgba(0,0,0,1)');
    ctx.globalCompositeOperation = 'destination-out';
    ctx.fillStyle = v2; ctx.fillRect(0, 0, w, h);
    for (var b2 = 0; b2 < 70; b2++) { ctx.fillStyle = 'rgba(0,0,0,' + (0.3 + Math.random() * 0.6) + ')'; ctx.fillRect(0, Math.random() * h, w, 1 + Math.random() * 4); }
  });
  var pcSheen = new THREE.Mesh(new THREE.PlaneGeometry(5, 44), new THREE.MeshBasicMaterial({ map: pcSheenTex, blending: THREE.AdditiveBlending, transparent: true, opacity: 0.06, depthWrite: false }));
  pcSheen.rotation.order = 'YXZ'; pcSheen.rotation.x = -Math.PI / 2; pcSheen.rotation.y = Math.atan2(6 - BR.x, 8 - BR.z);
  pcSheen.position.set(2.0, plainY(2.0, -18) + 0.2, -18); scene.add(pcSheen);
  // Reduced motion: the clock is pinned at 4s (river, reeds and bruise
  // settled) and the haze and streamers hold still.
  var pcStill = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var clock = new THREE.Clock();
  function animate() {
    if (!pcActive) return;
    pcAnimId = requestAnimationFrame(animate);
    var dt = pcStill ? 0 : Math.min(clock.getDelta(), 0.05), t = pcStill ? 4 : clock.elapsedTime;
    // Slow advection gives the pale reflected sky a current.
    riverTex.offset.y = t * 0.003;
    // the river's skin
    var wp = window.__wg.attributes.position;
    for (var i = 0; i < wp.count; i++) { var b = window.__wbase[i]; wp.setZ(i, Math.sin(b.y * 0.12 + t * 0.6) * 0.12 + Math.sin(b.x * 0.6 + b.y * 0.05 - t * 0.9) * 0.07); }
    wp.needsUpdate = true; window.__wg.computeVertexNormals();
    // haze that cannot agree on a direction
    for (var f = 0; f < (pcStill ? 0 : fogSprites.length); f++) {
      var fs = fogSprites[f]; fs.t += 1; fs.sway += fs.swaySpeed;
      var k = Math.sin(fs.t * 0.006);
      fs.sprite.position.x = fs.x0 + fs.dx * fs.reach * 60 * k + Math.sin(fs.sway) * fs.swayAmt;
      fs.sprite.position.z = fs.z0 + fs.dz * fs.reach * 60 * k;
    }
    for (var s = 0; s < streamers.length; s++) {
      var sr = streamers[s]; sr.life += dt;
      if (sr.life > sr.dur) resetStreamer(sr);
      sr.s.position.x += Math.cos(sr.dir) * sr.speed * dt; sr.s.position.z += Math.sin(sr.dir) * sr.speed * dt;
      sr.s.material.opacity = 0.85 * Math.sin(Math.PI * sr.life / sr.dur);
    }
    // the bruise breathes, slowly, like something behind it is not asleep
    var br = 0.5 + 0.5 * Math.sin(t * 0.35); br = br * br;
    bruiseCore.material.opacity = 0.08 + br * 0.3;
    bruiseRing.material.opacity = 0.1 + br * 0.14;
    bruiseDark.material.opacity = 0.16 + br * 0.14;
    northLight.intensity = 0.12 + br * 0.3;
    window.__skin.material.opacity = 0.3 + br * 0.35;
    pcSheen.material.opacity = 0.045 + br * 0.075;
    // the reeds bend to a wind that keeps changing its mind
    var wdir = Math.sin(t * 0.23) * 1.2, wstr = 0.55 + 0.45 * Math.sin(t * 0.41);
    for (var r = 0; r < reeds.length; r++) { var R = reeds[r]; var g = Math.sin(t * R.sp + R.ph) * 0.12 * wstr; R.m.rotation.x = R.rx + Math.cos(wdir) * (0.18 * wstr + g); R.m.rotation.z = R.rz + Math.sin(wdir) * (0.18 * wstr + g); }
    // the woman rocks with the washing: forward over the water and back, a little lift at the turn
    if (washer) { var wk = Math.sin(t * 1.45); washer.position.x = washer.userData.x0 - 0.03 * (wk + 1); washer.position.y = washer.userData.y0 - 0.012 * (wk + 1); }
    raycaster.setFromCamera(mouseNDC, camera);
    var hits = mouseMoved ? raycaster.intersectObjects(clickableObjects) : [];
    var hv = hits.length ? venueData.get(hits[0].object) : null;
    if (hv !== hoveredVenue) {
      hoveredVenue = hv;
      if (hv) { tooltip.textContent = hv.name; tooltip.classList.add('visible'); pcWrap.style.cursor = 'pointer'; }
      else { tooltip.classList.remove('visible'); pcWrap.style.cursor = ''; }
    }
    renderer.render(scene, camera);
  }
  animate();

var pcBtn = document.createElement('div');
pcBtn.textContent = 'WALK OUT ONTO THE PLAIN';
pcBtn.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:14px min(36px, 8vw);white-space:nowrap;max-width:calc(100vw - 16px);box-sizing:border-box;font:16px "Courier New",monospace;color:rgba(38,32,28,0.95);border:1px solid rgba(46,40,35,0.45);letter-spacing:min(4px, 0.9vw);cursor:pointer;z-index:9004;background:rgba(247,245,241,0.42);backdrop-filter:none;opacity:0;transition:opacity 2s ease;';
setTimeout(function() { pcBtn.style.opacity = '1'; }, 2200);
pcBtn.addEventListener('mouseenter', function() { pcBtn.style.borderColor = 'rgba(38,32,28,0.85)'; });
pcBtn.addEventListener('mouseleave', function() { pcBtn.style.borderColor = 'rgba(46,40,35,0.45)'; });
pcBtn.addEventListener('click', function(e) { e.stopPropagation(); pcEnter(); });
pcWrap.appendChild(pcBtn);
document.body.appendChild(pcWrap);
if (window.dssFilmGrade) window.dssFilmGrade(pcWrap);
}

setInterval(function() {
var container = document.getElementById('pc-container');
if (container && !pcActive) {
initpc();
} else if (!container && pcActive) {
pcActive = false;
if (pcAnimId) { cancelAnimationFrame(pcAnimId); pcAnimId = null; }
window._dssDisposeWrap('pc-wrap');
}
}, 300);
})();

// ===== ENDGAME VISUAL CONTINUITY — local decorative layers only =====
window.dssEndgameStage = function(stage, marker) {
  if(!marker || !marker.isConnected || marker.dataset.ready)return;
  marker.dataset.ready='1';
  var passage=marker.closest('.dss-room-prose, tw-passage');if(!passage)return;
  passage.dataset.endgame=stage;
  var reduced=window.matchMedia('(prefers-reduced-motion: reduce)'), raf=0, alive=true, last=0, time=0, canvas=null, c=null;
  var observer, resize, visible=true, intersection;
  function stop(){alive=false;cancelAnimationFrame(raf);observer.disconnect();if(resize)resize.disconnect();if(intersection)intersection.disconnect();reduced.removeEventListener('change',motion);}
  function glow(x,y,r,col){var g=c.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,col);g.addColorStop(1,'rgba(0,0,0,0)');c.fillStyle=g;c.fillRect(x-r,y-r,r*2,r*2);}
  function skyline(t){
    var dim=stage==='incomplete', final=stage==='dawn', W=600,H=210;
    // Dawn's actual moving sky shows through the skyline, without a second
    // rectangular sky painted inside it. Earlier ending stages keep theirs.
    if(!final){
    var g=c.createLinearGradient(0,0,0,H);
    g.addColorStop(0,dim?'#0d1522':'#19202e');g.addColorStop(.6,dim?'#333645':'#686075');g.addColorStop(1,dim?'#7b717b':'#c6a393');
    c.fillStyle=g;c.fillRect(0,0,W,H);
    glow(440,152,195,dim?'rgba(163,166,190,.14)':'rgba(249,205,162,.24)');
    // Thin cloud strata catch the dawn without sliding the whole landscape.
    for(var j=0;j<9;j++){
      var y=25+j*13,x=-80+(j*79)%210+Math.sin(t*.035+j)*9;
      var mist=c.createLinearGradient(x,y,x+430,y);
      mist.addColorStop(0,'rgba(189,182,197,0)');mist.addColorStop(.5,'rgba(195,185,194,'+(j%2?.035:.065)+')');mist.addColorStop(1,'rgba(189,182,197,0)');
      c.fillStyle=mist;c.beginPath();c.ellipse(x+215,y,215,2+j%3,0,0,Math.PI*2);c.fill();
    }
    }
    for(var layer=0;layer<3;layer++){
      var base=160+layer*22; c.fillStyle=['#4b4856','#30333e','#171f2a'][layer];
      for(var i=0;i<30;i++){
        // Low, irregular London terraces: chimney pots and parapets leave
        // room for the cathedral, rather than forming a wall of towers.
        var x=i*25-30+layer*11, h=7+(i*17+layer*13)%17, w=22+(i%4)*3;
        c.fillRect(x,base-h,w,H-base+h);
        if(i%3===1){c.beginPath();c.moveTo(x-1,base-h);c.lineTo(x+w/2,base-h-5);c.lineTo(x+w+1,base-h);c.fill();}
        else c.fillRect(x-1,base-h-2,w+2,3);
        if(i%3===0){c.fillRect(x+4,base-h-7,7,8);c.fillRect(x+4,base-h-10,2,4);c.fillRect(x+9,base-h-10,2,4);}
        if(layer===2){
          c.fillStyle='rgba(217,174,118,.20)';
          for(var k=0;k<2;k++)if((i+k)%3===0)c.fillRect(x+5+k*9,base-h+8,3,4);
          c.fillStyle='#171f2a';
        }
      }
    }
    // 2026-10-26 (Sam): St Paul's is the skyline's defining landmark.
    // Broad dome, colonnaded drum, lantern and cross; kept above the roofs.
    c.fillStyle='#30333e';
    c.fillRect(368,164,110,29);
    c.beginPath();c.moveTo(377,164);c.lineTo(388,154);c.lineTo(458,154);c.lineTo(470,164);c.closePath();c.fill();
    // Lower the dome onto a short drum; the columns are only a quiet hint.
    c.fillRect(394,151,58,13);c.fillRect(390,148,66,4);c.fillRect(391,160,64,3);
    c.save();c.translate(0,12);
    c.beginPath();c.moveTo(391,135);c.bezierCurveTo(393,113,402,99,418,95);c.lineTo(428,95);c.bezierCurveTo(444,99,453,113,455,135);c.closePath();c.fill();
    c.fillRect(389,133,68,4);c.fillRect(417,85,12,11);c.fillRect(415,83,16,3);
    c.beginPath();c.moveTo(416,83);c.quadraticCurveTo(417,77,423,76);c.quadraticCurveTo(429,77,430,83);c.closePath();c.fill();
    c.fillRect(422,67,2,11);c.fillRect(419,70,8,2);
    c.restore();
    // Narrow lit slots suggest the drum's columns without turning it into a logo.
    c.fillStyle='rgba(195,187,181,.13)';
    for(var col=0;col<9;col++)c.fillRect(397+col*6,154,2,5);
    c.strokeStyle='rgba(210,200,184,.17)';c.lineWidth=.8;
    c.beginPath();c.moveTo(393,146);c.bezierCurveTo(396,126,404,113,418,109);c.stroke();
    // A modest Wren-like steeple among the nearer chimney stacks.
    c.fillStyle='#30333e';c.beginPath();c.moveTo(145,161);c.lineTo(150,122);c.lineTo(155,161);c.fill();c.fillRect(143,150,14,36);
    if(!final){var bottom=c.createLinearGradient(0,170,0,210);bottom.addColorStop(0,'rgba(13,17,22,0)');bottom.addColorStop(1,'#10151c');c.fillStyle=bottom;c.fillRect(0,170,600,40);}
  }
  function sanctum(t){
    c.fillStyle='#10131a';c.fillRect(0,0,600,230);
    glow(300,90,230,'rgba(192,186,158,.15)');
    c.strokeStyle='rgba(170,177,172,.11)';c.lineWidth=1;
    c.beginPath();c.moveTo(0,180);c.lineTo(240,100);c.lineTo(360,100);c.lineTo(600,180);c.stroke();
    // Two empty chairs and the table: the prose supplies the person.
    for(var side=0;side<2;side++){
      var x=side?385:170;
      c.fillStyle='#111118';c.fillRect(x,108,43,57);
      c.strokeStyle='rgba(144,121,93,.25)';c.strokeRect(x,108,43,57);
      c.fillRect(x+3,161,4,38);c.fillRect(x+35,161,4,38);
    }
    var wood=c.createLinearGradient(0,110,0,218);wood.addColorStop(0,'#3c322c');wood.addColorStop(.5,'#25231f');wood.addColorStop(1,'#181a1b');
    c.fillStyle=wood;c.beginPath();c.moveTo(249,110);c.lineTo(351,110);c.lineTo(466,225);c.lineTo(134,225);c.closePath();c.fill();
    c.strokeStyle='rgba(184,156,113,.18)';c.lineWidth=.7;
    for(var i=0;i<13;i++){var x=252+i*8;c.beginPath();c.moveTo(x,112);c.lineTo(143+(x-252)*3.1,223);c.stroke();}
    glow(301,150,67,'rgba(215,197,147,.10)');
    // Damp dark cover, page block and fine reflected light along its spine.
    c.fillStyle='#111117';c.beginPath();c.moveTo(281,147);c.lineTo(323,148);c.lineTo(339,176);c.lineTo(276,174);c.closePath();c.fill();
    c.strokeStyle='rgba(217,204,164,.30)';c.beginPath();c.moveTo(277,174);c.lineTo(338,176);c.stroke();
    c.strokeStyle='rgba(140,135,115,.32)';c.beginPath();c.moveTo(284,149);c.lineTo(280,171);c.stroke();
    for(var j=0;j<16;j++){c.fillStyle='rgba(220,211,183,.13)';c.beginPath();c.arc(253+(j*29)%101,37+(j*17+t*1.8)%94,.45,0,Math.PI*2);c.fill();}
  }
  function seal(t){
    c.clearRect(0,0,440,340);
    glow(220,170,168,'rgba(103,104,155,.13)');
    c.save();c.translate(220,170);c.rotate(t*.055);
    // Two lobes exchange a fine luminous stream through the shared centre.
    for(var side=0;side<2;side++){
      c.save();c.rotate(side*Math.PI);
      var swell=1+Math.sin(t*.6+side*Math.PI)*.075;
      c.scale(swell,1/swell);
      glow(67,0,81,side?'rgba(165,193,232,.23)':'rgba(239,181,99,.29)');
      var g=c.createLinearGradient(0,0,128,0);g.addColorStop(0,'rgba(250,229,178,.35)');g.addColorStop(.5,side?'rgba(164,192,220,.23)':'rgba(211,149,76,.27)');g.addColorStop(1,'rgba(94,91,131,.025)');
      c.fillStyle=g;c.beginPath();c.moveTo(0,0);c.bezierCurveTo(30,-5,48,-56,88,-42);c.bezierCurveTo(148,-15,118,61,69,38);c.bezierCurveTo(36,23,20,6,0,0);c.fill();
      for(var i=0;i<9;i++){
        c.beginPath();c.moveTo(0,0);c.bezierCurveTo(23,-10+i*2,48,-46+i*2,85,-34+i*3);c.bezierCurveTo(126,-17,113,41-i*2,74,29-i);
        c.strokeStyle='rgba(235,214,181,'+(.03+i*.008)+')';c.lineWidth=.65;c.stroke();
      }
      glow(76,-1,23,side?'rgba(218,235,250,.7)':'rgba(255,233,185,.8)');
      c.fillStyle=side?'#e2ebef':'#ffe9b8';c.beginPath();c.arc(76,-1,2.4,0,Math.PI*2);c.fill();
      c.restore();
    }
    c.strokeStyle='rgba(218,197,144,.23)';c.lineWidth=.7;
    for(var k=0;k<2;k++){c.beginPath();for(var j=0;j<=5;j++){var a=-Math.PI/2+k*Math.PI+j*4*Math.PI/5,x=Math.cos(a)*139,y=Math.sin(a)*139;if(!j)c.moveTo(x,y);else c.lineTo(x,y);}c.stroke();}
    c.restore();glow(220,170,13,'rgba(255,239,204,.6)');
  }
  function paint(t){
    var d=canvas._ratio;c.setTransform(d,0,0,d,0,0);c.clearRect(0,0,canvas._w,canvas._h);
    if(stage==='synthesis')seal(t);else if(stage==='sanctum'||stage==='sitting')sanctum(t);else skyline(t);
  }
  function frame(now){raf=0;if(!alive)return;if(!marker.isConnected){stop();return;}if(visible&&!document.hidden){time+=last?Math.min(.05,(now-last)/1000):0;paint(time);}last=now;if(!reduced.matches)raf=requestAnimationFrame(frame);}
  function motion(){cancelAnimationFrame(raf);raf=0;last=0;if(!canvas)return;if(reduced.matches)paint(12);else raf=requestAnimationFrame(frame);}
  function attach(){
    var current=marker.closest('.dss-room-prose, tw-passage');
    if(current){passage=current;passage.dataset.endgame=stage;}
    if(canvas)return;
    var host;
    if(stage==='synthesis'){host=passage.querySelector('.hexagram-wrap');if(!host)return;}
    else if(['complete','incomplete','dawn'].indexOf(stage)>=0)host=passage.querySelector('.ending-pane');
    else if(stage==='sanctum'||stage==='sitting'||stage==='alt')host=passage;
    if(!host)return;
    canvas=document.createElement('canvas');c=canvas.getContext('2d');if(!c){canvas=null;return;}
    canvas.className='dss-end-frieze';canvas.setAttribute('aria-hidden','true');
    var W=stage==='synthesis'?440:600,H=stage==='synthesis'?340:(stage==='sanctum'||stage==='sitting'?230:210);
    canvas._w=W;canvas._h=H;
    canvas._ratio=Math.min(window.devicePixelRatio||1,2);canvas.width=W*canvas._ratio;canvas.height=H*canvas._ratio;
    if(stage==='synthesis'){var svg=host.querySelector('svg');if(svg)svg.style.display='none';host.appendChild(canvas);}
    else host.insertBefore(canvas,host.firstChild);
    if(window.IntersectionObserver){intersection=new IntersectionObserver(function(e){visible=e[0].isIntersecting;last=0;});intersection.observe(canvas);}
    paint(12);motion();
  }
  observer=new MutationObserver(function(){if(!marker.isConnected){stop();return;}attach();});observer.observe(document.body,{childList:true,subtree:true});
  reduced.addEventListener('change',motion);attach();
};
// ===== END ENDGAME VISUAL CONTINUITY =====

/* 2026-10-17: the readers' world lines (.dss-gift-line, data-gift = the world) show on tonight's gift (a .dss-gift-now marker printed by Harlowe when the flag is true) or on a gift from an earlier night (the lifetime store dssLifetimeGifts, written at each world's centre by dssMarkWorldSeen). Swept every 300 ms so lines inside (replace:) hooks and room panels are caught. */
(function(){ function sweep(){ var gifts = window.dssLoadLifetimeGifts ? window.dssLoadLifetimeGifts() : []; Array.prototype.forEach.call(document.querySelectorAll('.dss-gift-line[hidden]'), function(el){ var g = el.getAttribute('data-gift'); if (gifts.indexOf(g) >= 0 || document.querySelector('.dss-gift-now[data-gift="' + g + '"]')) el.removeAttribute('hidden'); }); } setInterval(sweep, 300); })();

:: Approach Centre Point [piano-bed] {"position":"1650,50","size":"100,100"}
<span id="dss-end-climb" hidden></span><script>setTimeout(function(){if(window.dssEndgameStage)window.dssEndgameStage("climb",document.getElementById("dss-end-climb"));},0);</script>\
<script>(function(){/* Continue the prefetch chain started on The Fetch — by now Three.js is already loaded by the CP scene init below, so this is mainly for the iframe HTML, which is the dominant network cost on Dawn Approach. Idempotent: HTTP cache dedups and the link element is id-guarded. */try{fetch('oxford-street-from-centre-point-3d-static.html',{cache:'force-cache'});}catch(e){}if(!document.getElementById('dss-three-prefetch')){var l=document.createElement('link');l.id='dss-three-prefetch';l.rel='preload';l.as='script';l.href='vendor/three/three.min.js';document.head.appendChild(l);}})();</script>\
(set: $visitedCentrePoint to true)\
(if: $sawAstralReveal is false)[(set: $sawAstralReveal to true)<script>
/* First arrival at Centre Point — the city you walked tonight dissolves
   into stars. Fires once. Deferred ~2.4s so the 3D scene paints in first;
   then the astral graph rises over it, holds, fades. The dot link below
   stays clickable underneath (z-index 9998 < pointer-events:none anyway).
   Outer setTimeout(0) defers the _passageGen snapshot until after the
   MutationObserver has incremented it for THIS passage; same race fix as
   showDrinkPopupSafe and the Ripley's Wheel trigger. */
(function(){
  setTimeout(function(){
    var pgGen = window._passageGen;
    setTimeout(function(){
      if (window._passageGen !== pgGen) return;
      if (window.dssAstralReveal) window.dssAstralReveal();
    }, 2400);
  }, 0);
})();
</script>]
