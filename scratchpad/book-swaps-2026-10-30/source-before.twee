    y=height(s);beginButton.disabled=false;resize();resizeObserver=new ResizeObserver(resize);resizeObserver.observe(canvas.parentElement);
    listen(window,'resize',resize);
    if(window.DSS_DEV)window._hcDev={canvas:canvas,snapshot:function(){return {s:s,u:u,y:y,ground:height(s),vy:vy,grounded:grounded,breath:breath,prints:prints,slips:slips,checkpoint:checkpoint,yetiS:yetiS,ending:ending,paused:paused,finished:finished,coyote:coyoteT,buffer:bufferT,activePrints:printList.filter(function(p){return p.mesh.visible;}).length,drawCalls:renderer.info.render.calls,climbing:climbing,corniceBroken:corniceBroken,avalanche:avalanche.phase,avalancheFront:avalanche.front,gust:gust.phase,gustDir:gust.dir,dawn:dawn,bloom:!!composer,wind:wind.strength,whirl:whirl.active,width:width(s),plateau:!!plateau(s)};},
      // Testing only: put the climber at any point on the route, or force a gust.
      warp:function(at){if(!started||ending>=0)return;s=Math.max(0,Math.min(LENGTH-1,at));u=0;y=height(s);vy=0;grounded=true;yetiS=Math.min(LENGTH,s+13);nextPrint=Math.max(nextPrint,s+3);cameraReady=false;},
      gust:function(dir){gust.phase='warning';gust.t=0;gust.dir=dir||1;},
      shove:function(du){u+=du;},
      yeti:yeti, climber:climber, // 2026-10-18: for close-up checks of the yeti and the mountaineer (dev only)
      calm:function(on){windLock=!!on;if(on){wind.target=0;wind.strength=0;gust.phase='idle';gust.next=99;}else{wind.timer=0;gust.next=4;}},
      avalanche:function(){var ci=0;for(var i=0;i<COULOIRS.length;i++)if(s<COULOIRS[i][1])ci=i,i=99;avalanche.phase='warning';avalanche.index=ci;avalanche.t=0;avalanche.front=Math.max(s+22,COULOIRS[ci][1]+8);avalanche.cued=false;if(avalanche.done.indexOf(ci)<0)avalanche.done.push(ci);announce('THE SLOPE IS GOING · BE READY TO JUMP');}};
    loop(performance.now());
  }
  function makePrint(at){
    if(gap(at))return;
    var material=new THREE.MeshBasicMaterial({color:0x57c7ff,transparent:true,opacity:.95,depthWrite:false});
    var g=new THREE.Group(),geo=new THREE.CircleGeometry(1,10);
    [-1,1].forEach(function(side){var foot=new THREE.Mesh(geo,material);foot.rotation.x=-Math.PI/2;foot.scale.set(.16,.32,1);foot.position.set(side*.19,0,side*.18);g.add(foot);});
    // 2026-10-14 (overnight report, Sam: fix): the prints wander across the path, so following them takes steering
    // (on the centre line they collected themselves); on the narrow bridge they keep near the middle
    var lim=Math.max(.2,width(at)/2-.9),pu=Math.max(-lim,Math.min(lim,1.6*Math.sin(at*.55)+.5*Math.sin(at*1.7)));
    g.position.copy(position(at,pu,height(at)+.045));g.rotation.y=-Math.atan(tangent(at));scene.add(g);
    printList.push({s:at,u:pu,born:time,mesh:g,material:material,geometry:geo,id:Math.round(at*100)});
  }
  // A fall is a whirlwind, not a teleport (Sam: "swept back onto the course
  // in a whirlwind like you did in the old version"). The climber is lifted,
  // spun and carried back to the last flags; the slip is counted at once and
  // the hazards reset when he is set down. Input is dead while airborne.
  function respawn(){if(whirl.active)return;slips++;whirl.active=true;whirl.t=0;whirl.fs=s;whirl.fu=u;whirl.fy=Math.max(y,height(s)-2);whirl.ts=Math.min(checkpoint,s);while(whirl.ts>2 && (!support(whirl.ts,0)||LADDERS.some(function(l){return whirl.ts>=l.a && whirl.ts<=l.b;})))whirl.ts-=.25;whirl.ty=height(whirl.ts);whirl.dur=Math.min(2.8,1.3+Math.abs(s-whirl.ts)*.022);clearInput();vy=0;grounded=false;if(whirlMesh)whirlMesh.visible=true;announce('SWEPT BACK · THE WIND KEEPS YOU');}
  function setDown(){whirl.active=false;if(whirlMesh)whirlMesh.visible=false;corniceTimer=-1;corniceWarned=false;corniceBroken=false;if(corniceMesh){corniceMesh.visible=true;corniceMesh.position.y=height(227.5)-.08;}
    if(avalanche.index>=0){var di=avalanche.done.indexOf(avalanche.index);if(di>=0)avalanche.done.splice(di,1);}avalanche.phase='idle';avalanche.t=0;avalanche.index=-1;if(avalancheMesh)avalancheMesh.visible=false;
    s=whirl.ts;u=0;y=height(s);vy=0;grounded=true;coyoteT=COYOTE;bufferT=0;breath=Math.max(.65,breath);climber.rotation.z=0;
    clearInput();rescueGrace=1.8;rescueShelter=true;wind.strength=0;wind.target=0;wind.timer=2;gust.phase='idle';gust.t=0;gust.next=5;
    yetiS=Math.min(LENGTH,s+13);nextPrint=s+1.35;
    printList.forEach(function(p){scene.remove(p.mesh);p.geometry.dispose();p.material.dispose();});printList=[];
    announce('SAFE AT THE FLAGS · TAKE YOUR TIME');}
  function update(dt){
    if(!started||paused||finished)return;time+=dt;
    if(ending>=0){
      ending+=dt;
      if(ending>1.2 && !turned){turned=true;if(window.dssAudio && window.dssAudio.loreUnravel && !(window.dssAudio.isMuted && window.dssAudio.isMuted()))window.dssAudio.loreUnravel();}
      if(ending>3.8)yetiS=Math.min(LENGTH+8,yetiS+dt*1.5);
      if(ending>8){finished=true;clearInput();hud.textContent='';banner.textContent='';
        var EZ=window.dssEase?window.dssEase.level('climb'):0;/* 2026-10-28 (dssEase): after a lost climb the next asks fewer prints and forgives more slips */
        var won=slips<=3+EZ && prints>=10-2*EZ;var exit=document.getElementById(won?'hc-win':'hc-lose');exit.style.display='block';exit.classList.add('dss-mini-exit');
        if(!won && window.dssEase){window.dssEase.lost('climb');window.dssEase.offer(stage, { onAgain: function(){ var a = document.querySelector('.hc-again tw-link'); if (a) a.click(); }, onMove: function(){ var l = exit.querySelector('tw-link'); if (l) l.click(); } });}
        if(document.fullscreenElement===stage)document.exitFullscreen().catch(function(){});
        exit.scrollIntoView({behavior:reducedMotion?'auto':'smooth',block:'nearest'});
      }
      return;
    }
    if(whirl.active){whirl.t+=dt;var we=Math.min(1,whirl.t/whirl.dur),wk=we*we*(3-2*we);
      s=whirl.fs+(whirl.ts-whirl.fs)*wk;u=whirl.fu*(1-wk);y=whirl.fy+(whirl.ty-whirl.fy)*wk+Math.sin(we*Math.PI)*5.5;
      if(we>=1)setDown();
      if(eng)eng.update(true,false,false);
      return;}
    rescueGrace=Math.max(0,rescueGrace-dt);
    var chant=(held('ArrowDown')||held('s'))&&grounded;
    var forward=held('ArrowUp')||held('w'), lateral=(held('ArrowRight')||held('d')?1:0)-(held('ArrowLeft')||held('a')?1:0);
    climbing=LADDERS.some(function(l){return s>=l.a-.1 && s<l.b && Math.abs(u)<1.15 && Math.abs(y-height(s))<.25;});
    if(climbing){bufferT=0;vy=0;grounded=true;u*=Math.max(0,1-dt*8);}
    bufferT=Math.max(0,bufferT-dt);coyoteT=grounded?COYOTE:Math.max(0,coyoteT-dt);
    if(bufferT>0 && coyoteT>0){vy=JUMP;grounded=false;bufferT=0;coyoteT=0;jumpCut=false;if(window.dssAudio&&window.dssAudio.jumpPuff)window.dssAudio.jumpPuff();}
    var oldY=y, oldS=s, oldU=u;
    // Breath changes walking speed only. Airborne range stays fully available.
    var speed=grounded?SPEED*(.66+.34*Math.min(1,breath*4)):SPEED;
    if(climbing)speed=.72;
    var moving=!chant && (forward||lateral);if(moving || !grounded)rescueShelter=false;
    if(!chant){s+=forward?speed*dt:0;if(!climbing)u+=lateral*4.6*dt;}
    // Walking stops at a visible gap lip. Space still makes the crossing;
    // airborne players and side-edge falls retain normal collision/respawn.
    if(grounded && Math.abs(u)<width(s)/2){GAPS.concat(corniceBroken?[CORNICE]:[]).forEach(function(g){if(oldS<=g[0] && s>g[0] && s<g[1])s=g[0]-.025;});}
    if(s>=BRIDGE[0] && s<=BRIDGE[1] && grounded)u=Math.max(-.8,Math.min(.8,u));
    var top=height(s),supported=support(s,u);
    if(grounded && supported && top-oldY>.16){s=oldS;top=height(s);supported=support(s,u);}
    if(grounded && supported){y=top;vy=0;}
    /* 2026-10-23 (Sam: "Walking: I want this to be the sound used in the yeti climb"): a recorded snow step every 3 units walked on the ground (not on the ladders) */
    if(grounded && !climbing && !chant){snowWalk+=Math.abs(s-oldS)+Math.abs(u-oldU)*.6;if(snowWalk>=3){snowWalk=0;if(window.dssAudio&&window.dssAudio.snowStep)window.dssAudio.snowStep();}}
    else{
      grounded=false;vy-=GRAV*dt;y+=vy*dt;
      // Resolve the solid riser BEFORE testing the landing. A jump below its
      // lip stays on the lower side, rather than entering the upper mesh.
      if(supported){STEPS.forEach(function(edge){
        if(oldS<edge && s>=edge && y<height(s)){s=edge-.001;}
      });top=height(s);supported=support(s,u);}
      // Sweep feet against the surface at BOTH ends of this movement. The
      // uphill floor can meet a rising foot near the apex; vertical velocity
      // alone must not reject that landing or let the snow overtake the feet.
      var wasAbove=support(oldS,oldU) ? oldY>=height(oldS)-.002 : oldY>=top-.002;
      if(supported && wasAbove && y<=top){if(window.dssAudio&&window.dssAudio.landThud)window.dssAudio.landThud(Math.min(1.4,Math.abs(vy)/Math.abs(JUMP)));y=top;vy=0;grounded=true;}
    }
    // GUSTS. Idle → warning (1.4s: the flurries lean and the wind rises, no
    // push yet) → blowing (1.2s: a sideways shove of 2.4 you can lean against,
    // lateral speed being 4.6; standing still costs about three units, a fall
    // only if you were already near that edge) → idle. Never on a ladder, the bridge
    // (its rails already clamp), during the avalanche or the ending, and not
    // before the first flag so the opening teaches the controls first.
    var exempt=climbing || rescueGrace>0 || rescueShelter || (s>=BRIDGE[0]&&s<=BRIDGE[1]) || avalanche.phase!=='idle';
    // THE WIND. A crosswind that picks a new target strength and side every
    // few seconds and eases toward it; it grows with height and is multiplied
    // on the plateaus. Gusts (warned by the flurries and the wind bed for
    // 1.4s) come every 4 to 9s on top of it. Together they are what you fight:
    // hold forward alone and you drift off. Chanting plants you and the wind
    // cannot move you, which is what chanting costs you in breath-time.
    wind.timer-=dt;if(wind.timer<=0){wind.timer=2.4+Math.random()*3.6;wind.target=windLock?0:(Math.random()<.2?0:(.6+Math.random()))*(Math.random()<.5?-1:1);}
    wind.strength+=(wind.target-wind.strength)*Math.min(1,dt*1.1);
    var pl=plateau(s),windMul=(s<FLAGS[0]?.45:1)*(1+dawn*.35)*(pl?pl[3]:1);
    if(gust.phase==='idle'){gust.next-=dt;if(gust.next<=0 && !exempt && s>=FLAGS[0]){gust.phase='warning';gust.t=0;gust.dir=Math.random()<.5?-1:1;if(window.dssAudio&&window.dssAudio.gust&&window.dssAudio._tick)window.dssAudio._tick(function(){window.dssAudio.gust(false);}); /* 2026-10-18 night: the wind rises with the warning */if(reducedMotion)announce('GUST FROM THE '+(gust.dir<0?'RIGHT':'LEFT'));}}
    else{gust.t+=dt;
      if(gust.phase==='warning' && gust.t>1.4){gust.phase='blowing';gust.t=0;}
      else if(gust.phase==='blowing' && gust.t>1.5){gust.phase='idle';gust.t=0;gust.next=4+Math.random()*5;}
      if(exempt && gust.phase!=='idle'){gust.phase='idle';gust.next=4+Math.random()*4;}
    }
    var push=(wind.strength+(gust.phase==='blowing'?gust.dir*2:0))*windMul;
    // Always leave steering authority, even on exposed plateaus. Air is steadier.
    push=exempt?0:Math.max(-3.5,Math.min(3.5,push));
    if(!chant)u+=push*(grounded?1:.8)*dt;
    dawn=Math.max(0,Math.min(1,(s-30)/(LENGTH-60)));
    if(!corniceWarned && s>=CORNICE[0]-3.5 && s<CORNICE[1]){corniceWarned=true;announce('CORNICE · HOLD JUMP + ↑');}
    if(corniceTimer<0 && grounded && s>=CORNICE[0] && s<CORNICE[1])corniceTimer=0;
    if(corniceTimer>=0 && !corniceBroken){corniceTimer+=dt;if(corniceTimer>.3){corniceBroken=true;if(corniceMesh)corniceMesh.visible=false;
      // The shelf goes from under anyone still standing on it: a runner cannot step across the hole before it opens.
      if(grounded && s>CORNICE[0] && s<CORNICE[1]){grounded=false;vy=-3;y=height(s)-1.7;}}}
    // AVALANCHES (Sam: more of them, much more warning). The warning starts
    // 30 units before the couloir and lasts 4s: the front appears eight units above
    // the couloir, visibly creeping but staying ahead during the warning, the camera trembles and the wind bed rises.
    // Then it runs at 18/s and a JUMP cue fires about 0.50s before the front
    // reaches the climber (measured against their closing speed, so walking
    // into it and standing still get the same reaction window).
    // Clearing it is a timed jump; being under it is a sweep-back.
    if(avalanche.phase==='idle' && rescueGrace<=0 && !rescueShelter){for(var ci=0;ci<COULOIRS.length;ci++){var C=COULOIRS[ci];if(avalanche.done.indexOf(ci)<0 && s>=C[0]-30 && s<C[1]){avalanche.phase='warning';avalanche.index=ci;avalanche.t=0;avalanche.front=Math.max(s+22,C[1]+8);avalanche.cued=false;avalanche.done.push(ci);announce('THE SLOPE IS GOING · BE READY TO JUMP');break;}}}
    if(avalanche.phase==='warning'){avalanche.t+=dt;avalanche.front=Math.max(s+18,avalanche.front-5*dt);if(avalanche.t>4){avalanche.phase='running';avalanche.t=0;}}
    if(avalanche.phase==='running'){
      var oldFront=avalanche.front;avalanche.front-=18*dt;avalanche.t+=dt;var C2=COULOIRS[avalanche.index];
      if(!avalanche.cued && avalanche.front>s && (avalanche.front-s)/(18+Math.max(0,(s-oldS)/dt))<.50){avalanche.cued=true;announce(hcTouch?'JUMP · HOLD JUMP':'JUMP · HOLD SPACE');}
      if(oldS<=oldFront && s>=avalanche.front && Math.abs(u)<width(s)/2 && y-height(s)<.6){respawn();announce('AVALANCHE · SWEPT BACK');return;}
      else if(avalanche.front<s-6 || avalanche.front<4){avalanche.phase='idle';avalanche.index=-1;}
    }
    if((!support(s,u) && y<height(s)-1.6) || Math.abs(u)>width(s)/2+3){respawn();return;}
    breath=Math.max(0,Math.min(1,breath+(chant?.48:(moving?-(.021+.023*s/LENGTH):.025))*dt));
    if(moving && grounded)running+=dt*11;
    flagObjects.forEach(function(flag){if(grounded && support(s,u) && Math.abs(u)<width(s)/2-.35 && Math.abs(s-flag.s)<.4 && checkpoint<flag.s){checkpoint=flag.s;flag.marker.material.color.setHex(0xd8c38d);breath=Math.max(breath,.65);announce('CHECKPOINT · PRAYER FLAGS');}});
    var desired=Math.min(LENGTH,Math.max(s+11,yetiS));yetiS+=Math.min(desired-yetiS,dt*SPEED*1.4);
    // A bounded trail of nine prints. They fade while the player pauses to chant.
    while(nextPrint<yetiS-1){makePrint(nextPrint);nextPrint+=1.35;}
    printList.forEach(function(p){var age=time-p.born;var available=!collected.has(p.id)&&age<24;p.mesh.visible=available;p.material.opacity=Math.max(0,.95-age/26);
      if(available && Math.abs(s-p.s)<.75 && Math.abs(u-(p.u||0))<.6 && Math.abs(y-height(p.s))<.7){collected.add(p.id);prints++;p.mesh.visible=false;if(eng)eng.tick();}
    });
    while(printList.length>9){var old=printList.shift();scene.remove(old.mesh);old.geometry.dispose();old.material.dispose();}
    if(s>=LENGTH-8 && grounded){ending=0;yetiS=LENGTH;clearInput();banner.textContent='';banner.style.opacity='0';hud.textContent='';}
    else{var wa=Math.min(4,Math.round(Math.abs(push)/.9)),windTxt=gust.phase==='warning'?'GUST COMING':wa===0?'WIND · calm':'WIND '+(push<0?'◀'.repeat(wa):'▶'.repeat(wa));
      var nearGap=GAPS.concat([CORNICE]).find(function(g){return g[0]-s>=-.1 && g[0]-s<6;});
      var hazard=avalanche.phase!=='idle'?(avalanche.cued?(hcTouch?'JUMP · HOLD JUMP':'JUMP · HOLD SPACE'):'AVALANCHE APPROACHING · GET READY'):nearGap?'GAP AHEAD · HOLD JUMP + ↑':STEPS.some(function(edge){return edge>=s && edge-s<2;})?'STEP UP · JUMP':'';
      var label=(hazard?hazard+'   ·   ':'')+'PRINTS '+prints+' / 10   ·   SLIPS '+slips+' / 3   ·   BREATH '+Math.round(breath*100)+'%   ·   '+windTxt+(climbing?'   ·   LADDER · HOLD ↑':chant?'   ·   '+['DATTA','DAYADHVAM','DAMYATA'][Math.floor(time*1.7)%3]:breath<.25?'   ·   Hold ↓ to chant':'');if(label!==lastHUD){hud.textContent=label;lastHUD=label;}}
    if(eng)eng.update(gust.phase!=='idle' || avalanche.phase!=='idle' || Math.abs(push)>1.4,chant,false);
  }
  function draw(dt){
    snowLight.value=reducedMotion?0:time;
    if(avalancheMesh){avalancheMesh.visible=avalanche.phase==='running'||avalanche.phase==='warning';if(avalancheMesh.visible){var block=new THREE.Object3D();for(var n=0;n<28;n++){var at=avalanche.front+(n%4)*.7;block.position.copy(position(at,(Math.floor(n/4)-3)*width(at)/6,height(at)+.28));block.scale.set(width(at)/10,.38,.6);if(!reducedMotion)block.rotation.set(time*2+n,n,time+n);block.updateMatrix();avalancheMesh.setMatrixAt(n,block.matrix);}avalancheMesh.instanceMatrix.needsUpdate=true;}}
    if(corniceMesh && !corniceBroken && corniceTimer>=0 && !reducedMotion)corniceMesh.position.y=height(227.5)-.08+Math.sin(time*35)*.035;
    climber.position.copy(position(s,u,y));climber.rotation.y=-Math.atan(tangent(s));
    if(whirl.active){
      // Spun, limbs flailing, and a helix of snow climbing round him.
      if(!reducedMotion){climber.rotation.y+=dt*15;climber.rotation.z=Math.sin(time*9)*.35;}
      climber.userData.limbs.forEach(function(l,i){l.rotation.x=reducedMotion?0:Math.sin(time*26+i*1.7)*.9;});
      if(whirlMesh){var wb=new THREE.Object3D();for(var wn=0;wn<44;wn++){var wa2=wn*.72+time*8,wr=.7+(wn%6)*.22;wb.position.set(climber.position.x+Math.cos(wa2)*wr,climber.position.y+.2+(wn/44)*3.4,climber.position.z+Math.sin(wa2)*wr);wb.scale.setScalar(.09+(wn%3)*.04);wb.updateMatrix();whirlMesh.setMatrixAt(wn,wb.matrix);}whirlMesh.instanceMatrix.needsUpdate=true;}
    }else{
      climber.rotation.z=Math.max(-.22,Math.min(.22,-(wind.strength*(plateau(s)?plateau(s)[3]:1))*.12)); // leans into a strong wind
      climber.userData.limbs.forEach(function(l,i){l.rotation.x=reducedMotion?0:Math.sin(running+(Math.floor(i/2)+i%2)*Math.PI)*.24;});
    }
    yeti.position.copy(position(yetiS,0,height(yetiS)));yeti.visible=yetiS<LENGTH+7.3;
    yeti.rotation.y=ending>1.2 && ending<3.8?Math.PI:-Math.atan(tangent(yetiS));
    if(yeti.userData.shades)yeti.userData.shades.visible=turned; // 2026-10-18 (Sam): aviators once he turns at the cave
    yeti.userData.limbs.forEach(function(l,i){l.rotation.x=reducedMotion || ending>=0 && ending<3.8?0:Math.sin(time*7+(Math.floor(i/2)+i%2)*Math.PI)*.25;});
    var baseY=Math.max(y,height(s)-1.5),cam=position(s-7.5,u*.7,baseY+4.1),look=position(s+7,u*.25,height(s+7)+1.45);
    look.y=Math.min(look.y,baseY+3); // Keep the climber in frame below steep ladders.
    // No bob, shake, FOV pulse or automatic orbit; reduced motion locks follow.
    if(!cameraReady||reducedMotion){camera.position.copy(cam);cameraReady=true;}else camera.position.lerp(cam,1-Math.exp(-dt*7));
    if(avalanche.phase==='warning' && !reducedMotion){camera.position.x+=Math.sin(time*41)*.03;camera.position.y+=Math.cos(time*37)*.025;}
    camera.lookAt(look);
    // DAWN: the sky, fog and lights slide from night at the foot to a grey
    // orange storm-lit morning near the cave, keyed to height, not to time.
    if(cBg){var d=Math.pow(dawn,.8);
      cBg.setHex(NIGHT.bg).lerp(cSky.setHex(DAWN.bg),d);scene.background=cBg;scene.fog.color.copy(cBg);
      hemi.color.setHex(NIGHT.sky).lerp(cSky.setHex(DAWN.sky),d);hemi.groundColor.setHex(NIGHT.ground).lerp(cGround.setHex(DAWN.ground),d);hemi.intensity=NIGHT.hemiI+(DAWN.hemiI-NIGHT.hemiI)*d;
      sun.color.setHex(NIGHT.sun).lerp(cSun.setHex(DAWN.sun),d);sun.intensity=NIGHT.sunI+(DAWN.sunI-NIGHT.sunI)*d;sun.position.set(-25+70*d+(reducedMotion?0:Math.sin(time*.09)*5),55-30*d,15+30*d);
      if(snowPoints)snowPoints.material.color.setHex(0xdceeff).lerp(cSun.setHex(0xffb364),d*.85);
    }
    // Weather thickens smoothly in gusts; the near shelf stays out of the veil.
    var weatherTarget=gust.phase==='warning'?.42:gust.phase==='blowing'?1:.12;
    weatherVeil+=(weatherTarget-weatherVeil)*(1-Math.exp(-dt*.85));
    scene.fog.near=32-weatherVeil*5;scene.fog.far=112-weatherVeil*31;
    var morning=Math.pow(dawn,.8);
    if(rimLight){rimLight.color.setHex(0xc8d0dc).lerp(cSun.setHex(0xd88a5a),morning);
      rimLight.intensity=.28+morning*.24-weatherVeil*.06;
      rimLight.position.set(center(s)+22,height(s)+13,-s-36);rimLight.target.position.set(center(s),height(s)+1,-s);}
    // Integrate the wind so cloud motion accelerates into gusts without snapping.
    if(!reducedMotion){var cloudPush=wind.strength*2+(gust.phase==='blowing'?gust.dir*7:gust.phase==='warning'?gust.dir*2.5:0);
      cloudWind+=(cloudPush-cloudWind)*(1-Math.exp(-dt*1.5));
      cloudFlow+=dt*(.65+cloudWind);cloudSpin+=dt*(.23+Math.abs(cloudWind)*.09);
    }
    mistBanks.forEach(function(bank,i){var phase=i*1.73+cloudSpin;
      bank.position.set(center(s)+Math.sin(phase)*25+Math.sin(cloudFlow*.18+i)*8,height(s)+5+i%3*4+(reducedMotion?0:Math.sin(phase*.8)*(1.8+weatherVeil)),-s-24-i*10+Math.cos(phase)*10);
      bank.material.rotation=reducedMotion?0:Math.sin(phase*.7)*(.18+weatherVeil*.12);
      bank.material.color.setHex(0xacc6df).lerp(cGround.setHex(0xffaa62),morning*.9);
      bank.material.opacity=(.045+weatherVeil*.07)*(i===0?.65:1);
    });
    cloudFade.value=height(s)-7;
    if(cloudTint)cloudTint.value.setHex(0x8a8c90).lerp(cGround.setHex(0xcc8b60),morning);
    if(cloudFloor){cloudFloor.position.set(camera.position.x,height(s)-13,camera.position.z);
      cloudFloor.material.color.setHex(0x5e6268).lerp(cGround.setHex(0xb77852),morning);}
    cloudBanks.forEach(function(bank,i){var row=Math.floor(i/7),col=i%7;
      var eddy=cloudSpin+i*1.9,flow=cloudFlow*.18;
      // Overlapping oval eddies keep the deck covered as banks curl past one another.
      var sway=reducedMotion?0:Math.sin(eddy)*(17+weatherVeil*9)+Math.sin(flow+i*.6)*12;
      var curl=reducedMotion?0:Math.cos(eddy)*(13+weatherVeil*7);
      var lift=reducedMotion?0:Math.sin(eddy*.8)*(2.3+weatherVeil*1.2);
      bank.position.set(camera.position.x+(col-3)*30+sway,height(s)-10-row*1.5+Math.sin(i*2.3)*1.2+lift,camera.position.z+22-row*36+curl);
      bank.material.rotation=reducedMotion?0:Math.sin(eddy*.65)*(.23+weatherVeil*.15);
      bank.scale.set((76+(i%3)*12)*(1+(reducedMotion?0:Math.sin(eddy)*(.1+weatherVeil*.05))),25+(i%4)*4,1);
      bank.material.color.setHex(0x8a8c90).lerp(cGround.setHex(i%3===0?0xffbd7a:0xcc8b60),morning);
    });
    var stormTarget=gust.phase==='blowing'?1:gust.phase==='warning'?.3*Math.min(1,gust.t/1.4):0;
    if(!reducedMotion)snowStorm+=(stormTarget-snowStorm)*(1-Math.exp(-dt*3));
    if(snowPoints){snowPoints.material.opacity=.7+snowStorm*.23;snowPoints.material.size=.15+snowStorm*.045;
      snowPoints.geometry.setDrawRange(0,Math.floor(SNOW_N*(.72+snowStorm*.28)));}
    // SNOW: fall, drift with the gust, wrap inside a box centred on the camera.
    if(snowPoints){var cx=camera.position.x,cy=camera.position.y,cz=camera.position.z;
      var pl2=plateau(s),base=wind.strength*(pl2?pl2[3]:1)*(1+dawn*.35)*4;
      var lean=gust.phase==='warning'?gust.dir*(5+12*Math.min(1,gust.t/1.4)):gust.phase==='blowing'?gust.dir*36:0;
      if(!reducedMotion)snowDrift+=(base+lean-snowDrift)*(1-Math.exp(-dt*4));
      var drift=snowDrift+Math.sin(time*.4)*.6;
      if(!reducedMotion){for(var k=0;k<SNOW_N;k++){var i3=k*3;
        // Rolling gust eddies: flakes race sideways, curl upwards, then fall back.
        var eddy=time*(2.2+snowStorm*2)+k*2.399+snowPos[i3+2]*.12;
        snowPos[i3]+=(drift*(.7+(k%11)*.06)+Math.sin(eddy)*snowStorm*7+Math.sin(time*1.3+k)*.35)*dt;
        snowPos[i3+1]+=(-snowVel[k]*(1-snowStorm*.35)+Math.cos(eddy)*snowStorm*5)*dt;
        snowPos[i3+2]+=(Math.sin(eddy*.73)*snowStorm*8+Math.cos(time*.9+k*.7)*.25)*dt;
        if(snowPos[i3+1]<cy-13)snowPos[i3+1]+=26;else if(snowPos[i3+1]>cy+13)snowPos[i3+1]-=26;if(snowPos[i3]<cx-22)snowPos[i3]+=44;else if(snowPos[i3]>cx+22)snowPos[i3]-=44;if(snowPos[i3+2]<cz-22)snowPos[i3+2]+=44;else if(snowPos[i3+2]>cz+22)snowPos[i3+2]-=44;
        // A flake right against the lens is a white blob the size of the frame: push it out.
        var ddx=snowPos[i3]-cx,ddy=snowPos[i3+1]-cy,ddz=snowPos[i3+2]-cz;if(ddx*ddx+ddy*ddy+ddz*ddz<4){snowPos[i3]=cx+(Math.random()-.5)*44;snowPos[i3+1]=cy+13;snowPos[i3+2]=cz-6-Math.random()*16;}}
        snowPoints.geometry.attributes.position.needsUpdate=true;}
      else{snowPoints.position.set(cx,cy,cz);}
    }
    if(composer)composer.render();else renderer.render(scene,camera);
  }
  function loop(now){
    if(disposed)return;if(!canvas.isConnected){cleanup();return;}
    var dt=lastNow===null?0:Math.min(.1,(now-lastNow)/1000);lastNow=now;
    if(!paused && !finished){accumulator+=dt;while(accumulator>=1/120){update(1/120);accumulator-=1/120;}}
    draw(paused?0:dt);
    if(eng && (!started||paused||finished))eng.silence();else if(eng && ending>=0)eng.update(false,false,turned);
    animId=requestAnimationFrame(loop);
  }
  beginButton.disabled=true;boot();
})();
</script>

:: Office Opens Line [system] {"position":"2600,2500","size":"100,100"}
<!-- 2026-10-11, Sam: the gold venue-opens line wherever a new venue opens. LACKLAND's office needs both facts (Davy's tip, JOHN in the cellar, JEFFREY at the Coach set them in any order), so this shows once, on whichever lands second. -->\
(if: $officeOpensSaid is not true)[(if: $knowsLackland is true and $knowsCopperSecret is true)[(set: $officeOpensSaid to true)<div class="haunt-opens">LACKLAND’S office opens.</div>]]

:: Key Doors Open Line [system] {"position":"2700,2500","size":"100,100"}
<!-- 2026-10-11 structure pass 3, under his venue-opens ruling ("make sure it is added elsewhere whenever a new venue opens"): the Coach and the Chippy open as key doors when INIS names the third pillar, and the Coach opens again for the cow once lines one and two are held. The gold line, once each. -->\
(unless: $coachOpensSaid is true)[(if: $coachUrgent is false)[(if: (($keySlip is "seed") and ($inisToldOfPillars is true)) or (($alba contains $alba1) and ($alba contains $alba2) and ($cowRideDone is false)))[(set: $coachOpensSaid to true)<div class="haunt-opens">The Coach and Horses opens.</div>]]]\
(unless: $chippyOpensSaid is true)[(if: ($hadChippy is false) and ($keyTicket is "seed") and ($inisToldOfPillars is true))[(set: $chippyOpensSaid to true)<div class="haunt-opens">The Halibut (Fish and Chips) opens.</div>]]

:: Key Guards [system] {"position":"2600,2600","size":"100,100"}
<!-- v2 KEYS, phase 2 (2026-09-01): old-save guards for the pocket-key vars. Displayed at the top of every key block. Key states: "seed" (lying in its venue), "held" (in the pocket), a passage name (set down there in a swap), "spent" (used at the third pillar), "stolen" (taken in a mugging), "traded" (given to the Charing Cross Road fence for the notebook), the last two added 2026-09-12. -->\
(unless: $dreamKey is a string)[(set: $dreamKey to "")]\
(unless: $keyPick is a string)[(set: $keyPick to "")]\
(unless: $notebook is a string)[(set: $notebook to "held")]\
(unless: $keyCocaine is a string)[(set: $keyCocaine to "seed")]\
(unless: $keyTicket is a string)[(set: $keyTicket to "seed")]\
(unless: $keySlip is a string)[(set: $keySlip to "seed")]\
(unless: $keyLighter is a string)[(set: $keyLighter to "seed")]\
(unless: $keyEye is a string)[(set: $keyEye to "seed")]\
(unless: $inisToldOfPillars is a boolean)[(set: $inisToldOfPillars to false)]\
(unless: $keyNames is a datamap)[(set: $keyNames to (dm: "cocaine", "bag of cocaine", "ticket", "chippy order ticket", "slip", "betting slip", "lighter", "brass lighter", "eye", "glass eye"))]\
<!-- STASHES (2026-09-12, Sam: an abandoned key should be retrievable without
     walking the whole venue again). $binOf maps a key VENUE to the bin by its
     door, which is the venue's own outdoor approach passage, so a swap inside
     leaves the old key outside where you can grab it on the way past. The ten
     alleys are the voluntary hiding places. Bins are public and can be turned
     over; alley hiding places are safe. -->\
(unless: $binOf is a datamap)[(set: $binOf to (dm: "Chinese Fish and Chips", "Approach Chinese Fish and Chips", "Coach and Horses bar", "Approach The Coach", "Martin Lackland's Office", "Approach Lacklands Office", "The French", "Approach The French", "Trisha's", "Approach Trisha's"))]\
(unless: $stashLabel is a datamap)[(set: $stashLabel to (dm: "Approach Chinese Fish and Chips", "in the bin outside The Halibut (Fish and Chips)", "Approach The Coach", "in the bin outside the Coach and Horses", "Approach Lacklands Office", "in the bin outside Lackland’s office", "Approach The French", "in the bin outside The French", "Approach Trisha's", "in the bin outside Trisha’s", "Alley: Meard Street", "behind the loose brick in Meard Street", "Alley: St Anne's Court", "on the ledge over the doorway in St Anne’s Court", "Alley: Richmond Buildings", "behind the drainpipe in Richmond Buildings", "Alley: Bateman's Buildings", "under the lifted flagstone in Bateman’s Buildings", "Alley: Walker's Court", "behind the shutter hinge in Walker’s Court", "Alley: Greek Court", "in the dry corner of the bike rack in Greek Court", "Alley: Soho Square", "under the bench by the hut in Soho Square", "Alley: Charing Cross Road", "behind the loose board at the back of Foyles", "Alley: Oxford Street", "in the phone box at the Oxford Street end"))]\
(unless: $stashSites is an array)[(set: $stashSites to (a:))]\
(set: $stashLabel's "Davy’s note" to "with DAVY in the Colony Room")

:: Bars Now [system] {"position":"2600,2600","size":"100,100"}
<!-- 2026-10-11 structure pass 3: redraws the header's stat bars after a stat changes in place (window.dssBarsNow). -->\
<span class="dss-bars-now" style="display:none">(print: (text: $confidence) + "," + (text: $sobriety))</span><script>if(window.dssBarsNow)window.dssBarsNow();</script>

:: Key Set Held [system] {"position":"2700,2600","size":"100,100"}
<!-- Marks $keyPick as the key in the pocket. Harlowe cannot address a variable by name, hence the ladder. -->\
(if: $keyPick is "cocaine")[(set: $keyCocaine to "held")](else-if: $keyPick is "ticket")[(set: $keyTicket to "held")](else-if: $keyPick is "slip")[(set: $keySlip to "held")](else-if: $keyPick is "lighter")[(set: $keyLighter to "held")](else-if: $keyPick is "eye")[(set: $keyEye to "held")](set: $dreamKey to $keyPick)(display: "Key Sites")<span class="dss-pocket-now" style="display:none">(if: $dreamKey is not "" and $keyNames is a datamap and $keyNames contains $dreamKey)[(print: $keyNames's ($dreamKey))]</span><script>/* 2026-10-11 structure pass 3: the header's pocket cell is drawn once per passage, so a key pocketed, swapped or set down in a room kept showing the old key until you left. Redraw it now. */(function(){var n=document.querySelectorAll('.dss-pocket-now');var name=n.length?n[n.length-1].textContent.trim():'';var cells=document.querySelectorAll('.pocket-cell');if(!name){cells.forEach(function(c){c.remove();});return;}if(!cells.length){var night=document.querySelector('.night-cell');if(!night||!night.parentNode)return;var c=document.createElement('span');c.className='pocket-cell';c.title='In your pocket. The third pillar wants paying.';c.innerHTML='<span class="pocket-glyph" aria-hidden="true">&#9906;</span>';night.parentNode.insertBefore(c,night);cells=[c];}cells.forEach(function(c){var g=c.querySelector('.pocket-glyph');c.textContent='';if(g)c.appendChild(g);c.appendChild(document.createTextNode(name));});})();</script><span class="dss-pocket-id" style="display:none">(print: $keyPick)</span><script>/* structure pass 3: the key just pocketed no longer lies at its trail's end, so that trail's steps in this room fall quiet now, not on the next page */(function(){var n=document.querySelectorAll('.dss-pocket-id');var k=n.length?n[n.length-1].textContent.trim():'';var st=document.getElementById('dss-voice-state');if(!k||!st)return;st.setAttribute('data-lying',(' '+(st.getAttribute('data-lying')||'')+' ').replace(' '+k+' ',' ').replace(/^ +/,''));})();</script>
(display: "Next Redraw")<!-- 2026-10-12: NEXT moves on the moment a key is pocketed -->

:: Key Drop Here [system] {"position":"2800,2600","size":"100,100"}
<!-- The key in the pocket is set down and can be fetched back later (Resting Keys).
     A key is only ever set down at one of the fourteen stash sites: the nine
     alley hiding places and the five bins, each bin being a venue's outdoor
     approach passage. It stays exactly where it is put, and every one of those
     fourteen offers it back, so nothing can be stranded.
     The venue-to-bin remap on the line below is kept as a guard only. It would
     move a key set down inside a venue out to the bin by that venue's door, but
     it never fires today, because no venue interior offers the drop.
     2026-10-10 (Sam): keys are never stolen, only the notebook. Bins no longer
     roll a raid; Raided Bins was cut. -->
(display: "Key Guards")\
(set: _here to (passage:)'s name)\
(if: (datanames: $binOf) contains _here)[(set: _here to $binOf's (_here))]\
(set: _dest to _here)\
<!-- A slip on the way out saying where the key rests. The drop prose says
     "You know where it is", and before this the player had no way to. Named
     from _here, the real site, NOT _dest: a raided bin still reads as the bin,
     because the raid is meant to be discovered on the way back, not announced. -->\
(set: _restName to (cond: $keyNames is a datamap and $keyNames contains $dreamKey, $keyNames's ($dreamKey), ""))\
(set: _restWhere to (dm: "Alley: Bateman's Buildings", "in Bateman’s Buildings", "Alley: Charing Cross Road", "in the alley off Charing Cross Road", "Alley: Greek Court", "in Greek Court", "Alley: Meard Street", "in Meard Street", "Alley: Oxford Street", "in the alley off Oxford Street", "Alley: Richmond Buildings", "in Richmond Buildings", "Alley: Soho Square", "in Soho Square", "Alley: St Anne's Court", "in St Anne’s Court", "Alley: Walker's Court", "in Walker’s Court", "Approach Chinese Fish and Chips", "in the bin outside the chippy", "Approach Lacklands Office", "in the bin outside Lackland’s office", "Approach The Coach", "in the bin outside the Coach and Horses", "Approach The French", "in the bin outside the French", "Approach Trisha's", "in the bin outside Trisha’s"))\
(if: $dreamKey is "cocaine")[(set: $keyCocaine to _dest)](else-if: $dreamKey is "ticket")[(set: $keyTicket to _dest)](else-if: $dreamKey is "slip")[(set: $keySlip to _dest)](else-if: $dreamKey is "lighter")[(set: $keyLighter to _dest)](else-if: $dreamKey is "eye")[(set: $keyEye to _dest)](set: $dreamKey to "")(display: "Key Sites")
(if: _restName is not "" and _restWhere contains _here)[<span class="dss-key-rest-msg" style="display:none">(print: "The " + _restName + " stays " + _restWhere's (_here) + ".")</span><script>setTimeout(function(){var n=document.querySelectorAll(".dss-key-rest-msg");var el=n[n.length-1];if(window.dssInlineHint&&el)window.dssInlineHint(el.textContent);},900);</script>]\
<span class="dss-pocket-now" style="display:none">(if: $dreamKey is not "" and $keyNames is a datamap and $keyNames contains $dreamKey)[(print: $keyNames's ($dreamKey))]</span><script>/* 2026-10-11 structure pass 3: the header's pocket cell is drawn once per passage, so a key pocketed, swapped or set down in a room kept showing the old key until you left. Redraw it now. */(function(){var n=document.querySelectorAll('.dss-pocket-now');var name=n.length?n[n.length-1].textContent.trim():'';var cells=document.querySelectorAll('.pocket-cell');if(!name){cells.forEach(function(c){c.remove();});return;}if(!cells.length){var night=document.querySelector('.night-cell');if(!night||!night.parentNode)return;var c=document.createElement('span');c.className='pocket-cell';c.title='In your pocket. The third pillar wants paying.';c.innerHTML='<span class="pocket-glyph" aria-hidden="true">&#9906;</span>';night.parentNode.insertBefore(c,night);cells=[c];}cells.forEach(function(c){var g=c.querySelector('.pocket-glyph');c.textContent='';if(g)c.appendChild(g);c.appendChild(document.createTextNode(name));});})();</script>

:: Key Sites [system] {"position":"3100,2600","size":"100,100"}
<!-- Rebuilds $stashSites, the list of passages currently holding a set-down key.
     The hub reads it so an alley stays listed while your thing is still in it. -->
(display: "Key Guards")\
(set: $stashSites to (a:))\
(if: $keyCocaine is not "seed" and $keyCocaine is not "held" and $keyCocaine is not "spent" and $keyCocaine is not "stolen" and $keyCocaine is not "traded")[(unless: $stashSites contains $keyCocaine)[(set: $stashSites to $stashSites + (a: $keyCocaine))]]\
(if: $keyTicket is not "seed" and $keyTicket is not "held" and $keyTicket is not "spent" and $keyTicket is not "stolen" and $keyTicket is not "traded")[(unless: $stashSites contains $keyTicket)[(set: $stashSites to $stashSites + (a: $keyTicket))]]\
(if: $keySlip is not "seed" and $keySlip is not "held" and $keySlip is not "spent" and $keySlip is not "stolen" and $keySlip is not "traded")[(unless: $stashSites contains $keySlip)[(set: $stashSites to $stashSites + (a: $keySlip))]]\
(if: $keyLighter is not "seed" and $keyLighter is not "held" and $keyLighter is not "spent" and $keyLighter is not "stolen" and $keyLighter is not "traded")[(unless: $stashSites contains $keyLighter)[(set: $stashSites to $stashSites + (a: $keyLighter))]]\
(if: $keyEye is not "seed" and $keyEye is not "held" and $keyEye is not "spent" and $keyEye is not "stolen" and $keyEye is not "traded")[(unless: $stashSites contains $keyEye)[(set: $stashSites to $stashSites + (a: $keyEye))]]

:: Spend Held Key [system]
<!-- THE CROSSING COSTS THE KEY (2026-09-14). It used to cost the key only when
     the world happened to match it, so a key whose world was already walked —
     or, after the Ezekiel gate, a glass eye that no longer steers — rode along
     for nothing and the crossing was free. That made "a night self-limits at
     five crossings" untrue and let one key walk every world in an evening.
     Harlowe cannot address a variable by name, hence the ladder. -->
(if: $dreamKey is "cocaine")[(set: $keyCocaine to "spent")]\
(else-if: $dreamKey is "ticket")[(set: $keyTicket to "spent")]\
(else-if: $dreamKey is "slip")[(set: $keySlip to "spent")]\
(else-if: $dreamKey is "lighter")[(set: $keyLighter to "spent")]\
(else-if: $dreamKey is "eye")[(set: $keyEye to "spent")]\
(set: $dreamKey to "")

:: Key Stash Here [system] {"position":"3300,2600","size":"100,100"}
<!-- Voluntary stashing. Offered wherever Stash Point is displayed, which is the
     five bins and the ten alleys. The bins are convenient and can be turned
     over; the alleys are out of the way and safe. -->
(display: "Key Guards")\
(if: $dreamKey is not "")[(link: "Leave the " + $keyNames's ($dreamKey) + " here")[(display: "Key Drop Here")<div>You put the key where it stays safe and hidden. Now you can carry another one. This one will stay here.</div>]]

:: Stash Point [system] {"position":"3400,2600","size":"100,100"}
<!-- One line to make any passage a stash site: the raid reveal, the offer to
     pick a key back up, and the offer to leave the one you are carrying. 2026-10-25: the line break after this comment opened an empty line at every stash site (seen at Foyles); joined. -->\
(display: "Key Guards")\
(display: "Resting Keys")\
(display: "Key Stash Here")\
<!-- ONE-TIME TEACHING (2026-09-15, Sam: "at the alleyway endings, where you can
     stash things, it should explain that"). Nothing anywhere said what a stash
     site was FOR: Key Stash Here only prints its offer when you happen to be
     CARRYING something, so a player who walked every alley empty-handed never
     learned the mechanic existed at all. Stash Point is displayed at all
     fourteen sites, so the lesson lands at whichever one is reached first,
     carrying or not. Site-neutral wording, because that first site may be a bin
     rather than an alley.
     CUT TO ONE SENTENCE (Sam). The first draft ran to 240 characters, which is
     the worst length a slip can be: under the 400 that makes one dismissable,
     so it took the short-nudge treatment (click-through, no way to wave it off)
     with a long-nudge duration — about eighteen seconds on screen. It also
     restated "One pocket, one thing; that is the rule tonight" from Key Set
     Held in flatter words, a beat after Sam had already said it. What is left
     is the part the player cannot know: that a site exists, and that an alley
     keeps a thing where a bin does not. ~96 characters holds for ~10s, in line
     with every other nudge. UI note, not passage prose — Sam's to change.
     ONLY WHEN CARRYING (2026-09-15, Sam: the slip came up on the French approach
     with "no option to do that"). Key Stash Here prints its "Leave the X here"
     link only when $dreamKey is set, so a slip that fires empty-handed describes
     an option that is not on the screen. Now both appear together, the first
     time a carried key reaches any of the fourteen sites. -->\
<!-- 2026-10-10 (Sam): the stash tip slip is CUT entirely; the "Leave the X here" button says it. -->

:: Key Take cocaine [system] {"position":"2900,2600","size":"100,100"}
<!-- One pocket, one key: pocket it if the pocket is empty, else swap (the held key rests here). The literal id sits INSIDE the link hook so several offers on one page cannot cross. -->
(display: "Key Guards")\
(if: $dreamKey is "")[(link: "Pocket the bag of cocaine")[(set: $keyPick to "cocaine")(display: "Key Set Held")<div>You can only carry one key at a time. The others stay where they lie, and you can come back for them.</div>]](else-if: $dreamKey is not "cocaine")[(link: "Leave the " + $keyNames's ($dreamKey) + " here and take the bag of cocaine")[(display: "Key Drop Here")(set: $keyPick to "cocaine")(display: "Key Set Held")]]
:: Key Take ticket [system] {"position":"2900,2600","size":"100,100"}
<!-- One pocket, one key: pocket it if the pocket is empty, else swap (the held key rests here). The literal id sits INSIDE the link hook so several offers on one page cannot cross. -->
(display: "Key Guards")\
(if: $dreamKey is "")[(link: "Pocket the chippy order ticket")[(set: $keyPick to "ticket")(display: "Key Set Held")<div>You can only carry one key at a time. The others stay where they lie, and you can come back for them.</div>]](else-if: $dreamKey is not "ticket")[(link: "Leave the " + $keyNames's ($dreamKey) + " here and take the chippy order ticket")[(display: "Key Drop Here")(set: $keyPick to "ticket")(display: "Key Set Held")]]
:: Key Take slip [system] {"position":"2900,2600","size":"100,100"}
<!-- One pocket, one key: pocket it if the pocket is empty, else swap (the held key rests here). The literal id sits INSIDE the link hook so several offers on one page cannot cross. -->
(display: "Key Guards")\
(if: $dreamKey is "")[(link: "Pocket the betting slip")[(set: $keyPick to "slip")(display: "Key Set Held")<div>You can only carry one key at a time. The others stay where they lie, and you can come back for them.</div>]](else-if: $dreamKey is not "slip")[(link: "Leave the " + $keyNames's ($dreamKey) + " here and take the betting slip")[(display: "Key Drop Here")(set: $keyPick to "slip")(display: "Key Set Held")]]
:: Key Take lighter [system] {"position":"2900,2600","size":"100,100"}
<!-- One pocket, one key: pocket it if the pocket is empty, else swap (the held key rests here). The literal id sits INSIDE the link hook so several offers on one page cannot cross. -->
(display: "Key Guards")\
(if: $dreamKey is "")[(link: "Pocket the brass lighter")[(set: $keyPick to "lighter")(display: "Key Set Held")<div>You can only carry one key at a time. The others stay where they lie, and you can come back for them.</div>]](else-if: $dreamKey is not "lighter")[(link: "Leave the " + $keyNames's ($dreamKey) + " here and take the brass lighter")[(display: "Key Drop Here")(set: $keyPick to "lighter")(display: "Key Set Held")]]
:: Key Take eye [system] {"position":"2900,2600","size":"100,100"}
<!-- One pocket, one key: pocket it if the pocket is empty, else swap (the held key rests here). The literal id sits INSIDE the link hook so several offers on one page cannot cross. -->
(display: "Key Guards")\
(if: $dreamKey is "")[(link: "Pocket the glass eye")[(set: $keyPick to "eye")(display: "Key Set Held")<div>You can only carry one key at a time. The others stay where they lie, and you can come back for them.</div>]](else-if: $dreamKey is not "eye")[(link: "Leave the " + $keyNames's ($dreamKey) + " here and take the glass eye")[(display: "Key Drop Here")(set: $keyPick to "eye")(display: "Key Set Held")]]

:: Resting Keys [system] {"position":"3000,2600","size":"100,100"}
<!-- A key set down in a swap rests in the passage where the swap happened; this offers it back. Displayed at the end of the five key venues. -->\
(display: "Key Guards")\
(if: $keyCocaine is (passage:)'s name)[<div class="dss-key-offer" data-key="cocaine" data-kind="rest"><div class="dss-key-blurb">The bag is, somehow, where you left it.</div>(display: "Key Take cocaine")</div>]\
(if: $keyTicket is (passage:)'s name)[<div class="dss-key-offer" data-key="ticket" data-kind="rest"><div class="dss-key-blurb">The chippy order ticket’s where you left it.</div>(display: "Key Take ticket")</div>]\
(if: $keySlip is (passage:)'s name)[<div class="dss-key-offer" data-key="slip" data-kind="rest"><div class="dss-key-blurb">The betting slip is waiting where you left it.</div>(display: "Key Take slip")</div>]\
(if: $keyLighter is (passage:)'s name)[<div class="dss-key-offer" data-key="lighter" data-kind="rest"><div class="dss-key-blurb">The big brass lighter’s where you left it.</div>(display: "Key Take lighter")</div>]\
(if: $keyEye is (passage:)'s name)[<div class="dss-key-offer" data-key="eye" data-kind="rest"><div class="dss-key-blurb">The glass eye’s where you left it.</div>(display: "Key Take eye")</div>]\
<!-- The offers above are parked off-screen by .dss-key-offer; this raises them
     as a decision popup instead of a line under the venue's links. Plain
     setTimeout, not (after:), because a backgrounded tab stalls Harlowe timers. -->\
<script>(function(){setTimeout(function(){if(window.dssKeyPopup)window.dssKeyPopup();},420);})();</script>

:: Alley: Bourchier Street [street-night] {"position":"2600,720","size":"100,100"}
(unless: $alleys is an array)[(set: $alleys to (a:))](set: $alleys to $alleys + (a: "bourchier"))(set: $alleyReturn to true)\
(if: $killedMugger is true)[<!-- 2026-10-25 (Sam): after the murder the alley stays, empty. --><span>Bourchier Street, empty now. The three are gone.</span>
[[Back to the street|Dean Street]]](else:)[It’s bold to turn down an alley at this time of night. There are three in a group and one peels off and he offers you a smoke. You’re starting to follow him to buy what he’s offered before you’ve time to notice what you’re doing. He wants to go where nobody is watching.
[[Follow him|Bourchier Street: The Car Park]]
[[Walk away|Dean Street]]]

:: Bourchier Street: The Car Park [street-night] {"position":"2600,740","size":"100,100"}
<!-- 2026-10-25 (Sam): the murder. Far gone (sobriety under 30, no blackout needed: one step easier than the Soho Square hut), the knife is a choice: freeze and be robbed as before, or turn it on him. Once a game ($killedMugger). No meter moves, nobody comes; the only trace is a black teardrop on the notebook's first page. The robbery text is Sam's, moved word for word to "Bourchier Street: Mugged" so both ways can show it; the pink lines are slots for Sam. -->
(display: "Key Guards")(if: $killedMugger is true)[(display: "Bourchier Street: The Knife")](else-if: $notebook is "held")[He takes you round to Brewer Street and into the car park with the pale tiled front and the copper dome, then down the ramp to the underground level, which at this hour is deserted.

He lights up, hands it over, then pulls a knife. ‘Empty your jacket pocket,’ he says. (if: ($sobriety < 30) and ($killedMugger is not true))[|mugchoice>[<span class="claude-draft">(link: "Freeze.")[(replace: ?mugchoice)[(display: "Bourchier Street: Mugged")]]</span>
<span class="claude-draft">(link: "Turn his knife on him.")[(set: $killedMugger to true)(replace: ?mugchoice)[(display: "Bourchier Street: The Knife")]]</span>]](else:)[(display: "Bourchier Street: Mugged")]](else:)[[[Back to the street|Dean Street]]]

:: Bourchier Street: The Knife [street-night] {"position":"2600,780","size":"100,100"}
<!-- 2026-10-25: the murder and the slipping away, displayed by the car park; also what the car park shows on any later render, so a re-render can never fall through to the robbery. -->\
<span>POW!</span>


[[Back to the street|Dean Street]]

:: Bourchier Street: Mugged [street-night] {"position":"2600,760","size":"100,100"}
<!-- 2026-10-25: Sam's robbery text, unchanged, displayed by the car park when you freeze (or when the murder is not open to you). -->\
(set: $notebook to "stolen")You freeze, so he goes in with his hand and spills the contents out onto the floor, then gathers them up.

Among them is your notebook, full of work. You plead with him to return it. ‘Not now,’ he says as he scarpers. ‘No time but there’s a bloke on the Charing Cross Road, buys anything. Ask him if he’s got it, you might get lucky!’

He leaves you smoking in the much-too-light and picking up your manuscript which he chucked on the floor.<div class="inventory-note">NOTEBOOK TAKEN</div>
[[Back to the street|Dean Street]]

:: The Barbershop [street-night] {"position":"2600,780","size":"100,100"}
<!-- 2026-10-18 (Sam): a barber's on one of the alleys, "just a doorway", no interior. 2026-10-19 (Sam): the map and the hub link call it the barbershop; Donny Florentine is named only here. The link is gated in the hub dock on $nightPhase 1. A haircut or a shave
     is a small lift to morale ($confidence on the asymptotic $statGain curve, like the pissing doorways),
     each once a night; after one the other is still on offer. $alleyReturn keeps the visit off the lap
     count, as at the alleys. Both flags are reset at Start and healed here for older saves. The lines
     are pink: Sam's to redraft. -->
(set: $alleyReturn to true)\
(unless: $barberCut is a boolean)[(set: $barberCut to false)](unless: $barberShave is a boolean)[(set: $barberShave to false)]\
<span class="scene-location">Meard Street, Soho.</span>
<div><span>A pole turns in a doorway on Meard Street. Donny Florentine is still open. ‘Sit down,’ he says, silly grin like Sweeney Todd.</span></div>
(if: $barberCut is true and $barberShave is true)[<div><span>‘Still looking fine, boy; no need to come back tonight.’</span></div>]\
(if: $barberCut is false)[|cut>[<div>(link: "A haircut")[(set: $barberCut to true)(set: $confidence to ($statGain: $confidence, 6))(replace: ?cut)[<div><span>He barbers you and holds the mirror up behind you at the end. Sharp, everything’s sharp.</span></div><span class="inventory-note">MORALE +6</span>]]</div>]]\
(if: $barberShave is false)[|shave>[<div>(link: "A shave")[(set: $barberShave to true)(set: $confidence to ($statGain: $confidence, 6))(replace: ?shave)[<div><span>Hot towel, Turkic, you think. Attaboy!</span></div><span class="inventory-note">MORALE +6</span>]]</div>]]\
<div>[[Back to the street|Dean Street]]</div>

:: Mister Jimmy’s Drug Store [street-night] {"position":"2720,780","size":"100,100"}
<!-- 2026-10-24 (Sam): "in the same mode" as the barbershop, a shop that opens at some point and sells painkillers for a little of the stats back. A door and a counter, no interior.
     The hub link is gated on $nightPhase 2, later than the barber. One packet a night: a small lift to sobriety and morale on the $statGain curve.
     $alleyReturn keeps the visit off the lap count, as at the barber. The flag is reset at Start and healed here for older saves. Sam redrafted the lines 2026-10-24. -->
(set: $alleyReturn to true)\
(unless: $jimmyPills is a boolean)[(set: $jimmyPills to false)]\
<span class="scene-location">Old Compton Street, Soho.</span>
<div>Why don’t you take something to kill the pain? That’s Mr. Jimmy behind the counter, looking pretty ill.</div>
(if: $jimmyPills is true)[<div>‘You’ve had your lot,’ he says, without looking up.</div>]\
(if: $jimmyPills is false)[|pills>[<div>(link: "Buy an analgesic, something to kill the pain.")[(set: $jimmyPills to true)(set: $sobriety to ($statGain: $sobriety, 5))(set: $confidence to ($statGain: $confidence, 5))(replace: ?pills)[<div>He slides a packet to you.</div><span class="inventory-note">SOBRIETY +5 | MORALE +5</span>]]</div>]]\
<div>[[Back to the street|Dean Street]]</div>

:: Alley: Soho Square [street-night] {"position":"2600,1020","size":"100,100"}
(unless: $alleys is an array)[(set: $alleys to (a:))](set: $alleys to $alleys + (a: "square"))(set: $alleyReturn to true)\
(unless: $squareBenchTaken is true)[(set: $squareBenchTaken to true)(set: $confidence to ($statGain: $confidence, 8))]
(unless: $hutBurnt is true)[(display: "Soho Hut Art")(unless: $sobriety < 30 and $blackouts >= 1)[
[[Into the gardener’s hut|Soho Square: the gardener’s hut]]]]
