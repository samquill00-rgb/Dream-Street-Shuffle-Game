  [[-1.0, 2.27, 1.54, 0.04], [-1.0, 1.77, 1.54, 0.04], [-1.76, 2.02, 0.04, 0.5], [-0.24, 2.02, 0.04, 0.5]].forEach(function(bd) { placeMesh(shop, new THREE.BoxGeometry(bd[2], bd[3], 0.35), new THREE.MeshStandardMaterial({ color: 0x2a2a28, roughness: 0.4, metalness: 0.6 }), bd[0], bd[1], -0.585); });
  placeMesh(shop, new THREE.BoxGeometry(1.52, 0.03, 0.35), fc29Chrome, -1.0, 2.28, -0.585);
  for (var ch = 0; ch < 3; ch++) placeMesh(shop, new THREE.BoxGeometry(0.4, 0.14, 0.26), new THREE.MeshStandardMaterial({ color: 0xe09a30, roughness: 0.9, emissive: 0x402000, emissiveIntensity: 0.6 }), -1.5 + ch * 0.5, 1.85, -0.585);
  // Salt, vinegar, ketchup on the counter
  [[-0.4, 0xe8e8e0], [-0.2, 0x6a4a1a], [1.3, 0xe8e8e0], [1.5, 0xb02020]].forEach(function(bt) { placeMesh(shop, new THREE.CylinderGeometry(0.035, 0.04, 0.22, 8), new THREE.MeshStandardMaterial({ color: bt[1], roughness: 0.4 }), bt[0], 1.55, 0.0); });
  // A breath of steam over the fryer
  var fc29SteamTex = makeCanvasTexture(64, 64, function(cx, w, h) { var g = cx.createRadialGradient(w / 2, h / 2, 0, w / 2, h / 2, w / 2); g.addColorStop(0, 'rgba(255,245,230,0.7)'); g.addColorStop(0.5, 'rgba(255,245,230,0.2)'); g.addColorStop(1, 'rgba(255,245,230,0)'); cx.fillStyle = g; cx.fillRect(0, 0, w, h); });
  var fc29Steam = new THREE.Sprite(new THREE.SpriteMaterial({ map: fc29SteamTex, transparent: true, opacity: 0.12, blending: THREE.AdditiveBlending, depthWrite: false }));
  fc29Steam.position.set(-1.0, 2.6, -0.5); fc29Steam.scale.set(1.4, 0.9, 1); shop.add(fc29Steam);

  // ---- FLUORESCENT LIGHT STRIP inside (visible through glass) ----
  var fluoro = new THREE.Mesh(new THREE.BoxGeometry(3.5, 0.06, 0.15),
    new THREE.MeshBasicMaterial({ color: 0xf0f0e8 }));
  fluoro.position.set(0.5, 3.4, -0.3);
  shop.add(fluoro);
  // Second strip
  var fluoro2 = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.06, 0.15),
    new THREE.MeshBasicMaterial({ color: 0xeeeee0 }));
  fluoro2.position.set(0.5, 3.4, -0.6);
  shop.add(fluoro2);

  // ---- BRIGHT INTERIOR LIGHTING — THE KEY FEATURE ----
  // Multiple strong warm lights to make this glow like a beacon
  var interiorLight1 = new THREE.PointLight(0xffe8c0, 0.85, 10); /* 2026-10-28 (note 29): dimmed, the open room blew out to white */
  interiorLight1.position.set(0.5, 2.5, 0.5);
  shop.add(interiorLight1);
  var interiorLight2 = new THREE.PointLight(0xffe0b0, 0.55, 8);
  interiorLight2.position.set(-0.7, 2.0, 0.3);
  shop.add(interiorLight2);
  var interiorLight3 = new THREE.PointLight(0xffe0b0, 0.55, 8);
  interiorLight3.position.set(1.7, 2.0, 0.3);
  shop.add(interiorLight3);
  var doorSpill = new THREE.PointLight(0xffd880, 0.8, 6);
  doorSpill.position.set(0.5, 1.5, 1.5);
  shop.add(doorSpill);
  // Strong warm spill onto pavement
  var pavementSpill = new THREE.PointLight(0xffd060, 0.6, 8);
  pavementSpill.position.set(0.5, 0.3, 3.0);
  shop.add(pavementSpill);
  // The chippy's amber lying on the wet flags in front of the door: one
  // additive plane, a warm pool under the windows with a blue fleck from
  // the fly-killer, cut by paving joints. Breathes with the spill lights.
  var fcSheenTex = makeCanvasTexture(256, 128, function(cx, w, h) {
    cx.clearRect(0, 0, w, h);
    function pool(x, y, rx, ry, col, a) {
      var g = cx.createRadialGradient(x, y, 0, x, y, rx);
      g.addColorStop(0, col.replace('A', a)); g.addColorStop(0.5, col.replace('A', a * 0.4)); g.addColorStop(1, col.replace('A', 0));
      cx.save(); cx.translate(x, y); cx.scale(1, ry / rx); cx.translate(-x, -y);
      cx.fillStyle = g; cx.beginPath(); cx.arc(x, y, rx, 0, Math.PI * 2); cx.fill(); cx.restore();
    }
    pool(w * 0.5, h * 0.3, w * 0.42, h * 0.62, 'rgba(255,208,110,A)', 0.7);
    pool(w * 0.5, h * 0.78, w * 0.22, h * 0.3, 'rgba(255,190,90,A)', 0.4);
    pool(w * 0.7, h * 0.25, w * 0.08, h * 0.16, 'rgba(90,120,255,A)', 0.35);
    cx.strokeStyle = 'rgba(0,0,0,0.5)'; cx.lineWidth = 2;
    for (var j = 0; j <= w; j += 43) { cx.beginPath(); cx.moveTo(j, 0); cx.lineTo(j, h); cx.stroke(); }
    for (var k = 0; k <= h; k += 34) { cx.beginPath(); cx.moveTo(0, k); cx.lineTo(w, k); cx.stroke(); }
  });
  var fcSheen = new THREE.Mesh(new THREE.PlaneGeometry(4.6, 2.6), new THREE.MeshBasicMaterial({
    map: fcSheenTex, transparent: true, opacity: 0.1, blending: THREE.AdditiveBlending, depthWrite: false, fog: false
  }));
  fcSheen.rotation.x = -Math.PI / 2;
  fcSheen.position.set(0.5, 0.015, 2.7);
  shop.add(fcSheen);
  // Upward glow on fascia from windows
  var fasciaGlow = new THREE.PointLight(0xffe8c0, 0.4, 4);
  fasciaGlow.position.set(0.5, 3.5, 0.8);
  // shop.add(fasciaGlow); // 2026-10-14 (speed, Sam: yes): left out of the scene; 20 point lights made this approach slow, and this one barely showed

  // ---- ELECTRIC FLY-KILLER mounted high inside the right window (2026-10-28, note 29: it sat under the neon) ----
  // Classic 1970s chippy fixture, positioned just behind the front
