      setTimeout(function() { try { done.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); } catch (e) {} }, 60); /* 2026-10-19 overnight: on a short screen the button sat below the card's fold, so the end of his speech showed no way out */
    }
