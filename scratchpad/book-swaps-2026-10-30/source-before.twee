ll='none'/><circle cx='-2' cy='-1.5' r='0.9' fill='#f5d490' stroke='none'/><circle cx='2' cy='-1.5' r='0.9' fill='#f5d490' stroke='none'/><path d='M-2.5,2 Q0,3.5 2.5,2'/><path d='M-6,-4 Q0,-9 6,-4'/></g><g transform='translate(152.0,-0.0)' fill='none' stroke='#f5d490' stroke-width='0.95' stroke-linecap='round' stroke-linejoin='round'><circle r='6' fill='none'/><path d='M-6,-4 L-9,-7 L-5,-6 Z M6,-4 L9,-7 L5,-6 Z'/><circle cx='-2' cy='-1' r='0.8' fill='#f5d490' stroke='none'/><circle cx='2' cy='-1' r='0.8' fill='#f5d490' stroke='none'/><path d='M-2,3 L0,5 L2,3'/><path d='M-10,2 Q-14,3 -16,6 M10,2 Q14,3 16,6 M-14,-2 Q-18,-3 -19,-6 M14,-2 Q18,-3 19,-6'/></g><g transform='translate(0.0,152.0)' fill='none' stroke='#f5d490' stroke-width='0.95' stroke-linecap='round' stroke-linejoin='round'><path d='M-7,-3 Q-7,-7 0,-7 Q7,-7 7,-3 L7,4 Q7,7 0,7 Q-7,7 -7,4 Z'/><path d='M-7,-3 Q-10,-6 -8,-9 M7,-3 Q10,-6 8,-9'/><circle cx='-2.5' cy='-1' r='0.8' fill='#f5d490' stroke='none'/><circle cx='2.5' cy='-1' r='0.8' fill='#f5d490' stroke='none'/><path d='M-2,3 Q0,4 2,3'/></g><g transform='translate(-152.0,0.0)' fill='none' stroke='#f5d490' stroke-width='0.95' stroke-linecap='round' stroke-linejoin='round'><path d='M0,-7 L-4,-2 L-8,2 L-4,5 L0,8 L5,5 L4,1 L0,-2 Z'/><circle cx='-2' cy='0' r='0.8' fill='#f5d490' stroke='none'/><path d='M-8,2 L-12,-2 M-8,2 L-12,5 M0,-7 L1,-12 L0,-7 L4,-11'/></g></g></svg></div>}

<script>
// Ezekiel: two perpendicular rims, shaded and sorted in depth on a single 2D
// canvas. The authored SVG remains a fallback; no extra WebGL context or audio.
(function(){
  var wrap=document.querySelector('.ezekiel-wheel-wrap');
  if(!wrap || wrap.dataset.wheelDepth)return;
  var canvas=document.createElement('canvas'), c=canvas.getContext('2d');
  if(!c)return;
  wrap.dataset.wheelDepth='1';
  canvas.className='ezekiel-wheel-canvas';
  canvas.setAttribute('role','img');
  canvas.setAttribute('aria-label','Two interlocking golden wheels, their rims set with open eyes.');
  var ratio=Math.min(window.devicePixelRatio||1,2), size=440;
  canvas.width=size*ratio; canvas.height=size*ratio;
  wrap.appendChild(canvas);
  var fallback=wrap.querySelector('svg'); if(fallback)fallback.style.display='none';
  var media=window.matchMedia('(prefers-reduced-motion: reduce)');
  var still=media.matches, alive=true, visible=true, raf=0, time=0, last=0;
  var pointer={x:220,y:218,active:false},pairGaze={x:0,y:0},gazeStamp=0;
  function followPointer(e){
    if(still || !visible || !wrap.isConnected || e.pointerType==='touch')return;
    var bounds=canvas.getBoundingClientRect();if(!bounds.width||!bounds.height)return;
    pointer.x=(e.clientX-bounds.left)/bounds.width*size;pointer.y=(e.clientY-bounds.top)/bounds.height*size;pointer.active=true;
  }
  function releaseGaze(e){if(!e || !e.relatedTarget)pointer.active=false;}
  window.addEventListener('pointermove',followPointer,{passive:true});window.addEventListener('pointerout',releaseGaze);window.addEventListener('blur',releaseGaze);
  var TAU=Math.PI*2;
  // Soft light textures are made once, not re-rasterised for every particle.
  function light(col){
    var s=document.createElement('canvas');s.width=s.height=128;
    var q=s.getContext('2d'),g=q.createRadialGradient(64,64,0,64,64,64);
    g.addColorStop(0,col);g.addColorStop(.3,col.replace(/,[\d.]+\)$/,',0.10)'));g.addColorStop(1,'rgba(0,0,0,0)');
    q.fillStyle=g;q.fillRect(0,0,128,128);return s;
  }
  var amber=light('rgba(232,156,57,0.38)'), violet=light('rgba(102,76,152,0.28)');
  function project(x,y,z,t){
    var yaw=.46+Math.sin(t*.11)*.43, pitch=.37+Math.sin(t*.16)*.12;
    var a=x*Math.cos(yaw)+z*Math.sin(yaw), b=-x*Math.sin(yaw)+z*Math.cos(yaw);
    var d=y*Math.cos(pitch)-b*Math.sin(pitch), e=y*Math.sin(pitch)+b*Math.cos(pitch);
    var roll=-.15+Math.sin(t*.11)*.09, f=a*Math.cos(roll)-d*Math.sin(roll), h=a*Math.sin(roll)+d*Math.cos(roll);
    var scale=620/(620-e);
    return {x:220+f*scale,y:218+h*scale,z:e,k:scale};
  }
  function point(r,a,ring,t,offset){
    offset=offset||0;return ring===0 ? project(r*Math.cos(a),r*Math.sin(a),offset,t) : project(offset,r*Math.sin(a),r*Math.cos(a),t);
  }
  function line(a,b,color,width){c.beginPath();c.moveTo(a.x,a.y);c.lineTo(b.x,b.y);c.strokeStyle=color;c.lineWidth=width;c.stroke();}
  function pairBlink(t){
    if(still)return 0;
    var phase=((t+8)%17)-15.4;
    if(phase<0)return 0;
    var v=phase<.55?phase/.55:phase<.72?1:Math.max(0,1-(phase-.72)/.88);
    return v*v*(3-2*v);
  }
  function glassEye(p,alpha,k,blue,t){
    c.save();c.translate(p.x,p.y);c.scale(k,k);c.globalAlpha=alpha;
    c.fillStyle='rgba(9,7,8,.7)';c.beginPath();c.ellipse(1.2,1.8,10.1,9.8,0,0,TAU);c.fill();
    var white=c.createRadialGradient(-3,-4,1,0,0,9.5);white.addColorStop(0,'#fffef1');white.addColorStop(.52,'#e8e9dd');white.addColorStop(.82,'#aebcb8');white.addColorStop(1,'#506767');
    c.fillStyle=white;c.beginPath();c.arc(0,0,9.3,0,TAU);c.fill();c.strokeStyle='#b99a61';c.lineWidth=.8;c.stroke();
    // Both irises face the viewer, instead of swivelling with the rim's tangent.
    var gaze=Math.sin(t*.18)*.08;c.save();c.translate(pairGaze.x+gaze,pairGaze.y);
    var iris=c.createRadialGradient(-1,-1,.3,0,0,5.8);iris.addColorStop(0,'#091a21');iris.addColorStop(.36,blue?'#125999':'#216441');iris.addColorStop(.67,blue?'#39acfa':'#68c772');iris.addColorStop(.88,blue?'#6cc7ee':'#a4d88c');iris.addColorStop(1,blue?'#133c62':'#214d36');c.fillStyle=iris;c.beginPath();c.arc(0,0,5.8,0,TAU);c.fill();
    for(var fiber=0;fiber<44;fiber++){
      var angle=fiber/44*TAU,inner=2.2+(Math.sin(fiber*4.7)*.5+.5)*.8;
      c.strokeStyle=fiber%3===0?'rgba(8,28,36,.45)':blue?'rgba(163,225,255,.42)':'rgba(209,237,146,.4)';c.lineWidth=.22;c.beginPath();c.moveTo(Math.cos(angle)*inner,Math.sin(angle)*inner);c.lineTo(Math.cos(angle)*5.35,Math.sin(angle)*5.35);c.stroke();
    }
    c.fillStyle='#050d12';c.beginPath();c.arc(0,0,2.1,0,TAU);c.fill();c.restore();
    // Shared reflections make the pair read as polished glass spheres.
    c.fillStyle='rgba(255,255,247,.92)';c.beginPath();c.ellipse(-2.6,-3.5,1.5,.9,-.45,0,TAU);c.fill();
    c.fillStyle='rgba(216,241,249,.65)';c.beginPath();c.arc(2.7,2.4,.65,0,TAU);c.fill();
    c.strokeStyle='rgba(242,254,252,.46)';c.lineWidth=.6;c.beginPath();c.arc(-.5,-.7,7.6,-2.65,-1.05);c.stroke();
    // Bronze-grey lids sweep over the glass; both eyes share exactly the same blink.
    var closing=pairBlink(t);
    if(closing>0){
      c.save();c.beginPath();c.arc(0,0,9.4,0,TAU);c.clip();
      var gap=9.5*(1-closing),lid=c.createLinearGradient(0,-9.4,0,9.4);
      lid.addColorStop(0,'#a29478');lid.addColorStop(.5,'#786f5c');lid.addColorStop(1,'#4a4c43');c.fillStyle=lid;
      c.beginPath();c.moveTo(-10,-10);c.lineTo(10,-10);c.lineTo(10,-gap);c.quadraticCurveTo(0,-gap+closing*.9,-10,-gap);c.closePath();c.fill();
      c.beginPath();c.moveTo(-10,10);c.lineTo(10,10);c.lineTo(10,gap);c.quadraticCurveTo(0,gap-closing*.9,-10,gap);c.closePath();c.fill();
      c.strokeStyle='rgba(216,199,159,.5)';c.lineWidth=.45;c.beginPath();c.moveTo(-9.4,-gap);c.quadraticCurveTo(0,-gap+closing*.9,9.4,-gap);c.stroke();c.restore();
    }
    c.restore();
  }
  function eye(p,tangent,alpha,k,index,t){
    var recognised=index===100||index===101,blue=index===100,gazeIndex=recognised?100:index;
    c.save();c.translate(p.x,p.y);c.rotate(tangent);c.scale(k,k);
    // Almond sockets with opaque dark recesses; tiny irises remain open.
    c.beginPath();c.moveTo(-8,0);c.quadraticCurveTo(0,-6.3,8,0);c.quadraticCurveTo(0,6.3,-8,0);
    c.fillStyle=recognised?'rgba(213,216,198,'+alpha+')':'rgba(17,12,11,'+alpha+')';c.fill();c.strokeStyle='rgba(231,190,111,'+alpha+')';c.lineWidth=.8;c.stroke();
    // Each gaze lingers, then drifts elsewhere; the central eye stays more attentive.
    var gazeX=Math.tanh(Math.sin(t*.31+gazeIndex*1.73)*2.2)*(index===99?.7:1.65);
    var gazeY=Math.sin(t*.23+gazeIndex*2.17)*.65;
    c.save();c.translate(gazeX,gazeY);
    var irisR=recognised?3.5:2.8;var iris=c.createRadialGradient(-.5,-.5,.2,0,0,irisR);
    if(recognised){iris.addColorStop(0,'#060f16');iris.addColorStop(.3,blue?'#10366c':'#164b2e');iris.addColorStop(.48,blue?'#2697f4':'#3dba66');iris.addColorStop(.8,blue?'#71ceff':'#96e58e');iris.addColorStop(1,blue?'#174a83':'#24583b');}
    else{iris.addColorStop(0,'#171317');iris.addColorStop(.35,'#211b15');iris.addColorStop(.48,'#9e8052');iris.addColorStop(.82,'#e1c28a');iris.addColorStop(1,'#69543a');}
    c.globalAlpha=alpha;c.fillStyle=iris;c.beginPath();c.arc(0,0,irisR,0,TAU);c.fill();
    c.fillStyle='#110e10';c.beginPath();c.ellipse(0,0,recognised?1.2:.9,recognised?1.2:1.7,0,0,TAU);c.fill();
    var catchLight=.5+.5*Math.sin(t*.21+index*.47);
    c.fillStyle='rgba(255,244,210,'+(.45+catchLight*.5)+')';c.beginPath();c.arc(-1.1+catchLight*.6,-1.1,.4+catchLight*.28,0,TAU);c.fill();
    c.fillStyle='rgba(169,205,221,'+(.15+catchLight*.24)+')';c.beginPath();c.arc(.9,-.8,.32,0,TAU);c.fill();
    c.restore();
    c.strokeStyle='rgba(255,226,171,'+alpha*(.12+catchLight*.24)+')';c.lineWidth=.5;c.beginPath();c.moveTo(-7,0);c.quadraticCurveTo(0,-5.5,7,0);c.stroke();
    c.restore();
  }
  function draw(t){
    c.setTransform(ratio,0,0,ratio,0,0);c.clearRect(0,0,size,size);
    var forming=still?1:Math.min(1,t/3.2), ease=forming*forming*(3-2*forming);
    var pairAnchor=point(147,1.35+Math.sin(t*.13)*.06,0,t);
    var targetX=pointer.active&&!still?Math.max(-1.35,Math.min(1.35,(pointer.x-pairAnchor.x)/135)):0;
    var targetY=pointer.active&&!still?Math.max(-1,Math.min(1,(pointer.y-pairAnchor.y)/150)):0;
    var gazeEase=still?1:1-Math.exp(-Math.min(.1,Math.max(0,t-gazeStamp))*7);gazeStamp=t;
    pairGaze.x+=(targetX-pairGaze.x)*gazeEase;pairGaze.y+=(targetY-pairGaze.y)*gazeEase;
    // A violet distance field and warmer transmitted light in the wheel's heart.
    c.globalAlpha=.8;c.drawImage(violet,8,6,424,424);
    c.globalAlpha=.55+.09*Math.sin(t*.44);c.drawImage(amber,56,54,328,328);c.globalAlpha=1;
    // A vast, slowly turning cloud field; broken light wells up through the electrum.
    c.save();c.globalCompositeOperation='screen';
    for(var cloud=0;cloud<18;cloud++){
      var phase=cloud*2.39996+t*.095,radius=92+cloud%4*23+Math.sin(t*.12+cloud)*12;
      var cx=220+Math.cos(phase)*radius,cy=218+Math.sin(phase)*radius*.7;
      c.save();c.translate(cx,cy);c.rotate(phase*.7);c.scale(1.55,.56);
      c.globalAlpha=(.43+.14*Math.sin(cloud+t*.18))*ease;c.drawImage(cloud%3===0?amber:violet,-75,-75,150,150);c.restore();
    }
    // Feathered columns stay behind the wheel; no flashes or camera shake.
    for(var shaft=0;shaft<3;shaft++){
      c.save();c.translate(220,218);c.rotate(-.45+shaft*.41+Math.sin(t*.09+shaft)*.035);
      var ray=c.createLinearGradient(0,-205,0,180);ray.addColorStop(0,'rgba(127,144,185,0)');ray.addColorStop(.35,'rgba(127,144,185,'+(.035*ease)+')');ray.addColorStop(.65,'rgba(228,171,96,'+(.045*ease)+')');ray.addColorStop(1,'rgba(228,171,96,0)');c.fillStyle=ray;c.beginPath();c.moveTo(-5,-205);c.lineTo(4,-205);c.lineTo(48,180);c.lineTo(-40,180);c.closePath();c.fill();c.restore();
    }
    // Fine concentric filaments appear in the cloud, rather than another solid rim.
    for(var thread=0;thread<6;thread++){
      c.beginPath();for(var step=0;step<=54;step++){
        var angle=-2.4+step/54*1.9+t*.018+thread*.67,r=170+thread*5+Math.sin(angle*5+thread+t*.08)*4;
        var x=220+Math.cos(angle)*r,y=218+Math.sin(angle)*r*.9;if(!step)c.moveTo(x,y);else c.lineTo(x,y);
      }
      c.strokeStyle='rgba(169,139,162,'+(.035*ease)+')';c.lineWidth=.6;c.stroke();
    }
    c.restore();
    // Sparse drifting dust, deterministic and quiet; no random flicker.
    for(var i=0;i<46;i++){
      var a=i*2.39996+t*.012, r=60+(i*37%139);
      var x=220+Math.cos(a)*r,y=218+Math.sin(a)*r*.92;
      c.fillStyle='rgba(228,194,128,'+(.055+.10*(.5+.5*Math.sin(i*4.1+t*.22)))+')';
      c.beginPath();c.arc(x,y,i%6===0?1:.45,0,TAU);c.fill();
    }
    c.save();c.translate(220,218);c.scale(.84+.16*ease,.84+.16*ease);c.translate(-220,-218);
    var pieces=[],N=192;
    for(var ring=0;ring<2;ring++){
      var reveal=Math.max(0,Math.min(1,(forming-(ring*.18))/(1-ring*.18)));
      for(var j=0;j<N;j++){
        if(j/N>reveal)continue;
        var a=j/N*TAU-Math.PI/2, b=(j+1)/N*TAU-Math.PI/2;
        var p=point(147,a,ring,t),q=point(147,b,ring,t);
        pieces.push({kind:0,z:(p.z+q.z)/2,p:p,q:q,a:a,b:b,ring:ring});
      }
      // Engraved cross-braces move with their own rim, never over foreground metal.
      for(var j=0;j<8;j++){
        var a=j/8*TAU+t*(ring===0?.045:-.045);
        var p=point(27,a,ring,t),q=point(139,a,ring,t);
        pieces.push({kind:1,z:(p.z+q.z)/2,p:p,q:q,alpha:reveal});
      }
      for(var j=0;j<24;j++){
        var a=j/24*TAU+t*(ring===0?.045:-.045),p=point(147,a,ring,t),q=point(147,a+.01,ring,t);
        if(ring===0 && j===3){
          for(var pair=0;pair<2;pair++){var pa=1.35+Math.sin(t*.13)*.06+(pair===0?-.125:.125),ep=point(147,pa,ring,t),eq=point(147,pa+.01,ring,t);pieces.push({kind:2,z:ep.z+18,p:ep,q:eq,index:100+pair,recognised:true,alpha:Math.max(0,(forming-.48)/.52)});}
        }else pieces.push({kind:2,z:p.z+16,p:p,q:q,index:j+ring*24,alpha:Math.max(0,(forming-.48)/.52)});
      }
    }
    // A continuous dark rear bevel avoids seams between tiny side facets.
    for(var rim=0;rim<2;rim++){
      var rimReveal=Math.max(0,Math.min(1,(forming-rim*.18)/(1-rim*.18)));
      c.beginPath();for(var segment=0;segment<=N;segment++){
        if(segment/N>rimReveal)break;
        var a=segment/N*TAU-Math.PI/2,p=point(147,a,rim,t,-4);if(!segment)c.moveTo(p.x,p.y);else c.lineTo(p.x,p.y);
      }
      c.strokeStyle='rgba(44,30,22,'+ease+')';c.lineWidth=16;c.stroke();
    }
    pieces.sort(function(a,b){return a.z-b.z;});
    c.lineCap='round';
    pieces.forEach(function(s){
      var depth=(s.z+180)/360;
      if(s.kind===0){
        var shine=.5+.5*Math.cos(s.a-2.3+s.ring*.9+t*.065);
        // Dark outer bevel, broad aged metal, warm inner lip and a fine cold edge.
        var edgeA=point(154,s.a,s.ring,t,4),edgeB=point(154,s.b+.0008,s.ring,t,4);
        var innerA=point(140,s.a,s.ring,t,4),innerB=point(140,s.b+.0008,s.ring,t,4);

        c.beginPath();c.moveTo(edgeA.x,edgeA.y);c.lineTo(edgeB.x,edgeB.y);c.lineTo(innerB.x,innerB.y);c.lineTo(innerA.x,innerA.y);c.closePath();
        var aged=.92+.055*Math.sin(s.a*47+s.ring*3)+.025*Math.cos(s.a*109);
        var glint=Math.pow(Math.max(0,Math.cos(s.a-2.05+s.ring*.9+t*.065)),36);
        var rr=Math.round((84+99*shine+31*depth+glint*29)*aged),gg=Math.round((55+84*shine+27*depth+glint*30)*aged),bb=Math.round((28+52*shine+19*depth+glint*28)*aged);
        c.fillStyle='rgb('+rr+','+gg+','+bb+')';c.fill();
        var p=point(141,s.a,s.ring,t,4),q=point(141,s.b,s.ring,t,4);
        line(p,q,'rgba(255,226,164,'+(.2+.5*shine)+')',.85*p.k);
        p=point(153,s.a,s.ring,t,4);q=point(153,s.b,s.ring,t,4);
        line(p,q,'rgba(232,224,204,'+(.10+.36*shine)+')',.6*p.k);
        if(Math.round((s.a+Math.PI/2)/TAU*N)%5===0){
          var nick=point(143+(Math.sin(s.a*97)*.5+.5)*8,s.a,s.ring,t,4);
          c.fillStyle='rgba(37,26,19,.45)';c.fillRect(nick.x,nick.y,.65*nick.k,.85*nick.k);
        }
        // Regular fine incisions catch the moving light.
        if(Math.round((s.a+Math.PI/2)/TAU*N)%3===0){
          line(point(145,s.a,s.ring,t),point(149,s.a,s.ring,t),'rgba(30,21,13,.44)',.55);
        }
      } else if(s.kind===1){
        line(s.p,s.q,'rgba(190,153,84,'+s.alpha*(.09+.18*depth)+')',.7*s.p.k);
      } else {
        var tangent=Math.atan2(s.q.y-s.p.y,s.q.x-s.p.x);
        if(!s.recognised)eye(s.p,tangent,s.alpha*(.43+.55*depth),s.p.k*(.72+.28*depth),s.index,t);
      }
    });
    pieces.filter(function(s){return s.recognised;}).forEach(function(s){glassEye(s.p,s.alpha,s.p.k*1.55,s.index===100,t);});
    // Quiet light in the hub; recognition belongs to the two eyes on the rim.
    var core=project(0,0,0,t);
    c.globalAlpha=ease;c.drawImage(amber,core.x-56,core.y-56,112,112);
    c.globalAlpha=1;
    // A handful of near motes drift across the vision, giving the rims real depth.
    for(var mote=0;mote<12;mote++){
      var phase=mote*2.399+t*.045,r=80+(mote*47%120),mx=220+Math.cos(phase)*r,my=218+Math.sin(phase*.8+mote)*r*.8;
      c.globalAlpha=.035+.025*(.5+.5*Math.sin(t*.2+mote));c.drawImage(amber,mx-4,my-4,8,8);
    }
    // A few thin wisps pass in front, while the main cloud turns behind the metal.
    for(var veil=0;veil<3;veil++){
      var flow=t*.075+veil*2.094,vx=220+Math.cos(flow)*125,vy=218+Math.sin(flow)*110;
      c.save();c.translate(vx,vy);c.rotate(flow+.4);c.scale(1.9,.34);c.globalAlpha=.12*ease;c.drawImage(violet,-55,-55,110,110);c.restore();
    }
    c.globalAlpha=1;
    c.restore();
  }
  function frame(now){
    raf=0;if(!alive)return;
    if(!wrap.isConnected){dispose();return;}
    if(visible&&!document.hidden){time+=last?Math.min((now-last)/1000,.05):0;draw(time);}
    last=now;if(!still)raf=requestAnimationFrame(frame);
  }
  function dispose(){alive=false;window.removeEventListener('pointermove',followPointer);window.removeEventListener('pointerout',releaseGaze);window.removeEventListener('blur',releaseGaze);cancelAnimationFrame(raf);if(observer)observer.disconnect();if(intersection)intersection.disconnect();media.removeEventListener('change',motion);}
  function motion(){still=media.matches;if(still){pointer.active=false;pairGaze.x=pairGaze.y=0;}cancelAnimationFrame(raf);raf=0;last=0;if(still)draw(8);else raf=requestAnimationFrame(frame);}
  var observer=new MutationObserver(function(){if(!wrap.isConnected)dispose();});
  observer.observe(document.body,{childList:true,subtree:true});
  var intersection=window.IntersectionObserver?new IntersectionObserver(function(entries){visible=entries[0].isIntersecting;last=0;}):null;
  if(intersection)intersection.observe(wrap);
  media.addEventListener('change',motion);
  if(still)draw(8);else {draw(0);raf=requestAnimationFrame(frame);}
})();
</script>

<script>
// 2026-10-06: the two reveal sounds used to fire the moment "Draw it down" was pressed, before the
// wheel had formed. The wheel takes 3.2 s to form (ezekielForm): the lore sound now begins as the
// panel has scrolled to it and the gold is drawing, and the bell rings as the wheel settles. Under
// reduced motion the wheel is simply there, so the sounds keep their old quick timing.
(function(){
  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (window.dssAudio && window.dssAudio.loreUnravel) {
    setTimeout(function(){ window.dssAudio.loreUnravel(); }, still ? 100 : 1300);
  }
  if (window.dssAudio && window.dssAudio.distantBell) {
    setTimeout(function(){ window.dssAudio.distantBell(); }, still ? 900 : 3200);
  }
})();
// 2026-10-06 Ezekiel polish: the wheel forms below the fold of the panel on a laptop, so the
// panel (or the page, when there is no panel) is brought down to it as it begins to form.
(function(){
  var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  setTimeout(function(){
    var w = document.querySelector('.ezekiel-wheel-wrap');
    if (w && w.scrollIntoView) { try { w.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' }); } catch(e) { w.scrollIntoView(); } }
  }, still ? 60 : 220);
})();
</script>

