:: UserScript [script]

// ====== V2-EXPANSION: WORLDS LIFETIME TRACKING ======
// Worlds the player has completed across all playthroughs persist in
// localStorage. The Third Pillar Portal passage reads this list in its
// own script at render time. The permanent gift list now governs access;
// this legacy list is kept for compatibility and never cycles. No Harlowe internals
// touched — JS handles the roll, then triggers a hidden Harlowe link
// via .click() to navigate.
window.DSS_WORLDS_ALL = ["himalayas", "nazca", "easter", "pyramid", "ezekiel"];
window.DSS_WORLDS_KEY = "dssWorldsSeenCycle";
window.dssLoadLifetimeWorlds = function() {
  try {
    var raw = localStorage.getItem(window.DSS_WORLDS_KEY);
    if (!raw) return [];
    var arr = JSON.parse(raw);
    if (!Array.isArray(arr)) return [];
    return arr.filter(function(w){ return window.DSS_WORLDS_ALL.indexOf(w) >= 0; });
  } catch(e) { return []; }
};
window.dssSaveLifetimeWorlds = function(arr) {
  try { localStorage.setItem(window.DSS_WORLDS_KEY, JSON.stringify(arr || [])); } catch(e) {}
};
window.dssMarkWorldSeen = function(name) {
  if (window.DSS_WORLDS_ALL.indexOf(name) < 0) return;
  var lifetime = window.dssLoadLifetimeWorlds();
  if (lifetime.indexOf(name) < 0) lifetime.push(name);
  // Completion is permanent; never reset after the fifth world.
  window.dssSaveLifetimeWorlds(lifetime);
  // Also persist the gift permanently (never resets — needed for the
  // 6th world ritual which requires lifetime 5/5 gifts).
  window.dssAddLifetimeGift(name);
};

// ====== V2-EXPANSION: LIFETIME GIFTS (PERMANENT, NEVER RESETS) ======
// Tracks which world gifts the player has *ever* earned, across all
// playthroughs and lifetime-cycle resets. The 6th world ritual at the
// Pillars only unlocks once all 5 are accumulated. This is the
// multi-playthrough payoff of Variant B.
window.DSS_GIFTS_KEY = "dssLifetimeGifts";
window.dssLoadLifetimeGifts = function() {
  try {
    var raw = localStorage.getItem(window.DSS_GIFTS_KEY);
    if (!raw) return [];
    var arr = JSON.parse(raw);
    if (!Array.isArray(arr)) return [];
    return arr.filter(function(g){ return window.DSS_WORLDS_ALL.indexOf(g) >= 0; });
  } catch(e) { return []; }
};
window.dssAddLifetimeGift = function(name) {
  if (window.DSS_WORLDS_ALL.indexOf(name) < 0) return;
  var gifts = window.dssLoadLifetimeGifts();
  if (gifts.indexOf(name) < 0) gifts.push(name);
  try { localStorage.setItem(window.DSS_GIFTS_KEY, JSON.stringify(gifts)); } catch(e) {}
};
window.dssClearLifetimeGifts = function() {
  try { localStorage.removeItem(window.DSS_GIFTS_KEY); } catch(e) {}
};

// v2 KEYS: pocket-key -> world steering. The player carries at most one
// key; the Third Pillar Portal reads it to choose tonight's world.
window.DSS_KEY_WORLDS = { cocaine: "nazca", ticket: "easter", slip: "pyramid", lighter: "himalayas", eye: "ezekiel" };


// ====== ASYMPTOTIC STAT HELPERS (JS) ======
// Mirror the Harlowe $statGain / $statLoss macros so any JS-side stat
// bump (notebook buttons, minigame scoring, etc.) lands on the same curve
// as passage-level changes. Keep the /50 divisor identical to the macros;
// if the macro divisor changes, change here too.
window.dssStatGain = function(v, n) {
  if (typeof v !== 'number' || typeof n !== 'number') return v;
  return Math.round(Math.min(100, v + (100 - v) * (n / 50)));
};
window.dssStatLoss = function(v, n) {
  if (typeof v !== 'number' || typeof n !== 'number') return v;
  return Math.round(Math.max(0, v - v * (n / 50)));
};

// 2026-10-11 structure pass 3: the stat bars are drawn once per page, so a stat changed in place (Retch. in the
// gents, "I’m not here" to a ringing phone) showed the old value until you left. The "Bars Now" passage prints the
// new morale,sobriety into a hidden span and calls this to redraw both bars, their percentages and the voices' note.
window.dssBarsNow = function() {
  var n = document.querySelectorAll('.dss-bars-now'); if (!n.length) return;
  var v = n[n.length - 1].textContent.split(',');
  var rows = document.querySelectorAll('.stat-bars .stat-row');
  [0, 1].forEach(function(i) {
    var r = rows[i], x = Math.round(+v[i]);
    if (!r || isNaN(x) || r.querySelector('.pct-opus')) return;
    x = Math.max(0, Math.min(100, x));
    var f = r.querySelector('.bar-fill'), p = r.querySelector('.stat-pct');
    if (p && parseInt(p.textContent, 10) === x) return; // unchanged: keep this page's marks
    if (f) { f.style.width = x + '%'; f.classList.remove('bar-good', 'bar-warning', 'bar-danger', 'bar-flash-up', 'bar-flash-down'); f.classList.add(x >= 50 ? 'bar-good' : (x >= 25 ? 'bar-warning' : 'bar-danger')); }
    if (p) { p.textContent = x + '%'; p.classList.remove('pct-gain', 'pct-loss'); }
    Array.prototype.forEach.call(r.querySelectorAll('.stat-delta, .bar-ghost'), function(e) { e.remove(); }); // the last page's change marks no longer apply
  });
  var st = document.getElementById('dss-voice-state');
  if (st) { if (!isNaN(+v[0])) st.setAttribute('data-mor', String(Math.round(+v[0]))); if (!isNaN(+v[1])) st.setAttribute('data-sob', String(Math.round(+v[1]))); }
};

/* 2026-10-29 (Sam: "I just added lightning. Use this where appropriate, maybe when the pentagram is drawn?"): as the casting traces the star on the
   notebook's map, each of its five strokes crackles with his lightning (six frames, flickered) the moment the gold line runs along it, then sinks to a
   faint after-glow; when the star closes the whole figure flashes once. Timed to nb-map-pent: the line draws from 8% to 52% of 5 s, eased. */
window.DSS_LIGHTNING = [{"src": "data:image/jpeg;base64,", "h": 85}, {"src": "data:image/jpeg;base64,", "h": 77}, {"src": "data:image/jpeg;base64,", "h": 81}, {"src": "data:image/jpeg;base64,", "h": 94}, {"src": "data:image/jpeg;base64,", "h": 95}, {"src": "data:image/jpeg;base64,", "h": 85}];
setInterval(function() {
  var svg = document.querySelector('.soho-map svg.nb-map-pentangle'); if (!svg || svg._dssBolts) return; svg._dssBolts = true;
  var poly = svg.querySelector('.map-pentagram'); if (!poly || !window.DSS_LIGHTNING) return;
  var NS = 'http://www.w3.org/2000/svg', XL = 'http://www.w3.org/1999/xlink', F = window.DSS_LIGHTNING;
  var pts = poly.getAttribute('points').trim().split(/\s+/).map(function(p) { var q = p.split(','); return [+q[0], +q[1]]; }); pts.push(pts[0]);
  var lens = [], tot = 0; for (var i = 0; i < pts.length - 1; i++) { var L = Math.hypot(pts[i + 1][0] - pts[i][0], pts[i + 1][1] - pts[i][1]); lens.push(L); tot += L; }
  function ease(t) { return t < 0.5 ? 2 * t * t : 1 - 2 * (1 - t) * (1 - t); }
  function timeAt(frac) { var lo = 0, hi = 1; for (var k = 0; k < 24; k++) { var m = (lo + hi) / 2; if (ease(m) < frac) lo = m; else hi = m; } return 400 + 2200 * lo; }
  var g = document.createElementNS(NS, 'g'); g.setAttribute('class', 'map-pent-bolts'); g.style.mixBlendMode = 'screen'; g.style.pointerEvents = 'none'; svg.appendChild(g);
  var acc = 0;
  lens.forEach(function(L, i) {
    var a = pts[i], b = pts[i + 1], ang = Math.atan2(b[1] - a[1], b[0] - a[0]) * 180 / Math.PI, t0 = timeAt(acc / tot), t1 = timeAt((acc + L) / tot); acc += L;
    var im = document.createElementNS(NS, 'image'), hgt = Math.max(14, L * 0.09);
    im.setAttribute('x', 0); im.setAttribute('y', -hgt / 2); im.setAttribute('width', L); im.setAttribute('height', hgt); im.setAttribute('preserveAspectRatio', 'none');
    im.setAttribute('transform', 'translate(' + a[0] + ',' + a[1] + ') rotate(' + ang + ')'); im.style.opacity = '0'; im.style.transition = 'opacity 0.5s ease';
    g.appendChild(im);
    var f = 0, iv = null;
    setTimeout(function() { im.style.transition = 'opacity 0.08s'; im.style.opacity = '1'; iv = setInterval(function() { var fr = F[(f++) % F.length]; im.setAttributeNS(XL, 'href', fr.src); im.setAttribute('href', fr.src); }, 55); }, Math.max(0, t0 - 60));
    setTimeout(function() { clearInterval(iv); im.style.transition = 'opacity 1.4s ease'; im.style.opacity = '0.16'; }, t1 + 650);
  });
  setTimeout(function() { g.style.transition = 'filter 0.15s'; g.style.filter = 'brightness(2.4)'; Array.prototype.forEach.call(g.children, function(im) { im.style.transition = 'opacity 0.1s'; im.style.opacity = '1'; }); setTimeout(function() { g.style.transition = 'filter 1.2s'; g.style.filter = ''; Array.prototype.forEach.call(g.children, function(im) { im.style.transition = 'opacity 1.6s ease'; im.style.opacity = '0.12'; }); }, 220); }, 2600 + 900);
}, 150);
// ====== PENTANGLE REVEAL ON MAP ======
// Opens the notebook (if not already open), switches to MAP tab, and triggers
// the pentagram + lily-of-the-valley animation drawn over the Soho map.
window.dssRevealPentangleOnMap = function() {
  function openMap() {
    var page = document.querySelector('tw-dialog .nb-page');
    if (!page) return false;
    // Make sure the queue includes 'map' so nbSwitchTab will fire the animation
    var queue = page.dataset.pentangleQueue || '';
    if (queue.indexOf('map') < 0) {
      queue = queue ? (queue + ',map') : 'map';
      page.dataset.pentangleQueue = queue;
    }
    var mapTab = page.querySelector('.nb-tab[data-tab="map"]');
    if (mapTab && window.nbSwitchTab) { window.nbSwitchTab(mapTab); return true; }
    return false;
  }
  if (openMap()) return;
  // Notebook isn't open yet — click the link, then open map after dialog renders
  var nbLink = document.querySelector('.notebook-link tw-link, .notebook-link a, .notebook-link');
  if (nbLink) {
    if (nbLink.tagName === 'TW-LINK' || nbLink.tagName === 'A') nbLink.click();
    else { var inner = nbLink.querySelector('tw-link, a'); if (inner) inner.click(); }
  }
  // Poll briefly for the notebook to appear
  var tries = 0;
  var iv = setInterval(function() {
    tries++;
    if (openMap() || tries > 30) clearInterval(iv);
  }, 80);
};

// Legacy: kept for direct testing only — the small screen overlay isn't the main reveal.
window.dssShowPentangleOverlay = function() {
  if (document.getElementById('dss-pentangle-overlay')) return;

  // 5 lily groups arranged at the points of a point-up pentagram (centre 150,150 radius 50)
  var ROT = [180, 108, 36, 324, 252];
  var lilyContent = '<line x1="0" y1="0" x2="0" y2="32" stroke="#9a8a68" stroke-width="1.1" stroke-linecap="round" opacity="0.7"/>'
    + '<path d="M -7,38 C -7,32 -3,30 0,30 C 3,30 7,32 7,38 C 7,46 4,52 0,52 C -4,52 -7,46 -7,38 Z" fill="#e8e2d4" stroke="#9a8a68" stroke-width="0.8" opacity="0.92"/>'
    + '<path d="M -3,38 C -3,34 -1.5,33 0,33 C 1.5,33 3,34 3,38 C 3,42 1.5,46 0,46 C -1.5,46 -3,42 -3,38 Z" fill="#f5f0e6" stroke="none" opacity="0.55"/>';

  var lilies = '';
  for (var i = 0; i < 5; i++) {
    lilies += '<g class="dss-pent-lily dss-pent-lily-' + (i + 1) + '" transform="translate(150,150) rotate(' + ROT[i] + ')" opacity="0">' + lilyContent + '</g>';
  }

  var html = '<div id="dss-pentangle-overlay" style="position:fixed;top:0;left:0;width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;z-index:99999;pointer-events:none;background:rgba(0,0,0,0.55);opacity:0;transition:opacity 0.7s ease;">'
    + '<svg width="340" height="340" viewBox="0 0 300 300" style="max-width:80vw;max-height:80vh;overflow:visible;">'
    + '<polygon class="dss-pent-star" points="150,100 179.4,190.5 102.5,134.6 197.6,134.6 120.6,190.5" fill="none" stroke="#d4a574" stroke-width="1.1" opacity="0" style="transition:opacity 0.8s 0.3s ease;"/>'
    + '<circle class="dss-pent-glow" cx="150" cy="150" r="78" fill="none" stroke="#d4a574" stroke-width="0.4" opacity="0" style="transition:opacity 1.0s 0.4s ease;"/>'
    + lilies
    + '</svg></div>';

  var wrap = document.createElement('div');
  wrap.innerHTML = html;
  var overlay = wrap.firstChild;
  document.body.appendChild(overlay);

  // Fade in everything
  requestAnimationFrame(function() {
    overlay.style.opacity = '1';
    var lils = overlay.querySelectorAll('.dss-pent-lily');
    lils.forEach(function(g, i) {
      g.style.transition = 'opacity 0.6s ease ' + (0.1 + i * 0.08) + 's';
      g.style.opacity = '1';
    });
    var poly = overlay.querySelector('.dss-pent-star');
    if (poly) poly.style.opacity = '0.78';
    var glow = overlay.querySelector('.dss-pent-glow');
    if (glow) glow.style.opacity = '0.45';
  });

  // Fade out
  setTimeout(function() {
    overlay.style.opacity = '0';
  }, 3300);

  // Remove from DOM
  setTimeout(function() {
    if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
  }, 4100);
};

// ====== BROWSER BACK BUTTON (PLAYTESTING) ======
var _dssLastPassage = '';
setInterval(function() {
  var p = document.querySelector('tw-passage[data-name]');
  var name = p ? p.getAttribute('data-name') : '';
  if (name && name !== _dssLastPassage) {
    _dssLastPassage = name;
    window.history.pushState({ dss: 1 }, '');
  }
}, 150);
window.addEventListener('popstate', function() {
  // Find whichever sidebar icon triggers undo
  var icons = document.querySelectorAll('tw-icon');
  for (var i = 0; i < icons.length; i++) {
    var t = icons[i].getAttribute('title') || icons[i].getAttribute('aria-label') || '';
    if (/undo/i.test(t)) { icons[i].click(); return; }
  }
  // Fallback: first icon in sidebar is usually undo
  var first = document.querySelector('tw-sidebar tw-icon');
  if (first) first.click();
});

// ====== AUDIO — Web Audio synth (no external files) ======
