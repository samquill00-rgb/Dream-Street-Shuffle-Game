        for(var grain=0;grain<5;grain++){var gy=base-9-grain*8;c.strokeStyle=grain%2?'#bf92551a':'#09070935';c.beginPath();c.moveTo(x+2,gy);c.bezierCurveTo(x+w*.3,gy+2,x+w*.7,gy-2,x+w-2,gy+1);c.stroke();}

