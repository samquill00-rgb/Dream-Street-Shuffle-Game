var grimeMat = new THREE.MeshBasicMaterial({ color: 0x0a0808, transparent: true, opacity: 0.12, side: THREE.DoubleSide });
var dampMat = new THREE.MeshBasicMaterial({ color: 0x1a1815, transparent: true, opacity: 0.08, side: THREE.DoubleSide });
var sootMat = new THREE.MeshBasicMaterial({ color: 0x050505, transparent: true, opacity: 0.1, side: THREE.DoubleSide });

// Dark water streaks running down pub facade (from gutters/window sills)
