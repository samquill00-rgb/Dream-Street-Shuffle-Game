    });
  }
  // Ambient bed — single-slot state machine. Only one bed plays at a time.
  var _ambient = null;
  function _stopAmbient(fadeSec) {
    var ac = getCtx(); if (!ac || !_ambient) return;
    var prev = _ambient; _ambient = null;
    if (prev.timer) { try { clearTimeout(prev.timer); } catch(e) {} }
    if (prev.dripTimer) { try { clearTimeout(prev.dripTimer); } catch(e) {} }
    var fade = (typeof fadeSec === 'number') ? Math.max(0, fadeSec) : 0.5;
    try {
      prev.g.gain.cancelScheduledValues(ac.currentTime);
      if (fade <= 0.005) {
        prev.g.gain.setValueAtTime(0, ac.currentTime);
        prev.src.stop(ac.currentTime + 0.01);
      } else {
        prev.g.gain.linearRampToValueAtTime(0, ac.currentTime + fade);
        prev.src.stop(ac.currentTime + fade + 0.1);
      }
    } catch(e) {}
    // Stop any LFO oscillators attached to the bed so they don't keep
    // running in the background after the audio is silent.
    ['lfo','lfo2','ampLfo'].forEach(function(k){
      if (prev[k] && prev[k].stop) {
        try { prev[k].stop(ac.currentTime + 0.6); } catch(e) {}
      }
    });
  }
  // Pub murmur — pink noise filtered through two bandpass filters tuned to
  // the human voice formants (F1 ~600Hz, F2 ~1500Hz), with rhythmic amplitude
  // modulation baked into the buffer. Sounds like distant chatter rather than
  // hiss.
  function ambientPub() {
    _play(function(ac) {
    if (_ambient && _ambient.kind === 'pub') return;
    _stopAmbient();
    var now = ac.currentTime;
    // Long buffer (8s) so the loop point isn't obvious
    var bufLen = Math.floor(ac.sampleRate * 8.0);
    var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
    var d = buf.getChannelData(0);
    var b0=0, b1=0, b2=0;
    for (var i = 0; i < bufLen; i++) {
      var w = Math.random()*2-1;
      b0 = 0.99*b0 + 0.07*w;
      b1 = 0.96*b1 + 0.10*w;
      b2 = 0.85*b2 + 0.12*w;
      // Rhythmic amplitude modulation — voices coming and going.
      // Two low-frequency sines at incommensurate rates so there's no obvious pulse.
      var ti = i / ac.sampleRate;
      var rhythm = 0.45 + 0.35 * Math.sin(ti * 1.7) + 0.20 * Math.sin(ti * 0.83 + 1.3);
      if (rhythm < 0.15) rhythm = 0.15;
      d[i] = (b0 + b1 + b2) * 0.3 * rhythm;
    }
    var src = ac.createBufferSource(); src.buffer = buf; src.loop = true;
    // Two bandpass filters in parallel — formant character (vowels)
    var f1 = ac.createBiquadFilter(); f1.type='bandpass';
    f1.frequency.value = 620; f1.Q.value = 1.6;
    var f2 = ac.createBiquadFilter(); f2.type='bandpass';
    f2.frequency.value = 1500; f2.Q.value = 1.9;
    var g1 = ac.createGain(); g1.gain.value = 1.0;
    var g2 = ac.createGain(); g2.gain.value = 0.55;
    var g = ac.createGain();
    g.gain.setValueAtTime(0, now);
    g.gain.linearRampToValueAtTime(0.18, now + 1.5);
    src.connect(f1); f1.connect(g1); g1.connect(g);
    src.connect(f2); f2.connect(g2); g2.connect(g);
    g.connect(ac.destination);
    src.start(now);
    _ambient = { src: src, g: g, kind: 'pub' };
      });
  }
  // Wind / sea — broader noise with slow filter sweep, suggesting open coast
  function ambientDream() {
    _play(function(ac) {
    if (_ambient && _ambient.kind === 'dream') return;
    _stopAmbient();
    var now = ac.currentTime;
    var bufLen = Math.floor(ac.sampleRate * 6.0);
    var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
    var d = buf.getChannelData(0);
    for (var i = 0; i < bufLen; i++) d[i] = (Math.random()*2-1) * 0.6;
    var src = ac.createBufferSource(); src.buffer = buf; src.loop = true;
    var f = ac.createBiquadFilter(); f.type='lowpass';
    f.frequency.value = 1100; f.Q.value = 0.4;
    var g = ac.createGain();
