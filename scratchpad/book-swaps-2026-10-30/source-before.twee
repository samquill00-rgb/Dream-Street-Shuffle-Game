      if (sg.length > 1) { var pth = document.createElementNS(NS, 'path'); pth.setAttribute('d', d); pth.setAttribute('pathLength', '1'); pth.setAttribute('class', 'nb-trace-route'); pth.style.animationDelay = start.toFixed(2) + 's'; pth.style.animationDuration = Math.max(0.1, dur).toFixed(2) + 's'; g.appendChild(pth); }
      var last = sg[sg.length - 1], dot = document.createElementNS(NS, 'circle');
      dot.setAttribute('cx', lerp(XS, last[0] + 0.5).toFixed(1)); dot.setAttribute('cy', lerp(YS, last[1] + 0.5).toFixed(1)); dot.setAttribute('r', '4'); dot.setAttribute('class', 'nb-trace-door'); dot.style.animationDelay = (start + dur).toFixed(2) + 's'; g.appendChild(dot);
    });
    var firstText = svg.querySelector('text'); while (firstText && firstText.parentNode !== svg) firstText = firstText.parentNode; // the labels sit over the walk
    if (firstText) svg.insertBefore(g, firstText); else svg.appendChild(g);
