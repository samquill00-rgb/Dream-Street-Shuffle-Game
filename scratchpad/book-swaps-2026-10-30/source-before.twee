};
/* the NOTEBOOK's copy, once the rumour has been heard (.nb-rumour-sketch is printed by the notebook's FINDS) */
setInterval(function() { Array.prototype.forEach.call(document.querySelectorAll('.nb-rumour-sketch:not([data-filled])'), function(b) { b.setAttribute('data-filled', '1'); b.appendChild(window.dssRumourSketch(3)); }); }, 300);
// 2026-10-14 (Sam: "the clocking of rejections is the most important ... you have to really want to sell the book and be
// sad that you fail"): each reading's verdict is filed as a rejection slip. The scene carries a hidden .dss-refusal with
// the reader's own words; when it is on screen the slip rises, holds, and is filed into the NOTEBOOK; any haunt box in
// the scene waits until it is filed (the book first, the haunt second). Slips are kept in localStorage 'dssRefusals' by
// night ('dssNightNo'), so earlier nights' refusals stay in the notebook, fading. No count, no glow, no tally.
window.dssRefusals = (function() {
  var KEY = 'dssRefusals', mem = null;
  function night() { try { return +localStorage.getItem('dssNightNo') || 0; } catch (e) { return 0; } }
  function load() { if (mem) return mem; try { return (JSON.parse(localStorage.getItem(KEY) || '[]') || []).filter(function(r) { return r && r.k !== 'moe'; }); } catch (e) { return []; } } /* 2026-10-19 (Sam): MOE is not a reader; slips he filed on earlier nights drop out of the notebook, the Dawn and the deal's count */
  function save(a) { try { localStorage.setItem(KEY, JSON.stringify(a)); } catch (e) { mem = a; } }
  function shown(el) {
    if (!el || !el.getClientRects().length) return false;
    for (var e = el; e && e.nodeType === 1 && e !== document.body; e = e.parentElement) { var cs = getComputedStyle(e); if (cs.display === 'none' || cs.visibility === 'hidden' || parseFloat(cs.opacity) < 0.6) return false; }
    return true;
  }
  function notebookLink() { return Array.prototype.find.call(document.querySelectorAll('#stat-bars-lifted tw-link, .stat-bars tw-link'), function(l) { return /NOTEBOOK/i.test(l.textContent) && l.getClientRects().length; }); }
  function fly(rec, m) {
    var slip = document.createElement('div'); slip.className = 'dss-slip-fly' + (rec.near ? ' dss-slip-near' : '') + (rec.yes ? ' dss-slip-yes' : '');
    slip.setAttribute('aria-hidden', 'true');
    var w = document.createElement('div'); w.className = 'dss-slip-who'; w.textContent = rec.who;
    var t = document.createElement('div'); t.className = 'dss-slip-line'; t.textContent = rec.line;
    slip.appendChild(w); slip.appendChild(t); document.body.appendChild(slip);
    requestAnimationFrame(function() { requestAnimationFrame(function() { slip.classList.add('in'); }); });
    setTimeout(function() {
      var nb = notebookLink();
      if (nb) { var r = nb.getBoundingClientRect(); slip.style.left = (r.left + r.width / 2) + 'px'; slip.style.top = (r.top + r.height / 2) + 'px'; }
      slip.classList.add('out');
      setTimeout(function() {
        if (slip.parentNode) slip.parentNode.removeChild(slip);
        m.classList.add('dss-filed'); after(m); window._dssSlipFiledAt = Date.now();
        // the scene's haunt box now plays its own reveal from the start
        var root = m.closest('.dss-room-prose') || m.closest('tw-passage');
        if (root) Array.prototype.forEach.call(root.querySelectorAll('.haunt-box'), function(h) { h.style.animation = 'none'; void h.offsetWidth; h.style.animation = ''; });
        if (nb) { nb.classList.add('dss-nb-took'); setTimeout(function() { nb.classList.remove('dss-nb-took'); }, 1600); }
      }, 1100);
    }, 6000); /* 2026-10-19 (Sam, playtest: the reader's words "came and went far too quickly"): held 6 s, was 3.2 */
  }
  // 2026-10-19 (Sam, playtest: "there should be a line after each about how you ignore it etc. How it affects you, so it makes sense
  // that you keep going in spite of discouragement"): the scene's .dss-refusal-after (his line; pink slots until he writes them) shows
  // once the slip is filed, or at once when it was filed earlier tonight (a revisit) or motion is reduced
  function after(m) {
    var k = m.getAttribute('data-k'), root = m.closest('.dss-room-prose') || m.closest('tw-passage') || document;
    Array.prototype.forEach.call(root.querySelectorAll('.dss-refusal-after[data-k="' + k + '"]'), function(sl) { if (!sl.hidden) return; sl.hidden = false; setTimeout(function() { sl.classList.add('dss-in'); }, 30); });
  }
  function file(m) {
    if (m._filed) return; m._filed = true;
    var n = night(), k = m.getAttribute('data-k'), a = load();
    if (a.some(function(r) { return r.n === n && r.k === k; })) { m.classList.add('dss-filed'); after(m); return; }
    var rec = { n: n, k: k, who: m.getAttribute('data-who') || '', line: m.textContent, near: m.hasAttribute('data-near'), yes: m.hasAttribute('data-yes') };
    a.push(rec); save(a);
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { m.classList.add('dss-filed'); after(m); return; }
    /* 2026-10-23 overnight (Sam, playtest: INIS "these responses that flash up distract from the main text, I want rid of them";
       Coach "'I don't want that book' etc. This is just confusing. Get rid of these little things"; the Ham's America words
       "shouldn't be happening twice in one scene"): the reader's words are already in the prose, so the slip no longer flies
       over the page; it is filed quietly (the notebook, the Dawn's record and the Fetch still count it) and the NOTEBOOK
