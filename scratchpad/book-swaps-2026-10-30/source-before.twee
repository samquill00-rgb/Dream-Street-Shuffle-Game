  color: 0x080810, roughness: 0.05, metalness: 0.6, transparent: true, opacity: 0.3
});
var pavePuddlePos = [
  [-1, 2.2, 0.5], [1.5, 1.8, 0.4], [4, 2.5, 0.55],
  [-5, 2.0, 0.65], [7, 2.3, 0.45], [-3, 1.5, 0.35]
];
for (var ppi = 0; ppi < pavePuddlePos.length; ppi++) {
  var ppp = pavePuddlePos[ppi];
