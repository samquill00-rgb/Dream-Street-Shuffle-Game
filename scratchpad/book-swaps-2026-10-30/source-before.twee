-style='italic' letter-spacing='2' style='filter: drop-shadow(0 0 2px rgba(10,9,8,0.9));'>for about me flames the Pentagram,</text><text x='280' y='642' text-anchor='middle' fill='#d8e0ec' font-family='Playfair Display,Georgia,serif' font-size='10' font-style='italic' letter-spacing='2' style='filter: drop-shadow(0 0 2px rgba(10,9,8,0.9));'>and in the Column stands the six-rayed Star.</text></g>")]\
(set: _m to _m + "<rect width='560' height='700' fill='url(#fg)' pointer-events='none'/><rect width='560' height='700' fill='url(#fg2)' pointer-events='none'/><rect width='560' height='700' fill='none' stroke='rgba(10,9,8,0.85)' stroke-width='15' pointer-events='none'/>")(set: _m to _m + "</svg></div>")\
