      more = document.createElement('div'); more.className = 'dss-rumour-more'; more.setAttribute('aria-hidden', 'true'); more.innerHTML = '<span class="drm-word">Go on</span><span class="drm-arrow">&#9660;</span>'; /* 2026-10-29 (Sam, playtest note 2: "there should be an arrow or something to make it obvious that you need to click here for the next bit of text") */
      c.appendChild(more);
