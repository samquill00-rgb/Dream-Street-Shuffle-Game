# LibreOffice / OpenOffice lock files (created while a doc is open)
.~lock.*#

# Compile-script backup snapshots (sync_html.py creates these on every run)
BACKUP-*.twee
BACKUP-*.html

# macOS metadata
.DS_Store

# Editor swap files
*.swp
*~

# Claude session handoff notes (not part of the game)
HANDOFF*.md

# Claude Code workspace (worktrees, session state, settings)
.claude/

# Python bytecode from the test harness
__pycache__/
*.pyc

# Loop screenshots live in the project files, not the repo
scratchpad/**/*.png
scratchpad/**/regress/

# Listening page for Sam's street recording: WAV copies remade from the game files by hand (2026-11-11)
street-live-originals/game/
street-live-originals/listen.html
