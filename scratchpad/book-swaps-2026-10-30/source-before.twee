var cardPress=null;
card.addEventListener('pointerdown',function(ev){cardPress={x:ev.clientX,y:ev.clientY,scroll:(card.querySelector('.dss-room-card-body')||card).scrollTop};});
// a click, not a press, steps back from the card, so a finger can scroll a long card without closing it
