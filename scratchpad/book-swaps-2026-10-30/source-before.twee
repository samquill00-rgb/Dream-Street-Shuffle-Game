      for (var jr = 0; jr < 5; jr++) placeMesh(rightBuilding, new THREE.CylinderGeometry(0.07, 0.07, 0.2, 8), new THREE.MeshStandardMaterial({ color: [0xb06a20, 0x4a6a30, 0xa02020, 0xc89040, 0x6a3a50][(jr + si) % 5], roughness: 0.4, emissive: 0x301008, emissiveIntensity: 0.6 }), wx - 0.5 + jr * 0.25, sy + 0.12, -0.2);
    });
  });
  // ---- Ground floor: black-lacquered shopfront, panelled and chipped (2026-10-28) ----
  var lacquerTex = makeCanvasTexture(512, 512, function(cx, w, h) {
