var ofDisplay = placeMesh(new THREE.PlaneGeometry(2.66, 2.0), new THREE.MeshBasicMaterial({ map: displayTex }), 0.675, 1.62, -0.16);
// The existing painted spines get a second, static identity mask. The GPU
// changes each independently; lettering, shadows and paper notices stay put.
var ofBookMaskTex=new THREE.CanvasTexture(ofBookMaskCanvas);
ofDisplay.material.onBeforeCompile=function(shader){
 shader.uniforms.ofBookMask={value:ofBookMaskTex};shader.uniforms.ofMagicTime=ofMagicTime;
 shader.fragmentShader='uniform sampler2D ofBookMask;\nuniform float ofMagicTime;\n'+shader.fragmentShader;
 shader.fragmentShader=shader.fragmentShader.replace('#include <map_fragment>',[
 '#include <map_fragment>',
 'vec4 bookID=texture2D(ofBookMask,vUv);',
 'float seed=bookID.r*255.0;',
 'float pace=mod(floor(seed),4.0)<1.0?3.0+mod(seed*0.173,3.0):8.0+mod(seed*0.731,14.0);',
 'float phase=ofMagicTime*6.283185/pace+seed*2.399;',
 'float blend=0.5+0.5*sin(phase);blend=blend*blend*(3.0-2.0*blend);',
 'float pick=mod(floor(seed),6.0);',
 'vec3 hue=vec3(0.60,0.045,0.12);',
 'if(pick>0.5)hue=vec3(0.015,0.48,0.30);',
 'if(pick>1.5)hue=vec3(0.06,0.16,0.72);',
 'if(pick>2.5)hue=vec3(0.45,0.055,0.62);',
 'if(pick>3.5)hue=vec3(0.68,0.40,0.035);',
 'if(pick>4.5)hue=vec3(0.68,0.09,0.35);',
 'float lum=dot(diffuseColor.rgb,vec3(0.2126,0.7152,0.0722));',
 'float chroma=max(max(diffuseColor.r,diffuseColor.g),diffuseColor.b)-min(min(diffuseColor.r,diffuseColor.g),diffuseColor.b);',
 'vec3 magic=hue*lum*1.3/max(0.01,dot(hue,vec3(0.2126,0.7152,0.0722)));',
 'diffuseColor.rgb=mix(diffuseColor.rgb,magic,bookID.a*blend*smoothstep(0.01,0.05,chroma));'
 ].join('\n'));
};
ofDisplay.material.customProgramCacheKey=function(){return 'of-magic-books-2';};
// Register the mask with the room's normal texture disposal.
ofDisplay.material.userData.dssBookMask=ofBookMaskTex;
