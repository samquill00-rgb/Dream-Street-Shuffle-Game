  cx.fillStyle = g; cx.fillRect(0, 0, w, h);
  var st = cx.createLinearGradient(0, h*0.3, 0, h);
  st.addColorStop(0, 'rgba(240,140,50,0.3)');
  st.addColorStop(1, 'rgba(232,120,24,0)');
  cx.fillStyle = st; cx.fillRect(w*0.36, h*0.3, w*0.28, h*0.7);
});
var glGlint = new THREE.Mesh(new THREE.PlaneGeometry(1.1, 1.7),
  new THREE.MeshBasicMaterial({ map: glGlintTex, transparent: true, opacity: 0.22, blending: THREE.AdditiveBlending, depthWrite: false, fog: false }));
