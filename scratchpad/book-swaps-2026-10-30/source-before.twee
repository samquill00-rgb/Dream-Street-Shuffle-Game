    placeMesh(rightBuilding, new THREE.SphereGeometry(0.11, 10, 8), new THREE.MeshBasicMaterial({ color: 0xff6a40 }), wx, 2.55, -0.25);
    [1.0, 1.7].forEach(function(sy, si) {
