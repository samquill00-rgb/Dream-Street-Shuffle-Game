  if (anyRoom && window.dssKeyPopup) setTimeout(function() { window.dssKeyPopup(); }, 300);
  if (!anyRoom && where === 'build') {
    // 2026-10-25: the chippy now has choices outside. A graphics failure must
    // leave BEVAN / waiting accessible instead of automatically entering.
    if (document.querySelector('.bevan-chippy-choices')) {
      var chippyOutside = document.getElementById('fc-container');
      if (chippyOutside) chippyOutside.remove();
      return;
    }
    // an exterior scene: go on through its door, as its own button would
    var links = document.querySelectorAll('tw-passage tw-link');
    for (var k = 0; k < links.length; k++) { if (links[k].textContent.trim() === '\u00b7') { try { links[k].click(); } catch (e) {} break; } }
  }
};
(function() {
  var harlowe = window.onerror;
  window.onerror = function(msg, src, line, col, err) {
    var stack = (err && err.stack) || '';
    if (/__HarloweEval|harlowe-crash/.test(stack)) { return typeof harlowe === 'function' ? harlowe.apply(this, arguments) : false; }
    try { console.error('DSS: uncaught error kept off the page', err || msg, src ? src + ':' + line + ':' + col : ''); } catch (e) {}
    return true;
  };
})();
// Scenes load three.min.js lazily from 32 places, so catch THREE as it lands
// rather than editing each loader: three assigns globalThis.THREE = {} and
// then fills it, so the guard runs on the microtask after that script ends.
(function() {
  if (typeof THREE !== 'undefined') { window.dssGuardThree(THREE); return; }
  var held;
  try {
    Object.defineProperty(window, 'THREE', {
      configurable: true, enumerable: true,
      get: function() { return held; },
      set: function(v) {
        held = v;
        Promise.resolve().then(function() { window.dssGuardThree(held); });
      }
    });
  } catch(e) {}
})();
// ---------- FIRST-LOAD LINE (2026-10-05) ----------
// The first 3D scene of a night fetches three.min.js and ten effect scripts
// uncached; on a slow line that is seconds of dark page, which reads as broken.
// Watches for those script tags as any of the 32 loaders appends them and
// shows one pink line with a thin hairline that fills as the scripts land.
// Cached loads finish inside the 350 ms grace and never show it.
(function() {
  var ROOM_IDS = ['fi','ci','pi','ri','cu','cb','ti','lk','cf','oi'];
  var pending = 0, seen = 0, ahead = 0, el = null, showTimer = null;
  function build() {
    if (el) return el;
    el = document.createElement('div'); el.id = 'dss-load-line'; el.setAttribute('aria-hidden', 'true');
    el.innerHTML = '<div class="dss-load-text">loading</div><div class="dss-load-bar"><i></i></div>';
    document.body.appendChild(el); return el;
  }
  function paint() {
    if (!el) return;
    var total = seen + pending + ahead, i = el.querySelector('.dss-load-bar i');
    if (i) i.style.width = (total ? Math.round(100 * seen / total) : 0) + '%';
    // a venue room carries its own pink cue; keep only the hairline there
    var room = ROOM_IDS.some(function(id) { return document.querySelector('tw-passage #' + id + '-container') && !document.getElementById(id + '-wrap'); });
    el.classList.toggle('dss-load-bar-only', !!room);
  }
  function show() {
    if (showTimer || (el && el.classList.contains('on'))) return;
    showTimer = setTimeout(function() { showTimer = null; if (!pending) return; build(); paint(); el.classList.add('on'); }, 350);
  }
  function hide() {
    if (showTimer) { clearTimeout(showTimer); showTimer = null; }
    if (!el) return; paint(); el.classList.remove('on');
  }
  function track(s) {
    if (s.__dssLoadLine) return; s.__dssLoadLine = true;
    var isThree = /three\.min\.js/.test(s.src);
    pending++;
    if (isThree) ahead = (window.dssPostScriptURLs || []).length || 10; else if (ahead > 0) ahead--;
    show(); paint();
    var did = false;
    var done = function() { if (did) return; did = true; pending--; seen++; if (pending <= 0) { pending = 0; ahead = 0; hide(); } else paint(); };
    s.addEventListener('load', done); s.addEventListener('error', done);
    setTimeout(function() { if (!did && !s.isConnected) done(); }, 30000);
  }
  function scan(nodes) {
    for (var k = 0; k < nodes.length; k++) {
      var n = nodes[k];
      if (n.nodeType !== 1) continue;
      if (n.tagName === 'SCRIPT' && /vendor\/three\//.test(n.getAttribute('src') || '')) track(n);
    }
  }
  try {
    new MutationObserver(function(ms) { for (var j = 0; j < ms.length; j++) scan(ms[j].addedNodes); })
      .observe(document.documentElement, { childList: true, subtree: true });
  } catch(e) {}
