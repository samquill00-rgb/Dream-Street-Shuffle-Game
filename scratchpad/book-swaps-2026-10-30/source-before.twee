      var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ac.sampleRate * 0.04));
      var src = ac.createBufferSource(); src.buffer = buf;
      var f = ac.createBiquadFilter(); f.type = 'lowpass'; f.frequency.value = 600;
      var ng = ac.createGain(); ng.gain.value = 0.18;
      src.connect(f); f.connect(ng); ng.connect(ac.destination);
      src.start(now);
    });
  }
  // Punch impact — sharp, fleshy thud when a punch lands.
  function punchImpact() {
    _play(function(ac) {
      var now = ac.currentTime;
      // Low transient
      var o = ac.createOscillator(); o.type = 'sine';
      o.frequency.setValueAtTime(160, now);
      o.frequency.exponentialRampToValueAtTime(45, now + 0.15);
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.50, now + 0.005);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.20);
      o.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(now + 0.22);
      // Bright snap layer (skin/bone slap)
      var bufLen = Math.floor(ac.sampleRate * 0.06);
      var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ac.sampleRate * 0.012));
      var src = ac.createBufferSource(); src.buffer = buf;
      var f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 1800; f.Q.value = 1.0;
      var ng = ac.createGain(); ng.gain.value = 0.3;
      src.connect(f); f.connect(ng); ng.connect(ac.destination);
      src.start(now);
    });
  }
  // Vial clink — daintier than glassClink, three high partials, longer decay.
  // Camera shutter — mechanical SLR snap. Two phases: open (sharp, brighter
  // burst) then close ~80ms later (slightly heavier, lower). A faint
  // mid-thunk underneath gives the mirror its body. Used when the napkin
  // portrait is captured at the Sketch the Painter passage.
  function cameraShutter() {
    _play(function(ac) {
      var now = ac.currentTime;
      function clack(t0, dur, freq, q, gain) {
        var bufLen = Math.floor(ac.sampleRate * dur);
        var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
        var d = buf.getChannelData(0);
        for (var i = 0; i < bufLen; i++) {
          var env = Math.exp(-i / (ac.sampleRate * (dur * 0.22)));
          d[i] = (Math.random() * 2 - 1) * env;
        }
        var src = ac.createBufferSource(); src.buffer = buf;
        var f = ac.createBiquadFilter(); f.type = 'bandpass';
        f.frequency.value = freq; f.Q.value = q;
        var g = ac.createGain(); g.gain.value = gain;
        src.connect(f); f.connect(g); g.connect(ac.destination);
        src.start(t0);
      }
      function thunk(t0, freq, gain) {
        var o = ac.createOscillator(); o.type = 'triangle';
        o.frequency.setValueAtTime(freq, t0);
        o.frequency.exponentialRampToValueAtTime(freq * 0.55, t0 + 0.06);
        var g = ac.createGain();
        g.gain.setValueAtTime(0, t0);
        g.gain.linearRampToValueAtTime(gain, t0 + 0.004);
        g.gain.exponentialRampToValueAtTime(0.001, t0 + 0.07);
        o.connect(g); g.connect(ac.destination);
        o.start(t0); o.stop(t0 + 0.09);
      }
      // Phase 1 — shutter open: brighter, shorter
      clack(now, 0.030, 4200, 4.5, 0.55);
      thunk(now, 180, 0.14);
      // Phase 2 — shutter close: heavier, lower, slight delay
      clack(now + 0.085, 0.050, 2600, 3.5, 0.60);
      thunk(now + 0.085, 130, 0.18);
    });
  }
  function vialClink() {
    _play(function(ac) {
      var now = ac.currentTime;
      [5800, 4200, 2900].forEach(function(freq, i) {
        var o = ac.createOscillator(); o.type = 'sine';
        o.frequency.setValueAtTime(freq, now);
        o.frequency.exponentialRampToValueAtTime(freq * 0.92, now + 0.65);
        var g = ac.createGain();
        var amp = [0.055, 0.04, 0.03][i];
        g.gain.setValueAtTime(0, now);
        g.gain.linearRampToValueAtTime(amp, now + 0.005);
        g.gain.exponentialRampToValueAtTime(0.001, now + 0.65);
        o.connect(g); g.connect(ac.destination);
        o.start(now); o.stop(now + 0.70);
      });
    });
  }
  // Uncork — wet pop with a quick rising chirp.
  function uncork() {
    _play(function(ac) {
      var now = ac.currentTime;
      // Pop transient
      var bufLen = Math.floor(ac.sampleRate * 0.08);
      var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ac.sampleRate * 0.008));
      var src = ac.createBufferSource(); src.buffer = buf;
      var f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 700; f.Q.value = 3;
      var g = ac.createGain(); g.gain.value = 0.40;
      src.connect(f); f.connect(g); g.connect(ac.destination);
      src.start(now);
      // Rising chirp (cork escaping bottle)
      var o = ac.createOscillator(); o.type = 'sine';
      o.frequency.setValueAtTime(220, now);
      o.frequency.exponentialRampToValueAtTime(680, now + 0.05);
      var og = ac.createGain();
      og.gain.setValueAtTime(0, now);
      og.gain.linearRampToValueAtTime(0.16, now + 0.005);
      og.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
      o.connect(og); og.connect(ac.destination);
      o.start(now); o.stop(now + 0.10);
    });
  }
  // Uncanny breath — a slow, breathy exhalation as if something close is
  // exhaling near you. Used when the Fetch (your double) appears.
  function uncannyBreath() {
    _play(function(ac) {
      var now = ac.currentTime;
      var dur = 1.6;
      // Filtered breath noise
      var bufLen = Math.floor(ac.sampleRate * dur);
      var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) {
        var p = i / bufLen;
        // Slow attack, hold, slow release
        var env = Math.min(1, p * 4) * Math.min(1, (1 - p) * 3);
        d[i] = (Math.random() * 2 - 1) * env;
      }
      var src = ac.createBufferSource(); src.buffer = buf;
      var f = ac.createBiquadFilter();
      f.type = 'bandpass';
      f.frequency.setValueAtTime(700, now);
      f.frequency.exponentialRampToValueAtTime(1500, now + dur * 0.5);
      f.frequency.exponentialRampToValueAtTime(550, now + dur);
      f.Q.value = 2.0;
      var g = ac.createGain(); g.gain.value = 0.16;
      src.connect(f); f.connect(g); g.connect(ac.destination);
      src.start(now);
      // A faint low pitch underneath — the suggestion of voice
      var o = ac.createOscillator(); o.type = 'sine';
      o.frequency.setValueAtTime(135, now);
      o.frequency.exponentialRampToValueAtTime(105, now + dur);
      var og = ac.createGain();
      og.gain.setValueAtTime(0, now);
      og.gain.linearRampToValueAtTime(0.022, now + 0.5);
      og.gain.exponentialRampToValueAtTime(0.001, now + dur);
      o.connect(og); og.connect(ac.destination);
      o.start(now); o.stop(now + dur);
    });
  }
  // Distant bell — a single far-off church bell. Inharmonic partials and
  // a long decay give it that "across the city" quality.
  // ====== BIRDSONG (2026-09-14) ======
  // Sam: "add more and more birdsong noises as the night goes on but as you
  // approach the dawn really ramp it up." One chirp is a short run of syllables
  // — a sine swept up and back, two to four times, each a little different — and
  // the chorus is built by how OFTEN they come and how many voices overlap, not
  // by making any one of them louder. Silence at dusk, a lone bird in the small
  // hours, a wall of them at first light.
  function chirp(level, far) {
    _play(function(ac) {
      var now = ac.currentTime;
      var bright = Math.max(0.25, Math.min(1, level));
      var o = ac.createOscillator(); o.type = 'sine';
      var g = ac.createGain();
      var lp = ac.createBiquadFilter(); lp.type = 'lowpass';
      lp.frequency.value = far ? 3200 : 7000;   // distance takes the top off
      var base = 2100 + Math.random() * 1900;
      var syll = 2 + Math.floor(Math.random() * 3);
      var t = now;
      g.gain.setValueAtTime(0.0001, now);
      for (var i = 0; i < syll; i++) {
        var d  = 0.042 + Math.random() * 0.05;
        var f1 = base * (0.82 + Math.random() * 0.45);
        var f2 = f1 * (1.28 + Math.random() * 0.55);
        o.frequency.setValueAtTime(f1, t);
        o.frequency.exponentialRampToValueAtTime(f2, t + d * 0.45);
        o.frequency.exponentialRampToValueAtTime(f1 * 0.88, t + d);
        g.gain.setValueAtTime(0.0001, t);
        g.gain.exponentialRampToValueAtTime((far ? 0.006 : 0.013) * bright, t + 0.007);
        g.gain.exponentialRampToValueAtTime(0.0001, t + d);
        t += d + 0.012 + Math.random() * 0.035;
      }
      o.connect(lp); lp.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(t + 0.06);
    });
  }
  // The scheduler reads the night's depth every time it fires and re-times
  // itself, so the chorus thickens on its own as the night deepens. It only
  // sings where you could hear it: outdoors, on the street, or at the dawn.
  var _birdTimer = null, _birdBoost = 0, _birdBoostGen = -1;
  // The boost belongs to the passage that asked for it. Without this it would
  // stick, and the dawn chorus would follow you back into Soho for ever.
  function setBirdLevel(x) {
    _birdBoost = Math.max(0, Math.min(1, x || 0));
    _birdBoostGen = (window._passageGen || 0);
  }
  function _outdoors() {
    var st = document.querySelector('tw-story');
    var tags = st ? (st.getAttribute('tags') || '') : '';
    return /(^|\s)(hub|outdoor|street-night|dawn-approach|dawn)(\s|$)/.test(tags);
  }
  // Which of the four night phases we are in: 0 Before midnight, 1 After
  // midnight, 2 Small hours, 3 Dawn awaits. Read off the header rather than
  // taken from __dssNightDepth, which only updates while the Soho map is being
  // drawn; the window value is the fallback when the header is not on the page.
  function _nightPhase() {
    var el = document.querySelector('.night-phase[data-night-phase]');
    var n = el ? Number(el.getAttribute('data-night-phase')) : NaN;
    if (!isFinite(n)) n = (window.__dssNightDepth || 0) * 3;
    return Math.max(0, Math.min(3, n));
  }
  function _birdTick() {
    if (_birdBoost > 0 && (window._passageGen || 0) !== _birdBoostGen) _birdBoost = 0;
    // Sam, 2026-09-14: "The birds start chirping much too early. No chirping
    // till the final part of the night then much more as you approach the end."
    // Nothing at all before Dawn awaits. The old curve ran off phase/3, which
    // put the odd bird into After midnight and something close to a chorus into
    // the Small hours. The last phase opens with the occasional far bird, about
    // one every twelve seconds, and the dawn passages take it up from there
    // through their own boosts: 0.55 Towards Dawn, 0.85 at the approach, 1.0 at
    // the Dawn itself.
    var depth = _nightPhase() >= 3 ? 0.35 : 0;
    var level = Math.max(depth, _birdBoost);
    var wait;
    if (!_outdoors() || level <= 0.02) {
      wait = 4000;                                   // indoors, or too early: listen again later
    } else {
      // Steeply weighted to the end, because that is how it actually goes: one
      // far bird every twenty seconds or so after midnight, a chorus building
      // through the small hours, and the sky full of them at first light. A
      // gentler curve put a bird a second into 1am, which is nobody's Soho.
      var rate = 6.5 * Math.pow(level, 4.2);         // chirps per second
      wait = Math.max(90, (1000 / rate) * (0.55 + Math.random() * 0.9));
      var far = Math.random() > (0.25 + level * 0.6);
      chirp(0.35 + level * 0.65, far);
      // at the top end they overlap, which is what makes a chorus a chorus
      if (level > 0.6 && Math.random() < (level - 0.6) * 2.2) {
        setTimeout(function() { chirp(0.3 + level * 0.6, Math.random() > 0.5); },
                   40 + Math.random() * 200);
      }
    }
    _birdTimer = setTimeout(_birdTick, wait);
  }
  // BIRDSONG CUT 2026-10-07 (Sam: "Cut all the birdsong. I'll put it back
  // later much more precisely"). The scheduler that fired the chirps is no
  // longer started, so no bird sings anywhere: not on the outdoor streets in
  // the Dawn awaits phase, not at Towards Dawn, the Dawn Approach pages or the
  // Dawn. chirp() and setBirdLevel() are kept so the old calls are harmless.
  // To restore, put this line back:
  //   if (typeof document !== 'undefined') { _birdTimer = setTimeout(_birdTick, 2500); }

  function distantBell() {
    _play(function(ac) {
      var now = ac.currentTime;
      // A BELL, NOT A GONG (2026-09-14, Sam: "can be improved. More of a bell?").
      // The old version was four near-harmonic sines with a 20ms fade-in, which
      // is the recipe for a hum. What makes the ear say "bell" is three things,
      // all of them here now: partials at INHARMONIC ratios — above all the
      // tierce, a minor third over the prime, which is the sound's signature;
      // a different decay rate for each, the hum ringing on long after the top
      // has gone; and a strike, because a bell is hit rather than faded up.
      var f = 440;
      var partials = [
        { r: 0.50, amp: 0.030, dur: 5.6, det:  0.0 },  // hum
        { r: 1.00, amp: 0.034, dur: 4.4, det:  0.4 },  // prime
        { r: 1.20, amp: 0.024, dur: 3.2, det: -0.6 },  // tierce — the minor third
        { r: 1.50, amp: 0.014, dur: 2.4, det:  0.5 },  // quint
        { r: 2.00, amp: 0.020, dur: 2.0, det:  0.0 },  // nominal
        { r: 2.55, amp: 0.010, dur: 1.1, det:  0.8 },
        { r: 3.10, amp: 0.007, dur: 0.8, det: -0.7 },
        { r: 4.25, amp: 0.004, dur: 0.5, det:  0.0 }
      ];
      var dur = 5.6;
      partials.forEach(function(p) {
        var o = ac.createOscillator(); o.type = 'sine';
        o.frequency.value = f * p.r + p.det;   // the detune sets the partials beating
        var g = ac.createGain();
        g.gain.setValueAtTime(0, now);
        g.gain.linearRampToValueAtTime(p.amp, now + 0.006);
        g.gain.exponentialRampToValueAtTime(0.0008, now + p.dur);
        o.connect(g); g.connect(ac.destination);
        o.start(now); o.stop(now + p.dur + 0.05);
      });
      // the clapper
      try {
        var nb = ac.createBuffer(1, Math.floor(ac.sampleRate * 0.06), ac.sampleRate);
        var chd = nb.getChannelData(0);
        for (var ni = 0; ni < chd.length; ni++) chd[ni] = (Math.random() * 2 - 1) * (1 - ni / chd.length);
        var nsrc = ac.createBufferSource(); nsrc.buffer = nb;
        var nbp = ac.createBiquadFilter(); nbp.type = 'bandpass';
        nbp.frequency.value = f * 2.6; nbp.Q.value = 1.1;
        var ng = ac.createGain();
        ng.gain.setValueAtTime(0.016, now);
        ng.gain.exponentialRampToValueAtTime(0.0004, now + 0.12);
        nsrc.connect(nbp); nbp.connect(ng); ng.connect(ac.destination);
        nsrc.start(now); nsrc.stop(now + 0.09);
      } catch(e) {}
    });
  }
  // Phone line — a faint, looping carrier hum/crackle for under call dialogue.
  // Bandpass-filtered noise around the telephone band, with a slow LFO
  // wobbling the filter frequency for a tape-like crackle.
  var _phoneLineNodes = [];
  function stopPhoneLine() {
    _phoneLineNodes.forEach(function(node) {
      try { if (node.stop) node.stop(); } catch(e) {}
      try { node.disconnect(); } catch(e) {}
    });
    _phoneLineNodes = [];
  }
  function phoneLine() {
    stopPhoneLine();
    _play(function(ac) {
      var now = ac.currentTime;
      var dur = 4.0;
      var bufLen = Math.floor(ac.sampleRate * dur);
      var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1) * 0.55;
      var src = ac.createBufferSource(); src.buffer = buf; src.loop = true;
      var f = ac.createBiquadFilter();
      f.type = 'bandpass';
      f.frequency.value = 1800;
      f.Q.value = 4.0;
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.045, now + 1.2); // gentle fade-in
      // Slow LFO on filter freq — gives the line a soft, breathing crackle
      var lfo = ac.createOscillator(); lfo.type = 'sine';
      lfo.frequency.value = 0.13;
      var lfoG = ac.createGain(); lfoG.gain.value = 220;
      lfo.connect(lfoG); lfoG.connect(f.frequency);
      lfo.start(now);
      src.connect(f); f.connect(g); g.connect(ac.destination);
      src.start(now);
      _phoneLineNodes.push(src);
      _phoneLineNodes.push(lfo);
    });
  }
  // Hoof beat — a single clop. Short, low, with a cloth-on-ground noise.
  function hoofBeat() {
    _play(function(ac) {
      var now = ac.currentTime;
      // Low body — pitch drops fast
      var o = ac.createOscillator(); o.type = 'sine';
      o.frequency.setValueAtTime(180, now);
      o.frequency.exponentialRampToValueAtTime(70, now + 0.08);
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.22, now + 0.005);
      g.gain.exponentialRampToValueAtTime(0.001, now + 0.10);
      o.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(now + 0.12);
      // Light noise scuff
      var bufLen = Math.floor(ac.sampleRate * 0.05);
      var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ac.sampleRate * 0.018));
      var src = ac.createBufferSource(); src.buffer = buf;
      var f = ac.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 600; f.Q.value = 1.5;
      var ng = ac.createGain(); ng.gain.value = 0.10;
      src.connect(f); f.connect(ng); ng.connect(ac.destination);
      src.start(now);
    });
  }
  // Cow moo — long, throaty, descending pitch with vibrato.
  // Short swerve moo (2026-09-13, Sam: the cow should moo when it moves left or
  // right instead of the whoosh it had). Deliberately NOT cowMoo: that one runs
  // 1.2s and is already the every-5-to-12-second ambience, so firing it on a
  // 90ms-throttled swerve would pile up. This is the same animal, clipped.
  function cowMooShort() {
    _play(function(ac) {
      var now = ac.currentTime;
      var dur = 0.34;
      var vary = 0.93 + Math.random() * 0.16;
      var o = ac.createOscillator(); o.type = 'sawtooth';
      o.frequency.setValueAtTime(205 * vary, now);
      o.frequency.linearRampToValueAtTime(178 * vary, now + 0.12);
      o.frequency.linearRampToValueAtTime(150 * vary, now + dur);
      var vib = ac.createOscillator(); vib.type = 'sine';
      vib.frequency.value = 7;
      var vibG = ac.createGain(); vibG.gain.value = 3.5;
      vib.connect(vibG); vibG.connect(o.frequency);
      vib.start(now); vib.stop(now + dur);
      var f = ac.createBiquadFilter(); f.type = 'lowpass';
      f.frequency.value = 820; f.Q.value = 0.8;
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.075, now + 0.035);
      g.gain.linearRampToValueAtTime(0.055, now + 0.16);
      g.gain.exponentialRampToValueAtTime(0.001, now + dur);
      o.connect(f); f.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(now + dur + 0.02);
    });
  }
  function cowMoo() {
    _play(function(ac) {
      var now = ac.currentTime;
      var dur = 1.2;
      // Main pitch — low oscillator with descending slide
      var o = ac.createOscillator(); o.type = 'sawtooth';
      o.frequency.setValueAtTime(190, now);
      o.frequency.linearRampToValueAtTime(165, now + 0.25);
      o.frequency.linearRampToValueAtTime(155, now + 0.7);
      o.frequency.linearRampToValueAtTime(120, now + dur);
      // Slight vibrato — throaty
      var vib = ac.createOscillator(); vib.type = 'sine';
      vib.frequency.value = 6;
      var vibG = ac.createGain(); vibG.gain.value = 4;
      vib.connect(vibG); vibG.connect(o.frequency);
      vib.start(now); vib.stop(now + dur);
      var f = ac.createBiquadFilter(); f.type = 'lowpass';
      f.frequency.value = 750; f.Q.value = 0.8;
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.10, now + 0.18);
      g.gain.linearRampToValueAtTime(0.085, now + 0.6);
      g.gain.exponentialRampToValueAtTime(0.001, now + dur);
      o.connect(f); f.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(now + dur);
    });
  }
  // Thunder clap — distant rumble building to a crack, with a long tail.
  // Modelled as: low rumble (filtered noise) + sharp transient + long roll.
  function thunderClap() {
    _play(function(ac) {
      var now = ac.currentTime;
      var dur = 2.6;
      // Low rumble — lowpass-filtered noise, swells then fades
      var bufLen = Math.floor(ac.sampleRate * dur);
      var buf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) d[i] = (Math.random() * 2 - 1);
      var src = ac.createBufferSource(); src.buffer = buf;
      var f = ac.createBiquadFilter(); f.type = 'lowpass';
      f.frequency.setValueAtTime(180, now);
      f.frequency.linearRampToValueAtTime(120, now + dur);
      f.Q.value = 0.7;
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.32, now + 0.18);   // build
      g.gain.linearRampToValueAtTime(0.55, now + 0.30);   // crack peak
      g.gain.exponentialRampToValueAtTime(0.001, now + dur); // long roll
      src.connect(f); f.connect(g); g.connect(ac.destination);
      src.start(now);
      // Sharp crack transient at the peak
      var cLen = Math.floor(ac.sampleRate * 0.08);
      var cBuf = ac.createBuffer(1, cLen, ac.sampleRate);
      var cD = cBuf.getChannelData(0);
      for (var k = 0; k < cLen; k++) cD[k] = (Math.random() * 2 - 1) * Math.exp(-k / (ac.sampleRate * 0.012));
      var cSrc = ac.createBufferSource(); cSrc.buffer = cBuf;
      var cF = ac.createBiquadFilter(); cF.type = 'bandpass'; cF.frequency.value = 1400; cF.Q.value = 1.2;
      var cG = ac.createGain(); cG.gain.value = 0.42;
      cSrc.connect(cF); cF.connect(cG); cG.connect(ac.destination);
      cSrc.start(now + 0.28);
    });
  }
  // Door knock — knuckles on a heavy cellar door. Times defaults to 3.
  // REBUILT 2026-09-12 (Sam: "it doesn't sound like a knock at all"). The old
  // one was a 5ms noise burst bandpassed hard at 380Hz plus a single sine, so
  // everything above 400Hz was thrown away and it read as a tick, not a rap.
  // What actually makes a knock legible:
  //   1. a broadband knuckle crack with real HF in it, rolled off at the top so
  //      it is wood and not a stick on tile;
  //   2. the panel answering on SEVERAL modes at once, not one sine, the lowest
  //      hanging longest;
  //   3. a short thud through the frame, felt more than heard;
  //   4. a little of the stairwell behind it, because this door is below ground;
  //   5. per-rap variation, so three raps are not one rap three times.
  function doorKnock(times) {
    times = times || 3;
    _play(function(ac) {
      var now = ac.currentTime;
      for (var k = 0; k < times; k++) {
        var t = now + k * 0.19;
        var vary = 0.92 + Math.random() * 0.16;   // pitch/weight of this rap
        var hit  = 0.88 + Math.random() * 0.24;   // how hard it landed

        // 1. The knuckle itself: a very short crack, band-limited to wood.
        var nLen = Math.floor(ac.sampleRate * 0.06);
        var nb = ac.createBuffer(1, nLen, ac.sampleRate);
        var nd = nb.getChannelData(0);
        for (var i = 0; i < nLen; i++) {
          nd[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ac.sampleRate * 0.0038));
        }
        var nsrc = ac.createBufferSource(); nsrc.buffer = nb;
        var lp = ac.createBiquadFilter(); lp.type = 'lowpass';
        lp.frequency.value = 2700 * vary; lp.Q.value = 0.6;
        var hp = ac.createBiquadFilter(); hp.type = 'highpass'; hp.frequency.value = 200;
        var ng = ac.createGain(); ng.gain.value = 0.34 * hit;
        nsrc.connect(lp); lp.connect(hp); hp.connect(ng); ng.connect(ac.destination);
        nsrc.start(t);

        // 2. The panel: three modes, the low one hanging longest.
        var modes = [[94, 0.24, 0.30], [151, 0.15, 0.18], [237, 0.085, 0.12]];
        for (var m = 0; m < modes.length; m++) {
          var f0 = modes[m][0] * vary, amp = modes[m][1] * hit, dur = modes[m][2];
          var o = ac.createOscillator(); o.type = 'sine';
          o.frequency.setValueAtTime(f0 * 1.07, t);
          o.frequency.exponentialRampToValueAtTime(f0, t + 0.045);
          var og = ac.createGain();
          og.gain.setValueAtTime(0.0001, t);
          og.gain.linearRampToValueAtTime(amp, t + 0.004);
          og.gain.exponentialRampToValueAtTime(0.0008, t + dur);
          o.connect(og); og.connect(ac.destination);
          o.start(t); o.stop(t + dur + 0.03);
        }

        // 3. The frame taking it: a short low thud under everything.
        var th = ac.createOscillator(); th.type = 'sine';
        th.frequency.setValueAtTime(62 * vary, t);
        th.frequency.exponentialRampToValueAtTime(44 * vary, t + 0.09);
        var thg = ac.createGain();
        thg.gain.setValueAtTime(0.0001, t);
        thg.gain.linearRampToValueAtTime(0.20 * hit, t + 0.006);
        thg.gain.exponentialRampToValueAtTime(0.0008, t + 0.13);
        th.connect(thg); thg.connect(ac.destination);
        th.start(t); th.stop(t + 0.15);

        // 4. The stairwell behind the door: a quiet filtered tail so the rap
        //    sounds like it is landing on something with a cellar behind it.
        var rLen = Math.floor(ac.sampleRate * 0.28);
        var rb = ac.createBuffer(1, rLen, ac.sampleRate);
        var rd = rb.getChannelData(0);
        for (var j = 0; j < rLen; j++) {
          rd[j] = (Math.random() * 2 - 1) * Math.exp(-j / (ac.sampleRate * 0.075));
        }
        var rsrc = ac.createBufferSource(); rsrc.buffer = rb;
        var rf = ac.createBiquadFilter(); rf.type = 'bandpass';
        rf.frequency.value = 430 * vary; rf.Q.value = 1.1;
        var rg = ac.createGain(); rg.gain.value = 0.055 * hit;
        rsrc.connect(rf); rf.connect(rg); rg.connect(ac.destination);
        rsrc.start(t + 0.012);
      }
    });
  }
  // Lily chime — held string-harmonic note that swells and fades.
  // Played when the player clicks one of the lily-flower glimpses.
  // Pitched an octave down from the original (E6 → E5) so it reads as
  // warmer, less treble-piercing — same shape, lower register.
  // Brief upward arpeggio — fires when a password is correctly deployed.
  // Three quick sine pings rising through a major triad, with a shimmer
  // octave on top of the last note. Warm, small, not triumphant.
  function passwordSuccess() {
    _play(function(ac) {
      var now = ac.currentTime;
      var notes = [
        { f: 587.33, t: 0.00, dur: 0.55, amp: 0.075 }, // D5
        { f: 739.99, t: 0.09, dur: 0.55, amp: 0.075 }, // F#5
        { f: 880.00, t: 0.18, dur: 0.75, amp: 0.085 }  // A5
      ];
      notes.forEach(function(n) {
        var o = ac.createOscillator(); o.type = 'sine';
        o.frequency.value = n.f;
        var g = ac.createGain();
        g.gain.setValueAtTime(0, now + n.t);
        g.gain.linearRampToValueAtTime(n.amp, now + n.t + 0.02);
        g.gain.linearRampToValueAtTime(n.amp * 0.7, now + n.t + 0.18);
        g.gain.exponentialRampToValueAtTime(0.001, now + n.t + n.dur);
        o.connect(g); g.connect(ac.destination);
        o.start(now + n.t); o.stop(now + n.t + n.dur + 0.05);
      });
      // Shimmer one octave above the final note
      var sh = ac.createOscillator(); sh.type = 'sine';
      sh.frequency.value = 1760;
      var shG = ac.createGain();
      shG.gain.setValueAtTime(0, now + 0.18);
      shG.gain.linearRampToValueAtTime(0.035, now + 0.26);
      shG.gain.exponentialRampToValueAtTime(0.001, now + 0.95);
      sh.connect(shG); shG.connect(ac.destination);
      sh.start(now + 0.18); sh.stop(now + 1.0);
    });
  }
  function lilyChime() {
    _play(function(ac) {
      var now = ac.currentTime;
      var dur = 2.4;
      // Main tone — sine, harmonic-like
      var o = ac.createOscillator(); o.type = 'sine';
      o.frequency.value = 659; // E5 — warm, ringing (was 1318 / E6)
      // Subtle vibrato (~5 Hz, very small depth) — kicks in mid-swell
      var vib = ac.createOscillator(); vib.type = 'sine';
      vib.frequency.value = 5;
      var vibG = ac.createGain(); vibG.gain.value = 2.0;
      vib.connect(vibG); vibG.connect(o.frequency);
      vib.start(now + 0.4); vib.stop(now + dur);
      // Slow swell + slow fade
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.07, now + 0.5);   // slow swell
      g.gain.linearRampToValueAtTime(0.06, now + 1.0);   // brief hold
      g.gain.exponentialRampToValueAtTime(0.001, now + dur);
      o.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(now + dur + 0.05);
      // A faint shimmer one octave up of the new fundamental, softer
      var o2 = ac.createOscillator(); o2.type = 'sine';
      o2.frequency.value = 988; // ~B5 (was 1976 / B6)
      var g2 = ac.createGain();
      g2.gain.setValueAtTime(0, now);
      g2.gain.linearRampToValueAtTime(0.025, now + 0.6);
      g2.gain.exponentialRampToValueAtTime(0.001, now + dur);
      o2.connect(g2); g2.connect(ac.destination);
      o2.start(now + 0.1); o2.stop(now + dur + 0.05);
    });
  }
  // Low, dull "block" thunk — feedback for poking a flower that's already
  // been gathered. Pitched well below lilyChime, short and damped, with no
  // shimmer, so it reads as a soft refusal rather than a collection cue.
  function lilyBlock() {
    _play(function(ac) {
      var now = ac.currentTime;
      var dur = 0.22;
      var o = ac.createOscillator(); o.type = 'triangle';
      o.frequency.setValueAtTime(150, now);
      o.frequency.exponentialRampToValueAtTime(96, now + dur);  // slight downward thunk
      var g = ac.createGain();
      g.gain.setValueAtTime(0.0001, now);
      g.gain.linearRampToValueAtTime(0.09, now + 0.008);        // fast attack
      g.gain.exponentialRampToValueAtTime(0.001, now + dur);    // quick damped decay
      o.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(now + dur + 0.03);
      // Softer sub an octave down for body
      var o2 = ac.createOscillator(); o2.type = 'sine';
      o2.frequency.value = 75;
      var g2 = ac.createGain();
      g2.gain.setValueAtTime(0.0001, now);
      g2.gain.linearRampToValueAtTime(0.05, now + 0.01);
      g2.gain.exponentialRampToValueAtTime(0.001, now + dur * 0.8);
      o2.connect(g2); g2.connect(ac.destination);
      o2.start(now); o2.stop(now + dur);
    });
  }
  // Bright chord — a single sparkling celesta-like note plucked from a
  // Cmaj9 cluster, with an octave-up shimmer and a brief triangle tine at
  // the attack. Designed to be called repeatedly (throttled by the caller)
  // so that successive picks accumulate into an evolving chord. Used by the
  // liver-eating popup to give the eagle movement an airy, hymnal sparkle.
  // A quest is the one thing the night hands you that you have to go and do, so
  // it gets its own call instead of the page rustle it used to share with every
  // other popup (Sam, 2026-09-14: "maybe add a sound too. It's important").
  // Three struck notes rising a fifth then an octave, each with a hollow twelfth
  // over it for the strike, and a band of air opening behind them.
  function questCall() {
    _play(function(ac) {
      var now = ac.currentTime;
      var root = 392.0;                                   // G4
      var steps = [[0, 1.0, 0.10], [0.13, 1.5, 0.095], [0.28, 2.0, 0.11]];
      steps.forEach(function(st) {
        var t = now + st[0], f = root * st[1], amp = st[2], dur = 1.5 - st[0];
        var o = ac.createOscillator(); o.type = 'triangle'; o.frequency.value = f;
        var g = ac.createGain();
        g.gain.setValueAtTime(0, t);
        g.gain.linearRampToValueAtTime(amp, t + 0.008);
        g.gain.exponentialRampToValueAtTime(0.001, t + dur);
        o.connect(g); g.connect(ac.destination);
        o.start(t); o.stop(t + dur + 0.05);
        var o2 = ac.createOscillator(); o2.type = 'sine'; o2.frequency.value = f * 3;
        var g2 = ac.createGain();
        g2.gain.setValueAtTime(0, t);
        g2.gain.linearRampToValueAtTime(amp * 0.22, t + 0.004);
        g2.gain.exponentialRampToValueAtTime(0.001, t + 0.28);
        o2.connect(g2); g2.connect(ac.destination);
        o2.start(t); o2.stop(t + 0.32);
      });
      var len = Math.floor(ac.sampleRate * 0.9);
      var buf = ac.createBuffer(1, len, ac.sampleRate), d = buf.getChannelData(0);
      for (var i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / len);
      var src = ac.createBufferSource(); src.buffer = buf;
      var bp = ac.createBiquadFilter(); bp.type = 'bandpass'; bp.Q.value = 0.9;
      bp.frequency.setValueAtTime(900, now);
      bp.frequency.exponentialRampToValueAtTime(2600, now + 0.6);
      var ng = ac.createGain();
      ng.gain.setValueAtTime(0.0001, now);
      ng.gain.exponentialRampToValueAtTime(0.03, now + 0.08);
      ng.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);
      src.connect(bp); bp.connect(ng); ng.connect(ac.destination);
      src.start(now);
    });
  }
  function brightChord() {
    _play(function(ac) {
      var now = ac.currentTime;
      var notes = [1046.5, 1318.5, 1568.0, 1975.5, 2349.3, 2637.0];
      var f = notes[Math.floor(Math.random() * notes.length)];
      var dur = 1.1;
      var o = ac.createOscillator(); o.type = 'sine';
      o.frequency.value = f;
      var g = ac.createGain();
      g.gain.setValueAtTime(0, now);
      g.gain.linearRampToValueAtTime(0.10, now + 0.012);
      g.gain.exponentialRampToValueAtTime(0.001, now + dur);
      o.connect(g); g.connect(ac.destination);
      o.start(now); o.stop(now + dur + 0.05);
      var o2 = ac.createOscillator(); o2.type = 'sine';
      o2.frequency.value = f * 2;
      var g2 = ac.createGain();
      g2.gain.setValueAtTime(0, now);
      g2.gain.linearRampToValueAtTime(0.035, now + 0.018);
      g2.gain.exponentialRampToValueAtTime(0.001, now + dur * 0.7);
      o2.connect(g2); g2.connect(ac.destination);
      o2.start(now); o2.stop(now + dur);
      var o3 = ac.createOscillator(); o3.type = 'triangle';
      o3.frequency.value = f * 1.5;
      var g3 = ac.createGain();
      g3.gain.setValueAtTime(0, now);
      g3.gain.linearRampToValueAtTime(0.04, now + 0.006);
      g3.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
      o3.connect(g3); g3.connect(ac.destination);
      o3.start(now); o3.stop(now + 0.2);
    });
  }
  // 2026-10-19 (Sam, playtest at Approach The French: "the green moth/absinthe fairy should make a sort of twinkling noise ... maybe it
  // changes slightly every visit"): two to four small high bells, quiet, from one of five note sets; the visit number picks the set, so the
  // fairy sounds a little different each time. Called through _tick so the street bed is not ducked.
  // 2026-10-23 (Sam, playtest: "sounds like a checkout or a computer opening; it should sound like an absinthe fairy. THIN: whole tone
  // scale. Debussy."): the struck bells (a sharp attack with a bright clangy partial) went. Now a thin, breathy whole-tone figure, a few
  // notes rising and turning back, each one swelling in softly with a slow flutter, an octave ghost above it and a dim echo behind; the
  // visit picks which of the two whole-tone scales and where in it the figure starts.
  function fairyTwinkle(visit) {
    _play(function(ac) {
      var now = ac.currentTime, v = Math.abs(visit || 0);
      var root = (v % 2 ? 554.37 : 523.25) * (v % 3 === 2 ? 1.122 : 1); /* C or C# whole-tone, sometimes a tone up */
      var scale = []; for (var i = 0; i < 9; i++) scale.push(root * Math.pow(2, (2 * i) / 12));
      var start = v % 3, len = 4 + Math.floor(Math.random() * 3), idx = [];
      for (var k = 0; k < len; k++) idx.push(start + (k < len - 1 ? k : k - 2)); /* up the scale, then a step back down */
      var out = ac.createGain(); out.gain.value = 1;
      var echo = ac.createDelay(1); echo.delayTime.value = 0.27;
      var fb = ac.createGain(); fb.gain.value = 0.32;
      var tone = ac.createBiquadFilter(); tone.type = 'lowpass'; tone.frequency.value = 2600;
      var wet = ac.createGain(); wet.gain.value = 0.45;
      out.connect(ac.destination); out.connect(echo); echo.connect(tone); tone.connect(fb); fb.connect(echo); tone.connect(wet); wet.connect(ac.destination);
      var t = now + 0.02;
      idx.forEach(function(n, k) {
        var f = scale[Math.min(n, scale.length - 1)], dur = 1.1 + Math.random() * 0.5;
        [[f, 0.016, 'sine'], [f * 2, 0.0035, 'sine'], [f * 1.003, 0.006, 'triangle']].forEach(function(p) {
          var o = ac.createOscillator(); o.type = p[2]; o.frequency.value = p[0];
          var lfo = ac.createOscillator(); lfo.frequency.value = 5 + Math.random() * 1.5; var lg = ac.createGain(); lg.gain.value = p[0] * 0.004; lfo.connect(lg); lg.connect(o.frequency);
          var g = ac.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(p[1], t + 0.09); g.gain.setTargetAtTime(0, t + 0.2, dur / 4);
          o.connect(g); g.connect(out); o.start(t); lfo.start(t); o.stop(t + dur + 0.6); lfo.stop(t + dur + 0.6);
        });
        t += 0.16 + Math.random() * 0.07 + (k === len - 2 ? 0.12 : 0);
      });
      setTimeout(function() { try { fb.gain.value = 0; out.disconnect(); } catch (e) {} }, 6000);
    });
  }
  // Vinyl needle lift — the soft "thup" of the cartridge leaving the
  // groove, a brief surface-noise tail, and a few residual surface pops
  // as the needle moves away. Procedural, no sample.
  function needleLift() {
    _play(function(ac) {
      var now = ac.currentTime;
      // ── Thup: short noise burst, mid-low band ──
      var thupLen = Math.floor(ac.sampleRate * 0.08);
      var thupBuf = ac.createBuffer(1, thupLen, ac.sampleRate);
      var td = thupBuf.getChannelData(0);
      for (var i = 0; i < thupLen; i++) {
        var tEnv = Math.exp(-i / (ac.sampleRate * 0.012));
        td[i] = (Math.random() * 2 - 1) * tEnv;
      }
      var thupSrc = ac.createBufferSource(); thupSrc.buffer = thupBuf;
      var thupF = ac.createBiquadFilter(); thupF.type = 'bandpass';
      thupF.frequency.value = 320; thupF.Q.value = 1.2;
      var thupG = ac.createGain(); thupG.gain.value = 0.55;
      thupSrc.connect(thupF); thupF.connect(thupG); thupG.connect(ac.destination);
      thupSrc.start(now);
      // ── Fading vinyl surface hiss tail ──
      var hissLen = Math.floor(ac.sampleRate * 0.42);
      var hissBuf = ac.createBuffer(1, hissLen, ac.sampleRate);
      var hd = hissBuf.getChannelData(0);
      for (var j = 0; j < hissLen; j++) {
        var t = j / ac.sampleRate;
        var fadeIn = Math.min(1, t / 0.02);
        var decay = Math.exp(-t * 5.5);
        hd[j] = (Math.random() * 2 - 1) * fadeIn * decay * 0.18;
      }
      var hissSrc = ac.createBufferSource(); hissSrc.buffer = hissBuf;
      var hissF = ac.createBiquadFilter(); hissF.type = 'highpass';
      hissF.frequency.value = 1200; hissF.Q.value = 0.7;
      hissSrc.connect(hissF); hissF.connect(ac.destination);
      hissSrc.start(now);
      // ── A handful of residual surface pops in the tail ──
      for (var k = 0; k < 3; k++) {
        var t0 = now + 0.04 + Math.random() * 0.25;
        var popLen = Math.floor(ac.sampleRate * 0.008);
        var popBuf = ac.createBuffer(1, popLen, ac.sampleRate);
        var pd = popBuf.getChannelData(0);
        for (var p = 0; p < popLen; p++) {
          var penv = Math.exp(-p / (ac.sampleRate * 0.002));
          pd[p] = (Math.random() * 2 - 1) * penv;
        }
        var popSrc = ac.createBufferSource(); popSrc.buffer = popBuf;
        var popF = ac.createBiquadFilter(); popF.type = 'highpass';
        popF.frequency.value = 2400; popF.Q.value = 1.0;
        var popG = ac.createGain(); popG.gain.value = 0.18 + Math.random() * 0.12;
        popSrc.connect(popF); popF.connect(popG); popG.connect(ac.destination);
        popSrc.start(t0);
      }
    });
  }
  // ── COSMIC SEWER SUCK ──────────────────────────────────────────────
  // Long ~3.5s pipe-rush: filtered noise with a rising lowpass cutoff,
  // a sub rumble that pitches up (we accelerate toward the end of the
  // pipe), three submerged bubble pops scattered through the middle,
  // and a wet splash at the end when the player breaks the surface.
  // A short feedback delay across the whole graph gives it the vault-y
  // "cosmic" depth that distinguishes it from a plain water flush.
  function cosmicSewerSuck() {
    _play(function(ac) {
      var now = ac.currentTime;
      var DUR = 10.0;
      // ── Delay/feedback network — used as a parallel send for the wet,
      //    cathedral-ish tail. Light feedback, gentle highshelf cut so
      //    the tail doesn't get harsh. ──
      var delay = ac.createDelay(); delay.delayTime.value = 0.28;
      var fbk   = ac.createGain();   fbk.gain.value = 0.35;
      var dHpf  = ac.createBiquadFilter(); dHpf.type = 'highpass';
      dHpf.frequency.value = 180;
      var dWet  = ac.createGain();   dWet.gain.value = 0.45;
      delay.connect(dHpf); dHpf.connect(fbk); fbk.connect(delay);
      delay.connect(dWet); dWet.connect(ac.destination);
      // ── 1. Long noise whoosh — main "we are travelling" body. Lowpass
      //    opens as we accelerate; gain swells and tails off at the end. ──
      var bufLen = Math.floor(ac.sampleRate * DUR);
      var nbuf = ac.createBuffer(1, bufLen, ac.sampleRate);
      var nd = nbuf.getChannelData(0);
      for (var i = 0; i < bufLen; i++) nd[i] = (Math.random() * 2 - 1);
      var nSrc = ac.createBufferSource(); nSrc.buffer = nbuf;
      var nLp  = ac.createBiquadFilter(); nLp.type = 'lowpass'; nLp.Q.value = 0.9;
      nLp.frequency.setValueAtTime(320, now);
      nLp.frequency.exponentialRampToValueAtTime(1800, now + 1.3);
      nLp.frequency.exponentialRampToValueAtTime(650, now + 2.4);
      nLp.frequency.exponentialRampToValueAtTime(900, now + 6.0);
      nLp.frequency.exponentialRampToValueAtTime(2400, now + 7.65);
      nLp.frequency.exponentialRampToValueAtTime(4800, now + DUR);
      var nHp = ac.createBiquadFilter(); nHp.type = 'highpass';
      nHp.frequency.setValueAtTime(120, now);
      var nG  = ac.createGain();
      nG.gain.setValueAtTime(0.0001, now);
      nG.gain.exponentialRampToValueAtTime(0.34, now + 1.3);
      nG.gain.exponentialRampToValueAtTime(0.18, now + 2.4);
      nG.gain.exponentialRampToValueAtTime(0.22, now + 6.0);
      nG.gain.exponentialRampToValueAtTime(0.55, now + DUR * 0.85);
      nG.gain.exponentialRampToValueAtTime(0.0001, now + DUR);
      nSrc.connect(nLp); nLp.connect(nHp); nHp.connect(nG);
      nG.connect(ac.destination); nG.connect(delay);
      nSrc.start(now); nSrc.stop(now + DUR + 0.05);
      // ── 2. Sub rumble — low oscillator that pitches up so we feel the
      //    forward acceleration in the gut. Saw wave through a lowpass. ──
      var rOsc = ac.createOscillator(); rOsc.type = 'sawtooth';
      rOsc.frequency.setValueAtTime(34, now);
      rOsc.frequency.exponentialRampToValueAtTime(110, now + DUR * 0.85);
      rOsc.frequency.exponentialRampToValueAtTime(58, now + DUR);
      var rLp  = ac.createBiquadFilter(); rLp.type = 'lowpass';
      rLp.frequency.setValueAtTime(180, now);
      rLp.frequency.exponentialRampToValueAtTime(420, now + DUR * 0.85);
      var rG  = ac.createGain();
      rG.gain.setValueAtTime(0.0001, now);
      rG.gain.exponentialRampToValueAtTime(0.42, now + DUR * 0.55);
      rG.gain.exponentialRampToValueAtTime(0.68, now + DUR * 0.85);
      rG.gain.exponentialRampToValueAtTime(0.0001, now + DUR);
      rOsc.connect(rLp); rLp.connect(rG);
      rG.connect(ac.destination); rG.connect(delay);
      rOsc.start(now); rOsc.stop(now + DUR + 0.05);
      // ── 3. Submerged bubble pops scattered through the middle ──
      [0.65, 1.7, 3.0, 4.3, 5.7, 6.8].forEach(function(off) {
        var bt = now + off + (Math.random() - 0.5) * 0.18;
        // Pop body: short low sine that drops in pitch (cavity closes)
        var bOsc = ac.createOscillator(); bOsc.type = 'sine';
        var f0 = 280 + Math.random() * 220;
        bOsc.frequency.setValueAtTime(f0, bt);
        bOsc.frequency.exponentialRampToValueAtTime(70, bt + 0.18);
        var bG = ac.createGain();
        bG.gain.setValueAtTime(0.0001, bt);
        bG.gain.exponentialRampToValueAtTime(0.42, bt + 0.012);
        bG.gain.exponentialRampToValueAtTime(0.0001, bt + 0.22);
        bOsc.connect(bG); bG.connect(ac.destination); bG.connect(delay);
        bOsc.start(bt); bOsc.stop(bt + 0.24);
        // Pop click: tiny noise transient on top
        var cLen = Math.floor(ac.sampleRate * 0.018);
        var cBuf = ac.createBuffer(1, cLen, ac.sampleRate);
        var cd = cBuf.getChannelData(0);
        for (var j = 0; j < cLen; j++) {
          cd[j] = (Math.random() * 2 - 1) * Math.exp(-j / (ac.sampleRate * 0.003));
        }
        var cSrc = ac.createBufferSource(); cSrc.buffer = cBuf;
        var cBp = ac.createBiquadFilter(); cBp.type = 'bandpass';
        cBp.frequency.value = 1400; cBp.Q.value = 1.6;
        var cG = ac.createGain(); cG.gain.value = 0.22;
        cSrc.connect(cBp); cBp.connect(cG);
        cG.connect(ac.destination); cG.connect(delay);
        cSrc.start(bt);
      });
      // ── 4. Final splash — wet ploom when the player breaks the
      //    surface at the end of the pipe. Two layers: a low "thoom"
      //    oscillator and a fast noise transient with a falling bandpass. ──
      var spT = now + 8.05;
      var spOsc = ac.createOscillator(); spOsc.type = 'sine';
      spOsc.frequency.setValueAtTime(160, spT);
      spOsc.frequency.exponentialRampToValueAtTime(48, spT + 0.45);
      var spG = ac.createGain();
      spG.gain.setValueAtTime(0.0001, spT);
      spG.gain.exponentialRampToValueAtTime(0.62, spT + 0.02);
      spG.gain.exponentialRampToValueAtTime(0.0001, spT + 0.55);
      spOsc.connect(spG); spG.connect(ac.destination); spG.connect(delay);
      spOsc.start(spT); spOsc.stop(spT + 0.6);
      // Splash spray (noise transient with falling bandpass)
      var sLen = Math.floor(ac.sampleRate * 0.45);
      var sBuf = ac.createBuffer(1, sLen, ac.sampleRate);
      var sd = sBuf.getChannelData(0);
      for (var k = 0; k < sLen; k++) sd[k] = (Math.random() * 2 - 1);
      var sSrc = ac.createBufferSource(); sSrc.buffer = sBuf;
      var sBp = ac.createBiquadFilter(); sBp.type = 'bandpass'; sBp.Q.value = 1.4;
      sBp.frequency.setValueAtTime(2400, spT);
      sBp.frequency.exponentialRampToValueAtTime(420, spT + 0.4);
      var sG = ac.createGain();
      sG.gain.setValueAtTime(0.0001, spT);
      sG.gain.exponentialRampToValueAtTime(0.45, spT + 0.015);
      sG.gain.exponentialRampToValueAtTime(0.0001, spT + 0.5);
      sSrc.connect(sBp); sBp.connect(sG);
      sG.connect(ac.destination); sG.connect(delay);
      sSrc.start(spT);
    });
  }
  return {
    jeffreyTune: jeffreyTune, pour: pour, sip: sip, phoneRing: phoneRing, pageRustle: pageRustle, pageShuffle: pageShuffle,
    startPissStream: startPissStream, primePissStream: primePissStream, startRetchStream: startRetchStream, primeRetchStream: primeRetchStream, windowSmash: windowSmash, snowStep: snowStep, primeSnowSteps: primeSnowSteps,
    typewriterTick: typewriterTick, typewriterClack: typewriterClack,
    itemFound: itemFound,
    penScratch: penScratch, heartbeat: heartbeat,
    glassSmash: glassSmash, matchStrike: matchStrike, matchboxRattle: matchboxRattle, coinFlip: coinFlip,
    doorCreak: doorCreak, doorSwingBell: doorSwingBell, doorThud: doorThud, doorShopBell: doorShopBell,
    passageWhoosh: passageWhoosh, loreUnravel: loreUnravel,
    ambientPub: ambientPub, ambientDream: ambientDream, ambientOff: ambientOff, ambientCut: ambientCut,
    // Farnell-style procedural models
    phoneBell: phoneBell, windFarnell: windFarnell,
    fireFarnell: fireFarnell, footstep: footstep,
    chimeBook: chimeBook, lilyChime: lilyChime, lilyBlock: lilyBlock, brightChord: brightChord,
    questCall: questCall,
    passwordSuccess: passwordSuccess,
    stopPhoneBell: stopPhoneBell,
    phoneLine: phoneLine, stopPhoneLine: stopPhoneLine,
    glassClink: glassClink, swallow: swallow,
    dodgeWhoosh: dodgeWhoosh, muffledThud: muffledThud, punchImpact: punchImpact,
    vialClink: vialClink, uncork: uncork, cameraShutter: cameraShutter,
    chirp: chirp, setBirdLevel: setBirdLevel,
    uncannyBreath: uncannyBreath, distantBell: distantBell, doorKnock: doorKnock,
    thunderClap: thunderClap, hoofBeat: hoofBeat, cowMoo: cowMoo, cowMooShort: cowMooShort,
    distantTraffic: distantTraffic, stopDistantTraffic: stopDistantTraffic,
    carHorn: carHorn, dripDrop: dripDrop,
    needleLift: needleLift,
    cosmicSewerSuck: cosmicSewerSuck,
    // Background music bed
    startMusic: startMusic, stopMusic: stopMusic,
    updateMusicForPassage: updateMusicForPassage,
    pauseMusic: pauseMusic, resumeMusic: resumeMusic,
    setMusicVolume: setMusicVolume,
    setMuted: setMuted, isMuted: isMuted,
    _duckMusic: _duckMusic,
    // Venue ambient beds
    registerAmbientBed: registerAmbientBed,
    updateAmbientBedsForPassage: updateAmbientBedsForPassage,
    mapFootstep: mapFootstep, transitionDistance: transitionDistance, mapCab: mapCab, mapPigeons: mapPigeons, mapMatch: mapMatch, cardTurn: cardTurn, tabTick: tabTick, coinPocket: coinPocket, pongTock: pongTock, pongWall: pongWall, pongPoint: pongPoint, startTagTicks: startTagTicks, tagTickCount: function(){ return _tickTimers.length; },
    startBed: startBedByLabel, stopBed: stopBedByLabel, fadeBed: fadeBedByLabel, letBedFinish: letBedFinishByLabel,
    prewarmBed: prewarmBedByLabel,
    playTransition: playTransition,
    // 2026-10-18 night: room ticks, exported for the effects board
    vinylCrackle: vinylCrackle, shopBellFar: shopBellFar, flagstoneSteps: flagstoneSteps, gravelSteps: gravelSteps, glassSetDown: glassSetDown, chairScrape: chairScrape,
    gust: gust, surfWash: surfWash, gullFar: gullFar, sandSlip: sandSlip, wheelCreak: wheelCreak, crockery: crockery, _tick: _tick, fairyTwinkle: fairyTwinkle,
    handsetLift: handsetLift, jukeboxClunk: jukeboxClunk, filamentPing: filamentPing, globeSpin: globeSpin, woodCreak: woodCreak, woodKnock: woodKnock, gasHiss: gasHiss,
    jumpPuff: jumpPuff, landThud: landThud, spotSound: spotSound, zippoClick: zippoClick, marbleTap: marbleTap, keyPickup: keyPickup, fireCrackle: fireCrackle, matFlick: matFlick, matCatch: matCatch, matDrop: matDrop
  };
})();

// ====== MUTE BUTTON (bottom-right corner) ======
// Single fixed-position toggle. Two SVG icons baked in (speaker on / speaker
// off); CSS swaps them via [data-muted]. Persists state via dssAudio.setMuted
// which writes to localStorage internally.
(function() {
  function buildMuteButton() {
    if (document.getElementById('dss-mute-btn')) return;
    var btn = document.createElement('button');
    btn.id = 'dss-mute-btn';
    btn.type = 'button';
    btn.setAttribute('aria-label', 'Mute audio');
    btn.setAttribute('data-muted', (window.dssAudio && window.dssAudio.isMuted && window.dssAudio.isMuted()) ? '1' : '0');
    btn.innerHTML = ''
      + '<svg class="dss-mute-icon dss-mute-icon-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
      +   '<path d="M12 3.5v1.5M9 5.5c-2 1.2-2.8 3.2-2.8 5.6V15l-1.7 2h15l-1.7-2v-3.9c0-2.4-.8-4.4-2.8-5.6a3.3 3.3 0 0 0-6 0z"/>'
      +   '<path d="M10 19.5a2 2 0 0 0 4 0"/>'
      +   '<path d="M19.5 7c1.2 1.2 1.8 2.6 1.8 4.2M3.7 11.2c0-1.6.6-3 1.8-4.2" opacity="0.7"/>'
      + '</svg>'
      + '<svg class="dss-mute-icon dss-mute-icon-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'
      +   '<path d="M12 3.5v1.5M9 5.5c-2 1.2-2.8 3.2-2.8 5.6V15l-1.7 2h15l-1.7-2v-3.9c0-2.4-.8-4.4-2.8-5.6a3.3 3.3 0 0 0-6 0z"/>'
      +   '<path d="M10 19.5a2 2 0 0 0 4 0"/>'
      +   '<line x1="4.5" y1="4" x2="19.5" y2="19.5"/>'
      + '</svg>';
    btn.addEventListener('click', function() {
      if (!window.dssAudio || !window.dssAudio.setMuted) return;
      var next = !window.dssAudio.isMuted();
      window.dssAudio.setMuted(next);
      btn.setAttribute('data-muted', next ? '1' : '0');
    });
    document.body.appendChild(btn);
  }
  if (document.body) {
    buildMuteButton();
  } else {
    document.addEventListener('DOMContentLoaded', buildMuteButton);
  }
  // Nothing removes it today, but re-attach defensively if anything ever does,
  // so the toggle really is on every page.
  function watchMuteButton() {
    if (!window.MutationObserver || !document.body) return;
    new MutationObserver(function() {
      if (!document.getElementById('dss-mute-btn')) buildMuteButton();
    }).observe(document.body, { childList: true });
  }
  if (document.body) watchMuteButton();
  else document.addEventListener('DOMContentLoaded', watchMuteButton);
})();

// ====== LILY CLICK CHIME + PETAL MOTE ======
// Inline <script> tags inside (click-replace:) hooks don't execute when
// Harlowe inserts them via innerHTML, so use a delegated click listener
// to fire the chime AND spawn a single white lily-petal mote that floats
// up toward the notebook link in the header.
(function() {
  function spawnLilyPetal(hook) {
    var nb = document.querySelector('.notebook-link');
    var hookRect = hook.getBoundingClientRect();
    var startX = hookRect.left + hookRect.width / 2;
    var startY = hookRect.top + hookRect.height / 2;
    // If we can't find the notebook, just float upward and offscreen.
    var dx = 0, dy = -260;
    if (nb) {
      var nbRect = nb.getBoundingClientRect();
      dx = (nbRect.left + nbRect.width / 2) - startX;
      dy = (nbRect.top + nbRect.height / 2) - startY;
    }
    var petal = document.createElement('div');
    petal.className = 'lily-petal-mote';
    petal.style.left = startX + 'px';
    petal.style.top = startY + 'px';
    petal.style.setProperty('--dx', dx + 'px');
    petal.style.setProperty('--dy', dy + 'px');
    petal.innerHTML = ''
      + '<svg viewBox="0 0 24 36" preserveAspectRatio="xMidYMid meet" aria-hidden="true">'
      +   '<defs>'
      +     '<radialGradient id="lpGrad" cx="50%" cy="40%" r="60%">'
      +       '<stop offset="0%" stop-color="rgba(255,252,255,0.95)"/>'
      +       '<stop offset="65%" stop-color="rgba(238,228,245,0.78)"/>'
      +       '<stop offset="100%" stop-color="rgba(210,200,235,0.0)"/>'
      +     '</radialGradient>'
      +   '</defs>'
      +   '<g filter="url(#dss-ink-fine)">'
      +   '<path d="M12,2 Q4,11 4,22 Q4,32 12,34 Q20,32 20,22 Q20,11 12,2 Z" '
      +     'fill="url(#lpGrad)" stroke="rgba(220,205,235,0.55)" stroke-width="0.4"/>'
      +   '<path d="M12,4 Q9,14 11,32" fill="none" '
      +     'stroke="rgba(230,215,240,0.35)" stroke-width="0.5"/>'
      + '</g></svg>';
    document.body.appendChild(petal);
    setTimeout(function() {
      if (petal.parentNode) petal.parentNode.removeChild(petal);
    }, 3700);
  }

  // Briefly fade a spent flower (down to near-invisible, then back) so a
  // click on an already-gathered lily reads as "nothing here". Re-applied
  // each click via a reflow so it restarts every time.
  function lilyBlip(el) {
    if (!el) return;
    el.classList.remove('lily-spent-blip');
    void el.offsetWidth;
    el.classList.add('lily-spent-blip');
  }
  window.dssLilyBlip = lilyBlip;

  // Track which lily hooks have already released their petal this view.
  // Harlowe's (click-replace:) is one-shot, but the named tw-hook lingers in
  // the DOM after it fires — so without this guard a second click would still
  // spawn a petal even though no new flower is gathered.
  var _petalled = {};
  document.addEventListener('click', function(e) {
    var hook = e.target.closest('tw-hook');
    if (!hook) return;
    var name = hook.getAttribute('name') || '';
    if (!/^lily\d+$/i.test(name)) return;
    if (_petalled[name]) {
      // Already gathered this view — no new petal, no notebook entry. The
      // .lily-taken listener further down does the low "blocked" thunk and the
      // fade now that the class is actually applied; only sound it here if for
      // some reason it never landed.
      if (!hook.classList.contains('lily-taken')) {
        if (window.dssAudio && window.dssAudio.lilyBlock) window.dssAudio.lilyBlock();
        lilyBlip(hook.querySelector('.lily-prompt') || hook);
      }
      return;
    }
    _petalled[name] = true;
    if (window.dssAudio && window.dssAudio.lilyChime) {
      window.dssAudio.lilyChime();
    }
    // MARK IT SPENT. The stylesheet has always carried a full "taken flower"
    // state — no invite pulse, no hover lift, and crucially no
    // "✦ always take a flower ✦" line under it — but NOTHING in the game ever
    // added the class, so (click-replace:) put back a flower that looked
    // exactly as live as the one just picked, still asking to be picked (Sam,
    // 2026-09-15: "the styling of the 'take a flower' lilies is
    // inconsistent"). The class also switches on the .lily-taken click
    // listener, which until now could never fire.
    requestAnimationFrame(function() {
      hook.classList.add('lily-taken');
      // Defer one more frame so the click has been visually acknowledged.
      requestAnimationFrame(function() { spawnLilyPetal(hook); });
    });
  }, true);
})();

// ====== SHARED MODAL ACCESSIBILITY HELPER ======
// One place to make the gold-on-dark dialogs screen-reader- and keyboard-
// friendly (audit S1/S2/S3): tags the card as role="dialog" aria-modal with an
// aria-labelledby pointing at its title, moves focus into the dialog on open,
// optionally binds Escape-to-close, and returns a cleanup() the caller invokes
// from its teardown to unbind Escape and restore focus to the trigger.
//   opts.focusEl     — element to focus instead of the card (e.g. a Play button)
//   opts.escape      — false to NOT bind Escape (caller already handles it, or
//                      closing would be a soft-lock e.g. the rules modal)
//   opts.returnFocus — false to NOT restore focus on close (e.g. when the next
//                      thing — a game canvas — should keep focus)
window.dssModalA11y = function(overlay, card, labelEl, closeFn, opts) {
  opts = opts || {};
  card.setAttribute('role', 'dialog');
  card.setAttribute('aria-modal', 'true');
  if (labelEl) {
    if (!labelEl.id) labelEl.id = 'dss-modal-label-' + (window._dssModalLabelN = (window._dssModalLabelN || 0) + 1);
    card.setAttribute('aria-labelledby', labelEl.id);
  }
  var prevFocus = document.activeElement;
  var focusEl = opts.focusEl || card;
  if (focusEl === card && !card.hasAttribute('tabindex')) card.setAttribute('tabindex', '-1');
  try { focusEl.focus(); } catch (e) {}
  function onKey(e) { if (e.key === 'Escape') closeFn(); }
  if (opts.escape !== false) document.addEventListener('keydown', onKey);
  return function cleanup() {
    document.removeEventListener('keydown', onKey);
    if (opts.returnFocus !== false && prevFocus && prevFocus.focus) { try { prevFocus.focus(); } catch (e) {} }
  };
};

// ====== MINIGAME RULES MODAL ======
// A simple popup shown before a minigame begins: the game's title, a few
// plain-language rules, and a single PLAY button that closes the modal and
// runs opts.onPlay() to start the game. Appended to <body> at a high z-index;
// a MutationObserver on tw-story tears it down (without starting the game) if
// the player navigates away before pressing Play.
(function() {
  function showRules(opts) {
    opts = opts || {};
    if (typeof opts.onPlay !== 'function') return;
    var prev = document.getElementById('dss-rules-overlay');
    if (prev && prev.parentNode) prev.parentNode.removeChild(prev);

    var overlay = document.createElement('div');
    overlay.className = 'dss-rules-overlay';
    overlay.id = 'dss-rules-overlay';
    var card = document.createElement('div');
    card.className = 'dss-rules-card';

    // 2026-10-18 (Sam: the rules cards "still have a very 'claude' look"; he chose a mix): the game's name on a
    // title card from its own world (a fight bill, a beer mat, a betting slip, a dance card, a scorecard, a playing
    // card), and the explanation and the button on the game's ordinary paper instruction slip, tucked over it.
    // Replaces the gold-bordered dark card, its corner vines and engraved emblems. The words are the games' own.
    card.classList.add('dss-rules-pair');
    var KIND = { fight: 'bill', mats: 'mat', cow: 'betslip', waltz: 'dancecard', pong: 'scorecard', cards: 'playingcard', nazca: 'raceticket', climb: 'luggagetag', reclamation: 'stencil', pyramid: 'museumticket', worms: 'seedpacket' };
    var kind = KIND[opts.key] || 'bill';
    var obj = document.createElement('div');
    obj.className = 'dss-rules-object dss-rules-' + kind;
    var h = document.createElement('div');
    h.className = 'dss-rules-title';
    h.textContent = opts.title || 'How to play';
    var deco = function(html) { var d = document.createElement('div'); d.className = 'ro-deco'; d.setAttribute('aria-hidden', 'true'); d.innerHTML = html; return d; };
    if (kind === 'bill') { obj.appendChild(h); obj.appendChild(deco('<div class="ro-rule"></div><div class="ro-stars">✶ ✶ ✶</div>')); }
    else if (kind === 'betslip') { obj.appendChild(deco('<div class="ro-head"><span>No. 93</span><span>DEAN ST</span></div>')); obj.appendChild(h); }
    else if (kind === 'dancecard') { obj.appendChild(deco('<div class="ro-cord"></div>')); obj.appendChild(h); obj.appendChild(deco('<div class="ro-dots"></div><div class="ro-dots"></div><div class="ro-dots"></div>')); }
    else if (kind === 'scorecard') { obj.appendChild(h); obj.appendChild(deco('<div class="ro-grid">' + new Array(15).join('<i></i>') + '</div>')); }
    else if (kind === 'luggagetag') { obj.appendChild(deco('<div class="ro-eyelet"></div><div class="ro-string"></div>')); obj.appendChild(h); obj.appendChild(deco('<div class="ro-rule"></div>')); }
    else if (kind === 'stencil') { obj.appendChild(deco('<div class="ro-bolt ro-b1"></div><div class="ro-bolt ro-b2"></div><div class="ro-bolt ro-b3"></div><div class="ro-bolt ro-b4"></div>')); obj.appendChild(h); }
    else if (kind === 'museumticket') { obj.appendChild(h); obj.appendChild(deco('<div class="ro-eye">\u2625</div>')); }
    else if (kind === 'seedpacket') { obj.appendChild(deco('<div class="ro-flap"></div>')); obj.appendChild(h); obj.appendChild(deco('<div class="ro-sprig">\u2767</div>')); }
    else if (kind === 'raceticket') { obj.appendChild(deco('<div class="ro-chequer"></div>')); obj.appendChild(h); obj.appendChild(deco('<div class="ro-chequer"></div>')); }
    else if (kind === 'playingcard') { obj.appendChild(deco('<span class="ro-idx ro-tl">K<br>♠</span><span class="ro-idx ro-br">K<br>♠</span>')); obj.appendChild(h); }
    else { obj.appendChild(h); }
    card.appendChild(obj);

    var slip = document.createElement('div');
    slip.className = 'dss-rules-slip';
    if (opts.subtitle) {
      var s = document.createElement('div');
      s.className = 'dss-rules-sub';
      s.textContent = opts.subtitle;
      slip.appendChild(s);
    }
    var ul = document.createElement('div');
    ul.className = 'dss-rules-list';
    // 2026-10-13 (Sam: "make it so the game identifies if it's using a phone or a laptop ... applied to all"): a card can
    // carry touchLines, its words for a touch screen; on a phone or tablet (no hover, a coarse pointer, as the waltz and
    // the map already test) they are shown instead of lines.
    var dssTouch = !!(window.matchMedia && window.matchMedia('(hover: none) and (pointer: coarse)').matches);
    ((dssTouch && opts.touchLines) ? opts.touchLines : (opts.lines || [])).forEach(function(line) {
      var li = document.createElement('div'); // a div, not a p: some games' lines are already <div>s
      li.innerHTML = line;   // author-controlled; allows &larr; <b> etc.
      ul.appendChild(li);
    });
    slip.appendChild(ul);
    if ((ul.textContent || '').length > 380) card.classList.add('dss-rules-wide'); // long instructions (the dream-world games): a wider slip, so a shorter one

    var btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'dss-rules-play';
    btn.textContent = opts.play || 'Play'; // 2026-10-13 (Sam): each game's own word
    slip.appendChild(btn);
    card.appendChild(slip);

    overlay.appendChild(card);
    document.body.appendChild(overlay);
    /* Two frames so the initial opacity:0 is definitely painted before the class
       lands, plus a timeout fallback because a backgrounded tab stalls rAF and
       would otherwise leave the card invisible. */
    var shownIn = false;
    function revealCard() { if (shownIn) return; shownIn = true; overlay.classList.add('dss-rules-in'); }
    requestAnimationFrame(function() { requestAnimationFrame(revealCard); });
    setTimeout(revealCard, 140);

    var done = false;
    var obs = null;
    var a11yCleanup = null;
    function teardown() {
      if (a11yCleanup) a11yCleanup();
      if (obs) { try { obs.disconnect(); } catch (e) {} obs = null; }
      overlay.classList.remove('dss-rules-in');
      overlay.classList.add('dss-rules-out');
      setTimeout(function() {
        if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
      }, 280);
    }
    // Dialog semantics + focus the Play button (audit S1/S2). No Escape-to-close
    // and no focus-return: the only intended exit is Play (which starts the game
    // and manages canvas focus itself) — closing on Escape would strand the player.
    a11yCleanup = window.dssModalA11y(overlay, card, h, function(){}, {focusEl: btn, escape: false, returnFocus: false});
    btn.addEventListener('click', function() {
      if (done) return; done = true;
      teardown();
      try { opts.onPlay(); } catch (e) {}
      /* 2026-10-14 overnight: at 1280x800 the play area sat partly below the fold (the Cellar's gloves, Pong's paddle, the
         waltz's hit line, the cards' and mats' buttons) and nothing brought it up. After Play the largest game surface in
         the passage is scrolled fully into view when it is cut off. */
      setTimeout(window.dssScrollPlayIntoView, 120);
    });

    // If the player leaves the passage before pressing Play, remove the modal
    // without starting the game. Tear down only when the passage the modal was
    // launched from actually leaves the DOM — trailing mutations from the
    // passage transition that brought us here (which keep that passage in
    // place) must NOT trigger a false teardown.
    var story = document.querySelector('tw-story');
    var homePassage = document.querySelector('tw-passage');
    if (story && homePassage && window.MutationObserver) {
      obs = new MutationObserver(function() {
        if (done) return;
        if (document.contains(homePassage)) return;  // still on the launch passage
        done = true; teardown();
      });
      obs.observe(story, { childList: true, subtree: true });
    }
  }
  // 2026-10-14 overnight: after a game starts, bring its play surface fully into view when the window cuts it off
  // (rules-card games on Play; the worm hut and the dream-world games on their own start buttons, below)
  window.dssScrollPlayIntoView = function() {
        try {
          var pass = document.querySelector('tw-passage'); if (!pass) return;
          var cands = Array.prototype.slice.call(pass.querySelectorAll('canvas, #dss-beer-mats, #dss-house-cards, [class*="waltz-stage"], [id*="waltz"]'));
          var best = null, area = 0;
          cands.forEach(function(el) {
            var cs = getComputedStyle(el); if (cs.position === 'fixed') return;
            var r = el.getBoundingClientRect(), a = r.width * r.height; if (a > area) { area = a; best = el; }
          });
          var r = null, wm = pass.querySelector('.worm-meters'), ww = pass.querySelector('.worm-wall');
          if (wm && ww) { var a1 = wm.getBoundingClientRect(), a2 = ww.getBoundingClientRect(); r = { top: Math.min(a1.top, a2.top), bottom: Math.max(a1.bottom, a2.bottom) }; }
          else { if (!best || area < 20000) return; r = best.getBoundingClientRect(); }
          // the fixed stat header covers the top of the window: fit the surface into what is left under it
          var hb = 0;
          Array.prototype.forEach.call(document.querySelectorAll('tw-story > *, body > *'), function(el) {
            var cs = getComputedStyle(el); if (cs.position !== 'fixed' && cs.position !== 'sticky') return;
            var q = el.getBoundingClientRect(); if (q.top <= 1 && q.width > 300 && q.height < window.innerHeight * 0.4 && q.bottom > hb) hb = q.bottom;
          });
          var avail = window.innerHeight - hb, h = r.bottom - r.top;
          if (r.bottom > window.innerHeight + 2 || r.top < hb - 2) window.scrollBy(0, r.top - hb - Math.max(8, (avail - h) / 2)); // instant: a game's own focus() cancels a smooth scroll
        } catch (e) {}
  };
  document.addEventListener('click', function(e) {
    var b = e.target && e.target.closest && e.target.closest('button');
    if (b && /^(Pick up a spade|Begin ascent|Take the rifle|Enter the dark)$/i.test((b.textContent || '').trim())) setTimeout(window.dssScrollPlayIntoView, 250);
  }, true);
  window.dssShowMinigameRules = showRules;
  /* 2026-10-28 (Sam, after a playtest: the minigames are too hard for someone not used to games; "Easier each retry"):
     every failable game counts its own losses in this browser (localStorage 'dssEase', never reset, so a player who found a
     game hard finds it gentler on a later night too) and reads its ease level, 0 to 3, when a round starts. Each game loosens
     its own goals, timing windows, speeds or lives by the level; steering and jump physics are left as tuned. A lost round
     shows this card inside the game's frame: TRY AGAIN starts a gentler round, MOVE ON takes the loss as the story has it.
     Nothing on screen says it got easier. */
  window.dssEase = (function() {
    var KEY = 'dssEase', MAX = 3, mem = {};
    function all() { try { return JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { return mem; } }
    function level(k) { var n = +all()[k] || 0; return Math.max(0, Math.min(MAX, n)); }
    function lost(k) { var m = all(); m[k] = Math.min(MAX, (+m[k] || 0) + 1); mem = m; try { localStorage.setItem(KEY, JSON.stringify(m)); } catch (e) {} return m[k]; }
    /* by(k, a, b): a at level 0, b at level 3, in even steps */
    function by(k, a, b) { return a + (b - a) * level(k) / MAX; }
    function offer(host, o) {
      if (!host) return null;
      var old = host.querySelector(':scope > .dss-ease-card'); if (old) old.remove();
      if (getComputedStyle(host).position === 'static') host.style.position = 'relative';
      var c = document.createElement('div'); c.className = 'dss-ease-card';
      c.innerHTML = '<div class="dss-ease-row"><button type="button" class="dss-ease-btn dss-ease-again">' + (o.again || 'Try again') + '</button><button type="button" class="dss-ease-btn dss-ease-move">' + (o.move || 'Move on') + '</button></div>';
      host.appendChild(c);
      var done = false;
      function pick(fn) { if (done) return; done = true; c.remove(); if (fn) fn(); }
      c.querySelector('.dss-ease-again').addEventListener('click', function(e) { e.stopPropagation(); pick(o.onAgain); });
      c.querySelector('.dss-ease-move').addEventListener('click', function(e) { e.stopPropagation(); pick(o.onMove); });
      ['pointerdown', 'mousedown', 'touchstart', 'keydown'].forEach(function(t) { c.addEventListener(t, function(e) { e.stopPropagation(); }); });
      setTimeout(function() { var b = c.querySelector('.dss-ease-again'); if (b && c.isConnected) try { b.focus({ preventScroll: true }); } catch (e) {} }, 60);
      return c;
    }
    return { level: level, lost: lost, by: by, offer: offer };
  })();
  // 2026-10-18 (Sam: "all the dream world games in the next style too"): the dream-world games (the Climb, the Reclamation,
  // the Pyramid Run) open on a cover inside their frame: a kicker line, the name, instruction paragraphs and a start button.
  // Whenever such a cover is showing, the same rules card is raised from it, word for word: the kicker as the slip's bold
  // first line, each paragraph as it is (its line breaks kept), the button's own word; Play presses the cover's button.
  // The cover hides while the card is up. A cover that comes back later (a retry) raises the card again.
  var COVERS = [['hc-cover', 'climb'], ['rc-cover', 'reclamation'], ['pr-cover', 'pyramid']];
  function coverShowing(c) { return c && !c.hidden && document.contains(c) && getComputedStyle(c).display !== 'none'; }
  setInterval(function() {
    if (document.getElementById('dss-rules-overlay')) return;
    // 2026-10-18 (Sam): the worm hut too. Its game is laid out inline (a heading, an instruction line, the wall, a start
    // button), so the card is raised once per visit while the start button shows; the page itself is left as it is.
    var worm = document.getElementById('dss-worm-game');
    if (worm && !worm.dataset.dssCard) {
      var wStart = worm.querySelector('.worm-start'), wH = worm.querySelector('h2'), wIns = worm.querySelector('.worm-instructions');
      if (wStart && !wStart.hidden && wH && wIns) {
        worm.dataset.dssCard = 'done';
        showRules({ key: 'worms', title: wH.textContent.trim(), lines: [wIns.innerHTML], play: wStart.textContent.trim(), onPlay: function() { wStart.click(); } });
        return;
      }
    }
    COVERS.forEach(function(spec) {
      var cover = document.getElementById(spec[0]);
      if (!coverShowing(cover) || cover.dataset.dssCard === 'up') return;
      var h2 = cover.querySelector('h2'), kick = cover.querySelector('[class$="-kicker"]'), btn = cover.querySelector('button');
      if (!h2 || !btn) return;
      var paras = Array.prototype.filter.call(cover.querySelectorAll('p'), function(p) { return p !== kick; }).map(function(p) { return p.innerHTML; });
      cover.dataset.dssCard = 'up'; cover.style.visibility = 'hidden';
      var release = function() { cover.style.visibility = ''; delete cover.dataset.dssCard; };
      showRules({ key: spec[1], title: h2.textContent.trim(), subtitle: kick ? kick.textContent.trim() : '', lines: paras, play: btn.textContent.trim(),
        onPlay: function() { release(); btn.click(); } });
      // if the passage goes before Play, the card tears itself down; let the cover raise it again next time
      var ov = document.getElementById('dss-rules-overlay');
      if (ov && window.MutationObserver) { var mo = new MutationObserver(function() { if (!document.contains(ov)) { mo.disconnect(); if (cover.dataset.dssCard === 'up') release(); } }); mo.observe(document.body, { childList: true }); }
    });
  }, 400);
})();

// ====== THE PRIMER: MORALE, SOBRIETY & HAUNTS ======
// MORALE and SOBRIETY explain the stats; HAUNTS waits for the first collected haunt (Sam, 2026-10-28).
// Raised through window.dssShowPrimer and guarded by $primerShown, so whichever comes first, a drink or a haunt, shows them.
//
// 2026-09-14: this was a full-screen gold-on-dark modal. Sam asked for it on the
// paper slip with the rest of the instructions, "long enough to be read". Every
// sentence below is his, verbatim and in the order he set, including the two
// haunts paragraphs merged in on 2026-09-13. The slip sizes its own hold to the
// length of the text and can be waved away with a click once read.
//
// dssDeferIfBusy still applies: the primer waits behind a drink popup rather
// than typing itself out underneath one.
(function() {
  // 2026-10-12: Sam's new version, his words and headings exactly (the slip review, slip 1 of 14).
  var paras = [
      "You will be measured in two ways tonight. At the top of the page you can see where you stand.",
      "One measure’s your MORALE, that is, your confidence, what you bring into a room. The other’s your SOBRIETY; how straight you can remain. The latter might be traded for the former.",
      "Neither one can end the night. It’s hard to die quickly of booze or too much feeling. But they will change the way the night plays out; how its turns respond to your presence.",
      "Tend to them, they’re worth more than you know.",
      "HAUNTS",
      "Tonight, Soho will mark you. Here, in our mutual dream, we will call the marks ‘haunts’. You’ll gather them as you do the night’s Great Work."
  ];
  // 2026-10-23 (the first-night map): it waited through dssDeferIfBusy, which drops the retry when the page changes, and
  // gave up if a long slip was up; $primerShown is set before this runs, so either way STATS was lost for the night. The
  // slips are sticky, so it now waits across pages until nothing else is up.
  var waiting = false;
  function showPrimer() {
    if (waiting) return;
    if (document.querySelector('.dss-hint-slip.long') || (window.dssOverlayBusy && window.dssOverlayBusy())) { waiting = true; setTimeout(function() { waiting = false; showPrimer(); }, 300); return; }
    // Split the existing wording at its sentence boundary; no prose rewritten.
    var statSentences = paras[1].split(' The other’s');
    window.dssInlineHint('MORALE\n\n' + paras[0] + '\n\n' + statSentences[0], { sticky: true, then: function() {
      window.dssInlineHint('SOBRIETY\n\nThe other’s' + statSentences[1] + '\n\n' + paras.slice(2, 4).join('\n\n'), { sticky: true });
    } });
  }
  window.dssShowPrimer = showPrimer;
  var hauntWaiting = false;
  window.dssShowHauntPrimer = function showHauntPrimer() {
    if (hauntWaiting) return;
    if (document.querySelector('.dss-hint-slip:not(.out)') || (window.dssOverlayBusy && window.dssOverlayBusy())) {
      hauntWaiting = true;
      setTimeout(function(){ hauntWaiting = false; showHauntPrimer(); }, 300);
      return;
    }
    window.dssInlineHint(paras.slice(4).join('\n\n'), { sticky: true });
  };

})();

/* ====== A RESTING VENUE TURNS YOU AWAY (2026-10-17, Sam: "If you try to return eg to the french before looking elsewhere you should be blocked and gently prompted 'look elsewhere; try again later'") ======
   Dean Street's hidden 'rest' flag names the French or the Colony while it rests (someone was met there and no other venue has been entered since).
   A click on any link into that venue (the hub's own links, and the map's doors, which press them) is stopped and Sam's line shows on a slip. */
(function() {
  /* Harlowe's links carry only their text, so the hub's ways in are named here (every Dean Street link into the two rooms, 2026-10-17) */
  var INTO = { french: ['To The French', 'Back to The French', 'The French'], colony: ['Try the Colony Room', 'Back to The Colony Room'] };
  document.addEventListener('click', function(ev) {
    var link = ev.target && ev.target.closest ? ev.target.closest('tw-link') : null;
    if (!link) return;
    var f = document.querySelector('.dss-hub-flag[data-k="rest"]'), rest = f ? f.textContent.trim() : '';
    if (!rest || !INTO[rest] || INTO[rest].indexOf(link.textContent.replace(/\s+/g, ' ').trim()) < 0) return;
    ev.preventDefault(); ev.stopImmediatePropagation();
    var up = Array.prototype.some.call(document.querySelectorAll('.dss-hint-slip'), function(e) { return e.textContent.indexOf('Look elsewhere; try again later.') >= 0; });
    if (!up && window.dssInlineHint) window.dssInlineHint('Look elsewhere; try again later.');
  }, true);
})();

/* ====== THE FIRST HAUNT OPENS THE NOTEBOOK (2026-10-17, Sam: "when you get the first haunt it should automatically open up the notebook, sort of like a tutorial, so you know where they are and also so you notice the haunts") ======
   Once per browser (localStorage dssHauntNotebookTut). A haunt card reading "1 of 12 caught" starts it; it waits about 2.6 s so the card is read,
   then for the primer slip, any overlay, a dialog or a ringing phone to clear, then opens the NOTEBOOK and brings its HAUNTS section into view with a brief glow. */
(function() {
  var KEY = 'dssHauntNotebookTut', pending = false;
  function done() { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } }
  function busy() { return (window.dssOverlayBusy && window.dssOverlayBusy()) || !!document.querySelector('.dss-hint-slip:not(.out), tw-dialog, .phone-ringing:not(.ring-wait), .dss-rules-overlay, .dss-slip-fly, .dss-refusal:not(.dss-filed)'); } /* 2026-10-19 overnight: and a rejection slip, now held 6 s. 2026-10-23 (the first-night map): any slip on screen, not only a long one, so it no longer opens over the HAUNTS slip that follows STATS */
  setInterval(function() {
    if (pending || done()) return;
    var hp = Array.prototype.filter.call(document.querySelectorAll('.haunt-progress'), function(e) { var b = e.closest('.haunt-box'); return /^\s*1 of/.test(e.textContent) && b && b.getClientRects().length; })[0]; /* 2026-10-23: the count line is hidden now, so the box's own visibility is checked */
    if (!hp) return;
    /* 2026-10-19 overnight (seen live in a headless run): the count began while the box was still hidden behind the drink popup, so the
       notebook opened right over THE DEBT's flash. It now starts once the box is fully shown, and gives the flare time to finish. */
    var hbox = hp.closest('.haunt-box');
    if (hbox) { var hcs = getComputedStyle(hbox); if (hcs.visibility === 'hidden' || parseFloat(hcs.opacity) < 0.95) return; }
    pending = true;
    var t0 = Date.now();
    (function tryOpen() {
      if (done()) { pending = false; return; }
      if (document.querySelector('tw-dialog .nb-haunts')) { try { localStorage.setItem(KEY, '1'); } catch (e) {} pending = false; return; } /* 2026-10-19 overnight: the player opened the NOTEBOOK themselves, so the lesson is learnt; don't pop it open again once they close it */
      if (busy()) { t0 = Date.now(); setTimeout(tryOpen, 300); return; } /* the count restarts while anything is up (the drink popup above all) */
      if (Date.now() - t0 < 4500) { setTimeout(tryOpen, 300); return; } /* 4.5 s clear: the box's reveal and flare (to 2.8 s) are over */
      var nb = document.querySelector('.notebook-link tw-link');
      if (!nb || !nb.getClientRects().length) { if (Date.now() - t0 < 60000) { setTimeout(tryOpen, 500); } else { pending = false; } return; }
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
      nb.click();
      setTimeout(function() { var h = document.querySelector('tw-dialog .nb-haunts'); if (h) { try { h.scrollIntoView({ block: 'center' }); } catch (e) {} h.classList.add('nb-haunts-flash'); } }, 450);
      /* 2026-10-23 (Sam, playtest: "This preview of the wheel in the notebook should fade naturally after a few seconds. Say, 7
         seconds"): it fades out and closes itself at 7 s, unless the player has touched it (a click, a key or the wheel inside it) */
      setTimeout(function() {
        var dlg = document.querySelector('tw-dialog'); if (!dlg || !dlg.querySelector('.nb-haunts')) return;
        var touched = false; function mark() { touched = true; }
        dlg.addEventListener('pointerdown', mark, true); dlg.addEventListener('wheel', mark, true); document.addEventListener('keydown', mark, true);
        setTimeout(function() {
          document.removeEventListener('keydown', mark, true);
          if (touched || !dlg.isConnected) return;
          var fadeEls = [dlg].concat(Array.prototype.slice.call(document.querySelectorAll('tw-backdrop')));
          fadeEls.forEach(function(e) { e.style.transition = 'opacity 1.2s ease'; e.style.opacity = '0'; });
          setTimeout(function() { if (!dlg.isConnected) return; var link = document.querySelector('tw-dialog-links tw-link'); if (link) link.click(); }, 1250);
        }, 5800);
      }, 450);
    })();
  }, 500);
})();

// ====== POPUP SERIALIZATION ======
// Soft "info" modals (the haunts/stats primers, the venue hint, word-to-the-
// wise nudges, the morale warning) must never land on top of a "hard" tactile
// overlay (hold-to-drink, or the coin / match / cig / eat pickups) or on top of
// each other. Each soft modal calls dssDeferIfBusy() right after its own dedup
// guard: if something blocking is on screen it re-queues itself ~200ms later
// (cancelling if the player navigates away — _passageGen changes), so the
// player only ever sees one popup at a time, in sequence.
window.dssOverlayBusy = function() {
  if (window._drinkPopupOpen === true) return true;
  return !!document.querySelector(
    '#coin-overlay,#match-overlay,#cig-overlay,#eat-overlay,#dss-key-overlay,#dss-lily-overlay,' +
    '#dss-quest-overlay,' + /* 2026-10-23: #venue-hint-overlay, #word-wise-overlay and #wtw-overlay dropped from this list; nothing makes them any more */
    '#liver-eat-overlay,#napkin-popup-overlay,.dss-rules-overlay,' +
    '#drink-popup-overlay,#spew-popup-overlay,.coach-plumbing-intro,' +
    '#dss-lore-overlay,' /* 2026-10-19 overnight: a lore note or THE RUMOUR, so nothing pops up over his words while they are being read */ +
    '#dss-gate-flash' /* 2026-10-21: the gold wheel after a haunt */
  );
};
window.dssDeferIfBusy = function(retry) {
  if (!window.dssOverlayBusy()) return false;
  var gen = window._passageGen;
  setTimeout(function() { if (window._passageGen === gen) retry(); }, 200);
  return true;
};

// ====== SOHO MAP — the walkable hub (2026-09-01) ======
// Sam: "a sort of map you can walk around, like the early Pokémon Game Boy
// games, to get between venues." House palette, little moving legs, arrow
// keys; walking costs nothing — it is simply how you choose the next door.
// Round 2 (same night): sits LEFT OF THE STREET LAMP, the click list is
// docked off-screen (the map still reads it, and it is what gets clicked),
// every door carries an HTML label (clickable — the mouse/thumb way in) and
// spills its own colour of light onto the pavement.
//
// Design: the map is a VIEW over the Dean Street hub, not a replacement. The
// hub passage renders its links exactly as before (all the unlock/grey/funnel
// logic stays in Harlowe); the map scans those rendered <tw-link>s and
// .greyed-out spans, lights the matching doors, and walking into a lit door
// (or clicking its label) clicks the link. The hooks that held the list are
// parked off-screen with a layout box kept (Harlowe drops clicks on links
// with none — memory project_harlowe_hidden_link_clicks).
//
// Lifecycle: the hub carries <div id="soho-map-container">; a 300ms watcher
// builds the scene when it appears and tears it down when it goes (the same
// pattern as the 3D approach scenes).
(function(){
// SCROLLING SOHO (2026-09-11, Sam: "like the early Pokémon games the map moved with you").
// The WORLD is 52×44 tiles — Oxford Street along the top, Shaftesbury Avenue along the
// bottom, Wardour Street on the west edge, Charing Cross Road on the east — seen through
// a 26×26 VIEW that follows the figure. Every venue sits where it really sits in Soho,
// blocks compressed by about half (the same fudge as the notebook plan). Roads and
// pavements come from tileAt(); the real alleys (St Anne's Court, Meard Street,
// Bourchier Street, Manette Street, Walker's Court…) are walkable too, and the west,
// south and east edges let you walk off the map for a beat and come back.
var T = 16, COLS = 52, ROWS = 44, VC = 26, VR = 26, SKY = 3;
var W = VC*T, H = (VR+SKY)*T;         // the canvas: the view plus the sky band
// THE VIEW LOSES ROWS, NEVER COLUMNS (Sam, 2026-10-06: "on laptop the walkable map
// loses a bit of height if that's what it needs, but no width"). On a 1440x900
// laptop the hub's title block puts the top of the map 555px down, and a 26x29
// view drawn 544px wide runs 607px tall: its foot, the Shaftesbury Avenue side,
// sat 260px below the window's edge. Shrinking it would cost width, and a
// 26-tile Soho is the one thing the map must keep (see the lamp gutter note in
// the stylesheet). So the view stays 26 columns at the same tile size and shows
// FEWER ROWS when the window is short: fitRows() measures the height left under
// the top of the map, keeps the sky band, and clamps at VR_MIN rows of street,
// which at 544px wide is 14 rows in all and lands the foot and its bar just
// inside 900. The world is unchanged; the camera already scrolls with the
// figure, so a shorter view simply shows less of Soho at once. Phones (640px
// and under) keep the full 26 rows: scrolling is the norm there and the d-pad
// sits under the map anyway.
var VR_FULL = 26, VR_MIN = 6; /* 2026-10-25 (Sam: "make Dean Street fit at 1280x800 too, letting the map show fewer rows if it has to"): was 11, which left the hub 97 px over at 1280x800; fitRows() still takes as many rows as fit */
var WW = COLS*T, WH = ROWS*T;         // the world in pixels
var WIN_BLINK = [], CHIMNEYS = [], WARM_WINS = []; // WARM_WINS (2026-09-12): lit windows that go dark as the night runs down
var RED_WINS = []; // RED_WINS (2026-10-25, Sam: "sexy airs of night"): red-lit first-floor rooms off Walker's Court, Old Compton and the Wardour end; they stay on when Soho goes to bed

// ---- the streets -------------------------------------------------------------
// vertical roads (two lanes each): Wardour 5-6, Dean 17-18, Frith 29-30, Greek 41-42, Charing Cross 49-50
// horizontal: Oxford 1-2, Manette 8-9 (Greek→Charing Cross), Bateman 15-16 (Wardour→Greek),
//             Old Compton 27-28, Romilly 35-36 (Dean→Charing Cross), Shaftesbury 41-42
// Soho Square: a ring road 32..39 × 4..11 round a railed garden
var ALLEYS = [
  { name:"ST ANNE’S COURT",     r:20, c0:8,  c1:15 },
  { name:'MEARD STREET',        r:23, c0:8,  c1:15 },
  { name:'BOURCHIER STREET',    r:32, c0:8,  c1:15 },
  { name:'RICHMOND BUILDINGS',  r:12, c0:20, c1:27 },
  { name:"BATEMAN’S BUILDINGS", r:24, c0:32, c1:39 },
  { name:"WALKER’S COURT",      r:31, c0:0,  c1:3  },
  { name:'GREEK COURT',         r:39, c0:44, c1:47 }
];
function alleyAt(c, r) { for (var i = 0; i < ALLEYS.length; i++) { var a = ALLEYS[i]; if (a.r === r && c >= a.c0 && c <= a.c1) return a; } return null; }
function roadAt(c, r) {
  if (c < 0 || r < 0 || c >= COLS || r >= ROWS) return false;
  if (c >= 32 && c <= 39 && r >= 4 && r <= 11) return (c === 32 || c === 39 || r === 4 || r === 11);
  if (r === 1 || r === 2 || r === 41 || r === 42) return true;
  if (c === 5 || c === 6 || c === 17 || c === 18 || c === 29 || c === 30 || c === 41 || c === 42 || c === 49 || c === 50) return r >= 1 && r <= 42;
  if ((r === 27 || r === 28) && c >= 7 && c <= 48) return true;
  if ((r === 15 || r === 16) && c >= 7 && c <= 40) return true;
  if ((r === 35 || r === 36) && c >= 19 && c <= 48) return true;
  if ((r === 8 || r === 9) && c >= 43 && c <= 48) return true;
  return false;
}
var TILE = [];
(function buildTiles(){
  for (var r = 0; r < ROWS; r++) { TILE[r] = []; for (var c = 0; c < COLS; c++) {
    var t;
    if (c >= 32 && c <= 39 && r >= 4 && r <= 11) t = roadAt(c, r) ? 'R' : ((c === 33 || c === 38 || r === 5 || r === 10) ? 'P' : 'G');
    else if (roadAt(c, r)) t = 'R';
    else if (alleyAt(c, r)) t = 'A';
    else if (roadAt(c-1, r) || roadAt(c+1, r) || roadAt(c, r-1) || roadAt(c, r+1)) t = 'P';
    else t = '#';
    TILE[r][c] = t;
  } }
})();
function tileAt(c, r) { return (c < 0 || r < 0 || c >= COLS || r >= ROWS) ? '#' : TILE[r][c]; }

// Doors: the tile the door is in, the pavement tile you enter from (fc, fr), the display
