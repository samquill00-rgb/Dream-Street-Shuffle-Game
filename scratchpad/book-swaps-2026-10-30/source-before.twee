  // ── pre-rendered wall strip (limestone + hieroglyphs) ────────────
  var wallC = document.createElement('canvas'); wallC.width = 1024; wallC.height = 512;
  (function(cx){
    cx.fillStyle = '#241a12'; cx.fillRect(0, 0, 1024, 512);
    // block courses
    for (var row = 0; row < 8; row++){
      var byy = row * 64;
      cx.strokeStyle = 'rgba(12,8,5,0.9)'; cx.lineWidth = 2.4;
      cx.beginPath(); cx.moveTo(0, byy); cx.lineTo(1024, byy); cx.stroke();
      var off = (row % 2) * 90;
      for (var bxx = off; bxx < 1024 + 180; bxx += 180){
        cx.beginPath(); cx.moveTo(bxx, byy); cx.lineTo(bxx, byy + 64); cx.stroke();
      }
    }
    // mottle + soot
    for (var mm = 0; mm < 260; mm++){
      cx.fillStyle = 'rgba(' + (Math.random() < 0.5 ? '14,9,5' : '58,44,30') + ',' + (0.08 + Math.random()*0.14) + ')';
      cx.beginPath(); cx.arc(Math.random()*1024, Math.random()*512, 4 + Math.random()*26, 0, Math.PI*2); cx.fill();
    }
    // hieroglyph clusters — spare gold ink, crisp
    cx.strokeStyle = 'rgba(212,174,106,0.34)'; cx.lineWidth = 2; cx.lineCap = 'round';
    for (var hc = 0; hc < 9; hc++){
      var hx = 60 + Math.random()*904, hy = 60 + Math.random()*380;
      for (var gl = 0; gl < 5; gl++){
        var gy2 = hy + gl*18, kind = Math.floor(Math.random()*4);
        cx.beginPath();
        if (kind === 0){ cx.arc(hx + 6, gy2, 5, 0, Math.PI*2); }
        else if (kind === 1){ cx.moveTo(hx, gy2); cx.quadraticCurveTo(hx + 7, gy2 - 7, hx + 14, gy2); }
        else if (kind === 2){ cx.moveTo(hx, gy2 - 4); cx.lineTo(hx + 14, gy2 - 4); cx.moveTo(hx, gy2 + 3); cx.lineTo(hx + 14, gy2 + 3); }
        else { cx.moveTo(hx + 7, gy2 - 6); cx.lineTo(hx + 7, gy2 + 5); cx.moveTo(hx + 2, gy2); cx.lineTo(hx + 12, gy2); }
        cx.stroke();
      }
    }
    // block relief: a light-caught top edge and a shadowed base per course
    for (var rw = 0; rw < 8; rw++){
      var ry = rw * 64;
      cx.fillStyle = 'rgba(96,74,50,0.10)'; cx.fillRect(0, ry + 2, 1024, 5);
      cx.fillStyle = 'rgba(0,0,0,0.22)'; cx.fillRect(0, ry + 57, 1024, 7);
    }
    // painted frieze register along the fourth course, pigment nearly gone
    var fy = 192;
    cx.fillStyle = 'rgba(122,44,30,0.15)'; cx.fillRect(0, fy + 8, 1024, 12);
    cx.fillStyle = 'rgba(180,130,52,0.11)'; cx.fillRect(0, fy + 24, 1024, 30);
    cx.strokeStyle = 'rgba(212,174,106,0.20)'; cx.lineWidth = 1.4;
    cx.beginPath(); cx.moveTo(0, fy + 6); cx.lineTo(1024, fy + 6);
    cx.moveTo(0, fy + 58); cx.lineTo(1024, fy + 58); cx.stroke();
    // a procession of worn figures walking the frieze
    cx.strokeStyle = 'rgba(212,174,106,0.17)'; cx.lineWidth = 2; cx.lineCap = 'round';
    for (var pfg = 0; pfg < 19; pfg++){
      var fx2 = 22 + pfg*54 + Math.random()*12, fy2 = fy + 36;
      cx.beginPath();
      cx.arc(fx2, fy2 - 8, 3.2, 0, Math.PI*2);
      cx.moveTo(fx2, fy2 - 5); cx.lineTo(fx2 - 4, fy2 + 12);
      cx.moveTo(fx2, fy2 - 5); cx.lineTo(fx2 + 5, fy2 + 12);
      cx.moveTo(fx2 - 5, fy2 + 2); cx.lineTo(fx2 + 6, fy2 - 1);
      cx.stroke();
    }
    // recessed niches, each with a seated guardian in the dark
    for (var nn = 0; nn < 2; nn++){
      var nx = 170 + nn*540 + Math.random()*50, nyTop = 168, nw = 88, nh = 184;
      var ng = cx.createLinearGradient(nx, 0, nx + nw, 0);
      ng.addColorStop(0, 'rgba(0,0,0,0.82)');
      ng.addColorStop(0.5, 'rgba(6,4,2,0.94)');
      ng.addColorStop(1, 'rgba(0,0,0,0.82)');
      cx.fillStyle = ng; cx.fillRect(nx, nyTop, nw, nh);
      cx.strokeStyle = 'rgba(212,174,106,0.22)'; cx.lineWidth = 2;
      cx.strokeRect(nx, nyTop, nw, nh);
      var gxc = nx + nw/2;
      cx.fillStyle = 'rgba(18,12,8,1)';
      cx.beginPath();
      cx.moveTo(gxc - 26, nyTop + nh);
      cx.lineTo(gxc - 26, nyTop + nh - 44);
      cx.lineTo(gxc - 16, nyTop + nh - 80);
      cx.lineTo(gxc - 12, nyTop + nh - 106);
      cx.arc(gxc, nyTop + nh - 114, 13, Math.PI, 0);
      cx.lineTo(gxc + 16, nyTop + nh - 80);
      cx.lineTo(gxc + 26, nyTop + nh - 44);
      cx.lineTo(gxc + 26, nyTop + nh);
      cx.closePath(); cx.fill();
      cx.strokeStyle = 'rgba(180,140,80,0.20)';
      cx.lineWidth = 1.6;
      cx.beginPath(); cx.arc(gxc, nyTop + nh - 114, 13, -Math.PI*0.92, -Math.PI*0.08); cx.stroke();
    }
    // old cracks working down the courses
    cx.strokeStyle = 'rgba(8,5,3,0.55)'; cx.lineWidth = 1.6; cx.lineCap = 'butt';
    for (var ck = 0; ck < 5; ck++){
      var cxx = Math.random()*1024, cyy = Math.random()*260;
      cx.beginPath(); cx.moveTo(cxx, cyy);
      for (var cs = 0; cs < 6; cs++){ cxx += (Math.random()-0.5)*26; cyy += 18 + Math.random()*20; cx.lineTo(cxx, cyy); }
      cx.stroke();
    }
  })(wallC.getContext('2d'));
  // Baked limestone wear, plus separate relief highlights for moving firelight.
  var wearC=document.createElement('canvas');wearC.width=1024;wearC.height=512;
  var reliefC=document.createElement('canvas');reliefC.width=1024;reliefC.height=512;
  var wc=wearC.getContext('2d'),rc=reliefC.getContext('2d'),stoneSeed=73419;
  function stoneRand(){stoneSeed=(Math.imul(stoneSeed,1664525)+1013904223)>>>0;return stoneSeed/4294967296;}
  for(var pit=0;pit<11000;pit++){
    var x=stoneRand()*1024,y=stoneRand()*512,r=.35+stoneRand()*1.9;
    wc.fillStyle='rgba(5,4,3,'+(.08+stoneRand()*.2)+')';wc.beginPath();wc.ellipse(x,y,r,r*.6,stoneRand()*3,0,Math.PI*2);wc.fill();
    wc.fillStyle='rgba(169,137,96,.1)';wc.fillRect(x-r,y-r*.6,r*1.2,.7);
    rc.fillStyle='rgba(232,170,99,'+(.1+stoneRand()*.25)+')';rc.fillRect(x-r,y-r*.6,r*1.3,.8);
  }
  for(var course=0;course<8;course++){
    var cy=course*64;
    for(var chip=0;chip<28;chip++){
      var cx=stoneRand()*1024,depth=1+stoneRand()*5,width=2+stoneRand()*12;
      wc.fillStyle='rgba(4,3,2,.38)';wc.beginPath();wc.moveTo(cx,cy+1);wc.lineTo(cx+width,cy+1);wc.lineTo(cx+width*.7,cy+depth);wc.lineTo(cx+width*.2,cy+depth*.6);wc.closePath();wc.fill();
      rc.strokeStyle='rgba(221,161,93,.23)';rc.lineWidth=.8;rc.beginPath();rc.moveTo(cx+width*.2,cy+depth*.6);rc.lineTo(cx+width*.7,cy+depth);rc.lineTo(cx+width,cy+1);rc.stroke();
    }
    for(var stain=0;stain<8;stain++){
      var sx=stoneRand()*1024,sw=3+stoneRand()*14,sh=14+stoneRand()*42;
      var mineral=wc.createLinearGradient(0,cy,0,cy+sh);mineral.addColorStop(0,'rgba(100,77,45,.16)');mineral.addColorStop(1,'rgba(100,77,45,0)');wc.fillStyle=mineral;wc.fillRect(sx,cy,sw,sh);
    }
  }
  wallC.getContext('2d').drawImage(wearC,0,0);
  var torchReliefs=TORCHES.map(function(tx){
    var c=document.createElement('canvas');c.width=c.height=384;var x=c.getContext('2d');
    var ty=(floorAt(tx+4)||floorAt(tx-60)||360)-90,left=tx-192,top=ty-192;
    for(var tile=Math.floor(left/1024)*1024;tile<left+384;tile+=1024)x.drawImage(reliefC,tile-left,-60-top);
    x.globalCompositeOperation='destination-in';var mask=x.createRadialGradient(192,192,5,192,192,192);mask.addColorStop(0,'rgba(255,255,255,.9)');mask.addColorStop(.5,'rgba(255,255,255,.45)');mask.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=mask;x.fillRect(0,0,384,384);return {canvas:c,x:left,y:top};
  });


  // The stone's pits and mineral veins rotate with it, independently of the light.
  var boulderC=document.createElement('canvas');boulderC.width=boulderC.height=128;
  var bx=boulderC.getContext('2d');bx.fillStyle='#746450';bx.fillRect(0,0,128,128);
  for(var grain=0;grain<3100;grain++){
    var gx=stoneRand()*128,gy=stoneRand()*128,gr=.35+stoneRand()*1.8;
    bx.fillStyle=grain%3?'rgba(28,23,18,.28)':'rgba(184,161,123,.24)';bx.beginPath();bx.ellipse(gx,gy,gr,gr*.65,stoneRand()*3,0,Math.PI*2);bx.fill();
    if(grain%3===0){bx.fillStyle='rgba(209,179,130,.19)';bx.fillRect(gx-gr,gy-gr*.6,gr,.6);}
  }
  for(var vein=0;vein<7;vein++){
    var vx=stoneRand()*128,vy=stoneRand()*128;bx.beginPath();bx.moveTo(vx,vy);
    for(var step=0;step<6;step++){vx+=(stoneRand()-.5)*15;vy+=5+stoneRand()*8;bx.lineTo(vx,vy);}
    bx.strokeStyle=vein%2?'rgba(23,18,14,.55)':'rgba(174,150,109,.3)';bx.lineWidth=vein%2?1.3:.8;bx.stroke();
  }

  function makeAudio(){
    if(audio)return;
    try{
      var ac=new(window.AudioContext||window.webkitAudioContext)(), master=ac.createGain();master.gain.value=0;master.connect(ac.destination);
      var buf=ac.createBuffer(1,ac.sampleRate*2,ac.sampleRate),data=buf.getChannelData(0);for(var i=0;i<data.length;i++)data[i]=(Math.random()*2-1)*.5;
      var noise=ac.createBufferSource();noise.buffer=buf;noise.loop=true;
      var low=ac.createBiquadFilter();low.type='lowpass';low.frequency.value=180;
      var roll=ac.createGain();roll.gain.value=0;noise.connect(low);low.connect(roll);roll.connect(master);noise.start();
      function note(freq,duration,gain){if(window.dssAudio&&window.dssAudio.isMuted())return;var o=ac.createOscillator(),g=ac.createGain();o.type='sine';o.frequency.value=freq;g.gain.setValueAtTime(gain,ac.currentTime);g.gain.exponentialRampToValueAtTime(.0001,ac.currentTime+duration);o.connect(g);g.connect(master);o.start();o.stop(ac.currentTime+duration);}
      audio={resume:function(){ac.resume().catch(function(){});},silence:function(){master.gain.setTargetAtTime(0,ac.currentTime,.04);},update:function(chase,near,gallery){var mute=window.dssAudio&&window.dssAudio.isMuted();master.gain.setTargetAtTime(mute?0:.6,ac.currentTime,.08);roll.gain.setTargetAtTime(chase?.07+near*.12:(gallery?0:.012),ac.currentTime,.3);low.frequency.setTargetAtTime(chase?220+near*180:90,ac.currentTime,.2);},mark:function(n){note(330*Math.pow(2,n/12),.8,.07);},hit:function(){note(52,.6,.15);},kill:function(){try{noise.stop();ac.close();}catch(e){}}};
    }catch(e){audio=null;}
  }

  // Keyboard and independent pointer controls share the same actions.
  function clearInput(){ keys={}; pointers={}; jumpHeld=false; bufferT=0; touching=false; touchSide=0;
    stage.querySelectorAll('[data-held]').forEach(function(b){ b.removeAttribute('data-held'); }); }
  function startGame(){
    if(finished) return;
    makeAudio(); started=true; paused=false; lastNow=null; clearInput(); cover.hidden=true;
    pauseButton.textContent='Pause'; canvas.focus({preventScroll:true});
    if(audio) audio.resume();
  }
  function setPaused(value){
    if(!started || finished) return;
    paused=value; clearInput(); lastNow=null; cover.hidden=!value;
    cover.querySelector('h2').textContent='The Pyramid Run';
    beginButton.textContent=value ? 'Resume run' : 'Enter the dark';
    pauseButton.textContent=value ? 'Resume' : 'Pause';
    if(audio && value) audio.silence();
    if(!value){canvas.focus({preventScroll:true});if(audio)audio.resume();}
  }
  function kd(e){
    if(e.ctrlKey||e.metaKey||e.altKey||e.target && (e.target.isContentEditable || /INPUT|TEXTAREA|SELECT|BUTTON/.test(e.target.tagName))) return;
    var k=e.key.length===1 ? e.key.toLowerCase() : e.key;
    if(k==='p' || k==='Escape'){ if(!e.repeat && started && !finished){ e.preventDefault(); setPaused(!paused); } return; }
    if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' ','w','a','s','d'].indexOf(k)<0){
      
      return;
    }
    e.preventDefault();
    if(paused || finished) return;
    if(!started) startGame();
    keys[k]=true;
    if((k==='ArrowUp'||k==='w'||k===' ')&&!e.repeat){bufferT=BUFFER; jumpHeld=true;}
  }
  function releaseJump(){
    if(held('ArrowUp')||held('w')||held(' ')) return;
    jumpHeld=false; if(jumping&&vy<0) vy*=JUMPCUT;
  }
  function ku(e){var k=e.key.length===1?e.key.toLowerCase():e.key; keys[k]=false;
    if(k==='ArrowUp'||k==='w'||k===' ') releaseJump(); }
  function blur(){ if(started&&!finished) setPaused(true); else clearInput(); }
  function visibility(){if(document.hidden) blur();}
  function listen(el,event,fn){el.addEventListener(event,fn); controlRemovers.push(function(){el.removeEventListener(event,fn);});}
  listen(window,'keydown',kd); listen(window,'keyup',ku); listen(window,'blur',blur);
  listen(document,'visibilitychange',visibility);
  listen(beginButton,'click',startGame);
  listen(pauseButton,'click',function(){setPaused(!paused);});
  listen(expandButton,'click',function(){
    if(!stage.requestFullscreen && !document.fullscreenElement){say('Expand is unavailable in this browser.');return;}
    var op=document.fullscreenElement ? document.exitFullscreen() : stage.requestFullscreen && stage.requestFullscreen();
    if(op && op.catch) op.catch(function(){say('Expand is unavailable in this browser.');});
  });
  listen(document,'fullscreenchange',function(){expandButton.textContent=document.fullscreenElement===stage?'Shrink':'Expand';});
  stage.querySelectorAll('[data-pr-key]').forEach(function(button){
    listen(button,'pointerdown',function(e){
      e.preventDefault(); if(paused||finished) return; if(!started) startGame();
      var k=button.getAttribute('data-pr-key'); pointers[e.pointerId]=k;
      button.setPointerCapture(e.pointerId); button.setAttribute('data-held','');
      if(k==='ArrowUp'){bufferT=BUFFER; jumpHeld=true;} if(audio) audio.resume();
    });
    function release(e){var k=pointers[e.pointerId]; delete pointers[e.pointerId];
      if(!held(button.getAttribute('data-pr-key'))) button.removeAttribute('data-held');
      if(k==='ArrowUp') releaseJump(); }
    listen(button,'pointerup',release); listen(button,'pointercancel',release); listen(button,'lostpointercapture',release);
    // Enter/Space on a focused pad button is a keyboard equivalent.
    listen(button,'keydown',function(e){if(e.key!==' '&&e.key!=='Enter')return;e.preventDefault();
      if(paused||finished)return;if(!started)startGame();var k=button.getAttribute('data-pr-key');keys[k]=true;
      if(k==='ArrowUp'&&!e.repeat){bufferT=BUFFER;jumpHeld=true;}});
    listen(button,'keyup',function(e){if(e.key!==' '&&e.key!=='Enter')return;e.preventDefault();
      var k=button.getAttribute('data-pr-key');keys[k]=false;if(k==='ArrowUp')releaseJump();});
  });
  window._pyrCleanup=function(){clearInput();controlRemovers.forEach(function(fn){fn();});};

  function stumble(knock){
    if (invuln > 0) return;
    stumbles++; invuln = 1.15; shake = reducedMotion?0:1.0; hitFlash = 0.35; dust(px,py,10); if(audio)audio.hit();
    if (knock) px = Math.max(40, px - 26);
    say('STUMBLE · KEEP GOING',1.1);
  }

  function respawn(){
    px=lastCheckpoint;if(ball&&ball.done)px=Math.max(px,ball.x+ball.r+20);py=floorAt(px);vy=0;jumping=false;onGround=true;pitFall=null;
    invuln=1.8;clearInput();rescueHold=.85;croc.tunnel=0;croc.committed=false;
    if(ball&&!ball.done){ball.x=px-300;ball.v=236;}
    camX=Math.max(0,px-240);camY=py-415;say('SAFE AT THE TORCH · READY YOUR JUMP',1.5);

  }

  function update(dt){
    if (!started || finished || paused) return;
    if(rescueHold>0){rescueHold=Math.max(0,rescueHold-dt);return;}
    var now2 = gameClock;
    if(bannerUntil && gameClock>bannerUntil){banner.style.opacity='0';bannerUntil=0;}
    if(sealPulse>0)sealPulse=Math.max(0,sealPulse-dt);
    for(var di=debris.length-1;di>=0;di--){var d=debris[di];d.t+=dt;d.x+=d.vx*dt;d.y+=d.vy*dt;d.vy+=170*dt;if(d.t>1.2)debris.splice(di,1);}
    var crocPhase=(gameClock/1000)%6.4;
    var desiredOpen=croc.committed || (crocPhase>1.3&&crocPhase<4.9);
    croc.open+=( (desiredOpen?1:0)-croc.open)*Math.min(1,dt*5);
    if(croc.tunnel){
      croc.tunnel+=dt;px=4820+310*Math.min(1,croc.tunnel/1.1);py=400;
      camX+=((px-260)-camX)*Math.min(1,dt*4);
      if(croc.tunnel>1.1){croc.tunnel=0;croc.passed=true;croc.committed=false;px=5130;onGround=true;vy=0;lastCheckpoint=5130;dust(px,py,20);say('BACK INTO THE LIGHT.',1.5);}
      return;
    }
    if(cat.friend && px>cat.x-180){cat.x+=Math.min(150*dt,Math.max(0,Math.min(5230,px+140)-cat.x));}
    if(ending){
      ending+=dt;galleryLight=1;
      camX+=((WORLD_END-330)-camX)*Math.min(1,dt*1.5);
      if(ending>2.2) finishRun();
      if(audio)audio.update(false,0,true);
      return;
    }

    if (invuln > 0) invuln -= dt;
    if (shake > 0) shake = Math.max(0, shake - dt*3);
    if (hitFlash > 0) hitFlash = Math.max(0, hitFlash - dt*1.6);
    if (landPuff > 0) landPuff = Math.max(0, landPuff - dt*2.4);

    if (pitFall){
      pitFall.t += dt;
      py += 420*dt;
      if (pitFall.t > 0.55){
        // mercy: three falls into the same pit and sand fills it
        for (var pf2 = 0; pf2 < FLOOR.length; pf2++){
          if (FLOOR[pf2].y === null && px >= FLOOR[pf2].x0 - 30 && px < FLOOR[pf2].x1 + 30){
            pitCounts[pf2] = (pitCounts[pf2] || 0) + 1;
            if (pitCounts[pf2] >= 3){
              FLOOR[pf2].y = floorAt(FLOOR[pf2].x1+1); FLOOR[pf2].sanded = true;
              say('Sand fills the pit. The pyramid is bored of you.');
            }
          }
        }
        stumble(false); respawn();return;
      }
    } else {
      // pace: → hurries at 1.45; ← walks you BACK for a missed mark
      var paceMul = (held('ArrowRight') || held('d')) ? HURRY :
                    ((held('ArrowLeft') || held('a')) ? BACK : 1);
      // Fixed, shorter hops match the snake-head spacing; hurry resumes beyond.
      var snakePace=px>SNAKE0-100 && px<SNAKE1;
      if(snakePace && paceMul>0)paceMul=.75;
      var previousX=px,previousY=py;
      var greeting=px>3500&&px<3720&&(held('ArrowDown')||held('s'))&&onGround;
      if(greeting){paceMul=0;cat.pet+=dt;
        if(!cat.friend&&cat.pet>.45){cat.friend=true;GLYPHS[6].hidden=false;GLYPHS[6].x=px+28;say('THE CAT SHOWS YOU THE WAY.',2);if(audio)audio.mark(2);}
      }
      px += BASE * paceMul * dt;
      if(!cat.seen&&px>3480){cat.seen=true;say('↓ GREET THE TEMPLE CAT',3);}
      if(!snakeHint&&px>3680){snakeHint=true;say('MEASURED HOPS · HOLD ↑, RELEASE, JUMP AGAIN',3);}
      if(!crocHint&&px>4430){crocHint=true;say('→ ENTER WHEN THE JAWS OPEN.',3.5);}
      if(!croc.passed && px>=CROC_GATE && previousX<4820){
        if(!croc.committed){croc.wait+=dt;
          if(croc.open>.82 && (held('ArrowRight')||held('d')||croc.wait>10))croc.committed=true;
          else {px=CROC_GATE;paceMul=0;}}
        if(croc.committed&&px>=4820){croc.tunnel=.001;onGround=true;vy=0;return;}
      }
      if (px < 40) px = 40;
      // the sealed stone blocks the road back
      if (ball && ball.done && px < ball.x + ball.r + 18) px = ball.x + ball.r + 18;
      runPhase += dt * (6 + 5*Math.abs(paceMul));
      runLean += (Math.max(-0.16, (paceMul - 1) * 0.16) - runLean) * Math.min(1, dt*8);

      ducking = !!(held('ArrowDown') || held('s'));

      // vertical: coyote + buffer + asymmetric gravity (Sam's dials)
      var fl = floorAt(px);
      if(onGround&&snakeAt(px)&&snakeAt(previousX))py=fl;
      // A riser has a side even while airborne: do not snap through solid stone.
      if(fl!==null && floorAt(previousX)!==fl && py>fl+3){
        px=previousX;fl=floorAt(px);
        if(onGround)walledMs+=dt*1000;
      }
      if (onGround && fl === null){ onGround = false; coyoteT = COYOTE; }
      if (!onGround){
        if (coyoteT > 0) coyoteT -= dt;
        vy += GRAV * (vy > 0 ? FALLMULT : 1) * dt;
        py += vy * dt;
      } else {
        // ledge steps: walking off a step DOWN drops you into the air
        if (fl !== null && fl > py + 1){ onGround = false; coyoteT = COYOTE; }
        else if (fl !== null && fl >= py - 20){ py = fl; }
        else if (fl !== null){
          // a tall riser is a WALL — hold the line; it wants a jump
          for (var rw2 = 0; rw2 < FLOOR.length; rw2++){
            if (px >= FLOOR[rw2].x0 && px < FLOOR[rw2].x1){ px = Math.max(40, FLOOR[rw2].x0 - 1); break; }
          }
          walledMs += dt*1000;
          if (walledMs > 5000 && !taughtJump){
            taughtJump = true;
            if (banner){ banner.textContent = 'Hold ↑ to jump higher.'; banner.style.opacity = '1';
              setTimeout(function(){ banner.style.opacity = '0'; }, 2200); }
          }
          if (walledMs > 12000){
            walledMs = 0; py = fl;
            if (banner){ banner.textContent = 'The stone lifts you, unimpressed.'; banner.style.opacity = '1';
              setTimeout(function(){ banner.style.opacity = '0'; }, 1800); }
          }
        }
      }
      if (bufferT > 0) bufferT -= dt;
      if (walledMs > 0 && !onGround) walledMs = 0;
      if(walledMs>4500 && !taughtJump){taughtJump=true;say('Hold ↑ to jump higher.');}
      if(walledMs>12000){var ahead=floorAt(px+15);if(ahead!==null){px+=15;py=ahead;walledMs=0;say('The stone lifts you, unimpressed.');}}
      if (bufferT > 0 && (onGround || coyoteT > 0) && !jumping && !ducking){
        jumping = true; onGround = false; coyoteT = 0; bufferT = 0;
        if(window.dssAudio&&window.dssAudio.jumpPuff)window.dssAudio.jumpPuff(); /* 2026-10-18 night */
        vy = snakePace?-320:JUMP;
        if(!jumpHeld)vy*=JUMPCUT;
      }
      if (!onGround && fl !== null && vy >= 0 && previousY<=fl+4 && py >= fl){
        if(window.dssAudio&&window.dssAudio.landThud)window.dssAudio.landThud(Math.min(1.4,Math.abs(vy)/Math.abs(JUMP))); /* 2026-10-18 night: harder from higher */
        py = fl; vy = 0; onGround = true; jumping = false; landPuff = 1; dust(px,py,6);
      }
      // fell into a pit mouth
      if (fl === null && !jumping && vy >= 0 && py > (floorAt(previousX)===null?400:floorAt(previousX)) + 45){
        if (!pitFall) pitFall = { t: 0 };
      }
      if (fl === null && py > 460 && !pitFall) pitFall = { t: 0 };

      // lintels: duck or bonk
      var standH = ducking ? 26 : 46;
      for (var li2 = 0; li2 < LINTELS.length; li2++){
        var ln2 = LINTELS[li2];
        if (px > ln2.x0 && px < ln2.x1){
          var flh = floorAt(px);
          if (flh !== null && py - standH < flh - ln2.gap){ stumble(true); vy=Math.max(30,vy); jumping=false; }
        }
      }
      // scarabs
      for (var sc2 = 0; sc2 < SCARABS.length; sc2++){
        var s = SCARABS[sc2];
        s.x += s.dir * 46 * dt;
        if (s.x < s.x0 || s.x > s.x1) s.dir *= -1;
        var sfl = floorAt(s.x);
        if (sfl !== null && Math.abs(s.x - px) < 16 && py > sfl - 14){ stumble(true); }
      }
      // sand columns
      for (var sa2 = 0; sa2 < SANDS.length; sa2++){
        var sd = SANDS[sa2];
        var cyc = ((now2/1000 + sd.ph) % 2.6);
        if (cyc < 1.0 && Math.abs(sd.x - px) < 12 && onGround){ stumble(true); }
      }
      // glyphs
      for (var gy3 = 0; gy3 < GLYPHS.length; gy3++){
        var g3 = GLYPHS[gy3];
        if (g3.got || g3.hidden) continue;
        var gyy = (floorAt(g3.x) || floorAt(g3.x - 80) || 360) + g3.dy;
        if (Math.abs(g3.x - px) < 26 && Math.abs(gyy - (py - 24)) < 40){
          g3.got = true; glyphCount++; if(audio)audio.mark(glyphCount); if (stumbles > 0) { stumbles--; say('A MARK TAKES BACK A STUMBLE.', 1.6); } /* 2026-10-29 (Sam, playtest note 22: "there should be some reason for collecting these"; his pick: each buys back a stumble) */
          sparkles.push({ x: g3.x, y: gyy, t: 0 });
          if (window.dssAudio && window.dssAudio.loreUnravel && glyphCount === GLYPHS.length) window.dssAudio.loreUnravel();
        }
      }
      // THE BALL
      if(!warned && px>1780){warned=true;say('STONE MOVES IN THE DARK.',2.4);dust(px-170,py-180,22);if(audio)audio.hit();}
      if (!ball && px > 2000){
        ball = { x: px - 320, v: 236, r: 53, rot: 0, done: false };
        say('RUN.   → HURRY',1.8);
      }
      if (ball && !ball.done){
        ball.x += ball.v * dt;
        ball.rot += (ball.v/ball.r) * dt;
        // rubber band: never hopeless, never gone
        var bgap = px - ball.x;
        ball.v = bgap>300 ? 310 : (bgap<155 ? 180 : 252);
        var ballFloor=floorAt(ball.x);if(ballFloor===null)ballFloor=385;
        if(Math.abs(bgap)<ball.r+10 && invuln<=0 && py>ballFloor-ball.r*2+8){stumble(false);px=ball.x+ball.r+70;}
        if(!reducedMotion && bgap<260)shake=Math.max(shake,(1-Math.max(0,bgap)/260)*.55);
        if (ball.x > 3400){ ball.done = true; ball.x = 3400 + ball.r; shake = reducedMotion?0:1.8;sealPulse=1.5;dust(ball.x,400,35);if(audio)audio.hit();
          say('The stone seals the corridor behind you.',2.4); }
      }
      // gallery light
      galleryLight = Math.max(0, Math.min(1, (px - 5400) / 1300));

      // Actual grounded arrival, followed by a short quiet reveal.
      if(px>=WORLD_END && onGround){px=WORLD_END;ending=.001;keys={};pointers={};say('THE GRAND GALLERY',3);}
      if(onGround){for(var ci=0;ci<TORCHES.length;ci++){if(TORCHES[ci]<=px && TORCHES[ci]>lastCheckpoint)lastCheckpoint=TORCHES[ci];}}
      toolbar.textContent=px<2000?'THE PYRAMID · DESCENT':px<3480?'THE PYRAMID · THE PURSUIT':px<5400?'THE PYRAMID · LIVING GODS':'THE PYRAMID · GRAND GALLERY';
      if(audio)audio.update(!!ball&&!ball.done,ball?Math.max(0,1-(px-ball.x)/500):0,px>3480);

    }

    for (var sk2 = sparkles.length - 1; sk2 >= 0; sk2--){
      sparkles[sk2].t += dt;
      if (sparkles[sk2].t > 0.8) sparkles.splice(sk2, 1);
    }

    // camera
    camX += ((px - (ball&&!ball.done ? 300 : 240)) - camX) * Math.min(1, dt*5);
    var fl2 = floorAt(px);
    var target = (fl2 !== null ? fl2 : Math.min(py,420)) - 415;
    camY += (target - camY) * Math.min(1, dt*3);

    if (hud && !finished){
      var pace=(held('ArrowRight')||held('d'))?BASE*HURRY:BASE;
      var nextHazards=[];
      FLOOR.forEach(function(f,i){var dist=f.x0-px;if(dist<0||dist>pace*1.3)return;
        if(f.y===null)nextHazards.push({d:dist,text:dist<=pace*.28?'HOLD ↑ / SPACE · JUMP NOW':'PIT AHEAD · READY TO JUMP'});
        else if(i && FLOOR[i-1].y!==null && FLOOR[i-1].y>f.y)nextHazards.push({d:dist,text:'STEP UP · ↑ JUMP'});});
      LINTELS.forEach(function(l){if(l.x0-px<pace*1.1 && l.x1>px)nextHazards.push({d:Math.max(0,l.x0-px),text:'LOW STONE · HOLD ↓ TO DUCK'});});
      SCARABS.forEach(function(h){if(h.x>=px && h.x-px<pace*.9)nextHazards.push({d:h.x-px,text:'SCARAB · ↑ JUMP'});});
      SANDS.forEach(function(h){if(h.x>=px && h.x-px<pace*.9)nextHazards.push({d:h.x-px,text:'FALLING SAND · ↑ JUMP OVER THE POUR'});});
      nextHazards.sort(function(a,b){return a.d-b.d;});
      hazardHint=nextHazards.length?nextHazards[0].text:'';
      if(px>SNAKE0-35&&px<SNAKE1)hazardHint='SNAKE HEADS · HOLD ↑, RELEASE, JUMP AGAIN';
      if(!croc.passed&&px>=CROC_GATE-110&&px<4820)hazardHint=croc.open>.82?'JAWS OPEN · HOLD → TO ENTER':'WAIT · THE JAWS WILL OPEN';
      hud.textContent = (hazardHint?hazardHint+'   ·   ':'')+'MARKS ' + glyphCount + '/7 · EACH TAKES BACK A STUMBLE   ·   STUMBLES ' + stumbles + '/3';
    }
  }

  function finishRun(){
        finished = true;
        if(audio)audio.silence();
        if(document.fullscreenElement===stage && document.exitFullscreen)document.exitFullscreen().catch(function(){});
        var EZ = window.dssEase ? window.dssEase.level('pyramid') : 0; /* 2026-10-28 (dssEase): after a stumbling run the next asks less */
        var won = (stumbles <= 3 + EZ && glyphCount >= 4 - (EZ >= 2 ? 1 : 0));
        if (banner){
          banner.textContent = won ? 'THE GALLERY OPENS.' : 'THE GALLERY OPENS, GRUDGINGLY.';
          banner.style.opacity = '1';
        }
        if (hud) hud.textContent = won ?
          'You counted ' + glyphCount + ' of the seven marks. The stone approves of you.' :
          'You stumbled ' + stumbles + ' times and the marks kept their distance.';
        var span2 = document.getElementById(won ? 'pyr-run-win' : 'pyr-run-lose');
        if (span2){
          span2.style.display = 'block';
          span2.classList.add('dss-mini-exit');
          setTimeout(function(){
            if (span2.scrollIntoView) span2.scrollIntoView({ behavior: reducedMotion?'auto':'smooth', block: 'center' });
          }, 900);
          /* 2026-10-28 (Sam: "Easier each retry"): TRY AGAIN runs it afresh, gentler; MOVE ON limps on as before */
          /* 2026-10-29 (Sam, playtest note 23: "two buttons doing the same thing. Move on and Limp in. It should just be one"): the card's own move button is the limp; the page link stays hidden */
          if (!won && window.dssEase) { span2.style.display = 'none'; window.dssEase.lost('pyramid'); window.dssEase.offer(stage, { move: 'Limp into the Gallery', onAgain: function(){ var a = document.querySelector('.pr-again tw-link'); if (a) a.click(); }, onMove: function(){ var l = span2.querySelector('tw-link'); if (l) l.click(); } }); }
        }
        if (won && window.dssAudio && window.dssAudio.loreUnravel) window.dssAudio.loreUnravel();
  }

  // ── draw ─────────────────────────────────────────────────────────
  function nearestTorchDist(wx){
    var best = 1e9;
    for (var i = 0; i < TORCHES.length; i++){
      var d2 = Math.abs(TORCHES[i] - wx);
      if (d2 < best) best = d2;
    }
    return best;
  }
  function draw(){
    var now2 = reducedMotion?0:gameClock;
    var sx2 = (Math.random()-0.5) * 6 * shake;
    var sy2 = (Math.random()-0.5) * 5 * shake;
    ctx.save();
    ctx.translate(sx2 - camX, sy2 - camY);

    // far strata (parallax 0.4)
    ctx.save();
    ctx.translate(camX * 0.6, camY * 0.6);
    ctx.fillStyle = '#170f09';
    ctx.fillRect(camX*0.4 - 100, camY*0.4 - 100, W + 200, H + 200);
    ctx.restore();

    // wall strip behind the corridor
    var wallY = -60;
    for (var wx2 = Math.floor((camX - 80)/1024)*1024; wx2 < camX + W + 80; wx2 += 1024){
      ctx.drawImage(wallC, wx2, wallY, 1024, 512);
    }

    if(camX+W>5400){
      var galleryWall=ctx.createLinearGradient(0,-300,0,500);galleryWall.addColorStop(0,'#3a2e32');galleryWall.addColorStop(.6,'#4a3a3a');galleryWall.addColorStop(1,'#29251b');ctx.fillStyle=galleryWall;ctx.fillRect(5400,-600,2300,1200);
      ctx.fillStyle=ctx.createPattern(wearC,'repeat');ctx.fillRect(5400,-600,2300,1200);
      ctx.strokeStyle='rgba(10,10,7,.48)';ctx.lineWidth=2;
      for(var course=-5;course<8;course++){var gy=course*85;ctx.beginPath();ctx.moveTo(5400,gy);ctx.lineTo(7600,gy);ctx.stroke();for(var block=5400+(course%2)*85;block<7600;block+=170){ctx.beginPath();ctx.moveTo(block,gy);ctx.lineTo(block,gy+85);ctx.stroke();}}
    }

    // Monumental corbelled courses: the low passage opens into a tall gallery.
    for(var arch=0;arch<25;arch++){
      var ax=arch*310;if(ax<camX-350||ax>camX+W+350)continue;
      var af=floorAt(ax+35)||385, gallery=ax>=5400;
      var roof=gallery?af-490:af-245;
      var depth=gallery?7:4;
      for(var tier=0;tier<depth;tier++){
        var ty=roof+tier*19;
        var stone=ctx.createLinearGradient(0,ty,0,ty+19);
        stone.addColorStop(0,gallery?'#84724e':'#5b4631');stone.addColorStop(.25,gallery?'#4f4433':'#30251b');stone.addColorStop(1,'#15110d');
        ctx.fillStyle=stone;ctx.fillRect(ax-tier*5,ty,310+tier*10,18);
        ctx.fillStyle='rgba(225,190,116,.14)';ctx.fillRect(ax-tier*5,ty,310+tier*10,1);
      }
      // Deep vertical seams and incised jambs give the architecture weight.
      ctx.fillStyle=gallery?'#151410':'#120e0a';ctx.fillRect(ax+13,roof+depth*19,29,af-(roof+depth*19));
      ctx.fillStyle=gallery?'#736448':'#51402b';ctx.fillRect(ax+9,roof+depth*19,7,af-(roof+depth*19));
      ctx.strokeStyle='rgba(221,184,110,.2)';ctx.lineWidth=1;
      for(var cut=0;cut<7;cut++){var yy=af-32-cut*26;ctx.strokeRect(ax+19,yy,11,17);ctx.beginPath();ctx.moveTo(ax+21,yy+8);ctx.lineTo(ax+28,yy+5);ctx.stroke();}
      if(gallery){
        var alc=ctx.createLinearGradient(ax+90,0,ax+235,0);alc.addColorStop(0,'#100c0e');alc.addColorStop(.5,'#241c20');alc.addColorStop(1,'#0e0d0a');ctx.fillStyle=alc;ctx.fillRect(ax+85,af-295,150,263);
        ctx.strokeStyle='#b39b6055';ctx.lineWidth=3;ctx.strokeRect(ax+81,af-299,158,269);
        // Recessed immense seated guardians, glimpsed through light.
        ctx.fillStyle='#39372a';ctx.beginPath();ctx.moveTo(ax+110,af-34);ctx.lineTo(ax+115,af-111);ctx.lineTo(ax+139,af-158);ctx.lineTo(ax+141,af-199);ctx.quadraticCurveTo(ax+160,af-231,ax+181,af-199);ctx.lineTo(ax+184,af-158);ctx.lineTo(ax+208,af-111);ctx.lineTo(ax+213,af-34);ctx.closePath();ctx.fill();
        ctx.strokeStyle='#cab47955';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(ax+142,af-196);ctx.quadraticCurveTo(ax+160,af-220,ax+179,af-196);ctx.stroke();
      }
    }
    // The far door, a slit of warm light set deep into the final stonework.
    if(camX>6000){var portal=ctx.createLinearGradient(6770,0,7060,0);portal.addColorStop(0,'#514a32');portal.addColorStop(.55,'#c8b67c');portal.addColorStop(1,'#f8ebbb');ctx.fillStyle=portal;ctx.fillRect(6840,-150,110,360);ctx.fillStyle='#f7e8b6';ctx.fillRect(6898,-140,26,350);}

    // torch pools + sconces
    for (var ti2 = 0; ti2 < TORCHES.length; ti2++){
      var tx3 = TORCHES[ti2];
      if (tx3 < camX - 260 || tx3 > camX + W + 260) continue;
      var tfl = floorAt(tx3 + 4) || floorAt(tx3 - 60) || 360;
      var flick = .86+.08*Math.sin(now2/270+ti2*2.4)+.06*Math.sin(now2/113+ti2);
      var flameLean=Math.sin(now2/190+ti2)*3.2+Math.sin(now2/83+ti2*3)*1.3;
      var pool = ctx.createRadialGradient(tx3, tfl - 90, 8, tx3+Math.sin(now2/1800+ti2)*9, tfl - 80, 260);
      pool.addColorStop(0, 'rgba(255,190,105,' + (0.48*flick) + ')');
      pool.addColorStop(0.5, 'rgba(220,140,60,' + (0.23*flick) + ')');
      pool.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = pool;
      ctx.fillRect(tx3 - 270, tfl - 350, 540, 510);
      // Fine relief catches the changing fire independently of the broad light pool.
      var relief=torchReliefs[ti2];ctx.save();ctx.globalCompositeOperation='screen';ctx.globalAlpha=.42+.2*flick;
      ctx.drawImage(relief.canvas,relief.x+Math.sin(now2/730+ti2)*.45,relief.y+Math.sin(now2/510+ti2)*.3);ctx.restore();
      // Soft smoke curls rise above each torch, with a warm lower edge.
      for(var smoke=0;smoke<5;smoke++){
        var age=((now2/1000)*.22+smoke/5+ti2*.17)%1;
        var mx=tx3+Math.sin(age*5.4+ti2)*age*22,my=tfl-111-age*96;
        var radius=8+age*22,sm=ctx.createRadialGradient(mx,my,0,mx,my,radius);
        sm.addColorStop(0,'rgba(157,119,87,'+(.045*Math.sin(age*Math.PI))+')');sm.addColorStop(1,'rgba(90,83,78,0)');
        ctx.fillStyle=sm;ctx.fillRect(mx-radius,my-radius,radius*2,radius*2);
      }
      // Bracket shadow and recessed block edges breathe with the shifting flame.
      ctx.save();ctx.shadowColor='rgba(3,2,1,.3)';ctx.shadowBlur=7;
      var shadow=ctx.createLinearGradient(tx3,tfl-90,tx3+55+flameLean*4,tfl+12);
      shadow.addColorStop(0,'rgba(3,2,1,.32)');shadow.addColorStop(1,'rgba(3,2,1,0)');ctx.fillStyle=shadow;
      ctx.beginPath();ctx.moveTo(tx3-5,tfl-91);ctx.lineTo(tx3+6,tfl-91);ctx.lineTo(tx3+72+flameLean*5,tfl+18);ctx.lineTo(tx3+38+flameLean*3,tfl+18);ctx.closePath();ctx.fill();ctx.restore();
      for(var edge=0;edge<7;edge++){
        var joint=-60+edge*64,range=Math.max(0,1-Math.abs(joint-(tfl-95))/220);
        if(range<=0)continue;
        var lip=ctx.createLinearGradient(0,joint,0,joint+5+flick*2);
        lip.addColorStop(0,'rgba(6,4,2,'+(.16*range*flick)+')');lip.addColorStop(1,'rgba(6,4,2,0)');ctx.fillStyle=lip;
        ctx.fillRect(tx3-145+flameLean*2,joint,290,7);
      }
      // Charred mount, iron basket, and three interleaving tongues of fire.
      ctx.fillStyle='#20170f';ctx.fillRect(tx3-5,tfl-96,10,27);
      ctx.strokeStyle='#665039';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(tx3-7,tfl-98);ctx.lineTo(tx3-4,tfl-89);ctx.lineTo(tx3+4,tfl-89);ctx.lineTo(tx3+7,tfl-98);ctx.stroke();
      ctx.save();ctx.globalCompositeOperation='screen';
      var fireGlow=ctx.createRadialGradient(tx3,tfl-110,1,tx3,tfl-110,25);
      fireGlow.addColorStop(0,'rgba(255,149,35,.26)');fireGlow.addColorStop(1,'rgba(255,116,22,0)');ctx.fillStyle=fireGlow;ctx.fillRect(tx3-25,tfl-135,50,50);ctx.restore();
      for(var tongue=0;tongue<3;tongue++){
        var base=tx3+(tongue-1)*3,tip=base+flameLean*(1+tongue*.2),length=16+flick*9+Math.sin(now2/(97+tongue*23)+tongue+ti2)*4;
        ctx.fillStyle=tongue===0?'rgba(239,91,18,.9)':tongue===1?'rgba(255,177,45,.95)':'rgba(255,222,112,.9)';
        ctx.beginPath();ctx.moveTo(base-4,tfl-98);ctx.bezierCurveTo(base-9,tfl-108,tip-2,tfl-111,tip,tfl-98-length);ctx.bezierCurveTo(tip+1,tfl-108,base+8,tfl-107,base+4,tfl-98);ctx.closePath();ctx.fill();
      }
      ctx.fillStyle='rgba(255,246,196,.9)';ctx.beginPath();ctx.ellipse(tx3,tfl-102,2.3,6,flameLean*.035,0,Math.PI*2);ctx.fill();
      // Sparks lift, curl and fade rather than floating as fixed square pixels.
      for(var em=0;em<9;em++){
        var et=((now2/1000)*(.35+em*.057)+ti2*.7+em*.173)%1;
        var ex=tx3+Math.sin(et*8+em*2.1)*(3+et*17)+flameLean*et;
        var ey=tfl-111-et*(60+em%3*17),alpha=.72*Math.sin(et*Math.PI)*(1-et);
        ctx.strokeStyle='rgba(255,194,91,'+alpha+')';ctx.lineWidth=em%3===0?1.5:.8;ctx.beginPath();ctx.moveTo(ex,ey);ctx.lineTo(ex-Math.cos(et*6+em)*1.5,ey+2+et*3);ctx.stroke();
      }
    }

    // floor + pits
    for (var fs2 = 0; fs2 < FLOOR.length; fs2++){
      var seg = FLOOR[fs2];
      if (seg.x1 < camX - 60 || seg.x0 > camX + W + 60) continue;
      if (seg.sanded){
        ctx.fillStyle = '#6a5636';
        ctx.fillRect(seg.x0, seg.y, seg.x1 - seg.x0, 240);
        ctx.fillStyle = 'rgba(200,176,130,0.35)';
        ctx.beginPath(); ctx.ellipse((seg.x0 + seg.x1)/2, seg.y + 2, (seg.x1 - seg.x0)/2, 6, 0, 0, Math.PI*2); ctx.fill();
        continue;
      }
      if (seg.y === null){
        var pg = ctx.createLinearGradient(0, 380, 0, 470);
        pg.addColorStop(0, 'rgba(8,5,3,0.95)');
        pg.addColorStop(1, 'rgba(0,0,0,1)');
        ctx.fillStyle = pg;
        ctx.fillRect(seg.x0, 340, seg.x1 - seg.x0, 200);
        continue;
      }
      ctx.fillStyle = '#2a1e12';
      ctx.fillRect(seg.x0, seg.y, seg.x1 - seg.x0, 240);
      ctx.strokeStyle = 'rgba(232,204,146,0.62)';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(seg.x0, seg.y); ctx.lineTo(seg.x1, seg.y); ctx.stroke();
      ctx.fillStyle = 'rgba(14,9,5,0.5)';
      for (var fj = seg.x0; fj < seg.x1; fj += 68){ ctx.fillRect(fj, seg.y, 2, 26); }
    }

    // Pit edges remain legible in the deepest shade.
    for(var pe=0;pe<FLOOR.length;pe++){var gap=FLOOR[pe];if(gap.y!==null)continue;
      var leftY=floorAt(gap.x0-1),rightY=floorAt(gap.x1+1);ctx.strokeStyle='#d1b77d';ctx.lineWidth=3;
      ctx.beginPath();ctx.moveTo(gap.x0-16,leftY);ctx.lineTo(gap.x0,leftY);ctx.lineTo(gap.x0,leftY+12);ctx.moveTo(gap.x1,rightY+12);ctx.lineTo(gap.x1,rightY);ctx.lineTo(gap.x1+16,rightY);ctx.stroke();
      ctx.fillStyle='rgba(210,182,130,.2)';for(var grit=0;grit<6;grit++){var drop=(now2/9+grit*43)%150;ctx.fillRect(gap.x0+4+grit*3,leftY+drop,1.5,2.5);}}

    // lintels
    for (var ld2 = 0; ld2 < LINTELS.length; ld2++){
      var ln3 = LINTELS[ld2];
      if (ln3.x1 < camX - 60 || ln3.x0 > camX + W + 60) continue;
      var lfl = floorAt((ln3.x0 + ln3.x1)/2) || 360;
      ctx.fillStyle = '#1c1209';
      ctx.fillRect(ln3.x0, lfl - 300, ln3.x1 - ln3.x0, 300 - ln3.gap);
      ctx.strokeStyle = 'rgba(212,174,106,0.32)';
      ctx.strokeRect(ln3.x0, lfl - 300, ln3.x1 - ln3.x0, 300 - ln3.gap);
      ctx.fillStyle='#89734c';ctx.fillRect(ln3.x0,lfl-ln3.gap-5,ln3.x1-ln3.x0,5);
      ctx.fillStyle='#d7bd82';ctx.font='12px Georgia';ctx.textAlign='center';ctx.fillText('↓',(ln3.x0+ln3.x1)/2,lfl-ln3.gap-14);
    }

    // sand columns
    for (var sd2 = 0; sd2 < SANDS.length; sd2++){
      var sn = SANDS[sd2];
      if (sn.x < camX - 80 || sn.x > camX + W + 80) continue;
      var sfl2 = floorAt(sn.x) || 360;
      var cyc2 = ((gameClock/1000 + sn.ph) % 2.6);
      if (cyc2 < 1.0){
        ctx.strokeStyle = 'rgba(226,200,150,0.55)';
        ctx.lineWidth = 3 + Math.sin(now2/60)*1.2;
        ctx.beginPath(); ctx.moveTo(sn.x, sfl2 - 300); ctx.lineTo(sn.x, sfl2); ctx.stroke();
        ctx.strokeStyle = 'rgba(226,200,150,0.25)';
        ctx.lineWidth = 8;
        ctx.beginPath(); ctx.moveTo(sn.x, sfl2 - 300); ctx.lineTo(sn.x, sfl2); ctx.stroke();
      }
      if(cyc2>2.05){ctx.fillStyle='rgba(232,199,125,.8)';for(var pre=0;pre<5;pre++)ctx.fillRect(sn.x-5+pre*3,sfl2-200+((now2/12+pre*21)%95),1.5,3);}
      ctx.fillStyle = 'rgba(200,176,130,0.8)';
      ctx.beginPath(); ctx.ellipse(sn.x, sfl2, 16, 5, 0, 0, Math.PI*2); ctx.fill();
    }

    // scarabs (eyes glint in the dark)
    for (var sb2 = 0; sb2 < SCARABS.length; sb2++){
      var s2 = SCARABS[sb2];
      if (s2.x < camX - 40 || s2.x > camX + W + 40) continue;
      var sfl3 = floorAt(s2.x);
      if (sfl3 === null) continue;
      ctx.fillStyle = '#3f5c57';
      ctx.beginPath(); ctx.ellipse(s2.x, sfl3 - 5, 9, 5, 0, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = 'rgba(212,174,106,0.9)';
      ctx.fillRect(s2.x + s2.dir*6, sfl3 - 7, 2.5, 2.5);
      ctx.strokeStyle='#91b6a1';ctx.lineWidth=1.2;ctx.beginPath();ctx.ellipse(s2.x,sfl3-5,9,5,0,Math.PI,Math.PI*2);ctx.stroke();
    }

    // glyphs — red now (2026-10-29, Sam: "can we make them red not blue"), they glow through the dark
    for (var gd2 = 0; gd2 < GLYPHS.length; gd2++){
      var g4 = GLYPHS[gd2];
      if (g4.got || g4.hidden || g4.x < camX - 60 || g4.x > camX + W + 60) continue;
      var gfl = (floorAt(g4.x) || floorAt(g4.x - 80) || 360) + g4.dy;
      var pulse = 0.7 + 0.3*Math.sin(now2/400 + gd2*1.7);
      var gg2 = ctx.createRadialGradient(g4.x, gfl, 2, g4.x, gfl, 30);
      gg2.addColorStop(0, 'rgba(255,214,206,' + (0.6*pulse) + ')');
      gg2.addColorStop(0.4, 'rgba(235,50,40,' + (0.32*pulse) + ')');
      gg2.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = gg2;
      ctx.fillRect(g4.x - 30, gfl - 30, 60, 60);
      ctx.strokeStyle = 'rgba(255,90,70,' + (0.95*pulse) + ')';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      for (var ph2 = 0; ph2 < 26; ph2++){
        var an2 = ph2*0.42, rr3 = 1.5 + ph2*0.5;
        var gx2 = g4.x + Math.cos(an2)*rr3, gy4 = gfl + Math.sin(an2)*rr3;
        if (ph2 === 0) ctx.moveTo(gx2, gy4); else ctx.lineTo(gx2, gy4);
      }
