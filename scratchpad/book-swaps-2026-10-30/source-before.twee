    var tag = new THREE.Mesh(new THREE.PlaneGeometry(0.16, 0.1), new THREE.MeshLambertMaterial({ color: 0xe8dcb8, side: THREE.DoubleSide })); tag.position.set(0.3, 2.3, 0.57); tag.rotation.z = -0.15; g.add(tag);
