')](if: $keySlip is not "seed" and $keySlip is not "held" and $keySlip is not "spent" and $keySlip is not "stolen" and $keySlip is not "traded")[(set: _where to $keySlip)(if: _where's 1stto5th is "raid:")[(set: _where to _where's 6thtolast)](if: (datanames: $stashLabel) contains _where)[(set: _where to $stashLabel's (_where))](set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ The betting slip, ' + _where + '</div></div>')](if: $keyLighter is not "seed" and $keyLighter is not "held" and $keyLighter is not "spent" and $keyLighter is not "stolen" and $keyLighter is not "traded")[(set: _where to $keyLighter)(if: _where's 1stto5th is "raid:")[(set: _where to _where's 6thtolast)](if: (datanames: $stashLabel) contains _where)[(set: _where to $stashLabel's (_where))](set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ The brass lighter, ' + _where + '</div></div>')](if: $keyEye is not "seed" and $keyEye is not "held" and $keyEye is not "spent" and $keyEye is not "stolen" and $keyEye is not "traded")[(set: _where to $keyEye)(if: _where's 1stto5th is "raid:")[(set: _where to _where's 6thtolast)](if: (datanames: $stashLabel) contains _where)[(set: _where to $stashLabel's (_where))](set: _nb to _nb + '<div class="nb-inv-item"><div class="nb-inv-name nb-item">◈ The glass eye, ' + _where + '</div></div>')]
