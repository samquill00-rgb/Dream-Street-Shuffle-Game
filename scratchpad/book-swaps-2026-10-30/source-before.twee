cle class="ev-flower-center" r="1.3" cx="0" cy="0"/></g></g><g transform="translate(14,20)"><g class="ev-bell ev-be4c"><path d="M0,0 C-2.5,1 -5,3 -6,8 C-7,14 -6,19 -4,22 C-2,21 -1,22 0,23 C1,22 2,21 4,22 C6,19 7,14 6,8 C5,3 2.5,1 0,0Z"/><path d="M0,3 Q0,13 0,21" fill="none" stroke-width="0.7" opacity="0.45"/><circle class="ev-flower-center" r="1.1" cx="0" cy="0"/></g></g></g></svg></div>
<script>
/* 2026-10-12 (Sam, item 15): the vines are drawn on a wide 1600 x 900 sheet with their growth at the left and right edges, so a
   phone held upright (the sheet cropped to its middle) showed almost none of them. Upright, the sheet is now shown as its left
   half above its right half: the drawing goes into one group and a <use> of it, moved left and down, draws the right half
   underneath, in a sheet 800 x 1800. Turned sideways it is the whole sheet again. The drawing itself is untouched. */
(function(){
  var all = document.querySelectorAll('.ending-vines'); var wrap = all[all.length - 1];
  if (!wrap || wrap.dataset.evSplit) return; wrap.dataset.evSplit = '1';
  var svg = wrap.querySelector('svg'); if (!svg) return;
  var NS = 'http://www.w3.org/2000/svg', gid = 'evAll' + all.length;
  var g = document.createElementNS(NS, 'g'); g.setAttribute('id', gid);
  Array.prototype.slice.call(svg.childNodes).forEach(function(n) { if (!(n.nodeType === 1 && n.tagName.toLowerCase() === 'defs')) g.appendChild(n); });
  svg.appendChild(g);
  var u = document.createElementNS(NS, 'use'); u.setAttribute('href', '#' + gid); u.setAttribute('transform', 'translate(-800 900)'); u.setAttribute('class', 'ev-under');
  svg.appendChild(u);
  var mq = window.matchMedia ? window.matchMedia('(orientation: portrait)') : null;
  function fit() { var up = !!(mq && mq.matches); svg.setAttribute('viewBox', up ? '0 0 800 1800' : '0 0 1600 900'); u.style.display = up ? '' : 'none'; }
  fit(); if (mq) { if (mq.addEventListener) mq.addEventListener('change', fit); else if (mq.addListener) mq.addListener(fit); }
})();
</script>

:: Dawn Lily Sprig {"position":"3000,2850","size":"100,100"}
{<!-- The notebook's five-bell sprig restated on the Dawn screen as the
     flower record: gathered bells lit, empty ones faint, the pentangle
     star only at five. Bell art duplicated from Build Notebook (its _bell
     is passage-local and can't be shared). -->
(set: _bell to "<path d='M-1.2,-16 C-0.4,-10 0.4,-5 0,0 C2.6,3.2 2.8,8.4 0.4,13' fill='none' stroke='#7f8f5e' stroke-width='0.8' stroke-linecap='butt' opacity='0.9'/><path d='M-2.6,-15.2 L0.4,-17' fill='none' stroke='#8a7a48' stroke-width='0.6' stroke-linecap='round' opacity='0.75'/><path d='M0,13 C-3.2,11.8 -4.8,13.6 -5.4,16.8 C-2.2,15.2 2.2,15.2 5.4,16.8 C4.8,13.6 3.2,11.8 0,13 Z' fill='#8fa070' stroke='#5f6e46' stroke-width='0.3' opacity='0.85'/><path class='lb' d='M-3.6,15 C-10.4,16.6 -13.4,24 -13,31.5 C-12.7,38 -11.8,42 -12.6,45 C-13.4,47 -14.8,48.6 -15,50 Q-12.5,53.6 -10,50 Q-7.5,53.6 -5,50 Q-2.5,53.6 0,50 Q2.5,53.6 5,50 Q7.5,53.6 10,50 Q12.5,53.6 15,50 C14.8,48.6 13.4,47 12.6,45 C11.8,42 12.7,38 13,31.5 C13.4,24 10.4,16.6 3.6,15 Z' fill='url(#lilyIvory)' stroke='#a88a55' stroke-width='0.55' stroke-linejoin='round'/><ellipse cx='-4.6' cy='30' rx='4' ry='9' fill='#ffffff' opacity='0.22'/><path d='M-6,19 C-3,30 -4,40 -7.5,48' fill='none' stroke='#8a7a48' stroke-width='0.28' opacity='0.35'/><path d='M-12.2,47.4 Q0,43.6 12.2,47.4 Q0,50.4 -12.2,47.4 Z' fill='#7a6238' opacity='0.17'/><path d='M0,16.5 Q0.2,32 0,50' fill='none' stroke='#a88a55' stroke-width='0.32' opacity='0.5'/><path d='M-4.4,16.8 Q-7,31 -7.4,50' fill='none' stroke='#a88a55' stroke-width='0.3' opacity='0.45'/><path d='M4.4,16.8 Q7,31 7.4,50' fill='none' stroke='#a88a55' stroke-width='0.3' opacity='0.45'/><path d='M-8.6,19.6 Q-11.8,32 -12.4,48' fill='none' stroke='#a88a55' stroke-width='0.26' opacity='0.35'/><path d='M8.6,19.6 Q11.8,32 12.4,48' fill='none' stroke='#a88a55' stroke-width='0.26' opacity='0.35'/><path d='M-12.6,45 C-13.4,47 -14.8,48.6 -15,50 Q-12.5,53.6 -10,50 Q-7.5,53.6 -5,50 Q-2.5,53.6 0,50 Q2.5,53.6 5,50 Q7.5,53.6 10,50 Q12.5,53.6 15,50 C14.8,48.6 13.4,47 12.6,45' fill='none' stroke='#a88a55' stroke-width='0.72' stroke-linecap='round' opacity='0.9'/><circle cx='-1.5' cy='49.4' r='0.55' fill='#8a6a30' opacity='0.8'/><circle cx='1.5' cy='49.4' r='0.55' fill='#8a6a30' opacity='0.8'/><circle cx='0' cy='50.8' r='0.5' fill='#8a6a30' opacity='0.75'/>")
(set: _c1 to (cond: $lilyCount >= 1, 'nb-lily-gathered', 'nb-lily-empty'))
(set: _c2 to (cond: $lilyCount >= 2, 'nb-lily-gathered', 'nb-lily-empty'))
(set: _c3 to (cond: $lilyCount >= 3, 'nb-lily-gathered', 'nb-lily-empty'))
(set: _c4 to (cond: $lilyCount >= 4, 'nb-lily-gathered', 'nb-lily-empty'))
(set: _c5 to (cond: $lilyCount >= 5, 'nb-lily-gathered', 'nb-lily-empty'))
(set: _star to (cond: $lilyCount >= 5, '0.5', '0'))
(set: _s to '<svg class="nb-lily-row dawn-lily-sprig" viewBox="0 0 300 200" xmlns="http://www.w3.org/2000/svg">')
(set: _s to _s + '<defs><linearGradient id="lilyIvory" x1="0" y1="0" x2="0.3" y2="1"><stop offset="0" stop-color="#fbf6e8"/><stop offset="0.6" stop-color="#f1e6cc"/><stop offset="1" stop-color="#dfcfa8"/></linearGradient><linearGradient id="lilyLeaf" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9aa77c"/><stop offset="1" stop-color="#6e7f56"/></linearGradient><radialGradient id="lilyStain"><stop offset="0" stop-color="#8a7a48" stop-opacity="0.07"/><stop offset="0.7" stop-color="#8a7a48" stop-opacity="0.035"/><stop offset="1" stop-color="#8a7a48" stop-opacity="0"/></radialGradient><linearGradient id="lilyTape" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#e8dcb8" stop-opacity="0.55"/><stop offset="0.5" stop-color="#f2e9cf" stop-opacity="0.72"/><stop offset="1" stop-color="#e8dcb8" stop-opacity="0.55"/></linearGradient></defs><g filter="url(#dss-ink-fine)" class="plant"><ellipse cx="40" cy="52" rx="24" ry="36" fill="url(#lilyStain)"/><ellipse cx="95" cy="54" rx="24" ry="36" fill="url(#lilyStain)"/><ellipse cx="150" cy="56" rx="24" ry="36" fill="url(#lilyStain)"/><ellipse cx="205" cy="53" rx="24" ry="36" fill="url(#lilyStain)"/><ellipse cx="260" cy="50" rx="24" ry="36" fill="url(#lilyStain)"/><g transform="translate(39.3,26.6) rotate(0)"><rect x="-9.5" y="-4" width="19" height="8" fill="url(#lilyTape)" stroke="#c9b98f" stroke-width="0.3" opacity="0.95"/><path d="M-9.5,-4 L-8.2,-1.8 L-9.5,0.4 L-8,2.4 L-9.5,4 M9.5,-4 L8.1,-1.7 L9.5,0.5 L8.2,2.6 L9.5,4" fill="none" stroke="#c9b98f" stroke-width="0.3"/></g><g transform="translate(94.3,26.0) rotate(0)"><rect x="-9.5" y="-4" width="19" height="8" fill="url(#lilyTape)" stroke="#c9b98f" stroke-width="0.3" opacity="0.95"/><path d="M-9.5,-4 L-8.2,-1.8 L-9.5,0.4 L-8,2.4 L-9.5,4 M9.5,-4 L8.1,-1.7 L9.5,0.5 L8.2,2.6 L9.5,4" fill="none" stroke="#c9b98f" stroke-width="0.3"/></g><g transform="translate(149.2,25.0) rotate(0)"><rect x="-9.5" y="-4" width="19" height="8" fill="url(#lilyTape)" stroke="#c9b98f" stroke-width="0.3" opacity="0.95"/><path d="M-9.5,-4 L-8.2,-1.8 L-9.5,0.4 L-8,2.4 L-9.5,4 M9.5,-4 L8.1,-1.7 L9.5,0.5 L8.2,2.6 L9.5,4" fill="none" stroke="#c9b98f" stroke-width="0.3"/></g><g transform="translate(204.3,26.3) rotate(0)"><rect x="-9.5" y="-4" width="19" height="8" fill="url(#lilyTape)" stroke="#c9b98f" stroke-width="0.3" opacity="0.95"/><path d="M-9.5,-4 L-8.2,-1.8 L-9.5,0.4 L-8,2.4 L-9.5,4 M9.5,-4 L8.1,-1.7 L9.5,0.5 L8.2,2.6 L9.5,4" fill="none" stroke="#c9b98f" stroke-width="0.3"/></g><g transform="translate(259.4,27.6) rotate(0)"><rect x="-9.5" y="-4" width="19" height="8" fill="url(#lilyTape)" stroke="#c9b98f" stroke-width="0.3" opacity="0.95"/><path d="M-9.5,-4 L-8.2,-1.8 L-9.5,0.4 L-8,2.4 L-9.5,4 M9.5,-4 L8.1,-1.7 L9.5,0.5 L8.2,2.6 L9.5,4" fill="none" stroke="#c9b98f" stroke-width="0.3"/></g></g><polygon points="150,104 177,187.2 106.3,135.8 193.8,135.8 123,187.2" fill="none" stroke="#9a8a68" stroke-width="0.7" opacity="' + _star + '"/>')
(set: _s to _s + '<g filter="url(#dss-ink-fine)" class="nb-lily nb-lily-1 ' + _c1 + '" transform="translate(40,34) rotate(0) scale(0.821)">' + _bell + '</g>')
(set: _s to _s + '<g filter="url(#dss-ink-fine)" class="nb-lily nb-lily-2 ' + _c2 + '" transform="translate(95,34) rotate(0) scale(0.893)">' + _bell + '</g>')
(set: _s to _s + '<g filter="url(#dss-ink-fine)" class="nb-lily nb-lily-3 ' + _c3 + '" transform="translate(150,34) rotate(0)">' + _bell + '</g>')
(set: _s to _s + '<g filter="url(#dss-ink-fine)" class="nb-lily nb-lily-4 ' + _c4 + '" transform="translate(205,34) rotate(0) scale(0.857)">' + _bell + '</g>')
(set: _s to _s + '<g filter="url(#dss-ink-fine)" class="nb-lily nb-lily-5 ' + _c5 + '" transform="translate(260,34) rotate(0) scale(0.714)">' + _bell + '</g>')
