    var ht = cyl(0.4, 0.4, 0.05, 20, tableTop, 5.2, 1.05, -1.3); ht.receiveShadow = true;
    cyl(0.04, 0.04, 1.03, 8, tableLeg, 5.2, 0.52, -1.3); cyl(0.25, 0.25, 0.03, 16, tableLeg, 5.2, 0.015, -1.3);
    pint(5.05, 1.075, -1.2, 0.5); pint(5.35, 1.075, -1.42, 0.8);
    for (var i = 0; i < 3; i++) {
      var a = i / 3 * Math.PI * 2 + 0.6, sx = 5.2 + Math.sin(a) * 0.62, sz = -1.3 + Math.cos(a) * 0.62;
      cyl(0.17, 0.17, 0.06, 14, chairSeatMats[0], sx, 0.72, sz);
      cyl(0.03, 0.03, 0.7, 8, tableLeg, sx, 0.35, sz); cyl(0.2, 0.2, 0.02, 14, tableLeg, sx, 0.01, sz);
    }
  })();

  // Booths down the left wall: leather banquettes, a divider each, a table
  // The nearest booth has the paperback with the orange spine on the table.
  (function() {
    var leather = new THREE.MeshStandardMaterial({ color: 0x4a2238, roughness: 0.55 });
    var wood = new THREE.MeshStandardMaterial({ color: 0x3a2618, roughness: 0.6 });
    var k = 0;
    for (var z = -2.2; z > -12; z -= 3.2, k++) {
      box(0.6, 0.5, 1.3, leather, -6.5, 0.25, z);
      box(0.15, 1.2, 1.3, leather, -6.8, 0.85, z);
      for (var by = 0.55; by < 1.4; by += 0.28) for (var bz = -0.5; bz <= 0.5; bz += 0.33) cyl(0.015, 0.015, 0.02, 6, new THREE.MeshStandardMaterial({ color: 0xb08a40, metalness: 0.9, roughness: 0.3 }), -6.72, by, z + bz).rotation.z = Math.PI / 2;
      box(0.9, 1.3, 0.08, wood, -6.4, 0.65, z - 0.72);
      var t = box(0.7, 0.05, 1.0, tableTop, -5.7, 0.76, z); t.receiveShadow = true;
      box(0.05, 0.74, 0.05, tableLeg, -5.45, 0.37, z);
      // a little brass wall lamp over each booth
      var lampBase = box(0.06, 0.12, 0.12, new THREE.MeshStandardMaterial({ color: 0xb08a40, metalness: 0.9, roughness: 0.3 }), -6.95, 1.9, z, { cast: false });
      var shade = new THREE.Mesh(new THREE.ConeGeometry(0.11, 0.14, 12, 1, true), new THREE.MeshStandardMaterial({ color: 0xf0d8a0, roughness: 0.6, side: THREE.DoubleSide, emissive: 0x806030, emissiveIntensity: 0.6 })); shade.position.set(-6.8, 1.98, z); scene.add(shade);
      /* 2026-10-14 (speed): left out; 40 point lights ran this scene at ~9 fps, and its bulb and glow sprite carry the look */
      glowSprite('rgba(255,200,130,', 0.7, -6.72, 1.95, z);
      if (k === 0) {
        box(0.13, 0.025, 0.19, new THREE.MeshStandardMaterial({ color: 0xe86a1a, roughness: 0.8 }), -5.62, 0.8, z + 0.1, { cast: false }).rotation.y = 0.25;
        var paperbackFront = new THREE.Mesh(new THREE.PlaneGeometry(0.13, 0.19), window.dssOrangePaperbackCover());
        paperbackFront.position.set(-5.62, 0.8126, z + 0.1);
        paperbackFront.rotation.set(-Math.PI / 2, 0, 0.25); scene.add(paperbackFront);
        box(0.12, 0.004, 0.12, menuMat, -5.8, 0.79, z - 0.25, { cast: false }).rotation.y = -0.3;
        pint(-5.55, 0.785, z - 0.28, 0.4);
      } else {
        dressTable(-5.7, 0.785, z, false);
        if (k === 2) seatedFigure(-6.4, z, 0.3);
      }
    }
  })();

