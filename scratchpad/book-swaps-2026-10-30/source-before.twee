h="1.6" stroke-linecap="round"/><!-- Flower 5 --><path d="M170,22 Q168,26 168,30 Q170,34 174,30 Q176,26 172,22 Z" fill="#98b4d4" fill-opacity="0.28" stroke="#6a94c8" stroke-width="2" stroke-linejoin="round"/><path d="M170,22 Q172,18 176,14" fill="none" stroke="#6a94c8" stroke-width="1.4" stroke-linecap="round"/><!-- Small leaf --><path d="M110,56 Q118,52 124,56 Q128,62 122,66 Q114,68 110,62 Q108,58 110,56 Z" fill="#2e4a78" fill-opacity="0.18" stroke="#6a94c8" stroke-width="2" stroke-linejoin="round" opacity="0.6"/><!-- Background lead --><path d="M0,20 Q10,18 20,22 Q30,26 36,30" fill="none" stroke="#6a94c8" stroke-width="1.5" opacity="0.25"/><path d="M0,50 Q8,46 16,48 Q24,52 30,50" fill="none" stroke="#6a94c8" stroke-width="1.3" opacity="0.2"/><path d="M160,58 Q172,54 186,56 Q200,60 210,56" fill="none" stroke="#6a94c8" stroke-width="1.4" opacity="0.15"/></g></defs><!-- no ink filter: this art is drawn at 420 wide and stretched across the screen, which blows the fibre grain up into visible pixels (Sam 2026-10-23) --><g><use href="#dstAnLily" mask="url(#dstAnMaskL)"/><g mask="url(#dstAnMaskR)" transform="translate(420,0) scale(-1,1)"><use href="#dstAnLily"/></g></g></svg>
<!-- Drifting petals — lily-of-the-valley petals sway and rotate as they
     drift down the page. Two drift patterns alternate so the motion feels
     organic rather than synchronised. -->
<!-- 2026-10-21 (Sam): white petals, the premonition of the dawn; nine at three depths (near, mid, far-and-soft), three drift patterns -->
